<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_darabol_part" name="Daraboló üzem" processRef="pool_darabol_proc" />
    <bpmn:participant id="pool_elokeszit_part" name="Forgácsoló gyártáselőkészítő" processRef="pool_elokeszit_proc" />
    <bpmn:participant id="pool_programozo_part" name="CNC Programozó" processRef="pool_programozo_proc" />
    <bpmn:participant id="pool_cnc_part" name="Forgácsoló üzem (CNC)" processRef="pool_cnc_proc" />
    <bpmn:messageFlow id="msg_darabol_to_elokeszit" sourceRef="evt_end_darabol" targetRef="evt_start_elokeszit" name="Darabolt alkatrész és műhelyrajz átadása" />
    <bpmn:messageFlow id="msg_elokeszit_to_cnc" sourceRef="evt_end_elokeszit" targetRef="evt_start_cnc_prep" name="Alkatrész átadása CNC megmunkálásra" />
    <bpmn:messageFlow id="msg_elokeszit_to_programozo" sourceRef="evt_msg_program_hiany" targetRef="task_programoz" name="Program kérés" />
    <bpmn:messageFlow id="msg_programozo_to_elokeszit" sourceRef="task_programoz" targetRef="evt_msg_program_kesz" name="Program átadás" />
  </bpmn:collaboration>
  <bpmn:process id="pool_darabol_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_muhelyrajz" name="Műhelyrajz" dataObjectRef="data_muhelyrajz_do" />
    <bpmn:dataObject id="data_muhelyrajz_do" />
    <bpmn:dataObjectReference id="data_nyersanyag" name="Nyersanyag" dataObjectRef="data_nyersanyag_do" />
    <bpmn:dataObject id="data_nyersanyag_do" />
    <bpmn:dataObjectReference id="data_darabolt_alkatresz" name="Darabolt alkatrész" dataObjectRef="data_darabolt_alkatresz_do" />
    <bpmn:dataObject id="data_darabolt_alkatresz_do" />
    <bpmn:startEvent id="evt_start_darabol" name="Nyersanyag érkezés">
      <bpmn:outgoing>flow_start_to_vag</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_darabol" name="Darabolás kész">
      <bpmn:incoming>flow_mes_to_end_darabol</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_darabol_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_vag" name="Nyersanyag méretre vágása">
      <bpmn:incoming>flow_start_to_vag</bpmn:incoming>
      <bpmn:outgoing>flow_vag_to_scan</bpmn:outgoing>
      <bpmn:property id="task_vag_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_vag_dia0">
        <bpmn:sourceRef>data_muhelyrajz</bpmn:sourceRef>
        <bpmn:targetRef>task_vag_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_vag_dia1">
        <bpmn:sourceRef>data_nyersanyag</bpmn:sourceRef>
        <bpmn:targetRef>task_vag_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_vag_doa0">
        <bpmn:targetRef>data_darabolt_alkatresz</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_scan_darabol" name="Vonalkód beolvasása (nyomonkövetés)">
      <bpmn:incoming>flow_vag_to_scan</bpmn:incoming>
      <bpmn:outgoing>flow_scan_to_mes</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_mes_darabol" name="Státusz rögzítése MES-ben (darabolás)">
      <bpmn:incoming>flow_scan_to_mes</bpmn:incoming>
      <bpmn:outgoing>flow_mes_to_end_darabol</bpmn:outgoing>
      <bpmn:property id="task_mes_darabol_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_mes_darabol_dia0">
        <bpmn:sourceRef>data_darabolt_alkatresz</bpmn:sourceRef>
        <bpmn:targetRef>task_mes_darabol_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_start_to_vag" sourceRef="evt_start_darabol" targetRef="task_vag" />
    <bpmn:sequenceFlow id="flow_vag_to_scan" sourceRef="task_vag" targetRef="task_scan_darabol" />
    <bpmn:sequenceFlow id="flow_scan_to_mes" sourceRef="task_scan_darabol" targetRef="task_mes_darabol" />
    <bpmn:sequenceFlow id="flow_mes_to_end_darabol" sourceRef="task_mes_darabol" targetRef="evt_end_darabol" />
  </bpmn:process>
  <bpmn:process id="pool_elokeszit_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_muhelyrajz_p1" name="Műhelyrajz" dataObjectRef="data_muhelyrajz_p1_do" />
    <bpmn:dataObject id="data_muhelyrajz_p1_do" />
    <bpmn:dataObjectReference id="data_darabolt_alkatresz_p1" name="Darabolt alkatrész" dataObjectRef="data_darabolt_alkatresz_p1_do" />
    <bpmn:dataObject id="data_darabolt_alkatresz_p1_do" />
    <bpmn:dataObjectReference id="data_alkatresz_jegyzek" name="Alkatrészjegyzék" dataObjectRef="data_alkatresz_jegyzek_do" />
    <bpmn:dataObject id="data_alkatresz_jegyzek_do" />
    <bpmn:dataStoreReference id="data_store_program_server" name="CNC programszerver" />
    <bpmn:startEvent id="evt_start_elokeszit" name="Műhelyrajz és alkatrész fogadása">
      <bpmn:outgoing>flow_start_elokeszit_to_vizsgal</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_elokeszit_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_elokeszit" name="Előkészítés kész">
      <bpmn:incoming>flow_to_cnc_prep</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_elokeszit_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_program_hiany" name="Program hiány értesítés">
      <bpmn:incoming>flow_program_hiany</bpmn:incoming>
      <bpmn:outgoing>flow_msg_hiany_to_programoz</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_program_hiany_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_program_kesz" name="Program elkészült">
      <bpmn:incoming>flow_programoz_to_msg_kesz</bpmn:incoming>
      <bpmn:outgoing>flow_msg_kesz_to_betoltes</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_program_kesz_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_vizsgal_tipus" name="Megmunkálási típus vizsgálata és meghatározása">
      <bpmn:incoming>flow_start_elokeszit_to_vizsgal</bpmn:incoming>
      <bpmn:outgoing>flow_vizsgal_to_reg</bpmn:outgoing>
      <bpmn:property id="task_vizsgal_tipus_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_vizsgal_tipus_dia0">
        <bpmn:sourceRef>data_muhelyrajz_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_vizsgal_tipus_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_vizsgal_tipus_dia1">
        <bpmn:sourceRef>data_darabolt_alkatresz_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_vizsgal_tipus_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_reg_alaktr_jegyzek" name="Darabolt alkatrészjegyzék rögzítése">
      <bpmn:incoming>flow_vizsgal_to_reg</bpmn:incoming>
      <bpmn:outgoing>flow_reg_to_mes_elokeszit</bpmn:outgoing>
      <bpmn:property id="task_reg_alaktr_jegyzek_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_reg_alaktr_jegyzek_dia0">
        <bpmn:sourceRef>data_darabolt_alkatresz_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_reg_alaktr_jegyzek_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_reg_alaktr_jegyzek_doa0">
        <bpmn:targetRef>data_alkatresz_jegyzek</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_mes_elokeszit" name="Státusz váltás MES-ben (előkészítés)">
      <bpmn:incoming>flow_reg_to_mes_elokeszit</bpmn:incoming>
      <bpmn:outgoing>flow_mes_elokeszit_to_valaszt</bpmn:outgoing>
      <bpmn:property id="task_mes_elokeszit_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_mes_elokeszit_dia0">
        <bpmn:sourceRef>data_alkatresz_jegyzek</bpmn:sourceRef>
        <bpmn:targetRef>task_mes_elokeszit_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_valaszt_tipus" name="Megmunkálás típusának kiválasztása (CNC)">
      <bpmn:incoming>flow_mes_elokeszit_to_valaszt</bpmn:incoming>
      <bpmn:outgoing>flow_valaszt_to_gw_tipus</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_ellenoriz_program" name="CNC program meglétének ellenőrzése">
      <bpmn:incoming>flow_start_cnc_prep_to_ellenoriz_prog</bpmn:incoming>
      <bpmn:outgoing>flow_ellenoriz_prog_to_gw_prog</bpmn:outgoing>
      <bpmn:property id="task_ellenoriz_program_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_ellenoriz_program_dia0">
        <bpmn:sourceRef>data_store_program_server</bpmn:sourceRef>
        <bpmn:targetRef>task_ellenoriz_program_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_tipus_valasztas" name="Megmunkálási típus választása" isMarkerVisible="true">
      <bpmn:incoming>flow_valaszt_to_gw_tipus</bpmn:incoming>
      <bpmn:outgoing>flow_to_cnc_prep</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_program_megelte" name="CNC program megléte?" isMarkerVisible="true">
      <bpmn:incoming>flow_ellenoriz_prog_to_gw_prog</bpmn:incoming>
      <bpmn:outgoing>flow_program_hiany</bpmn:outgoing>
      <bpmn:outgoing>flow_program_van</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_elokeszit_to_vizsgal" sourceRef="evt_start_elokeszit" targetRef="task_vizsgal_tipus" />
    <bpmn:sequenceFlow id="flow_vizsgal_to_reg" sourceRef="task_vizsgal_tipus" targetRef="task_reg_alaktr_jegyzek" />
    <bpmn:sequenceFlow id="flow_reg_to_mes_elokeszit" sourceRef="task_reg_alaktr_jegyzek" targetRef="task_mes_elokeszit" />
    <bpmn:sequenceFlow id="flow_mes_elokeszit_to_valaszt" sourceRef="task_mes_elokeszit" targetRef="task_valaszt_tipus" />
    <bpmn:sequenceFlow id="flow_valaszt_to_gw_tipus" sourceRef="task_valaszt_tipus" targetRef="gw_tipus_valasztas" />
    <bpmn:sequenceFlow id="flow_to_cnc_prep" sourceRef="gw_tipus_valasztas" targetRef="evt_end_elokeszit" name="CNC" />
    <bpmn:sequenceFlow id="flow_ellenoriz_prog_to_gw_prog" sourceRef="task_ellenoriz_program" targetRef="gw_program_megelte" />
    <bpmn:sequenceFlow id="flow_program_hiany" sourceRef="gw_program_megelte" targetRef="evt_msg_program_hiany" name="Hiányzik program" />
  </bpmn:process>
  <bpmn:process id="pool_programozo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_muhelyrajz_p2" name="Műhelyrajz" dataObjectRef="data_muhelyrajz_p2_do" />
    <bpmn:dataObject id="data_muhelyrajz_p2_do" />
    <bpmn:dataObjectReference id="data_cnc_program" name="CNC program" dataObjectRef="data_cnc_program_do" />
    <bpmn:dataObject id="data_cnc_program_do" />
    <bpmn:userTask id="task_programoz" name="CNC program írása">
      <bpmn:incoming>flow_msg_hiany_to_programoz</bpmn:incoming>
      <bpmn:outgoing>flow_programoz_to_msg_kesz</bpmn:outgoing>
      <bpmn:property id="task_programoz_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_programoz_dia0">
        <bpmn:sourceRef>data_muhelyrajz_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_programoz_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_programoz_doa0">
        <bpmn:targetRef>data_cnc_program</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="pool_cnc_proc" isExecutable="false">
    <bpmn:dataStoreReference id="data_store_program_server_p1" name="CNC programszerver" />
    <bpmn:dataObjectReference id="data_cnc_program_p1" name="CNC program" dataObjectRef="data_cnc_program_p1_do" />
    <bpmn:dataObject id="data_cnc_program_p1_do" />
    <bpmn:dataObjectReference id="data_darabolt_alkatresz_p2" name="Darabolt alkatrész" dataObjectRef="data_darabolt_alkatresz_p2_do" />
    <bpmn:dataObject id="data_darabolt_alkatresz_p2_do" />
    <bpmn:dataObjectReference id="data_megmunkalt_termek" name="Megmunkált termék" dataObjectRef="data_megmunkalt_termek_do" />
    <bpmn:dataObject id="data_megmunkalt_termek_do" />
    <bpmn:startEvent id="evt_start_cnc_prep" name="Alkatrész fogadása CNC előkészítésre">
      <bpmn:outgoing>flow_start_cnc_prep_to_ellenoriz_prog</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_cnc_prep_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_cnc" name="Megmunkálás kész">
      <bpmn:incoming>flow_mes_veges_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_betoltes_program" name="CNC program letöltése programszerverről">
      <bpmn:incoming>flow_program_van</bpmn:incoming>
      <bpmn:incoming>flow_msg_kesz_to_betoltes</bpmn:incoming>
      <bpmn:outgoing>flow_betoltes_to_beazonositas</bpmn:outgoing>
      <bpmn:property id="task_betoltes_program_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_betoltes_program_dia0">
        <bpmn:sourceRef>data_store_program_server_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_betoltes_program_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_betoltes_program_doa0">
        <bpmn:targetRef>data_cnc_program_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_beazonositas" name="Beazonosítás vonalkód olvasással">
      <bpmn:incoming>flow_betoltes_to_beazonositas</bpmn:incoming>
      <bpmn:outgoing>flow_beazonositas_to_ellenoriz_satut</bpmn:outgoing>
      <bpmn:property id="task_beazonositas_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_beazonositas_dia0">
        <bpmn:sourceRef>data_darabolt_alkatresz_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_beazonositas_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_ellenoriz_satut" name="Satu ellenőrzése">
      <bpmn:incoming>flow_beazonositas_to_ellenoriz_satut</bpmn:incoming>
      <bpmn:outgoing>flow_ellenoriz_satut_to_gw_satut</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_csere_satut" name="Satu cseréje">
      <bpmn:incoming>flow_satut_csere_igen</bpmn:incoming>
      <bpmn:outgoing>flow_csere_satut_to_rogzit</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_rogzit_alapanyag" name="Alapanyag rögzítése a satuban">
      <bpmn:incoming>flow_satut_csere_nem</bpmn:incoming>
      <bpmn:incoming>flow_csere_satut_to_rogzit</bpmn:incoming>
      <bpmn:outgoing>flow_rogzit_to_ellenoriz_szerszam</bpmn:outgoing>
      <bpmn:property id="task_rogzit_alapanyag_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_rogzit_alapanyag_dia0">
        <bpmn:sourceRef>data_darabolt_alkatresz_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_rogzit_alapanyag_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_ellenoriz_szerszam" name="Szerszámlista ellenőrzése (CNC program alapján)">
      <bpmn:incoming>flow_rogzit_to_ellenoriz_szerszam</bpmn:incoming>
      <bpmn:outgoing>flow_ellenoriz_szerszam_to_gw_szerszam</bpmn:outgoing>
      <bpmn:property id="task_ellenoriz_szerszam_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_ellenoriz_szerszam_dia0">
        <bpmn:sourceRef>data_cnc_program_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_ellenoriz_szerszam_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_csere_szerszam" name="Új szerszám rögzítése és korrekciók felvétele">
      <bpmn:incoming>flow_szerszam_csere_igen</bpmn:incoming>
      <bpmn:outgoing>flow_csere_szerszam_to_zar</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_zar_ajtajat" name="CNC gép ajtajának zárása">
      <bpmn:incoming>flow_szerszam_csere_nem</bpmn:incoming>
      <bpmn:incoming>flow_csere_szerszam_to_zar</bpmn:incoming>
      <bpmn:incoming>flow_loop_back</bpmn:incoming>
      <bpmn:outgoing>flow_zar_to_forgacsoles</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="task_forgacsoles" name="Alapanyag forgácsolása">
      <bpmn:incoming>flow_zar_to_forgacsoles</bpmn:incoming>
      <bpmn:outgoing>flow_forgacsoles_to_nyit</bpmn:outgoing>
      <bpmn:property id="task_forgacsoles_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_forgacsoles_dia0">
        <bpmn:sourceRef>data_cnc_program_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_forgacsoles_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_forgacsoles_dia1">
        <bpmn:sourceRef>data_darabolt_alkatresz_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_forgacsoles_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_forgacsoles_doa0">
        <bpmn:targetRef>data_megmunkalt_termek</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:manualTask id="task_nyit_ajtajat" name="Ajtó nyitása és satu oldása">
      <bpmn:incoming>flow_forgacsoles_to_nyit</bpmn:incoming>
      <bpmn:outgoing>flow_nyit_to_vizsgal</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_vizsgal_elkeszulseg" name="Megmunkálás elkészültségének vizsgálata">
      <bpmn:incoming>flow_nyit_to_vizsgal</bpmn:incoming>
      <bpmn:outgoing>flow_vizsgal_to_gw_ujabb</bpmn:outgoing>
      <bpmn:property id="task_vizsgal_elkeszulseg_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_vizsgal_elkeszulseg_dia0">
        <bpmn:sourceRef>data_megmunkalt_termek</bpmn:sourceRef>
        <bpmn:targetRef>task_vizsgal_elkeszulseg_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_mes_veges" name="Termék elkészültségének jelzése státusz váltással MES-ben">
      <bpmn:incoming>flow_to_finish</bpmn:incoming>
      <bpmn:outgoing>flow_mes_veges_to_end</bpmn:outgoing>
      <bpmn:property id="task_mes_veges_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_mes_veges_dia0">
        <bpmn:sourceRef>data_megmunkalt_termek</bpmn:sourceRef>
        <bpmn:targetRef>task_mes_veges_prop</bpmn:targetRef>
