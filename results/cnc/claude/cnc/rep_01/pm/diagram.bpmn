<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_darabolo_part" name="Daraboló üzem" processRef="pool_darabolo_proc" />
    <bpmn:participant id="pool_forgacs_elokesz_part" name="Forgácsoló gyártáselőkészítő" processRef="pool_forgacs_elokesz_proc" />
    <bpmn:participant id="pool_forgacs_uzem_part" name="Forgácsoló üzem (CNC megmunkálás)" processRef="pool_forgacs_uzem_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_darabolo_msg" targetRef="start_forgacs_elokesz_msg" name="Műhelyrajz továbbítása" />
    <bpmn:messageFlow id="mf2" sourceRef="end_cnc_atadas_msg" targetRef="start_cnc_msg" name="Alkatrész átadása CNC megmunkálásra" />
  </bpmn:collaboration>
  <bpmn:process id="pool_darabolo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_muhelyrajz" name="Műhelyrajz" dataObjectRef="do_muhelyrajz_do" />
    <bpmn:dataObject id="do_muhelyrajz_do" />
    <bpmn:dataObjectReference id="do_vonalkod" name="Vonalkód" dataObjectRef="do_vonalkod_do" />
    <bpmn:dataObject id="do_vonalkod_do" />
    <bpmn:dataStoreReference id="ds_mes" name="MES rendszer" />
    <bpmn:startEvent id="start1" name="Nyersanyag érkezik">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_darabolo_msg" name="Műhelyrajz átadva">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_darabolo_msg_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_vagas" name="Nyersanyag méretre vágása a műhelyrajz paraméterei szerint">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:property id="task_vagas_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_vagas_dia0">
        <bpmn:sourceRef>do_muhelyrajz</bpmn:sourceRef>
        <bpmn:targetRef>task_vagas_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_scan" name="Vonalkód beolvasása scannerrel">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:property id="task_scan_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_scan_dia0">
        <bpmn:sourceRef>do_vonalkod</bpmn:sourceRef>
        <bpmn:targetRef>task_scan_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_mes1" name="Alkatrész státusz rögzítése MES-ben">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mes1_doa0">
        <bpmn:targetRef>ds_mes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf1" sourceRef="start1" targetRef="task_vagas" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task_vagas" targetRef="task_scan" />
    <bpmn:sequenceFlow id="sf3" sourceRef="task_scan" targetRef="task_mes1" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task_mes1" targetRef="end_darabolo_msg" />
  </bpmn:process>
  <bpmn:process id="pool_forgacs_elokesz_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_alkatreszjegyzek" name="Darabolt alkatrészjegyzék" dataObjectRef="do_alkatreszjegyzek_do" />
    <bpmn:dataObject id="do_alkatreszjegyzek_do" />
    <bpmn:dataStoreReference id="ds_mes_p1" name="MES rendszer" />
    <bpmn:dataObjectReference id="do_cnc_program" name="CNC program" dataObjectRef="do_cnc_program_do" />
    <bpmn:dataObject id="do_cnc_program_do" />
    <bpmn:startEvent id="start_forgacs_elokesz_msg" name="Műhelyrajz megérkezik">
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_forgacs_elokesz_msg_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_cnc_atadas_msg" name="CNC megmunkálásra átadva">
      <bpmn:incoming>f_program_van</bpmn:incoming>
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_cnc_atadas_msg_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_hagyomanyos" name="Hagyományos megmunkálás ág vége">
      <bpmn:incoming>f_tipus_hagyomanyos</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_kiszervezes" name="Kiszervezés ág vége">
      <bpmn:incoming>f_tipus_kiszervezes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_rogzit_alkatreszjegyzek" name="Darabolt alkatrészjegyzék rögzítése">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_rogzit_alkatreszjegyzek_doa0">
        <bpmn:targetRef>do_alkatreszjegyzek</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_mes2" name="Státusz váltás MES-ben">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mes2_doa0">
        <bpmn:targetRef>ds_mes_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_megmunk_tipus" name="Megmunkálás típusának meghatározása">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:property id="task_megmunk_tipus_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_megmunk_tipus_dia0">
        <bpmn:sourceRef>do_alkatreszjegyzek</bpmn:sourceRef>
        <bpmn:targetRef>task_megmunk_tipus_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_cnc_program_ellenorzes" name="CNC program meglétének ellenőrzése">
      <bpmn:incoming>f_tipus_cnc</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="task_cnc_program_ellenorzes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_cnc_program_ellenorzes_dia0">
        <bpmn:sourceRef>do_cnc_program</bpmn:sourceRef>
        <bpmn:targetRef>task_cnc_program_ellenorzes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_ertesit_programozo" name="CNC programozó értesítése">
      <bpmn:incoming>f_program_hianyzik</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_tipus" name="Megmunkálás típusa" isMarkerVisible="true">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>f_tipus_cnc</bpmn:outgoing>
      <bpmn:outgoing>f_tipus_hagyomanyos</bpmn:outgoing>
      <bpmn:outgoing>f_tipus_kiszervezes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_cnc_program" name="CNC program megvan?" isMarkerVisible="true">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>f_program_hianyzik</bpmn:outgoing>
      <bpmn:outgoing>f_program_van</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf5" sourceRef="start_forgacs_elokesz_msg" targetRef="task_rogzit_alkatreszjegyzek" />
    <bpmn:sequenceFlow id="sf6" sourceRef="task_rogzit_alkatreszjegyzek" targetRef="task_mes2" />
    <bpmn:sequenceFlow id="sf7" sourceRef="task_mes2" targetRef="task_megmunk_tipus" />
    <bpmn:sequenceFlow id="sf8" sourceRef="task_megmunk_tipus" targetRef="gw_tipus" />
    <bpmn:sequenceFlow id="f_tipus_cnc" sourceRef="gw_tipus" targetRef="task_cnc_program_ellenorzes" name="CNC" />
    <bpmn:sequenceFlow id="f_tipus_hagyomanyos" sourceRef="gw_tipus" targetRef="end_hagyomanyos" name="hagyományos" />
    <bpmn:sequenceFlow id="f_tipus_kiszervezes" sourceRef="gw_tipus" targetRef="end_kiszervezes" name="kiszervezés" />
    <bpmn:sequenceFlow id="sf9" sourceRef="task_cnc_program_ellenorzes" targetRef="gw_cnc_program" />
    <bpmn:sequenceFlow id="f_program_hianyzik" sourceRef="gw_cnc_program" targetRef="task_ertesit_programozo" name="hiányzik" />
    <bpmn:sequenceFlow id="f_program_van" sourceRef="gw_cnc_program" targetRef="end_cnc_atadas_msg" name="van" />
    <bpmn:sequenceFlow id="sf10" sourceRef="task_ertesit_programozo" targetRef="end_cnc_atadas_msg" />
  </bpmn:process>
  <bpmn:process id="pool_forgacs_uzem_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_vonalkod_p1" name="Vonalkód" dataObjectRef="do_vonalkod_p1_do" />
    <bpmn:dataObject id="do_vonalkod_p1_do" />
    <bpmn:dataStoreReference id="ds_cnc_program_server" name="CNC programszerver" />
    <bpmn:dataObjectReference id="do_cnc_program_p1" name="CNC program" dataObjectRef="do_cnc_program_p1_do" />
    <bpmn:dataObject id="do_cnc_program_p1_do" />
    <bpmn:dataObjectReference id="do_szerszamlista" name="Szerszámlista" dataObjectRef="do_szerszamlista_do" />
    <bpmn:dataObject id="do_szerszamlista_do" />
    <bpmn:dataObjectReference id="do_korrekcios_ertekek" name="Hossz és korrekciós értékek" dataObjectRef="do_korrekcios_ertekek_do" />
    <bpmn:dataObject id="do_korrekcios_ertekek_do" />
    <bpmn:dataStoreReference id="ds_mes_p2" name="MES rendszer" />
    <bpmn:startEvent id="start_cnc_msg" name="Alkatrész megérkezik CNC megmunkálásra">
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_cnc_msg_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_kesz" name="Termék elkészült">
      <bpmn:incoming>sf24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_beazonositas" name="Beazonosítás vonalkód olvasással">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:incoming>f_ujabb_igen</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:property id="task_beazonositas_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_beazonositas_dia0">
        <bpmn:sourceRef>do_vonalkod_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_beazonositas_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:serviceTask id="task_letoltes_cnc_program" name="CNC program letöltése a programszerverről">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:property id="task_letoltes_cnc_program_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_letoltes_cnc_program_dia0">
        <bpmn:sourceRef>ds_cnc_program_server</bpmn:sourceRef>
        <bpmn:targetRef>task_letoltes_cnc_program_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_letoltes_cnc_program_doa0">
        <bpmn:targetRef>do_cnc_program_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:manualTask id="task_satu_csere" name="Satu cseréje">
      <bpmn:incoming>f_satu_igen</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_alapanyag_rogzit" name="Alapanyag rögzítése a satuban">
      <bpmn:incoming>f_satu_nem</bpmn:incoming>
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_szerszamlista_ellenorzes" name="Szerszámlista ellenőrzése a CNC program alapján">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:property id="task_szerszamlista_ellenorzes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_szerszamlista_ellenorzes_dia0">
        <bpmn:sourceRef>do_cnc_program_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_szerszamlista_ellenorzes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_szerszamlista_ellenorzes_doa0">
        <bpmn:targetRef>do_szerszamlista</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_ajto_zar1" name="CNC gép ajtajának zárása (megfelelő szerszámok esetén)">
      <bpmn:incoming>f_szerszam_megfelelo</bpmn:incoming>
      <bpmn:outgoing>sf19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_uj_szerszam" name="Új szerszám rögzítése">
      <bpmn:incoming>f_szerszam_csere</bpmn:incoming>
      <bpmn:outgoing>sf17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_hossz_korrekcio" name="Hossz és korrekciós értékek felvitele">
      <bpmn:incoming>sf17</bpmn:incoming>
      <bpmn:outgoing>sf18</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_hossz_korrekcio_doa0">
        <bpmn:targetRef>do_korrekcios_ertekek</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_ajto_zar2" name="CNC gép ajtajának zárása (csere után)">
      <bpmn:incoming>sf18</bpmn:incoming>
      <bpmn:outgoing>sf20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="task_forgacsolas" name="Alapanyag forgácsolása">
      <bpmn:incoming>sf19</bpmn:incoming>
      <bpmn:incoming>sf20</bpmn:incoming>
      <bpmn:outgoing>sf21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="task_ajto_nyit" name="CNC gép ajtajának nyitása">
      <bpmn:incoming>sf21</bpmn:incoming>
      <bpmn:outgoing>sf22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_satu_old" name="Satu oldása">
      <bpmn:incoming>sf22</bpmn:incoming>
      <bpmn:outgoing>sf23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_mes_vegso" name="Termék elkészültségének jelzése MES-ben">
      <bpmn:incoming>f_ujabb_nem</bpmn:incoming>
      <bpmn:outgoing>sf24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mes_vegso_doa0">
        <bpmn:targetRef>ds_mes_p2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_satu_csere" name="Satu csere szükséges?" isMarkerVisible="true">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:outgoing>f_satu_igen</bpmn:outgoing>
      <bpmn:outgoing>f_satu_nem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_szerszam_csere" name="Szerszám csere szükséges?" isMarkerVisible="true">
      <bpmn:incoming>sf16</bpmn:incoming>
      <bpmn:outgoing>f_szerszam_megfelelo</bpmn:outgoing>
      <bpmn:outgoing>f_szerszam_csere</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_ujabb_megmunkalas" name="Van szükség újabb megmunkálásra?" isMarkerVisible="true">
      <bpmn:incoming>sf23</bpmn:incoming>
      <bpmn:outgoing>f_ujabb_igen</bpmn:outgoing>
      <bpmn:outgoing>f_ujabb_nem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf11" sourceRef="start_cnc_msg" targetRef="task_beazonositas" />
    <bpmn:sequenceFlow id="sf12" sourceRef="task_beazonositas" targetRef="task_letoltes_cnc_program" />
    <bpmn:sequenceFlow id="sf13" sourceRef="task_letoltes_cnc_program" targetRef="gw_satu_csere" />
    <bpmn:sequenceFlow id="f_satu_igen" sourceRef="gw_satu_csere" targetRef="task_satu_csere" name="igen" />
    <bpmn:sequenceFlow id="f_satu_nem" sourceRef="gw_satu_csere" targetRef="task_alapanyag_rogzit" name="nem" />
    <bpmn:sequenceFlow id="sf14" sourceRef="task_satu_csere" targetRef="task_alapanyag_rogzit" />
    <bpmn:sequenceFlow id="sf15" sourceRef="task_alapanyag_rogzit" targetRef="task_szerszamlista_ellenorzes" />
    <bpmn:sequenceFlow id="sf16" sourceRef="task_szerszamlista_ellenorzes" targetRef="gw_szerszam_csere" />
    <bpmn:sequenceFlow id="f_szerszam_megfelelo" sourceRef="gw_szerszam_csere" targetRef="task_ajto_zar1" name="megfelelő" />
    <bpmn:sequenceFlow id="f_szerszam_csere" sourceRef="gw_szerszam_csere" targetRef="task_uj_szerszam" name="csere szükséges" />
    <bpmn:sequenceFlow id="sf17" sourceRef="task_uj_szerszam" targetRef="task_hossz_korrekcio" />
    <bpmn:sequenceFlow id="sf18" sourceRef="task_hossz_korrekcio" targetRef="task_ajto_zar2" />
    <bpmn:sequenceFlow id="sf19" sourceRef="task_ajto_zar1" targetRef="task_forgacsolas" />
    <bpmn:sequenceFlow id="sf20" sourceRef="task_ajto_zar2" targetRef="task_forgacsolas" />
    <bpmn:sequenceFlow id="sf21" sourceRef="task_forgacsolas" targetRef="task_ajto_nyit" />
    <bpmn:sequenceFlow id="sf22" sourceRef="task_ajto_nyit" targetRef="task_satu_old" />
    <bpmn:sequenceFlow id="sf23" sourceRef="task_satu_old" targetRef="gw_ujabb_megmunkalas" />
    <bpmn:sequenceFlow id="f_ujabb_igen" sourceRef="gw_ujabb_megmunkalas" targetRef="task_beazonositas" name="igen" />
    <bpmn:sequenceFlow id="f_ujabb_nem" sourceRef="gw_ujabb_megmunkalas" targetRef="task_mes_vegso" name="nem" />
    <bpmn:sequenceFlow id="sf24" sourceRef="task_mes_vegso" targetRef="end_kesz" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_darabolo_part_di" bpmnElement="pool_darabolo_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1140" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_forgacs_elokesz_part_di" bpmnElement="pool_forgacs_elokesz_part" isHorizontal="true">
        <dc:Bounds x="120" y="375" width="1900" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_forgacs_uzem_part_di" bpmnElement="pool_forgacs_uzem_part" isHorizontal="true">
        <dc:Bounds x="120" y="960" width="3040" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_cnc_atadas_msg_di" bpmnElement="end_cnc_atadas_msg">
        <dc:Bounds x="1680" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_darabolo_msg_di" bpmnElement="end_darabolo_msg">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_hagyomanyos_di" bpmnElement="end_hagyomanyos">
        <dc:Bounds x="1110" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_kesz_di" bpmnElement="end_kesz">
        <dc:Bounds x="2820" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_kiszervezes_di" bpmnElement="end_kiszervezes">
