<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_darabolo_part" name="Daraboló üzem" processRef="pool_darabolo_proc" />
    <bpmn:participant id="pool_elokeszito_part" name="Forgácsoló gyártáselőkészítő" processRef="pool_elokeszito_proc" />
    <bpmn:participant id="pool_programozo_part" name="CNC programozó" processRef="pool_programozo_proc" />
    <bpmn:participant id="pool_cnc_part" name="Forgácsoló üzem (CNC)" processRef="pool_cnc_proc" />
    <bpmn:messageFlow id="mf_1" sourceRef="end_darabolo" targetRef="start_elokeszito" name="Műhelyrajz és darabolt alapanyag átadása" />
    <bpmn:messageFlow id="mf_2" sourceRef="end_elokeszito_programozo" targetRef="start_programozo" name="CNC programozó értesítése" />
    <bpmn:messageFlow id="mf_3" sourceRef="end_elokeszito_cnc" targetRef="start_cnc" name="Átadás CNC megmunkálásra" />
  </bpmn:collaboration>
  <bpmn:process id="pool_darabolo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_muhelyrajz" name="Műhelyrajz" dataObjectRef="data_muhelyrajz_do" />
    <bpmn:dataObject id="data_muhelyrajz_do" />
    <bpmn:dataStoreReference id="store_mes" name="MES rendszer" />
    <bpmn:startEvent id="start_1" name="Process start">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_darabolo" name="Műhelyrajz továbbítva">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_darabolo_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_1" name="Nyersanyag méretre vágása">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
      <bpmn:property id="task_1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_1_dia0">
        <bpmn:sourceRef>data_muhelyrajz</bpmn:sourceRef>
        <bpmn:targetRef>task_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_2" name="Vonalkódok beolvasása scannerrel">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_3" name="Alkatrész státuszának rögzítése MES rendszereben">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:property id="task_3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_3_dia0">
        <bpmn:sourceRef>data_muhelyrajz</bpmn:sourceRef>
        <bpmn:targetRef>task_3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_3_doa0">
        <bpmn:targetRef>store_mes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_1" sourceRef="start_1" targetRef="task_1" />
    <bpmn:sequenceFlow id="sf_2" sourceRef="task_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="sf_3" sourceRef="task_2" targetRef="task_3" />
    <bpmn:sequenceFlow id="sf_4" sourceRef="task_3" targetRef="end_darabolo" />
  </bpmn:process>
  <bpmn:process id="pool_elokeszito_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_alkatreszjegyzek" name="Darabolt alkatrészjegyzék" dataObjectRef="data_alkatreszjegyzek_do" />
    <bpmn:dataObject id="data_alkatreszjegyzek_do" />
    <bpmn:dataStoreReference id="store_mes_p1" name="MES rendszer" />
    <bpmn:dataStoreReference id="store_programserver" name="CNC programszerver" />
    <bpmn:startEvent id="start_elokeszito" name="Műhelyrajz beérkezett">
      <bpmn:outgoing>sf_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_elokeszito_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_elokeszito_programozo" name="Értesítés küldve CNC programozónak">
      <bpmn:incoming>sf_gw2_hianyzik</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_elokeszito_programozo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_elokeszito_cnc" name="Átadás CNC megmunkálásra">
      <bpmn:incoming>sf_gw2_van</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_elokeszito_cnc_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_4" name="Darabolt alkatrészjegyzék rögzítése és státuszváltás MES-ben">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:property id="task_4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_4_dia0">
        <bpmn:sourceRef>data_alkatreszjegyzek</bpmn:sourceRef>
        <bpmn:targetRef>task_4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_4_doa0">
        <bpmn:targetRef>store_mes_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_5" name="Megmunkálási típus vizsgálata és meghatározása">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_6" name="CNC program meglétének ellenőrzése">
      <bpmn:incoming>sf_gw1_cnc</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
      <bpmn:property id="task_6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_6_dia0">
        <bpmn:sourceRef>store_programserver</bpmn:sourceRef>
        <bpmn:targetRef>task_6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_megmunkalas_tipus" name="Megmunkálás típusa" isMarkerVisible="true">
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_gw1_cnc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_cnc_program_check" name="CNC program megvan?" isMarkerVisible="true">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_gw2_hianyzik</bpmn:outgoing>
      <bpmn:outgoing>sf_gw2_van</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_5" sourceRef="start_elokeszito" targetRef="task_4" />
    <bpmn:sequenceFlow id="sf_6" sourceRef="task_4" targetRef="task_5" />
    <bpmn:sequenceFlow id="sf_7" sourceRef="task_5" targetRef="gw_megmunkalas_tipus" />
    <bpmn:sequenceFlow id="sf_gw1_cnc" sourceRef="gw_megmunkalas_tipus" targetRef="task_6" name="CNC" />
    <bpmn:sequenceFlow id="sf_8" sourceRef="task_6" targetRef="gw_cnc_program_check" />
    <bpmn:sequenceFlow id="sf_gw2_hianyzik" sourceRef="gw_cnc_program_check" targetRef="end_elokeszito_programozo" name="Hiányzik" />
    <bpmn:sequenceFlow id="sf_gw2_van" sourceRef="gw_cnc_program_check" targetRef="end_elokeszito_cnc" name="Van" />
  </bpmn:process>
  <bpmn:process id="pool_programozo_proc" isExecutable="false">
    <bpmn:dataStoreReference id="store_programserver_p1" name="CNC programszerver" />
    <bpmn:startEvent id="start_programozo" name="Értesítés hiányzó programról beérkezett">
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_programozo_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_programozo" name="CNC program elkészítve">
      <bpmn:incoming>sf_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_7" name="CNC program elkészítése">
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_7_doa0">
        <bpmn:targetRef>store_programserver_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_9" sourceRef="start_programozo" targetRef="task_7" />
    <bpmn:sequenceFlow id="sf_10" sourceRef="task_7" targetRef="end_programozo" />
  </bpmn:process>
  <bpmn:process id="pool_cnc_proc" isExecutable="false">
    <bpmn:dataStoreReference id="store_programserver_p2" name="CNC programszerver" />
    <bpmn:dataObjectReference id="data_cnc_program" name="CNC program" dataObjectRef="data_cnc_program_do" />
    <bpmn:dataObject id="data_cnc_program_do" />
    <bpmn:dataObjectReference id="data_szerszamlista" name="Szerszámlista" dataObjectRef="data_szerszamlista_do" />
    <bpmn:dataObject id="data_szerszamlista_do" />
    <bpmn:dataStoreReference id="store_mes_p2" name="MES rendszer" />
    <bpmn:startEvent id="start_cnc" name="Megmunkálási megbízás beérkezett">
      <bpmn:outgoing>sf_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_cnc_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_cnc" name="CNC megmunkálás befejeződött">
      <bpmn:incoming>sf_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_8" name="Beazonosítás vonalkód olvasással">
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_9" name="CNC program letöltése a programszerverről">
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
      <bpmn:property id="task_9_prop" name="__targetRef_placeholder" />
