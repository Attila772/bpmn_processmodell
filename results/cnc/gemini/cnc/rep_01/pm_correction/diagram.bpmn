      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_9_doa0">
        <bpmn:targetRef>data_cnc_program</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_10" name="Satu ellenőrzése">
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:incoming>sf_gw5_igen</bpmn:incoming>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_11" name="Satu cseréje">
      <bpmn:incoming>sf_gw3_igen</bpmn:incoming>
      <bpmn:outgoing>sf_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_12" name="Alapanyag rögzítése a satuban">
      <bpmn:incoming>sf_16</bpmn:incoming>
      <bpmn:outgoing>sf_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_13" name="Szerszámlista ellenőrzése">
      <bpmn:incoming>sf_17</bpmn:incoming>
      <bpmn:outgoing>sf_18</bpmn:outgoing>
      <bpmn:property id="task_13_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_13_dia0">
        <bpmn:sourceRef>data_szerszamlista</bpmn:sourceRef>
        <bpmn:targetRef>task_13_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_13_dia1">
        <bpmn:sourceRef>data_cnc_program</bpmn:sourceRef>
        <bpmn:targetRef>task_13_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_14" name="Új szerszám rögzítése és hossz, korrekciós értékek felvitele">
      <bpmn:incoming>sf_gw4_csere_szukseges</bpmn:incoming>
      <bpmn:outgoing>sf_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_15" name="CNC gép ajtajának zárása">
      <bpmn:incoming>sf_gw4_megfelelo</bpmn:incoming>
      <bpmn:incoming>sf_19</bpmn:incoming>
      <bpmn:outgoing>sf_20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_16" name="Alapanyag forgácsolása">
      <bpmn:incoming>sf_20</bpmn:incoming>
      <bpmn:outgoing>sf_21</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_17" name="Ajtó nyitása és satu oldása">
      <bpmn:incoming>sf_21</bpmn:incoming>
      <bpmn:outgoing>sf_22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_18" name="Megmunkálás elkészültségének vizsgálata">
      <bpmn:incoming>sf_22</bpmn:incoming>
      <bpmn:outgoing>sf_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_19" name="Termék elkészültségének jelzése státuszváltással a MES-ben">
      <bpmn:incoming>sf_gw5_nem</bpmn:incoming>
      <bpmn:outgoing>sf_24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_19_doa0">
        <bpmn:targetRef>store_mes_p2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_satu_csere" name="Szükség van satu cserére?" isMarkerVisible="true">
      <bpmn:incoming>sf_14</bpmn:incoming>
      <bpmn:outgoing>sf_gw3_igen</bpmn:outgoing>
      <bpmn:outgoing>sf_gw3_nem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_satu_join" name="Satu előkészítve" isMarkerVisible="true">
      <bpmn:incoming>sf_15</bpmn:incoming>
      <bpmn:incoming>sf_gw3_nem</bpmn:incoming>
      <bpmn:outgoing>sf_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_szerszam_csere" name="Megfelelő szerszámok vannak betárazva?" isMarkerVisible="true">
      <bpmn:incoming>sf_18</bpmn:incoming>
      <bpmn:outgoing>sf_gw4_megfelelo</bpmn:outgoing>
      <bpmn:outgoing>sf_gw4_csere_szukseges</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_ujabb_megmunkalas" name="Van-e szükség újabb megmunkálásra?" isMarkerVisible="true">
      <bpmn:incoming>sf_23</bpmn:incoming>
      <bpmn:outgoing>sf_gw5_igen</bpmn:outgoing>
      <bpmn:outgoing>sf_gw5_nem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_11" sourceRef="start_cnc" targetRef="task_8" />
    <bpmn:sequenceFlow id="sf_12" sourceRef="task_8" targetRef="task_9" />
    <bpmn:sequenceFlow id="sf_13" sourceRef="task_9" targetRef="task_10" />
    <bpmn:sequenceFlow id="sf_14" sourceRef="task_10" targetRef="gw_satu_csere" />
    <bpmn:sequenceFlow id="sf_gw3_igen" sourceRef="gw_satu_csere" targetRef="task_11" name="Igen" />
    <bpmn:sequenceFlow id="sf_15" sourceRef="task_11" targetRef="gw_satu_join" />
    <bpmn:sequenceFlow id="sf_gw3_nem" sourceRef="gw_satu_csere" targetRef="gw_satu_join" name="Nem" />
