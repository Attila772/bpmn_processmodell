    <bpmn:sequenceFlow id="sf_17" sourceRef="task_12" targetRef="task_13" />
    <bpmn:sequenceFlow id="sf_18" sourceRef="task_13" targetRef="gw_szerszam_csere" />
    <bpmn:sequenceFlow id="sf_gw4_megfelelo" sourceRef="gw_szerszam_csere" targetRef="task_15" name="Megfelelő szerszámok vannak" />
    <bpmn:sequenceFlow id="sf_gw4_csere_szukseges" sourceRef="gw_szerszam_csere" targetRef="task_14" name="Szükség van cserére" />
    <bpmn:sequenceFlow id="sf_19" sourceRef="task_14" targetRef="task_15" />
    <bpmn:sequenceFlow id="sf_20" sourceRef="task_15" targetRef="task_16" />
    <bpmn:sequenceFlow id="sf_21" sourceRef="task_16" targetRef="task_17" />
    <bpmn:sequenceFlow id="sf_22" sourceRef="task_17" targetRef="task_18" />
    <bpmn:sequenceFlow id="sf_23" sourceRef="task_18" targetRef="gw_ujabb_megmunkalas" />
    <bpmn:sequenceFlow id="sf_gw5_igen" sourceRef="gw_ujabb_megmunkalas" targetRef="task_10" name="Igen" />
    <bpmn:sequenceFlow id="sf_gw5_nem" sourceRef="gw_ujabb_megmunkalas" targetRef="task_19" name="Nem" />
    <bpmn:sequenceFlow id="sf_24" sourceRef="task_19" targetRef="end_cnc" />
  </bpmn:process>
