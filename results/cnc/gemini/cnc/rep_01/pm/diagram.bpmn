      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_8_doa0">
        <bpmn:targetRef>data_cnc_program</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_9" name="Satu ellenőrzése">
      <bpmn:incoming>sf_cnc_3</bpmn:incoming>
      <bpmn:incoming>sf_ujabb_yes</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_10" name="Satu cseréje">
      <bpmn:incoming>sf_satu_yes</bpmn:incoming>
      <bpmn:outgoing>sf_satu_join_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_11" name="Alapanyag rögzítése a satuban">
      <bpmn:incoming>sf_cnc_5</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_12" name="Szerszámlista ellenőrzése a CNC programból">
      <bpmn:incoming>sf_cnc_6</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_7</bpmn:outgoing>
      <bpmn:property id="task_12_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_12_dia0">
        <bpmn:sourceRef>data_cnc_program</bpmn:sourceRef>
        <bpmn:targetRef>task_12_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_12_dia1">
        <bpmn:sourceRef>data_szerszamlista</bpmn:sourceRef>
        <bpmn:targetRef>task_12_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_13" name="Új szerszám rögzítése, hossz és korrekciós értékek felvitele">
      <bpmn:incoming>sf_szerszam_no</bpmn:incoming>
      <bpmn:outgoing>sf_szerszam_join_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_14" name="CNC gép ajtajának zárása">
      <bpmn:incoming>sf_cnc_8</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_15" name="Alapanyag forgácsolása">
      <bpmn:incoming>sf_cnc_9</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_16" name="Ajtó nyitása és satu oldása">
      <bpmn:incoming>sf_cnc_10</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_17" name="Megmunkálás elkészültségének vizsgálata">
      <bpmn:incoming>sf_cnc_11</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_18" name="Termék elkészültségének jelzése státuszváltással a MES-ben">
      <bpmn:incoming>sf_ujabb_no</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_18_doa0">
        <bpmn:targetRef>store_mes_p2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_satu" name="Szükség van satu cserére?" isMarkerVisible="true">
      <bpmn:incoming>sf_cnc_4</bpmn:incoming>
      <bpmn:outgoing>sf_satu_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_satu_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_satu_join" name="Satu előkészítés egyesítése" isMarkerVisible="true">
      <bpmn:incoming>sf_satu_no</bpmn:incoming>
      <bpmn:incoming>sf_satu_join_1</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_szerszam" name="Megfelelő szerszámok vannak betárazva?" isMarkerVisible="true">
      <bpmn:incoming>sf_cnc_7</bpmn:incoming>
      <bpmn:outgoing>sf_szerszam_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_szerszam_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_szerszam_join" name="Szerszám beállítás egyesítése" isMarkerVisible="true">
      <bpmn:incoming>sf_szerszam_yes</bpmn:incoming>
      <bpmn:incoming>sf_szerszam_join_1</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_ujabb_megmunkalas" name="Szükség van újabb megmunkálásra?" isMarkerVisible="true">
      <bpmn:incoming>sf_cnc_12</bpmn:incoming>
      <bpmn:outgoing>sf_ujabb_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_ujabb_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_cnc_1" sourceRef="start_ev_cnc_uzem" targetRef="task_7" />
    <bpmn:sequenceFlow id="sf_cnc_2" sourceRef="task_7" targetRef="task_8" />
    <bpmn:sequenceFlow id="sf_cnc_3" sourceRef="task_8" targetRef="task_9" />
    <bpmn:sequenceFlow id="sf_cnc_4" sourceRef="task_9" targetRef="gw_satu" />
