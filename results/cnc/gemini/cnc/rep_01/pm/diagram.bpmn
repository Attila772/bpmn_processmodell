  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_darabolo_part" name="Daraboló üzem" processRef="pool_darabolo_proc" />
    <bpmn:participant id="pool_elokeszito_part" name="Forgácsoló gyártáselőkészítő" processRef="pool_elokeszito_proc" />
    <bpmn:participant id="pool_forgacsolo_part" name="Forgácsoló üzem" processRef="pool_forgacsolo_proc" />
    <bpmn:messageFlow id="mf_darab_to_elok" sourceRef="end_ev_darab_send" targetRef="start_ev_elokeszito" name="Műhelyrajz és darabolt alapanyag" />
    <bpmn:messageFlow id="mf_elok_to_cnc" sourceRef="end_ev_elokeszito_cnc" targetRef="start_ev_cnc_uzem" name="CNC megmunkálási feladat" />
  </bpmn:collaboration>
  <bpmn:process id="pool_darabolo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_muhelyrajz" name="Műhelyrajz" dataObjectRef="data_muhelyrajz_do" />
    <bpmn:dataObject id="data_muhelyrajz_do" />
    <bpmn:dataObjectReference id="data_vonalkod" name="Vonalkód" dataObjectRef="data_vonalkod_do" />
    <bpmn:dataObject id="data_vonalkod_do" />
    <bpmn:dataStoreReference id="store_mes" name="MES rendszer" />
    <bpmn:startEvent id="start_ev_1" name="Nyersanyag megérkezése">
      <bpmn:outgoing>sf_darab_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_ev_darab_send" name="Műhelyrajz és alapanyag továbbítva">
      <bpmn:incoming>sf_darab_4</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_ev_darab_send_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_1" name="Nyersanyag méretre vágása">
      <bpmn:incoming>sf_darab_1</bpmn:incoming>
      <bpmn:outgoing>sf_darab_2</bpmn:outgoing>
      <bpmn:property id="task_1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_1_dia0">
        <bpmn:sourceRef>data_muhelyrajz</bpmn:sourceRef>
        <bpmn:targetRef>task_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_2" name="Vonalkódok beolvasása scannerrel">
      <bpmn:incoming>sf_darab_2</bpmn:incoming>
      <bpmn:outgoing>sf_darab_3</bpmn:outgoing>
      <bpmn:property id="task_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_2_dia0">
        <bpmn:sourceRef>data_vonalkod</bpmn:sourceRef>
        <bpmn:targetRef>task_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_3" name="Alkatrész státusz rögzítése MES-ben">
      <bpmn:incoming>sf_darab_3</bpmn:incoming>
      <bpmn:outgoing>sf_darab_4</bpmn:outgoing>
      <bpmn:property id="task_3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_3_dia0">
        <bpmn:sourceRef>data_muhelyrajz</bpmn:sourceRef>
        <bpmn:targetRef>task_3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_3_doa0">
        <bpmn:targetRef>store_mes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_darab_1" sourceRef="start_ev_1" targetRef="task_1" />
    <bpmn:sequenceFlow id="sf_darab_2" sourceRef="task_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="sf_darab_3" sourceRef="task_2" targetRef="task_3" />
    <bpmn:sequenceFlow id="sf_darab_4" sourceRef="task_3" targetRef="end_ev_darab_send" />
  </bpmn:process>
  <bpmn:process id="pool_elokeszito_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_alkatreszjegyzek" name="Darabolt alkatrészjegyzék" dataObjectRef="data_alkatreszjegyzek_do" />
    <bpmn:dataObject id="data_alkatreszjegyzek_do" />
    <bpmn:dataStoreReference id="store_mes_p1" name="MES rendszer" />
    <bpmn:dataStoreReference id="store_cnc_server" name="CNC programszerver" />
    <bpmn:startEvent id="start_ev_elokeszito" name="Műhelyrajz és alapanyag beérkezése">
      <bpmn:outgoing>sf_elok_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_ev_elokeszito_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_ev_elokeszito_cnc" name="Átadás CNC megmunkálásra">
      <bpmn:incoming>sf_prog_yes</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_ev_elokeszito_cnc_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_ev_prog_notify" name="CNC programozó értesítve">
      <bpmn:incoming>sf_prog_no</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_ev_prog_notify_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_4" name="Darabolt alkatrészjegyzék rögzítése és státuszváltás MES-ben">
      <bpmn:incoming>sf_elok_1</bpmn:incoming>
      <bpmn:outgoing>sf_elok_2</bpmn:outgoing>
      <bpmn:property id="task_4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_4_dia0">
        <bpmn:sourceRef>data_alkatreszjegyzek</bpmn:sourceRef>
        <bpmn:targetRef>task_4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_4_doa0">
        <bpmn:targetRef>store_mes_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_5" name="Megmunkálás típusának kiválasztása">
      <bpmn:incoming>sf_elok_2</bpmn:incoming>
      <bpmn:outgoing>sf_elok_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_6" name="CNC program meglétének ellenőrzése">
      <bpmn:incoming>sf_elok_3</bpmn:incoming>
      <bpmn:outgoing>sf_elok_4</bpmn:outgoing>
      <bpmn:property id="task_6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_6_dia0">
        <bpmn:sourceRef>store_cnc_server</bpmn:sourceRef>
        <bpmn:targetRef>task_6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_cnc_program" name="Van CNC program?" isMarkerVisible="true">
      <bpmn:incoming>sf_elok_4</bpmn:incoming>
      <bpmn:outgoing>sf_prog_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_prog_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_elok_1" sourceRef="start_ev_elokeszito" targetRef="task_4" />
    <bpmn:sequenceFlow id="sf_elok_2" sourceRef="task_4" targetRef="task_5" />
    <bpmn:sequenceFlow id="sf_elok_3" sourceRef="task_5" targetRef="task_6" name="CNC vonal" />
    <bpmn:sequenceFlow id="sf_elok_4" sourceRef="task_6" targetRef="gw_cnc_program" />
    <bpmn:sequenceFlow id="sf_prog_yes" sourceRef="gw_cnc_program" targetRef="end_ev_elokeszito_cnc" name="van" />
    <bpmn:sequenceFlow id="sf_prog_no" sourceRef="gw_cnc_program" targetRef="end_ev_prog_notify" name="hiányzik" />
  </bpmn:process>
  <bpmn:process id="pool_forgacsolo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vonalkod_p1" name="Vonalkód" dataObjectRef="data_vonalkod_p1_do" />
    <bpmn:dataObject id="data_vonalkod_p1_do" />
    <bpmn:dataStoreReference id="store_cnc_server_p1" name="CNC programszerver" />
    <bpmn:dataObjectReference id="data_cnc_program" name="CNC program" dataObjectRef="data_cnc_program_do" />
    <bpmn:dataObject id="data_cnc_program_do" />
    <bpmn:dataObjectReference id="data_szerszamlista" name="Szerszámlista" dataObjectRef="data_szerszamlista_do" />
    <bpmn:dataObject id="data_szerszamlista_do" />
    <bpmn:dataStoreReference id="store_mes_p2" name="MES rendszer" />
    <bpmn:startEvent id="start_ev_cnc_uzem" name="CNC megmunkálási feladat beérkezett">
      <bpmn:outgoing>sf_cnc_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_ev_cnc_uzem_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_ev_cnc_uzem" name="CNC megmunkálás befejeződött">
      <bpmn:incoming>sf_cnc_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_7" name="Beazonosítás vonalkód olvasással">
      <bpmn:incoming>sf_cnc_1</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_2</bpmn:outgoing>
      <bpmn:property id="task_7_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_7_dia0">
        <bpmn:sourceRef>data_vonalkod_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_7_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_8" name="CNC program letöltése a programszerverről">
      <bpmn:incoming>sf_cnc_2</bpmn:incoming>
      <bpmn:outgoing>sf_cnc_3</bpmn:outgoing>
      <bpmn:property id="task_8_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_8_dia0">
