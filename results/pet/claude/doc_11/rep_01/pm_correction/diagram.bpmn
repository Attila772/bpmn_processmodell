<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_customer_part" name="Customer" processRef="pool_customer_proc" />
    <bpmn:participant id="pool_cs_part" name="Customer Service" processRef="pool_cs_proc" />
    <bpmn:participant id="pool_sm_part" name="Service Management" processRef="pool_sm_proc" />
    <bpmn:participant id="pool_rp_part" name="Resource Provisioning" processRef="pool_rp_proc" />
    <bpmn:participant id="pool_bc_part" name="Billing &amp; Collections" processRef="pool_bc_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="ev_send_problem_params" targetRef="ev_cs_receive_params" name="Problem Parameter List" />
    <bpmn:messageFlow id="mf2" sourceRef="ev_send_detailed_report" targetRef="ev_sm_receive_detailed_report" name="Detailed Problem Report" />
    <bpmn:messageFlow id="mf3" sourceRef="ev_sm_send_to_rp" targetRef="ev_rp_receive_detailed_report" name="Detailed Problem Report" />
    <bpmn:messageFlow id="mf4" sourceRef="ev_rp_send_status_report" targetRef="ev_sm_receive_status_report" name="Status Report" />
    <bpmn:messageFlow id="mf5" sourceRef="ev_sm_send_no_problem" targetRef="ev_cs_receive_result" name="Actual Service Performance" />
    <bpmn:messageFlow id="mf6" sourceRef="ev_sm_send_resolution_minor" targetRef="ev_cs_receive_result" name="Problem Resolution Report" />
    <bpmn:messageFlow id="mf7" sourceRef="ev_sm_send_restoration_request" targetRef="ev_rp_wait_restoration_request" name="Restoration Request" />
    <bpmn:messageFlow id="mf8" sourceRef="ev_rp_send_troubleshooting_report" targetRef="ev_sm_receive_troubleshoot_report" name="Trouble-shooting Report" />
    <bpmn:messageFlow id="mf9" sourceRef="ev_sm_send_resolution_restoration" targetRef="ev_cs_receive_result" name="Problem Resolution Report" />
    <bpmn:messageFlow id="mf10" sourceRef="ev_send_customer_report" targetRef="ev_receive_report_customer" name="Service Performance &amp; Resolution Report" />
    <bpmn:messageFlow id="mf11" sourceRef="ev_send_rebate_billing" targetRef="ev_bc_receive_rebate" name="SLA Violation Rebate" />
  </bpmn:collaboration>
  <bpmn:process id="pool_customer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_problem_params" name="Problem Parameter List" dataObjectRef="do_problem_params_do" />
    <bpmn:dataObject id="do_problem_params_do" />
    <bpmn:startEvent id="ev_start_customer" name="Customer perceives service degradation">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="ev_send_problem_params" name="Problem parameters sent">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:messageEventDefinition id="ev_send_problem_params_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="ev_receive_report_customer" name="Customer receives report">
      <bpmn:outgoing>f44</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_receive_report_customer_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ev_end_customer" name="Customer process end">
      <bpmn:incoming>f44</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_perceive_degradation" name="Customer perceives service degradation and compiles problem parameters">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_perceive_degradation_doa0">
        <bpmn:targetRef>do_problem_params</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="f1" sourceRef="ev_start_customer" targetRef="task_perceive_degradation" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_perceive_degradation" targetRef="ev_send_problem_params" />
    <bpmn:sequenceFlow id="f44" sourceRef="ev_receive_report_customer" targetRef="ev_end_customer" />
  </bpmn:process>
  <bpmn:process id="pool_cs_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_problem_params_p1" name="Problem Parameter List" dataObjectRef="do_problem_params_p1_do" />
    <bpmn:dataObject id="do_problem_params_p1_do" />
    <bpmn:dataObjectReference id="do_problem_report" name="Problem Report" dataObjectRef="do_problem_report_do" />
    <bpmn:dataObject id="do_problem_report_do" />
    <bpmn:dataObjectReference id="do_detailed_report" name="Detailed Problem Report" dataObjectRef="do_detailed_report_do" />
    <bpmn:dataObject id="do_detailed_report_do" />
    <bpmn:dataObjectReference id="do_customer_report" name="Customer Service Performance &amp; Resolution Report" dataObjectRef="do_customer_report_do" />
    <bpmn:dataObject id="do_customer_report_do" />
    <bpmn:dataObjectReference id="do_rebate_notice" name="SLA Violation Rebate Notice" dataObjectRef="do_rebate_notice_do" />
    <bpmn:dataObject id="do_rebate_notice_do" />
    <bpmn:startEvent id="ev_cs_receive_params" name="Problem parameters received">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_cs_receive_params_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="ev_link_premium_fix" name="Linked to premium problem fix process">
      <bpmn:incoming>flow_premium_yes</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ev_send_detailed_report" name="Detailed problem report sent">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:messageEventDefinition id="ev_send_detailed_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ev_cs_receive_result" name="Result received by Customer Service">
      <bpmn:outgoing>f34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_cs_receive_result_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="ev_send_customer_report" name="Report sent to customer">
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:outgoing>f38</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_send_customer_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_send_rebate_billing" name="SLA violation rebate sent to Billing">
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:outgoing>f40</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_send_rebate_billing_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_end_cs" name="Customer Service process end">
      <bpmn:incoming>f41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_enter_problem_report" name="Enter problem report into system T">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="task_enter_problem_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_enter_problem_report_dia0">
        <bpmn:sourceRef>do_problem_params_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_enter_problem_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_enter_problem_report_doa0">
        <bpmn:targetRef>do_problem_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_compare_sla" name="Compare problem report to customer SLA">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:property id="task_compare_sla_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_compare_sla_dia0">
        <bpmn:sourceRef>do_problem_report</bpmn:sourceRef>
        <bpmn:targetRef>task_compare_sla_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_determine_countermeasures" name="Determine necessary countermeasures and priorities">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_determine_significance" name="Determine customer significance (electronic service)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_reprioritize" name="Re-prioritize counter measures">
      <bpmn:incoming>flow_sig_yes</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_detailed_report" name="Create detailed problem report">
      <bpmn:incoming>flow_sig_no</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:property id="task_create_detailed_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_detailed_report_dia0">
        <bpmn:sourceRef>do_problem_report</bpmn:sourceRef>
        <bpmn:targetRef>task_create_detailed_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_detailed_report_doa0">
        <bpmn:targetRef>do_detailed_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_customer_report" name="Create report for customer on service performance and resolution">
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_customer_report_doa0">
        <bpmn:targetRef>do_customer_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_report_rebate" name="Report SLA violation rebate to Billing &amp; Collections">
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f39</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_report_rebate_doa0">
        <bpmn:targetRef>do_rebate_notice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_premium" name="Premium customer?" isMarkerVisible="true">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>flow_premium_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_premium_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_significance" name="Significance affects countermeasures?" isMarkerVisible="true">
      <bpmn:incoming>flow_premium_no</bpmn:incoming>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>flow_sig_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_sig_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_cs_result_type" name="Split concurrent CS activities">
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_cs_join" name="Join CS activities">
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:incoming>f40</bpmn:incoming>
      <bpmn:outgoing>f41</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="f3" sourceRef="ev_cs_receive_params" targetRef="task_enter_problem_report" />
    <bpmn:sequenceFlow id="f4" sourceRef="task_enter_problem_report" targetRef="task_compare_sla" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_compare_sla" targetRef="task_determine_countermeasures" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_determine_countermeasures" targetRef="task_determine_significance" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_determine_significance" targetRef="gw_premium" />
    <bpmn:sequenceFlow id="flow_premium_yes" sourceRef="gw_premium" targetRef="ev_link_premium_fix" name="premium" />
    <bpmn:sequenceFlow id="flow_premium_no" sourceRef="gw_premium" targetRef="gw_significance" name="not premium" />
    <bpmn:sequenceFlow id="f8" sourceRef="ev_link_premium_fix" targetRef="gw_significance" />
    <bpmn:sequenceFlow id="flow_sig_yes" sourceRef="gw_significance" targetRef="task_reprioritize" name="affects countermeasures" />
    <bpmn:sequenceFlow id="flow_sig_no" sourceRef="gw_significance" targetRef="task_create_detailed_report" name="does not affect countermeasures" />
    <bpmn:sequenceFlow id="f9" sourceRef="task_reprioritize" targetRef="task_create_detailed_report" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_create_detailed_report" targetRef="ev_send_detailed_report" />
    <bpmn:sequenceFlow id="f34" sourceRef="ev_cs_receive_result" targetRef="gw_cs_result_type" />
    <bpmn:sequenceFlow id="f35" sourceRef="gw_cs_result_type" targetRef="task_create_customer_report" />
    <bpmn:sequenceFlow id="f36" sourceRef="gw_cs_result_type" targetRef="task_report_rebate" />
    <bpmn:sequenceFlow id="f37" sourceRef="task_create_customer_report" targetRef="ev_send_customer_report" />
    <bpmn:sequenceFlow id="f38" sourceRef="ev_send_customer_report" targetRef="gw_cs_join" />
    <bpmn:sequenceFlow id="f39" sourceRef="task_report_rebate" targetRef="ev_send_rebate_billing" />
    <bpmn:sequenceFlow id="f40" sourceRef="ev_send_rebate_billing" targetRef="gw_cs_join" />
    <bpmn:sequenceFlow id="f41" sourceRef="gw_cs_join" targetRef="ev_end_cs" />
  </bpmn:process>
  <bpmn:process id="pool_sm_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_detailed_report_p1" name="Detailed Problem Report" dataObjectRef="do_detailed_report_p1_do" />
    <bpmn:dataObject id="do_detailed_report_p1_do" />
    <bpmn:dataObjectReference id="do_trouble_report_sm" name="Trouble Report (Service Management)" dataObjectRef="do_trouble_report_sm_do" />
    <bpmn:dataObject id="do_trouble_report_sm_do" />
    <bpmn:dataObjectReference id="do_status_report_p1" name="Status Report" dataObjectRef="do_status_report_p1_do" />
    <bpmn:dataObject id="do_status_report_p1_do" />
    <bpmn:dataObjectReference id="do_final_status_report" name="Final Status Report" dataObjectRef="do_final_status_report_do" />
    <bpmn:dataObject id="do_final_status_report_do" />
    <bpmn:dataObjectReference id="do_resolution_report" name="Problem Resolution Report" dataObjectRef="do_resolution_report_do" />
    <bpmn:dataObject id="do_resolution_report_do" />
    <bpmn:dataObjectReference id="do_restoration_request" name="Automatic Resource Restoration Request" dataObjectRef="do_restoration_request_do" />
    <bpmn:dataObject id="do_restoration_request_do" />
    <bpmn:dataObjectReference id="do_troubleshooting_report_p1" name="Trouble-shooting Report" dataObjectRef="do_troubleshooting_report_p1_do" />
    <bpmn:dataObject id="do_troubleshooting_report_p1_do" />
    <bpmn:startEvent id="ev_sm_receive_detailed_report" name="Detailed problem report received">
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_receive_detailed_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="ev_sm_send_to_rp" name="Detailed problem report sent to RP">
      <bpmn:incoming>flow_analyzable_no</bpmn:incoming>
      <bpmn:messageEventDefinition id="ev_sm_send_to_rp_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ev_sm_receive_status_report" name="Status report received">
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_receive_status_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="ev_sm_send_no_problem" name="Actual service performance sent to Customer Service">
      <bpmn:incoming>flow_cm_none</bpmn:incoming>
      <bpmn:messageEventDefinition id="ev_sm_send_no_problem_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_sm_send_resolution_minor" name="Problem resolution report sent (minor)">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_send_resolution_minor_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_sm_end_minor" name="SM minor path end">
      <bpmn:incoming>f23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_sm_send_restoration_request" name="Restoration request sent">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:messageEventDefinition id="ev_sm_send_restoration_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ev_sm_receive_troubleshoot_report" name="Trouble-shooting report received">
      <bpmn:outgoing>f31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_receive_troubleshoot_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="ev_sm_send_resolution_restoration" name="Problem resolution report sent (restoration)">
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_send_resolution_restoration_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_sm_end_restoration" name="SM restoration path end">
      <bpmn:incoming>f33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_sm_analyze" name="Analyze problem at Service Management level">
      <bpmn:incoming>flow_analyzable_yes</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:property id="task_sm_analyze_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_sm_analyze_dia0">
        <bpmn:sourceRef>do_detailed_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_sm_analyze_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_sm_create_trouble_report" name="Create trouble report (Service Management)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_sm_create_trouble_report_doa0">
        <bpmn:targetRef>do_trouble_report_sm</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_sm_prepare_final_status" name="Prepare final status report">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:property id="task_sm_prepare_final_status_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_sm_prepare_final_status_dia0">
        <bpmn:sourceRef>do_status_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_sm_prepare_final_status_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_sm_prepare_final_status_doa0">
        <bpmn:targetRef>do_final_status_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_sm_corrective_actions" name="Undertake minor corrective actions">
      <bpmn:incoming>flow_cm_minor</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:property id="task_sm_corrective_actions_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_sm_corrective_actions_dia0">
        <bpmn:sourceRef>do_final_status_report</bpmn:sourceRef>
        <bpmn:targetRef>task_sm_corrective_actions_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_sm_create_resolution_report_minor" name="Create problem resolution report (minor path)">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_sm_create_resolution_report_minor_doa0">
        <bpmn:targetRef>do_resolution_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_sm_create_restoration_request" name="Create request for automatic resource restoration">
      <bpmn:incoming>flow_cm_restoration</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:property id="task_sm_create_restoration_request_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_sm_create_restoration_request_dia0">
        <bpmn:sourceRef>do_final_status_report</bpmn:sourceRef>
        <bpmn:targetRef>task_sm_create_restoration_request_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_sm_create_restoration_request_doa0">
        <bpmn:targetRef>do_restoration_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_sm_create_resolution_report_restoration" name="Create problem resolution report (restoration path)">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:incoming>f32b</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
      <bpmn:property id="task_sm_create_resolution_report_restoration_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_sm_create_resolution_report_restoration_dia0">
        <bpmn:sourceRef>do_troubleshooting_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_sm_create_resolution_report_restoration_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_sm_create_resolution_report_restoration_doa0">
        <bpmn:targetRef>do_resolution_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_sm_analyzable" name="Analyzable by Service Management?" isMarkerVisible="true">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>flow_analyzable_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_analyzable_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
