<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_customer_part" name="Customer" processRef="pool_customer_proc" />
    <bpmn:participant id="pool_cs_part" name="Customer Service" processRef="pool_cs_proc" />
    <bpmn:participant id="pool_sm_part" name="Service Management" processRef="pool_sm_proc" />
    <bpmn:participant id="pool_rp_part" name="Resource Provisioning" processRef="pool_rp_proc" />
    <bpmn:participant id="pool_billing_part" name="Billing &amp; Collections" processRef="pool_billing_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="task_send_problem_list" targetRef="ev_cs_receive_list" name="Problem Parameter List" />
    <bpmn:messageFlow id="mf2" sourceRef="ev_send_detailed_report" targetRef="ev_sm_receive_detailed" name="Detailed Problem Report" />
    <bpmn:messageFlow id="mf3" sourceRef="ev_sm_send_to_rp" targetRef="ev_rp_receive_detailed" name="Detailed Problem Report" />
    <bpmn:messageFlow id="mf4" sourceRef="ev_rp_send_status" targetRef="ev_sm_receive_status" name="Status Report" />
    <bpmn:messageFlow id="mf5" sourceRef="ev_sm_send_actual_perf" targetRef="ev_cs_receive_outcome" name="Actual Service Performance" />
    <bpmn:messageFlow id="mf6" sourceRef="ev_sm_send_resolution_cs1" targetRef="ev_cs_receive_outcome" name="Problem Resolution Report" />
    <bpmn:messageFlow id="mf7" sourceRef="ev_sm_send_resolution_cs2" targetRef="ev_cs_receive_outcome" name="Problem Resolution Report" />
    <bpmn:messageFlow id="mf8" sourceRef="ev_sm_send_restoration_req" targetRef="ev_rp_wait_restoration" name="Restoration Request" />
    <bpmn:messageFlow id="mf9" sourceRef="ev_rp_send_troubleshoot" targetRef="ev_sm_receive_troubleshoot" name="Trouble-shooting Report" />
    <bpmn:messageFlow id="mf10" sourceRef="ev_send_customer_report" targetRef="ev_end_customer_receive" name="Customer Report" />
    <bpmn:messageFlow id="mf11" sourceRef="task_report_rebate" targetRef="ev_billing_receive_rebate" name="SLA Violation Rebate" />
  </bpmn:collaboration>
  <bpmn:process id="pool_customer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_problem_param_list" name="Problem Parameter List" dataObjectRef="do_problem_param_list_do" />
    <bpmn:dataObject id="do_problem_param_list_do" />
    <bpmn:startEvent id="ev_start_degrad" name="Customer perceives service degradation">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="ev_end_customer_receive" name="Customer receives report">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:incoming>sf20</bpmn:incoming>
      <bpmn:messageEventDefinition id="ev_end_customer_receive_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_send_problem_list" name="Send list of problem parameters">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_problem_list_doa0">
        <bpmn:targetRef>do_problem_param_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="gw_cs_split" name="Split concurrent CS activities">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:outgoing>sf14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="sf1" sourceRef="ev_start_degrad" targetRef="task_send_problem_list" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task_send_problem_list" targetRef="ev_end_customer_receive" />
  </bpmn:process>
  <bpmn:process id="pool_cs_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_problem_param_list_p1" name="Problem Parameter List" dataObjectRef="do_problem_param_list_p1_do" />
    <bpmn:dataObject id="do_problem_param_list_p1_do" />
    <bpmn:dataObjectReference id="do_problem_report" name="Problem Report" dataObjectRef="do_problem_report_do" />
    <bpmn:dataObject id="do_problem_report_do" />
    <bpmn:dataObjectReference id="do_customer_sla" name="Customer SLA" dataObjectRef="do_customer_sla_do" />
    <bpmn:dataObject id="do_customer_sla_do" />
    <bpmn:dataObjectReference id="do_customer_history" name="Customer History Data" dataObjectRef="do_customer_history_do" />
    <bpmn:dataObject id="do_customer_history_do" />
    <bpmn:dataObjectReference id="do_detailed_problem_report" name="Detailed Problem Report" dataObjectRef="do_detailed_problem_report_do" />
    <bpmn:dataObject id="do_detailed_problem_report_do" />
    <bpmn:dataObjectReference id="do_customer_report" name="Customer Report" dataObjectRef="do_customer_report_do" />
    <bpmn:dataObject id="do_customer_report_do" />
    <bpmn:dataObjectReference id="do_rebate_notice" name="SLA Violation Rebate Notice" dataObjectRef="do_rebate_notice_do" />
    <bpmn:dataObject id="do_rebate_notice_do" />
    <bpmn:startEvent id="ev_cs_receive_list" name="Problem parameter list received">
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_cs_receive_list_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="ev_send_detailed_report" name="Detailed problem report sent to Service Management">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_send_detailed_report_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="ev_cs_receive_outcome" name="Outcome received from Service Management">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:incoming>sf50</bpmn:incoming>
      <bpmn:incoming>sf51</bpmn:incoming>
      <bpmn:incoming>sf52</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_cs_receive_outcome_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="ev_send_customer_report" name="Report sent to customer">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:outgoing>sf20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_send_customer_report_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ev_end_cs" name="Customer Service process ends">
      <bpmn:incoming>sf18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_enter_report" name="Enter problem report into system T">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="task_enter_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_enter_report_dia0">
        <bpmn:sourceRef>do_problem_param_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_enter_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_enter_report_doa0">
        <bpmn:targetRef>do_problem_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_compare_sla" name="Compare problem report to customer SLA">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:property id="task_compare_sla_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_compare_sla_dia0">
        <bpmn:sourceRef>do_problem_report</bpmn:sourceRef>
        <bpmn:targetRef>task_compare_sla_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_compare_sla_dia1">
        <bpmn:sourceRef>do_customer_sla</bpmn:sourceRef>
        <bpmn:targetRef>task_compare_sla_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_determine_measures" name="Determine counter measures and priorities">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_determine_significance" name="Determine customer significance">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:property id="task_determine_significance_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_determine_significance_dia0">
        <bpmn:sourceRef>do_customer_history</bpmn:sourceRef>
        <bpmn:targetRef>task_determine_significance_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="task_premium_link" name="Link to extra problem fix process (premium)">
      <bpmn:incoming>sf_premium_yes</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_reprioritize" name="Re-prioritize counter measures">
      <bpmn:incoming>sf_resig_yes</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_detailed_report" name="Create detailed problem report">
      <bpmn:incoming>sf_resig_no</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_detailed_report_doa0">
        <bpmn:targetRef>do_detailed_problem_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_customer_report" name="Create report for customer (service performance &amp; resolution)">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_customer_report_doa0">
        <bpmn:targetRef>do_customer_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_report_rebate" name="Report SLA violation rebate to Billing &amp; Collections">
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf17</bpmn:outgoing>
      <bpmn:outgoing>sf19</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_report_rebate_doa0">
        <bpmn:targetRef>do_rebate_notice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_premium" name="Customer premium?" isMarkerVisible="true">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf_premium_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_premium_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_resig_change" name="Significance affects measures?" isMarkerVisible="true">
      <bpmn:incoming>sf_premium_no</bpmn:incoming>
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf_resig_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_resig_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_cs_join" name="Join concurrent CS activities">
      <bpmn:incoming>sf16</bpmn:incoming>
      <bpmn:incoming>sf17</bpmn:incoming>
      <bpmn:outgoing>sf18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="sf3" sourceRef="ev_cs_receive_list" targetRef="task_enter_report" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task_enter_report" targetRef="task_compare_sla" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task_compare_sla" targetRef="task_determine_measures" />
    <bpmn:sequenceFlow id="sf6" sourceRef="task_determine_measures" targetRef="task_determine_significance" />
    <bpmn:sequenceFlow id="sf7" sourceRef="task_determine_significance" targetRef="gw_premium" />
    <bpmn:sequenceFlow id="sf_premium_yes" sourceRef="gw_premium" targetRef="task_premium_link" />
    <bpmn:sequenceFlow id="sf_premium_no" sourceRef="gw_premium" targetRef="gw_resig_change" />
    <bpmn:sequenceFlow id="sf8" sourceRef="task_premium_link" targetRef="gw_resig_change" />
    <bpmn:sequenceFlow id="sf_resig_yes" sourceRef="gw_resig_change" targetRef="task_reprioritize" />
    <bpmn:sequenceFlow id="sf9" sourceRef="task_reprioritize" targetRef="task_determine_measures" />
    <bpmn:sequenceFlow id="sf_resig_no" sourceRef="gw_resig_change" targetRef="task_create_detailed_report" />
    <bpmn:sequenceFlow id="sf10" sourceRef="task_create_detailed_report" targetRef="ev_send_detailed_report" />
    <bpmn:sequenceFlow id="sf11" sourceRef="ev_send_detailed_report" targetRef="ev_cs_receive_outcome" />
    <bpmn:sequenceFlow id="sf15" sourceRef="task_create_customer_report" targetRef="ev_send_customer_report" />
    <bpmn:sequenceFlow id="sf16" sourceRef="ev_send_customer_report" targetRef="gw_cs_join" />
    <bpmn:sequenceFlow id="sf17" sourceRef="task_report_rebate" targetRef="gw_cs_join" />
    <bpmn:sequenceFlow id="sf18" sourceRef="gw_cs_join" targetRef="ev_end_cs" />
  </bpmn:process>
  <bpmn:process id="pool_sm_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_detailed_problem_report_p1" name="Detailed Problem Report" dataObjectRef="do_detailed_problem_report_p1_do" />
    <bpmn:dataObject id="do_detailed_problem_report_p1_do" />
    <bpmn:dataObjectReference id="do_trouble_report_sm" name="Trouble Report (Service Management)" dataObjectRef="do_trouble_report_sm_do" />
    <bpmn:dataObject id="do_trouble_report_sm_do" />
    <bpmn:dataObjectReference id="do_status_report" name="Status Report" dataObjectRef="do_status_report_do" />
    <bpmn:dataObject id="do_status_report_do" />
    <bpmn:dataObjectReference id="do_final_status_report" name="Final Status Report" dataObjectRef="do_final_status_report_do" />
    <bpmn:dataObject id="do_final_status_report_do" />
    <bpmn:dataObjectReference id="do_resolution_report" name="Problem Resolution Report" dataObjectRef="do_resolution_report_do" />
    <bpmn:dataObject id="do_resolution_report_do" />
    <bpmn:dataObjectReference id="do_restoration_request" name="Restoration Request" dataObjectRef="do_restoration_request_do" />
    <bpmn:dataObject id="do_restoration_request_do" />
    <bpmn:dataObjectReference id="do_troubleshoot_report" name="Trouble-shooting Report" dataObjectRef="do_troubleshoot_report_do" />
    <bpmn:dataObject id="do_troubleshoot_report_do" />
    <bpmn:startEvent id="ev_sm_receive_detailed" name="Detailed problem report received">
      <bpmn:outgoing>sf23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_receive_detailed_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="ev_sm_send_to_rp" name="Detailed problem report sent to Resource Provisioning">
      <bpmn:incoming>sf_analyzable_no</bpmn:incoming>
      <bpmn:outgoing>sf26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_send_to_rp_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="ev_sm_receive_status" name="Status report received from Resource Provisioning">
      <bpmn:incoming>sf25</bpmn:incoming>
      <bpmn:incoming>sf32</bpmn:incoming>
      <bpmn:outgoing>sf33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_receive_status_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ev_sm_send_resolution_cs1" name="Problem resolution report sent to Customer Service">
      <bpmn:incoming>sf37</bpmn:incoming>
      <bpmn:outgoing>sf38</bpmn:outgoing>
      <bpmn:outgoing>sf51</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_send_resolution_cs1_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_sm_send_actual_perf" name="Actual service performance sent to Customer Service">
      <bpmn:incoming>sf_cm_none</bpmn:incoming>
      <bpmn:outgoing>sf35</bpmn:outgoing>
      <bpmn:outgoing>sf50</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_send_actual_perf_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="ev_sm_send_restoration_req" name="Restoration request sent to Resource Provisioning">
      <bpmn:incoming>sf39</bpmn:incoming>
      <bpmn:outgoing>sf40</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_send_restoration_req_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="ev_sm_receive_troubleshoot" name="Trouble-shooting report received">
      <bpmn:incoming>sf46</bpmn:incoming>
      <bpmn:outgoing>sf47</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_receive_troubleshoot_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ev_sm_send_resolution_cs2" name="Problem resolution report sent to Customer Service">
      <bpmn:incoming>sf48</bpmn:incoming>
      <bpmn:outgoing>sf49</bpmn:outgoing>
      <bpmn:outgoing>sf52</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sm_send_resolution_cs2_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_end_sm1" name="Service Management process ends (no problem)">
      <bpmn:incoming>sf35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_end_sm2" name="Service Management process ends (minor corrective)">
      <bpmn:incoming>sf38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_end_sm3" name="Service Management process ends (restoration)">
      <bpmn:incoming>sf49</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_sm_analysis" name="Perform analysis (Service Management)">
      <bpmn:incoming>sf_analyzable_yes</bpmn:incoming>
      <bpmn:outgoing>sf24</bpmn:outgoing>
      <bpmn:property id="task_sm_analysis_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_sm_analysis_dia0">
        <bpmn:sourceRef>do_detailed_problem_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_sm_analysis_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_sm_create_trouble_report" name="Create trouble report (type of problem)">
      <bpmn:incoming>sf24</bpmn:incoming>
      <bpmn:outgoing>sf25</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_sm_create_trouble_report_doa0">
        <bpmn:targetRef>do_trouble_report_sm</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_prepare_final_status" name="Prepare final status report">
      <bpmn:incoming>sf33</bpmn:incoming>
      <bpmn:outgoing>sf34</bpmn:outgoing>
      <bpmn:property id="task_prepare_final_status_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prepare_final_status_dia0">
        <bpmn:sourceRef>do_status_report</bpmn:sourceRef>
        <bpmn:targetRef>task_prepare_final_status_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_prepare_final_status_doa0">
        <bpmn:targetRef>do_final_status_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_sm_corrective_actions" name="Undertake minor corrective actions">
      <bpmn:incoming>sf_cm_minor</bpmn:incoming>
      <bpmn:outgoing>sf36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_sm_create_resolution_report" name="Create problem resolution report">
      <bpmn:incoming>sf36</bpmn:incoming>
      <bpmn:outgoing>sf37</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_sm_create_resolution_report_doa0">
        <bpmn:targetRef>do_resolution_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_restoration_request" name="Create request for automatic resource restoration">
      <bpmn:incoming>sf_cm_restoration</bpmn:incoming>
      <bpmn:outgoing>sf39</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_restoration_request_doa0">
        <bpmn:targetRef>do_restoration_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_sm_create_resolution_report2" name="Create problem resolution report (after trouble-shooting)">
      <bpmn:incoming>sf47</bpmn:incoming>
      <bpmn:outgoing>sf48</bpmn:outgoing>
      <bpmn:property id="task_sm_create_resolution_report2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_sm_create_resolution_report2_dia0">
        <bpmn:sourceRef>do_troubleshoot_report</bpmn:sourceRef>
        <bpmn:targetRef>task_sm_create_resolution_report2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_sm_create_resolution_report2_doa0">
        <bpmn:targetRef>do_resolution_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_analyzable" name="Analyzable by Service Management?" isMarkerVisible="true">
      <bpmn:incoming>sf23</bpmn:incoming>
      <bpmn:outgoing>sf_analyzable_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_analyzable_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_counter_measures" name="Counter measure type?" isMarkerVisible="true">
      <bpmn:incoming>sf34</bpmn:incoming>
      <bpmn:outgoing>sf_cm_none</bpmn:outgoing>
      <bpmn:outgoing>sf_cm_minor</bpmn:outgoing>
      <bpmn:outgoing>sf_cm_restoration</bpmn:outgoing>
