<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_party_part" name="Party" processRef="pool_party_proc" />
    <bpmn:participant id="pool_backoffice_part" name="Client Service Back Office (Small Claims Registry Operations)" processRef="pool_backoffice_proc" />
    <bpmn:participant id="pool_police_part" name="Queensland Police" processRef="pool_police_proc" />
    <bpmn:participant id="pool_mc_staff_part" name="MC Internal Staff" processRef="pool_mc_staff_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_send_request" targetRef="start_receive_request" name="Warrant Possession Request" />
    <bpmn:messageFlow id="mf2" sourceRef="end_forward_warrant" targetRef="start_receive_warrant" name="SCT Warrant Possession" />
    <bpmn:messageFlow id="mf3" sourceRef="end_send_report" targetRef="start_receive_report" name="Police Report" />
    <bpmn:messageFlow id="mf4" sourceRef="end_store_expanded_file" targetRef="start_receive_physical_file" name="Physical SCT File" />
  </bpmn:collaboration>
  <bpmn:process id="pool_party_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_warrant_request" name="Warrant Possession Request" dataObjectRef="doc_warrant_request_do" />
    <bpmn:dataObject id="doc_warrant_request_do" />
    <bpmn:startEvent id="start_request" name="Need to release warrant">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_request" name="Request sent">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_send_request" name="Send warrant possession request">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_request_doa0">
        <bpmn:targetRef>doc_warrant_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow1" sourceRef="start_request" targetRef="task_send_request" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task_send_request" targetRef="end_send_request" />
  </bpmn:process>
  <bpmn:process id="pool_backoffice_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_warrant_request_p1" name="Warrant Possession Request" dataObjectRef="doc_warrant_request_p1_do" />
    <bpmn:dataObject id="doc_warrant_request_p1_do" />
    <bpmn:dataObjectReference id="doc_sct_file" name="SCT File" dataObjectRef="doc_sct_file_do" />
    <bpmn:dataObject id="doc_sct_file_do" />
    <bpmn:dataObjectReference id="doc_sct_warrant_possession" name="SCT Warrant Possession Document" dataObjectRef="doc_sct_warrant_possession_do" />
    <bpmn:dataObject id="doc_sct_warrant_possession_do" />
    <bpmn:dataObjectReference id="doc_police_report_p1" name="Police Report" dataObjectRef="doc_police_report_p1_do" />
    <bpmn:dataObject id="doc_police_report_p1_do" />
    <bpmn:dataObjectReference id="doc_sct_file_expanded" name="Expanded SCT Physical File" dataObjectRef="doc_sct_file_expanded_do" />
    <bpmn:dataObject id="doc_sct_file_expanded_do" />
    <bpmn:startEvent id="start_receive_request" name="Request received">
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_request_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_forward_warrant" name="Warrant forwarded">
      <bpmn:incoming>flow6</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_forward_warrant_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_receive_report" name="Report received">
      <bpmn:outgoing>flow9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_store_expanded_file" name="Expanded SCT file sent to MC staff">
      <bpmn:incoming>flow12</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_store_expanded_file_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_retrieve_sct_file" name="Retrieve SCT file">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
      <bpmn:property id="task_retrieve_sct_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_retrieve_sct_file_dia0">
        <bpmn:sourceRef>doc_warrant_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_retrieve_sct_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_retrieve_sct_file_doa0">
        <bpmn:targetRef>doc_sct_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_forward_warrant" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:outgoing>flow5</bpmn:outgoing>
      <bpmn:property id="task_forward_warrant_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_forward_warrant_dia0">
        <bpmn:sourceRef>doc_sct_file</bpmn:sourceRef>
        <bpmn:targetRef>task_forward_warrant_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_forward_warrant_doa0">
        <bpmn:targetRef>doc_sct_warrant_possession</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_store_physical_file" name="Store SCT physical file awaiting police report">
      <bpmn:incoming>flow5</bpmn:incoming>
      <bpmn:outgoing>flow6</bpmn:outgoing>
      <bpmn:property id="task_store_physical_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_physical_file_dia0">
        <bpmn:sourceRef>doc_sct_file</bpmn:sourceRef>
        <bpmn:targetRef>task_store_physical_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_retrieve_sct_file_2" name="Retrieve respective SCT file">
      <bpmn:incoming>flow9</bpmn:incoming>
      <bpmn:outgoing>flow10</bpmn:outgoing>
      <bpmn:property id="task_retrieve_sct_file_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_retrieve_sct_file_2_dia0">
        <bpmn:sourceRef>doc_police_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_retrieve_sct_file_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_retrieve_sct_file_2_doa0">
        <bpmn:targetRef>doc_sct_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_attach_document" name="Attach new SCT document">
      <bpmn:incoming>flow10</bpmn:incoming>
      <bpmn:outgoing>flow11</bpmn:outgoing>
      <bpmn:property id="task_attach_document_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_attach_document_dia0">
