    </bpmn:manualTask>
    <bpmn:manualTask id="task_store_expanded_file" name="Store expanded SCT physical file">
      <bpmn:incoming>flow11</bpmn:incoming>
      <bpmn:outgoing>flow12</bpmn:outgoing>
      <bpmn:property id="task_store_expanded_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_expanded_file_dia0">
        <bpmn:sourceRef>doc_sct_file_expanded</bpmn:sourceRef>
        <bpmn:targetRef>task_store_expanded_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow3" sourceRef="start_receive_request" targetRef="task_retrieve_sct_file" />
    <bpmn:sequenceFlow id="flow4" sourceRef="task_retrieve_sct_file" targetRef="task_forward_warrant" />
    <bpmn:sequenceFlow id="flow5" sourceRef="task_forward_warrant" targetRef="task_store_physical_file" />
    <bpmn:sequenceFlow id="flow6" sourceRef="task_store_physical_file" targetRef="end_forward_warrant" />
    <bpmn:sequenceFlow id="flow9" sourceRef="start_receive_report" targetRef="task_retrieve_sct_file_2" />
    <bpmn:sequenceFlow id="flow10" sourceRef="task_retrieve_sct_file_2" targetRef="task_attach_document" />
    <bpmn:sequenceFlow id="flow11" sourceRef="task_attach_document" targetRef="task_store_expanded_file" />
    <bpmn:sequenceFlow id="flow12" sourceRef="task_store_expanded_file" targetRef="end_store_expanded_file" />
  </bpmn:process>
  <bpmn:process id="pool_police_proc" isExecutable="false">
