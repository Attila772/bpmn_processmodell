<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   id="Definitions_1"
                   targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Party" name="Party" processRef="Process_Party" />
    <bpmn:participant id="Participant_BackOffice" name="Client Service Back Office (Small Claims Registry Operations)" processRef="Process_BackOffice" />
    <bpmn:participant id="Participant_Police" name="Queensland Police" processRef="Process_Police" />
    <bpmn:participant id="Participant_MCStaff" name="Other MC Internal Staff (Out of Scope)" processRef="Process_MCStaff" />

    <bpmn:messageFlow id="MessageFlow_Request" sourceRef="Task_SendRequest" targetRef="StartEvent_Receive" />
    <bpmn:messageFlow id="MessageFlow_Forward" sourceRef="Task_ForwardToPolice" targetRef="StartEvent_Police" />
    <bpmn:messageFlow id="MessageFlow_Report" sourceRef="Task_SendReport" targetRef="IntermediateCatchEvent_ReceiveReport" />
    <bpmn:messageFlow id="MessageFlow_PhysicalFile" sourceRef="EndEvent_SendPhysicalFile" targetRef="StartEvent_MCStaff" />
  </bpmn:collaboration>

  <!-- PARTY PROCESS -->
  <bpmn:process id="Process_Party" name="Party" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Process Started">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendRequest" name="Send Warrant Possession Request (Release of Warrant)">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Request Sent">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="StartEvent_1" targetRef="Task_SendRequest" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_SendRequest" targetRef="EndEvent_1" />
  </bpmn:process>

  <!-- CLIENT SERVICE BACK OFFICE PROCESS -->
  <bpmn:process id="Process_BackOffice" name="Client Service Back Office" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Receive" name="Receive Warrant Possession Request">
      <bpmn:messageEventDefinition id="MsgDef_Receive" />
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_RetrieveFile1" name="Retrieve SCT File">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ForwardToPolice" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_StorePhysicalFile" name="Store SCT Physical File (Awaiting Report)">
      <bpmn:incoming>Flow_B3</bpmn:incoming>
      <bpmn:outgoing>Flow_B4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReceiveReport" name="Receive Report from Police">
      <bpmn:messageEventDefinition id="MsgDef_ReceiveReport" />
      <bpmn:incoming>Flow_B4</bpmn:incoming>
      <bpmn:outgoing>Flow_B5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_RetrieveFile2" name="Retrieve SCT File">
      <bpmn:incoming>Flow_B5</bpmn:incoming>
      <bpmn:outgoing>Flow_B6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AttachDocument" name="Attach New SCT Document">
      <bpmn:incoming>Flow_B6</bpmn:incoming>
      <bpmn:outgoing>Flow_B7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_StoreExpandedFile" name="Store Expanded SCT Physical File">
      <bpmn:incoming>Flow_B7</bpmn:incoming>
      <bpmn:outgoing>Flow_B8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_SendPhysicalFile" name="Physical SCT File Sent to MC Internal Staff">
      <bpmn:messageEventDefinition id="MsgDef_SendPhysicalFile" />
      <bpmn:incoming>Flow_B8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_B1" sourceRef="StartEvent_Receive" targetRef="Task_RetrieveFile1" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Task_RetrieveFile1" targetRef="Task_ForwardToPolice" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Task_ForwardToPolice" targetRef="Task_StorePhysicalFile" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Task_StorePhysicalFile" targetRef="IntermediateCatchEvent_ReceiveReport" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="IntermediateCatchEvent_ReceiveReport" targetRef="Task_RetrieveFile2" />
    <bpmn:sequenceFlow id="Flow_B6" sourceRef="Task_RetrieveFile2" targetRef="Task_AttachDocument" />
    <bpmn:sequenceFlow id="Flow_B7" sourceRef="Task_AttachDocument" targetRef="Task_StoreExpandedFile" />
    <bpmn:sequenceFlow id="Flow_B8" sourceRef="Task_StoreExpandedFile" targetRef="EndEvent_SendPhysicalFile" />
  </bpmn:process>

  <!-- QUEENSLAND POLICE PROCESS -->
  <bpmn:process id="Process_Police" name="Queensland Police" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Police" name="Receive SCT Warrant Possession">
      <bpmn:messageEventDefinition id="MsgDef_StartPolice" />
      <bpmn:outgoing>Flow_PO1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ProcessWarrant" name="Process Warrant">
      <bpmn:incoming>Flow_PO1</bpmn:incoming>
      <bpmn:outgoing>Flow_PO2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendReport" name="Send Report">
      <bpmn:incoming>Flow_PO2</bpmn:incoming>
      <bpmn:outgoing>Flow_PO3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Police" name="Report Sent">
      <bpmn:incoming>Flow_PO3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_PO1" sourceRef="StartEvent_Police" targetRef="Task_ProcessWarrant" />
    <bpmn:sequenceFlow id="Flow_PO2" sourceRef="Task_ProcessWarrant" targetRef="Task_SendReport" />
    <bpmn:sequenceFlow id="Flow_PO3" sourceRef="Task_SendReport" targetRef="EndEvent_Police" />
  </bpmn:process>

  <!-- OTHER MC INTERNAL STAFF PROCESS (OUT OF SCOPE) -->
  <bpmn:process id="Process_MCStaff" name="Other MC Internal Staff" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MCStaff" name="Receive Physical SCT File">
      <bpmn:messageEventDefinition id="MsgDef_StartMCStaff" />
      <bpmn:outgoing>Flow_M1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_MCStaff" name="Out of Scope">
      <bpmn:incoming>Flow_M1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_M1" sourceRef="StartEvent_MCStaff" targetRef="EndEvent_MCStaff" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <!-- Pool: Party -->
      <bpmndi:BPMNShape id="Participant_Party_di" bpmnElement="Participant_Party" isHorizontal="true">
        <dc:Bounds x="120" y="20" width="1300" height="140" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="200" y="70" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRequest_di" bpmnElement="Task_SendRequest">
        <dc:Bounds x="280" y="55" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="430" y="70" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_P1_di" bpmnElement="Flow_P1">
        <di:waypoint x="236" y="88" />
        <di:waypoint x="280" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2_di" bpmnElement="Flow_P2">
        <di:waypoint x="380" y="95" />
        <di:waypoint x="430" y="88" />
      </bpmndi:BPMNEdge>

      <!-- Pool: Back Office -->
      <bpmndi:BPMNShape id="Participant_BackOffice_di" bpmnElement="Participant_BackOffice" isHorizontal="true">
        <dc:Bounds x="120" y="180" width="1300" height="300" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Receive_di" bpmnElement="StartEvent_Receive">
        <dc:Bounds x="200" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetrieveFile1_di" bpmnElement="Task_RetrieveFile1">
        <dc:Bounds x="280" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ForwardToPolice_di" bpmnElement="Task_ForwardToPolice">
        <dc:Bounds x="430" y="285" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StorePhysicalFile_di" bpmnElement="Task_StorePhysicalFile">
        <dc:Bounds x="590" y="285" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent_ReceiveReport_di" bpmnElement="IntermediateCatchEvent_ReceiveReport">
        <dc:Bounds x="750" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetrieveFile2_di" bpmnElement="Task_RetrieveFile2">
        <dc:Bounds x="830" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AttachDocument_di" bpmnElement="Task_AttachDocument">
        <dc:Bounds x="980" y="285" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StoreExpandedFile_di" bpmnElement="Task_StoreExpandedFile">
        <dc:Bounds x="1140" y="285" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_SendPhysicalFile_di" bpmnElement="EndEvent_SendPhysicalFile">
        <dc:Bounds x="1310" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_B1_di" bpmnElement="Flow_B1">
        <di:waypoint x="236" y="318" />
        <di:waypoint x="280" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B2_di" bpmnElement="Flow_B2">
        <di:waypoint x="380" y="325" />
        <di:waypoint x="430" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B3_di" bpmnElement="Flow_B3">
        <di:waypoint x="540" y="325" />
        <di:waypoint x="590" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B4_di" bpmnElement="Flow_B4">
        <di:waypoint x="700" y="325" />
        <di:waypoint x="750" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B5_di" bpmnElement="Flow_B5">
        <di:waypoint x="786" y="318" />
        <di:waypoint x="830" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B6_di" bpmnElement="Flow_B6">
        <di:waypoint x="930" y="325" />
        <di:waypoint x="980" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B7_di" bpmnElement="Flow_B7">
        <di:waypoint x="1090" y="325" />
        <di:waypoint x="1140" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B8_di" bpmnElement="Flow_B8">
        <di:waypoint x="1260" y="325" />
        <di:waypoint x="1310" y="318" />
      </bpmndi:BPMNEdge>

      <!-- Pool: Queensland Police -->
      <bpmndi:BPMNShape id="Participant_Police_di" bpmnElement="Participant_Police" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="1300" height="140" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Police_di" bpmnElement="StartEvent_Police">
        <dc:Bounds x="430" y="550" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessWarrant_di" bpmnElement="Task_ProcessWarrant">
        <dc:Bounds x="510" y="535" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendReport_di" bpmnElement="Task_SendReport">
        <dc:Bounds x="660" y="535" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Police_di" bpmnElement="EndEvent_Police">
        <dc:Bounds x="800" y="550" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_PO1_di" bpmnElement="Flow_PO1">
        <di:waypoint x="466" y="568" />
        <di:waypoint x="510" y="575" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PO2_di" bpmnElement="Flow_PO2">
        <di:waypoint x="620" y="575" />
        <di:waypoint x="660" y="575" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PO3_di" bpmnElement="Flow_PO3">
        <di:waypoint x="760" y="575" />
        <di:waypoint x="800" y="568" />
      </bpmndi:BPMNEdge>

      <!-- Pool: Other MC Internal Staff -->
      <bpmndi:BPMNShape id="Participant_MCStaff_di" bpmnElement="Participant_MCStaff" isHorizontal="true">
        <dc:Bounds x="120" y="660" width="1300" height="120" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MCStaff_di" bpmnElement="StartEvent_MCStaff">
        <dc:Bounds x="1310" y="700" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_MCStaff_di" bpmnElement="EndEvent_MCStaff">
        <dc:Bounds x="1400" y="700" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_M1_di" bpmnElement="Flow_M1">
        <di:waypoint x="1346" y="718" />
        <di:waypoint x="1400" y="718" />
      </bpmndi:BPMNEdge>

      <!-- Message Flows -->
      <bpmndi:BPMNEdge id="MessageFlow_Request_di" bpmnElement="MessageFlow_Request">
        <di:waypoint x="330" y="135" />
        <di:waypoint x="218" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_Forward_di" bpmnElement="MessageFlow_Forward">
        <di:waypoint x="485" y="365" />
        <di:waypoint x="448" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_Report_di" bpmnElement="MessageFlow_Report">
        <di:waypoint x="710" y="535" />
        <di:waypoint x="768" y="336" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_PhysicalFile_di" bpmnElement="MessageFlow_PhysicalFile">
        <di:waypoint x="1328" y="336" />
        <di:waypoint x="1328" y="700" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
