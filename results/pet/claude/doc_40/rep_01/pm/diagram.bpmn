        <bpmn:sourceRef>data_sct_warrant_possession</bpmn:sourceRef>
        <bpmn:targetRef>task_process_warrant_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_process_warrant_doa0">
        <bpmn:targetRef>data_police_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf4" sourceRef="msg_start_warrant_received" targetRef="task_process_warrant" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task_process_warrant" targetRef="end_send_report" />
  </bpmn:process>
  <bpmn:process id="pool_mc_internal_proc" isExecutable="false">
    <bpmn:startEvent id="msg_start_receive_physical_file" name="Physical SCT file received">
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_receive_physical_file_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_out_of_scope" name="Process continues (out of scope)">
      <bpmn:incoming>sf12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf12" sourceRef="msg_start_receive_physical_file" targetRef="end_out_of_scope" />
  </bpmn:process>
