<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_party_part" name="Party" processRef="pool_party_proc" />
    <bpmn:participant id="pool_back_office_part" name="Client Service Back Office (Small Claims Registry Operations)" processRef="pool_back_office_proc" />
    <bpmn:participant id="pool_police_part" name="Queensland Police" processRef="pool_police_proc" />
    <bpmn:participant id="pool_mc_internal_part" name="MC Internal Staff" processRef="pool_mc_internal_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_send_request" targetRef="msg_start_request_received" name="Warrant Possession Request" />
    <bpmn:messageFlow id="mf2" sourceRef="end_forward_to_police" targetRef="msg_start_warrant_received" name="SCT Warrant Possession" />
    <bpmn:messageFlow id="mf3" sourceRef="end_send_report" targetRef="msg_start_report_received" name="Police Report" />
    <bpmn:messageFlow id="mf4" sourceRef="end_send_physical_file" targetRef="msg_start_receive_physical_file" name="Expanded SCT Physical File" />
  </bpmn:collaboration>
  <bpmn:process id="pool_party_proc" isExecutable="false">
    <bpmn:startEvent id="start_request" name="Party decides to request warrant possession">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_request" name="Warrant possession request sent">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_request" targetRef="end_send_request" />
  </bpmn:process>
  <bpmn:process id="pool_back_office_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_warrant_request" name="Warrant Possession Request" dataObjectRef="data_warrant_request_do" />
    <bpmn:dataObject id="data_warrant_request_do" />
    <bpmn:dataObjectReference id="data_sct_file" name="SCT Physical File" dataObjectRef="data_sct_file_do" />
    <bpmn:dataObject id="data_sct_file_do" />
    <bpmn:dataObjectReference id="data_police_report_p1" name="Police Report" dataObjectRef="data_police_report_p1_do" />
    <bpmn:dataObject id="data_police_report_p1_do" />
    <bpmn:dataObjectReference id="data_expanded_sct_file" name="Expanded SCT Physical File" dataObjectRef="data_expanded_sct_file_do" />
    <bpmn:dataObject id="data_expanded_sct_file_do" />
    <bpmn:startEvent id="msg_start_request_received" name="Request received">
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_request_received_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_forward_to_police" name="SCT Warrant Possession forwarded to Police">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="end_forward_to_police_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="msg_start_report_received" name="Report received">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_report_received_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_physical_file" name="Physical SCT file sent to internal staff">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_physical_file_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_retrieve_sct_file" name="Retrieve SCT file">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:property id="task_retrieve_sct_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_retrieve_sct_file_dia0">
        <bpmn:sourceRef>data_warrant_request</bpmn:sourceRef>
        <bpmn:targetRef>task_retrieve_sct_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_retrieve_sct_file_doa0">
        <bpmn:targetRef>data_sct_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_store_physical_file" name="Store SCT physical file awaiting report">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:property id="task_store_physical_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_physical_file_dia0">
        <bpmn:sourceRef>data_sct_file</bpmn:sourceRef>
        <bpmn:targetRef>task_store_physical_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_retrieve_sct_file_2" name="Retrieve SCT file">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="task_retrieve_sct_file_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_retrieve_sct_file_2_dia0">
        <bpmn:sourceRef>data_police_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_retrieve_sct_file_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_retrieve_sct_file_2_doa0">
        <bpmn:targetRef>data_sct_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_attach_new_document" name="Attach new SCT document">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:property id="task_attach_new_document_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_attach_new_document_dia0">
        <bpmn:sourceRef>data_sct_file</bpmn:sourceRef>
        <bpmn:targetRef>task_attach_new_document_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_attach_new_document_dia1">
        <bpmn:sourceRef>data_police_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_attach_new_document_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_attach_new_document_doa0">
        <bpmn:targetRef>data_expanded_sct_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_store_expanded_file" name="Store expanded SCT physical file">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:property id="task_store_expanded_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_expanded_file_dia0">
        <bpmn:sourceRef>data_expanded_sct_file</bpmn:sourceRef>
        <bpmn:targetRef>task_store_expanded_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_expanded_file_doa0">
        <bpmn:targetRef>data_expanded_sct_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="sf2" sourceRef="msg_start_request_received" targetRef="task_retrieve_sct_file" />
    <bpmn:sequenceFlow id="sf3" sourceRef="task_retrieve_sct_file" targetRef="end_forward_to_police" />
    <bpmn:sequenceFlow id="sf6" sourceRef="end_forward_to_police" targetRef="task_store_physical_file" />
    <bpmn:sequenceFlow id="sf7" sourceRef="task_store_physical_file" targetRef="msg_start_report_received" />
    <bpmn:sequenceFlow id="sf8" sourceRef="msg_start_report_received" targetRef="task_retrieve_sct_file_2" />
    <bpmn:sequenceFlow id="sf9" sourceRef="task_retrieve_sct_file_2" targetRef="task_attach_new_document" />
    <bpmn:sequenceFlow id="sf10" sourceRef="task_attach_new_document" targetRef="task_store_expanded_file" />
    <bpmn:sequenceFlow id="sf11" sourceRef="task_store_expanded_file" targetRef="end_send_physical_file" />
  </bpmn:process>
  <bpmn:process id="pool_police_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_sct_warrant_possession" name="SCT Warrant Possession" dataObjectRef="data_sct_warrant_possession_do" />
    <bpmn:dataObject id="data_sct_warrant_possession_do" />
    <bpmn:dataObjectReference id="data_police_report" name="Police Report" dataObjectRef="data_police_report_do" />
    <bpmn:dataObject id="data_police_report_do" />
    <bpmn:startEvent id="msg_start_warrant_received" name="Warrant possession received">
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_warrant_received_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_report" name="Report sent to Back Office">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_process_warrant" name="Process warrant possession">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:property id="task_process_warrant_prop" name="__targetRef_placeholder" />
