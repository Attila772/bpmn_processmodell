<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_inq_part" name="INQ" processRef="pool_inq_proc" />
    <bpmn:participant id="pool_ip_part" name="IP" processRef="pool_ip_proc" />
    <bpmn:messageFlow id="mf_request" sourceRef="end_send_request" targetRef="start_ip_receive" name="Transaction Data Request" />
    <bpmn:messageFlow id="mf_data" sourceRef="end_send_data" targetRef="start_receive_answer" name="Data Transmission" />
    <bpmn:messageFlow id="mf_rejection" sourceRef="end_send_rejection" targetRef="start_receive_answer" name="Rejection" />
  </bpmn:collaboration>
  <bpmn:process id="pool_inq_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_request" name="Transaktionsdatenanfrage" dataObjectRef="data_request_do" />
    <bpmn:dataObject id="data_request_do" />
    <bpmn:startEvent id="start_inq" name="Start">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_request" name="Anfrage gesendet">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_receive_answer" name="Antwort empfangen">
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_answer_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_inq" name="Ende">
      <bpmn:incoming>flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_transmit_request" name="Transaktionsdatenanfrage übermitteln">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_transmit_request_doa0">
        <bpmn:targetRef>data_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_inq" targetRef="task_transmit_request" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_transmit_request" targetRef="end_send_request" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="start_receive_answer" targetRef="end_inq" />
  </bpmn:process>
  <bpmn:process id="pool_ip_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_request_p1" name="Transaktionsdatenanfrage" dataObjectRef="data_request_p1_do" />
    <bpmn:dataObject id="data_request_p1_do" />
    <bpmn:dataObjectReference id="data_transaction_data" name="Transaktionsdaten" dataObjectRef="data_transaction_data_do" />
    <bpmn:dataObject id="data_transaction_data_do" />
    <bpmn:dataObjectReference id="data_rejection" name="Ablehnung" dataObjectRef="data_rejection_do" />
    <bpmn:dataObject id="data_rejection_do" />
    <bpmn:startEvent id="start_ip_receive" name="Anfrage empfangen">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_ip_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_data" name="Daten gesendet">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_data_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_send_rejection" name="Ablehnung gesendet">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_rejection_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_check_request" name="Anfrage prüfen">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_check_request_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_request_dia0">
        <bpmn:sourceRef>data_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_request_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_transmit_data" name="Daten übermitteln">
      <bpmn:incoming>flow_to_transmit</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_transmit_data_doa0">
        <bpmn:targetRef>data_transaction_data</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_reject" name="Anfrage ablehnen">
      <bpmn:incoming>flow_to_reject</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_reject_doa0">
        <bpmn:targetRef>data_rejection</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_outcome" name="Prüfungsergebnis" isMarkerVisible="true">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_to_transmit</bpmn:outgoing>
      <bpmn:outgoing>flow_to_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_3" sourceRef="start_ip_receive" targetRef="task_check_request" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_check_request" targetRef="gateway_outcome" />
    <bpmn:sequenceFlow id="flow_to_transmit" sourceRef="gateway_outcome" targetRef="task_transmit_data" name="Anfrage ok" />
    <bpmn:sequenceFlow id="flow_to_reject" sourceRef="gateway_outcome" targetRef="task_reject" name="Anfrage abgelehnt" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_transmit_data" targetRef="end_send_data" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_reject" targetRef="end_send_rejection" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_inq_part_di" bpmnElement="pool_inq_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_ip_part_di" bpmnElement="pool_ip_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="1140" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_inq_di" bpmnElement="end_inq">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_send_data_di" bpmnElement="end_send_data">
        <dc:Bounds x="920" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_send_rejection_di" bpmnElement="end_send_rejection">
        <dc:Bounds x="920" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_send_request_di" bpmnElement="end_send_request">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_outcome_di" bpmnElement="gateway_outcome">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_inq_di" bpmnElement="start_inq">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_ip_receive_di" bpmnElement="start_ip_receive">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_receive_answer_di" bpmnElement="start_receive_answer">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_request_di" bpmnElement="task_check_request">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_reject_di" bpmnElement="task_reject">
        <dc:Bounds x="730" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_transmit_data_di" bpmnElement="task_transmit_data">
        <dc:Bounds x="730" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_transmit_request_di" bpmnElement="task_transmit_request">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_request_di" bpmnElement="data_request">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_request_p1_di" bpmnElement="data_request_p1">
        <dc:Bounds x="370" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_transaction_data_di" bpmnElement="data_transaction_data">
        <dc:Bounds x="750" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_rejection_di" bpmnElement="data_rejection">
        <dc:Bounds x="750" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_transmit_di" bpmnElement="flow_to_transmit">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_reject_di" bpmnElement="flow_to_reject">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="780" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="938" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="780" y="600" />
        <di:waypoint x="938" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_request_di" bpmnElement="mf_request">
        <di:waypoint x="558" y="118" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_data_di" bpmnElement="mf_data">
        <di:waypoint x="938" y="578" />
        <di:waypoint x="178" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_rejection_di" bpmnElement="mf_rejection">
        <di:waypoint x="938" y="703" />
        <di:waypoint x="178" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_transmit_request_doa0_di" bpmnElement="task_transmit_request_doa0">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="388" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_request_dia0_di" bpmnElement="task_check_request_dia0">
        <di:waypoint x="388" y="850" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_transmit_data_doa0_di" bpmnElement="task_transmit_data_doa0">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="768" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_reject_doa0_di" bpmnElement="task_reject_doa0">
        <di:waypoint x="780" y="600" />
        <di:waypoint x="768" y="850" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>