<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_INQ" name="INQ" processRef="Process_INQ" />
    <participant id="Participant_IP" name="IP" processRef="Process_IP" />
    <messageFlow id="MessageFlow_1" name="Transaction Data Request" sourceRef="Task_SendRequest" targetRef="Task_CheckRequest" />
    <messageFlow id="MessageFlow_2" name="Data Transmission" sourceRef="Task_TransmitData" targetRef="Event_End_INQ" />
    <messageFlow id="MessageFlow_3" name="Rejection" sourceRef="Task_RejectRequest" targetRef="Event_End_INQ" />
  </collaboration>

  <process id="Process_INQ" name="INQ" isExecutable="false">
    <startEvent id="Event_Start_INQ" name="Start">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_SendRequest" name="Transmit transaction data request">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <endEvent id="Event_End_INQ" name="Response Received">
      <incoming>Flow_2</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="Event_Start_INQ" targetRef="Task_SendRequest" />
    <sequenceFlow id="Flow_2" sourceRef="Task_SendRequest" targetRef="Event_End_INQ" />
  </process>

  <process id="Process_IP" name="IP" isExecutable="false">
    <startEvent id="Event_Start_IP" name="Request Received">
      <outgoing>Flow_3</outgoing>
    </startEvent>

    <task id="Task_CheckRequest" name="Check request of the INQ">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Decision" name="Examination Outcome?">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>

    <task id="Task_TransmitData" name="Transmit data">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_7</outgoing>
    </task>

    <task id="Task_RejectRequest" name="Reject request">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_8</outgoing>
    </task>

    <endEvent id="Event_End_IP" name="End">
      <incoming>Flow_7</incoming>
      <incoming>Flow_8</incoming>
    </endEvent>

    <sequenceFlow id="Flow_3" sourceRef="Event_Start_IP" targetRef="Task_CheckRequest" />
    <sequenceFlow id="Flow_4" sourceRef="Task_CheckRequest" targetRef="Gateway_Decision" />
    <sequenceFlow id="Flow_5" name="Request Valid" sourceRef="Gateway_Decision" targetRef="Task_TransmitData" />
    <sequenceFlow id="Flow_6" name="Request Invalid" sourceRef="Gateway_Decision" targetRef="Task_RejectRequest" />
    <sequenceFlow id="Flow_7" sourceRef="Task_TransmitData" targetRef="Event_End_IP" />
    <sequenceFlow id="Flow_8" sourceRef="Task_RejectRequest" targetRef="Event_End_IP" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_INQ_di" bpmnElement="Participant_INQ" isHorizontal="true">
        <omgdc:Bounds x="100" y="60" width="600" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_Start_INQ_di" bpmnElement="Event_Start_INQ">
        <omgdc:Bounds x="150" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendRequest_di" bpmnElement="Task_SendRequest">
        <omgdc:Bounds x="240" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_End_INQ_di" bpmnElement="Event_End_INQ">
        <omgdc:Bounds x="620" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="186" y="140" />
        <omgdi:waypoint x="240" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="360" y="140" />
        <omgdi:waypoint x="620" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_IP_di" bpmnElement="Participant_IP" isHorizontal="true">
        <omgdc:Bounds x="100" y="280" width="700" height="220" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_Start_IP_di" bpmnElement="Event_Start_IP">
        <omgdc:Bounds x="150" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckRequest_di" bpmnElement="Task_CheckRequest">
        <omgdc:Bounds x="240" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <omgdc:Bounds x="405" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TransmitData_di" bpmnElement="Task_TransmitData">
        <omgdc:Bounds x="520" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RejectRequest_di" bpmnElement="Task_RejectRequest">
        <omgdc:Bounds x="520" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_End_IP_di" bpmnElement="Event_End_IP">
        <omgdc:Bounds x="700" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="186" y="380" />
        <omgdi:waypoint x="240" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="360" y="380" />
        <omgdi:waypoint x="405" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="430" y="355" />
        <omgdi:waypoint x="430" y="340" />
        <omgdi:waypoint x="520" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="430" y="405" />
        <omgdi:waypoint x="430" y="440" />
        <omgdi:waypoint x="520" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <omgdi:waypoint x="640" y="340" />
        <omgdi:waypoint x="718" y="340" />
        <omgdi:waypoint x="718" y="362" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <omgdi:waypoint x="640" y="440" />
        <omgdi:waypoint x="718" y="440" />
        <omgdi:waypoint x="718" y="398" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <omgdi:waypoint x="300" y="180" />
        <omgdi:waypoint x="300" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <omgdi:waypoint x="580" y="300" />
        <omgdi:waypoint x="638" y="158" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_3_di" bpmnElement="MessageFlow_3">
        <omgdi:waypoint x="580" y="400" />
        <omgdi:waypoint x="638" y="158" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
