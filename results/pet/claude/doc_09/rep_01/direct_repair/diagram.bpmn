<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_INQ" name="INQ" processRef="Process_INQ" />
    <participant id="Participant_IP" name="IP" processRef="Process_IP" />

    <messageFlow id="MessageFlow_Request" name="Transaction data request"
                 sourceRef="Task_TransmitRequest" targetRef="StartEvent_IP" />
    <messageFlow id="MessageFlow_DataTransmission" name="Data transmission"
                 sourceRef="Task_TransmitData" targetRef="Task_ReceiveAnswer" />
    <messageFlow id="MessageFlow_Rejection" name="Rejection"
                 sourceRef="Task_RejectRequest" targetRef="Task_ReceiveAnswer" />
  </collaboration>

  <!-- INQ Process -->
  <process id="Process_INQ" name="INQ Process" isExecutable="false">
    <startEvent id="StartEvent_INQ" name="Start">
      <outgoing>Flow_INQ_1</outgoing>
    </startEvent>

    <task id="Task_TransmitRequest" name="Transmit transaction data request">
      <incoming>Flow_INQ_1</incoming>
      <outgoing>Flow_INQ_2</outgoing>
    </task>

    <task id="Task_ReceiveAnswer" name="Receive answer from IP">
      <incoming>Flow_INQ_2</incoming>
      <outgoing>Flow_INQ_3</outgoing>
    </task>

    <endEvent id="EndEvent_INQ" name="End">
      <incoming>Flow_INQ_3</incoming>
    </endEvent>

    <sequenceFlow id="Flow_INQ_1" sourceRef="StartEvent_INQ" targetRef="Task_TransmitRequest" />
    <sequenceFlow id="Flow_INQ_2" sourceRef="Task_TransmitRequest" targetRef="Task_ReceiveAnswer" />
    <sequenceFlow id="Flow_INQ_3" sourceRef="Task_ReceiveAnswer" targetRef="EndEvent_INQ" />
  </process>

  <!-- IP Process -->
  <process id="Process_IP" name="IP Process" isExecutable="false">
    <startEvent id="StartEvent_IP" name="Request received">
      <outgoing>Flow_IP_1</outgoing>
    </startEvent>

    <task id="Task_CheckRequest" name="Check request of INQ">
      <incoming>Flow_IP_1</incoming>
      <outgoing>Flow_IP_2</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Decision" name="Examination result?">
      <incoming>Flow_IP_2</incoming>
      <outgoing>Flow_IP_3</outgoing>
      <outgoing>Flow_IP_4</outgoing>
    </exclusiveGateway>

    <task id="Task_TransmitData" name="Transmit data">
      <incoming>Flow_IP_3</incoming>
      <outgoing>Flow_IP_5</outgoing>
    </task>

    <task id="Task_RejectRequest" name="Reject request">
      <incoming>Flow_IP_4</incoming>
      <outgoing>Flow_IP_6</outgoing>
    </task>

    <endEvent id="EndEvent_IP_Transmitted" name="Data transmitted">
      <incoming>Flow_IP_5</incoming>
    </endEvent>

    <endEvent id="EndEvent_IP_Rejected" name="Request rejected">
      <incoming>Flow_IP_6</incoming>
    </endEvent>

    <sequenceFlow id="Flow_IP_1" sourceRef="StartEvent_IP" targetRef="Task_CheckRequest" />
    <sequenceFlow id="Flow_IP_2" sourceRef="Task_CheckRequest" targetRef="Gateway_Decision" />
    <sequenceFlow id="Flow_IP_3" name="Request valid" sourceRef="Gateway_Decision" targetRef="Task_TransmitData" />
    <sequenceFlow id="Flow_IP_4" name="Request invalid" sourceRef="Gateway_Decision" targetRef="Task_RejectRequest" />
    <sequenceFlow id="Flow_IP_5" sourceRef="Task_TransmitData" targetRef="EndEvent_IP_Transmitted" />
    <sequenceFlow id="Flow_IP_6" sourceRef="Task_RejectRequest" targetRef="EndEvent_IP_Rejected" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_INQ_di" bpmnElement="Participant_INQ" isHorizontal="true">
        <omgdc:Bounds x="100" y="60" width="700" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_INQ_di" bpmnElement="StartEvent_INQ">
        <omgdc:Bounds x="150" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TransmitRequest_di" bpmnElement="Task_TransmitRequest">
        <omgdc:Bounds x="240" y="98" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveAnswer_di" bpmnElement="Task_ReceiveAnswer">
        <omgdc:Bounds x="500" y="98" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_INQ_di" bpmnElement="EndEvent_INQ">
        <omgdc:Bounds x="700" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_INQ_1_di" bpmnElement="Flow_INQ_1">
        <omgdi:waypoint x="186" y="138" />
        <omgdi:waypoint x="240" y="138" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_INQ_2_di" bpmnElement="Flow_INQ_2">
        <omgdi:waypoint x="360" y="138" />
        <omgdi:waypoint x="500" y="138" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_INQ_3_di" bpmnElement="Flow_INQ_3">
        <omgdi:waypoint x="620" y="138" />
        <omgdi:waypoint x="700" y="138" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_IP_di" bpmnElement="Participant_IP" isHorizontal="true">
        <omgdc:Bounds x="100" y="260" width="700" height="250" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_IP_di" bpmnElement="StartEvent_IP">
        <omgdc:Bounds x="150" y="360" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckRequest_di" bpmnElement="Task_CheckRequest">
        <omgdc:Bounds x="230" y="338" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <omgdc:Bounds x="400" y="353" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TransmitData_di" bpmnElement="Task_TransmitData">
        <omgdc:Bounds x="500" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RejectRequest_di" bpmnElement="Task_RejectRequest">
        <omgdc:Bounds x="500" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_IP_Transmitted_di" bpmnElement="EndEvent_IP_Transmitted">
        <omgdc:Bounds x="680" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_IP_Rejected_di" bpmnElement="EndEvent_IP_Rejected">
        <omgdc:Bounds x="680" y="422" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_IP_1_di" bpmnElement="Flow_IP_1">
        <omgdi:waypoint x="186" y="378" />
        <omgdi:waypoint x="230" y="378" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_IP_2_di" bpmnElement="Flow_IP_2">
        <omgdi:waypoint x="350" y="378" />
        <omgdi:waypoint x="400" y="378" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_IP_3_di" bpmnElement="Flow_IP_3">
        <omgdi:waypoint x="425" y="353" />
        <omgdi:waypoint x="425" y="320" />
        <omgdi:waypoint x="500" y="320" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_IP_4_di" bpmnElement="Flow_IP_4">
        <omgdi:waypoint x="425" y="403" />
        <omgdi:waypoint x="425" y="440" />
        <omgdi:waypoint x="500" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_IP_5_di" bpmnElement="Flow_IP_5">
        <omgdi:waypoint x="620" y="320" />
        <omgdi:waypoint x="680" y="320" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_IP_6_di" bpmnElement="Flow_IP_6">
        <omgdi:waypoint x="620" y="440" />
        <omgdi:waypoint x="680" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Request_di" bpmnElement="MessageFlow_Request">
        <omgdi:waypoint x="300" y="178" />
        <omgdi:waypoint x="300" y="260" />
        <omgdi:waypoint x="168" y="260" />
        <omgdi:waypoint x="168" y="360" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_DataTransmission_di" bpmnElement="MessageFlow_DataTransmission">
        <omgdi:waypoint x="560" y="280" />
        <omgdi:waypoint x="560" y="178" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Rejection_di" bpmnElement="MessageFlow_Rejection">
        <omgdi:waypoint x="560" y="400" />
        <omgdi:waypoint x="560" y="178" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
