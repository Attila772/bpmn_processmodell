        <di:waypoint x="368" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_msg5_di" bpmnElement="flow_msg5">
        <di:waypoint x="1350" y="725" />
        <di:waypoint x="178" y="1373" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow9_di" bpmnElement="flow9">
        <di:waypoint x="178" y="1373" />
        <di:waypoint x="368" y="1373" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_di" bpmnElement="mf1">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="178" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_di" bpmnElement="mf2">
        <di:waypoint x="150" y="140" />
        <di:waypoint x="178" y="243" />
