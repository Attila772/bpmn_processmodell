<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO" />
    <participant id="Participant_GO" name="GO" processRef="Process_GO" />
    <participant id="Participant_MPO" name="MPO" />
    <participant id="Participant_SP" name="SP" />

    <messageFlow id="MF1" name="Deregistration request" sourceRef="Task_1" targetRef="StartEvent_2" />
    <messageFlow id="MF2" name="Info on end/start of assignment" sourceRef="Task_6" targetRef="IntermediateCatchEvent_1" />
    <messageFlow id="MF3" name="Info on assignment of GO" sourceRef="Task_7" targetRef="Participant_MPO" />
    <messageFlow id="MF4" name="Info on assignment of GO" sourceRef="Task_8" targetRef="Participant_SP" />
  </collaboration>

  <process id="Process_MSPO" name="MSPO Process" isExecutable="false">
    <startEvent id="StartEvent_1" name="Start">
      <outgoing>SF1</outgoing>
    </startEvent>

    <sendTask id="Task_1" name="Deregisters at the GO">
      <incoming>SF1</incoming>
      <outgoing>SF2</outgoing>
    </sendTask>

    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Informed about end/beginning of assignment">
      <incoming>SF2</incoming>
      <outgoing>SF3</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1" />
    </intermediateCatchEvent>

    <endEvent id="EndEvent_1" name="End">
      <incoming>SF3</incoming>
    </endEvent>

    <sequenceFlow id="SF1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <sequenceFlow id="SF2" sourceRef="Task_1" targetRef="IntermediateCatchEvent_1" />
    <sequenceFlow id="SF3" sourceRef="IntermediateCatchEvent_1" targetRef="EndEvent_1" />
  </process>

  <process id="Process_GO" name="GO Process" isExecutable="false">
    <startEvent id="StartEvent_2" name="Deregistration received">
      <outgoing>SF4</outgoing>
      <messageEventDefinition id="MessageEventDefinition_2" />
    </startEvent>

    <task id="Task_2" name="Verifies the deregistration">
      <incoming>SF4</incoming>
      <outgoing>SF5</outgoing>
    </task>

    <exclusiveGateway id="Gateway_1" name="Verification result">
      <incoming>SF5</incoming>
      <outgoing>SF6</outgoing>
      <outgoing>SF8</outgoing>
    </exclusiveGateway>

    <task id="Task_3" name="Rejects the deregistration of the MSPO">
      <incoming>SF6</incoming>
      <outgoing>SF7</outgoing>
    </task>

    <endEvent id="EndEvent_2" name="Deregistration rejected">
      <incoming>SF7</incoming>
    </endEvent>

    <task id="Task_4" name="Preliminarily confirms the deregistration of the MSPO">
      <incoming>SF8</incoming>
      <outgoing>SF9</outgoing>
    </task>

    <task id="Task_5" name="Assigns himself as MSP">
      <incoming>SF9</incoming>
      <outgoing>SF10</outgoing>
    </task>

    <parallelGateway id="Gateway_2" name="Split">
      <incoming>SF10</incoming>
      <outgoing>SF11</outgoing>
      <outgoing>SF12</outgoing>
      <outgoing>SF13</outgoing>
    </parallelGateway>

    <sendTask id="Task_6" name="Informs the MSPO about the end/beginning of the assignment">
      <incoming>SF11</incoming>
      <outgoing>SF14</outgoing>
    </sendTask>

    <sendTask id="Task_7" name="Informs the MPO about the assignment of the GO">
      <incoming>SF12</incoming>
      <outgoing>SF15</outgoing>
    </sendTask>

    <sendTask id="Task_8" name="Informs the SP about the assignment of the GO">
      <incoming>SF13</incoming>
      <outgoing>SF16</outgoing>
    </sendTask>

    <parallelGateway id="Gateway_3" name="Join">
      <incoming>SF14</incoming>
      <incoming>SF15</incoming>
      <incoming>SF16</incoming>
      <outgoing>SF17</outgoing>
    </parallelGateway>

    <endEvent id="EndEvent_3" name="Assignment process completed">
      <incoming>SF17</incoming>
    </endEvent>

    <sequenceFlow id="SF4" sourceRef="StartEvent_2" targetRef="Task_2" />
    <sequenceFlow id="SF5" sourceRef="Task_2" targetRef="Gateway_1" />
    <sequenceFlow id="SF6" name="Rejected" sourceRef="Gateway_1" targetRef="Task_3" />
    <sequenceFlow id="SF7" sourceRef="Task_3" targetRef="EndEvent_2" />
    <sequenceFlow id="SF8" name="Confirmed" sourceRef="Gateway_1" targetRef="Task_4" />
    <sequenceFlow id="SF9" sourceRef="Task_4" targetRef="Task_5" />
    <sequenceFlow id="SF10" sourceRef="Task_5" targetRef="Gateway_2" />
    <sequenceFlow id="SF11" sourceRef="Gateway_2" targetRef="Task_6" />
    <sequenceFlow id="SF12" sourceRef="Gateway_2" targetRef="Task_7" />
    <sequenceFlow id="SF13" sourceRef="Gateway_2" targetRef="Task_8" />
    <sequenceFlow id="SF14" sourceRef="Task_6" targetRef="Gateway_3" />
    <sequenceFlow id="SF15" sourceRef="Task_7" targetRef="Gateway_3" />
    <sequenceFlow id="SF16" sourceRef="Task_8" targetRef="Gateway_3" />
    <sequenceFlow id="SF17" sourceRef="Gateway_3" targetRef="EndEvent_3" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_MSPO_di" bpmnElement="Participant_MSPO" isHorizontal="true">
        <omgdc:Bounds x="100" y="60" width="600" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="150" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <omgdc:Bounds x="230" y="98" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent_1_di" bpmnElement="IntermediateCatchEvent_1">
        <omgdc:Bounds x="380" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="460" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Participant_GO_di" bpmnElement="Participant_GO" isHorizontal="true">
        <omgdc:Bounds x="100" y="260" width="900" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_2_di" bpmnElement="StartEvent_2">
        <omgdc:Bounds x="150" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <omgdc:Bounds x="220" y="318" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <omgdc:Bounds x="360" y="333" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <omgdc:Bounds x="450" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <omgdc:Bounds x="600" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <omgdc:Bounds x="450" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <omgdc:Bounds x="600" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_2_di" bpmnElement="Gateway_2">
        <omgdc:Bounds x="740" y="395" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <omgdc:Bounds x="830" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7">
        <omgdc:Bounds x="830" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_8_di" bpmnElement="Task_8">
        <omgdc:Bounds x="830" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_3_di" bpmnElement="Gateway_3">
        <omgdc:Bounds x="980" y="395" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_3_di" bpmnElement="EndEvent_3">
        <omgdc:Bounds x="1070" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Participant_MPO_di" bpmnElement="Participant_MPO" isHorizontal="true">
        <omgdc:Bounds x="100" y="520" width="900" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_SP_di" bpmnElement="Participant_SP" isHorizontal="true">
        <omgdc:Bounds x="100" y="620" width="900" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="SF1_di" bpmnElement="SF1">
        <omgdi:waypoint x="186" y="138" />
        <omgdi:waypoint x="230" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF2_di" bpmnElement="SF2">
        <omgdi:waypoint x="330" y="138" />
        <omgdi:waypoint x="380" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF3_di" bpmnElement="SF3">
        <omgdi:waypoint x="416" y="138" />
        <omgdi:waypoint x="460" y="138" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF4_di" bpmnElement="SF4">
        <omgdi:waypoint x="186" y="358" />
        <omgdi:waypoint x="220" y="358" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF5_di" bpmnElement="SF5">
        <omgdi:waypoint x="320" y="358" />
        <omgdi:waypoint x="360" y="358" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF6_di" bpmnElement="SF6">
        <omgdi:waypoint x="400" y="340" />
        <omgdi:waypoint x="450" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF7_di" bpmnElement="SF7">
        <omgdi:waypoint x="550" y="300" />
        <omgdi:waypoint x="600" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF8_di" bpmnElement="SF8">
        <omgdi:waypoint x="400" y="375" />
        <omgdi:waypoint x="450" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF9_di" bpmnElement="SF9">
        <omgdi:waypoint x="550" y="420" />
        <omgdi:waypoint x="600" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF10_di" bpmnElement="SF10">
        <omgdi:waypoint x="700" y="420" />
        <omgdi:waypoint x="740" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF11_di" bpmnElement="SF11">
        <omgdi:waypoint x="765" y="395" />
        <omgdi:waypoint x="765" y="320" />
        <omgdi:waypoint x="830" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF12_di" bpmnElement="SF12">
        <omgdi:waypoint x="790" y="420" />
        <omgdi:waypoint x="830" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF13_di" bpmnElement="SF13">
        <omgdi:waypoint x="765" y="445" />
        <omgdi:waypoint x="765" y="520" />
        <omgdi:waypoint x="830" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF14_di" bpmnElement="SF14">
        <omgdi:waypoint x="930" y="320" />
        <omgdi:waypoint x="1005" y="320" />
        <omgdi:waypoint x="1005" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF15_di" bpmnElement="SF15">
        <omgdi:waypoint x="930" y="420" />
        <omgdi:waypoint x="980" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF16_di" bpmnElement="SF16">
        <omgdi:waypoint x="930" y="520" />
        <omgdi:waypoint x="1005" y="520" />
        <omgdi:waypoint x="1005" y="445" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF17_di" bpmnElement="SF17">
        <omgdi:waypoint x="1030" y="420" />
        <omgdi:waypoint x="1070" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MF1_di" bpmnElement="MF1">
        <omgdi:waypoint x="280" y="178" />
        <omgdi:waypoint x="280" y="250" />
        <omgdi:waypoint x="168" y="250" />
        <omgdi:waypoint x="168" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF2_di" bpmnElement="MF2">
        <omgdi:waypoint x="880" y="280" />
        <omgdi:waypoint x="880" y="200" />
        <omgdi:waypoint x="398" y="200" />
        <omgdi:waypoint x="398" y="156" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF3_di" bpmnElement="MF3">
        <omgdi:waypoint x="880" y="460" />
        <omgdi:waypoint x="880" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF4_di" bpmnElement="MF4">
        <omgdi:waypoint x="880" y="560" />
        <omgdi:waypoint x="880" y="620" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
