<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="task_deregister" targetRef="start_receive_dereg" name="Deregistration" />
    <bpmn:messageFlow id="mf2" sourceRef="end_reject_go" targetRef="end_reject_msg" name="Rejection" />
    <bpmn:messageFlow id="mf3" sourceRef="task_inform_mspo" targetRef="end_informed_msg" name="Assignment Info MSPO" />
    <bpmn:messageFlow id="mf4" sourceRef="task_inform_mpo" targetRef="start_mpo_informed" name="Assignment Info MPO" />
    <bpmn:messageFlow id="mf5" sourceRef="task_inform_sp" targetRef="start_sp_informed" name="Assignment Info SP" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mspo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_deregistration" name="Deregistration Document" dataObjectRef="data_deregistration_do" />
    <bpmn:dataObject id="data_deregistration_do" />
    <bpmn:startEvent id="start_deregister" name="Start">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_reject_msg" name="Deregistration rejected received">
      <bpmn:messageEventDefinition id="end_reject_msg_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_informed_msg" name="Informed about end/start of assignment">
      <bpmn:messageEventDefinition id="end_informed_msg_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_deregister" name="MSPO deregisters at the GO">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_deregister_doa0">
        <bpmn:targetRef>data_deregistration</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_deregister" targetRef="task_deregister" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_deregistration_p1" name="Deregistration Document" dataObjectRef="data_deregistration_p1_do" />
    <bpmn:dataObject id="data_deregistration_p1_do" />
    <bpmn:dataObjectReference id="data_assignment" name="Assignment Confirmation" dataObjectRef="data_assignment_do" />
    <bpmn:dataObject id="data_assignment_do" />
    <bpmn:startEvent id="start_receive_dereg" name="Deregistration received">
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_dereg_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_go_process" name="End">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:incoming>sf11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_reject_go" name="Deregistration rejected">
      <bpmn:incoming>flow_reject</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_reject_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_verify" name="GO verifies the deregistration">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="task_verify_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_verify_dia0">
        <bpmn:sourceRef>data_deregistration_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_verify_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_assign_self" name="GO assigns himself as MSP">
      <bpmn:incoming>flow_confirm</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_assign_self_doa0">
        <bpmn:targetRef>data_assignment</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_inform_mspo" name="GO informs the MSPO about end/start of assignment">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:property id="task_inform_mspo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mspo_dia0">
        <bpmn:sourceRef>data_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mspo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_inform_mpo" name="GO informs the MPO about the assignment of the GO">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="task_inform_mpo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mpo_dia0">
        <bpmn:sourceRef>data_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mpo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_inform_sp" name="GO informs the SP about the assignment of the GO">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:property id="task_inform_sp_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_sp_dia0">
        <bpmn:sourceRef>data_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_sp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_decision" name="Deregistration confirmed?" isMarkerVisible="true">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>flow_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf3" sourceRef="start_receive_dereg" targetRef="task_verify" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task_verify" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_reject" sourceRef="gw_decision" targetRef="end_reject_go" name="rejected" />
    <bpmn:sequenceFlow id="flow_confirm" sourceRef="gw_decision" targetRef="task_assign_self" name="preliminarily confirmed" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task_assign_self" targetRef="task_inform_mspo" />
    <bpmn:sequenceFlow id="sf6" sourceRef="task_inform_mspo" targetRef="task_inform_mpo" />
    <bpmn:sequenceFlow id="sf7" sourceRef="task_inform_mspo" targetRef="task_inform_mpo" />
    <bpmn:sequenceFlow id="sf8" sourceRef="task_inform_mpo" targetRef="task_inform_sp" />
    <bpmn:sequenceFlow id="sf9" sourceRef="task_inform_mpo" targetRef="task_inform_sp" />
    <bpmn:sequenceFlow id="sf10" sourceRef="task_inform_sp" targetRef="end_go_process" />
    <bpmn:sequenceFlow id="sf11" sourceRef="task_inform_sp" targetRef="end_go_process" />
  </bpmn:process>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:startEvent id="start_mpo_informed" name="Assignment info received">
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpo_informed_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpo_informed" name="End">
      <bpmn:incoming>sf12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf12" sourceRef="start_mpo_informed" targetRef="end_mpo_informed" />
  </bpmn:process>
  <bpmn:process id="pool_sp_proc" isExecutable="false">
    <bpmn:startEvent id="start_sp_informed" name="Assignment info received">
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_sp_informed_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_sp_informed" name="End">
      <bpmn:incoming>sf13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf13" sourceRef="start_sp_informed" targetRef="end_sp_informed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
