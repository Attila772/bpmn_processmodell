      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <omgdi:waypoint x="1540" y="270"/>
        <omgdi:waypoint x="1590" y="270"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <omgdi:waypoint x="1700" y="270"/>
        <omgdi:waypoint x="1750" y="270"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <omgdi:waypoint x="1775" y="245"/>
        <omgdi:waypoint x="1775" y="130"/>
