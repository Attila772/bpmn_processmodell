<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_IPO"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_IPO" name="IPO Process" processRef="Process_IPO"/>
  </collaboration>

  <process id="Process_IPO" isExecutable="false">

    <laneSet id="LaneSet_1">
      <lane id="Lane_Company" name="Company">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_SelectUnderwriters</flowNodeRef>
        <flowNodeRef>EndEvent_Withdrawn</flowNodeRef>
        <flowNodeRef>EndEvent_Offered</flowNodeRef>
      </lane>
      <lane id="Lane_Underwriters" name="Underwriters">
        <flowNodeRef>Task_Advice</flowNodeRef>
        <flowNodeRef>Task_PrepareRegistration</flowNodeRef>
        <flowNodeRef>Gateway_Split1</flowNodeRef>
        <flowNodeRef>Task_RegisterSEC</flowNodeRef>
        <flowNodeRef>Task_CheckBlueSky</flowNodeRef>
        <flowNodeRef>Gateway_Join1</flowNodeRef>
        <flowNodeRef>Gateway_Split2</flowNodeRef>
        <flowNodeRef>Task_RoadShow</flowNodeRef>
        <flowNodeRef>Task_FirmUpPrice</flowNodeRef>
        <flowNodeRef>Gateway_Join2</flowNodeRef>
        <flowNodeRef>Task_ReceiveClearance</flowNodeRef>
        <flowNodeRef>Task_FixIssuePrice</flowNodeRef>
        <flowNodeRef>Gateway_Decision</flowNodeRef>
        <flowNodeRef>Task_FirmCommitment</flowNodeRef>
        <flowNodeRef>Task_OfferToPublic</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Company decides to go public">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_SelectUnderwriters" name="Select underwriters">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <task id="Task_Advice" name="Provide procedural and financial advice">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <task id="Task_PrepareRegistration" name="Prepare registration statement">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <parallelGateway id="Gateway_Split1" name="Split: Registration tasks">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </parallelGateway>

    <task id="Task_RegisterSEC" name="Register issue with SEC">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_7</outgoing>
    </task>

    <task id="Task_CheckBlueSky" name="Check compliance with blue-sky laws of each state">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_8</outgoing>
    </task>

    <parallelGateway id="Gateway_Join1" name="Join">
      <incoming>Flow_7</incoming>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
    </parallelGateway>

    <parallelGateway id="Gateway_Split2" name="Split: While awaiting approval">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
    </parallelGateway>

    <task id="Task_RoadShow" name="Arrange road show to talk to potential investors">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_12</outgoing>
    </task>

    <task id="Task_FirmUpPrice" name="Firm up the issue price">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_13</outgoing>
    </task>

    <parallelGateway id="Gateway_Join2" name="Join">
      <incoming>Flow_12</incoming>
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
    </parallelGateway>

    <task id="Task_ReceiveClearance" name="Receive clearance from SEC">
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
    </task>

    <task id="Task_FixIssuePrice" name="Fix the issue price">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Decision" name="Found reason not to proceed?">
      <incoming>Flow_16</incoming>
      <outgoing>Flow_Yes</outgoing>
      <outgoing>Flow_No</outgoing>
    </exclusiveGateway>

    <task id="Task_FirmCommitment" name="Enter firm commitment to buy the stock">
      <incoming>Flow_No</incoming>
      <outgoing>Flow_17</outgoing>
    </task>

    <task id="Task_OfferToPublic" name="Offer the stock to the public">
      <incoming>Flow_17</incoming>
      <outgoing>Flow_18</outgoing>
    </task>

    <endEvent id="EndEvent_Offered" name="Stock offered to the public">
      <incoming>Flow_18</incoming>
    </endEvent>

    <endEvent id="EndEvent_Withdrawn" name="Issue withdrawn">
      <incoming>Flow_Yes</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SelectUnderwriters"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_SelectUnderwriters" targetRef="Task_Advice"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_Advice" targetRef="Task_PrepareRegistration"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_PrepareRegistration" targetRef="Gateway_Split1"/>
    <sequenceFlow id="Flow_5" sourceRef="Gateway_Split1" targetRef="Task_RegisterSEC"/>
    <sequenceFlow id="Flow_6" sourceRef="Gateway_Split1" targetRef="Task_CheckBlueSky"/>
    <sequenceFlow id="Flow_7" sourceRef="Task_RegisterSEC" targetRef="Gateway_Join1"/>
    <sequenceFlow id="Flow_8" sourceRef="Task_CheckBlueSky" targetRef="Gateway_Join1"/>
    <sequenceFlow id="Flow_9" sourceRef="Gateway_Join1" targetRef="Gateway_Split2"/>
    <sequenceFlow id="Flow_10" sourceRef="Gateway_Split2" targetRef="Task_RoadShow"/>
    <sequenceFlow id="Flow_11" sourceRef="Gateway_Split2" targetRef="Task_FirmUpPrice"/>
    <sequenceFlow id="Flow_12" sourceRef="Task_RoadShow" targetRef="Gateway_Join2"/>
    <sequenceFlow id="Flow_13" sourceRef="Task_FirmUpPrice" targetRef="Gateway_Join2"/>
    <sequenceFlow id="Flow_14" sourceRef="Gateway_Join2" targetRef="Task_ReceiveClearance"/>
    <sequenceFlow id="Flow_15" sourceRef="Task_ReceiveClearance" targetRef="Task_FixIssuePrice"/>
    <sequenceFlow id="Flow_16" sourceRef="Task_FixIssuePrice" targetRef="Gateway_Decision"/>
    <sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_Decision" targetRef="EndEvent_Withdrawn"/>
    <sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Decision" targetRef="Task_FirmCommitment"/>
    <sequenceFlow id="Flow_17" sourceRef="Task_FirmCommitment" targetRef="Task_OfferToPublic"/>
    <sequenceFlow id="Flow_18" sourceRef="Task_OfferToPublic" targetRef="EndEvent_Offered"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_IPO_di" bpmnElement="Participant_IPO" isHorizontal="true">
        <omgdc:Bounds x="100" y="60" width="1900" height="460"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Company_di" bpmnElement="Lane_Company" isHorizontal="true">
        <omgdc:Bounds x="130" y="60" width="1870" height="140"/>
