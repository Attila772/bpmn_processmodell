      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Join1_di" bpmnElement="Gateway_Join1">
        <omgdc:Bounds x="990" y="245" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Split2_di" bpmnElement="Gateway_Split2">
        <omgdc:Bounds x="1080" y="245" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RoadShow_di" bpmnElement="Task_RoadShow">
        <omgdc:Bounds x="1180" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FirmUpPrice_di" bpmnElement="Task_FirmUpPrice">
        <omgdc:Bounds x="1180" y="320" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Join2_di" bpmnElement="Gateway_Join2">
        <omgdc:Bounds x="1340" y="245" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveClearance_di" bpmnElement="Task_ReceiveClearance">
        <omgdc:Bounds x="1430" y="230" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FixIssuePrice_di" bpmnElement="Task_FixIssuePrice">
        <omgdc:Bounds x="1590" y="230" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <omgdc:Bounds x="1750" y="245" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FirmCommitment_di" bpmnElement="Task_FirmCommitment">
        <omgdc:Bounds x="1840" y="230" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_OfferToPublic_di" bpmnElement="Task_OfferToPublic">
        <omgdc:Bounds x="1840" y="340" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Offered_di" bpmnElement="EndEvent_Offered">
        <omgdc:Bounds x="1995" y="360" width="36" height="36"/>
