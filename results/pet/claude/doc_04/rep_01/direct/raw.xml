      <bpmndi:BPMNShape id="Lane_Underwriters_di" bpmnElement="Lane_Underwriters" isHorizontal="true">
        <omgdc:Bounds x="130" y="200" width="1870" height="320"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="170" y="112" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SelectUnderwriters_di" bpmnElement="Task_SelectUnderwriters">
