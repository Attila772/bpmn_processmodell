        <omgdi:waypoint x="1105" y="360"/>
        <omgdi:waypoint x="1180" y="360"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <omgdi:waypoint x="1290" y="250"/>
        <omgdi:waypoint x="1340" y="250"/>
