<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do_registration_statement" name="Registration statement" dataObjectRef="do_registration_statement_do" />
    <bpmn:dataObject id="do_registration_statement_do" />
    <bpmn:startEvent id="ev_start" name="Company decides to go public">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="ev_sec_approval" name="SEC clearance received">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_sec_approval_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ev_end_proceed" name="Stock offered to public">
      <bpmn:incoming>sf11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_end_abort" name="Issue withdrawn">
      <bpmn:incoming>sf_gw1_no</bpmn:incoming>
      <bpmn:incoming>sf_gw2_reason</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1" name="Select underwriters">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Provide procedural and financial advice">
      <bpmn:incoming>sf_gw1_yes</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Prepare registration statement">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t3_doa0">
        <bpmn:targetRef>do_registration_statement</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t4" name="Submit registration statement to SEC for approval">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t4_dia0">
        <bpmn:sourceRef>do_registration_statement</bpmn:sourceRef>
        <bpmn:targetRef>t4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t5" name="Check compliance with blue-sky laws of each state">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="t5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t5_dia0">
        <bpmn:sourceRef>do_registration_statement</bpmn:sourceRef>
        <bpmn:targetRef>t5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t6" name="Arrange road show to talk to potential investors">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Fix issue price">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Enter into firm commitment to buy the stock">
      <bpmn:incoming>sf_gw2_no_reason</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Offer stock to the public">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_facts_fair" name="Facts presented fairly?" isMarkerVisible="true">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf_gw1_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_gw1_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_reason_not" name="Reason not to proceed found?" isMarkerVisible="true">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf_gw2_no_reason</bpmn:outgoing>
      <bpmn:outgoing>sf_gw2_reason</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf1" sourceRef="ev_start" targetRef="t1" />
    <bpmn:sequenceFlow id="sf2" sourceRef="t1" targetRef="gw_facts_fair" />
    <bpmn:sequenceFlow id="sf_gw1_yes" sourceRef="gw_facts_fair" targetRef="t2" name="yes - facts presented fairly" />
    <bpmn:sequenceFlow id="sf_gw1_no" sourceRef="gw_facts_fair" targetRef="ev_end_abort" name="no - facts not presented fairly" />
    <bpmn:sequenceFlow id="sf3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="sf4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="sf5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="sf6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="sf7" sourceRef="t6" targetRef="ev_sec_approval" />
    <bpmn:sequenceFlow id="sf8" sourceRef="ev_sec_approval" targetRef="t7" />
    <bpmn:sequenceFlow id="sf9" sourceRef="t7" targetRef="gw_reason_not" />
    <bpmn:sequenceFlow id="sf_gw2_no_reason" sourceRef="gw_reason_not" targetRef="t8" name="no reason found - proceed" />
    <bpmn:sequenceFlow id="sf_gw2_reason" sourceRef="gw_reason_not" targetRef="ev_end_abort" name="reason found - do not proceed" />
    <bpmn:sequenceFlow id="sf10" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="sf11" sourceRef="t9" targetRef="ev_end_proceed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="ev_end_abort_di" bpmnElement="ev_end_abort">
        <dc:Bounds x="2250" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_end_proceed_di" bpmnElement="ev_end_proceed">
        <dc:Bounds x="2630" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_sec_approval_di" bpmnElement="ev_sec_approval">
        <dc:Bounds x="1680" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_start_di" bpmnElement="ev_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_facts_fair_di" bpmnElement="gw_facts_fair">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_reason_not_di" bpmnElement="gw_reason_not">
        <dc:Bounds x="2060" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6">
        <dc:Bounds x="1490" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7">
        <dc:Bounds x="1870" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8">
        <dc:Bounds x="2250" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t9_di" bpmnElement="t9">
        <dc:Bounds x="2440" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_registration_statement_di" bpmnElement="do_registration_statement">
        <dc:Bounds x="1130" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_gw1_yes_di" bpmnElement="sf_gw1_yes">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_gw1_no_di" bpmnElement="sf_gw1_no">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="2268" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf4_di" bpmnElement="sf4">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf5_di" bpmnElement="sf5">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf6_di" bpmnElement="sf6">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1540" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf7_di" bpmnElement="sf7">
        <di:waypoint x="1540" y="140" />
        <di:waypoint x="1698" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf8_di" bpmnElement="sf8">
        <di:waypoint x="1698" y="118" />
        <di:waypoint x="1920" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf9_di" bpmnElement="sf9">
        <di:waypoint x="1920" y="140" />
        <di:waypoint x="2085" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_gw2_no_reason_di" bpmnElement="sf_gw2_no_reason">
        <di:waypoint x="2085" y="125" />
        <di:waypoint x="2300" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_gw2_reason_di" bpmnElement="sf_gw2_reason">
        <di:waypoint x="2085" y="125" />
        <di:waypoint x="2268" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf10_di" bpmnElement="sf10">
        <di:waypoint x="2300" y="265" />
        <di:waypoint x="2490" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf11_di" bpmnElement="sf11">
        <di:waypoint x="2490" y="140" />
        <di:waypoint x="2648" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="t3_doa0_di" bpmnElement="t3_doa0">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1148" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="t4_dia0_di" bpmnElement="t4_dia0">
        <di:waypoint x="1148" y="390" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="t5_dia0_di" bpmnElement="t5_dia0">
        <di:waypoint x="1148" y="390" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>