<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="d_regstatement" name="Registration statement" dataObjectRef="d_regstatement_do" />
    <bpmn:dataObject id="d_regstatement_do" />
    <bpmn:dataObjectReference id="d_issueprice" name="Issue price" dataObjectRef="d_issueprice_do" />
    <bpmn:dataObject id="d_issueprice_do" />
    <bpmn:startEvent id="e_start" name="Company decides to go public">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e_end" name="Issue offered to public">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_end_withdraw" name="Underwriting withdrawn">
      <bpmn:incoming>f_g2_yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1" name="Select underwriters">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Provide procedural and financial advice">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Prepare registration statement">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t3_doa0">
        <bpmn:targetRef>d_regstatement</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t4" name="Submit registration statement to SEC for approval">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t4_dia0">
        <bpmn:sourceRef>d_regstatement</bpmn:sourceRef>
        <bpmn:targetRef>t4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t5" name="Check compliance with blue-sky laws of each state">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:property id="t5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t5_dia0">
        <bpmn:sourceRef>d_regstatement</bpmn:sourceRef>
        <bpmn:targetRef>t5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t6" name="Arrange road show to talk to potential investors">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f_g1_no</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="t7" name="Review SEC clearance / registration statement approval">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:property id="t7_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t7_dia0">
        <bpmn:sourceRef>d_regstatement</bpmn:sourceRef>
        <bpmn:targetRef>t7_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="t8" name="Fix issue price">
      <bpmn:incoming>f_g1_yes</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t8_doa0">
        <bpmn:targetRef>d_issueprice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t9" name="Enter into firm commitment to buy the stock">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="Offer stock to the public">
      <bpmn:incoming>f_g2_no</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="SEC clearance received?" isMarkerVisible="true">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f_g1_yes</bpmn:outgoing>
      <bpmn:outgoing>f_g1_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="Reason not to proceed found?" isMarkerVisible="true">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f_g2_no</bpmn:outgoing>
      <bpmn:outgoing>f_g2_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f1" sourceRef="e_start" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f8" sourceRef="t7" targetRef="g1" />
    <bpmn:sequenceFlow id="f_g1_yes" sourceRef="g1" targetRef="t8" name="cleared" />
    <bpmn:sequenceFlow id="f_g1_no" sourceRef="g1" targetRef="t6" name="not cleared" />
    <bpmn:sequenceFlow id="f9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f10" sourceRef="t9" targetRef="g2" />
    <bpmn:sequenceFlow id="f_g2_no" sourceRef="g2" targetRef="t10" name="no reason found" />
    <bpmn:sequenceFlow id="f_g2_yes" sourceRef="g2" targetRef="e_end_withdraw" name="reason found" />
    <bpmn:sequenceFlow id="f11" sourceRef="t10" targetRef="e_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
