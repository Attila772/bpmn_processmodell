<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.com/bpmn/ipo-underwriting"
             id="Definitions_1">

  <collaboration id="Collaboration_1">
    <participant id="Participant_Company" name="Issuing Company" processRef="Process_Company"/>
    <participant id="Participant_Underwriters" name="Underwriters" processRef="Process_Underwriters"/>
    <messageFlow id="MessageFlow_1" sourceRef="Task_SelectUnderwriters" targetRef="StartEvent_Underwriters"/>
    <messageFlow id="MessageFlow_2" sourceRef="Task_FixPrice" targetRef="CatchEvent_SECClearance"/>
  </collaboration>

  <!-- ================= COMPANY PROCESS ================= -->
  <process id="Process_Company" name="Company - Go Public" isExecutable="false">
    <startEvent id="StartEvent_Company" name="Decision to go public is made">
      <outgoing>Flow_C1</outgoing>
    </startEvent>

    <task id="Task_SelectUnderwriters" name="Select underwriters">
      <incoming>Flow_C1</incoming>
      <outgoing>Flow_C2</outgoing>
    </task>

    <endEvent id="EndEvent_Company" name="Underwriters selected">
      <incoming>Flow_C2</incoming>
    </endEvent>

    <sequenceFlow id="Flow_C1" sourceRef="StartEvent_Company" targetRef="Task_SelectUnderwriters"/>
    <sequenceFlow id="Flow_C2" sourceRef="Task_SelectUnderwriters" targetRef="EndEvent_Company"/>
  </process>

  <!-- ================= UNDERWRITERS PROCESS ================= -->
  <process id="Process_Underwriters" name="Underwriters - Handle New Issue" isExecutable="false">

    <startEvent id="StartEvent_Underwriters" name="Receive selection by company">
      <outgoing>Flow_U1</outgoing>
    </startEvent>

    <task id="Task_ProvideAdvice" name="Provide procedural and financial advice">
      <incoming>Flow_U1</incoming>
      <outgoing>Flow_U2</outgoing>
    </task>

    <task id="Task_PrepareRegistration" name="Prepare registration statement">
      <incoming>Flow_U2</incoming>
      <outgoing>Flow_U3</outgoing>
    </task>

    <exclusiveGateway id="Gateway_FactsFair" name="Facts presented fairly?">
      <incoming>Flow_U3</incoming>
      <outgoing>Flow_U4_No</outgoing>
      <outgoing>Flow_U4_Yes</outgoing>
    </exclusiveGateway>

    <endEvent id="EndEvent_Decline" name="Decline to handle issue">
      <incoming>Flow_U4_No</incoming>
    </endEvent>

    <parallelGateway id="Gateway_Split1" name="Split - approval tasks">
      <incoming>Flow_U4_Yes</incoming>
      <outgoing>Flow_U5</outgoing>
      <outgoing>Flow_U6</outgoing>
    </parallelGateway>

    <task id="Task_RegisterSEC" name="Register issue with SEC and check blue-sky law compliance">
      <incoming>Flow_U5</incoming>
      <outgoing>Flow_U7</outgoing>
    </task>

    <task id="Task_RoadShow" name="Arrange road show to firm up issue price">
      <incoming>Flow_U6</incoming>
      <outgoing>Flow_U8</outgoing>
    </task>

    <parallelGateway id="Gateway_Join1" name="Join - await clearance">
      <incoming>Flow_U7</incoming>
      <incoming>Flow_U8</incoming>
      <outgoing>Flow_U9</outgoing>
    </parallelGateway>

    <intermediateCatchEvent id="CatchEvent_SECClearance" name="Receive SEC clearance">
      <incoming>Flow_U9</incoming>
      <outgoing>Flow_U10</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1"/>
    </intermediateCatchEvent>

    <task id="Task_FixPrice" name="Fix issue price">
      <incoming>Flow_U10</incoming>
      <outgoing>Flow_U11</outgoing>
    </task>

    <exclusiveGateway id="Gateway_ReasonNotToProceed" name="Any reason not to proceed?">
      <incoming>Flow_U11</incoming>
      <outgoing>Flow_U12_Yes</outgoing>
      <outgoing>Flow_U12_No</outgoing>
    </exclusiveGateway>

    <endEvent id="EndEvent_Withdrawn" name="Issue withdrawn">
      <incoming>Flow_U12_Yes</incoming>
    </endEvent>

    <task id="Task_FirmCommitment" name="Enter firm commitment to buy the stock">
      <incoming>Flow_U12_No</incoming>
      <outgoing>Flow_U13</outgoing>
    </task>

    <task id="Task_OfferPublic" name="Offer stock to the public">
      <incoming>Flow_U13</incoming>
      <outgoing>Flow_U14</outgoing>
    </task>

    <endEvent id="EndEvent_Completed" name="Issue completed">
      <incoming>Flow_U14</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="Flow_U1" sourceRef="StartEvent_Underwriters" targetRef="Task_ProvideAdvice"/>
    <sequenceFlow id="Flow_U2" sourceRef="Task_ProvideAdvice" targetRef="Task_PrepareRegistration"/>
    <sequenceFlow id="Flow_U3" sourceRef="Task_PrepareRegistration" targetRef="Gateway_FactsFair"/>
    <sequenceFlow id="Flow_U4_No" name="No" sourceRef="Gateway_FactsFair" targetRef="EndEvent_Decline"/>
    <sequenceFlow id="Flow_U4_Yes" name="Yes" sourceRef="Gateway_FactsFair" targetRef="Gateway_Split1"/>
    <sequenceFlow id="Flow_U5" sourceRef="Gateway_Split1" targetRef="Task_RegisterSEC"/>
    <sequenceFlow id="Flow_U6" sourceRef="Gateway_Split1" targetRef="Task_RoadShow"/>
    <sequenceFlow id="Flow_U7" sourceRef="Task_RegisterSEC" targetRef="Gateway_Join1"/>
    <sequenceFlow id="Flow_U8" sourceRef="Task_RoadShow" targetRef="Gateway_Join1"/>
    <sequenceFlow id="Flow_U9" sourceRef="Gateway_Join1" targetRef="CatchEvent_SECClearance"/>
    <sequenceFlow id="Flow_U10" sourceRef="CatchEvent_SECClearance" targetRef="Task_FixPrice"/>
    <sequenceFlow id="Flow_U11" sourceRef="Task_FixPrice" targetRef="Gateway_ReasonNotToProceed"/>
    <sequenceFlow id="Flow_U12_Yes" name="Yes" sourceRef="Gateway_ReasonNotToProceed" targetRef="EndEvent_Withdrawn"/>
    <sequenceFlow id="Flow_U12_No" name="No" sourceRef="Gateway_ReasonNotToProceed" targetRef="Task_FirmCommitment"/>
    <sequenceFlow id="Flow_U13" sourceRef="Task_FirmCommitment" targetRef="Task_OfferPublic"/>
    <sequenceFlow id="Flow_U14" sourceRef="Task_OfferPublic" targetRef="EndEvent_Completed"/>

  </process>

  <!-- ================= DIAGRAM ================= -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Shape_Participant_Company" bpmnElement="Participant_Company" isHorizontal="true">
        <omgdc:Bounds x="50" y="40" width="900" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_Company" bpmnElement="StartEvent_Company">
        <omgdc:Bounds x="90" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_SelectUnderwriters" bpmnElement="Task_SelectUnderwriters">
        <omgdc:Bounds x="180" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Company" bpmnElement="EndEvent_Company">
        <omgdc:Bounds x="350" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_Underwriters" bpmnElement="Participant_Underwriters" isHorizontal="true">
        <omgdc:Bounds x="50" y="230" width="1500" height="400"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_Underwriters" bpmnElement="StartEvent_Underwriters">
        <omgdc:Bounds x="90" y="400" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ProvideAdvice" bpmnElement="Task_ProvideAdvice">
        <omgdc:Bounds x="170" y="380" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_PrepareRegistration" bpmnElement="Task_PrepareRegistration">
        <omgdc:Bounds x="330" y="380" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_FactsFair" bpmnElement="Gateway_FactsFair" isMarkerVisible="true">
        <omgdc:Bounds x="490" y="395" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Decline" bpmnElement="EndEvent_Decline">
        <omgdc:Bounds x="500" y="500" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_Split1" bpmnElement="Gateway_Split1">
        <omgdc:Bounds x="580" y="395" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_RegisterSEC" bpmnElement="Task_RegisterSEC">
        <omgdc:Bounds x="670" y="320" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_RoadShow" bpmnElement="Task_RoadShow">
        <omgdc:Bounds x="670" y="440" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_Join1" bpmnElement="Gateway_Join1">
        <omgdc:Bounds x="850" y="395" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_CatchEvent_SECClearance" bpmnElement="CatchEvent_SECClearance">
        <omgdc:Bounds x="940" y="402" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_FixPrice" bpmnElement="Task_FixPrice">
        <omgdc:Bounds x="1010" y="380" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ReasonNotToProceed" bpmnElement="Gateway_ReasonNotToProceed" isMarkerVisible="true">
        <omgdc:Bounds x="1170" y="395" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Withdrawn" bpmnElement="EndEvent_Withdrawn">
        <omgdc:Bounds x="1180" y="500" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_FirmCommitment" bpmnElement="Task_FirmCommitment">
        <omgdc:Bounds x="1260" y="380" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_OfferPublic" bpmnElement="Task_OfferPublic">
        <omgdc:Bounds x="1430" y="380" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Completed" bpmnElement="EndEvent_Completed">
        <omgdc:Bounds x="1580" y="402" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Edge_Flow_C1" bpmnElement="Flow_C1">
        <omgdi:waypoint x="126" y="118"/>
        <omgdi:waypoint x="180" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_C2" bpmnElement="Flow_C2">
        <omgdi:waypoint x="300" y="120"/>
        <omgdi:waypoint x="350" y="118"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MessageFlow_1" bpmnElement="MessageFlow_1">
        <omgdi:waypoint x="240" y="160"/>
        <omgdi:waypoint x="108" y="400"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_U1" bpmnElement="Flow_U1">
        <omgdi:waypoint x="126" y="418"/>
        <omgdi:waypoint x="170" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U2" bpmnElement="Flow_U2">
        <omgdi:waypoint x="290" y="420"/>
        <omgdi:waypoint x="330" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U3" bpmnElement="Flow_U3">
        <omgdi:waypoint x="450" y="420"/>
        <omgdi:waypoint x="490" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U4_No" bpmnElement="Flow_U4_No">
        <omgdi:waypoint x="515" y="445"/>
        <omgdi:waypoint x="518" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U4_Yes" bpmnElement="Flow_U4_Yes">
        <omgdi:waypoint x="540" y="420"/>
        <omgdi:waypoint x="580" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U5" bpmnElement="Flow_U5">
        <omgdi:waypoint x="605" y="400"/>
        <omgdi:waypoint x="670" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U6" bpmnElement="Flow_U6">
        <omgdi:waypoint x="605" y="440"/>
        <omgdi:waypoint x="670" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U7" bpmnElement="Flow_U7">
        <omgdi:waypoint x="810" y="360"/>
        <omgdi:waypoint x="875" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U8" bpmnElement="Flow_U8">
        <omgdi:waypoint x="810" y="480"/>
        <omgdi:waypoint x="875" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U9" bpmnElement="Flow_U9">
        <omgdi:waypoint x="900" y="420"/>
        <omgdi:waypoint x="940" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U10" bpmnElement="Flow_U10">
        <omgdi:waypoint x="976" y="420"/>
        <omgdi:waypoint x="1010" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MessageFlow_2" bpmnElement="MessageFlow_2">
        <omgdi:waypoint x="1070" y="380"/>
        <omgdi:waypoint x="958" y="402"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U11" bpmnElement="Flow_U11">
        <omgdi:waypoint x="1130" y="420"/>
        <omgdi:waypoint x="1170" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U12_Yes" bpmnElement="Flow_U12_Yes">
        <omgdi:waypoint x="1195" y="445"/>
        <omgdi:waypoint x="1198" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U12_No" bpmnElement="Flow_U12_No">
        <omgdi:waypoint x="1220" y="420"/>
        <omgdi:waypoint x="1260" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U13" bpmnElement="Flow_U13">
        <omgdi:waypoint x="1400" y="420"/>
        <omgdi:waypoint x="1430" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U14" bpmnElement="Flow_U14">
        <omgdi:waypoint x="1550" y="420"/>
        <omgdi:waypoint x="1580" y="420"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
