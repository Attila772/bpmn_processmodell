<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://example.com/bpmn/crs">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Computer Repair Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" name="Computer Repair Process" isExecutable="false">

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRS" name="CRS">
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Customer brings defective computer">
      <bpmn:outgoing>SF1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_1" name="Check defect">
      <bpmn:incoming>SF1</bpmn:incoming>
      <bpmn:outgoing>SF2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_2" name="Calculate repair cost">
      <bpmn:incoming>SF2</bpmn:incoming>
      <bpmn:outgoing>SF3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_1" name="Costs acceptable?">
      <bpmn:incoming>SF3</bpmn:incoming>
      <bpmn:outgoing>SF4</bpmn:outgoing>
      <bpmn:outgoing>SF6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_4" name="Take computer home unrepaired">
      <bpmn:incoming>SF4</bpmn:incoming>
      <bpmn:outgoing>SF5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Process ended - unrepaired">
      <bpmn:incoming>SF5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="Gateway_2" name="Start repair">
      <bpmn:incoming>SF6</bpmn:incoming>
      <bpmn:incoming>SF13</bpmn:incoming>
      <bpmn:outgoing>SF7</bpmn:outgoing>
      <bpmn:outgoing>SF8</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_5" name="Check and repair hardware">
      <bpmn:incoming>SF7</bpmn:incoming>
      <bpmn:outgoing>SF9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_6" name="Check and configure software">
      <bpmn:incoming>SF8</bpmn:incoming>
      <bpmn:outgoing>SF10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_3" name="Repair activities joined">
      <bpmn:incoming>SF9</bpmn:incoming>
      <bpmn:incoming>SF10</bpmn:incoming>
      <bpmn:outgoing>SF11</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_7" name="Test system functionality">
      <bpmn:incoming>SF11</bpmn:incoming>
      <bpmn:outgoing>SF12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_4" name="Error detected?">
      <bpmn:incoming>SF12</bpmn:incoming>
      <bpmn:outgoing>SF13</bpmn:outgoing>
      <bpmn:outgoing>SF14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_8" name="Customer picks up repaired computer">
      <bpmn:incoming>SF14</bpmn:incoming>
      <bpmn:outgoing>SF15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_2" name="Process ended - repaired">
      <bpmn:incoming>SF15</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SF2" sourceRef="Task_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SF3" sourceRef="Task_2" targetRef="Gateway_1"/>
    <bpmn:sequenceFlow id="SF4" name="No" sourceRef="Gateway_1" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SF5" sourceRef="Task_4" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SF6" name="Yes" sourceRef="Gateway_1" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="SF7" sourceRef="Gateway_2" targetRef="Task_5"/>
    <bpmn:sequenceFlow id="SF8" sourceRef="Gateway_2" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="SF9" sourceRef="Task_5" targetRef="Gateway_3"/>
    <bpmn:sequenceFlow id="SF10" sourceRef="Task_6" targetRef="Gateway_3"/>
    <bpmn:sequenceFlow id="SF11" sourceRef="Gateway_3" targetRef="Task_7"/>
    <bpmn:sequenceFlow id="SF12" sourceRef="Task_7" targetRef="Gateway_4"/>
    <bpmn:sequenceFlow id="SF13" name="Yes - repair again" sourceRef="Gateway_4" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="SF14" name="No - finished" sourceRef="Gateway_4" targetRef="Task_8"/>
    <bpmn:sequenceFlow id="SF15" sourceRef="Task_8" targetRef="EndEvent_2"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1360" height="420"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1330" height="210"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_CRS_di" bpmnElement="Lane_CRS" isHorizontal="true">
        <dc:Bounds x="70" y="250" width="1330" height="210"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="120" y="127" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="220" y="315" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="360" y="315" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="520" y="120" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="620" y="105" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="770" y="127" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_2_di" bpmnElement="Gateway_2">
        <dc:Bounds x="620" y="330" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="720" y="270" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <dc:Bounds x="720" y="400" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_3_di" bpmnElement="Gateway_3">
        <dc:Bounds x="870" y="330" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7">
        <dc:Bounds x="960" y="315" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_4_di" bpmnElement="Gateway_4" isMarkerVisible="true">
        <dc:Bounds x="1110" y="330" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_8_di" bpmnElement="Task_8">
        <dc:Bounds x="1190" y="105" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <dc:Bounds x="1340" y="127" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="SF1_di" bpmnElement="SF1">
        <di:waypoint x="156" y="145"/>
        <di:waypoint x="270" y="145"/>
        <di:waypoint x="270" y="315"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF2_di" bpmnElement="SF2">
        <di:waypoint x="320" y="355"/>
        <di:waypoint x="360" y="355"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF3_di" bpmnElement="SF3">
        <di:waypoint x="460" y="355"/>
        <di:waypoint x="545" y="355"/>
        <di:waypoint x="545" y="170"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF4_di" bpmnElement="SF4">
        <di:waypoint x="570" y="145"/>
