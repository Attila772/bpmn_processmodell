        <di:waypoint x="645" y="250"/>
        <di:waypoint x="645" y="330"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF14_di" bpmnElement="SF14">
        <di:waypoint x="1135" y="330"/>
