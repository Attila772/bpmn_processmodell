      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF9_di" bpmnElement="SF9">
        <di:waypoint x="820" y="310"/>
        <di:waypoint x="895" y="340"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF10_di" bpmnElement="SF10">
        <di:waypoint x="820" y="440"/>
        <di:waypoint x="895" y="370"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF11_di" bpmnElement="SF11">
        <di:waypoint x="920" y="355"/>
        <di:waypoint x="960" y="355"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF12_di" bpmnElement="SF12">
        <di:waypoint x="1060" y="355"/>
