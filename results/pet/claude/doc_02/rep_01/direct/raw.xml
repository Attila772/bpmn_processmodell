        <di:waypoint x="545" y="170"/>
        <di:waypoint x="545" y="355"/>
        <di:waypoint x="620" y="355"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF7_di" bpmnElement="SF7">
        <di:waypoint x="670" y="340"/>
        <di:waypoint x="720" y="310"/>
      </bpmndi:BPMNEdge>

