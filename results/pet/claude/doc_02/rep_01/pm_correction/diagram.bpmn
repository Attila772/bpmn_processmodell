        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="178" y="828" />
        <di:waypoint x="375" y="835" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_accept_yes_di" bpmnElement="flow_accept_yes">
        <di:waypoint x="375" y="835" />
        <di:waypoint x="565" y="835" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_reject_di" bpmnElement="f_reject">
        <di:waypoint x="375" y="835" />
        <di:waypoint x="558" y="1078" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_reject2_di" bpmnElement="f_reject2">
        <di:waypoint x="178" y="368" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="565" y="835" />
