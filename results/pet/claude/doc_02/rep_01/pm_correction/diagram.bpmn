        <di:waypoint x="1135" y="835" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13">
        <di:waypoint x="1135" y="835" />
        <di:waypoint x="1705" y="835" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_error_yes_di" bpmnElement="flow_error_yes">
        <di:waypoint x="1705" y="835" />
        <di:waypoint x="1540" y="975" />
      </bpmndi:BPMNEdge>
