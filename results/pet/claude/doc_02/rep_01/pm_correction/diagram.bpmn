      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_defect_doa0_di" bpmnElement="task_check_defect_doa0">
        <di:waypoint x="400" y="975" />
        <di:waypoint x="388" y="1225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_decide_dia0_di" bpmnElement="task_decide_dia0">
        <di:waypoint x="388" y="640" />
        <di:waypoint x="400" y="390" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>