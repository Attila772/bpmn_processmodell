<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do_contact_details" name="Kontaktdaten" dataObjectRef="do_contact_details_do" />
    <bpmn:dataObject id="do_contact_details_do" />
    <bpmn:dataObjectReference id="do_customer_info" name="Kundeninformationen (Ansprechpartner, Budget)" dataObjectRef="do_customer_info_do" />
    <bpmn:dataObject id="do_customer_info_do" />
    <bpmn:dataObjectReference id="do_quotation" name="Angebot" dataObjectRef="do_quotation_do" />
    <bpmn:dataObject id="do_quotation_do" />
    <bpmn:startEvent id="ev_start" name="Kontaktdaten-Quelle verfügbar">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="ev_timer_wait" name="2 Wochen keine Rückmeldung">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ev_timer_wait_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ev_end_nointerest" name="Kunde nicht interessiert">
      <bpmn:incoming>sf_budget_no</bpmn:incoming>
      <bpmn:incoming>sf_acquire_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_end_quote" name="Angebot erstellt">
      <bpmn:incoming>sf13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_buy_data" name="Kontaktdaten für Kaltakquise kaufen">
      <bpmn:incoming>sf_src_buy</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t_buy_data_doa0">
        <bpmn:targetRef>do_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="t_exhibition" name="Kontakte auf Messe sammeln">
      <bpmn:incoming>sf_src_exhibition</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t_exhibition_doa0">
        <bpmn:targetRef>do_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_personal_contact" name="Persönlichen Kontakt notieren">
      <bpmn:incoming>sf_src_personal</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t_personal_contact_doa0">
        <bpmn:targetRef>do_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="t_call_customer" name="Kunden anrufen und Ansprechpartner/Budget ermitteln">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="t_call_customer_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t_call_customer_dia0">
        <bpmn:sourceRef>do_contact_details</bpmn:sourceRef>
        <bpmn:targetRef>t_call_customer_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t_call_customer_doa0">
        <bpmn:targetRef>do_customer_info</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t_personal_acquisition" name="Kunden persönlich akquirieren">
      <bpmn:incoming>sf_budget_yes</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:property id="t_personal_acquisition_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t_personal_acquisition_dia0">
        <bpmn:sourceRef>do_customer_info</bpmn:sourceRef>
        <bpmn:targetRef>t_personal_acquisition_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_presentation_sales" name="Online-Präsentation durch Vertriebsmitarbeiter">
      <bpmn:incoming>sf_pres_sales</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:property id="t_presentation_sales_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t_presentation_sales_dia0">
        <bpmn:sourceRef>do_customer_info</bpmn:sourceRef>
        <bpmn:targetRef>t_presentation_sales_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_presentation_presales" name="Technische Online-Präsentation durch Pre-Sales">
      <bpmn:incoming>sf_pres_presales</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="t_presentation_presales_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t_presentation_presales_dia0">
        <bpmn:sourceRef>do_customer_info</bpmn:sourceRef>
        <bpmn:targetRef>t_presentation_presales_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_followup_call" name="Kunden erneut anrufen">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_create_quote" name="Angebot erstellen">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:property id="t_create_quote_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t_create_quote_dia0">
        <bpmn:sourceRef>do_customer_info</bpmn:sourceRef>
        <bpmn:targetRef>t_create_quote_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t_create_quote_doa0">
        <bpmn:targetRef>do_quotation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_source" name="Kontaktquelle" isMarkerVisible="true">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf_src_buy</bpmn:outgoing>
      <bpmn:outgoing>sf_src_exhibition</bpmn:outgoing>
      <bpmn:outgoing>sf_src_personal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_merge_source" name="Kontakt vorhanden" isMarkerVisible="true">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_interested" name="Allgemein interessiert?" isMarkerVisible="true">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf_int_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_int_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_budget" name="Budget hoch?" isMarkerVisible="true">
      <bpmn:incoming>sf_int_no</bpmn:incoming>
      <bpmn:outgoing>sf_budget_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_budget_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_merge_acquire" name="Interesse nach Akquise?" isMarkerVisible="true">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf_acquire_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_acquire_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_presentation_type" name="Präsentationsart" isMarkerVisible="true">
      <bpmn:incoming>sf_int_yes</bpmn:incoming>
      <bpmn:incoming>sf_acquire_yes</bpmn:incoming>
      <bpmn:outgoing>sf_pres_sales</bpmn:outgoing>
      <bpmn:outgoing>sf_pres_presales</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_merge_presentation" name="Präsentation gegeben" isMarkerVisible="true">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf1" sourceRef="ev_start" targetRef="gw_source" />
    <bpmn:sequenceFlow id="sf_src_buy" sourceRef="gw_source" targetRef="t_buy_data" name="Daten gekauft" />
    <bpmn:sequenceFlow id="sf_src_exhibition" sourceRef="gw_source" targetRef="t_exhibition" name="Messe-Kontakt" />
    <bpmn:sequenceFlow id="sf_src_personal" sourceRef="gw_source" targetRef="t_personal_contact" name="persönlich bekannt" />
    <bpmn:sequenceFlow id="sf2" sourceRef="t_buy_data" targetRef="gw_merge_source" />
    <bpmn:sequenceFlow id="sf3" sourceRef="t_exhibition" targetRef="gw_merge_source" />
    <bpmn:sequenceFlow id="sf4" sourceRef="t_personal_contact" targetRef="gw_merge_source" />
    <bpmn:sequenceFlow id="sf5" sourceRef="gw_merge_source" targetRef="t_call_customer" />
    <bpmn:sequenceFlow id="sf6" sourceRef="t_call_customer" targetRef="gw_interested" />
    <bpmn:sequenceFlow id="sf_int_yes" sourceRef="gw_interested" targetRef="gw_presentation_type" name="ja" />
    <bpmn:sequenceFlow id="sf_int_no" sourceRef="gw_interested" targetRef="gw_budget" name="nein" />
    <bpmn:sequenceFlow id="sf_budget_yes" sourceRef="gw_budget" targetRef="t_personal_acquisition" name="großes Budget" />
    <bpmn:sequenceFlow id="sf_budget_no" sourceRef="gw_budget" targetRef="ev_end_nointerest" name="kein großes Budget" />
    <bpmn:sequenceFlow id="sf7" sourceRef="t_personal_acquisition" targetRef="gw_merge_acquire" />
    <bpmn:sequenceFlow id="sf_acquire_yes" sourceRef="gw_merge_acquire" targetRef="gw_presentation_type" name="ja" />
    <bpmn:sequenceFlow id="sf_acquire_no" sourceRef="gw_merge_acquire" targetRef="ev_end_nointerest" name="nein" />
    <bpmn:sequenceFlow id="sf_pres_sales" sourceRef="gw_presentation_type" targetRef="t_presentation_sales" name="Standard-Präsentation" />
    <bpmn:sequenceFlow id="sf_pres_presales" sourceRef="gw_presentation_type" targetRef="t_presentation_presales" name="technische Präsentation" />
    <bpmn:sequenceFlow id="sf8" sourceRef="t_presentation_sales" targetRef="gw_merge_presentation" />
    <bpmn:sequenceFlow id="sf9" sourceRef="t_presentation_presales" targetRef="gw_merge_presentation" />
    <bpmn:sequenceFlow id="sf10" sourceRef="gw_merge_presentation" targetRef="ev_timer_wait" />
    <bpmn:sequenceFlow id="sf11" sourceRef="ev_timer_wait" targetRef="t_followup_call" />
    <bpmn:sequenceFlow id="sf12" sourceRef="t_followup_call" targetRef="t_create_quote" />
    <bpmn:sequenceFlow id="sf13" sourceRef="t_create_quote" targetRef="ev_end_quote" />
  </bpmn:process>
