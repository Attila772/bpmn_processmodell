  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do1" name="Kontaktdaten" dataObjectRef="do1_do" />
    <bpmn:dataObject id="do1_do" />
    <bpmn:dataObjectReference id="do2" name="Angebot" dataObjectRef="do2_do" />
    <bpmn:dataObject id="do2_do" />
    <bpmn:startEvent id="e1" name="Prozess gestartet">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Kunde nicht interessiert - Prozessende">
      <bpmn:incoming>sf_g4_no</bpmn:incoming>
      <bpmn:incoming>sf_g5_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Angebot erstellt">
      <bpmn:incoming>sf16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="e4" name="2 Wochen keine Rückmeldung">
      <bpmn:timerEventDefinition id="e4_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="t1" name="Kontaktdaten durch Kauf beschaffen">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="t2" name="Kontaktdaten auf Messe sammeln">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t2_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="t3" name="Persönlicher Kontakt zu interessiertem Kunden">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t3_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t4" name="Kunden anrufen und Ansprechpartner sowie Budget ermitteln">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t4_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t5" name="Kunde persönlich akquirieren">
      <bpmn:incoming>sf_g4_yes</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Online-Präsentation durch Vertriebsmitarbeiter">
      <bpmn:incoming>sf_g6_sales</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Technische Online-Präsentation durch Pre-Sales">
      <bpmn:incoming>sf_g6_presales</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Kunde anrufen nach 2 Wochen ohne Rückmeldung">
      <bpmn:incoming>sf_g8_no</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Angebot erstellen">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t9_doa0">
        <bpmn:targetRef>do2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Kontaktquelle" isMarkerVisible="true">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:outgoing>sf4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="Zusammenführung Kontaktdaten" isMarkerVisible="true">
