      <bpmn:incoming>sf_g5_yes</bpmn:incoming>
      <bpmn:outgoing>sf_g6_sales</bpmn:outgoing>
      <bpmn:outgoing>sf_g6_presales</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g7" name="Zusammenführung Präsentation" isMarkerVisible="true">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g8" name="Kunde meldet sich zurück?" isMarkerVisible="true">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:outgoing>sf_g8_no</bpmn:outgoing>
      <bpmn:outgoing>sf_g8_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g9" name="Zusammenführung vor Angebot" isMarkerVisible="true">
