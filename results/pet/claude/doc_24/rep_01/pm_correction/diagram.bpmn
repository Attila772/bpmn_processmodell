<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_customer_part" name="Customer" processRef="pool_customer_proc" />
    <bpmn:participant id="pool_customer_service_part" name="Customer Service (Sales &amp; Distribution Shared Service Center)" processRef="pool_customer_service_proc" />
    <bpmn:participant id="pool_grid_operator_part" name="Grid Operator" processRef="pool_grid_operator_proc" />
    <bpmn:participant id="pool_old_supplier_part" name="Old Supplier" processRef="pool_old_supplier_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="event_send_data" targetRef="event_receive_customer_data" name="Customer Data" />
    <bpmn:messageFlow id="mf2" sourceRef="task_send_confirmation" targetRef="event_receive_confirmation" name="Confirmation Document" />
    <bpmn:messageFlow id="mf3" sourceRef="event_send_request_grid_operator" targetRef="event_receive_switch_request_go" name="Switch Request" />
    <bpmn:messageFlow id="mf4" sourceRef="event_send_response_cs" targetRef="event_receive_grid_response" name="Concurrence Response" />
    <bpmn:messageFlow id="mf5" sourceRef="event_send_meter_data_report" targetRef="event_receive_meter_data_old_supplier" name="Consumption Report" />
    <bpmn:messageFlow id="mf6" sourceRef="event_send_meter_data_report" targetRef="event_receive_report_customer" name="Consumption Report" />
    <bpmn:messageFlow id="mf7" sourceRef="event_send_meter_data_report" targetRef="event_receive_meter_data" name="Consumption Report" />
    <bpmn:messageFlow id="mf8" sourceRef="event_send_final_billing_old_supplier" targetRef="event_receive_final_billing_go" name="Final Billing (Grid)" />
    <bpmn:messageFlow id="mf9" sourceRef="event_send_final_billing_customer" targetRef="event_receive_final_billing_customer" name="Final Billing (Customer)" />
    <bpmn:messageFlow id="mf10" sourceRef="task_terminate_old_agreement" targetRef="event_receive_termination" name="Termination Request" />
    <bpmn:messageFlow id="mf11" sourceRef="task_create_cis_contract" targetRef="event_receive_confirmation" name="Confirmation Document" />
  </bpmn:collaboration>
  <bpmn:process id="pool_customer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_cis_contract_p1" name="CIS Contract" dataObjectRef="data_cis_contract_p1_do" />
    <bpmn:dataObject id="data_cis_contract_p1_do" />
    <bpmn:startEvent id="start_request" name="Switch-over request initiated">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_send_data" name="Customer transmits data">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_data_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="event_receive_confirmation" name="Confirmation document received">
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_confirmation_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="event_receive_report_customer" name="Consumption report received">
      <bpmn:outgoing>f33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_report_customer_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="event_receive_final_billing_customer" name="Final billing received">
      <bpmn:messageEventDefinition id="event_receive_final_billing_customer_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_withdraw" name="Process ends - customer withdrew">
      <bpmn:incoming>flow_withdraw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_customer_process" name="Customer process ends">
      <bpmn:incoming>f33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_contract" name="Check contract details and decide to withdraw or confirm">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:property id="task_check_contract_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_contract_dia0">
        <bpmn:sourceRef>data_cis_contract_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_contract_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_accept_reject" name="Customer accepts or withdraws?" isMarkerVisible="true">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>flow_withdraw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f1" sourceRef="start_request" targetRef="event_send_data" />
    <bpmn:sequenceFlow id="f20" sourceRef="event_receive_confirmation" targetRef="task_check_contract" />
    <bpmn:sequenceFlow id="f21" sourceRef="task_check_contract" targetRef="gw_accept_reject" />
    <bpmn:sequenceFlow id="flow_withdraw" sourceRef="gw_accept_reject" targetRef="end_withdraw" name="Widerruf" />
    <bpmn:sequenceFlow id="f33" sourceRef="event_receive_report_customer" targetRef="end_customer_process" />
  </bpmn:process>
  <bpmn:process id="pool_customer_service_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_customer_data" name="Customer Data" dataObjectRef="data_customer_data_do" />
    <bpmn:dataObject id="data_customer_data_do" />
    <bpmn:dataObjectReference id="data_customer_object" name="Customer Object" dataObjectRef="data_customer_object_do" />
    <bpmn:dataObject id="data_customer_object_do" />
    <bpmn:dataObjectReference id="data_error_list" name="Error List" dataObjectRef="data_error_list_do" />
    <bpmn:dataObject id="data_error_list_do" />
    <bpmn:dataObjectReference id="data_contract_documents" name="Contract Documents" dataObjectRef="data_contract_documents_do" />
    <bpmn:dataObject id="data_contract_documents_do" />
    <bpmn:dataObjectReference id="data_confirmation_document" name="Confirmation Document" dataObjectRef="data_confirmation_document_do" />
    <bpmn:dataObject id="data_confirmation_document_do" />
    <bpmn:dataObjectReference id="data_cis_contract" name="CIS Contract" dataObjectRef="data_cis_contract_do" />
    <bpmn:dataObject id="data_cis_contract_do" />
    <bpmn:dataObjectReference id="data_consumption_report_p1" name="Consumption Report" dataObjectRef="data_consumption_report_p1_do" />
    <bpmn:dataObject id="data_consumption_report_p1_do" />
    <bpmn:startEvent id="event_receive_customer_data" name="Customer data received">
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_customer_data_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="event_send_confirmation_cs" name="Confirmation document sent">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="event_send_request_grid_operator" name="Request sent to grid operator">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_request_grid_operator_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="event_receive_grid_response" name="Response received from grid operator">
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_grid_response_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="event_receive_meter_data" name="Meter data received by customer service">
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_meter_data_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_cs_process" name="Customer service process ends">
      <bpmn:incoming>flow_concurrence_yes</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_enter_crm" name="Enter customer data object into CRM">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:property id="task_enter_crm_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_enter_crm_dia0">
        <bpmn:sourceRef>data_customer_data</bpmn:sourceRef>
        <bpmn:targetRef>task_enter_crm_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_enter_crm_doa0">
        <bpmn:targetRef>data_customer_object</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_compare_data" name="Compare data with internal customer database and check completeness/plausibility">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="task_compare_data_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_compare_data_dia0">
        <bpmn:sourceRef>data_customer_object</bpmn:sourceRef>
        <bpmn:targetRef>task_compare_data_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_correct_errors" name="Correct errors based on error list">
      <bpmn:incoming>flow_error_yes</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:property id="task_correct_errors_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_correct_errors_dia0">
        <bpmn:sourceRef>data_error_list</bpmn:sourceRef>
        <bpmn:targetRef>task_correct_errors_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_customer_object" name="Create new customer object (name, address, power gauge)">
      <bpmn:incoming>flow_exists_no</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_customer_object_doa0">
        <bpmn:targetRef>data_customer_object</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_prepare_contract_docs" name="Prepare contract documents for power supplier switch">
      <bpmn:incoming>flow_exists_yes</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:property id="task_prepare_contract_docs_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prepare_contract_docs_dia0">
        <bpmn:sourceRef>data_customer_object</bpmn:sourceRef>
        <bpmn:targetRef>task_prepare_contract_docs_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_prepare_contract_docs_doa0">
        <bpmn:targetRef>data_contract_documents</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_check_contract_docs_cis" name="Automated check of contract documents in CIS">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:property id="task_check_contract_docs_cis_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_contract_docs_cis_dia0">
        <bpmn:sourceRef>data_contract_documents</bpmn:sourceRef>
        <bpmn:targetRef>task_check_contract_docs_cis_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_analyze_resolve_issues" name="Analyze and resolve causing issues">
      <bpmn:incoming>flow_check_negative</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_send_confirmation" name="Send confirmation document to customer">
      <bpmn:incoming>flow_check_positive</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:property id="task_send_confirmation_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_confirmation_dia0">
        <bpmn:sourceRef>data_contract_documents</bpmn:sourceRef>
        <bpmn:targetRef>task_send_confirmation_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_send_confirmation_doa0">
        <bpmn:targetRef>data_confirmation_document</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_create_cis_contract" name="Create CIS contract">
      <bpmn:incoming>flow_concurrence_no</bpmn:incoming>
      <bpmn:dataOutputAssociation id="task_create_cis_contract_doa0">
        <bpmn:targetRef>data_cis_contract</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_import_meter_data" name="Import meter data to systems requiring the information">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:property id="task_import_meter_data_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_import_meter_data_dia0">
        <bpmn:sourceRef>data_consumption_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_import_meter_data_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_error_check" name="Errors found?" isMarkerVisible="true">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>flow_error_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_error_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_exists_check" name="Customer exists in database?" isMarkerVisible="true">
      <bpmn:incoming>flow_error_no</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>flow_exists_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_exists_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_check_result" name="Contract documents generated successfully?" isMarkerVisible="true">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>flow_check_negative</bpmn:outgoing>
      <bpmn:outgoing>flow_check_positive</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_concurrence" name="Supplier concurrence?" isMarkerVisible="true">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>flow_concurrence_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_concurrence_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f2" sourceRef="event_receive_customer_data" targetRef="task_enter_crm" />
    <bpmn:sequenceFlow id="f3" sourceRef="task_enter_crm" targetRef="task_compare_data" />
    <bpmn:sequenceFlow id="f4" sourceRef="task_compare_data" targetRef="gw_error_check" />
    <bpmn:sequenceFlow id="flow_error_yes" sourceRef="gw_error_check" targetRef="task_correct_errors" name="Fehler vorhanden" />
    <bpmn:sequenceFlow id="flow_error_no" sourceRef="gw_error_check" targetRef="gw_exists_check" name="keine Fehler" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_correct_errors" targetRef="gw_exists_check" />
    <bpmn:sequenceFlow id="flow_exists_yes" sourceRef="gw_exists_check" targetRef="task_prepare_contract_docs" name="existiert bereits" />
    <bpmn:sequenceFlow id="flow_exists_no" sourceRef="gw_exists_check" targetRef="task_create_customer_object" name="existiert nicht" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_create_customer_object" targetRef="task_prepare_contract_docs" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_prepare_contract_docs" targetRef="task_check_contract_docs_cis" />
    <bpmn:sequenceFlow id="f8" sourceRef="task_check_contract_docs_cis" targetRef="gw_check_result" />
    <bpmn:sequenceFlow id="flow_check_negative" sourceRef="gw_check_result" targetRef="task_analyze_resolve_issues" name="negativ" />
    <bpmn:sequenceFlow id="flow_check_positive" sourceRef="gw_check_result" targetRef="task_send_confirmation" name="positiv" />
    <bpmn:sequenceFlow id="f9" sourceRef="task_analyze_resolve_issues" targetRef="task_prepare_contract_docs" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_send_confirmation" targetRef="event_send_confirmation_cs" />
    <bpmn:sequenceFlow id="f11" sourceRef="event_send_confirmation_cs" targetRef="event_send_request_grid_operator" />
    <bpmn:sequenceFlow id="f18" sourceRef="event_receive_grid_response" targetRef="gw_concurrence" />
    <bpmn:sequenceFlow id="flow_concurrence_yes" sourceRef="gw_concurrence" targetRef="end_cs_process" name="Lieferantenkonkurrenz" />
    <bpmn:sequenceFlow id="flow_concurrence_no" sourceRef="gw_concurrence" targetRef="task_create_cis_contract" name="keine Lieferantenkonkurrenz" />
    <bpmn:sequenceFlow id="f22" sourceRef="event_receive_meter_data" targetRef="task_import_meter_data" />
    <bpmn:sequenceFlow id="f23" sourceRef="task_import_meter_data" targetRef="end_cs_process" />
  </bpmn:process>
  <bpmn:process id="pool_grid_operator_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_consumption_report" name="Consumption Report" dataObjectRef="data_consumption_report_do" />
    <bpmn:dataObject id="data_consumption_report_do" />
    <bpmn:dataObjectReference id="data_final_billing_go" name="Final Billing (Grid Operator)" dataObjectRef="data_final_billing_go_do" />
    <bpmn:dataObject id="data_final_billing_go_do" />
    <bpmn:startEvent id="event_receive_switch_request_go" name="Switch request received">
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_switch_request_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="event_send_response_cs" name="Response sent to customer service">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
      <bpmn:outgoing>f35</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_send_response_cs_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="event_send_meter_data_report" name="Meter data report sent">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_meter_data_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="event_send_final_billing_old_supplier" name="Final billing sent to old supplier">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_final_billing_old_supplier_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go_process" name="Grid operator process ends">
      <bpmn:incoming>f35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_supplier_concurrence" name="Check switch-over request for supplier concurrence">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_suppliers_demand_resolution" name="Inform all involved suppliers and demand resolution of conflict">
      <bpmn:incoming>flow_go_concurrence_yes</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_terminate_old_agreement" name="Terminate sales agreement between customer and old supplier">
      <bpmn:incoming>flow_go_concurrence_no</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_compute_final_billing" name="Compute final billing based on meter data">
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f29</bpmn:outgoing>
      <bpmn:property id="task_compute_final_billing_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_compute_final_billing_dia0">
        <bpmn:sourceRef>data_consumption_report</bpmn:sourceRef>
        <bpmn:targetRef>task_compute_final_billing_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_compute_final_billing_doa0">
        <bpmn:targetRef>data_final_billing_go</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_concurrence_go" name="Supplier concurrence? (Grid Operator)" isMarkerVisible="true">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>flow_go_concurrence_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_go_concurrence_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f12" sourceRef="event_receive_switch_request_go" targetRef="task_check_supplier_concurrence" />
    <bpmn:sequenceFlow id="f13" sourceRef="task_check_supplier_concurrence" targetRef="gw_concurrence_go" />
    <bpmn:sequenceFlow id="flow_go_concurrence_yes" sourceRef="gw_concurrence_go" targetRef="task_inform_suppliers_demand_resolution" name="Lieferantenkonkurrenz" />
    <bpmn:sequenceFlow id="flow_go_concurrence_no" sourceRef="gw_concurrence_go" targetRef="task_terminate_old_agreement" name="keine Lieferantenkonkurrenz" />
    <bpmn:sequenceFlow id="f14" sourceRef="task_inform_suppliers_demand_resolution" targetRef="event_send_response_cs" />
    <bpmn:sequenceFlow id="f17" sourceRef="task_terminate_old_agreement" targetRef="event_send_response_cs" />
    <bpmn:sequenceFlow id="f24" sourceRef="task_compute_final_billing" targetRef="event_send_final_billing_old_supplier" />
    <bpmn:sequenceFlow id="f29" sourceRef="task_compute_final_billing" targetRef="event_send_meter_data_report" />
    <bpmn:sequenceFlow id="f34" sourceRef="event_send_response_cs" targetRef="task_compute_final_billing" />
    <bpmn:sequenceFlow id="f35" sourceRef="event_send_response_cs" targetRef="end_go_process" />
  </bpmn:process>
  <bpmn:process id="pool_old_supplier_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_final_billing_customer" name="Final Billing (Customer)" dataObjectRef="data_final_billing_customer_do" />
    <bpmn:dataObject id="data_final_billing_customer_do" />
    <bpmn:startEvent id="event_receive_termination" name="Termination request received">
      <bpmn:outgoing>f16</bpmn:outgoing>
