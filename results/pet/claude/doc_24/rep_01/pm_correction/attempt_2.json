  "gateways": [
    {
      "id": "gw_error_check",
      "name": "Errors found?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_error_yes",
          "condition": "Fehler vorhanden"
        },
        {
          "flow_id": "flow_error_no",
          "condition": "keine Fehler"
        }
      ]
    },
    {
      "id": "gw_exists_check",
      "name": "Customer exists in database?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_exists_yes",
          "condition": "existiert bereits"
        },
        {
          "flow_id": "flow_exists_no",
          "condition": "existiert nicht"
        }
      ]
    },
    {
      "id": "gw_check_result",
      "name": "Contract documents generated successfully?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_check_negative",
          "condition": "negativ"
        },
        {
          "flow_id": "flow_check_positive",
          "condition": "positiv"
        }
      ]
    },
    {
      "id": "gw_concurrence",
      "name": "Supplier concurrence?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_concurrence_yes",
          "condition": "Lieferantenkonkurrenz"
        },
        {
          "flow_id": "flow_concurrence_no",
          "condition": "keine Lieferantenkonkurrenz"
        }
      ]
    },
    {
      "id": "gw_concurrence_go",
      "name": "Supplier concurrence? (Grid Operator)",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_go_concurrence_yes",
          "condition": "Lieferantenkonkurrenz"
        },
        {
          "flow_id": "flow_go_concurrence_no",
          "condition": "keine Lieferantenkonkurrenz"
        }
      ]
    },
    {
      "id": "gw_accept_reject",
      "name": "Customer accepts or withdraws?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_withdraw",
          "condition": "Widerruf"
        },
        {
          "flow_id": "flow_confirm",
          "condition": "Bestätigung oder 7 Tage verstrichen"
        }
      ]
    }
  ],
