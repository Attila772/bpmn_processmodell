      <bpmndi:BPMNShape id="msg_end_results_shared_target_di" bpmnElement="msg_end_results_shared_target">
        <dc:Bounds x="160" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_end_to_go_di" bpmnElement="msg_end_to_go">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_end_to_go2_di" bpmnElement="msg_end_to_go2">
        <dc:Bounds x="1490" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_end_to_msp_di" bpmnElement="msg_end_to_msp">
        <dc:Bounds x="920" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_end_to_msp2_di" bpmnElement="msg_end_to_msp2">
        <dc:Bounds x="1680" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_start_go_confirm_di" bpmnElement="msg_start_go_confirm">
        <dc:Bounds x="160" y="1145" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_start_go_resolution_di" bpmnElement="msg_start_go_resolution">
        <dc:Bounds x="160" y="1270" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_start_msp_confirm_di" bpmnElement="msg_start_msp_confirm">
        <dc:Bounds x="160" y="1605" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_start_msp_resolution_di" bpmnElement="msg_start_msp_resolution">
        <dc:Bounds x="160" y="1730" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_start_report_sent_di" bpmnElement="msg_start_report_sent">
        <dc:Bounds x="160" y="810" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_report_di" bpmnElement="start_report">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_suspicion_di" bpmnElement="start_suspicion">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_examine_di" bpmnElement="task_examine">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_fix_fault_di" bpmnElement="task_fix_fault">
        <dc:Bounds x="920" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_go_confirm_di" bpmnElement="task_inform_go_confirm">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_go_resolution_di" bpmnElement="task_inform_go_resolution">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_msp_resolution_di" bpmnElement="task_inform_msp_resolution">
        <dc:Bounds x="1490" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_share_results_di" bpmnElement="task_share_results">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_failure_report_di" bpmnElement="data_failure_report">
        <dc:Bounds x="370" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_repair_results_di" bpmnElement="data_repair_results">
        <dc:Bounds x="1035" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_report_to_examine_di" bpmnElement="flow_start_report_to_examine">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_suspicion_to_examine_di" bpmnElement="flow_start_suspicion_to_examine">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_examine_to_gw_di" bpmnElement="flow_examine_to_gw">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_to_reject_di" bpmnElement="flow_gw_to_reject">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_to_inform_go_di" bpmnElement="flow_gw_to_inform_go">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_go_to_msg_go_di" bpmnElement="flow_inform_go_to_msg_go">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_go_to_msg_msp_di" bpmnElement="flow_inform_go_to_msg_msp">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="938" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_go_to_fix_di" bpmnElement="flow_inform_go_to_fix">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="970" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fix_to_share_di" bpmnElement="flow_fix_to_share">
        <di:waypoint x="970" y="390" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_share_to_inform_go_res_di" bpmnElement="flow_share_to_inform_go_res">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_go_res_to_msg_go2_di" bpmnElement="flow_inform_go_res_to_msg_go2">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1508" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_go_res_to_inform_msp_res_di" bpmnElement="flow_inform_go_res_to_inform_msp_res">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1540" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_msp_res_to_msg_msp2_di" bpmnElement="flow_inform_msp_res_to_msg_msp2">
        <di:waypoint x="1540" y="265" />
        <di:waypoint x="1698" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_msp_res_to_end_di" bpmnElement="flow_inform_msp_res_to_end">
