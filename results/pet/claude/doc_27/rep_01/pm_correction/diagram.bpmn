<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_fault_detector_part" name="Fault Detector" processRef="pool_fault_detector_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_msp_part" name="MSP" processRef="pool_msp_proc" />
    <bpmn:messageFlow id="mf_report" sourceRef="msg_start_report_sent" targetRef="start_report" name="Failure Report" />
    <bpmn:messageFlow id="mf_confirm_go" sourceRef="msg_end_to_go" targetRef="msg_start_go_confirm" name="Failure Confirmed" />
    <bpmn:messageFlow id="mf_confirm_msp" sourceRef="msg_end_to_msp" targetRef="msg_start_msp_confirm" name="Failure Confirmed" />
    <bpmn:messageFlow id="mf_results" sourceRef="task_share_results" targetRef="msg_end_results_shared_target" name="Repair Results" />
    <bpmn:messageFlow id="mf_resolution_go" sourceRef="msg_end_to_go2" targetRef="msg_start_go_resolution" name="Interference Resolved" />
    <bpmn:messageFlow id="mf_resolution_msp" sourceRef="msg_end_to_msp2" targetRef="msg_start_msp_resolution" name="Interference Resolved" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_failure_report" name="Failure Report" dataObjectRef="data_failure_report_do" />
    <bpmn:dataObject id="data_failure_report_do" />
    <bpmn:dataObjectReference id="data_repair_results" name="Repair Results" dataObjectRef="data_repair_results_do" />
    <bpmn:dataObject id="data_repair_results_do" />
    <bpmn:startEvent id="start_report" name="Failure reported by Fault Detector">
      <bpmn:outgoing>flow_start_report_to_examine</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="start_suspicion" name="MPO has suspicion of own fault">
      <bpmn:outgoing>flow_start_suspicion_to_examine</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_reject" name="Failure rejected">
      <bpmn:incoming>flow_gw_to_reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_process" name="Process completed">
      <bpmn:incoming>flow_inform_msp_res_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="msg_end_to_go" name="Inform GO about confirmation">
      <bpmn:incoming>flow_inform_go_to_msg_go</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_to_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msg_end_to_msp" name="Inform MSP about confirmation">
      <bpmn:incoming>flow_inform_go_to_msg_msp</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_to_msp_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msg_end_to_go2" name="Inform GO about resolution">
      <bpmn:incoming>flow_inform_go_res_to_msg_go2</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_to_go2_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msg_end_to_msp2" name="Inform MSP about resolution">
      <bpmn:incoming>flow_inform_msp_res_to_msg_msp2</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_to_msp2_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_examine" name="Examine the failure">
      <bpmn:incoming>flow_start_report_to_examine</bpmn:incoming>
      <bpmn:incoming>flow_start_suspicion_to_examine</bpmn:incoming>
      <bpmn:outgoing>flow_examine_to_gw</bpmn:outgoing>
      <bpmn:property id="task_examine_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_dia0">
        <bpmn:sourceRef>data_failure_report</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_inform_go_confirm" name="Inform GO about confirmed failure">
      <bpmn:incoming>flow_gw_to_inform_go</bpmn:incoming>
      <bpmn:outgoing>flow_inform_go_to_msg_go</bpmn:outgoing>
      <bpmn:outgoing>flow_inform_go_to_msg_msp</bpmn:outgoing>
      <bpmn:outgoing>flow_inform_go_to_fix</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="task_fix_fault" name="Fix the fault at the measuring device">
      <bpmn:incoming>flow_inform_go_to_fix</bpmn:incoming>
      <bpmn:outgoing>flow_fix_to_share</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_fix_fault_doa0">
        <bpmn:targetRef>data_repair_results</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_share_results" name="Share repair results with Fault Detector">
      <bpmn:incoming>flow_fix_to_share</bpmn:incoming>
      <bpmn:outgoing>flow_share_to_inform_go_res</bpmn:outgoing>
      <bpmn:property id="task_share_results_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_share_results_dia0">
        <bpmn:sourceRef>data_repair_results</bpmn:sourceRef>
        <bpmn:targetRef>task_share_results_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_inform_go_resolution" name="Inform GO about resolution of interference">
      <bpmn:incoming>flow_share_to_inform_go_res</bpmn:incoming>
      <bpmn:outgoing>flow_inform_go_res_to_msg_go2</bpmn:outgoing>
      <bpmn:outgoing>flow_inform_go_res_to_inform_msp_res</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_inform_msp_resolution" name="Inform MSP about resolution of interference">
      <bpmn:incoming>flow_inform_go_res_to_inform_msp_res</bpmn:incoming>
      <bpmn:outgoing>flow_inform_msp_res_to_msg_msp2</bpmn:outgoing>
      <bpmn:outgoing>flow_inform_msp_res_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_reject_confirm" name="Failure confirmed?" isMarkerVisible="true">
      <bpmn:incoming>flow_examine_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_gw_to_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_to_inform_go</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_report_to_examine" sourceRef="start_report" targetRef="task_examine" />
    <bpmn:sequenceFlow id="flow_start_suspicion_to_examine" sourceRef="start_suspicion" targetRef="task_examine" />
    <bpmn:sequenceFlow id="flow_examine_to_gw" sourceRef="task_examine" targetRef="gw_reject_confirm" />
    <bpmn:sequenceFlow id="flow_gw_to_reject" sourceRef="gw_reject_confirm" targetRef="end_reject" name="rejected" />
    <bpmn:sequenceFlow id="flow_gw_to_inform_go" sourceRef="gw_reject_confirm" targetRef="task_inform_go_confirm" name="confirmed" />
    <bpmn:sequenceFlow id="flow_inform_go_to_msg_go" sourceRef="task_inform_go_confirm" targetRef="msg_end_to_go" />
    <bpmn:sequenceFlow id="flow_inform_go_to_msg_msp" sourceRef="task_inform_go_confirm" targetRef="msg_end_to_msp" />
    <bpmn:sequenceFlow id="flow_inform_go_to_fix" sourceRef="task_inform_go_confirm" targetRef="task_fix_fault" />
    <bpmn:sequenceFlow id="flow_fix_to_share" sourceRef="task_fix_fault" targetRef="task_share_results" />
    <bpmn:sequenceFlow id="flow_share_to_inform_go_res" sourceRef="task_share_results" targetRef="task_inform_go_resolution" />
    <bpmn:sequenceFlow id="flow_inform_go_res_to_msg_go2" sourceRef="task_inform_go_resolution" targetRef="msg_end_to_go2" />
    <bpmn:sequenceFlow id="flow_inform_go_res_to_inform_msp_res" sourceRef="task_inform_go_resolution" targetRef="task_inform_msp_resolution" />
    <bpmn:sequenceFlow id="flow_inform_msp_res_to_msg_msp2" sourceRef="task_inform_msp_resolution" targetRef="msg_end_to_msp2" />
    <bpmn:sequenceFlow id="flow_inform_msp_res_to_end" sourceRef="task_inform_msp_resolution" targetRef="end_process" />
  </bpmn:process>
  <bpmn:process id="pool_fault_detector_proc" isExecutable="false">
    <bpmn:startEvent id="msg_start_report_sent" name="Fault Detector reports failure">
      <bpmn:messageEventDefinition id="msg_start_report_sent_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msg_end_results_shared_target" name="Fault Detector receives repair results">
      <bpmn:messageEventDefinition id="msg_end_results_shared_target_msgdef" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:endEvent id="msg_start_go_confirm" name="GO receives confirmation">
      <bpmn:messageEventDefinition id="msg_start_go_confirm_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msg_start_go_resolution" name="GO receives resolution info">
      <bpmn:messageEventDefinition id="msg_start_go_resolution_msgdef" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="pool_msp_proc" isExecutable="false">
    <bpmn:endEvent id="msg_start_msp_confirm" name="MSP receives confirmation">
      <bpmn:messageEventDefinition id="msg_start_msp_confirm_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msg_start_msp_resolution" name="MSP receives resolution info">
      <bpmn:messageEventDefinition id="msg_start_msp_resolution_msgdef" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpo_part_di" bpmnElement="pool_mpo_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1900" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_fault_detector_part_di" bpmnElement="pool_fault_detector_part" isHorizontal="true">
        <dc:Bounds x="120" y="625" width="700" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_go_part_di" bpmnElement="pool_go_part" isHorizontal="true">
