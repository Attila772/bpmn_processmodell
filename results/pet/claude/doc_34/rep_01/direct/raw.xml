<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="ExpenseReimbursementProcess" name="Expense Reimbursement Process" isExecutable="true">

    <laneSet id="LaneSet_1">
      <lane id="Lane_Employee" name="Employee">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>EndEvent_Completed</flowNodeRef>
        <flowNodeRef>EndEvent_Rejected</flowNodeRef>
        <flowNodeRef>EndEvent_Cancelled</flowNodeRef>
      </lane>
      <lane id="Lane_System" name="System">
        <flowNodeRef>Gateway_HasAccount</flowNodeRef>
        <flowNodeRef>Task_CreateAccount</flowNodeRef>
        <flowNodeRef>SubProcess_Approval</flowNodeRef>
        <flowNodeRef>Task_SendInProgressEmail</flowNodeRef>
        <flowNodeRef>Task_SendCancellationEmail</flowNodeRef>
        <flowNodeRef>EndEvent_InProgressNotified</flowNodeRef>
      </lane>
      <lane id="Lane_Supervisor" name="Supervisor">
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Expense Report Received">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <exclusiveGateway id="Gateway_HasAccount" name="Employee Has Account?">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_NoAccount</outgoing>
      <outgoing>Flow_HasAccount</outgoing>
    </exclusiveGateway>

    <task id="Task_CreateAccount" name="Create New Account">
      <incoming>Flow_NoAccount</incoming>
      <outgoing>Flow_AfterCreate</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Join" name="Join">
      <incoming>Flow_AfterCreate</incoming>
      <incoming>Flow_HasAccount</incoming>
      <outgoing>Flow_ToSubProcess</outgoing>
    </exclusiveGateway>

    <subProcess id="SubProcess_Approval" name="Process Expense Report Approval">
      <incoming>Flow_ToSubProcess</incoming>
      <outgoing>Flow_SubToCompleted</outgoing>
      <outgoing>Flow_SubToRejected</outgoing>

      <startEvent id="SubStart_1" name="Start Review">
        <outgoing>SubFlow_1</outgoing>
      </startEvent>

      <task id="Task_ReviewReport" name="Review Report for Automatic Approval">
        <incoming>SubFlow_1</incoming>
        <outgoing>SubFlow_2</outgoing>
      </task>

      <exclusiveGateway id="Gateway_AmountCheck" name="Amount &gt;= $200?">
        <incoming>SubFlow_2</incoming>
        <outgoing>SubFlow_AutoApprove</outgoing>
        <outgoing>SubFlow_NeedsSupervisor</outgoing>
      </exclusiveGateway>

      <task id="Task_AutoApprove" name="Automatically Approve">
        <incoming>SubFlow_AutoApprove</incoming>
        <outgoing>SubFlow_ToDeposit1</outgoing>
      </task>

      <task id="Task_SupervisorApproval" name="Supervisor Approval">
        <incoming>SubFlow_NeedsSupervisor</incoming>
        <outgoing>SubFlow_3</outgoing>
      </task>

      <exclusiveGateway id="Gateway_Approved" name="Approved?">
        <incoming>SubFlow_3</incoming>
        <outgoing>SubFlow_Approved</outgoing>
        <outgoing>SubFlow_RejectedPath</outgoing>
      </exclusiveGateway>

      <task id="Task_SendRejectionEmail" name="Send Rejection Email">
        <incoming>SubFlow_RejectedPath</incoming>
        <outgoing>SubFlow_ToRejectedEnd</outgoing>
      </task>

      <endEvent id="SubEnd_Rejected" name="Rejected">
        <incoming>SubFlow_ToRejectedEnd</incoming>
      </endEvent>

      <task id="Task_DirectDeposit" name="Process Direct Deposit">
        <incoming>SubFlow_ToDeposit1</incoming>
        <incoming>SubFlow_Approved</incoming>
        <outgoing>SubFlow_ToEnd</outgoing>
      </task>

      <endEvent id="SubEnd_Completed" name="Completed">
        <incoming>SubFlow_ToEnd</incoming>
      </endEvent>

      <sequenceFlow id="SubFlow_1" sourceRef="SubStart_1" targetRef="Task_ReviewReport" />
      <sequenceFlow id="SubFlow_2" sourceRef="Task_ReviewReport" targetRef="Gateway_AmountCheck" />
      <sequenceFlow id="SubFlow_AutoApprove" name="&lt; $200" sourceRef="Gateway_AmountCheck" targetRef="Task_AutoApprove" />
      <sequenceFlow id="SubFlow_NeedsSupervisor" name="&gt;= $200" sourceRef="Gateway_AmountCheck" targetRef="Task_SupervisorApproval" />
      <sequenceFlow id="SubFlow_ToDeposit1" sourceRef="Task_AutoApprove" targetRef="Task_DirectDeposit" />
      <sequenceFlow id="SubFlow_3" sourceRef="Task_SupervisorApproval" targetRef="Gateway_Approved" />
      <sequenceFlow id="SubFlow_Approved" name="Yes" sourceRef="Gateway_Approved" targetRef="Task_DirectDeposit" />
      <sequenceFlow id="SubFlow_RejectedPath" name="No" sourceRef="Gateway_Approved" targetRef="Task_SendRejectionEmail" />
      <sequenceFlow id="SubFlow_ToRejectedEnd" sourceRef="Task_SendRejectionEmail" targetRef="SubEnd_Rejected" />
      <sequenceFlow id="SubFlow_ToEnd" sourceRef="Task_DirectDeposit" targetRef="SubEnd_Completed" />

    </subProcess>

    <boundaryEvent id="BoundaryTimer_7Days" name="7 Days" attachedToRef="SubProcess_Approval" cancelActivity="false">
      <timerEventDefinition>
        <timeDuration>P7D</timeDuration>
      </timerEventDefinition>
      <outgoing>Flow_To7DayEmail</outgoing>
    </boundaryEvent>

    <task id="Task_SendInProgressEmail" name="Send Approval In Progress Email">
      <incoming>Flow_To7DayEmail</incoming>
      <outgoing>Flow_ToInProgressEnd</outgoing>
    </task>

    <endEvent id="EndEvent_InProgressNotified" name="In Progress Notification Sent">
      <incoming>Flow_ToInProgressEnd</incoming>
    </endEvent>

    <boundaryEvent id="BoundaryTimer_30Days" name="30 Days" attachedToRef="SubProcess_Approval" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration>P30D</timeDuration>
      </timerEventDefinition>
      <outgoing>Flow_To30DayEmail</outgoing>
    </boundaryEvent>

    <task id="Task_SendCancellationEmail" name="Send Cancellation Email">
      <incoming>Flow_To30DayEmail</incoming>
      <outgoing>Flow_ToCancelledEnd</outgoing>
    </task>

    <endEvent id="EndEvent_Cancelled" name="Process Cancelled - Resubmit Required">
      <incoming>Flow_ToCancelledEnd</incoming>
    </endEvent>

    <endEvent id="EndEvent_Completed" name="Reimbursement Completed">
      <incoming>Flow_SubToCompleted</incoming>
    </endEvent>

    <endEvent id="EndEvent_Rejected" name="Expense Report Rejected">
      <incoming>Flow_SubToRejected</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_HasAccount" />
    <sequenceFlow id="Flow_NoAccount" name="No Account" sourceRef="Gateway_HasAccount" targetRef="Task_CreateAccount" />
    <sequenceFlow id="Flow_HasAccount" name="Has Account" sourceRef="Gateway_HasAccount" targetRef="Gateway_Join" />
    <sequenceFlow id="Flow_AfterCreate" sourceRef="Task_CreateAccount" targetRef="Gateway_Join" />
    <sequenceFlow id="Flow_ToSubProcess" sourceRef="Gateway_Join" targetRef="SubProcess_Approval" />
    <sequenceFlow id="Flow_SubToCompleted" sourceRef="SubProcess_Approval" targetRef="EndEvent_Completed" />
    <sequenceFlow id="Flow_SubToRejected" sourceRef="SubProcess_Approval" targetRef="EndEvent_Rejected" />
    <sequenceFlow id="Flow_To7DayEmail" sourceRef="BoundaryTimer_7Days" targetRef="Task_SendInProgressEmail" />
    <sequenceFlow id="Flow_ToInProgressEnd" sourceRef="Task_SendInProgressEmail" targetRef="EndEvent_InProgressNotified" />
    <sequenceFlow id="Flow_To30DayEmail" sourceRef="BoundaryTimer_30Days" targetRef="Task_SendCancellationEmail" />
    <sequenceFlow id="Flow_ToCancelledEnd" sourceRef="Task_SendCancellationEmail" targetRef="EndEvent_Cancelled" />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ExpenseReimbursementProcess">

