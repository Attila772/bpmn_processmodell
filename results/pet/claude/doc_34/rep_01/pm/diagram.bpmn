<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do1" name="Expense Report" dataObjectRef="do1_do" />
    <bpmn:dataObject id="do1_do" />
    <bpmn:dataStoreReference id="ds1" name="Employee Account System" />
    <bpmn:dataObjectReference id="do2" name="Rejection Notice Email" dataObjectRef="do2_do" />
    <bpmn:dataObject id="do2_do" />
    <bpmn:dataStoreReference id="ds2" name="Direct Deposit Bank Account" />
    <bpmn:dataObjectReference id="do3" name="Approval In Progress Email" dataObjectRef="do3_do" />
    <bpmn:dataObject id="do3_do" />
    <bpmn:dataObjectReference id="do4" name="Cancellation Notice Email" dataObjectRef="do4_do" />
    <bpmn:dataObject id="do4_do" />
    <bpmn:startEvent id="e1" name="Expense Report Received">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="e2" name="Timer 7 Days">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>f_g4_notcompleted</bpmn:outgoing>
      <bpmn:timerEventDefinition id="e2_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="e3" name="Timer 30 Days">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>f_g5_notfinished</bpmn:outgoing>
      <bpmn:timerEventDefinition id="e3_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="e4" name="Reimbursement Completed">
      <bpmn:incoming>sf11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e5" name="Rejected - Notice Sent">
      <bpmn:incoming>sf12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e6" name="Process Cancelled">
      <bpmn:incoming>sf9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t1" name="Create New Account">
      <bpmn:incoming>f_g1_create</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:property id="t1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t1_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Review Report for Automatic Approval">
      <bpmn:incoming>f_g1_review</bpmn:incoming>
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:property id="t2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t2_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="t3" name="Automatically Approve Report">
      <bpmn:incoming>f_g2_auto</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:property id="t3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t3_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="t4" name="Supervisor Approval">
      <bpmn:incoming>f_g2_supervisor</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t4_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="t5" name="Send Rejection Notice Email">
      <bpmn:incoming>f_g3_rejected</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t5_doa0">
        <bpmn:targetRef>do2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t6" name="Deposit Reimbursement to Bank Account">
      <bpmn:incoming>f_g3_approved</bpmn:incoming>
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t6_doa0">
        <bpmn:targetRef>ds2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t7" name="Send Approval In Progress Email">
      <bpmn:incoming>f_g4_notcompleted</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t7_doa0">
        <bpmn:targetRef>do3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t8" name="Send Cancellation Notice Email">
      <bpmn:incoming>f_g5_notfinished</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t8_doa0">
        <bpmn:targetRef>do4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t9" name="Re-submit Expense Report">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t9_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g1" name="Account Exists?" isMarkerVisible="true">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>f_g1_create</bpmn:outgoing>
      <bpmn:outgoing>f_g1_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="Amount Check" isMarkerVisible="true">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>f_g2_auto</bpmn:outgoing>
      <bpmn:outgoing>f_g2_supervisor</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Supervisor Decision" isMarkerVisible="true">
      <bpmn:incoming>f_g5_finished</bpmn:incoming>
      <bpmn:incoming>f_g4_completed</bpmn:incoming>
      <bpmn:outgoing>f_g3_approved</bpmn:outgoing>
      <bpmn:outgoing>f_g3_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g4" name="7-Day Timer Check" isMarkerVisible="true">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:outgoing>f_g4_completed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g5" name="30-Day Timer Check" isMarkerVisible="true">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:outgoing>f_g5_finished</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf1" sourceRef="e1" targetRef="g1" />
    <bpmn:sequenceFlow id="f_g1_create" sourceRef="g1" targetRef="t1" name="nincs fiók / no account" />
    <bpmn:sequenceFlow id="f_g1_review" sourceRef="g1" targetRef="t2" name="van fiók / has account" />
    <bpmn:sequenceFlow id="sf2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="sf3" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="f_g2_auto" sourceRef="g2" targetRef="t3" name="&lt; $200" />
    <bpmn:sequenceFlow id="f_g2_supervisor" sourceRef="g2" targetRef="t4" name="&gt;= $200" />
    <bpmn:sequenceFlow id="sf4" sourceRef="t4" targetRef="g4" />
    <bpmn:sequenceFlow id="sf5" sourceRef="g4" targetRef="e2" />
    <bpmn:sequenceFlow id="f_g4_notcompleted" sourceRef="e2" targetRef="t7" name="not completed in 7 days" />
    <bpmn:sequenceFlow id="sf6" sourceRef="t7" targetRef="g5" />
    <bpmn:sequenceFlow id="sf7" sourceRef="g5" targetRef="e3" />
    <bpmn:sequenceFlow id="f_g5_notfinished" sourceRef="e3" targetRef="t8" name="not finished in 30 days" />
    <bpmn:sequenceFlow id="sf8" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="sf9" sourceRef="t9" targetRef="e6" />
    <bpmn:sequenceFlow id="f_g5_finished" sourceRef="g5" targetRef="g3" name="finished" />
    <bpmn:sequenceFlow id="f_g4_completed" sourceRef="g4" targetRef="g3" name="completed" />
    <bpmn:sequenceFlow id="f_g3_approved" sourceRef="g3" targetRef="t6" name="approved" />
    <bpmn:sequenceFlow id="f_g3_rejected" sourceRef="g3" targetRef="t5" name="rejected" />
    <bpmn:sequenceFlow id="sf10" sourceRef="t3" targetRef="t6" />
    <bpmn:sequenceFlow id="sf11" sourceRef="t6" targetRef="e4" />
    <bpmn:sequenceFlow id="sf12" sourceRef="t5" targetRef="e5" />
  </bpmn:process>
