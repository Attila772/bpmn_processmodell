        <bpmn:targetRef>t2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="t3" name="Automatically Approve Report">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:property id="t3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t3_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="t4" name="Supervisor Approval">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
