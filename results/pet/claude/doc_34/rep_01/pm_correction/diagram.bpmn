    <bpmn:startEvent id="e1" name="Expense Report Received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="e2" name="7 Days Timer">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="e2_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="e3" name="30 Days Timer">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="e3_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="e4" name="Reimbursement Completed">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e5" name="Rejected - Notice Sent">
      <bpmn:incoming>f13b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e6" name="Process Cancelled - Resubmit Required">
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t1" name="Create New Account">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="t1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t1_dia0">
