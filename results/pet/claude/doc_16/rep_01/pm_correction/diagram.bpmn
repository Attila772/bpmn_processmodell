<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_manager_part" name="Manager" processRef="pool_manager_proc" />
    <bpmn:participant id="pool_assistant_part" name="Sales Assistant" processRef="pool_assistant_proc" />
    <bpmn:messageFlow id="mflow1" sourceRef="event_send_instruction" targetRef="event_receive_instruction" name="Call Instruction" />
    <bpmn:messageFlow id="mflow2" sourceRef="event_send_note" targetRef="event_receive_note" name="Interest Note" />
  </bpmn:collaboration>
  <bpmn:process id="pool_manager_proc" isExecutable="false">
    <bpmn:dataStoreReference id="data_store_crm" name="CRM System" />
    <bpmn:dataObjectReference id="data_open_leads_list" name="Open Leads List" dataObjectRef="data_open_leads_list_do" />
    <bpmn:dataObject id="data_open_leads_list_do" />
    <bpmn:dataObjectReference id="data_top5_list" name="Top Five Leads List" dataObjectRef="data_top5_list_do" />
    <bpmn:dataObject id="data_top5_list_do" />
    <bpmn:startEvent id="start1" name="Process Start">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_send_instruction" name="Instruction Sent">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_instruction_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="event_receive_note" name="Note Received">
      <bpmn:outgoing>flow8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_note_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="Lead Processed">
      <bpmn:incoming>flow9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_leads" name="Check open leads">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:property id="task_check_leads_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_leads_dia0">
        <bpmn:sourceRef>data_store_crm</bpmn:sourceRef>
        <bpmn:targetRef>task_check_leads_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_check_leads_doa0">
        <bpmn:targetRef>data_open_leads_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_select_top5" name="Select top five leads">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:property id="task_select_top5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_select_top5_dia0">
        <bpmn:sourceRef>data_open_leads_list</bpmn:sourceRef>
        <bpmn:targetRef>task_select_top5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_select_top5_doa0">
        <bpmn:targetRef>data_top5_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_instruct_assistant" name="Tell Sales Assistant to call contacts">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
      <bpmn:property id="task_instruct_assistant_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_instruct_assistant_dia0">
        <bpmn:sourceRef>data_top5_list</bpmn:sourceRef>
        <bpmn:targetRef>task_instruct_assistant_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_process_lead" name="Process lead">
      <bpmn:incoming>flow8</bpmn:incoming>
      <bpmn:outgoing>flow9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_process_lead_doa0">
        <bpmn:targetRef>data_store_crm</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow1" sourceRef="start1" targetRef="task_check_leads" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task_check_leads" targetRef="task_select_top5" />
    <bpmn:sequenceFlow id="flow3" sourceRef="task_select_top5" targetRef="task_instruct_assistant" />
    <bpmn:sequenceFlow id="flow4" sourceRef="task_instruct_assistant" targetRef="event_send_instruction" />
    <bpmn:sequenceFlow id="flow8" sourceRef="event_receive_note" targetRef="task_process_lead" />
    <bpmn:sequenceFlow id="flow9" sourceRef="task_process_lead" targetRef="end1" />
  </bpmn:process>
  <bpmn:process id="pool_assistant_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_top5_list_p1" name="Top Five Leads List" dataObjectRef="data_top5_list_p1_do" />
    <bpmn:dataObject id="data_top5_list_p1_do" />
    <bpmn:startEvent id="event_receive_instruction" name="Instruction Received">
      <bpmn:outgoing>flow5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_instruction_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="event_send_note" name="Note Sent">
      <bpmn:incoming>flow_interested_yes</bpmn:incoming>
      <bpmn:outgoing>flow7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_send_note_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end2" name="Calls Completed">
      <bpmn:incoming>flow7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_call_customer" name="Call customer">
      <bpmn:incoming>flow5</bpmn:incoming>
      <bpmn:incoming>flow_interested_no</bpmn:incoming>
      <bpmn:outgoing>flow6</bpmn:outgoing>
      <bpmn:property id="task_call_customer_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_call_customer_dia0">
        <bpmn:sourceRef>data_top5_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_call_customer_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gateway_interested" name="Interested?" isMarkerVisible="true">
      <bpmn:incoming>flow6</bpmn:incoming>
      <bpmn:outgoing>flow_interested_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_interested_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow5" sourceRef="event_receive_instruction" targetRef="task_call_customer" />
    <bpmn:sequenceFlow id="flow6" sourceRef="task_call_customer" targetRef="gateway_interested" />
    <bpmn:sequenceFlow id="flow_interested_yes" sourceRef="gateway_interested" targetRef="event_send_note" name="interested" />
    <bpmn:sequenceFlow id="flow_interested_no" sourceRef="gateway_interested" targetRef="task_call_customer" name="not interested" />
    <bpmn:sequenceFlow id="flow7" sourceRef="event_send_note" targetRef="end2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_manager_part_di" bpmnElement="pool_manager_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1140" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_assistant_part_di" bpmnElement="pool_assistant_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="1140" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end1_di" bpmnElement="end1">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end2_di" bpmnElement="end2">
        <dc:Bounds x="920" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_receive_instruction_di" bpmnElement="event_receive_instruction">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_receive_note_di" bpmnElement="event_receive_note">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_send_instruction_di" bpmnElement="event_send_instruction">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_send_note_di" bpmnElement="event_send_note">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_interested_di" bpmnElement="gateway_interested">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_call_customer_di" bpmnElement="task_call_customer">
        <dc:Bounds x="730" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_leads_di" bpmnElement="task_check_leads">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_instruct_assistant_di" bpmnElement="task_instruct_assistant">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_lead_di" bpmnElement="task_process_lead">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_select_top5_di" bpmnElement="task_select_top5">
        <dc:Bounds x="540" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_store_crm_di" bpmnElement="data_store_crm">
        <dc:Bounds x="370" y="365" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_open_leads_list_di" bpmnElement="data_open_leads_list">
        <dc:Bounds x="465" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_top5_list_di" bpmnElement="data_top5_list">
        <dc:Bounds x="655" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_top5_list_p1_di" bpmnElement="data_top5_list_p1">
        <dc:Bounds x="750" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="590" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow5_di" bpmnElement="flow5">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow6_di" bpmnElement="flow6">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_yes_di" bpmnElement="flow_interested_yes">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_no_di" bpmnElement="flow_interested_no">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow7_di" bpmnElement="flow7">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="938" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow8_di" bpmnElement="flow8">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow9_di" bpmnElement="flow9">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mflow1_di" bpmnElement="mflow1">
        <di:waypoint x="938" y="118" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mflow2_di" bpmnElement="mflow2">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_leads_dia0_di" bpmnElement="task_check_leads_dia0">
        <di:waypoint x="395" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_leads_doa0_di" bpmnElement="task_check_leads_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_select_top5_dia0_di" bpmnElement="task_select_top5_dia0">
        <di:waypoint x="483" y="390" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_select_top5_doa0_di" bpmnElement="task_select_top5_doa0">
        <di:waypoint x="590" y="265" />
        <di:waypoint x="673" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_instruct_assistant_dia0_di" bpmnElement="task_instruct_assistant_dia0">
        <di:waypoint x="673" y="390" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_call_customer_dia0_di" bpmnElement="task_call_customer_dia0">
        <di:waypoint x="768" y="850" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_process_lead_doa0_di" bpmnElement="task_process_lead_doa0">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="395" y="390" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>