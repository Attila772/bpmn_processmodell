<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_manager_part" name="Manager" processRef="pool_manager_proc" />
    <bpmn:participant id="pool_assistant_part" name="Sales Assistant" processRef="pool_assistant_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="event_send_instruction" targetRef="event_receive_instruction" name="Call Leads Instruction" />
    <bpmn:messageFlow id="mf2" sourceRef="event_send_note" targetRef="event_receive_note" name="Interest Note" />
  </bpmn:collaboration>
  <bpmn:process id="pool_manager_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_leads_list" name="Open Leads List" dataObjectRef="data_leads_list_do" />
    <bpmn:dataObject id="data_leads_list_do" />
    <bpmn:dataObjectReference id="data_top5_list" name="Top Five Leads List" dataObjectRef="data_top5_list_do" />
    <bpmn:dataObject id="data_top5_list_do" />
    <bpmn:dataObjectReference id="data_note" name="Interest Note" dataObjectRef="data_note_do" />
    <bpmn:dataObject id="data_note_do" />
    <bpmn:startEvent id="start1" name="Process Start">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_send_instruction" name="Instruction Sent to Call Leads">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_instruction_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="event_receive_note" name="Note Received">
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_note_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="Lead Processed">
      <bpmn:incoming>sf9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_leads" name="Check open leads">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:property id="task_check_leads_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_leads_dia0">
        <bpmn:sourceRef>data_leads_list</bpmn:sourceRef>
        <bpmn:targetRef>task_check_leads_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_select_top5" name="Select top five leads">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:property id="task_select_top5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_select_top5_dia0">
        <bpmn:sourceRef>data_leads_list</bpmn:sourceRef>
        <bpmn:targetRef>task_select_top5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_select_top5_doa0">
        <bpmn:targetRef>data_top5_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_tell_assistant" name="Tell Sales Assistant to call leads">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="task_tell_assistant_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_tell_assistant_dia0">
        <bpmn:sourceRef>data_top5_list</bpmn:sourceRef>
        <bpmn:targetRef>task_tell_assistant_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task_process_lead" name="Process lead">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="task_process_lead_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_process_lead_dia0">
        <bpmn:sourceRef>data_note</bpmn:sourceRef>
        <bpmn:targetRef>task_process_lead_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf1" sourceRef="start1" targetRef="task_check_leads" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task_check_leads" targetRef="task_select_top5" />
    <bpmn:sequenceFlow id="sf3" sourceRef="task_select_top5" targetRef="task_tell_assistant" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task_tell_assistant" targetRef="event_send_instruction" />
    <bpmn:sequenceFlow id="sf8" sourceRef="event_receive_note" targetRef="task_process_lead" />
    <bpmn:sequenceFlow id="sf9" sourceRef="task_process_lead" targetRef="end1" />
  </bpmn:process>
  <bpmn:process id="pool_assistant_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_top5_list_p1" name="Top Five Leads List" dataObjectRef="data_top5_list_p1_do" />
    <bpmn:dataObject id="data_top5_list_p1_do" />
    <bpmn:startEvent id="event_receive_instruction" name="Instruction Received">
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_instruction_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="event_send_note" name="Note Sent to Manager">
      <bpmn:incoming>flow_interested_yes</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_send_note_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end2" name="All Calls Completed">
      <bpmn:incoming>sf7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_call_customer" name="Call customer">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:incoming>flow_interested_no</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="task_call_customer_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_call_customer_dia0">
        <bpmn:sourceRef>data_top5_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_call_customer_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_interested" name="Interested?" isMarkerVisible="true">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>flow_interested_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_interested_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf5" sourceRef="event_receive_instruction" targetRef="task_call_customer" />
    <bpmn:sequenceFlow id="sf6" sourceRef="task_call_customer" targetRef="gw_interested" />
    <bpmn:sequenceFlow id="flow_interested_yes" sourceRef="gw_interested" targetRef="event_send_note" name="interested" />
    <bpmn:sequenceFlow id="flow_interested_no" sourceRef="gw_interested" targetRef="task_call_customer" name="not interested" />
    <bpmn:sequenceFlow id="sf7" sourceRef="event_send_note" targetRef="end2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_manager_part_di" bpmnElement="pool_manager_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1140" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_assistant_part_di" bpmnElement="pool_assistant_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="1140" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end1_di" bpmnElement="end1">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end2_di" bpmnElement="end2">
        <dc:Bounds x="920" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_receive_instruction_di" bpmnElement="event_receive_instruction">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_receive_note_di" bpmnElement="event_receive_note">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_send_instruction_di" bpmnElement="event_send_instruction">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_send_note_di" bpmnElement="event_send_note">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_interested_di" bpmnElement="gw_interested">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_call_customer_di" bpmnElement="task_call_customer">
        <dc:Bounds x="730" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_leads_di" bpmnElement="task_check_leads">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_lead_di" bpmnElement="task_process_lead">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_select_top5_di" bpmnElement="task_select_top5">
        <dc:Bounds x="540" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_tell_assistant_di" bpmnElement="task_tell_assistant">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_leads_list_di" bpmnElement="data_leads_list">
        <dc:Bounds x="465" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_top5_list_di" bpmnElement="data_top5_list">
        <dc:Bounds x="655" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_note_di" bpmnElement="data_note">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_top5_list_p1_di" bpmnElement="data_top5_list_p1">
        <dc:Bounds x="750" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3">
        <di:waypoint x="590" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf4_di" bpmnElement="sf4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf5_di" bpmnElement="sf5">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf6_di" bpmnElement="sf6">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_yes_di" bpmnElement="flow_interested_yes">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_no_di" bpmnElement="flow_interested_no">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf7_di" bpmnElement="sf7">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="938" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf8_di" bpmnElement="sf8">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf9_di" bpmnElement="sf9">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_di" bpmnElement="mf1">
        <di:waypoint x="938" y="118" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_di" bpmnElement="mf2">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_leads_dia0_di" bpmnElement="task_check_leads_dia0">
        <di:waypoint x="483" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_select_top5_dia0_di" bpmnElement="task_select_top5_dia0">
        <di:waypoint x="483" y="390" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_select_top5_doa0_di" bpmnElement="task_select_top5_doa0">
        <di:waypoint x="590" y="265" />
        <di:waypoint x="673" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_tell_assistant_dia0_di" bpmnElement="task_tell_assistant_dia0">
        <di:waypoint x="673" y="390" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_call_customer_dia0_di" bpmnElement="task_call_customer_dia0">
        <di:waypoint x="768" y="850" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_process_lead_dia0_di" bpmnElement="task_process_lead_dia0">
        <di:waypoint x="388" y="390" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>