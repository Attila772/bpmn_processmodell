  "events": [
    {
      "id": "start1",
      "name": "Invoice received (paper/fax)",
      "event_position": "start",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "msgend_to_accounting",
      "name": "Invoice forwarded to accounting",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Invoice copy + forwarding"
    },
    {
      "id": "msgstart_from_secretariat",
      "name": "Invoice received from secretariat",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Invoice copy + forwarding"
    },
    {
      "id": "msgend_to_ccm1",
      "name": "Docket+copy sent to first CCM",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy"
    },
    {
      "id": "msgstart_from_accounting1",
      "name": "Docket+copy received",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy"
    },
    {
      "id": "msgend_to_accounting_next",
      "name": "Send to next CCM or accounting",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy"
    },
    {
      "id": "msgend_to_accounting_final",
      "name": "All items AP or rejection - send to accounting",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy"
    },
    {
      "id": "msgstart_from_ccm",
      "name": "Docket+copy received back",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy"
    },
    {
      "id": "msgend_to_ccm_again",
      "name": "Resolved - resend to CCM",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - resend"
    },
    {
      "id": "msgstart_from_accounting_again",
      "name": "Resolved invoice received again",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - resend"
    },
    {
      "id": "msgend_to_commercial",
      "name": "Send to commercial manager",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - final"
    },
    {
      "id": "msgstart_from_accounting2",
      "name": "Invoice received for commercial audit",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - final"
    },
    {
      "id": "msgend_to_board",
      "name": "Send to board for 4-eyes check",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - board review"
    },
    {
      "id": "msgstart_from_commercial2",
      "name": "Invoice received for board check",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - board review"
    },
    {
      "id": "msgend_to_accounting4",
      "name": "Board check complete - return to accounting",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - signature file"
    },
    {
      "id": "msgend_to_accounting3",
      "name": "Commercial audit done - return to accounting",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - signature file"
    },
    {
      "id": "msgstart_from_commercial",
      "name": "Signed invoice received",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Docket and invoice copy - signature file"
    },
    {
      "id": "end_accounting",
      "name": "Instance closed",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    }
