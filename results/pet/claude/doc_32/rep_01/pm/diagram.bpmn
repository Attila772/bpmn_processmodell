<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_secretariat_part" name="Secretariat" processRef="pool_secretariat_proc" />
    <bpmn:participant id="pool_accounting_part" name="Accounting Employee" processRef="pool_accounting_proc" />
    <bpmn:participant id="pool_ccm_part" name="Cost Center Managers" processRef="pool_ccm_proc" />
    <bpmn:participant id="pool_commercial_part" name="Commercial Manager" processRef="pool_commercial_proc" />
    <bpmn:participant id="pool_board_part" name="Board" processRef="pool_board_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="msgend_to_accounting" targetRef="msgstart_from_secretariat" />
    <bpmn:messageFlow id="mf2" sourceRef="msgend_to_ccm1" targetRef="msgstart_from_accounting1" />
    <bpmn:messageFlow id="mf3" sourceRef="msgend_to_accounting_next" targetRef="msgstart_from_accounting1" />
    <bpmn:messageFlow id="mf4" sourceRef="msgend_to_accounting_final" targetRef="msgstart_from_ccm" />
    <bpmn:messageFlow id="mf5" sourceRef="msgend_to_ccm_again" targetRef="msgstart_from_accounting_again" />
    <bpmn:messageFlow id="mf6" sourceRef="msgend_to_commercial" targetRef="msgstart_from_accounting2" />
    <bpmn:messageFlow id="mf7" sourceRef="msgend_to_board" targetRef="msgstart_from_commercial2" />
    <bpmn:messageFlow id="mf8" sourceRef="msgend_to_accounting4" targetRef="msgstart_from_commercial" />
    <bpmn:messageFlow id="mf9" sourceRef="msgend_to_accounting3" targetRef="msgstart_from_commercial" />
  </bpmn:collaboration>
  <bpmn:process id="pool_secretariat_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_invoice" name="Invoice (copy)" dataObjectRef="doc_invoice_do" />
    <bpmn:dataObject id="doc_invoice_do" />
    <bpmn:startEvent id="start1" name="Invoice received (paper/fax)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="msgend_to_accounting" name="Invoice forwarded to accounting">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_accounting_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msgend_to_commercial" name="Send to commercial manager">
      <bpmn:incoming>f_allap_yes</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_commercial_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_receive" name="Receive invoice in central inbox">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_receive_doa0">
        <bpmn:targetRef>doc_invoice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_inspect" name="Visual inspection of invoice">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:property id="task_inspect_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inspect_dia0">
        <bpmn:sourceRef>doc_invoice</bpmn:sourceRef>
        <bpmn:targetRef>task_inspect_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="task_receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_receive" targetRef="task_inspect" />
    <bpmn:sequenceFlow id="f3" sourceRef="task_inspect" targetRef="msgend_to_accounting" />
  </bpmn:process>
  <bpmn:process id="pool_accounting_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_invoice_p1" name="Invoice (copy)" dataObjectRef="doc_invoice_p1_do" />
    <bpmn:dataObject id="doc_invoice_p1_do" />
    <bpmn:dataStoreReference id="store_acme_fa" name="ACME Financial Accounting" />
    <bpmn:dataObjectReference id="doc_docket" name="Docket" dataObjectRef="doc_docket_do" />
    <bpmn:dataObject id="doc_docket_do" />
    <bpmn:startEvent id="msgstart_from_secretariat" name="Invoice received from secretariat">
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgstart_from_secretariat_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msgend_to_ccm1" name="Docket+copy sent to first CCM">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_ccm1_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="msgstart_from_ccm" name="Docket+copy received back">
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgstart_from_ccm_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msgend_to_ccm_again" name="Resolved - resend to CCM">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_ccm_again_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="msgstart_from_commercial" name="Signed invoice received">
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgstart_from_commercial_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_accounting" name="Instance closed">
      <bpmn:incoming>f23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_identify_supplier" name="Identify charging supplier and create instance">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:property id="task_identify_supplier_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_identify_supplier_dia0">
        <bpmn:sourceRef>doc_invoice_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_identify_supplier_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_identify_supplier_doa0">
        <bpmn:targetRef>store_acme_fa</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_items" name="Check invoice items">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:property id="task_check_items_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_items_dia0">
        <bpmn:sourceRef>doc_invoice_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_items_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_create_docket" name="Note cost center and manager on docket">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_docket_doa0">
        <bpmn:targetRef>doc_docket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_clarify_vendor" name="Clarify inconsistencies with vendor">
      <bpmn:incoming>f_allap_no</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:property id="task_clarify_vendor_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_clarify_vendor_dia0">
        <bpmn:sourceRef>doc_docket</bpmn:sourceRef>
        <bpmn:targetRef>task_clarify_vendor_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_resolve_complaint" name="Resolve complaint with supplier">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_payment_instruction" name="Give payment instruction and close instance">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_payment_instruction_doa0">
        <bpmn:targetRef>store_acme_fa</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_all_ap" name="All items AP?" isMarkerVisible="true">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f_allap_yes</bpmn:outgoing>
      <bpmn:outgoing>f_allap_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f4" sourceRef="msgstart_from_secretariat" targetRef="task_identify_supplier" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_identify_supplier" targetRef="task_check_items" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_check_items" targetRef="task_create_docket" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_create_docket" targetRef="msgend_to_ccm1" />
    <bpmn:sequenceFlow id="f14" sourceRef="msgstart_from_ccm" targetRef="gw_all_ap" />
    <bpmn:sequenceFlow id="f_allap_no" sourceRef="gw_all_ap" targetRef="task_clarify_vendor" name="inconsistency" />
    <bpmn:sequenceFlow id="f15" sourceRef="task_clarify_vendor" targetRef="msgend_to_ccm_again" />
    <bpmn:sequenceFlow id="f21" sourceRef="msgstart_from_commercial" targetRef="task_resolve_complaint" />
    <bpmn:sequenceFlow id="f22" sourceRef="task_resolve_complaint" targetRef="task_payment_instruction" />
    <bpmn:sequenceFlow id="f23" sourceRef="task_payment_instruction" targetRef="end_accounting" />
  </bpmn:process>
  <bpmn:process id="pool_ccm_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_invoice_p2" name="Invoice (copy)" dataObjectRef="doc_invoice_p2_do" />
    <bpmn:dataObject id="doc_invoice_p2_do" />
    <bpmn:dataObjectReference id="doc_docket_p1" name="Docket" dataObjectRef="doc_docket_p1_do" />
    <bpmn:dataObject id="doc_docket_p1_do" />
    <bpmn:startEvent id="msgstart_from_accounting1" name="Docket+copy received">
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgstart_from_accounting1_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msgend_to_accounting_next" name="Send to next CCM or accounting">
      <bpmn:incoming>f_more_yes</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_accounting_next_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msgend_to_accounting_final" name="All items AP or rejection - send to accounting">
      <bpmn:incoming>f_more_no</bpmn:incoming>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_accounting_final_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="msgstart_from_accounting_again" name="Resolved invoice received again">
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgstart_from_accounting_again_msgdef" />
    </bpmn:startEvent>
    <bpmn:manualTask id="task_review_content" name="Review invoice content for accuracy">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:property id="task_review_content_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_content_dia0">
        <bpmn:sourceRef>doc_invoice_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_review_content_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_review_content_dia1">
        <bpmn:sourceRef>doc_docket_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_content_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_note_ap" name="Note code AP on docket">
      <bpmn:incoming>f_accurate_yes</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:property id="task_note_ap_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_note_ap_dia0">
        <bpmn:sourceRef>doc_docket_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_note_ap_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_note_ap_doa0">
        <bpmn:targetRef>doc_docket_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_reject_ap" name="Reject AP with note and explanation">
      <bpmn:incoming>f_accurate_no</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:property id="task_reject_ap_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_reject_ap_dia0">
        <bpmn:sourceRef>doc_docket_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_reject_ap_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_reject_ap_doa0">
        <bpmn:targetRef>doc_docket_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_review_again" name="Review invoice again after clarification">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:property id="task_review_again_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_again_dia0">
        <bpmn:sourceRef>doc_invoice_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_review_again_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_review_again_dia1">
        <bpmn:sourceRef>doc_docket_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_again_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_accurate" name="Content accurate?" isMarkerVisible="true">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f_accurate_yes</bpmn:outgoing>
      <bpmn:outgoing>f_accurate_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_more_items" name="More items on docket?" isMarkerVisible="true">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f_more_yes</bpmn:outgoing>
      <bpmn:outgoing>f_more_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f8" sourceRef="msgstart_from_accounting1" targetRef="task_review_content" />
    <bpmn:sequenceFlow id="f9" sourceRef="task_review_content" targetRef="gw_accurate" />
    <bpmn:sequenceFlow id="f_accurate_yes" sourceRef="gw_accurate" targetRef="task_note_ap" name="accurate" />
    <bpmn:sequenceFlow id="f_accurate_no" sourceRef="gw_accurate" targetRef="task_reject_ap" name="inconsistency" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_note_ap" targetRef="gw_more_items" />
    <bpmn:sequenceFlow id="f_more_yes" sourceRef="gw_more_items" targetRef="msgend_to_accounting_next" name="next cost center manager" />
    <bpmn:sequenceFlow id="f_more_no" sourceRef="gw_more_items" targetRef="msgend_to_accounting_final" name="all items AP" />
    <bpmn:sequenceFlow id="f11" sourceRef="task_reject_ap" targetRef="msgend_to_accounting_final" />
    <bpmn:sequenceFlow id="f12" sourceRef="msgstart_from_accounting_again" targetRef="task_review_again" />
    <bpmn:sequenceFlow id="f13" sourceRef="task_review_again" targetRef="gw_accurate" />
  </bpmn:process>
  <bpmn:process id="pool_commercial_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_invoice_p3" name="Invoice (copy)" dataObjectRef="doc_invoice_p3_do" />
    <bpmn:dataObject id="doc_invoice_p3_do" />
    <bpmn:dataObjectReference id="doc_docket_p2" name="Docket" dataObjectRef="doc_docket_p2_do" />
    <bpmn:dataObject id="doc_docket_p2_do" />
    <bpmn:startEvent id="msgstart_from_accounting2" name="Invoice received for commercial audit">
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgstart_from_accounting2_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msgend_to_board" name="Send to board for 4-eyes check">
      <bpmn:incoming>f_amount_yes</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_board_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msgend_to_accounting3" name="Commercial audit done - return to accounting">
      <bpmn:incoming>f_amount_no</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_accounting3_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_commercial_audit" name="Perform commercial audit">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:property id="task_commercial_audit_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_commercial_audit_dia0">
        <bpmn:sourceRef>doc_invoice_p3</bpmn:sourceRef>
        <bpmn:targetRef>task_commercial_audit_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_commercial_audit_dia1">
        <bpmn:sourceRef>doc_docket_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_commercial_audit_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_issue_approval" name="Issue approval for payment">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_amount_check" name="Invoice amount &gt; EUR 20?" isMarkerVisible="true">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f_amount_yes</bpmn:outgoing>
      <bpmn:outgoing>f_amount_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f18" sourceRef="msgstart_from_accounting2" targetRef="task_commercial_audit" />
    <bpmn:sequenceFlow id="f19" sourceRef="task_commercial_audit" targetRef="task_issue_approval" />
    <bpmn:sequenceFlow id="f20" sourceRef="task_issue_approval" targetRef="gw_amount_check" />
    <bpmn:sequenceFlow id="f_amount_yes" sourceRef="gw_amount_check" targetRef="msgend_to_board" name="amount &gt; 20 EUR" />
    <bpmn:sequenceFlow id="f_amount_no" sourceRef="gw_amount_check" targetRef="msgend_to_accounting3" name="amount &lt;= 20 EUR" />
  </bpmn:process>
  <bpmn:process id="pool_board_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_invoice_p4" name="Invoice (copy)" dataObjectRef="doc_invoice_p4_do" />
    <bpmn:dataObject id="doc_invoice_p4_do" />
    <bpmn:dataObjectReference id="doc_docket_p3" name="Docket" dataObjectRef="doc_docket_p3_do" />
    <bpmn:dataObject id="doc_docket_p3_do" />
    <bpmn:startEvent id="msgstart_from_commercial2" name="Invoice received for board check">
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgstart_from_commercial2_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msgend_to_accounting4" name="Board check complete - return to accounting">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:messageEventDefinition id="msgend_to_accounting4_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_board_check" name="Board reviews invoice (4-eyes principle)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:property id="task_board_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_board_check_dia0">
        <bpmn:sourceRef>doc_invoice_p4</bpmn:sourceRef>
        <bpmn:targetRef>task_board_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_board_check_dia1">
        <bpmn:sourceRef>doc_docket_p3</bpmn:sourceRef>
        <bpmn:targetRef>task_board_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="f16" sourceRef="msgstart_from_commercial2" targetRef="task_board_check" />
    <bpmn:sequenceFlow id="f17" sourceRef="task_board_check" targetRef="msgend_to_accounting4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_secretariat_part_di" bpmnElement="pool_secretariat_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="950" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_accounting_part_di" bpmnElement="pool_accounting_part" isHorizontal="true">
        <dc:Bounds x="120" y="375" width="1140" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_ccm_part_di" bpmnElement="pool_ccm_part" isHorizontal="true">
        <dc:Bounds x="120" y="960" width="1330" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_commercial_part_di" bpmnElement="pool_commercial_part" isHorizontal="true">
        <dc:Bounds x="120" y="1420" width="1140" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_board_part_di" bpmnElement="pool_board_part" isHorizontal="true">
