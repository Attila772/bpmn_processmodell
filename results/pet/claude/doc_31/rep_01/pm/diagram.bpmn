<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_employee_part" name="Employee" processRef="pool_employee_proc" />
    <bpmn:participant id="pool_supervisor_part" name="Immediate Supervisor" processRef="pool_supervisor_proc" />
    <bpmn:participant id="pool_hr_part" name="Human Resources Representative" processRef="pool_hr_proc" />
    <bpmn:messageFlow id="msg_flow_submit" sourceRef="start_submit" targetRef="msg_start_supervisor" name="Vacation Request Submitted" />
    <bpmn:messageFlow id="msg_flow_rejection" sourceRef="end_rejected_notify" targetRef="task_review_rejection" name="Rejection Notification" />
    <bpmn:messageFlow id="msg_flow_approval" sourceRef="end_approved_notify" targetRef="msg_start_hr" name="Approval Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_employee_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request_p1" name="Vacation Request Form" dataObjectRef="data_vacation_request_p1_do" />
    <bpmn:dataObject id="data_vacation_request_p1_do" />
    <bpmn:startEvent id="start_submit" name="Employee submits vacation request">
      <bpmn:outgoing>flow_employee_start_to_submit_end</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_reviewed" name="Rejection reasons reviewed">
    </bpmn:endEvent>
    <bpmn:userTask id="task_review_rejection" name="Review Rejection Reasons">
      <bpmn:incoming>flow_employee_start_to_submit_end</bpmn:incoming>
      <bpmn:property id="task_review_rejection_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_rejection_dia0">
        <bpmn:sourceRef>data_vacation_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_rejection_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_employee_start_to_submit_end" sourceRef="start_submit" targetRef="task_review_rejection" />
  </bpmn:process>
  <bpmn:process id="pool_supervisor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request" name="Vacation Request Form" dataObjectRef="data_vacation_request_do" />
    <bpmn:dataObject id="data_vacation_request_do" />
    <bpmn:startEvent id="msg_start_supervisor" name="Request received by supervisor">
      <bpmn:outgoing>flow_start_to_supervisor_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_supervisor_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_rejected_notify" name="Rejection notified to employee">
      <bpmn:incoming>flow_gw_rejected</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_rejected_notify_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_approved_notify" name="Approval notified to HR">
      <bpmn:incoming>flow_gw_approved</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_approved_notify_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_approve_reject" name="Approve or Reject Vacation Request">
      <bpmn:incoming>flow_start_to_supervisor_task</bpmn:incoming>
      <bpmn:outgoing>flow_task_to_gw</bpmn:outgoing>
      <bpmn:property id="task_approve_reject_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_approve_reject_dia0">
        <bpmn:sourceRef>data_vacation_request</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_reject_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_approve_reject_doa0">
        <bpmn:targetRef>data_vacation_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decision" name="Request Approved?" isMarkerVisible="true">
      <bpmn:incoming>flow_task_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_gw_rejected</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_supervisor_task" sourceRef="msg_start_supervisor" targetRef="task_approve_reject" />
    <bpmn:sequenceFlow id="flow_task_to_gw" sourceRef="task_approve_reject" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_gw_rejected" sourceRef="gw_decision" targetRef="end_rejected_notify" name="Rejected" />
    <bpmn:sequenceFlow id="flow_gw_approved" sourceRef="gw_decision" targetRef="end_approved_notify" name="Approved" />
  </bpmn:process>
  <bpmn:process id="pool_hr_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request_p2" name="Vacation Request Form" dataObjectRef="data_vacation_request_p2_do" />
    <bpmn:dataObject id="data_vacation_request_p2_do" />
    <bpmn:startEvent id="msg_start_hr" name="HR receives approval notification">
      <bpmn:outgoing>flow_hr_start_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_hr_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_management_complete" name="Management procedures completed">
      <bpmn:incoming>flow_hr_task_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_complete_management" name="Complete Management Procedures">
      <bpmn:incoming>flow_hr_start_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_hr_task_to_end</bpmn:outgoing>
      <bpmn:property id="task_complete_management_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_complete_management_dia0">
        <bpmn:sourceRef>data_vacation_request_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_complete_management_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_hr_start_to_task" sourceRef="msg_start_hr" targetRef="task_complete_management" />
    <bpmn:sequenceFlow id="flow_hr_task_to_end" sourceRef="task_complete_management" targetRef="end_management_complete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_employee_part_di" bpmnElement="pool_employee_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="700" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_supervisor_part_di" bpmnElement="pool_supervisor_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="950" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_hr_part_di" bpmnElement="pool_hr_part" isHorizontal="true">
        <dc:Bounds x="120" y="960" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_approved_notify_di" bpmnElement="end_approved_notify">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_management_complete_di" bpmnElement="end_management_complete">
        <dc:Bounds x="540" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_rejected_notify_di" bpmnElement="end_rejected_notify">
        <dc:Bounds x="730" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reviewed_di" bpmnElement="end_reviewed">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_di" bpmnElement="gw_decision">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_start_hr_di" bpmnElement="msg_start_hr">
        <dc:Bounds x="160" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_start_supervisor_di" bpmnElement="msg_start_supervisor">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_submit_di" bpmnElement="start_submit">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_reject_di" bpmnElement="task_approve_reject">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_complete_management_di" bpmnElement="task_complete_management">
        <dc:Bounds x="350" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_rejection_di" bpmnElement="task_review_rejection">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_p1_di" bpmnElement="data_vacation_request_p1">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_di" bpmnElement="data_vacation_request">
        <dc:Bounds x="370" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_p2_di" bpmnElement="data_vacation_request_p2">
        <dc:Bounds x="370" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_supervisor_task_di" bpmnElement="flow_start_to_supervisor_task">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task_to_gw_di" bpmnElement="flow_task_to_gw">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_rejected_di" bpmnElement="flow_gw_rejected">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_approved_di" bpmnElement="flow_gw_approved">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hr_start_to_task_di" bpmnElement="flow_hr_start_to_task">
        <di:waypoint x="178" y="1038" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hr_task_to_end_di" bpmnElement="flow_hr_task_to_end">
        <di:waypoint x="400" y="1060" />
        <di:waypoint x="558" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_employee_start_to_submit_end_di" bpmnElement="flow_employee_start_to_submit_end">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_submit_di" bpmnElement="msg_flow_submit">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_rejection_di" bpmnElement="msg_flow_rejection">
        <di:waypoint x="748" y="703" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_approval_di" bpmnElement="msg_flow_approval">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_approve_reject_dia0_di" bpmnElement="task_approve_reject_dia0">
        <di:waypoint x="388" y="850" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_approve_reject_doa0_di" bpmnElement="task_approve_reject_doa0">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="388" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_review_rejection_dia0_di" bpmnElement="task_review_rejection_dia0">
        <di:waypoint x="388" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_complete_management_dia0_di" bpmnElement="task_complete_management_dia0">
        <di:waypoint x="388" y="1185" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>