<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_employee_part" name="Employee" processRef="pool_employee_proc" />
    <bpmn:participant id="pool_supervisor_part" name="Immediate Supervisor" processRef="pool_supervisor_proc" />
    <bpmn:participant id="pool_hr_part" name="Human Resources Representative" processRef="pool_hr_proc" />
    <bpmn:messageFlow id="mf_1" sourceRef="end_submit_notify" targetRef="start_supervisor_receive" name="Vacation Request" />
    <bpmn:messageFlow id="mf_2" sourceRef="end_rejected_notify" targetRef="start_employee_review" name="Rejection Notification" />
    <bpmn:messageFlow id="mf_3" sourceRef="end_notify_hr" targetRef="start_hr_receive" name="Approval Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_employee_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request" name="Vacation Request Form" dataObjectRef="data_vacation_request_do" />
    <bpmn:dataObject id="data_vacation_request_do" />
    <bpmn:startEvent id="start_1" name="Vacation request submitted">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_submit_notify" name="Vacation request sent to supervisor">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_submit_notify_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_employee_done" name="Request process ended">
      <bpmn:incoming>flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_employee_review" name="Rejection received by employee">
      <bpmn:outgoing>flow_review_start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_employee_review_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit" name="Submit vacation request">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_submit_doa0">
        <bpmn:targetRef>data_vacation_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_review_rejection" name="Review rejection reasons">
      <bpmn:incoming>flow_review_start</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:property id="task_review_rejection_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_rejection_dia0">
        <bpmn:sourceRef>data_vacation_request</bpmn:sourceRef>
        <bpmn:targetRef>task_review_rejection_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_submit" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_submit" targetRef="end_submit_notify" />
    <bpmn:sequenceFlow id="flow_review_start" sourceRef="start_employee_review" targetRef="task_review_rejection" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_review_rejection" targetRef="end_employee_done" />
  </bpmn:process>
  <bpmn:process id="pool_supervisor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request_p1" name="Vacation Request Form" dataObjectRef="data_vacation_request_p1_do" />
    <bpmn:dataObject id="data_vacation_request_p1_do" />
    <bpmn:endEvent id="end_rejected_notify" name="Rejection sent to employee">
      <bpmn:incoming>flow_reject</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_rejected_notify_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_supervisor_receive" name="Request received by supervisor">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_supervisor_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_notify_hr" name="Approval notification sent to HR">
      <bpmn:incoming>flow_approve</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_notify_hr_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_evaluate" name="Approve or reject vacation request">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_evaluate_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_evaluate_dia0">
        <bpmn:sourceRef>data_vacation_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_evaluate_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_evaluate_doa0">
        <bpmn:targetRef>data_vacation_request_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decision" name="Request approved?" isMarkerVisible="true">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_3" sourceRef="start_supervisor_receive" targetRef="task_evaluate" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_evaluate" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_reject" sourceRef="gw_decision" targetRef="end_rejected_notify" name="Rechazada" />
    <bpmn:sequenceFlow id="flow_approve" sourceRef="gw_decision" targetRef="end_notify_hr" name="Aprobada" />
  </bpmn:process>
  <bpmn:process id="pool_hr_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request_p2" name="Vacation Request Form" dataObjectRef="data_vacation_request_p2_do" />
    <bpmn:dataObject id="data_vacation_request_p2_do" />
    <bpmn:dataObjectReference id="data_vacation_record" name="Vacation Management Record" dataObjectRef="data_vacation_record_do" />
    <bpmn:dataObject id="data_vacation_record_do" />
    <bpmn:startEvent id="start_hr_receive" name="Notification received by HR">
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_hr_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_hr_done" name="Management procedures completed">
      <bpmn:incoming>flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_management_procedures" name="Complete vacation management procedures">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:property id="task_management_procedures_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_management_procedures_dia0">
        <bpmn:sourceRef>data_vacation_request_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_management_procedures_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_management_procedures_doa0">
        <bpmn:targetRef>data_vacation_record</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_6" sourceRef="start_hr_receive" targetRef="task_management_procedures" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_management_procedures" targetRef="end_hr_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_employee_part_di" bpmnElement="pool_employee_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_supervisor_part_di" bpmnElement="pool_supervisor_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="950" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_hr_part_di" bpmnElement="pool_hr_part" isHorizontal="true">
        <dc:Bounds x="120" y="960" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_employee_done_di" bpmnElement="end_employee_done">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_hr_done_di" bpmnElement="end_hr_done">
        <dc:Bounds x="540" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_notify_hr_di" bpmnElement="end_notify_hr">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_rejected_notify_di" bpmnElement="end_rejected_notify">
        <dc:Bounds x="730" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_submit_notify_di" bpmnElement="end_submit_notify">
        <dc:Bounds x="540" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_di" bpmnElement="gw_decision">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_employee_review_di" bpmnElement="start_employee_review">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_hr_receive_di" bpmnElement="start_hr_receive">
        <dc:Bounds x="160" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_supervisor_receive_di" bpmnElement="start_supervisor_receive">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_evaluate_di" bpmnElement="task_evaluate">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_management_procedures_di" bpmnElement="task_management_procedures">
        <dc:Bounds x="350" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_rejection_di" bpmnElement="task_review_rejection">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_di" bpmnElement="task_submit">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_di" bpmnElement="data_vacation_request">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_p1_di" bpmnElement="data_vacation_request_p1">
        <dc:Bounds x="370" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_p2_di" bpmnElement="data_vacation_request_p2">
        <dc:Bounds x="370" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_record_di" bpmnElement="data_vacation_record">
        <dc:Bounds x="370" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reject_di" bpmnElement="flow_reject">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_di" bpmnElement="flow_approve">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_start_di" bpmnElement="flow_review_start">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="178" y="1038" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7">
        <di:waypoint x="400" y="1060" />
        <di:waypoint x="558" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_1_di" bpmnElement="mf_1">
        <di:waypoint x="558" y="243" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_2_di" bpmnElement="mf_2">
        <di:waypoint x="748" y="703" />
        <di:waypoint x="178" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_3_di" bpmnElement="mf_3">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_submit_doa0_di" bpmnElement="task_submit_doa0">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="388" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_evaluate_dia0_di" bpmnElement="task_evaluate_dia0">
        <di:waypoint x="388" y="850" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_evaluate_doa0_di" bpmnElement="task_evaluate_doa0">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="388" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_review_rejection_dia0_di" bpmnElement="task_review_rejection_dia0">
        <di:waypoint x="388" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_management_procedures_dia0_di" bpmnElement="task_management_procedures_dia0">
        <di:waypoint x="388" y="1185" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_management_procedures_doa0_di" bpmnElement="task_management_procedures_doa0">
        <di:waypoint x="400" y="1060" />
        <di:waypoint x="388" y="1185" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>