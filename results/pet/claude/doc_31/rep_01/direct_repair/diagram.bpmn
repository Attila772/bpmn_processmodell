<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="VacationRequestProcess" name="Vacations Request" isExecutable="false">

    <laneSet id="LaneSet_1">
      <lane id="Lane_Employee" name="Employee">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_SubmitRequest</flowNodeRef>
        <flowNodeRef>Task_ReviewRejection</flowNodeRef>
        <flowNodeRef>EndEvent_Rejected</flowNodeRef>
      </lane>
      <lane id="Lane_Supervisor" name="Immediate Supervisor">
        <flowNodeRef>Task_ReceiveRequest</flowNodeRef>
        <flowNodeRef>Gateway_Decision</flowNodeRef>
        <flowNodeRef>Task_NotifyHR</flowNodeRef>
      </lane>
      <lane id="Lane_HR" name="Human Resources Representative">
        <flowNodeRef>Task_CompleteManagement</flowNodeRef>
        <flowNodeRef>EndEvent_Approved</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Employee submits vacation request">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_SubmitRequest" name="Submit Vacation Request">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <task id="Task_ReceiveRequest" name="Receive and Review Request">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Decision" name="Approved?">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_Rejected</outgoing>
      <outgoing>Flow_Approved</outgoing>
    </exclusiveGateway>

    <task id="Task_ReviewRejection" name="Review Rejection Reasons">
      <incoming>Flow_Rejected</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <endEvent id="EndEvent_Rejected" name="Request Rejected">
      <incoming>Flow_4</incoming>
    </endEvent>

    <task id="Task_NotifyHR" name="Notify Human Resources Representative">
      <incoming>Flow_Approved</incoming>
      <outgoing>Flow_5</outgoing>
    </task>

    <task id="Task_CompleteManagement" name="Complete Management Procedures">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </task>

    <endEvent id="EndEvent_Approved" name="Request Approved and Processed">
      <incoming>Flow_6</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SubmitRequest"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_ReceiveRequest"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_ReceiveRequest" targetRef="Gateway_Decision"/>
    <sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_Decision" targetRef="Task_ReviewRejection"/>
    <sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Decision" targetRef="Task_NotifyHR"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_ReviewRejection" targetRef="EndEvent_Rejected"/>
    <sequenceFlow id="Flow_5" sourceRef="Task_NotifyHR" targetRef="Task_CompleteManagement"/>
    <sequenceFlow id="Flow_6" sourceRef="Task_CompleteManagement" targetRef="EndEvent_Approved"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="VacationRequestProcess">

      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <omgdc:Bounds x="160" y="40" width="900" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <omgdc:Bounds x="160" y="190" width="900" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HR_di" bpmnElement="Lane_HR" isHorizontal="true">
        <omgdc:Bounds x="160" y="340" width="900" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="200" y="95" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest">
        <omgdc:Bounds x="280" y="75" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveRequest_di" bpmnElement="Task_ReceiveRequest">
        <omgdc:Bounds x="430" y="225" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <omgdc:Bounds x="580" y="240" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewRejection_di" bpmnElement="Task_ReviewRejection">
        <omgdc:Bounds x="680" y="75" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <omgdc:Bounds x="830" y="97" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyHR_di" bpmnElement="Task_NotifyHR">
        <omgdc:Bounds x="680" y="225" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CompleteManagement_di" bpmnElement="Task_CompleteManagement">
        <omgdc:Bounds x="830" y="375" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <omgdc:Bounds x="980" y="397" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="236" y="113"/>
        <omgdi:waypoint x="280" y="115"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="330" y="155"/>
        <omgdi:waypoint x="330" y="265"/>
        <omgdi:waypoint x="430" y="265"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="530" y="265"/>
        <omgdi:waypoint x="580" y="265"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <omgdi:waypoint x="605" y="240"/>
        <omgdi:waypoint x="605" y="115"/>
        <omgdi:waypoint x="680" y="115"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <omgdi:waypoint x="630" y="265"/>
        <omgdi:waypoint x="680" y="265"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="780" y="115"/>
        <omgdi:waypoint x="830" y="115"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="730" y="305"/>
        <omgdi:waypoint x="730" y="415"/>
        <omgdi:waypoint x="830" y="415"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="930" y="415"/>
        <omgdi:waypoint x="980" y="415"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
