<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_MPON" name="MPON" processRef="Process_MPON" />
    <participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO" />

    <messageFlow id="MessageFlow_1" name="Device takeover bid request" sourceRef="Task_MPON_RequestBid" targetRef="Task_MPOO_SendTender" />
    <messageFlow id="MessageFlow_2" name="Tender for equipment takeover" sourceRef="Task_MPOO_SendTender" targetRef="Task_MPON_PlaceOrder" />
    <messageFlow id="MessageFlow_3" name="Order" sourceRef="Task_MPON_PlaceOrder" targetRef="Task_MPOO_ConfirmOrder" />
    <messageFlow id="MessageFlow_4" name="Order confirmation and master data" sourceRef="Task_MPOO_ConfirmOrder" targetRef="Task_MPON_ReceiveConfirmation" />
  </collaboration>

  <process id="Process_MPON" name="MPON" isExecutable="false">
    <startEvent id="StartEvent_MPON" name="Start" />

    <task id="Task_MPON_RequestBid" name="Request device takeover bid" />
    <task id="Task_MPON_PlaceOrder" name="Place order" />
    <task id="Task_MPON_ReceiveConfirmation" name="Receive order confirmation and master data" />

    <endEvent id="EndEvent_MPON" name="End" />

    <sequenceFlow id="Flow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_MPON_RequestBid" />
    <sequenceFlow id="Flow_MPON_2" sourceRef="Task_MPON_RequestBid" targetRef="Task_MPON_PlaceOrder" />
    <sequenceFlow id="Flow_MPON_3" sourceRef="Task_MPON_PlaceOrder" targetRef="Task_MPON_ReceiveConfirmation" />
    <sequenceFlow id="Flow_MPON_4" sourceRef="Task_MPON_ReceiveConfirmation" targetRef="EndEvent_MPON" />
  </process>

  <process id="Process_MPOO" name="MPOO" isExecutable="false">
    <startEvent id="StartEvent_MPOO" name="Start" />

    <task id="Task_MPOO_SendTender" name="Send tender for equipment takeover" />
    <task id="Task_MPOO_ConfirmOrder" name="Confirm order and send master data" />

    <endEvent id="EndEvent_MPOO" name="End" />

    <sequenceFlow id="Flow_MPOO_1" sourceRef="StartEvent_MPOO" targetRef="Task_MPOO_SendTender" />
    <sequenceFlow id="Flow_MPOO_2" sourceRef="Task_MPOO_SendTender" targetRef="Task_MPOO_ConfirmOrder" />
    <sequenceFlow id="Flow_MPOO_3" sourceRef="Task_MPOO_ConfirmOrder" targetRef="EndEvent_MPOO" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_MPON_di" bpmnElement="Participant_MPON" isHorizontal="true">
        <omgdc:Bounds x="160" y="60" width="760" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MPON_di" bpmnElement="StartEvent_MPON">
        <omgdc:Bounds x="200" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_RequestBid_di" bpmnElement="Task_MPON_RequestBid">
        <omgdc:Bounds x="280" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_PlaceOrder_di" bpmnElement="Task_MPON_PlaceOrder">
        <omgdc:Bounds x="460" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_ReceiveConfirmation_di" bpmnElement="Task_MPON_ReceiveConfirmation">
        <omgdc:Bounds x="640" y="90" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MPON_di" bpmnElement="EndEvent_MPON">
        <omgdc:Bounds x="840" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_MPON_1_di" bpmnElement="Flow_MPON_1">
        <omgdi:waypoint x="236" y="130" />
        <omgdi:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPON_2_di" bpmnElement="Flow_MPON_2">
        <omgdi:waypoint x="400" y="130" />
        <omgdi:waypoint x="460" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPON_3_di" bpmnElement="Flow_MPON_3">
        <omgdi:waypoint x="580" y="130" />
        <omgdi:waypoint x="640" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPON_4_di" bpmnElement="Flow_MPON_4">
        <omgdi:waypoint x="780" y="130" />
        <omgdi:waypoint x="840" y="130" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_MPOO_di" bpmnElement="Participant_MPOO" isHorizontal="true">
        <omgdc:Bounds x="160" y="280" width="760" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MPOO_di" bpmnElement="StartEvent_MPOO">
        <omgdc:Bounds x="200" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPOO_SendTender_di" bpmnElement="Task_MPOO_SendTender">
        <omgdc:Bounds x="280" y="310" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPOO_ConfirmOrder_di" bpmnElement="Task_MPOO_ConfirmOrder">
        <omgdc:Bounds x="500" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MPOO_di" bpmnElement="EndEvent_MPOO">
        <omgdc:Bounds x="720" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_MPOO_1_di" bpmnElement="Flow_MPOO_1">
        <omgdi:waypoint x="236" y="350" />
        <omgdi:waypoint x="280" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_2_di" bpmnElement="Flow_MPOO_2">
        <omgdi:waypoint x="420" y="350" />
        <omgdi:waypoint x="500" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_3_di" bpmnElement="Flow_MPOO_3">
        <omgdi:waypoint x="660" y="350" />
        <omgdi:waypoint x="720" y="350" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <omgdi:waypoint x="340" y="170" />
        <omgdi:waypoint x="340" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <omgdi:waypoint x="420" y="310" />
        <omgdi:waypoint x="500" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_3_di" bpmnElement="MessageFlow_3">
        <omgdi:waypoint x="520" y="170" />
        <omgdi:waypoint x="560" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_4_di" bpmnElement="MessageFlow_4">
        <omgdi:waypoint x="600" y="310" />
        <omgdi:waypoint x="700" y="170" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
