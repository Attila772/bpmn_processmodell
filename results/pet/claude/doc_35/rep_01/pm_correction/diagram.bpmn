<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="evt_send_request" targetRef="evt_receive_request" name="Übernahmeangebot-Anfrage" />
    <bpmn:messageFlow id="mf2" sourceRef="evt_send_tender" targetRef="evt_receive_tender" name="Angebot" />
    <bpmn:messageFlow id="mf3" sourceRef="evt_send_order" targetRef="evt_receive_order" name="Bestellung" />
    <bpmn:messageFlow id="mf4" sourceRef="task_confirm_order_send_masterdata" targetRef="evt_receive_confirmation" name="Bestellbestätigung und Stammdaten" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_tender_p1" name="Angebot zur Geräteübernahme" dataObjectRef="doc_tender_p1_do" />
    <bpmn:dataObject id="doc_tender_p1_do" />
    <bpmn:dataObjectReference id="doc_order" name="Bestellung" dataObjectRef="doc_order_do" />
    <bpmn:dataObject id="doc_order_do" />
    <bpmn:startEvent id="start_mpon" name="Prozessstart">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_send_request" name="Übernahmeangebot-Anfrage gesendet">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_request_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_receive_tender" name="Angebot empfangen">
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_tender_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="evt_send_order" name="Bestellung gesendet">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_order_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_receive_confirmation" name="Bestellbestätigung und Stammdaten empfangen">
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_confirmation_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_mpon" name="Prozessende MPON">
      <bpmn:incoming>sf9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_request_bid" name="Geräteübernahmeangebot anfordern">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_place_order" name="Bestellung bei MPOO aufgeben">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="task_place_order_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_place_order_dia0">
        <bpmn:sourceRef>doc_tender_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_place_order_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_place_order_doa0">
        <bpmn:targetRef>doc_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_mpon" targetRef="task_request_bid" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task_request_bid" targetRef="evt_send_request" />
    <bpmn:sequenceFlow id="sf5" sourceRef="evt_receive_tender" targetRef="task_place_order" />
    <bpmn:sequenceFlow id="sf6" sourceRef="task_place_order" targetRef="evt_send_order" />
    <bpmn:sequenceFlow id="sf9" sourceRef="evt_receive_confirmation" targetRef="end_mpon" />
  </bpmn:process>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_tender" name="Angebot zur Geräteübernahme" dataObjectRef="doc_tender_do" />
    <bpmn:dataObject id="doc_tender_do" />
    <bpmn:dataObjectReference id="doc_order_p1" name="Bestellung" dataObjectRef="doc_order_p1_do" />
    <bpmn:dataObject id="doc_order_p1_do" />
    <bpmn:dataObjectReference id="doc_order_confirmation" name="Bestellbestätigung" dataObjectRef="doc_order_confirmation_do" />
    <bpmn:dataObject id="doc_order_confirmation_do" />
    <bpmn:dataObjectReference id="doc_masterdata" name="Stammdaten" dataObjectRef="doc_masterdata_do" />
    <bpmn:dataObject id="doc_masterdata_do" />
    <bpmn:startEvent id="evt_receive_request" name="Übernahmeangebot angefragt">
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_request_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_send_tender" name="Angebot gesendet">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_tender_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_receive_order" name="Bestellung empfangen">
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_order_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_mpoo" name="Prozessende MPOO">
      <bpmn:incoming>sf8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_send_tender" name="Angebot zur Geräteübernahme senden">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_tender_doa0">
        <bpmn:targetRef>doc_tender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_confirm_order_send_masterdata" name="Bestellung bestätigen und Stammdaten senden">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:property id="task_confirm_order_send_masterdata_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_confirm_order_send_masterdata_dia0">
        <bpmn:sourceRef>doc_order_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_confirm_order_send_masterdata_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_confirm_order_send_masterdata_doa0">
        <bpmn:targetRef>doc_order_confirmation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_confirm_order_send_masterdata_doa1">
        <bpmn:targetRef>doc_masterdata</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf3" sourceRef="evt_receive_request" targetRef="task_send_tender" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task_send_tender" targetRef="evt_send_tender" />
    <bpmn:sequenceFlow id="sf7" sourceRef="evt_receive_order" targetRef="task_confirm_order_send_masterdata" />
    <bpmn:sequenceFlow id="sf8" sourceRef="task_confirm_order_send_masterdata" targetRef="end_mpoo" />
  </bpmn:process>
