<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_send_request" targetRef="start_receive_request" name="Takeover Bid Request" />
    <bpmn:messageFlow id="mf2" sourceRef="end_send_tender" targetRef="start_receive_tender" name="Tender" />
    <bpmn:messageFlow id="mf3" sourceRef="end_send_order" targetRef="start_receive_order" name="Order" />
    <bpmn:messageFlow id="mf4" sourceRef="end_send_confirmation" targetRef="start_receive_confirmation" name="Order Confirmation and Master Data" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_bid_request" name="Device Takeover Bid Request" dataObjectRef="data_bid_request_do" />
    <bpmn:dataObject id="data_bid_request_do" />
    <bpmn:dataObjectReference id="data_tender_p1" name="Tender for Equipment Takeover" dataObjectRef="data_tender_p1_do" />
    <bpmn:dataObject id="data_tender_p1_do" />
    <bpmn:dataObjectReference id="data_order" name="Order" dataObjectRef="data_order_do" />
    <bpmn:dataObject id="data_order_do" />
    <bpmn:startEvent id="start_mpon" name="Process Start">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_request" name="Takeover Bid Request Sent">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="start_receive_tender" name="Tender Received">
      <bpmn:outgoing>flow5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_tender_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_send_order" name="Order Sent">
      <bpmn:incoming>flow6</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_order_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="start_receive_confirmation" name="Order Confirmation Received">
      <bpmn:outgoing>flow9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_confirmation_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_mpon" name="Process End">
      <bpmn:incoming>flow9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_request_bid" name="Request device takeover bid">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_request_bid_doa0">
        <bpmn:targetRef>data_bid_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_place_order" name="Place order">
      <bpmn:incoming>flow5</bpmn:incoming>
      <bpmn:outgoing>flow6</bpmn:outgoing>
      <bpmn:property id="task_place_order_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_place_order_dia0">
        <bpmn:sourceRef>data_tender_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_place_order_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_place_order_doa0">
        <bpmn:targetRef>data_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow1" sourceRef="start_mpon" targetRef="task_request_bid" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task_request_bid" targetRef="end_send_request" />
    <bpmn:sequenceFlow id="flow5" sourceRef="start_receive_tender" targetRef="task_place_order" />
    <bpmn:sequenceFlow id="flow6" sourceRef="task_place_order" targetRef="end_send_order" />
    <bpmn:sequenceFlow id="flow9" sourceRef="start_receive_confirmation" targetRef="end_mpon" />
  </bpmn:process>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_bid_request_p1" name="Device Takeover Bid Request" dataObjectRef="data_bid_request_p1_do" />
    <bpmn:dataObject id="data_bid_request_p1_do" />
    <bpmn:dataObjectReference id="data_tender" name="Tender for Equipment Takeover" dataObjectRef="data_tender_do" />
    <bpmn:dataObject id="data_tender_do" />
    <bpmn:dataObjectReference id="data_order_p1" name="Order" dataObjectRef="data_order_p1_do" />
    <bpmn:dataObject id="data_order_p1_do" />
    <bpmn:dataObjectReference id="data_order_confirmation" name="Order Confirmation" dataObjectRef="data_order_confirmation_do" />
    <bpmn:dataObject id="data_order_confirmation_do" />
    <bpmn:dataObjectReference id="data_master_data" name="Master Data" dataObjectRef="data_master_data_do" />
    <bpmn:dataObject id="data_master_data_do" />
    <bpmn:startEvent id="start_receive_request" name="Takeover Bid Request Received">
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_request_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_tender" name="Tender Sent">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_tender_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_receive_order" name="Order Received">
      <bpmn:outgoing>flow7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_order_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_confirmation" name="Order Confirmation and Master Data Sent">
      <bpmn:incoming>flow8</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_confirmation_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_send_tender" name="Send tender for equipment takeover">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
      <bpmn:property id="task_send_tender_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_tender_dia0">
        <bpmn:sourceRef>data_bid_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_send_tender_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_send_tender_doa0">
        <bpmn:targetRef>data_tender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_confirm_order" name="Confirm order and send master data">
      <bpmn:incoming>flow7</bpmn:incoming>
      <bpmn:outgoing>flow8</bpmn:outgoing>
      <bpmn:property id="task_confirm_order_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_confirm_order_dia0">
        <bpmn:sourceRef>data_order_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_confirm_order_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_confirm_order_doa0">
        <bpmn:targetRef>data_order_confirmation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_confirm_order_doa1">
        <bpmn:targetRef>data_master_data</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow3" sourceRef="start_receive_request" targetRef="task_send_tender" />
    <bpmn:sequenceFlow id="flow4" sourceRef="task_send_tender" targetRef="end_send_tender" />
    <bpmn:sequenceFlow id="flow7" sourceRef="start_receive_order" targetRef="task_confirm_order" />
    <bpmn:sequenceFlow id="flow8" sourceRef="task_confirm_order" targetRef="end_send_confirmation" />
  </bpmn:process>
