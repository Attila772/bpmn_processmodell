<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_MPON" name="MPON" processRef="Process_MPON" />
    <participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO" />

    <messageFlow id="MessageFlow_1" name="Device takeover bid request"
                 sourceRef="SendTask_RequestBid" targetRef="ReceiveTask_RequestBid" />
    <messageFlow id="MessageFlow_2" name="Tender for equipment takeover"
                 sourceRef="SendTask_SendTender" targetRef="ReceiveTask_ReceiveTender" />
    <messageFlow id="MessageFlow_3" name="Order"
                 sourceRef="SendTask_PlaceOrder" targetRef="ReceiveTask_ReceiveOrder" />
    <messageFlow id="MessageFlow_4" name="Order confirmation and master data"
                 sourceRef="SendTask_ConfirmOrder" targetRef="ReceiveTask_ReceiveConfirmation" />
  </collaboration>

  <process id="Process_MPON" name="MPON" isExecutable="false">
    <startEvent id="StartEvent_MPON" name="Start" />

    <sendTask id="SendTask_RequestBid" name="Request device takeover bid" />

    <receiveTask id="ReceiveTask_ReceiveTender" name="Receive tender for equipment takeover" />

    <sendTask id="SendTask_PlaceOrder" name="Place order at MPOO" />

    <receiveTask id="ReceiveTask_ReceiveConfirmation" name="Receive order confirmation and master data" />

    <endEvent id="EndEvent_MPON" name="End" />

    <sequenceFlow id="Flow_MPON_1" sourceRef="StartEvent_MPON" targetRef="SendTask_RequestBid" />
    <sequenceFlow id="Flow_MPON_2" sourceRef="SendTask_RequestBid" targetRef="ReceiveTask_ReceiveTender" />
    <sequenceFlow id="Flow_MPON_3" sourceRef="ReceiveTask_ReceiveTender" targetRef="SendTask_PlaceOrder" />
    <sequenceFlow id="Flow_MPON_4" sourceRef="SendTask_PlaceOrder" targetRef="ReceiveTask_ReceiveConfirmation" />
    <sequenceFlow id="Flow_MPON_5" sourceRef="ReceiveTask_ReceiveConfirmation" targetRef="EndEvent_MPON" />
  </process>

  <process id="Process_MPOO" name="MPOO" isExecutable="false">
    <receiveTask id="ReceiveTask_RequestBid" name="Receive device takeover bid request" />

    <sendTask id="SendTask_SendTender" name="Send tender for equipment takeover" />

    <receiveTask id="ReceiveTask_ReceiveOrder" name="Receive order from MPON" />

    <sendTask id="SendTask_ConfirmOrder" name="Confirm order and send master data" />

    <endEvent id="EndEvent_MPOO" name="End" />

    <sequenceFlow id="Flow_MPOO_1" sourceRef="ReceiveTask_RequestBid" targetRef="SendTask_SendTender" />
    <sequenceFlow id="Flow_MPOO_2" sourceRef="SendTask_SendTender" targetRef="ReceiveTask_ReceiveOrder" />
    <sequenceFlow id="Flow_MPOO_3" sourceRef="ReceiveTask_ReceiveOrder" targetRef="SendTask_ConfirmOrder" />
    <sequenceFlow id="Flow_MPOO_4" sourceRef="SendTask_ConfirmOrder" targetRef="EndEvent_MPOO" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_MPON_di" bpmnElement="Participant_MPON" isHorizontal="true">
        <omgdc:Bounds x="100" y="60" width="900" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MPON_di" bpmnElement="StartEvent_MPON">
        <omgdc:Bounds x="150" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SendTask_RequestBid_di" bpmnElement="SendTask_RequestBid">
        <omgdc:Bounds x="230" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ReceiveTask_ReceiveTender_di" bpmnElement="ReceiveTask_ReceiveTender">
        <omgdc:Bounds x="400" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SendTask_PlaceOrder_di" bpmnElement="SendTask_PlaceOrder">
        <omgdc:Bounds x="570" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ReceiveTask_ReceiveConfirmation_di" bpmnElement="ReceiveTask_ReceiveConfirmation">
        <omgdc:Bounds x="740" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MPON_di" bpmnElement="EndEvent_MPON">
        <omgdc:Bounds x="910" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Participant_MPOO_di" bpmnElement="Participant_MPOO" isHorizontal="true">
        <omgdc:Bounds x="100" y="320" width="900" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ReceiveTask_RequestBid_di" bpmnElement="ReceiveTask_RequestBid">
        <omgdc:Bounds x="230" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SendTask_SendTender_di" bpmnElement="SendTask_SendTender">
        <omgdc:Bounds x="400" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ReceiveTask_ReceiveOrder_di" bpmnElement="ReceiveTask_ReceiveOrder">
        <omgdc:Bounds x="570" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SendTask_ConfirmOrder_di" bpmnElement="SendTask_ConfirmOrder">
        <omgdc:Bounds x="740" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MPOO_di" bpmnElement="EndEvent_MPOO">
        <omgdc:Bounds x="910" y="400" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_MPON_1_di" bpmnElement="Flow_MPON_1">
        <omgdi:waypoint x="186" y="158" />
        <omgdi:waypoint x="230" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPON_2_di" bpmnElement="Flow_MPON_2">
        <omgdi:waypoint x="350" y="160" />
        <omgdi:waypoint x="400" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPON_3_di" bpmnElement="Flow_MPON_3">
        <omgdi:waypoint x="520" y="160" />
        <omgdi:waypoint x="570" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPON_4_di" bpmnElement="Flow_MPON_4">
        <omgdi:waypoint x="690" y="160" />
        <omgdi:waypoint x="740" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPON_5_di" bpmnElement="Flow_MPON_5">
        <omgdi:waypoint x="860" y="160" />
        <omgdi:waypoint x="910" y="158" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPOO_1_di" bpmnElement="Flow_MPOO_1">
        <omgdi:waypoint x="350" y="420" />
        <omgdi:waypoint x="400" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPOO_2_di" bpmnElement="Flow_MPOO_2">
        <omgdi:waypoint x="520" y="420" />
        <omgdi:waypoint x="570" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPOO_3_di" bpmnElement="Flow_MPOO_3">
        <omgdi:waypoint x="690" y="420" />
        <omgdi:waypoint x="740" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPOO_4_di" bpmnElement="Flow_MPOO_4">
        <omgdi:waypoint x="860" y="420" />
        <omgdi:waypoint x="910" y="418" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <omgdi:waypoint x="290" y="200" />
        <omgdi:waypoint x="290" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <omgdi:waypoint x="460" y="380" />
        <omgdi:waypoint x="460" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_3_di" bpmnElement="MessageFlow_3">
        <omgdi:waypoint x="630" y="200" />
        <omgdi:waypoint x="630" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_4_di" bpmnElement="MessageFlow_4">
        <omgdi:waypoint x="800" y="380" />
        <omgdi:waypoint x="800" y="200" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
