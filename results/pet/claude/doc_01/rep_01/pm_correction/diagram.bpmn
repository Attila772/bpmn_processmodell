<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_ec_part" name="EC" processRef="pool_ec_proc" />
    <bpmn:participant id="pool_inq_part" name="INQ" processRef="pool_inq_proc" />
    <bpmn:participant id="pool_ip_part" name="IP" processRef="pool_ip_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_ec_notify" targetRef="start_inq_receive" name="Master data change notification" />
    <bpmn:messageFlow id="mf2" sourceRef="end_inq_notify" targetRef="start_ip_receive" name="Change notification to IP" />
    <bpmn:messageFlow id="mf3" sourceRef="end_ip_confirm" targetRef="start_inq_result" name="Decision notification" />
    <bpmn:messageFlow id="mf4" sourceRef="end_ip_reject" targetRef="start_inq_result" name="Decision notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_ec_proc" isExecutable="false">
    <bpmn:startEvent id="start_ec" name="Change of master data occurs">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_ec_notify" name="Change notified to INQ">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_ec_notify_msgdef" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_ec" targetRef="end_ec_notify" />
  </bpmn:process>
  <bpmn:process id="pool_inq_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_master_data_change" name="Master data change information" dataObjectRef="data_master_data_change_do" />
    <bpmn:dataObject id="data_master_data_change_do" />
    <bpmn:startEvent id="start_inq_receive" name="Change notification received">
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_inq_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_inq_notify" name="Change notified to IP">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_inq_notify_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_inq_result" name="Decision received from IP">
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_inq_result_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_inq_result" name="Process finished">
      <bpmn:incoming>sf4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_inq_notify" name="Notify IP of the change">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:property id="task_inq_notify_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inq_notify_dia0">
        <bpmn:sourceRef>data_master_data_change</bpmn:sourceRef>
        <bpmn:targetRef>task_inq_notify_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_inq_notify_doa0">
        <bpmn:targetRef>data_master_data_change</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf2" sourceRef="start_inq_receive" targetRef="task_inq_notify" />
    <bpmn:sequenceFlow id="sf3" sourceRef="task_inq_notify" targetRef="end_inq_notify" />
    <bpmn:sequenceFlow id="sf4" sourceRef="start_inq_result" targetRef="end_inq_result" />
  </bpmn:process>
  <bpmn:process id="pool_ip_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_master_data_change_p1" name="Master data change information" dataObjectRef="data_master_data_change_p1_do" />
    <bpmn:dataObject id="data_master_data_change_p1_do" />
    <bpmn:dataObjectReference id="data_decision" name="Confirmation/Rejection decision" dataObjectRef="data_decision_do" />
    <bpmn:dataObject id="data_decision_do" />
    <bpmn:startEvent id="start_ip_receive" name="Change notification received">
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_ip_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_ip_confirm" name="Confirmation sent">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_ip_confirm_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_ip_reject" name="Rejection sent">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_ip_reject_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_ip_check" name="Check whether master data can be changed at desired time">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="task_ip_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_ip_check_dia0">
        <bpmn:sourceRef>data_master_data_change_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_ip_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_ip_confirm" name="Confirm the changes of the INQ">
      <bpmn:incoming>flow_gw_confirm</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_ip_confirm_doa0">
        <bpmn:targetRef>data_decision</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_ip_reject" name="Reject the changes of the INQ">
      <bpmn:incoming>flow_gw_reject</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_ip_reject_doa0">
        <bpmn:targetRef>data_decision</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_ip_decision" name="Can master data be changed at desired time?" isMarkerVisible="true">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>flow_gw_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf5" sourceRef="start_ip_receive" targetRef="task_ip_check" />
    <bpmn:sequenceFlow id="sf6" sourceRef="task_ip_check" targetRef="gw_ip_decision" />
    <bpmn:sequenceFlow id="flow_gw_confirm" sourceRef="gw_ip_decision" targetRef="task_ip_confirm" name="confirmed" />
    <bpmn:sequenceFlow id="flow_gw_reject" sourceRef="gw_ip_decision" targetRef="task_ip_reject" name="rejected" />
    <bpmn:sequenceFlow id="sf7" sourceRef="task_ip_confirm" targetRef="end_ip_confirm" />
    <bpmn:sequenceFlow id="sf8" sourceRef="task_ip_reject" targetRef="end_ip_reject" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_ec_part_di" bpmnElement="pool_ec_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="700" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_inq_part_di" bpmnElement="pool_inq_part" isHorizontal="true">
        <dc:Bounds x="120" y="375" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_ip_part_di" bpmnElement="pool_ip_part" isHorizontal="true">
        <dc:Bounds x="120" y="835" width="1140" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ec_notify_di" bpmnElement="end_ec_notify">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_inq_notify_di" bpmnElement="end_inq_notify">
        <dc:Bounds x="540" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_inq_result_di" bpmnElement="end_inq_result">
        <dc:Bounds x="350" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ip_confirm_di" bpmnElement="end_ip_confirm">
        <dc:Bounds x="920" y="895" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ip_reject_di" bpmnElement="end_ip_reject">
        <dc:Bounds x="920" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ip_decision_di" bpmnElement="gw_ip_decision">
        <dc:Bounds x="540" y="895" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_ec_di" bpmnElement="start_ec">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_inq_receive_di" bpmnElement="start_inq_receive">
        <dc:Bounds x="160" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_inq_result_di" bpmnElement="start_inq_result">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_ip_receive_di" bpmnElement="start_ip_receive">
        <dc:Bounds x="160" y="895" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inq_notify_di" bpmnElement="task_inq_notify">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ip_check_di" bpmnElement="task_ip_check">
        <dc:Bounds x="350" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ip_confirm_di" bpmnElement="task_ip_confirm">
        <dc:Bounds x="730" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ip_reject_di" bpmnElement="task_ip_reject">
        <dc:Bounds x="730" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_master_data_change_di" bpmnElement="data_master_data_change">
        <dc:Bounds x="370" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_master_data_change_p1_di" bpmnElement="data_master_data_change_p1">
        <dc:Bounds x="370" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_decision_di" bpmnElement="data_decision">
        <dc:Bounds x="750" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="178" y="453" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="558" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf4_di" bpmnElement="sf4">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="368" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf5_di" bpmnElement="sf5">
        <di:waypoint x="178" y="913" />
        <di:waypoint x="400" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf6_di" bpmnElement="sf6">
        <di:waypoint x="400" y="935" />
        <di:waypoint x="565" y="920" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_confirm_di" bpmnElement="flow_gw_confirm">
        <di:waypoint x="565" y="920" />
        <di:waypoint x="780" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_reject_di" bpmnElement="flow_gw_reject">
        <di:waypoint x="565" y="920" />
        <di:waypoint x="780" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf7_di" bpmnElement="sf7">
        <di:waypoint x="780" y="935" />
        <di:waypoint x="938" y="913" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf8_di" bpmnElement="sf8">
        <di:waypoint x="780" y="1060" />
        <di:waypoint x="938" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_di" bpmnElement="mf1">
        <di:waypoint x="368" y="118" />
        <di:waypoint x="178" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_di" bpmnElement="mf2">
        <di:waypoint x="558" y="453" />
        <di:waypoint x="178" y="913" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf3_di" bpmnElement="mf3">
        <di:waypoint x="938" y="913" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf4_di" bpmnElement="mf4">
        <di:waypoint x="938" y="1038" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_inq_notify_dia0_di" bpmnElement="task_inq_notify_dia0">
        <di:waypoint x="388" y="725" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_inq_notify_doa0_di" bpmnElement="task_inq_notify_doa0">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="388" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_ip_check_dia0_di" bpmnElement="task_ip_check_dia0">
        <di:waypoint x="388" y="1185" />
        <di:waypoint x="400" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_ip_confirm_doa0_di" bpmnElement="task_ip_confirm_doa0">
        <di:waypoint x="780" y="935" />
        <di:waypoint x="768" y="1185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_ip_reject_doa0_di" bpmnElement="task_ip_reject_doa0">
        <di:waypoint x="780" y="1060" />
        <di:waypoint x="768" y="1185" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>