{
  "name": "Master Data Change Notification Process",
  "resources": [
    {
      "name": "EC",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "INQ",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "IP",
      "capacity": 1,
      "resource_type": "human"
    }
  ],
  "events": [
    {
      "id": "start_ec",
      "name": "Master data change decided",
      "event_position": "start",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "end_ec_notify",
      "name": "Change communicated to INQ",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Master data change notification"
    },
    {
      "id": "start_inq_receive",
      "name": "Change notification received",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Master data change notification"
    },
    {
      "id": "end_inq_notify",
      "name": "Change notified to IP",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Change notification"
    },
    {
      "id": "start_inq_result",
      "name": "Decision received from IP",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Decision notification"
    },
    {
      "id": "end_inq_final",
      "name": "Process completed",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "start_ip_receive",
      "name": "Change notification received",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Change notification"
    },
    {
      "id": "end_ip_confirm",
      "name": "Confirmation sent",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Decision notification"
    },
    {
      "id": "end_ip_reject",
      "name": "Rejection sent",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Decision notification"
    }
  ],
  "tasks": [
    {
      "id": "task_inq_notify_ip",
      "name": "Notify IP of the change",
      "bpmn_type": "bpmn:Task",
      "resource_name": null,
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [
        "data_master_data_change"
      ],
      "output_data_ids": [
        "data_master_data_change"
      ]
    },
    {
      "id": "task_ip_check",
      "name": "Check whether master data can be changed at desired time",
      "bpmn_type": "bpmn:Task",
      "resource_name": null,
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [
        "data_master_data_change"
      ],
      "output_data_ids": []
    },
    {
      "id": "task_ip_confirm",
      "name": "Confirm the changes of the INQ",
      "bpmn_type": "bpmn:Task",
      "resource_name": null,
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [],
      "output_data_ids": [
        "data_decision"
      ]
    },
    {
      "id": "task_ip_reject",
      "name": "Reject the changes of the INQ",
      "bpmn_type": "bpmn:Task",
      "resource_name": null,
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [],
      "output_data_ids": [
        "data_decision"
      ]
    }
  ],
  "gateways": [
    {
      "id": "gateway_ip_decision",
      "name": "Changeable at desired time?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_decision_confirm",
          "condition": "yes"
        },
        {
          "flow_id": "flow_decision_reject",
          "condition": "no"
        }
      ]
    }
  ],
  "sequence_flows": [
    {
      "id": "flow_ec_start_end",
      "source_id": "start_ec",
      "target_id": "end_ec_notify",
      "condition_name": null
