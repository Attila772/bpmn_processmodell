    {
      "id": "flow_inq_task_end",
      "source_id": "task_inq_notify_ip",
      "target_id": "end_inq_notify",
      "condition_name": null
    },
    {
      "id": "flow_inq_result_end",
      "source_id": "start_inq_result",
      "target_id": "end_inq_final",
      "condition_name": null
    },
    {
      "id": "flow_ip_start_task",
      "source_id": "start_ip_receive",
      "target_id": "task_ip_check",
      "condition_name": null
    },
    {
      "id": "flow_ip_task_gateway",
      "source_id": "task_ip_check",
      "target_id": "gateway_ip_decision",
      "condition_name": null
    },
    {
      "id": "flow_decision_confirm",
      "source_id": "gateway_ip_decision",
      "target_id": "task_ip_confirm",
      "condition_name": "yes"
    },
    {
      "id": "flow_decision_reject",
      "source_id": "gateway_ip_decision",
      "target_id": "task_ip_reject",
      "condition_name": "no"
    },
    {
      "id": "flow_confirm_end",
      "source_id": "task_ip_confirm",
      "target_id": "end_ip_confirm",
      "condition_name": null
    },
    {
      "id": "flow_reject_end",
      "source_id": "task_ip_reject",
      "target_id": "end_ip_reject",
      "condition_name": null
    }
  ],
  "pools": [
    {
      "id": "pool_ec",
      "name": "EC",
      "element_ids": [
        "start_ec",
        "end_ec_notify"
      ]
    },
    {
      "id": "pool_inq",
      "name": "INQ",
      "element_ids": [
        "start_inq_receive",
        "task_inq_notify_ip",
        "end_inq_notify",
        "start_inq_result",
        "end_inq_final"
      ]
    },
    {
      "id": "pool_ip",
      "name": "IP",
      "element_ids": [
        "start_ip_receive",
        "task_ip_check",
        "gateway_ip_decision",
        "task_ip_confirm",
        "task_ip_reject",
        "end_ip_confirm",
        "end_ip_reject"
      ]
    }
  ],
  "message_flows": [
    {
      "id": "msg_ec_to_inq",
      "source_id": "end_ec_notify",
      "target_id": "start_inq_receive",
      "name": "Master data change notification"
    },
    {
      "id": "msg_inq_to_ip",
      "source_id": "end_inq_notify",
      "target_id": "start_ip_receive",
      "name": "Change notification"
    },
    {
      "id": "msg_ip_confirm_to_inq",
      "source_id": "end_ip_confirm",
      "target_id": "start_inq_result",
      "name": "Decision notification"
    },
    {
      "id": "msg_ip_reject_to_inq",
      "source_id": "end_ip_reject",
      "target_id": "start_inq_result",
      "name": "Decision notification"
    }
