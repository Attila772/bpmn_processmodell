  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_msp_part" name="MSP" processRef="pool_msp_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="task_notify_mpoo" targetRef="start_mpoo_msg" name="Wechselabsicht" />
    <bpmn:messageFlow id="mf2" sourceRef="task_notify_no_self_dismount" targetRef="task_final_reading_mpon" name="Kein_Selbstausbau_Meldung" />
    <bpmn:messageFlow id="mf3" sourceRef="task_send_final_reading" targetRef="start_go_msg1" name="Endablesung_Werte" />
    <bpmn:messageFlow id="mf4" sourceRef="task_tell_go_changes" targetRef="start_go_msg2" name="Gerätewechsel_Stammdaten_Einbau" />
    <bpmn:messageFlow id="mf5" sourceRef="task_notify_msp" targetRef="start_msp_msg" name="Gerätewechsel_Stammdaten_Zaehlerstaende" />
    <bpmn:messageFlow id="mf6" sourceRef="gw_who_reads" targetRef="task_final_reading_mpon" />
    <bpmn:messageFlow id="mf7" sourceRef="task_final_reading_mpon" targetRef="gw_who_dismounts" />
    <bpmn:messageFlow id="mf8" sourceRef="gw_who_dismounts" targetRef="task_dismount_mpon" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_wechselabsicht" name="Gerätewechselabsicht" dataObjectRef="doc_wechselabsicht_do" />
    <bpmn:dataObject id="doc_wechselabsicht_do" />
    <bpmn:dataObjectReference id="doc_endablesung" name="Endablesung (Zählerstand bei Ausbau)" dataObjectRef="doc_endablesung_do" />
    <bpmn:dataObject id="doc_endablesung_do" />
    <bpmn:dataObjectReference id="doc_stammdaten_einbau" name="Stammdaten neues Gerät" dataObjectRef="doc_stammdaten_einbau_do" />
    <bpmn:dataObject id="doc_stammdaten_einbau_do" />
    <bpmn:dataObjectReference id="doc_zaehlerstand_einbau" name="Zählerstand bei Einbau" dataObjectRef="doc_zaehlerstand_einbau_do" />
    <bpmn:dataObject id="doc_zaehlerstand_einbau_do" />
    <bpmn:startEvent id="start_1" name="Prozessstart">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpon" name="Prozessende MPON">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="task_notify_mpoo" name="MPON benachrichtigt MPOO über Gerätewechselabsicht">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_notify_mpoo_doa0">
        <bpmn:targetRef>doc_wechselabsicht</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:manualTask id="task_final_reading_mpon" name="MPON führt Endablesung durch">
      <bpmn:dataOutputAssociation id="task_final_reading_mpon_doa0">
        <bpmn:targetRef>doc_endablesung</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_dismount_mpon" name="MPON baut altes Gerät aus">
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:property id="task_dismount_mpon_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_dismount_mpon_dia0">
        <bpmn:sourceRef>doc_endablesung</bpmn:sourceRef>
        <bpmn:targetRef>task_dismount_mpon_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_mount_new" name="MPON baut neues Gerät ein">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mount_new_doa0">
        <bpmn:targetRef>doc_stammdaten_einbau</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_read_meter" name="MPON liest Zählerstand am neuen Gerät ab">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:property id="task_read_meter_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_read_meter_dia0">
        <bpmn:sourceRef>doc_stammdaten_einbau</bpmn:sourceRef>
        <bpmn:targetRef>task_read_meter_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_read_meter_doa0">
        <bpmn:targetRef>doc_zaehlerstand_einbau</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sendTask id="task_send_final_reading" name="MPON sendet Werte der Endablesung an GO">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:property id="task_send_final_reading_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_final_reading_dia0">
        <bpmn:sourceRef>doc_endablesung</bpmn:sourceRef>
        <bpmn:targetRef>task_send_final_reading_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:sendTask id="task_tell_go_changes" name="MPON informiert GO über Gerätewechsel, Stammdaten und Zählerstand bei Einbau">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:property id="task_tell_go_changes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_tell_go_changes_dia0">
        <bpmn:sourceRef>doc_stammdaten_einbau</bpmn:sourceRef>
        <bpmn:targetRef>task_tell_go_changes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_tell_go_changes_dia1">
        <bpmn:sourceRef>doc_zaehlerstand_einbau</bpmn:sourceRef>
        <bpmn:targetRef>task_tell_go_changes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f1" sourceRef="start_1" targetRef="task_notify_mpoo" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_notify_mpoo" targetRef="end_mpon" />
    <bpmn:sequenceFlow id="f8" sourceRef="task_dismount_mpon" targetRef="task_mount_new" />
    <bpmn:sequenceFlow id="f9" sourceRef="task_mount_new" targetRef="task_read_meter" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_read_meter" targetRef="task_send_final_reading" />
    <bpmn:sequenceFlow id="f11" sourceRef="task_send_final_reading" targetRef="task_tell_go_changes" />
    <bpmn:sequenceFlow id="f14" sourceRef="task_tell_go_changes" targetRef="end_mpon" />
  </bpmn:process>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_wechselabsicht_p1" name="Gerätewechselabsicht" dataObjectRef="doc_wechselabsicht_p1_do" />
    <bpmn:dataObject id="doc_wechselabsicht_p1_do" />
    <bpmn:dataObjectReference id="doc_endablesung_p1" name="Endablesung (Zählerstand bei Ausbau)" dataObjectRef="doc_endablesung_p1_do" />
    <bpmn:dataObject id="doc_endablesung_p1_do" />
    <bpmn:startEvent id="start_mpoo_msg" name="Wechselabsicht empfangen">
      <bpmn:outgoing>f_msg1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpoo_msg_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpoo" name="Prozessende MPOO">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_announce_self_dismount" name="MPOO kündigt Selbstausbau an">
      <bpmn:incoming>flow_sd_yes</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:property id="task_announce_self_dismount_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_announce_self_dismount_dia0">
        <bpmn:sourceRef>doc_wechselabsicht_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_announce_self_dismount_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_notify_no_self_dismount" name="MPOO meldet keinen Selbstausbau">
      <bpmn:incoming>flow_sd_no</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="task_notify_no_self_dismount_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_notify_no_self_dismount_dia0">
        <bpmn:sourceRef>doc_wechselabsicht_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_notify_no_self_dismount_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_final_reading_mpoo" name="MPOO führt Endablesung durch">
      <bpmn:incoming>f_who_reads_mpoo</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_final_reading_mpoo_doa0">
        <bpmn:targetRef>doc_endablesung_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_dismount_mpoo" name="MPOO baut altes Gerät aus">
      <bpmn:incoming>f_who_dismounts_mpoo</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:property id="task_dismount_mpoo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_dismount_mpoo_dia0">
        <bpmn:sourceRef>doc_endablesung_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_dismount_mpoo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_self_dismount" name="Selbstausbau durch MPOO?" isMarkerVisible="true">
      <bpmn:incoming>f_msg1</bpmn:incoming>
      <bpmn:outgoing>flow_sd_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_sd_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_who_reads" name="MPON oder MPOO liest ab" isMarkerVisible="true">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f_who_reads_mpoo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_who_dismounts" name="MPON oder MPOO baut aus" isMarkerVisible="true">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f_who_dismounts_mpoo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f_msg1" sourceRef="start_mpoo_msg" targetRef="gw_self_dismount" />
    <bpmn:sequenceFlow id="flow_sd_yes" sourceRef="gw_self_dismount" targetRef="task_announce_self_dismount" name="Selbstausbau" />
    <bpmn:sequenceFlow id="flow_sd_no" sourceRef="gw_self_dismount" targetRef="task_notify_no_self_dismount" name="kein Selbstausbau" />
    <bpmn:sequenceFlow id="f3" sourceRef="task_announce_self_dismount" targetRef="gw_who_reads" />
    <bpmn:sequenceFlow id="f4" sourceRef="task_notify_no_self_dismount" targetRef="end_mpoo" />
    <bpmn:sequenceFlow id="f_who_reads_mpoo" sourceRef="gw_who_reads" targetRef="task_final_reading_mpoo" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_final_reading_mpoo" targetRef="gw_who_dismounts" />
    <bpmn:sequenceFlow id="f_who_dismounts_mpoo" sourceRef="gw_who_dismounts" targetRef="task_dismount_mpoo" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_dismount_mpoo" targetRef="end_mpoo" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_endablesung_p2" name="Endablesung (Zählerstand bei Ausbau)" dataObjectRef="doc_endablesung_p2_do" />
