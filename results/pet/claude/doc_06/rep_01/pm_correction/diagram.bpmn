    </bpmn:startEvent>
    <bpmn:endEvent id="end_go" name="Prozessende GO">
      <bpmn:incoming>f_go4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="task_notify_msp" name="GO meldet MSP Gerätewechsel, Stammdaten, Zählerstand bei Ausbau und Einbau">
      <bpmn:incoming>f_go1</bpmn:incoming>
      <bpmn:incoming>f_go2</bpmn:incoming>
      <bpmn:outgoing>f_go4</bpmn:outgoing>
      <bpmn:property id="task_notify_msp_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_notify_msp_dia0">
        <bpmn:sourceRef>doc_endablesung_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_notify_msp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_notify_msp_dia1">
        <bpmn:sourceRef>doc_stammdaten_einbau_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_notify_msp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_notify_msp_dia2">
        <bpmn:sourceRef>doc_zaehlerstand_einbau_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_notify_msp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="f_go1" sourceRef="start_go_msg1" targetRef="task_notify_msp" />
    <bpmn:sequenceFlow id="f_go2" sourceRef="start_go_msg2" targetRef="task_notify_msp" />
    <bpmn:sequenceFlow id="f_go4" sourceRef="task_notify_msp" targetRef="end_go" />
  </bpmn:process>
  <bpmn:process id="pool_msp_proc" isExecutable="false">
    <bpmn:startEvent id="start_msp_msg" name="Meldung empfangen">
