  <collaboration id="Collaboration_1">
    <participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <participant id="Participant_MSP" name="MSP" processRef="Process_MSP"/>

    <messageFlow id="MF_Intentions" name="Equipment change intentions" sourceRef="Task_NotifyIntentions" targetRef="StartEvent_MPOO"/>
    <messageFlow id="MF_AnnounceSelfDismount" name="Announce self dismounting" sourceRef="Task_AnnounceSelfDismount" targetRef="CatchEvent_AnnounceSelfDismount"/>
    <messageFlow id="MF_NoSelfDismount" name="No self-dismounting" sourceRef="Task_NotifyNoSelfDismount" targetRef="CatchEvent_NoSelfDismount"/>
    <messageFlow id="MF_FinalReadingValues" name="Final reading values" sourceRef="Task_SendFinalReadingValues" targetRef="StartEvent_GO"/>
    <messageFlow id="MF_DeviceChanges" name="Device changes, master data, meter count at installation" sourceRef="Task_TellGODeviceChanges" targetRef="CatchEvent_DeviceChanges"/>
    <messageFlow id="MF_MSPNotify" name="Device changes, master data, meter counts" sourceRef="Task_NotifyMSP" targetRef="StartEvent_MSP"/>
  </collaboration>

  <process id="Process_MPON" name="MPON" isExecutable="false">
    <startEvent id="StartEvent_MPON" name="Start"/>
    <task id="Task_NotifyIntentions" name="Notify MPOO about equipment change intentions"/>
    <eventBasedGateway id="Gateway_EventBased" name="Wait for MPOO response"/>
    <intermediateCatchEvent id="CatchEvent_AnnounceSelfDismount" name="Receive: Self dismounting announced">
      <messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_AnnounceSelfDismount"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="CatchEvent_NoSelfDismount" name="Receive: No self-dismounting">
      <messageEventDefinition id="MessageEventDefinition_2" messageRef="Message_NoSelfDismount"/>
    </intermediateCatchEvent>
    <task id="Task_FinalReading_MPON" name="Perform final reading"/>
    <task id="Task_Dismount_MPON" name="Dismount old equipment"/>
    <exclusiveGateway id="Gateway_Merge" name="Merge"/>
    <task id="Task_MountNewDevice" name="Mount new device"/>
    <task id="Task_ReadMeterCount" name="Read meter count from installed meter"/>
    <task id="Task_SendFinalReadingValues" name="Send values of final reading to GO"/>
    <task id="Task_TellGODeviceChanges" name="Tell GO about device changes, master data and meter count at installation"/>
    <endEvent id="EndEvent_MPON" name="End"/>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_MPON" targetRef="Task_NotifyIntentions"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_NotifyIntentions" targetRef="Gateway_EventBased"/>
    <sequenceFlow id="Flow_3" sourceRef="Gateway_EventBased" targetRef="CatchEvent_AnnounceSelfDismount"/>
    <sequenceFlow id="Flow_4" sourceRef="Gateway_EventBased" targetRef="CatchEvent_NoSelfDismount"/>
    <sequenceFlow id="Flow_5" sourceRef="CatchEvent_AnnounceSelfDismount" targetRef="Gateway_Merge"/>
    <sequenceFlow id="Flow_6" sourceRef="CatchEvent_NoSelfDismount" targetRef="Task_FinalReading_MPON"/>
    <sequenceFlow id="Flow_7" sourceRef="Task_FinalReading_MPON" targetRef="Task_Dismount_MPON"/>
    <sequenceFlow id="Flow_8" sourceRef="Task_Dismount_MPON" targetRef="Gateway_Merge"/>
    <sequenceFlow id="Flow_9" sourceRef="Gateway_Merge" targetRef="Task_MountNewDevice"/>
    <sequenceFlow id="Flow_10" sourceRef="Task_MountNewDevice" targetRef="Task_ReadMeterCount"/>
    <sequenceFlow id="Flow_11" sourceRef="Task_ReadMeterCount" targetRef="Task_SendFinalReadingValues"/>
    <sequenceFlow id="Flow_12" sourceRef="Task_SendFinalReadingValues" targetRef="Task_TellGODeviceChanges"/>
    <sequenceFlow id="Flow_13" sourceRef="Task_TellGODeviceChanges" targetRef="EndEvent_MPON"/>
  </process>

  <process id="Process_MPOO" name="MPOO" isExecutable="false">
    <startEvent id="StartEvent_MPOO" name="Receive equipment change intentions">
      <messageEventDefinition id="MessageEventDefinition_3" messageRef="Message_Intentions"/>
    </startEvent>
    <exclusiveGateway id="Gateway_MPOO_Decision" name="Self-dismounting?"/>
    <task id="Task_AnnounceSelfDismount" name="Announce self dismounting to MPON"/>
    <task id="Task_FinalReading_MPOO" name="Perform final reading"/>
    <task id="Task_Dismount_MPOO" name="Dismount old equipment"/>
    <endEvent id="EndEvent_MPOO_1" name="End"/>
    <task id="Task_NotifyNoSelfDismount" name="Notify MPON about no self-dismounting"/>
    <endEvent id="EndEvent_MPOO_2" name="End"/>

    <sequenceFlow id="Flow_14" sourceRef="StartEvent_MPOO" targetRef="Gateway_MPOO_Decision"/>
    <sequenceFlow id="Flow_15" name="Self-dismounting" sourceRef="Gateway_MPOO_Decision" targetRef="Task_AnnounceSelfDismount"/>
    <sequenceFlow id="Flow_16" name="No self-dismounting" sourceRef="Gateway_MPOO_Decision" targetRef="Task_NotifyNoSelfDismount"/>
    <sequenceFlow id="Flow_17" sourceRef="Task_AnnounceSelfDismount" targetRef="Task_FinalReading_MPOO"/>
    <sequenceFlow id="Flow_18" sourceRef="Task_FinalReading_MPOO" targetRef="Task_Dismount_MPOO"/>
    <sequenceFlow id="Flow_19" sourceRef="Task_Dismount_MPOO" targetRef="EndEvent_MPOO_1"/>
    <sequenceFlow id="Flow_20" sourceRef="Task_NotifyNoSelfDismount" targetRef="EndEvent_MPOO_2"/>
  </process>

  <process id="Process_GO" name="GO" isExecutable="false">
    <startEvent id="StartEvent_GO" name="Receive final reading values">
      <messageEventDefinition id="MessageEventDefinition_4" messageRef="Message_FinalReadingValues"/>
    </startEvent>
    <intermediateCatchEvent id="CatchEvent_DeviceChanges" name="Receive device changes, master data, meter count at installation">
      <messageEventDefinition id="MessageEventDefinition_5" messageRef="Message_DeviceChanges"/>
    </intermediateCatchEvent>
    <task id="Task_NotifyMSP" name="Notify MSP about device changes, master data, meter count at dismounting and installation"/>
    <endEvent id="EndEvent_GO" name="End"/>

    <sequenceFlow id="Flow_21" sourceRef="StartEvent_GO" targetRef="CatchEvent_DeviceChanges"/>
    <sequenceFlow id="Flow_22" sourceRef="CatchEvent_DeviceChanges" targetRef="Task_NotifyMSP"/>
    <sequenceFlow id="Flow_23" sourceRef="Task_NotifyMSP" targetRef="EndEvent_GO"/>
  </process>

  <process id="Process_MSP" name="MSP" isExecutable="false">
    <startEvent id="StartEvent_MSP" name="Receive notification from GO">
      <messageEventDefinition id="MessageEventDefinition_6" messageRef="Message_MSPNotify"/>
    </startEvent>
    <endEvent id="EndEvent_MSP" name="End"/>
    <sequenceFlow id="Flow_24" sourceRef="StartEvent_MSP" targetRef="EndEvent_MSP"/>
  </process>

