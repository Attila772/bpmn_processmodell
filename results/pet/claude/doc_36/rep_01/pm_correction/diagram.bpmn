<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="D1" name="Court files" dataObjectRef="D1_do" />
    <bpmn:dataObject id="D1_do" />
    <bpmn:dataObjectReference id="D2" name="Judge's Lawlist" dataObjectRef="D2_do" />
    <bpmn:dataObject id="D2_do" />
    <bpmn:startEvent id="E1" name="Morning starts">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="E2" name="Files ready and distributed">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="E3" name="Directions hearings completed">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="T1" name="Check files not yet processed">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:property id="T1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T1_dia0">
        <bpmn:sourceRef>D1</bpmn:sourceRef>
        <bpmn:targetRef>T1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="T2" name="Initiate search for missing files">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T2_doa0">
        <bpmn:targetRef>D1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="T3" name="Physically track files to intended location">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:property id="T3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T3_dia0">
        <bpmn:sourceRef>D1</bpmn:sourceRef>
        <bpmn:targetRef>T3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="T3_doa0">
        <bpmn:targetRef>D1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="T4" name="Hand files to Associate">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:property id="T4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T4_dia0">
        <bpmn:sourceRef>D1</bpmn:sourceRef>
        <bpmn:targetRef>T4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="T5" name="Distribute Judge's Lawlist to relevant people">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:property id="T5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T5_dia0">
        <bpmn:sourceRef>D2</bpmn:sourceRef>
        <bpmn:targetRef>T5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="T5_doa0">
        <bpmn:targetRef>D2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="T6" name="Conduct directions hearings">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:property id="T6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T6_dia0">
        <bpmn:sourceRef>D1</bpmn:sourceRef>
        <bpmn:targetRef>T6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="T6_dia1">
        <bpmn:sourceRef>D2</bpmn:sourceRef>
        <bpmn:targetRef>T6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Files missing?" isMarkerVisible="true">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="G2" name="Fork files-handover and lawlist distribution">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="G3" name="Join before hearings">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="F1" sourceRef="E1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" sourceRef="G1" targetRef="T2" name="missing" />
    <bpmn:sequenceFlow id="F4" sourceRef="G1" targetRef="T3" name="not missing" />
    <bpmn:sequenceFlow id="F5" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F8" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" sourceRef="T4" targetRef="G3" />
    <bpmn:sequenceFlow id="F10" sourceRef="T5" targetRef="G3" />
    <bpmn:sequenceFlow id="F11" sourceRef="G3" targetRef="E2" />
    <bpmn:sequenceFlow id="F12" sourceRef="E2" targetRef="T6" />
    <bpmn:sequenceFlow id="F13" sourceRef="T6" targetRef="E3" />
  </bpmn:process>
