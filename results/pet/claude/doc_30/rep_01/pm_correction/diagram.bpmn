<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf_1" sourceRef="end_msg_deregister" targetRef="start_msg_receive_deregister" name="Deregistration" />
    <bpmn:messageFlow id="mf_2" sourceRef="end_msg_oblige_continuation" targetRef="start_msg_confirm_continuation" name="Continuation obligation" />
    <bpmn:messageFlow id="mf_3" sourceRef="end_msg_inform_mpoo" targetRef="start_1" name="Assignment info MPOO" />
    <bpmn:messageFlow id="mf_4" sourceRef="end_msg_inform_mspo" targetRef="start_msg_mspo_informed" name="Assignment info MSPO" />
    <bpmn:messageFlow id="mf_5" sourceRef="end_msg_inform_sp" targetRef="start_msg_sp_informed" name="Assignment info SP" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_deregistration" name="Abmeldung des Messpunkts" dataObjectRef="data_deregistration_do" />
    <bpmn:dataObject id="data_deregistration_do" />
    <bpmn:startEvent id="start_1" name="Start">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msg_deregister" name="Deregistration sent">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_deregister_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_msg_confirm_continuation" name="Obligation to continue received">
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_confirm_continuation_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_1" name="MPOO process end">
      <bpmn:incoming>sf_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_deregister" name="MPOO deregistriert sich bei GO">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_deregister_doa0">
        <bpmn:targetRef>data_deregistration</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_confirm_continuation" name="MPOO bestätigt die Fortführung">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf_1" sourceRef="start_1" targetRef="task_deregister" />
    <bpmn:sequenceFlow id="sf_2" sourceRef="task_deregister" targetRef="end_msg_deregister" />
    <bpmn:sequenceFlow id="sf_6" sourceRef="start_msg_confirm_continuation" targetRef="task_confirm_continuation" />
    <bpmn:sequenceFlow id="sf_7" sourceRef="task_confirm_continuation" targetRef="end_1" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_deregistration_p1" name="Abmeldung des Messpunkts" dataObjectRef="data_deregistration_p1_do" />
    <bpmn:dataObject id="data_deregistration_p1_do" />
    <bpmn:dataObjectReference id="data_assignment" name="Zuweisung MPO" dataObjectRef="data_assignment_do" />
    <bpmn:dataObject id="data_assignment_do" />
    <bpmn:startEvent id="start_msg_receive_deregister" name="Deregistration received">
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_receive_deregister_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_reject" name="Deregistration rejected">
      <bpmn:incoming>flow_reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_msg_oblige_continuation" name="Obligation to continue sent">
      <bpmn:incoming>flow_oblige_yes</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_oblige_continuation_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_msg_inform_mpoo" name="MPOO informed">
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_inform_mpoo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_msg_inform_mspo" name="MSPO informed">
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_inform_mspo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_msg_inform_sp" name="SP informed">
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_inform_sp_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_verify" name="GO prüft die Abmeldung">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:property id="task_verify_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_verify_dia0">
        <bpmn:sourceRef>data_deregistration_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_verify_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_prepare_readmission" name="GO bereitet die Wiederzulassung des Messpunkts vor">
      <bpmn:incoming>flow_confirm</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_equipment" name="GO führt Geräteerwerb und/oder Gerätewechsel durch">
      <bpmn:incoming>flow_oblige_no</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_assign_mpo" name="GO weist sich selbst als MPO zu">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_assign_mpo_doa0">
        <bpmn:targetRef>data_assignment</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_decision" name="Abmeldung ablehnen oder vorläufig bestätigen?" isMarkerVisible="true">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>flow_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_oblige" name="MPOO zur Fortführung verpflichten?" isMarkerVisible="true">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>flow_oblige_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_oblige_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_3" sourceRef="start_msg_receive_deregister" targetRef="task_verify" />
    <bpmn:sequenceFlow id="sf_4" sourceRef="task_verify" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_reject" sourceRef="gw_decision" targetRef="end_reject" name="Abmeldung abgelehnt" />
    <bpmn:sequenceFlow id="flow_confirm" sourceRef="gw_decision" targetRef="task_prepare_readmission" name="Abmeldung vorläufig bestätigt" />
    <bpmn:sequenceFlow id="sf_5" sourceRef="task_prepare_readmission" targetRef="gw_oblige" />
    <bpmn:sequenceFlow id="flow_oblige_yes" sourceRef="gw_oblige" targetRef="end_msg_oblige_continuation" name="MPOO wird zur Fortführung verpflichtet" />
    <bpmn:sequenceFlow id="flow_oblige_no" sourceRef="gw_oblige" targetRef="task_equipment" name="keine Verpflichtung" />
    <bpmn:sequenceFlow id="sf_8" sourceRef="task_equipment" targetRef="task_assign_mpo" />
    <bpmn:sequenceFlow id="sf_9" sourceRef="task_assign_mpo" targetRef="end_msg_inform_mpoo" />
    <bpmn:sequenceFlow id="sf_10" sourceRef="task_assign_mpo" targetRef="end_msg_inform_mspo" />
    <bpmn:sequenceFlow id="sf_11" sourceRef="task_assign_mpo" targetRef="end_msg_inform_sp" />
  </bpmn:process>
  <bpmn:process id="pool_mspo_proc" isExecutable="false">
    <bpmn:startEvent id="start_msg_mspo_informed" name="Assignment info received">
      <bpmn:outgoing>sf_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_mspo_informed_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_2" name="MSPO process end">
      <bpmn:incoming>sf_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf_12" sourceRef="start_msg_mspo_informed" targetRef="end_2" />
  </bpmn:process>
  <bpmn:process id="pool_sp_proc" isExecutable="false">
    <bpmn:startEvent id="start_msg_sp_informed" name="Assignment info received">
      <bpmn:outgoing>sf_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_sp_informed_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_3" name="SP process end">
      <bpmn:incoming>sf_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf_13" sourceRef="start_msg_sp_informed" targetRef="end_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
