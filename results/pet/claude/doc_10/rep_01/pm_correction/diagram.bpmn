<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_job_posting" name="Stellenausschreibung" dataObjectRef="data_job_posting_do" />
    <bpmn:dataObject id="data_job_posting_do" />
    <bpmn:dataObjectReference id="data_application" name="Bewerbung" dataObjectRef="data_application_do" />
    <bpmn:dataObject id="data_application_do" />
    <bpmn:dataObjectReference id="data_check_result" name="Prüfungsergebnis der Bewerbungen" dataObjectRef="data_check_result_do" />
    <bpmn:dataObject id="data_check_result_do" />
    <bpmn:dataObjectReference id="data_contract" name="Arbeitsvertrag" dataObjectRef="data_contract_do" />
    <bpmn:dataObject id="data_contract_do" />
    <bpmn:startEvent id="event_start" name="Bedarf einer Fachabteilung zur Besetzung einer Stelle">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_end" name="Stelle besetzt (Arbeitsvertrag abgeschlossen)">
      <bpmn:incoming>flow5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_advertise" name="Stelle ausschreiben">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_advertise_doa0">
        <bpmn:targetRef>data_job_posting</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_apply" name="Bewerbung einreichen">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:property id="task_apply_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_apply_dia0">
        <bpmn:sourceRef>data_job_posting</bpmn:sourceRef>
        <bpmn:targetRef>task_apply_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_apply_doa0">
        <bpmn:targetRef>data_application</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_check" name="Bewerbungen prüfen">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
      <bpmn:property id="task_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_dia0">
        <bpmn:sourceRef>data_application</bpmn:sourceRef>
        <bpmn:targetRef>task_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_check_doa0">
        <bpmn:targetRef>data_check_result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_fill" name="Stelle besetzen (Arbeitsvertrag abschließen)">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:outgoing>flow5</bpmn:outgoing>
      <bpmn:property id="task_fill_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_fill_dia0">
        <bpmn:sourceRef>data_check_result</bpmn:sourceRef>
        <bpmn:targetRef>task_fill_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_fill_doa0">
        <bpmn:targetRef>data_contract</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow1" sourceRef="event_start" targetRef="task_advertise" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task_advertise" targetRef="task_apply" />
    <bpmn:sequenceFlow id="flow3" sourceRef="task_apply" targetRef="task_check" />
    <bpmn:sequenceFlow id="flow4" sourceRef="task_check" targetRef="task_fill" />
    <bpmn:sequenceFlow id="flow5" sourceRef="task_fill" targetRef="event_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_end_di" bpmnElement="event_end">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_start_di" bpmnElement="event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_advertise_di" bpmnElement="task_advertise">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_apply_di" bpmnElement="task_apply">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_di" bpmnElement="task_check">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_fill_di" bpmnElement="task_fill">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_job_posting_di" bpmnElement="data_job_posting">
        <dc:Bounds x="465" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_application_di" bpmnElement="data_application">
        <dc:Bounds x="655" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_check_result_di" bpmnElement="data_check_result">
        <dc:Bounds x="845" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_contract_di" bpmnElement="data_contract">
        <dc:Bounds x="940" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow5_di" bpmnElement="flow5">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_advertise_doa0_di" bpmnElement="task_advertise_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_apply_dia0_di" bpmnElement="task_apply_dia0">
        <di:waypoint x="483" y="265" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_apply_doa0_di" bpmnElement="task_apply_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="673" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_dia0_di" bpmnElement="task_check_dia0">
        <di:waypoint x="673" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_doa0_di" bpmnElement="task_check_doa0">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="863" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_fill_dia0_di" bpmnElement="task_fill_dia0">
        <di:waypoint x="863" y="265" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_fill_doa0_di" bpmnElement="task_fill_doa0">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="958" y="265" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>