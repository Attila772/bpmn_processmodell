<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="d1" name="Stellenausschreibung" dataObjectRef="d1_do" />
    <bpmn:dataObject id="d1_do" />
    <bpmn:dataObjectReference id="d2" name="Bewerbungsunterlagen" dataObjectRef="d2_do" />
    <bpmn:dataObject id="d2_do" />
    <bpmn:dataObjectReference id="d3" name="Geprüfte Bewerbungen" dataObjectRef="d3_do" />
    <bpmn:dataObject id="d3_do" />
    <bpmn:dataObjectReference id="d4" name="Arbeitsvertrag" dataObjectRef="d4_do" />
    <bpmn:dataObject id="d4_do" />
    <bpmn:startEvent id="e1" name="Bedarf einer Fachabteilung zur Stellenbesetzung">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Stelle besetzt (Arbeitsvertrag abgeschlossen)">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1" name="Stelle ausschreiben">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>d1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t2" name="Bewerbungen einreichen">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:property id="t2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t2_dia0">
        <bpmn:sourceRef>d1</bpmn:sourceRef>
        <bpmn:targetRef>t2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t2_doa0">
        <bpmn:targetRef>d2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t3" name="Bewerbungen prüfen">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="t3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t3_dia0">
        <bpmn:sourceRef>d2</bpmn:sourceRef>
        <bpmn:targetRef>t3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t3_doa0">
        <bpmn:targetRef>d3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t4" name="Stelle besetzen (Arbeitsvertrag abschließen)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t4_dia0">
        <bpmn:sourceRef>d3</bpmn:sourceRef>
        <bpmn:targetRef>t4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t4_doa0">
        <bpmn:targetRef>d4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="f1" sourceRef="e1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f5" sourceRef="t4" targetRef="e2" />
  </bpmn:process>
