      <bpmndi:BPMNShape id="d4_di" bpmnElement="d4">
        <dc:Bounds x="940" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
