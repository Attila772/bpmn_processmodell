<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="Process_FillPost" name="Fill Vacant Post Process" isExecutable="false">

    <startEvent id="StartEvent_1" name="Functional department demands to fill a post">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_AdvertisePost" name="Advertise post">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <task id="Task_ApplicantsApply" name="Applicants apply">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <task id="Task_CheckApplications" name="Check applications">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <task id="Task_FillPost" name="Fill post (conclude contract of employment)">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
    </task>

    <endEvent id="EndEvent_1" name="Post filled - contract of employment concluded">
      <incoming>Flow_5</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_AdvertisePost" />
    <sequenceFlow id="Flow_2" sourceRef="Task_AdvertisePost" targetRef="Task_ApplicantsApply" />
    <sequenceFlow id="Flow_3" sourceRef="Task_ApplicantsApply" targetRef="Task_CheckApplications" />
    <sequenceFlow id="Flow_4" sourceRef="Task_CheckApplications" targetRef="Task_FillPost" />
    <sequenceFlow id="Flow_5" sourceRef="Task_FillPost" targetRef="EndEvent_1" />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_FillPost">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="100" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AdvertisePost_di" bpmnElement="Task_AdvertisePost">
        <omgdc:Bounds x="200" y="128" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ApplicantsApply_di" bpmnElement="Task_ApplicantsApply">
        <omgdc:Bounds x="360" y="128" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckApplications_di" bpmnElement="Task_CheckApplications">
        <omgdc:Bounds x="520" y="128" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FillPost_di" bpmnElement="Task_FillPost">
        <omgdc:Bounds x="680" y="128" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="852" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="136" y="168" />
        <omgdi:waypoint x="200" y="168" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="300" y="168" />
        <omgdi:waypoint x="360" y="168" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="460" y="168" />
        <omgdi:waypoint x="520" y="168" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="620" y="168" />
        <omgdi:waypoint x="680" y="168" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="800" y="168" />
        <omgdi:waypoint x="852" y="168" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
