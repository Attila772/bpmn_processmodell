        <omgdi:waypoint x="1138" y="330"/>
        <omgdi:waypoint x="656" y="330"/>
        <omgdi:waypoint x="638" y="288"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
