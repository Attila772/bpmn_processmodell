      <bpmndi:BPMNShape bpmnElement="Participant_Department" isHorizontal="true">
        <omgdc:Bounds x="100" y="380" width="1300" height="280"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="StartEvent_Dept_Clarification">
        <omgdc:Bounds x="620" y="400" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ProvideClarification">
        <omgdc:Bounds x="700" y="378" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="EndEvent_Dept_ClarificationSent">
        <omgdc:Bounds x="850" y="400" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="StartEvent_Dept_ReviewJD">
        <omgdc:Bounds x="620" y="520" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ReviewJD">
        <omgdc:Bounds x="700" y="498" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Gateway_DeptApprove">
        <omgdc:Bounds x="850" y="513" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_SendApproval">
        <omgdc:Bounds x="950" y="440" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="EndEvent_Dept_Approved">
        <omgdc:Bounds x="1100" y="462" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_SendRejection">
        <omgdc:Bounds x="950" y="560" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="EndEvent_Dept_Rejected">
        <omgdc:Bounds x="1120" y="582" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- sequence flow edges -->
      <bpmndi:BPMNEdge bpmnElement="Flow_1" sourceRef="StartEvent_VacancyReported" targetRef="Task_CreateJD">
        <omgdi:waypoint x="176" y="188"/>
        <omgdi:waypoint x="220" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_2" sourceRef="Task_CreateJD" targetRef="Gateway_Confusion">
        <omgdi:waypoint x="320" y="188"/>
        <omgdi:waypoint x="370" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_ToAsk" sourceRef="Gateway_Confusion" targetRef="Task_AskDept">
        <omgdi:waypoint x="395" y="163"/>
        <omgdi:waypoint x="395" y="120"/>
        <omgdi:waypoint x="470" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_ToSubmit" sourceRef="Gateway_Confusion" targetRef="Task_SubmitJD">
        <omgdi:waypoint x="395" y="213"/>
        <omgdi:waypoint x="395" y="270"/>
        <omgdi:waypoint x="470" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_3" sourceRef="Task_AskDept" targetRef="IntermediateCatch_ClarificationReceived">
        <omgdi:waypoint x="570" y="120"/>
        <omgdi:waypoint x="620" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_FromClarification" sourceRef="IntermediateCatch_ClarificationReceived" targetRef="Task_CreateJD">
        <omgdi:waypoint x="638" y="102"/>
        <omgdi:waypoint x="638" y="60"/>
        <omgdi:waypoint x="270" y="60"/>
        <omgdi:waypoint x="270" y="148"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_4" sourceRef="Task_SubmitJD" targetRef="IntermediateCatch_Decision">
        <omgdi:waypoint x="570" y="270"/>
        <omgdi:waypoint x="620" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_5" sourceRef="IntermediateCatch_Decision" targetRef="Gateway_Approved">
        <omgdi:waypoint x="656" y="270"/>
        <omgdi:waypoint x="700" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Rejected" sourceRef="Gateway_Approved" targetRef="Task_Correct">
        <omgdi:waypoint x="725" y="295"/>
        <omgdi:waypoint x="725" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_FromCorrect" sourceRef="Task_Correct" targetRef="Task_SubmitJD">
        <omgdi:waypoint x="700" y="370"/>
        <omgdi:waypoint x="520" y="370"/>
        <omgdi:waypoint x="520" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_ApprovedYes" sourceRef="Gateway_Approved" targetRef="Task_PostJob">
        <omgdi:waypoint x="750" y="270"/>
        <omgdi:waypoint x="820" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_6" sourceRef="Task_PostJob" targetRef="EndEvent_JobPosted">
        <omgdi:waypoint x="920" y="270"/>
        <omgdi:waypoint x="980" y="270"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_D1" sourceRef="StartEvent_Dept_Clarification" targetRef="Task_ProvideClarification">
        <omgdi:waypoint x="656" y="418"/>
        <omgdi:waypoint x="700" y="418"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_D2" sourceRef="Task_ProvideClarification" targetRef="EndEvent_Dept_ClarificationSent">
        <omgdi:waypoint x="800" y="418"/>
        <omgdi:waypoint x="850" y="418"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_D3" sourceRef="StartEvent_Dept_ReviewJD" targetRef="Task_ReviewJD">
        <omgdi:waypoint x="656" y="538"/>
        <omgdi:waypoint x="700" y="538"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_D4" sourceRef="Task_ReviewJD" targetRef="Gateway_DeptApprove">
        <omgdi:waypoint x="800" y="538"/>
        <omgdi:waypoint x="850" y="538"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_D_Approve" sourceRef="Gateway_DeptApprove" targetRef="Task_SendApproval">
        <omgdi:waypoint x="875" y="513"/>
        <omgdi:waypoint x="875" y="480"/>
        <omgdi:waypoint x="950" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_D_Reject" sourceRef="Gateway_DeptApprove" targetRef="Task_SendRejection">
