      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_AskDept">
        <omgdc:Bounds x="470" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="IntermediateCatch_ClarificationReceived">
        <omgdc:Bounds x="620" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_SubmitJD">
        <omgdc:Bounds x="470" y="230" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="IntermediateCatch_Decision">
        <omgdc:Bounds x="620" y="252" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Gateway_Approved">
        <omgdc:Bounds x="700" y="245" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Correct">
        <omgdc:Bounds x="700" y="330" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_PostJob">
        <omgdc:Bounds x="820" y="230" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="EndEvent_JobPosted">
        <omgdc:Bounds x="980" y="252" width="36" height="36"/>
