        <omgdi:waypoint x="875" y="600"/>
        <omgdi:waypoint x="950" y="600"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_D5" sourceRef="Task_SendApproval" targetRef="EndEvent_Dept_Approved">
        <omgdi:waypoint x="1050" y="480"/>
        <omgdi:waypoint x="1100" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_D6" sourceRef="Task_SendRejection" targetRef="EndEvent_Dept_Rejected">
