        <omgdi:waypoint x="638" y="400"/>
        <omgdi:waypoint x="638" y="520"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="MF_ApprovalReply" sourceRef="EndEvent_Dept_Approved" targetRef="IntermediateCatch_Decision">
