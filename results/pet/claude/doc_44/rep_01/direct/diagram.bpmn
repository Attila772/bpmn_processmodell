<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="Process_BicycleOrder" name="Customized Bicycle Order Process" isExecutable="false">

    <laneSet id="LaneSet_1">
      <lane id="Lane_Sales" name="Sales Department">
        <flowNodeRef>StartEvent_OrderReceived</flowNodeRef>
        <flowNodeRef>Task_ReviewOrder</flowNodeRef>
        <flowNodeRef>Gateway_AcceptReject</flowNodeRef>
        <flowNodeRef>EndEvent_Rejected</flowNodeRef>
        <flowNodeRef>Task_ShipBicycle</flowNodeRef>
        <flowNodeRef>EndEvent_ProcessCompleted</flowNodeRef>
      </lane>
      <lane id="Lane_Storehouse" name="Storehouse">
        <flowNodeRef>Gateway_Split</flowNodeRef>
        <flowNodeRef>SubProcess_PartList</flowNodeRef>
        <flowNodeRef>Gateway_Join</flowNodeRef>
      </lane>
      <lane id="Lane_Engineering" name="Engineering Department">
        <flowNodeRef>Task_PrepareAssembly</flowNodeRef>
        <flowNodeRef>Task_AssembleBicycle</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Sales department start -->
    <startEvent id="StartEvent_OrderReceived" name="Order received">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_ReviewOrder" name="Review order">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <exclusiveGateway id="Gateway_AcceptReject" name="Accept order?">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_Reject</outgoing>
      <outgoing>Flow_Accept</outgoing>
    </exclusiveGateway>

    <endEvent id="EndEvent_Rejected" name="Order rejected">
      <incoming>Flow_Reject</incoming>
    </endEvent>

    <!-- Parallel split to storehouse and engineering -->
    <parallelGateway id="Gateway_Split" name="Inform storehouse and engineering">
      <incoming>Flow_Accept</incoming>
      <outgoing>Flow_ToStorehouse</outgoing>
      <outgoing>Flow_ToEngineeringPrepare</outgoing>
    </parallelGateway>

    <!-- Storehouse sub-process: processing part list -->
    <subProcess id="SubProcess_PartList" name="Process part list">
      <incoming>Flow_ToStorehouse</incoming>
      <outgoing>Flow_FromStorehouse</outgoing>
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopCardinality xsi:type="tFormalExpression">numberOfPartListItems</loopCardinality>
      </multiInstanceLoopCharacteristics>

      <startEvent id="StartEvent_Sub" name="Part item">
        <outgoing>Flow_Sub1</outgoing>
      </startEvent>

      <task id="Task_CheckQuantity" name="Check required quantity">
        <incoming>Flow_Sub1</incoming>
        <outgoing>Flow_Sub2</outgoing>
      </task>

      <exclusiveGateway id="Gateway_Availability" name="Part available?">
        <incoming>Flow_Sub2</incoming>
        <outgoing>Flow_Sub_Available</outgoing>
        <outgoing>Flow_Sub_NotAvailable</outgoing>
      </exclusiveGateway>

      <task id="Task_Reserve" name="Reserve part">
        <incoming>Flow_Sub_Available</incoming>
        <outgoing>Flow_Sub3</outgoing>
      </task>

      <task id="Task_BackOrder" name="Back-order part">
        <incoming>Flow_Sub_NotAvailable</incoming>
        <outgoing>Flow_Sub4</outgoing>
      </task>

      <endEvent id="EndEvent_Sub" name="Part processed">
        <incoming>Flow_Sub3</incoming>
        <incoming>Flow_Sub4</incoming>
      </endEvent>

      <sequenceFlow id="Flow_Sub1" sourceRef="StartEvent_Sub" targetRef="Task_CheckQuantity" />
      <sequenceFlow id="Flow_Sub2" sourceRef="Task_CheckQuantity" targetRef="Gateway_Availability" />
      <sequenceFlow id="Flow_Sub_Available" name="Available" sourceRef="Gateway_Availability" targetRef="Task_Reserve" />
      <sequenceFlow id="Flow_Sub_NotAvailable" name="Not available" sourceRef="Gateway_Availability" targetRef="Task_BackOrder" />
      <sequenceFlow id="Flow_Sub3" sourceRef="Task_Reserve" targetRef="EndEvent_Sub" />
      <sequenceFlow id="Flow_Sub4" sourceRef="Task_BackOrder" targetRef="EndEvent_Sub" />
    </subProcess>

    <!-- Engineering department preparation -->
    <task id="Task_PrepareAssembly" name="Prepare for assembling">
      <incoming>Flow_ToEngineeringPrepare</incoming>
      <outgoing>Flow_FromEngineeringPrepare</outgoing>
    </task>

    <!-- Join after both branches complete -->
    <parallelGateway id="Gateway_Join" name="Both tasks completed">
      <incoming>Flow_FromStorehouse</incoming>
      <incoming>Flow_FromEngineeringPrepare</incoming>
      <outgoing>Flow_ToAssemble</outgoing>
    </parallelGateway>

    <task id="Task_AssembleBicycle" name="Assemble bicycle">
      <incoming>Flow_ToAssemble</incoming>
      <outgoing>Flow_ToShip</outgoing>
    </task>

    <task id="Task_ShipBicycle" name="Ship bicycle to customer">
      <incoming>Flow_ToShip</incoming>
      <outgoing>Flow_ToEnd</outgoing>
    </task>

    <endEvent id="EndEvent_ProcessCompleted" name="Process completed">
      <incoming>Flow_ToEnd</incoming>
    </endEvent>

    <!-- Main sequence flows -->
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_OrderReceived" targetRef="Task_ReviewOrder" />
    <sequenceFlow id="Flow_2" sourceRef="Task_ReviewOrder" targetRef="Gateway_AcceptReject" />
    <sequenceFlow id="Flow_Reject" name="Reject" sourceRef="Gateway_AcceptReject" targetRef="EndEvent_Rejected" />
    <sequenceFlow id="Flow_Accept" name="Accept" sourceRef="Gateway_AcceptReject" targetRef="Gateway_Split" />
    <sequenceFlow id="Flow_ToStorehouse" sourceRef="Gateway_Split" targetRef="SubProcess_PartList" />
    <sequenceFlow id="Flow_ToEngineeringPrepare" sourceRef="Gateway_Split" targetRef="Task_PrepareAssembly" />
    <sequenceFlow id="Flow_FromStorehouse" sourceRef="SubProcess_PartList" targetRef="Gateway_Join" />
    <sequenceFlow id="Flow_FromEngineeringPrepare" sourceRef="Task_PrepareAssembly" targetRef="Gateway_Join" />
    <sequenceFlow id="Flow_ToAssemble" sourceRef="Gateway_Join" targetRef="Task_AssembleBicycle" />
    <sequenceFlow id="Flow_ToShip" sourceRef="Task_AssembleBicycle" targetRef="Task_ShipBicycle" />
    <sequenceFlow id="Flow_ToEnd" sourceRef="Task_ShipBicycle" targetRef="EndEvent_ProcessCompleted" />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_BicycleOrder">

      <bpmndi:BPMNShape bpmnElement="StartEvent_OrderReceived" >
        <omgdc:Bounds x="60" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Task_ReviewOrder">
        <omgdc:Bounds x="140" y="70" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Gateway_AcceptReject" isMarkerVisible="true">
        <omgdc:Bounds x="280" y="85" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="EndEvent_Rejected">
        <omgdc:Bounds x="360" y="20" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Gateway_Split">
        <omgdc:Bounds x="380" y="85" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="SubProcess_PartList" isExpanded="true">
        <omgdc:Bounds x="470" y="190" width="380" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="StartEvent_Sub">
        <omgdc:Bounds x="490" y="260" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Task_CheckQuantity">
        <omgdc:Bounds x="550" y="238" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Gateway_Availability" isMarkerVisible="true">
        <omgdc:Bounds x="680" y="253" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Task_Reserve">
        <omgdc:Bounds x="760" y="210" width="80" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Task_BackOrder">
        <omgdc:Bounds x="760" y="300" width="80" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="EndEvent_Sub">
        <omgdc:Bounds x="800" y="260" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Task_PrepareAssembly">
        <omgdc:Bounds x="470" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Gateway_Join">
        <omgdc:Bounds x="910" y="85" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Task_AssembleBicycle">
        <omgdc:Bounds x="1010" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="Task_ShipBicycle">
        <omgdc:Bounds x="1190" y="70" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="EndEvent_ProcessCompleted">
        <omgdc:Bounds x="1350" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge bpmnElement="Flow_1">
        <omgdi:waypoint x="96" y="110" />
        <omgdi:waypoint x="140" y="110" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_2">
        <omgdi:waypoint x="240" y="110" />
        <omgdi:waypoint x="280" y="110" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_Reject">
        <omgdi:waypoint x="305" y="85" />
        <omgdi:waypoint x="305" y="38" />
        <omgdi:waypoint x="360" y="38" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_Accept">
        <omgdi:waypoint x="330" y="110" />
        <omgdi:waypoint x="380" y="110" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_ToStorehouse">
        <omgdi:waypoint x="405" y="135" />
        <omgdi:waypoint x="405" y="280" />
        <omgdi:waypoint x="470" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_ToEngineeringPrepare">
        <omgdi:waypoint x="405" y="135" />
        <omgdi:waypoint x="405" y="440" />
        <omgdi:waypoint x="470" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_Sub1">
        <omgdi:waypoint x="526" y="278" />
        <omgdi:waypoint x="550" y="278" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_Sub2">
        <omgdi:waypoint x="650" y="278" />
        <omgdi:waypoint x="680" y="278" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_Sub_Available">
        <omgdi:waypoint x="705" y="253" />
        <omgdi:waypoint x="705" y="240" />
        <omgdi:waypoint x="760" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_Sub_NotAvailable">
        <omgdi:waypoint x="705" y="303" />
        <omgdi:waypoint x="705" y="330" />
        <omgdi:waypoint x="760" y="330" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_Sub3">
        <omgdi:waypoint x="840" y="240" />
        <omgdi:waypoint x="818" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_Sub4">
        <omgdi:waypoint x="840" y="330" />
        <omgdi:waypoint x="818" y="296" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_FromStorehouse">
        <omgdi:waypoint x="850" y="280" />
        <omgdi:waypoint x="935" y="280" />
        <omgdi:waypoint x="935" y="135" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_FromEngineeringPrepare">
        <omgdi:waypoint x="590" y="440" />
        <omgdi:waypoint x="935" y="440" />
        <omgdi:waypoint x="935" y="135" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_ToAssemble">
        <omgdi:waypoint x="935" y="135" />
        <omgdi:waypoint x="935" y="440" />
        <omgdi:waypoint x="1010" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_ToShip">
        <omgdi:waypoint x="1130" y="440" />
        <omgdi:waypoint x="1250" y="440" />
        <omgdi:waypoint x="1250" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge bpmnElement="Flow_ToEnd">
        <omgdi:waypoint x="1310" y="110" />
        <omgdi:waypoint x="1350" y="110" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
