<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="ClaimsNotificationProcess" name="Claims Notification Process" isExecutable="false">

    <startEvent id="StartEvent_1" name="Claim Received">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_CheckInsured" name="Check if Claimant is Insured">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Insured" name="Insured?">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_NotInsured</outgoing>
      <outgoing>Flow_IsInsured</outgoing>
    </exclusiveGateway>

    <task id="Task_InformRejected" name="Inform Claimant of Rejection">
      <incoming>Flow_NotInsured</incoming>
      <outgoing>Flow_ToRejectedEnd</outgoing>
    </task>

    <endEvent id="EndEvent_Rejected" name="Claim Rejected">
      <incoming>Flow_ToRejectedEnd</incoming>
    </endEvent>

    <task id="Task_EvaluateSeverity" name="Evaluate Severity of Claim">
      <incoming>Flow_IsInsured</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Severity" name="Severity?">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_Simple</outgoing>
      <outgoing>Flow_Complex</outgoing>
    </exclusiveGateway>

    <task id="Task_SendSimpleForms" name="Send Simple Claim Forms">
      <incoming>Flow_Simple</incoming>
      <outgoing>Flow_SimpleToMerge</outgoing>
    </task>

    <task id="Task_SendComplexForms" name="Send Complex Claim Forms">
      <incoming>Flow_Complex</incoming>
      <outgoing>Flow_ComplexToMerge</outgoing>
    </task>

    <exclusiveGateway id="Gateway_MergeForms" name="Forms Sent">
      <incoming>Flow_SimpleToMerge</incoming>
      <incoming>Flow_ComplexToMerge</incoming>
      <outgoing>Flow_ToReceiveForms</outgoing>
    </exclusiveGateway>

    <task id="Task_ReceiveForms" name="Receive Forms from Claimant">
      <incoming>Flow_ToReceiveForms</incoming>
      <incoming>Flow_LoopBackToReceive</incoming>
      <outgoing>Flow_ToCheckCompleteness</outgoing>
    </task>

    <task id="Task_CheckCompleteness" name="Check Forms for Completeness">
      <incoming>Flow_ToCheckCompleteness</incoming>
      <outgoing>Flow_ToCompleteGateway</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Complete" name="Complete?">
      <incoming>Flow_ToCompleteGateway</incoming>
      <outgoing>Flow_Incomplete</outgoing>
      <outgoing>Flow_CompleteYes</outgoing>
    </exclusiveGateway>

    <task id="Task_InformUpdate" name="Inform Claimant to Update Forms">
      <incoming>Flow_Incomplete</incoming>
      <outgoing>Flow_LoopBackToReceive</outgoing>
    </task>

    <task id="Task_RegisterClaim" name="Register Claim in Claims Management System">
      <incoming>Flow_CompleteYes</incoming>
      <outgoing>Flow_ToEnd</outgoing>
    </task>

    <endEvent id="EndEvent_Registered" name="Claims Notification Completed">
      <incoming>Flow_ToEnd</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckInsured" />
    <sequenceFlow id="Flow_2" sourceRef="Task_CheckInsured" targetRef="Gateway_Insured" />

    <sequenceFlow id="Flow_NotInsured" name="No" sourceRef="Gateway_Insured" targetRef="Task_InformRejected" />
    <sequenceFlow id="Flow_IsInsured" name="Yes" sourceRef="Gateway_Insured" targetRef="Task_EvaluateSeverity" />

    <sequenceFlow id="Flow_ToRejectedEnd" sourceRef="Task_InformRejected" targetRef="EndEvent_Rejected" />

    <sequenceFlow id="Flow_3" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_Severity" />

    <sequenceFlow id="Flow_Simple" name="Simple" sourceRef="Gateway_Severity" targetRef="Task_SendSimpleForms" />
    <sequenceFlow id="Flow_Complex" name="Complex" sourceRef="Gateway_Severity" targetRef="Task_SendComplexForms" />

    <sequenceFlow id="Flow_SimpleToMerge" sourceRef="Task_SendSimpleForms" targetRef="Gateway_MergeForms" />
    <sequenceFlow id="Flow_ComplexToMerge" sourceRef="Task_SendComplexForms" targetRef="Gateway_MergeForms" />

    <sequenceFlow id="Flow_ToReceiveForms" sourceRef="Gateway_MergeForms" targetRef="Task_ReceiveForms" />

    <sequenceFlow id="Flow_ToCheckCompleteness" sourceRef="Task_ReceiveForms" targetRef="Task_CheckCompleteness" />

    <sequenceFlow id="Flow_ToCompleteGateway" sourceRef="Task_CheckCompleteness" targetRef="Gateway_Complete" />

    <sequenceFlow id="Flow_Incomplete" name="No" sourceRef="Gateway_Complete" targetRef="Task_InformUpdate" />
    <sequenceFlow id="Flow_CompleteYes" name="Yes" sourceRef="Gateway_Complete" targetRef="Task_RegisterClaim" />

    <sequenceFlow id="Flow_LoopBackToReceive" sourceRef="Task_InformUpdate" targetRef="Task_ReceiveForms" />

    <sequenceFlow id="Flow_ToEnd" sourceRef="Task_RegisterClaim" targetRef="EndEvent_Registered" />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ClaimsNotificationProcess">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="50" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckInsured_di" bpmnElement="Task_CheckInsured">
        <omgdc:Bounds x="130" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Insured_di" bpmnElement="Gateway_Insured" isMarkerVisible="true">
        <omgdc:Bounds x="270" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_InformRejected_di" bpmnElement="Task_InformRejected">
        <omgdc:Bounds x="360" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <omgdc:Bounds x="510" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_EvaluateSeverity_di" bpmnElement="Task_EvaluateSeverity">
        <omgdc:Bounds x="360" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Severity_di" bpmnElement="Gateway_Severity" isMarkerVisible="true">
        <omgdc:Bounds x="500" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendSimpleForms_di" bpmnElement="Task_SendSimpleForms">
        <omgdc:Bounds x="590" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendComplexForms_di" bpmnElement="Task_SendComplexForms">
        <omgdc:Bounds x="590" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergeForms_di" bpmnElement="Gateway_MergeForms" isMarkerVisible="true">
        <omgdc:Bounds x="730" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveForms_di" bpmnElement="Task_ReceiveForms">
        <omgdc:Bounds x="820" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckCompleteness_di" bpmnElement="Task_CheckCompleteness">
        <omgdc:Bounds x="960" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Complete_di" bpmnElement="Gateway_Complete" isMarkerVisible="true">
        <omgdc:Bounds x="1100" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_InformUpdate_di" bpmnElement="Task_InformUpdate">
        <omgdc:Bounds x="1080" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RegisterClaim_di" bpmnElement="Task_RegisterClaim">
        <omgdc:Bounds x="1190" y="178" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Registered_di" bpmnElement="EndEvent_Registered">
        <omgdc:Bounds x="1350" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="86" y="218" />
        <omgdi:waypoint x="130" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="230" y="218" />
        <omgdi:waypoint x="270" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_NotInsured_di" bpmnElement="Flow_NotInsured">
        <omgdi:waypoint x="295" y="193" />
        <omgdi:waypoint x="295" y="100" />
        <omgdi:waypoint x="360" y="100" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_IsInsured_di" bpmnElement="Flow_IsInsured">
        <omgdi:waypoint x="320" y="218" />
        <omgdi:waypoint x="360" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToRejectedEnd_di" bpmnElement="Flow_ToRejectedEnd">
        <omgdi:waypoint x="460" y="100" />
        <omgdi:waypoint x="510" y="100" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="460" y="218" />
        <omgdi:waypoint x="500" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Simple_di" bpmnElement="Flow_Simple">
        <omgdi:waypoint x="525" y="193" />
        <omgdi:waypoint x="525" y="140" />
        <omgdi:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Complex_di" bpmnElement="Flow_Complex">
        <omgdi:waypoint x="525" y="243" />
        <omgdi:waypoint x="525" y="300" />
        <omgdi:waypoint x="590" y="300" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_SimpleToMerge_di" bpmnElement="Flow_SimpleToMerge">
        <omgdi:waypoint x="690" y="140" />
        <omgdi:waypoint x="755" y="140" />
        <omgdi:waypoint x="755" y="193" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ComplexToMerge_di" bpmnElement="Flow_ComplexToMerge">
        <omgdi:waypoint x="690" y="300" />
        <omgdi:waypoint x="755" y="300" />
        <omgdi:waypoint x="755" y="243" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToReceiveForms_di" bpmnElement="Flow_ToReceiveForms">
        <omgdi:waypoint x="780" y="218" />
        <omgdi:waypoint x="820" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToCheckCompleteness_di" bpmnElement="Flow_ToCheckCompleteness">
        <omgdi:waypoint x="920" y="218" />
        <omgdi:waypoint x="960" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToCompleteGateway_di" bpmnElement="Flow_ToCompleteGateway">
        <omgdi:waypoint x="1060" y="218" />
        <omgdi:waypoint x="1100" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Incomplete_di" bpmnElement="Flow_Incomplete">
        <omgdi:waypoint x="1125" y="243" />
        <omgdi:waypoint x="1125" y="320" />
        <omgdi:waypoint x="1130" y="320" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CompleteYes_di" bpmnElement="Flow_CompleteYes">
        <omgdi:waypoint x="1150" y="218" />
        <omgdi:waypoint x="1190" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_LoopBackToReceive_di" bpmnElement="Flow_LoopBackToReceive">
        <omgdi:waypoint x="1080" y="360" />
        <omgdi:waypoint x="870" y="360" />
        <omgdi:waypoint x="870" y="258" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <omgdi:waypoint x="1300" y="218" />
        <omgdi:waypoint x="1350" y="218" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
