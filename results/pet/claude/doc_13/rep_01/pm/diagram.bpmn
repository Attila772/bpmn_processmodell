<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do1" name="Claim Forms" dataObjectRef="do1_do" />
    <bpmn:dataObject id="do1_do" />
    <bpmn:dataObjectReference id="do2" name="Updated Claim Forms" dataObjectRef="do2_do" />
    <bpmn:dataObject id="do2_do" />
    <bpmn:startEvent id="e1" name="Claim received">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Claim rejected">
      <bpmn:incoming>sf4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Claims Notification process ended">
      <bpmn:incoming>sf15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1" name="Check whether claimant is insured">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf1b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Inform claimant that claim must be rejected">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Evaluate severity of claim">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Send relevant forms for simple claim">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t4_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t5" name="Send relevant forms for complex claim">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t5_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t6" name="Check forms for completeness">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:property id="t6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t6_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:userTask id="t7" name="Register claim in Claims Management system">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
      <bpmn:property id="t7_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t7_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t7_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:task id="t8" name="Inform claimant to update forms">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Receive updated forms">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t9_doa0">
        <bpmn:targetRef>do2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Insured?" isMarkerVisible="true">
      <bpmn:incoming>sf1b</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:outgoing>sf7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Forms complete?" isMarkerVisible="true">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:outgoing>sf12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf1" sourceRef="e1" targetRef="t1" />
    <bpmn:sequenceFlow id="sf2" sourceRef="g1" targetRef="t2" name="not insured" />
    <bpmn:sequenceFlow id="sf3" sourceRef="g1" targetRef="t3" name="insured" />
    <bpmn:sequenceFlow id="sf1b" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="sf4" sourceRef="t2" targetRef="e2" />
    <bpmn:sequenceFlow id="sf5" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="sf6" sourceRef="g2" targetRef="t4" name="simple" />
    <bpmn:sequenceFlow id="sf7" sourceRef="g2" targetRef="t5" name="complex" />
    <bpmn:sequenceFlow id="sf8" sourceRef="t4" targetRef="t6" />
    <bpmn:sequenceFlow id="sf9" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="sf10" sourceRef="t6" targetRef="g3" />
    <bpmn:sequenceFlow id="sf11" sourceRef="g3" targetRef="t7" name="complete" />
    <bpmn:sequenceFlow id="sf12" sourceRef="g3" targetRef="t8" name="incomplete" />
    <bpmn:sequenceFlow id="sf13" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="sf14" sourceRef="t9" targetRef="t6" />
    <bpmn:sequenceFlow id="sf15" sourceRef="t7" targetRef="e3" />
  </bpmn:process>
