<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do1" name="Claim Forms" dataObjectRef="do1_do" />
    <bpmn:dataObject id="do1_do" />
    <bpmn:dataStoreReference id="ds1" name="Claims Management System" />
    <bpmn:dataObjectReference id="do2" name="Updated Claim Forms" dataObjectRef="do2_do" />
    <bpmn:dataObject id="do2_do" />
    <bpmn:startEvent id="e1" name="Claim received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Claimant informed of rejection">
      <bpmn:incoming>f_a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Claim registered">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1" name="Check whether claimant is insured">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Inform claimant that claim must be rejected">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f_a</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Evaluate severity of claim">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Send forms for simple claim">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t4_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t5" name="Send forms for complex claim">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t5_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t6" name="Check forms for completeness">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:property id="t6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t6_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:userTask id="t7" name="Register claim in Claims Management system">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:property id="t7_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t7_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t7_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t7_doa0">
        <bpmn:targetRef>ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="t8" name="Inform claimant to update forms">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Receive updated forms">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t9_doa0">
        <bpmn:targetRef>do2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Is claimant insured?" isMarkerVisible="true">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="Severity of claim?" isMarkerVisible="true">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Forms complete?" isMarkerVisible="true">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f1" sourceRef="e1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g1" name="not insured" />
    <bpmn:sequenceFlow id="f3" sourceRef="g1" targetRef="t2" name="not insured" />
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t3" name="insured" />
    <bpmn:sequenceFlow id="f_a" sourceRef="t2" targetRef="e2" />
    <bpmn:sequenceFlow id="f5" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f6" sourceRef="g2" targetRef="t4" name="simple" />
    <bpmn:sequenceFlow id="f7" sourceRef="g2" targetRef="t5" name="complex" />
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="t6" />
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="g3" />
    <bpmn:sequenceFlow id="f11" sourceRef="g3" targetRef="t7" name="complete" />
    <bpmn:sequenceFlow id="f12" sourceRef="g3" targetRef="t8" name="incomplete" />
    <bpmn:sequenceFlow id="f13" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f14" sourceRef="t9" targetRef="t6" />
    <bpmn:sequenceFlow id="f15" sourceRef="t7" targetRef="e3" />
  </bpmn:process>
