<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_loan_request" name="Customer loan request" dataObjectRef="data_loan_request_do" />
    <bpmn:dataObject id="data_loan_request_do" />
    <bpmn:dataObjectReference id="data_risk_assessment" name="Risk assessment result" dataObjectRef="data_risk_assessment_do" />
    <bpmn:dataObject id="data_risk_assessment_do" />
    <bpmn:dataObjectReference id="data_decision" name="Approval decision" dataObjectRef="data_decision_do" />
    <bpmn:dataObject id="data_decision_do" />
    <bpmn:startEvent id="start1" name="Customer loan request received">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_approved" name="Loan approved - customer notified">
      <bpmn:incoming>flow_small_low</bpmn:incoming>
      <bpmn:incoming>flow3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_denied" name="Loan denied - customer notified">
      <bpmn:incoming>flow_high_risk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_assess" name="Assess risk (Risk Assessment Web service)">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:property id="task_assess_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_assess_dia0">
        <bpmn:sourceRef>data_loan_request</bpmn:sourceRef>
        <bpmn:targetRef>task_assess_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_assess_doa0">
        <bpmn:targetRef>data_risk_assessment</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_approve_service" name="Evaluate request (Approver Web service)">
      <bpmn:incoming>flow_review_or_large</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:property id="task_approve_service_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_approve_service_dia0">
        <bpmn:sourceRef>data_loan_request</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_service_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_approve_service_dia1">
        <bpmn:sourceRef>data_risk_assessment</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_service_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_approve_service_doa0">
        <bpmn:targetRef>data_decision</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_risk" name="Risk and amount check" isMarkerVisible="true">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:outgoing>flow_small_low</bpmn:outgoing>
      <bpmn:outgoing>flow_high_risk</bpmn:outgoing>
      <bpmn:outgoing>flow_review_or_large</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow1" sourceRef="start1" targetRef="task_assess" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task_assess" targetRef="gw_risk" />
    <bpmn:sequenceFlow id="flow_small_low" sourceRef="gw_risk" targetRef="end_approved" name="loan small and customer low risk" />
    <bpmn:sequenceFlow id="flow_high_risk" sourceRef="gw_risk" targetRef="end_denied" name="customer high risk" />
    <bpmn:sequenceFlow id="flow_review_or_large" sourceRef="gw_risk" targetRef="task_approve_service" name="needs further review or amount &gt;= $10,000" />
    <bpmn:sequenceFlow id="flow3" sourceRef="task_approve_service" targetRef="end_approved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_approved_di" bpmnElement="end_approved">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_denied_di" bpmnElement="end_denied">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_risk_di" bpmnElement="gw_risk">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_service_di" bpmnElement="task_approve_service">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assess_di" bpmnElement="task_assess">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_loan_request_di" bpmnElement="data_loan_request">
        <dc:Bounds x="560" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_risk_assessment_di" bpmnElement="data_risk_assessment">
        <dc:Bounds x="560" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_decision_di" bpmnElement="data_decision">
        <dc:Bounds x="750" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_small_low_di" bpmnElement="flow_small_low">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_high_risk_di" bpmnElement="flow_high_risk">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_or_large_di" bpmnElement="flow_review_or_large">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_assess_dia0_di" bpmnElement="task_assess_dia0">
        <di:waypoint x="578" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_assess_doa0_di" bpmnElement="task_assess_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="578" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_approve_service_dia0_di" bpmnElement="task_approve_service_dia0">
        <di:waypoint x="578" y="390" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_approve_service_dia1_di" bpmnElement="task_approve_service_dia1">
        <di:waypoint x="578" y="390" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_approve_service_doa0_di" bpmnElement="task_approve_service_doa0">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="768" y="390" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>