<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data1" name="Customer loan request" dataObjectRef="data1_do" />
    <bpmn:dataObject id="data1_do" />
    <bpmn:dataObjectReference id="data2" name="Risk assessment result" dataObjectRef="data2_do" />
    <bpmn:dataObject id="data2_do" />
    <bpmn:dataObjectReference id="data3" name="Approver decision" dataObjectRef="data3_do" />
    <bpmn:dataObject id="data3_do" />
    <bpmn:startEvent id="start1" name="Customer request for loan received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="Loan approved">
      <bpmn:incoming>flow_gw1_approve</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end2" name="Loan denied">
      <bpmn:incoming>flow_gw1_deny</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end3" name="Loan decided by approver">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task1" name="Assess risk (invoke risk assessment Web service)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:property id="task1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task1_dia0">
        <bpmn:sourceRef>data1</bpmn:sourceRef>
        <bpmn:targetRef>task1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task1_doa0">
        <bpmn:targetRef>data2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task2" name="Send request to approver Web service">
      <bpmn:incoming>flow_gw1_review</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:property id="task2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task2_dia0">
        <bpmn:sourceRef>data2</bpmn:sourceRef>
        <bpmn:targetRef>task2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task2_doa0">
        <bpmn:targetRef>data3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task3" name="Notify customer of decision">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="task3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task3_dia0">
        <bpmn:sourceRef>data2</bpmn:sourceRef>
        <bpmn:targetRef>task3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task3_dia1">
        <bpmn:sourceRef>data3</bpmn:sourceRef>
        <bpmn:targetRef>task3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw1" name="Risk assessment outcome" isMarkerVisible="true">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>flow_gw1_approve</bpmn:outgoing>
      <bpmn:outgoing>flow_gw1_deny</bpmn:outgoing>
      <bpmn:outgoing>flow_gw1_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="task1" />
    <bpmn:sequenceFlow id="f2" sourceRef="task1" targetRef="gw1" />
    <bpmn:sequenceFlow id="flow_gw1_approve" sourceRef="gw1" targetRef="end1" name="small loan and low risk" />
    <bpmn:sequenceFlow id="flow_gw1_deny" sourceRef="gw1" targetRef="end2" name="high risk" />
    <bpmn:sequenceFlow id="flow_gw1_review" sourceRef="gw1" targetRef="task2" name="needs further review or amount &gt;= $10,000" />
    <bpmn:sequenceFlow id="f3" sourceRef="task2" targetRef="task3" />
    <bpmn:sequenceFlow id="f4" sourceRef="task3" targetRef="end3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end1_di" bpmnElement="end1">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end2_di" bpmnElement="end2">
        <dc:Bounds x="730" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end3_di" bpmnElement="end3">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw1_di" bpmnElement="gw1">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task1_di" bpmnElement="task1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task2_di" bpmnElement="task2">
        <dc:Bounds x="730" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task3_di" bpmnElement="task3">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data1_di" bpmnElement="data1">
        <dc:Bounds x="370" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data2_di" bpmnElement="data2">
        <dc:Bounds x="686" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data3_di" bpmnElement="data3">
        <dc:Bounds x="845" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_approve_di" bpmnElement="flow_gw1_approve">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_deny_di" bpmnElement="flow_gw1_deny">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="748" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_review_di" bpmnElement="flow_gw1_review">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="780" y="390" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task1_dia0_di" bpmnElement="task1_dia0">
        <di:waypoint x="388" y="515" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task1_doa0_di" bpmnElement="task1_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="704" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task2_dia0_di" bpmnElement="task2_dia0">
        <di:waypoint x="704" y="515" />
        <di:waypoint x="780" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task2_doa0_di" bpmnElement="task2_doa0">
        <di:waypoint x="780" y="390" />
        <di:waypoint x="863" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task3_dia0_di" bpmnElement="task3_dia0">
        <di:waypoint x="704" y="515" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task3_dia1_di" bpmnElement="task3_dia1">
        <di:waypoint x="863" y="515" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>