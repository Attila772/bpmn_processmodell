      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task5_dia1_di" bpmnElement="task5_dia1">
        <di:waypoint x="958" y="265" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task5_doa0_di" bpmnElement="task5_doa0">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1148" y="265" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>