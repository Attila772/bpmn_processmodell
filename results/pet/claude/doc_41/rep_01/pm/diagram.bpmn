<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool1_part" name="Claims Department" processRef="pool1_proc" />
  </bpmn:collaboration>
  <bpmn:process id="pool1_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_police_report" name="Police Report" dataObjectRef="data_police_report_do" />
    <bpmn:dataObject id="data_police_report_do" />
    <bpmn:dataObjectReference id="data_claim_documentation" name="Claim Documentation" dataObjectRef="data_claim_documentation_do" />
    <bpmn:dataObject id="data_claim_documentation_do" />
    <bpmn:dataObjectReference id="data_claim_file" name="Claim File" dataObjectRef="data_claim_file_do" />
    <bpmn:dataObject id="data_claim_file_do" />
    <bpmn:dataObjectReference id="data_claim_estimate" name="Initial Claim Estimate" dataObjectRef="data_claim_estimate_do" />
    <bpmn:dataObject id="data_claim_estimate_do" />
    <bpmn:dataObjectReference id="data_action_plan_checklist" name="Action Plan Checklist" dataObjectRef="data_action_plan_checklist_do" />
    <bpmn:dataObject id="data_action_plan_checklist_do" />
    <bpmn:dataObjectReference id="data_action_plan" name="Action Plan" dataObjectRef="data_action_plan_do" />
    <bpmn:dataObject id="data_action_plan_do" />
    <bpmn:dataObjectReference id="data_settlement_outcome" name="Settlement Outcome" dataObjectRef="data_settlement_outcome_do" />
    <bpmn:dataObject id="data_settlement_outcome_do" />
    <bpmn:startEvent id="start1" name="Claim Received">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="Claimant Informed">
      <bpmn:incoming>flow6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task1" name="Search Police Report in Police Report Database">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task1_doa0">
        <bpmn:targetRef>data_police_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task2" name="Compile File with Police Report and Claim Documentation">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:property id="task2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task2_dia0">
        <bpmn:sourceRef>data_police_report</bpmn:sourceRef>
        <bpmn:targetRef>task2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task2_dia1">
        <bpmn:sourceRef>data_claim_documentation</bpmn:sourceRef>
        <bpmn:targetRef>task2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task2_doa0">
        <bpmn:targetRef>data_claim_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task3" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
      <bpmn:property id="task3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task3_dia0">
        <bpmn:sourceRef>data_claim_file</bpmn:sourceRef>
        <bpmn:targetRef>task3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task3_doa0">
        <bpmn:targetRef>data_claim_estimate</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task4" name="Create Action Plan based on Action Plan Checklist">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:outgoing>flow5</bpmn:outgoing>
      <bpmn:property id="task4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task4_dia0">
        <bpmn:sourceRef>data_action_plan_checklist</bpmn:sourceRef>
        <bpmn:targetRef>task4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task4_doa0">
        <bpmn:targetRef>data_action_plan</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task5" name="Negotiate Settlement on Claim Estimate">
      <bpmn:incoming>flow5</bpmn:incoming>
      <bpmn:outgoing>flow6</bpmn:outgoing>
      <bpmn:property id="task5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task5_dia0">
        <bpmn:sourceRef>data_action_plan</bpmn:sourceRef>
        <bpmn:targetRef>task5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task5_dia1">
        <bpmn:sourceRef>data_claim_estimate</bpmn:sourceRef>
        <bpmn:targetRef>task5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task5_doa0">
        <bpmn:targetRef>data_settlement_outcome</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow1" sourceRef="start1" targetRef="task1" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task1" targetRef="task2" />
    <bpmn:sequenceFlow id="flow3" sourceRef="task2" targetRef="task3" />
    <bpmn:sequenceFlow id="flow4" sourceRef="task3" targetRef="task4" />
    <bpmn:sequenceFlow id="flow5" sourceRef="task4" targetRef="task5" />
    <bpmn:sequenceFlow id="flow6" sourceRef="task5" targetRef="end1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool1_part_di" bpmnElement="pool1_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1520" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end1_di" bpmnElement="end1">
        <dc:Bounds x="1300" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task1_di" bpmnElement="task1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task2_di" bpmnElement="task2">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task3_di" bpmnElement="task3">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task4_di" bpmnElement="task4">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task5_di" bpmnElement="task5">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_police_report_di" bpmnElement="data_police_report">
        <dc:Bounds x="465" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_claim_documentation_di" bpmnElement="data_claim_documentation">
        <dc:Bounds x="560" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_claim_file_di" bpmnElement="data_claim_file">
        <dc:Bounds x="655" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_claim_estimate_di" bpmnElement="data_claim_estimate">
        <dc:Bounds x="940" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_action_plan_checklist_di" bpmnElement="data_action_plan_checklist">
        <dc:Bounds x="940" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_action_plan_di" bpmnElement="data_action_plan">
        <dc:Bounds x="1035" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_settlement_outcome_di" bpmnElement="data_settlement_outcome">
        <dc:Bounds x="1130" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow5_di" bpmnElement="flow5">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow6_di" bpmnElement="flow6">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1318" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task1_doa0_di" bpmnElement="task1_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task2_dia0_di" bpmnElement="task2_dia0">
        <di:waypoint x="483" y="265" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task2_dia1_di" bpmnElement="task2_dia1">
        <di:waypoint x="578" y="265" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task2_doa0_di" bpmnElement="task2_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="673" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task3_dia0_di" bpmnElement="task3_dia0">
        <di:waypoint x="673" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task3_doa0_di" bpmnElement="task3_doa0">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="958" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task4_dia0_di" bpmnElement="task4_dia0">
        <di:waypoint x="958" y="265" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task4_doa0_di" bpmnElement="task4_doa0">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1053" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task5_dia0_di" bpmnElement="task5_dia0">
        <di:waypoint x="1053" y="265" />
