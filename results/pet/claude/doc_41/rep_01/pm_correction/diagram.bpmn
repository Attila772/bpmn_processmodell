<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_claims_part" name="Insurance Claims Department" processRef="pool_claims_proc" />
  </bpmn:collaboration>
  <bpmn:process id="pool_claims_proc" isExecutable="false">
    <bpmn:dataStoreReference id="ds_police_report_db" name="Police Report Database" />
    <bpmn:dataObjectReference id="do_police_report" name="Police Report" dataObjectRef="do_police_report_do" />
    <bpmn:dataObject id="do_police_report_do" />
    <bpmn:dataObjectReference id="do_claim_file" name="Claim File" dataObjectRef="do_claim_file_do" />
    <bpmn:dataObject id="do_claim_file_do" />
    <bpmn:dataObjectReference id="do_claim_documentation" name="Claim Documentation" dataObjectRef="do_claim_documentation_do" />
    <bpmn:dataObject id="do_claim_documentation_do" />
    <bpmn:dataObjectReference id="do_claim_estimate" name="Initial Claim Estimate" dataObjectRef="do_claim_estimate_do" />
    <bpmn:dataObject id="do_claim_estimate_do" />
    <bpmn:dataObjectReference id="do_action_plan_checklist" name="Action Plan Checklist" dataObjectRef="do_action_plan_checklist_do" />
    <bpmn:dataObject id="do_action_plan_checklist_do" />
    <bpmn:dataObjectReference id="do_action_plan" name="Action Plan" dataObjectRef="do_action_plan_do" />
    <bpmn:dataObject id="do_action_plan_do" />
    <bpmn:dataObjectReference id="do_settlement" name="Settlement Outcome" dataObjectRef="do_settlement_do" />
    <bpmn:dataObject id="do_settlement_do" />
    <bpmn:startEvent id="start1" name="Claim received">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="Claimant informed">
      <bpmn:incoming>sf5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task1" name="Search Police Report in Police Report database">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:property id="task1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task1_dia0">
        <bpmn:sourceRef>ds_police_report_db</bpmn:sourceRef>
        <bpmn:targetRef>task1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task1_doa0">
        <bpmn:targetRef>do_police_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task1_doa1">
        <bpmn:targetRef>do_claim_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task2" name="Calculate initial claim estimate">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:property id="task2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task2_dia0">
        <bpmn:sourceRef>do_claim_file</bpmn:sourceRef>
        <bpmn:targetRef>task2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task2_dia1">
        <bpmn:sourceRef>do_claim_documentation</bpmn:sourceRef>
        <bpmn:targetRef>task2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task2_doa0">
        <bpmn:targetRef>do_claim_estimate</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task3" name="Create Action Plan based on Action Plan Checklist">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="task3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task3_dia0">
        <bpmn:sourceRef>do_action_plan_checklist</bpmn:sourceRef>
        <bpmn:targetRef>task3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task3_doa0">
        <bpmn:targetRef>do_action_plan</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task4" name="Negotiate settlement on claim estimate">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:property id="task4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task4_dia0">
        <bpmn:sourceRef>do_action_plan</bpmn:sourceRef>
        <bpmn:targetRef>task4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task4_dia1">
        <bpmn:sourceRef>do_claim_estimate</bpmn:sourceRef>
        <bpmn:targetRef>task4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task4_doa0">
        <bpmn:targetRef>do_settlement</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf1" sourceRef="start1" targetRef="task1" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task1" targetRef="task2" />
    <bpmn:sequenceFlow id="sf3" sourceRef="task2" targetRef="task3" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task3" targetRef="task4" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task4" targetRef="end1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_claims_part_di" bpmnElement="pool_claims_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1330" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end1_di" bpmnElement="end1">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task1_di" bpmnElement="task1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task2_di" bpmnElement="task2">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task3_di" bpmnElement="task3">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task4_di" bpmnElement="task4">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ds_police_report_db_di" bpmnElement="ds_police_report_db">
        <dc:Bounds x="370" y="240" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_police_report_di" bpmnElement="do_police_report">
        <dc:Bounds x="370" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_claim_file_di" bpmnElement="do_claim_file">
        <dc:Bounds x="465" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_claim_documentation_di" bpmnElement="do_claim_documentation">
        <dc:Bounds x="560" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_claim_estimate_di" bpmnElement="do_claim_estimate">
        <dc:Bounds x="750" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_action_plan_checklist_di" bpmnElement="do_action_plan_checklist">
        <dc:Bounds x="750" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_action_plan_di" bpmnElement="do_action_plan">
        <dc:Bounds x="845" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_settlement_di" bpmnElement="do_settlement">
        <dc:Bounds x="940" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf4_di" bpmnElement="sf4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf5_di" bpmnElement="sf5">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task1_dia0_di" bpmnElement="task1_dia0">
        <di:waypoint x="395" y="265" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task1_doa0_di" bpmnElement="task1_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="388" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task1_doa1_di" bpmnElement="task1_doa1">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task2_dia0_di" bpmnElement="task2_dia0">
        <di:waypoint x="483" y="265" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task2_dia1_di" bpmnElement="task2_dia1">
        <di:waypoint x="578" y="265" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task2_doa0_di" bpmnElement="task2_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="768" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task3_dia0_di" bpmnElement="task3_dia0">
        <di:waypoint x="768" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task3_doa0_di" bpmnElement="task3_doa0">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="863" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task4_dia0_di" bpmnElement="task4_dia0">
        <di:waypoint x="863" y="265" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task4_dia1_di" bpmnElement="task4_dia1">
        <di:waypoint x="768" y="265" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task4_doa0_di" bpmnElement="task4_doa0">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="958" y="265" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>