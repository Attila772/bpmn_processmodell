<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_employee_part" name="Employee" processRef="pool_employee_proc" />
    <bpmn:participant id="pool_supervisor_part" name="Supervisor" processRef="pool_supervisor_proc" />
    <bpmn:participant id="pool_treasurer_part" name="Treasurer" processRef="pool_treasurer_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_event_emp_submit1" targetRef="start_event_sup_receive" name="Expense Report Submitted" />
    <bpmn:messageFlow id="mf2" sourceRef="end_event_sup_approve" targetRef="start_event_treas_receive" name="Expense Report Approved" />
    <bpmn:messageFlow id="mf3" sourceRef="end_event_sup_reject" targetRef="start_event_emp_receive_reject" name="Expense Report Rejected" />
    <bpmn:messageFlow id="mf4" sourceRef="end_event_emp_submit2" targetRef="start_event_sup_receive" name="Expense Report Resubmitted" />
    <bpmn:messageFlow id="mf5" sourceRef="end_event_treas_reject" targetRef="start_event_emp_receive_reject" name="Expense Report Rejected" />
  </bpmn:collaboration>
  <bpmn:process id="pool_employee_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_expense_report" name="Költségelszámolás (tételek listája)" dataObjectRef="data_expense_report_do" />
    <bpmn:dataObject id="data_expense_report_do" />
    <bpmn:dataObjectReference id="data_receipts" name="Bizonylatok/nyugták" dataObjectRef="data_receipts_do" />
    <bpmn:dataObject id="data_receipts_do" />
    <bpmn:startEvent id="start_purchase" name="Need for purchase arises">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_emp_submit1" name="Report sent to supervisor">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_event_emp_submit1_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_event_emp_receive_reject" name="Rejected report received">
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_event_emp_receive_reject_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_emp_submit2" name="Edited report resubmitted to supervisor">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_event_emp_submit2_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_purchase" name="Termék vagy szolgáltatás megvásárlása">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_submit_report" name="Költségelszámolás benyújtása tételekkel és bizonylatokkal">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_submit_report_doa0">
        <bpmn:targetRef>data_expense_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_submit_report_doa1">
        <bpmn:targetRef>data_receipts</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_edit_report" name="Költségelszámolás javítása">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:property id="task_edit_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_edit_report_dia0">
        <bpmn:sourceRef>data_expense_report</bpmn:sourceRef>
        <bpmn:targetRef>task_edit_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_edit_report_doa0">
        <bpmn:targetRef>data_expense_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_purchase" targetRef="task_purchase" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task_purchase" targetRef="task_submit_report" />
    <bpmn:sequenceFlow id="sf3" sourceRef="task_submit_report" targetRef="end_event_emp_submit1" />
    <bpmn:sequenceFlow id="sf6" sourceRef="start_event_emp_receive_reject" targetRef="task_edit_report" />
    <bpmn:sequenceFlow id="sf7" sourceRef="task_edit_report" targetRef="end_event_emp_submit2" />
  </bpmn:process>
  <bpmn:process id="pool_supervisor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_expense_report_p1" name="Költségelszámolás (tételek listája)" dataObjectRef="data_expense_report_p1_do" />
    <bpmn:dataObject id="data_expense_report_p1_do" />
    <bpmn:dataObjectReference id="data_receipts_p1" name="Bizonylatok/nyugták" dataObjectRef="data_receipts_p1_do" />
    <bpmn:dataObject id="data_receipts_p1_do" />
    <bpmn:startEvent id="start_event_sup_receive" name="Report received from employee">
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_event_sup_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_sup_approve" name="Report approved, sent to treasurer">
      <bpmn:incoming>flow_sup_approve</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_event_sup_approve_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_sup_reject" name="Report rejected, sent to employee">
      <bpmn:incoming>flow_sup_reject</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_event_sup_reject_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_review_report" name="Költségelszámolás felülvizsgálata">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:property id="task_review_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_report_dia0">
        <bpmn:sourceRef>data_expense_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_review_report_dia1">
        <bpmn:sourceRef>data_receipts_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_sup_decision" name="Supervisor decision" isMarkerVisible="true">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>flow_sup_approve</bpmn:outgoing>
      <bpmn:outgoing>flow_sup_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf4" sourceRef="start_event_sup_receive" targetRef="task_review_report" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task_review_report" targetRef="gw_sup_decision" />
    <bpmn:sequenceFlow id="flow_sup_approve" sourceRef="gw_sup_decision" targetRef="end_event_sup_approve" name="elfogadva" />
    <bpmn:sequenceFlow id="flow_sup_reject" sourceRef="gw_sup_decision" targetRef="end_event_sup_reject" name="elutasítva" />
  </bpmn:process>
  <bpmn:process id="pool_treasurer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_expense_report_p2" name="Költségelszámolás (tételek listája)" dataObjectRef="data_expense_report_p2_do" />
    <bpmn:dataObject id="data_expense_report_p2_do" />
    <bpmn:dataObjectReference id="data_receipts_p2" name="Bizonylatok/nyugták" dataObjectRef="data_receipts_p2_do" />
    <bpmn:dataObject id="data_receipts_p2_do" />
    <bpmn:dataObjectReference id="data_payment_record" name="Fizetési visszaigazolás" dataObjectRef="data_payment_record_do" />
    <bpmn:dataObject id="data_payment_record_do" />
    <bpmn:startEvent id="start_event_treas_receive" name="Approved report received from supervisor">
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_event_treas_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_treas_reject" name="Report sent back to employee">
      <bpmn:incoming>flow_treas_reject</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_event_treas_reject_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="intermediate_wait_payment" name="Waiting for payment confirmation">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="intermediate_wait_payment_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_event_process_end" name="Process ends">
      <bpmn:incoming>sf12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_receipts" name="Bizonylatok ellenőrzése a tételekkel">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="task_check_receipts_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_receipts_dia0">
        <bpmn:sourceRef>data_expense_report_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_check_receipts_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_check_receipts_dia1">
        <bpmn:sourceRef>data_receipts_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_check_receipts_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_accept_expenses" name="Költségek elfogadása feldolgozásra (kifizetés, könyvelés)">
      <bpmn:incoming>flow_treas_accept</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:property id="task_accept_expenses_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_accept_expenses_dia0">
        <bpmn:sourceRef>data_expense_report_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_accept_expenses_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_link_payment_system" name="Kapcsolódás a fizetési rendszerhez (automatikus)">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_link_payment_system_doa0">
        <bpmn:targetRef>data_payment_record</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_treas_decision" name="Treasurer decision" isMarkerVisible="true">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>flow_treas_accept</bpmn:outgoing>
      <bpmn:outgoing>flow_treas_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf8" sourceRef="start_event_treas_receive" targetRef="task_check_receipts" />
    <bpmn:sequenceFlow id="sf9" sourceRef="task_check_receipts" targetRef="gw_treas_decision" />
    <bpmn:sequenceFlow id="flow_treas_accept" sourceRef="gw_treas_decision" targetRef="task_accept_expenses" name="minden rendben" />
    <bpmn:sequenceFlow id="flow_treas_reject" sourceRef="gw_treas_decision" targetRef="end_event_treas_reject" name="hiányzó vagy nem egyező bizonylat" />
    <bpmn:sequenceFlow id="sf10" sourceRef="task_accept_expenses" targetRef="task_link_payment_system" />
    <bpmn:sequenceFlow id="sf11" sourceRef="task_link_payment_system" targetRef="intermediate_wait_payment" />
    <bpmn:sequenceFlow id="sf12" sourceRef="intermediate_wait_payment" targetRef="end_event_process_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_employee_part_di" bpmnElement="pool_employee_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="950" height="400" />
