<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_Assembler" name="Assembler AG" processRef="Process_Assembler"/>
    <participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier"/>
    <messageFlow id="MessageFlow_Order" sourceRef="Task_SendOrder" targetRef="StartEvent_ReceiveOrder"/>
    <messageFlow id="MessageFlow_Invoice" sourceRef="Task_SendInvoice" targetRef="Task_ReceiveInvoice"/>
  </collaboration>

  <process id="Process_Assembler" name="Assembler AG" isExecutable="false">
    <startEvent id="StartEvent_Timer" name="First of each month">
      <outgoing>Flow_1</outgoing>
      <timerEventDefinition id="TimerEventDefinition_1">
        <timeCycle>0 0 0 1 * ?</timeCycle>
      </timerEventDefinition>
    </startEvent>

    <task id="Task_SendOrder" name="Send order to supplier">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <task id="Task_ReceiveInvoice" name="Receive invoice">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <endEvent id="EndEvent_Assembler" name="Order process completed">
      <incoming>Flow_3</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_Timer" targetRef="Task_SendOrder"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_SendOrder" targetRef="Task_ReceiveInvoice"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_ReceiveInvoice" targetRef="EndEvent_Assembler"/>
  </process>

  <process id="Process_Supplier" name="Supplier" isExecutable="false">
    <startEvent id="StartEvent_ReceiveOrder" name="Order received">
      <outgoing>Flow_4</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1"/>
    </startEvent>

    <task id="Task_ProcessOrder" name="Process order">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
    </task>

    <task id="Task_SendInvoice" name="Send invoice to Assembler AG">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </task>

    <endEvent id="EndEvent_Supplier" name="Invoice sent">
      <incoming>Flow_6</incoming>
    </endEvent>

    <sequenceFlow id="Flow_4" sourceRef="StartEvent_ReceiveOrder" targetRef="Task_ProcessOrder"/>
    <sequenceFlow id="Flow_5" sourceRef="Task_ProcessOrder" targetRef="Task_SendInvoice"/>
    <sequenceFlow id="Flow_6" sourceRef="Task_SendInvoice" targetRef="EndEvent_Supplier"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_Assembler_di" bpmnElement="Participant_Assembler" isHorizontal="true">
        <omgdc:Bounds x="120" y="60" width="700" height="180"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Timer_di" bpmnElement="StartEvent_Timer">
        <omgdc:Bounds x="160" y="130" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendOrder_di" bpmnElement="Task_SendOrder">
        <omgdc:Bounds x="260" y="110" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveInvoice_di" bpmnElement="Task_ReceiveInvoice">
        <omgdc:Bounds x="500" y="110" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Assembler_di" bpmnElement="EndEvent_Assembler">
        <omgdc:Bounds x="700" y="130" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="196" y="148"/>
        <omgdi:waypoint x="260" y="150"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="360" y="150"/>
        <omgdi:waypoint x="500" y="150"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="600" y="150"/>
        <omgdi:waypoint x="700" y="148"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_Supplier_di" bpmnElement="Participant_Supplier" isHorizontal="true">
        <omgdc:Bounds x="120" y="300" width="700" height="180"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_ReceiveOrder_di" bpmnElement="StartEvent_ReceiveOrder">
        <omgdc:Bounds x="160" y="370" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcessOrder_di" bpmnElement="Task_ProcessOrder">
        <omgdc:Bounds x="260" y="350" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendInvoice_di" bpmnElement="Task_SendInvoice">
        <omgdc:Bounds x="500" y="350" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Supplier_di" bpmnElement="EndEvent_Supplier">
        <omgdc:Bounds x="700" y="370" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="196" y="388"/>
        <omgdi:waypoint x="260" y="390"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="360" y="390"/>
        <omgdi:waypoint x="500" y="390"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="600" y="390"/>
        <omgdi:waypoint x="700" y="388"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Order_di" bpmnElement="MessageFlow_Order">
        <omgdi:waypoint x="310" y="190"/>
        <omgdi:waypoint x="310" y="270"/>
        <omgdi:waypoint x="178" y="270"/>
        <omgdi:waypoint x="178" y="370"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Invoice_di" bpmnElement="MessageFlow_Invoice">
        <omgdi:waypoint x="550" y="350"/>
        <omgdi:waypoint x="550" y="270"/>
        <omgdi:waypoint x="550" y="190"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
