<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_assembler_part" name="Assembler AG" processRef="pool_assembler_proc" />
    <bpmn:participant id="pool_supplier_part" name="Supplier" processRef="pool_supplier_proc" />
    <bpmn:messageFlow id="mf_1" sourceRef="end_send_order" targetRef="start_receive_order" name="Bestellung" />
    <bpmn:messageFlow id="mf_2" sourceRef="end_2" targetRef="event_receive_invoice" name="Rechnung" />
  </bpmn:collaboration>
  <bpmn:process id="pool_assembler_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_order" name="Bestellung" dataObjectRef="doc_order_do" />
    <bpmn:dataObject id="doc_order_do" />
    <bpmn:startEvent id="start_1" name="Erster Tag des Monats">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="start_1_timerdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_order" name="Bestellung gesendet">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_order_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="event_receive_invoice" name="Rechnung empfangen">
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_invoice_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_1" name="Prozessende">
      <bpmn:incoming>sf_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_send_order" name="Bestellung an Lieferant senden">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_order_doa0">
        <bpmn:targetRef>doc_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="sf_1" sourceRef="start_1" targetRef="task_send_order" />
    <bpmn:sequenceFlow id="sf_2" sourceRef="task_send_order" targetRef="end_send_order" />
    <bpmn:sequenceFlow id="sf_6" sourceRef="event_receive_invoice" targetRef="end_1" />
  </bpmn:process>
  <bpmn:process id="pool_supplier_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_order_p1" name="Bestellung" dataObjectRef="doc_order_p1_do" />
    <bpmn:dataObject id="doc_order_p1_do" />
    <bpmn:dataObjectReference id="doc_invoice" name="Rechnung" dataObjectRef="doc_invoice_do" />
    <bpmn:dataObject id="doc_invoice_do" />
    <bpmn:startEvent id="start_receive_order" name="Bestellung empfangen">
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_order_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_2" name="Rechnung gesendet">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_2_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_process_order" name="Bestellung bearbeiten">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:property id="task_process_order_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_process_order_dia0">
        <bpmn:sourceRef>doc_order_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_process_order_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_send_invoice" name="Rechnung an Assembler AG senden">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_invoice_doa0">
        <bpmn:targetRef>doc_invoice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="sf_3" sourceRef="start_receive_order" targetRef="task_process_order" />
    <bpmn:sequenceFlow id="sf_4" sourceRef="task_process_order" targetRef="task_send_invoice" />
    <bpmn:sequenceFlow id="sf_5" sourceRef="task_send_invoice" targetRef="end_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_assembler_part_di" bpmnElement="pool_assembler_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_supplier_part_di" bpmnElement="pool_supplier_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="950" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_2_di" bpmnElement="end_2">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_send_order_di" bpmnElement="end_send_order">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_receive_invoice_di" bpmnElement="event_receive_invoice">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_receive_order_di" bpmnElement="start_receive_order">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_order_di" bpmnElement="task_process_order">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_invoice_di" bpmnElement="task_send_invoice">
        <dc:Bounds x="540" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_order_di" bpmnElement="task_send_order">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_order_di" bpmnElement="doc_order">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_order_p1_di" bpmnElement="doc_order_p1">
        <dc:Bounds x="370" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_invoice_di" bpmnElement="doc_invoice">
        <dc:Bounds x="560" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf_1_di" bpmnElement="sf_1">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_2_di" bpmnElement="sf_2">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_3_di" bpmnElement="sf_3">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_4_di" bpmnElement="sf_4">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="590" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_5_di" bpmnElement="sf_5">
        <di:waypoint x="590" y="600" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_6_di" bpmnElement="sf_6">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_1_di" bpmnElement="mf_1">
        <di:waypoint x="558" y="118" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_2_di" bpmnElement="mf_2">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_send_order_doa0_di" bpmnElement="task_send_order_doa0">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="388" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_process_order_dia0_di" bpmnElement="task_process_order_dia0">
        <di:waypoint x="388" y="725" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_send_invoice_doa0_di" bpmnElement="task_send_invoice_doa0">
        <di:waypoint x="590" y="600" />
        <di:waypoint x="578" y="725" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>