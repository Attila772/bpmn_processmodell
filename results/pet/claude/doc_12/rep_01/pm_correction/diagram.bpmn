<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_assembler_part" name="Assembler AG" processRef="pool_assembler_proc" />
    <bpmn:participant id="pool_supplier_part" name="Supplier" processRef="pool_supplier_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_send_order" targetRef="event_order_received" name="Order" />
    <bpmn:messageFlow id="mf2" sourceRef="end_invoice_sent" targetRef="event_receive_invoice" name="Invoice" />
  </bpmn:collaboration>
  <bpmn:process id="pool_assembler_proc" isExecutable="false">
    <bpmn:dataObjectReference id="order_doc" name="Bestellung" dataObjectRef="order_doc_do" />
    <bpmn:dataObject id="order_doc_do" />
    <bpmn:startEvent id="start_1" name="Erster des Monats / Beginn">
      <bpmn:outgoing>sf1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="start_1_timerdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_order" name="Bestellung gesendet">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_order_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="event_receive_invoice" name="Rechnung empfangen">
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_invoice_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_2" name="Prozess abgeschlossen">
      <bpmn:incoming>sf6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_a" name="Bestellung an Lieferant senden">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_a_doa0">
        <bpmn:targetRef>order_doc</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_1" targetRef="task_a" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task_a" targetRef="end_send_order" />
    <bpmn:sequenceFlow id="sf6" sourceRef="event_receive_invoice" targetRef="end_2" />
  </bpmn:process>
  <bpmn:process id="pool_supplier_proc" isExecutable="false">
    <bpmn:dataObjectReference id="order_doc_p1" name="Bestellung" dataObjectRef="order_doc_p1_do" />
    <bpmn:dataObject id="order_doc_p1_do" />
    <bpmn:dataObjectReference id="invoice_doc" name="Rechnung" dataObjectRef="invoice_doc_do" />
    <bpmn:dataObject id="invoice_doc_do" />
    <bpmn:startEvent id="event_order_received" name="Bestellung empfangen">
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_order_received_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_invoice_sent" name="Rechnung gesendet">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_invoice_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_b" name="Bestellung bearbeiten">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="task_b_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_b_dia0">
        <bpmn:sourceRef>order_doc_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_b_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_c" name="Rechnung an Assembler AG senden">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_c_doa0">
        <bpmn:targetRef>invoice_doc</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf3" sourceRef="event_order_received" targetRef="task_b" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task_b" targetRef="task_c" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task_c" targetRef="end_invoice_sent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_assembler_part_di" bpmnElement="pool_assembler_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_supplier_part_di" bpmnElement="pool_supplier_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="950" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_2_di" bpmnElement="end_2">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_invoice_sent_di" bpmnElement="end_invoice_sent">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_send_order_di" bpmnElement="end_send_order">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_order_received_di" bpmnElement="event_order_received">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_receive_invoice_di" bpmnElement="event_receive_invoice">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_a_di" bpmnElement="task_a">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_b_di" bpmnElement="task_b">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_c_di" bpmnElement="task_c">
        <dc:Bounds x="540" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="order_doc_di" bpmnElement="order_doc">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="order_doc_p1_di" bpmnElement="order_doc_p1">
        <dc:Bounds x="370" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="invoice_doc_di" bpmnElement="invoice_doc">
        <dc:Bounds x="560" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf4_di" bpmnElement="sf4">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="590" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf5_di" bpmnElement="sf5">
        <di:waypoint x="590" y="600" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf6_di" bpmnElement="sf6">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_di" bpmnElement="mf1">
        <di:waypoint x="558" y="118" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf2_di" bpmnElement="mf2">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_a_doa0_di" bpmnElement="task_a_doa0">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="388" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_b_dia0_di" bpmnElement="task_b_dia0">
        <di:waypoint x="388" y="725" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_c_doa0_di" bpmnElement="task_c_doa0">
        <di:waypoint x="590" y="600" />
        <di:waypoint x="578" y="725" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>