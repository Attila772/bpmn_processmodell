<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_fach_part" name="Fachbereich (Abteilungsleiter)" processRef="pool_fach_proc" />
    <bpmn:participant id="pool_hr_part" name="Personalabteilung (HR)" processRef="pool_hr_proc" />
    <bpmn:messageFlow id="mf_report" sourceRef="end_send_report" targetRef="start_receive_report" name="Stellenmeldung" />
    <bpmn:messageFlow id="mf_questions" sourceRef="end_ask_questions" targetRef="start_receive_jobdesc_q" name="Rückfrage" />
    <bpmn:messageFlow id="mf_clarify_answer" sourceRef="end_send_clarify" targetRef="start_receive_clarify" name="Antwort zur Klärung" />
    <bpmn:messageFlow id="mf_jobdesc_to_fach" sourceRef="end_send_jobdesc" targetRef="start_receive_jobdesc" name="Stellenbeschreibung" />
    <bpmn:messageFlow id="mf_correction_to_hr" sourceRef="end_send_correction" targetRef="start_receive_correction_request" name="Korrekturwunsch" />
    <bpmn:messageFlow id="mf_approval_to_hr" sourceRef="end_approved" targetRef="start_receive_approval" name="Freigabe" />
  </bpmn:collaboration>
  <bpmn:process id="pool_fach_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_stellenmeldung" name="Stellenmeldung (Personalbedarf)" dataObjectRef="doc_stellenmeldung_do" />
    <bpmn:dataObject id="doc_stellenmeldung_do" />
    <bpmn:dataObjectReference id="doc_stellenbeschreibung" name="Stellenbeschreibung" dataObjectRef="doc_stellenbeschreibung_do" />
    <bpmn:dataObject id="doc_stellenbeschreibung_do" />
    <bpmn:startEvent id="start_1" name="Personalbedarf festgestellt">
      <bpmn:outgoing>flow_start_report</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_report" name="Stellenmeldung gesendet">
      <bpmn:incoming>flow_report_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_receive_jobdesc" name="Stellenbeschreibung zur Prüfung empfangen">
      <bpmn:outgoing>flow_fach_questions_gw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_jobdesc_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="gw_questions" name="">
      <bpmn:incoming>flow_fach_questions_gw</bpmn:incoming>
      <bpmn:outgoing>flow_gw_to_clarify</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_to_review</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_send_clarify" name="Klärung gesendet">
      <bpmn:incoming>flow_clarify_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_clarify_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_send_correction" name="Korrekturwunsch gesendet">
      <bpmn:incoming>flow_correction_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_correction_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_approved" name="Stellenbeschreibung freigegeben">
      <bpmn:incoming>flow_approve_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_approved_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_report_vacancy" name="Stellenmeldung an Personalabteilung melden">
      <bpmn:incoming>flow_start_report</bpmn:incoming>
      <bpmn:outgoing>flow_report_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_report_vacancy_doa0">
        <bpmn:targetRef>doc_stellenmeldung</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_clarify" name="Rückfragen zu Aufgaben und Anforderungen klären">
      <bpmn:incoming>flow_gw_to_clarify</bpmn:incoming>
      <bpmn:outgoing>flow_clarify_to_end</bpmn:outgoing>
      <bpmn:property id="task_clarify_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_clarify_dia0">
        <bpmn:sourceRef>doc_stellenmeldung</bpmn:sourceRef>
        <bpmn:targetRef>task_clarify_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_review_jobdesc" name="Stellenbeschreibung prüfen">
      <bpmn:incoming>flow_gw_to_review</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_gw2</bpmn:outgoing>
      <bpmn:property id="task_review_jobdesc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_jobdesc_dia0">
        <bpmn:sourceRef>doc_stellenbeschreibung</bpmn:sourceRef>
        <bpmn:targetRef>task_review_jobdesc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_request_correction" name="Korrektur der Stellenbeschreibung anfordern">
      <bpmn:incoming>flow_review_to_correction</bpmn:incoming>
      <bpmn:outgoing>flow_correction_to_end</bpmn:outgoing>
      <bpmn:property id="task_request_correction_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_request_correction_dia0">
        <bpmn:sourceRef>doc_stellenbeschreibung</bpmn:sourceRef>
        <bpmn:targetRef>task_request_correction_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_approve_jobdesc" name="Stellenbeschreibung freigeben">
      <bpmn:incoming>flow_review_to_approve</bpmn:incoming>
      <bpmn:outgoing>flow_approve_to_end</bpmn:outgoing>
      <bpmn:property id="task_approve_jobdesc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_approve_jobdesc_dia0">
        <bpmn:sourceRef>doc_stellenbeschreibung</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_jobdesc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_correction_needed" name="Korrektur nötig?" isMarkerVisible="true">
      <bpmn:incoming>flow_review_to_gw2</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_correction</bpmn:outgoing>
      <bpmn:outgoing>flow_review_to_approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_report" sourceRef="start_1" targetRef="task_report_vacancy" />
    <bpmn:sequenceFlow id="flow_report_end" sourceRef="task_report_vacancy" targetRef="end_send_report" />
    <bpmn:sequenceFlow id="flow_fach_questions_gw" sourceRef="start_receive_jobdesc" targetRef="gw_questions" />
    <bpmn:sequenceFlow id="flow_gw_to_clarify" sourceRef="gw_questions" targetRef="task_clarify" />
    <bpmn:sequenceFlow id="flow_clarify_to_end" sourceRef="task_clarify" targetRef="end_send_clarify" />
    <bpmn:sequenceFlow id="flow_gw_to_review" sourceRef="gw_questions" targetRef="task_review_jobdesc" />
    <bpmn:sequenceFlow id="flow_review_to_gw2" sourceRef="task_review_jobdesc" targetRef="gw_correction_needed" />
    <bpmn:sequenceFlow id="flow_review_to_correction" sourceRef="gw_correction_needed" targetRef="task_request_correction" />
    <bpmn:sequenceFlow id="flow_review_to_approve" sourceRef="gw_correction_needed" targetRef="task_approve_jobdesc" />
    <bpmn:sequenceFlow id="flow_correction_to_end" sourceRef="task_request_correction" targetRef="end_send_correction" />
    <bpmn:sequenceFlow id="flow_approve_to_end" sourceRef="task_approve_jobdesc" targetRef="end_approved" />
  </bpmn:process>
  <bpmn:process id="pool_hr_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_stellenmeldung_p1" name="Stellenmeldung (Personalbedarf)" dataObjectRef="doc_stellenmeldung_p1_do" />
    <bpmn:dataObject id="doc_stellenmeldung_p1_do" />
    <bpmn:dataObjectReference id="doc_stellenbeschreibung_p1" name="Stellenbeschreibung" dataObjectRef="doc_stellenbeschreibung_p1_do" />
    <bpmn:dataObject id="doc_stellenbeschreibung_p1_do" />
    <bpmn:dataObjectReference id="stellenausschreibung" name="Stellenausschreibung" dataObjectRef="stellenausschreibung_do" />
    <bpmn:dataObject id="stellenausschreibung_do" />
    <bpmn:startEvent id="start_receive_report" name="Stellenmeldung empfangen">
      <bpmn:outgoing>flow_hr_start_gw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_ask_questions" name="Rückfrage gesendet">
      <bpmn:incoming>flow_hr_to_questions</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_ask_questions_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_receive_clarify" name="Antwort auf Rückfrage empfangen">
      <bpmn:outgoing>flow_clarify_start_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_clarify_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_jobdesc" name="Stellenbeschreibung zur Prüfung gesendet">
      <bpmn:incoming>flow_create_to_send</bpmn:incoming>
      <bpmn:incoming>flow_revise_to_send</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_jobdesc_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_receive_correction_request" name="Korrekturwunsch empfangen">
      <bpmn:outgoing>flow_hr_receive_correction_to_revise</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_correction_request_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="start_receive_approval" name="Freigabe empfangen">
      <bpmn:outgoing>flow_hr_receive_approval_to_publish</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_approval_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_process_end" name="Stelle ausgeschrieben">
      <bpmn:incoming>flow_publish_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_create_jobdesc" name="Stellenbeschreibung erstellen">
      <bpmn:incoming>flow_hr_to_create</bpmn:incoming>
      <bpmn:incoming>flow_clarify_start_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_create_to_send</bpmn:outgoing>
      <bpmn:property id="task_create_jobdesc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_jobdesc_dia0">
        <bpmn:sourceRef>doc_stellenmeldung_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_create_jobdesc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_jobdesc_doa0">
        <bpmn:targetRef>doc_stellenbeschreibung_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_revise_jobdesc" name="Stellenbeschreibung überarbeiten">
      <bpmn:incoming>flow_hr_receive_correction_to_revise</bpmn:incoming>
      <bpmn:outgoing>flow_revise_to_send</bpmn:outgoing>
      <bpmn:property id="task_revise_jobdesc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_revise_jobdesc_dia0">
        <bpmn:sourceRef>doc_stellenbeschreibung_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_revise_jobdesc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_revise_jobdesc_doa0">
        <bpmn:targetRef>doc_stellenbeschreibung_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:serviceTask id="task_publish_jobdesc" name="Stelle ausschreiben">
      <bpmn:incoming>flow_hr_receive_approval_to_publish</bpmn:incoming>
      <bpmn:outgoing>flow_publish_to_end</bpmn:outgoing>
      <bpmn:property id="task_publish_jobdesc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_publish_jobdesc_dia0">
        <bpmn:sourceRef>doc_stellenbeschreibung_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_publish_jobdesc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_publish_jobdesc_doa0">
        <bpmn:targetRef>stellenausschreibung</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_need_clarification" name="Rückfragen nötig?" isMarkerVisible="true">
      <bpmn:incoming>flow_hr_start_gw</bpmn:incoming>
      <bpmn:outgoing>flow_hr_to_questions</bpmn:outgoing>
      <bpmn:outgoing>flow_hr_to_create</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_hr_start_gw" sourceRef="start_receive_report" targetRef="gw_need_clarification" />
    <bpmn:sequenceFlow id="flow_hr_to_questions" sourceRef="gw_need_clarification" targetRef="end_ask_questions" />
    <bpmn:sequenceFlow id="flow_hr_to_create" sourceRef="gw_need_clarification" targetRef="task_create_jobdesc" />
    <bpmn:sequenceFlow id="flow_clarify_start_to_task" sourceRef="start_receive_clarify" targetRef="task_create_jobdesc" />
    <bpmn:sequenceFlow id="flow_create_to_send" sourceRef="task_create_jobdesc" targetRef="end_send_jobdesc" />
    <bpmn:sequenceFlow id="flow_hr_receive_correction_to_revise" sourceRef="start_receive_correction_request" targetRef="task_revise_jobdesc" />
    <bpmn:sequenceFlow id="flow_revise_to_send" sourceRef="task_revise_jobdesc" targetRef="end_send_jobdesc" />
    <bpmn:sequenceFlow id="flow_hr_receive_approval_to_publish" sourceRef="start_receive_approval" targetRef="task_publish_jobdesc" />
    <bpmn:sequenceFlow id="flow_publish_to_end" sourceRef="task_publish_jobdesc" targetRef="end_process_end" />
  </bpmn:process>
