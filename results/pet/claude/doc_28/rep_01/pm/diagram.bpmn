<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_familydoctor_part" name="Family Doctor" processRef="pool_familydoctor_proc" />
    <bpmn:participant id="pool_secretary_part" name="Secretarial Office" processRef="pool_secretary_proc" />
    <bpmn:participant id="pool_nursingofficer_part" name="Nursing Officer" processRef="pool_nursingofficer_proc" />
    <bpmn:participant id="pool_teamleader_part" name="Team Leader" processRef="pool_teamleader_proc" />
    <bpmn:participant id="pool_firstintaker_part" name="First Intaker (Social-Medical Worker)" processRef="pool_firstintaker_proc" />
    <bpmn:participant id="pool_secondintaker_part" name="Second Intaker (Physician)" processRef="pool_secondintaker_proc" />
    <bpmn:participant id="pool_psychiatrist_part" name="Psychiatrist" processRef="pool_psychiatrist_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="evt_connect_nursing" targetRef="evt_receive_call" name="Phone connection with doctor" />
    <bpmn:messageFlow id="mf2" sourceRef="evt_hand_in_form" targetRef="evt_receive_form" name="Registration form" />
    <bpmn:messageFlow id="mf3" sourceRef="evt_handover_assignment_list" targetRef="evt_assignmentlist_received" name="Assignment list" />
    <bpmn:messageFlow id="mf4" sourceRef="evt_send_medfile_req" targetRef="evt_receive_medfile_req" name="Medical file request letter" />
    <bpmn:messageFlow id="mf5" sourceRef="evt_medfile_sent" targetRef="evt_receive_medfile_copy" name="Medical file copy" />
    <bpmn:messageFlow id="mf6" sourceRef="task_pass_cards" targetRef="evt_receive_card_first" name="Registration card" />
    <bpmn:messageFlow id="mf7" sourceRef="task_pass_cards" targetRef="evt_receive_card_second" name="Registration card" />
    <bpmn:messageFlow id="mf8" sourceRef="task_inform_second_intaker" targetRef="evt_wait_medfile_info" name="Medical info notification" />
    <bpmn:messageFlow id="mf9" sourceRef="task_record_dictaphone" targetRef="task_type_tapes" name="Dictaphone tape" />
  </bpmn:collaboration>
  <bpmn:process id="pool_familydoctor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_medical_file_copy_p1" name="Medical file copy" dataObjectRef="do_medical_file_copy_p1_do" />
    <bpmn:dataObject id="do_medical_file_copy_p1_do" />
    <bpmn:startEvent id="start_notice" name="Family doctor notices need for treatment">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_send_medfile_req" name="Letter sent to family doctor">
      <bpmn:incoming>sf21</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_medfile_req_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_receive_medfile_req" name="Family doctor receives request letter">
      <bpmn:outgoing>sf22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_medfile_req_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_medfile_sent" name="Family doctor sends medical file copy">
      <bpmn:incoming>sf23</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_medfile_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_call_office" name="Call secretarial office to notify need for treatment">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_send_medfile_copy" name="Send copy of medical file">
      <bpmn:incoming>sf22</bpmn:incoming>
      <bpmn:outgoing>sf23</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_medfile_copy_doa0">
        <bpmn:targetRef>do_medical_file_copy_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_notice" targetRef="task_call_office" />
    <bpmn:sequenceFlow id="sf22" sourceRef="evt_receive_medfile_req" targetRef="task_send_medfile_copy" />
    <bpmn:sequenceFlow id="sf23" sourceRef="task_send_medfile_copy" targetRef="evt_medfile_sent" />
  </bpmn:process>
  <bpmn:process id="pool_secretary_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_registration_form_p1" name="Registration form" dataObjectRef="do_registration_form_p1_do" />
    <bpmn:dataObject id="do_registration_form_p1_do" />
    <bpmn:dataStoreReference id="ds_information_system" name="Institute Information System" />
    <bpmn:dataObjectReference id="do_print" name="Information system print-out" dataObjectRef="do_print_do" />
    <bpmn:dataObject id="do_print_do" />
    <bpmn:dataObjectReference id="do_patient_file" name="Patient file" dataObjectRef="do_patient_file_do" />
    <bpmn:dataObject id="do_patient_file_do" />
    <bpmn:dataObjectReference id="do_registration_card" name="Registration card" dataObjectRef="do_registration_card_do" />
    <bpmn:dataObject id="do_registration_card_do" />
    <bpmn:dataObjectReference id="do_new_notices_list" name="List of new notices" dataObjectRef="do_new_notices_list_do" />
    <bpmn:dataObject id="do_new_notices_list_do" />
    <bpmn:dataObjectReference id="do_assignment_list_p1" name="Assignment list" dataObjectRef="do_assignment_list_p1_do" />
    <bpmn:dataObject id="do_assignment_list_p1_do" />
    <bpmn:dataObjectReference id="do_request_letter" name="Letter requesting medical file" dataObjectRef="do_request_letter_do" />
    <bpmn:dataObject id="do_request_letter_do" />
    <bpmn:dataObjectReference id="do_medical_file_copy" name="Medical file copy" dataObjectRef="do_medical_file_copy_do" />
    <bpmn:dataObject id="do_medical_file_copy_do" />
    <bpmn:dataObjectReference id="do_dictaphone_tape_p1" name="Dictaphone tape" dataObjectRef="do_dictaphone_tape_p1_do" />
    <bpmn:dataObject id="do_dictaphone_tape_p1_do" />
    <bpmn:dataObjectReference id="do_typed_dictation" name="Typed dictation" dataObjectRef="do_typed_dictation_do" />
    <bpmn:dataObject id="do_typed_dictation_do" />
    <bpmn:dataObjectReference id="do_ready_list" name="List of patients ready for treatment plan" dataObjectRef="do_ready_list_do" />
    <bpmn:dataObject id="do_ready_list_do" />
    <bpmn:intermediateThrowEvent id="evt_connect_nursing" name="Secretary connects doctor to nursing officer">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_connect_nursing_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_receive_form" name="Secretary receives registration form">
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_form_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_assignmentlist_received" name="Secretary receives assignment list">
      <bpmn:outgoing>sf18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_assignmentlist_received_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_receive_medfile_copy" name="Secretary receives medical file copy">
      <bpmn:outgoing>sf24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_medfile_copy_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_intake_secretary" name="Patient ready for treatment plan">
      <bpmn:incoming>sf39</bpmn:incoming>
      <bpmn:outgoing>sf40</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_inquire_name" name="Inquire name and residence of patient">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_store_info_system" name="Store registration form info in information system">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:property id="task_store_info_system_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_info_system_dia0">
        <bpmn:sourceRef>do_registration_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_info_system_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_info_system_doa0">
        <bpmn:targetRef>ds_information_system</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_print_info" name="Print information from information system">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="task_print_info_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_print_info_dia0">
        <bpmn:sourceRef>ds_information_system</bpmn:sourceRef>
        <bpmn:targetRef>task_print_info_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_print_info_doa0">
        <bpmn:targetRef>do_print</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:manualTask id="task_create_file" name="Create patient file for new patients">
      <bpmn:incoming>sf_new_yes</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_file_doa0">
        <bpmn:targetRef>do_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_store_docs_file" name="Store registration form and print in patient file">
      <bpmn:incoming>sf_new_no</bpmn:incoming>
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:property id="task_store_docs_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_docs_file_dia0">
        <bpmn:sourceRef>do_registration_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_docs_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_store_docs_file_dia1">
        <bpmn:sourceRef>do_print</bpmn:sourceRef>
        <bpmn:targetRef>task_store_docs_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_docs_file_doa0">
        <bpmn:targetRef>do_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_produce_cards" name="Produce two registration cards (first and second intaker)">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_produce_cards_doa0">
        <bpmn:targetRef>do_registration_card</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_add_to_list" name="Add new patient to list of new notices">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_add_to_list_doa0">
        <bpmn:targetRef>do_new_notices_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_store_assignment" name="Store assignment of each patient in information system">
      <bpmn:incoming>sf18</bpmn:incoming>
      <bpmn:outgoing>sf19</bpmn:outgoing>
      <bpmn:property id="task_store_assignment_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_assignment_dia0">
        <bpmn:sourceRef>do_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_assignment_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_assignment_doa0">
        <bpmn:targetRef>ds_information_system</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_pass_cards" name="Pass registration cards to first and second intaker">
      <bpmn:incoming>sf19</bpmn:incoming>
      <bpmn:outgoing>sf20</bpmn:outgoing>
      <bpmn:property id="task_pass_cards_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_pass_cards_dia0">
        <bpmn:sourceRef>do_registration_card</bpmn:sourceRef>
        <bpmn:targetRef>task_pass_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_send_letter_doctor" name="Prepare and send letter to family doctor requesting medical file">
      <bpmn:incoming>sf_medfile_yes</bpmn:incoming>
      <bpmn:outgoing>sf21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_letter_doctor_doa0">
        <bpmn:targetRef>do_request_letter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_inform_second_intaker" name="Inform second intaker that medical file copy received">
      <bpmn:incoming>sf24</bpmn:incoming>
      <bpmn:outgoing>sf25</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_add_medfile_copy" name="Add medical file copy to patient file">
      <bpmn:incoming>sf25</bpmn:incoming>
      <bpmn:outgoing>sf26</bpmn:outgoing>
      <bpmn:property id="task_add_medfile_copy_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_add_medfile_copy_dia0">
        <bpmn:sourceRef>do_medical_file_copy</bpmn:sourceRef>
        <bpmn:targetRef>task_add_medfile_copy_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_add_medfile_copy_doa0">
        <bpmn:targetRef>do_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_type_tapes" name="Type out dictaphone tapes">
      <bpmn:outgoing>sf36</bpmn:outgoing>
      <bpmn:property id="task_type_tapes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_type_tapes_dia0">
        <bpmn:sourceRef>do_dictaphone_tape_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_type_tapes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_type_tapes_doa0">
        <bpmn:targetRef>do_typed_dictation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_add_dictation_file" name="Add typed dictation information to patient file">
      <bpmn:incoming>sf36</bpmn:incoming>
      <bpmn:outgoing>sf37</bpmn:outgoing>
      <bpmn:property id="task_add_dictation_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_add_dictation_file_dia0">
        <bpmn:sourceRef>do_typed_dictation</bpmn:sourceRef>
        <bpmn:targetRef>task_add_dictation_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_add_dictation_file_doa0">
        <bpmn:targetRef>do_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_put_on_ready_list" name="Put patient on list reaching intake-complete status">
      <bpmn:incoming>sf_medfile_no</bpmn:incoming>
      <bpmn:incoming>sf26</bpmn:incoming>
      <bpmn:incoming>sf37</bpmn:incoming>
      <bpmn:outgoing>sf38</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_put_on_ready_list_doa0">
        <bpmn:targetRef>do_ready_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_provide_list_teamleader" name="Provide team-leader with list of ready patients">
      <bpmn:incoming>sf38</bpmn:incoming>
      <bpmn:outgoing>sf39</bpmn:outgoing>
      <bpmn:property id="task_provide_list_teamleader_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_provide_list_teamleader_dia0">
        <bpmn:sourceRef>do_ready_list</bpmn:sourceRef>
        <bpmn:targetRef>task_provide_list_teamleader_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_new_patient" name="New patient?" isMarkerVisible="true">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf_new_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_new_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_medfile_required" name="Medical file required?" isMarkerVisible="true">
      <bpmn:incoming>sf20</bpmn:incoming>
      <bpmn:outgoing>sf_medfile_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_medfile_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf3" sourceRef="task_inquire_name" targetRef="evt_connect_nursing" />
    <bpmn:sequenceFlow id="sf7" sourceRef="evt_receive_form" targetRef="task_store_info_system" />
    <bpmn:sequenceFlow id="sf8" sourceRef="task_store_info_system" targetRef="task_print_info" />
    <bpmn:sequenceFlow id="sf9" sourceRef="task_print_info" targetRef="gw_new_patient" />
    <bpmn:sequenceFlow id="sf_new_yes" sourceRef="gw_new_patient" targetRef="task_create_file" name="new patient" />
    <bpmn:sequenceFlow id="sf_new_no" sourceRef="gw_new_patient" targetRef="task_store_docs_file" name="existing patient" />
    <bpmn:sequenceFlow id="sf10" sourceRef="task_create_file" targetRef="task_store_docs_file" />
    <bpmn:sequenceFlow id="sf11" sourceRef="task_store_docs_file" targetRef="task_produce_cards" />
    <bpmn:sequenceFlow id="sf12" sourceRef="task_produce_cards" targetRef="task_add_to_list" />
    <bpmn:sequenceFlow id="sf18" sourceRef="evt_assignmentlist_received" targetRef="task_store_assignment" />
    <bpmn:sequenceFlow id="sf19" sourceRef="task_store_assignment" targetRef="task_pass_cards" />
    <bpmn:sequenceFlow id="sf20" sourceRef="task_pass_cards" targetRef="gw_medfile_required" />
    <bpmn:sequenceFlow id="sf_medfile_yes" sourceRef="gw_medfile_required" targetRef="task_send_letter_doctor" name="required" />
    <bpmn:sequenceFlow id="sf_medfile_no" sourceRef="gw_medfile_required" targetRef="task_put_on_ready_list" name="not required" />
    <bpmn:sequenceFlow id="sf24" sourceRef="evt_receive_medfile_copy" targetRef="task_inform_second_intaker" />
    <bpmn:sequenceFlow id="sf25" sourceRef="task_inform_second_intaker" targetRef="task_add_medfile_copy" />
    <bpmn:sequenceFlow id="sf26" sourceRef="task_add_medfile_copy" targetRef="task_put_on_ready_list" />
    <bpmn:sequenceFlow id="sf36" sourceRef="task_type_tapes" targetRef="task_add_dictation_file" />
    <bpmn:sequenceFlow id="sf37" sourceRef="task_add_dictation_file" targetRef="task_put_on_ready_list" />
    <bpmn:sequenceFlow id="sf38" sourceRef="task_put_on_ready_list" targetRef="task_provide_list_teamleader" />
    <bpmn:sequenceFlow id="sf39" sourceRef="task_provide_list_teamleader" targetRef="evt_end_intake_secretary" />
  </bpmn:process>
  <bpmn:process id="pool_nursingofficer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_registration_form" name="Registration form" dataObjectRef="do_registration_form_do" />
    <bpmn:dataObject id="do_registration_form_do" />
    <bpmn:startEvent id="evt_receive_call" name="Nursing officer receives call">
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_call_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_hand_in_form" name="Registration form handed to secretarial office">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_hand_in_form_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_full_inquiry" name="Full inquiry into mental, health and social state">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_fill_registration_form" name="Fill out registration form">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_fill_registration_form_doa0">
        <bpmn:targetRef>do_registration_form</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="sf4" sourceRef="evt_receive_call" targetRef="task_full_inquiry" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task_full_inquiry" targetRef="task_fill_registration_form" />
    <bpmn:sequenceFlow id="sf6" sourceRef="task_fill_registration_form" targetRef="evt_hand_in_form" />
  </bpmn:process>
  <bpmn:process id="pool_teamleader_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_new_notices_list_p1" name="List of new notices" dataObjectRef="do_new_notices_list_p1_do" />
    <bpmn:dataObject id="do_new_notices_list_p1_do" />
    <bpmn:dataObjectReference id="do_assignment_list" name="Assignment list" dataObjectRef="do_assignment_list_do" />
    <bpmn:dataObject id="do_assignment_list_do" />
    <bpmn:dataObjectReference id="do_treatment_plan" name="Treatment plan" dataObjectRef="do_treatment_plan_do" />
    <bpmn:dataObject id="do_treatment_plan_do" />
    <bpmn:endEvent id="evt_handover_assignment_list" name="Team-leader hands over assignment list">
      <bpmn:incoming>sf17</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_handover_assignment_list_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_staffmeeting_start" name="Wednesday staff meeting starts">
      <bpmn:incoming>sf13</bpmn:incoming>
