<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_fd_part" name="Family Doctor" processRef="pool_fd_proc" />
    <bpmn:participant id="pool_sec_part" name="Secretarial Office" processRef="pool_sec_proc" />
    <bpmn:participant id="pool_no_part" name="Nursing Officer" processRef="pool_no_proc" />
    <bpmn:participant id="pool_team_part" name="Medical Team (Staff Meeting)" processRef="pool_team_proc" />
    <bpmn:participant id="pool_first_part" name="First Intaker" processRef="pool_first_proc" />
    <bpmn:participant id="pool_second_part" name="Second Intaker" processRef="pool_second_proc" />
    <bpmn:participant id="pool_phys_part" name="Physician" processRef="pool_phys_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="msg_end_fd1" targetRef="msg_start_fd1" name="Call transfer to nursing officer" />
    <bpmn:messageFlow id="mf2" sourceRef="task_call" targetRef="ev_start_notice" name="Patient notice call" />
    <bpmn:messageFlow id="mf3" sourceRef="msg_end_fd2" targetRef="msg_start_call" name="Registration form handed in" />
    <bpmn:messageFlow id="mf4" sourceRef="task_add_list" targetRef="msg_start_list_new" name="List of new notices" />
    <bpmn:messageFlow id="mf5" sourceRef="msg_end_assignment_list" targetRef="msg_start_assign" name="Assignment list" />
    <bpmn:messageFlow id="mf6" sourceRef="msg_end_letter" targetRef="task_send_copy" name="Medical file request letter" />
    <bpmn:messageFlow id="mf7" sourceRef="msg_end_fd2" targetRef="msg_start_copy" name="Medical file copy" />
    <bpmn:messageFlow id="mf8" sourceRef="task_pass_cards" targetRef="msg_start_cards1" name="Registration card to first intaker" />
    <bpmn:messageFlow id="mf9" sourceRef="task_pass_cards" targetRef="msg_start_cards2" name="Registration card to second intaker" />
    <bpmn:messageFlow id="mf10" sourceRef="msg_end_tapes" targetRef="msg_start_tapes" name="Dictaphone tapes" />
    <bpmn:messageFlow id="mf11" sourceRef="msg_end_list" targetRef="msg_start_patient_list" name="List of ready patients" />
    <bpmn:messageFlow id="mf12" sourceRef="task_inquire_name" targetRef="msg_start_fd1" name="Doctor put through to nursing officer" />
    <bpmn:messageFlow id="mf13" sourceRef="task_handin_form" targetRef="msg_end_fd2" name="Registration form handed in" />
    <bpmn:messageFlow id="mf14" sourceRef="msg_start_call" targetRef="task_store_print" name="Notice call info" />
    <bpmn:messageFlow id="mf15" sourceRef="task_add_copy_file" targetRef="msg_start_inform_second" name="Medical file available notice" />
    <bpmn:messageFlow id="mf16" sourceRef="task_plan_meeting2" targetRef="task_record_observations" name="Meeting with patient" />
    <bpmn:messageFlow id="mf17" sourceRef="task_copy_notes_file" targetRef="ev_end_intake_sec" name="Patient file notes and checklist delivered" />
  </bpmn:collaboration>
  <bpmn:process id="pool_fd_proc" isExecutable="false">
    <bpmn:startEvent id="ev_start_call" name="Family doctor decides to notify">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="msg_end_fd1" name="Doctor connected to nursing officer">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_fd1_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="task_send_copy" name="Family doctor receives letter">
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="msg_end_fd2" name="Copy of medical file sent">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_fd2_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_call" name="Call secretarial office to notify patient">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f1" sourceRef="ev_start_call" targetRef="task_call" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_call" targetRef="msg_end_fd1" />
    <bpmn:sequenceFlow id="f29" sourceRef="task_send_copy" targetRef="msg_end_fd2" />
  </bpmn:process>
  <bpmn:process id="pool_sec_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_regform_p1" name="Registration form" dataObjectRef="do_regform_p1_do" />
    <bpmn:dataObject id="do_regform_p1_do" />
    <bpmn:dataObjectReference id="do_print" name="Information system print" dataObjectRef="do_print_do" />
    <bpmn:dataObject id="do_print_do" />
    <bpmn:dataObjectReference id="do_patientfile" name="Patient file" dataObjectRef="do_patientfile_do" />
    <bpmn:dataObject id="do_patientfile_do" />
    <bpmn:dataObjectReference id="do_regcard1" name="Registration card (first intaker)" dataObjectRef="do_regcard1_do" />
    <bpmn:dataObject id="do_regcard1_do" />
    <bpmn:dataObjectReference id="do_regcard2" name="Registration card (second intaker)" dataObjectRef="do_regcard2_do" />
    <bpmn:dataObject id="do_regcard2_do" />
    <bpmn:dataObjectReference id="do_newnotices_list" name="List of new notices" dataObjectRef="do_newnotices_list_do" />
    <bpmn:dataObject id="do_newnotices_list_do" />
    <bpmn:dataObjectReference id="do_assignment_list_p1" name="Assignment list" dataObjectRef="do_assignment_list_p1_do" />
    <bpmn:dataObject id="do_assignment_list_p1_do" />
    <bpmn:dataObjectReference id="do_letter" name="Letter requesting medical file" dataObjectRef="do_letter_do" />
    <bpmn:dataObject id="do_letter_do" />
    <bpmn:dataObjectReference id="do_medfile_copy" name="Copy of medical file" dataObjectRef="do_medfile_copy_do" />
    <bpmn:dataObject id="do_medfile_copy_do" />
    <bpmn:dataObjectReference id="do_tapes_p1" name="Dictaphone tapes" dataObjectRef="do_tapes_p1_do" />
    <bpmn:dataObject id="do_tapes_p1_do" />
    <bpmn:dataObjectReference id="do_typed_notes" name="Typed observations" dataObjectRef="do_typed_notes_do" />
    <bpmn:dataObject id="do_typed_notes_do" />
    <bpmn:dataObjectReference id="do_ready_list" name="List of patients ready for treatment plan" dataObjectRef="do_ready_list_do" />
    <bpmn:dataObject id="do_ready_list_do" />
    <bpmn:startEvent id="ev_start_notice" name="Notice call received at secretarial office">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ev_start_notice_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msg_end_letter" name="Letter sent to family doctor">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_letter_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="msg_start_copy" name="Secretarial office receives medical file copy">
      <bpmn:outgoing>f30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_copy_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="msg_start_assign" name="Assignment list received">
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_assign_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msg_end_assign_req" name="New notices list sent to team">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_assign_req_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="task_inform_second" name="Inform second intaker">
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="msg_start_tapes" name="Secretarial office receives tapes">
      <bpmn:outgoing>f42</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_tapes_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msg_end_list" name="List of ready patients sent to team-leader">
      <bpmn:incoming>f45</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_list_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ev_end_intake_sec" name="Secretarial office process end">
      <bpmn:incoming>f27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_inquire_name" name="Inquire name and residence of patient">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:task>
    <bpmn:userTask id="task_store_print" name="Store information in system and print">
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:property id="task_store_print_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_print_dia0">
        <bpmn:sourceRef>do_regform_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_print_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_print_doa0">
        <bpmn:targetRef>do_print</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_create_file" name="Create patient file">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_file_doa0">
        <bpmn:targetRef>do_patientfile</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_store_file1" name="Store registration form and print in patient file">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:property id="task_store_file1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_file1_dia0">
        <bpmn:sourceRef>do_regform_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_file1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_store_file1_dia1">
        <bpmn:sourceRef>do_print</bpmn:sourceRef>
        <bpmn:targetRef>task_store_file1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_file1_doa0">
        <bpmn:targetRef>do_patientfile</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_produce_cards" name="Produce two registration cards (first &amp; second intaker)">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_produce_cards_doa0">
        <bpmn:targetRef>do_regcard1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_produce_cards_doa1">
        <bpmn:targetRef>do_regcard2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_add_list" name="Add patient to list of new notices">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_add_list_doa0">
        <bpmn:targetRef>do_newnotices_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:serviceTask id="task_store_assignment" name="Store assignment in information system">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:property id="task_store_assignment_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_assignment_dia0">
        <bpmn:sourceRef>do_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_assignment_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="task_pass_cards" name="Pass registration cards to first and second intaker">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:property id="task_pass_cards_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_pass_cards_dia0">
        <bpmn:sourceRef>do_regcard1</bpmn:sourceRef>
        <bpmn:targetRef>task_pass_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_pass_cards_dia1">
        <bpmn:sourceRef>do_regcard2</bpmn:sourceRef>
        <bpmn:targetRef>task_pass_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_prepare_letter" name="Prepare and send letter requesting medical file copy">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_prepare_letter_doa0">
        <bpmn:targetRef>do_letter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_add_copy_file" name="Add medical file copy to patient file">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:property id="task_add_copy_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_add_copy_file_dia0">
        <bpmn:sourceRef>do_medfile_copy</bpmn:sourceRef>
        <bpmn:targetRef>task_add_copy_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_add_copy_file_doa0">
        <bpmn:targetRef>do_patientfile</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_type_tapes" name="Type out dictaphone tapes">
      <bpmn:incoming>f42</bpmn:incoming>
      <bpmn:outgoing>f43</bpmn:outgoing>
      <bpmn:property id="task_type_tapes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_type_tapes_dia0">
        <bpmn:sourceRef>do_tapes_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_type_tapes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_type_tapes_doa0">
        <bpmn:targetRef>do_typed_notes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_add_typed_file" name="Add typed information to patient file">
      <bpmn:incoming>f43</bpmn:incoming>
      <bpmn:outgoing>f44</bpmn:outgoing>
      <bpmn:property id="task_add_typed_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_add_typed_file_dia0">
        <bpmn:sourceRef>do_typed_notes</bpmn:sourceRef>
        <bpmn:targetRef>task_add_typed_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_add_typed_file_doa0">
        <bpmn:targetRef>do_patientfile</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_put_on_list" name="Put patient on list of patients ready for treatment plan">
      <bpmn:incoming>f44</bpmn:incoming>
      <bpmn:outgoing>f45</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_put_on_list_doa0">
        <bpmn:targetRef>do_ready_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_new_patient" name="New patient?" isMarkerVisible="true">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_file_required" name="Medical file required?" isMarkerVisible="true">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f3" sourceRef="ev_start_notice" targetRef="task_inquire_name" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_store_print" targetRef="gw_new_patient" />
    <bpmn:sequenceFlow id="f11" sourceRef="gw_new_patient" targetRef="task_create_file" name="yes" />
    <bpmn:sequenceFlow id="f12" sourceRef="task_create_file" targetRef="task_store_file1" />
    <bpmn:sequenceFlow id="f13" sourceRef="gw_new_patient" targetRef="task_store_file1" name="no" />
    <bpmn:sequenceFlow id="f14" sourceRef="task_store_file1" targetRef="task_produce_cards" />
    <bpmn:sequenceFlow id="f15" sourceRef="task_produce_cards" targetRef="task_add_list" />
    <bpmn:sequenceFlow id="f16" sourceRef="task_add_list" targetRef="msg_end_assign_req" />
    <bpmn:sequenceFlow id="f22" sourceRef="msg_start_assign" targetRef="task_store_assignment" />
    <bpmn:sequenceFlow id="f23" sourceRef="task_store_assignment" targetRef="task_pass_cards" />
    <bpmn:sequenceFlow id="f24" sourceRef="task_pass_cards" targetRef="gw_file_required" />
    <bpmn:sequenceFlow id="f25" sourceRef="gw_file_required" targetRef="task_prepare_letter" name="yes" />
    <bpmn:sequenceFlow id="f26" sourceRef="task_prepare_letter" targetRef="msg_end_letter" />
    <bpmn:sequenceFlow id="f27" sourceRef="gw_file_required" targetRef="ev_end_intake_sec" name="no" />
    <bpmn:sequenceFlow id="f30" sourceRef="msg_start_copy" targetRef="task_inform_second" />
    <bpmn:sequenceFlow id="f31" sourceRef="task_inform_second" targetRef="task_add_copy_file" />
    <bpmn:sequenceFlow id="f42" sourceRef="msg_start_tapes" targetRef="task_type_tapes" />
    <bpmn:sequenceFlow id="f43" sourceRef="task_type_tapes" targetRef="task_add_typed_file" />
    <bpmn:sequenceFlow id="f44" sourceRef="task_add_typed_file" targetRef="task_put_on_list" />
    <bpmn:sequenceFlow id="f45" sourceRef="task_put_on_list" targetRef="msg_end_list" />
  </bpmn:process>
  <bpmn:process id="pool_no_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_regform" name="Registration form" dataObjectRef="do_regform_do" />
    <bpmn:dataObject id="do_regform_do" />
    <bpmn:startEvent id="msg_start_call" name="Call received by nursing officer">
      <bpmn:messageEventDefinition id="msg_start_call_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="msg_start_fd1" name="Nursing officer receives call">
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_fd1_msgdef" />
    </bpmn:startEvent>
    <bpmn:task id="task_inquire_patient" name="Full inquiry into mental, health, social state">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="task_fill_form" name="Record information on registration form">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_fill_form_doa0">
        <bpmn:targetRef>do_regform</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_handin_form" name="Hand in registration form at secretarial office">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:property id="task_handin_form_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_handin_form_dia0">
        <bpmn:sourceRef>do_regform</bpmn:sourceRef>
        <bpmn:targetRef>task_handin_form_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="f5" sourceRef="msg_start_fd1" targetRef="task_inquire_patient" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_inquire_patient" targetRef="task_fill_form" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_fill_form" targetRef="task_handin_form" />
  </bpmn:process>
  <bpmn:process id="pool_team_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_newnotices_list_p1" name="List of new notices" dataObjectRef="do_newnotices_list_p1_do" />
    <bpmn:dataObject id="do_newnotices_list_p1_do" />
    <bpmn:dataObjectReference id="do_assignment_list" name="Assignment list" dataObjectRef="do_assignment_list_do" />
    <bpmn:dataObject id="do_assignment_list_do" />
    <bpmn:dataObjectReference id="do_ready_list_p1" name="List of patients ready for treatment plan" dataObjectRef="do_ready_list_p1_do" />
    <bpmn:dataObject id="do_ready_list_p1_do" />
    <bpmn:dataObjectReference id="do_treatment_plan" name="Treatment plan" dataObjectRef="do_treatment_plan_do" />
    <bpmn:dataObject id="do_treatment_plan_do" />
    <bpmn:startEvent id="msg_start_list_new" name="List of new notices received">
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_list_new_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="ev_wednesday1" name="Wednesday staff meeting starts">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ev_wednesday1_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="msg_end_assignment_list" name="Assignment list handed to secretarial office">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_assignment_list_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="msg_start_patient_list" name="Team-leader receives list of ready patients">
      <bpmn:outgoing>f46</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_patient_list_msgdef" />
