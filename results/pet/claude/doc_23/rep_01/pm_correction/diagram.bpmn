<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do1" name="Order Ticket" dataObjectRef="do1_do" />
    <bpmn:dataObject id="do1_do" />
    <bpmn:dataObjectReference id="do2" name="Wine/Beverage Order" dataObjectRef="do2_do" />
    <bpmn:dataObject id="do2_do" />
    <bpmn:dataStoreReference id="ds1" name="Guest Account System" />
    <bpmn:startEvent id="e1" name="Guest calls room service">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Order delivered and billed">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="t1" name="Take down order">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t2" name="Submit order ticket to kitchen">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:property id="t2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t2_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Prepare food">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:property id="t3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t3_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t4" name="Give order to sommelier">
      <bpmn:incoming>f_g2_yes</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t4_doa0">
        <bpmn:targetRef>do2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t5" name="Fetch wine from cellar and prepare alcoholic beverages">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:property id="t5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t5_dia0">
        <bpmn:sourceRef>do2</bpmn:sourceRef>
        <bpmn:targetRef>t5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t6" name="Assign order to waiter">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t7" name="Ready cart (tablecloth and silverware)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f_g4_yes</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t8" name="Prepare nonalcoholic drinks">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t9" name="Deliver order to guest's room">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t10" name="Debit guest's account">
      <bpmn:incoming>f_g4_no</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t10_doa0">
        <bpmn:targetRef>ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="g1" name="Split order to kitchen, sommelier, waiter">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="g2" name="Alcoholic beverage included?" isMarkerVisible="true">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f_g2_yes</bpmn:outgoing>
      <bpmn:outgoing>f_g2_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="g3" name="Join food, wine, cart ready">
      <bpmn:incoming>f_g2_no</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="g4" name="Another order to prepare/deliver?" isMarkerVisible="true">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f_g4_yes</bpmn:outgoing>
      <bpmn:outgoing>f_g4_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f1" sourceRef="e1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f3" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="f_g2_yes" sourceRef="g2" targetRef="t4" />
    <bpmn:sequenceFlow id="f_g2_no" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f6" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f7" sourceRef="t5" targetRef="g3" />
    <bpmn:sequenceFlow id="f8" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f9" sourceRef="t3" targetRef="g3" />
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f12" sourceRef="t8" targetRef="g3" />
    <bpmn:sequenceFlow id="f13" sourceRef="g3" targetRef="t9" />
    <bpmn:sequenceFlow id="f14" sourceRef="t9" targetRef="g4" />
    <bpmn:sequenceFlow id="f_g4_yes" sourceRef="g4" targetRef="t7" />
    <bpmn:sequenceFlow id="f_g4_no" sourceRef="g4" targetRef="t10" />
    <bpmn:sequenceFlow id="f15" sourceRef="t10" targetRef="e2" />
  </bpmn:process>
