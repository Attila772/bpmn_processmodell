      <bpmndi:BPMNShape id="Gateway_Join1_di" bpmnElement="Gateway_Join1">
        <omgdc:Bounds x="910" y="332" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Waiter_Deliver_di" bpmnElement="Task_Waiter_Deliver">
        <omgdc:Bounds x="990" y="317" width="140" height="65" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Waiter_Return_di" bpmnElement="Task_Waiter_Return">
        <omgdc:Bounds x="1170" y="317" width="130" height="65" />
      </bpmndi:BPMNShape>

