        <omgdc:Bounds x="1340" y="317" width="120" height="65" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="1500" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_1_di" bpmnElement="TextAnnotation_1">
        <omgdc:Bounds x="1340" y="400" width="200" height="60" />
      </bpmndi:BPMNShape>

