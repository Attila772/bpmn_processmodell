<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://www.evanstonian.com/bpmn">

  <process id="RoomServiceProcess" name="Room Service Process" isExecutable="false">

    <laneSet id="LaneSet_1">
      <lane id="Lane_Manager" name="Room-Service Manager">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_TakeOrder</flowNodeRef>
        <flowNodeRef>Gateway_Split1</flowNodeRef>
        <flowNodeRef>Task_SubmitTicket</flowNodeRef>
        <flowNodeRef>Gateway_AlcoholDecision</flowNodeRef>
        <flowNodeRef>Task_GiveOrderSommelier</flowNodeRef>
        <flowNodeRef>Gateway_AlcoholMerge</flowNodeRef>
        <flowNodeRef>Task_AssignWaiter</flowNodeRef>
      </lane>
      <lane id="Lane_Kitchen" name="Kitchen">
        <flowNodeRef>Task_PrepareFood</flowNodeRef>
      </lane>
      <lane id="Lane_Sommelier" name="Sommelier">
        <flowNodeRef>Task_FetchWine</flowNodeRef>
      </lane>
      <lane id="Lane_Waiter" name="Waiter">
        <flowNodeRef>Gateway_WaiterSplit</flowNodeRef>
        <flowNodeRef>Task_ReadyCart</flowNodeRef>
        <flowNodeRef>Task_PrepareNonAlcoholic</flowNodeRef>
        <flowNodeRef>Gateway_WaiterJoin</flowNodeRef>
        <flowNodeRef>Gateway_FinalJoin</flowNodeRef>
        <flowNodeRef>Task_Deliver</flowNodeRef>
        <flowNodeRef>Task_Return</flowNodeRef>
        <flowNodeRef>Task_Debit</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Guest calls room service">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_TakeOrder" name="Take down the order">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <parallelGateway id="Gateway_Split1" name="Split order processing">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </parallelGateway>

    <!-- Kitchen branch -->
    <task id="Task_SubmitTicket" name="Submit order ticket to kitchen">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_6</outgoing>
    </task>

    <task id="Task_PrepareFood" name="Prepare food">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
    </task>

    <!-- Wine branch -->
    <exclusiveGateway id="Gateway_AlcoholDecision" name="Order includes alcohol?">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>

    <task id="Task_GiveOrderSommelier" name="Give order to sommelier">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_10</outgoing>
    </task>

    <task id="Task_FetchWine" name="Fetch wine from cellar / prepare alcoholic beverages">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
    </task>

    <exclusiveGateway id="Gateway_AlcoholMerge" name="Merge alcohol path">
      <incoming>Flow_9</incoming>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
    </exclusiveGateway>

    <!-- Waiter branch -->
    <task id="Task_AssignWaiter" name="Assign order to waiter">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_13</outgoing>
    </task>

    <parallelGateway id="Gateway_WaiterSplit" name="Split waiter tasks">
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
      <outgoing>Flow_15</outgoing>
    </parallelGateway>

    <task id="Task_ReadyCart" name="Ready cart (tablecloth and silverware)">
      <incoming>Flow_14</incoming>
      <outgoing>Flow_16</outgoing>
    </task>

    <task id="Task_PrepareNonAlcoholic" name="Prepare nonalcoholic drinks">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_17</outgoing>
    </task>

    <parallelGateway id="Gateway_WaiterJoin" name="Join waiter tasks">
      <incoming>Flow_16</incoming>
      <incoming>Flow_17</incoming>
      <outgoing>Flow_18</outgoing>
    </parallelGateway>

    <!-- Final synchronization -->
    <parallelGateway id="Gateway_FinalJoin" name="Food, wine, and cart ready">
      <incoming>Flow_7</incoming>
      <incoming>Flow_12</incoming>
      <incoming>Flow_18</incoming>
      <outgoing>Flow_19</outgoing>
    </parallelGateway>

    <task id="Task_Deliver" name="Deliver order to guest's room">
      <incoming>Flow_19</incoming>
      <outgoing>Flow_20</outgoing>
    </task>

    <task id="Task_Return" name="Return to room-service station">
      <incoming>Flow_20</incoming>
      <outgoing>Flow_21</outgoing>
    </task>

    <task id="Task_Debit" name="Debit guest's account">
      <incoming>Flow_21</incoming>
      <outgoing>Flow_22</outgoing>
    </task>

    <endEvent id="EndEvent_1" name="Order complete">
      <incoming>Flow_22</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_TakeOrder" />
    <sequenceFlow id="Flow_2" sourceRef="Task_TakeOrder" targetRef="Gateway_Split1" />
    <sequenceFlow id="Flow_3" sourceRef="Gateway_Split1" targetRef="Task_SubmitTicket" />
    <sequenceFlow id="Flow_4" sourceRef="Gateway_Split1" targetRef="Gateway_AlcoholDecision" />
    <sequenceFlow id="Flow_5" sourceRef="Gateway_Split1" targetRef="Task_AssignWaiter" />
    <sequenceFlow id="Flow_6" sourceRef="Task_SubmitTicket" targetRef="Task_PrepareFood" />
    <sequenceFlow id="Flow_7" sourceRef="Task_PrepareFood" targetRef="Gateway_FinalJoin" />
    <sequenceFlow id="Flow_8" name="Yes (80%)" sourceRef="Gateway_AlcoholDecision" targetRef="Task_GiveOrderSommelier" />
    <sequenceFlow id="Flow_9" name="No (20%)" sourceRef="Gateway_AlcoholDecision" targetRef="Gateway_AlcoholMerge" />
    <sequenceFlow id="Flow_10" sourceRef="Task_GiveOrderSommelier" targetRef="Task_FetchWine" />
    <sequenceFlow id="Flow_11" sourceRef="Task_FetchWine" targetRef="Gateway_AlcoholMerge" />
    <sequenceFlow id="Flow_12" sourceRef="Gateway_AlcoholMerge" targetRef="Gateway_FinalJoin" />
    <sequenceFlow id="Flow_13" sourceRef="Task_AssignWaiter" targetRef="Gateway_WaiterSplit" />
    <sequenceFlow id="Flow_14" sourceRef="Gateway_WaiterSplit" targetRef="Task_ReadyCart" />
    <sequenceFlow id="Flow_15" sourceRef="Gateway_WaiterSplit" targetRef="Task_PrepareNonAlcoholic" />
    <sequenceFlow id="Flow_16" sourceRef="Task_ReadyCart" targetRef="Gateway_WaiterJoin" />
    <sequenceFlow id="Flow_17" sourceRef="Task_PrepareNonAlcoholic" targetRef="Gateway_WaiterJoin" />
    <sequenceFlow id="Flow_18" sourceRef="Gateway_WaiterJoin" targetRef="Gateway_FinalJoin" />
    <sequenceFlow id="Flow_19" sourceRef="Gateway_FinalJoin" targetRef="Task_Deliver" />
    <sequenceFlow id="Flow_20" sourceRef="Task_Deliver" targetRef="Task_Return" />
    <sequenceFlow id="Flow_21" sourceRef="Task_Return" targetRef="Task_Debit" />
    <sequenceFlow id="Flow_22" sourceRef="Task_Debit" targetRef="EndEvent_1" />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="RoomServiceProcess">

      <bpmndi:BPMNShape id="Pool_di" bpmnElement="RoomServiceProcess" isHorizontal="true">
        <omgdc:Bounds x="0" y="0" width="1700" height="960" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <omgdc:Bounds x="30" y="0" width="1670" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kitchen_di" bpmnElement="Lane_Kitchen" isHorizontal="true">
        <omgdc:Bounds x="30" y="260" width="1670" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sommelier_di" bpmnElement="Lane_Sommelier" isHorizontal="true">
        <omgdc:Bounds x="30" y="460" width="1670" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Waiter_di" bpmnElement="Lane_Waiter" isHorizontal="true">
        <omgdc:Bounds x="30" y="660" width="1670" height="300" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="70" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TakeOrder_di" bpmnElement="Task_TakeOrder">
        <omgdc:Bounds x="140" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Split1_di" bpmnElement="Gateway_Split1">
        <omgdc:Bounds x="290" y="80" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SubmitTicket_di" bpmnElement="Task_SubmitTicket">
        <omgdc:Bounds x="370" y="15" width="130" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_AlcoholDecision_di" bpmnElement="Gateway_AlcoholDecision">
        <omgdc:Bounds x="390" y="110" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_GiveOrderSommelier_di" bpmnElement="Task_GiveOrderSommelier">
        <omgdc:Bounds x="470" y="95" width="130" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_AlcoholMerge_di" bpmnElement="Gateway_AlcoholMerge">
        <omgdc:Bounds x="800" y="110" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AssignWaiter_di" bpmnElement="Task_AssignWaiter">
        <omgdc:Bounds x="370" y="185" width="130" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PrepareFood_di" bpmnElement="Task_PrepareFood">
        <omgdc:Bounds x="560" y="325" width="120" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FetchWine_di" bpmnElement="Task_FetchWine">
        <omgdc:Bounds x="650" y="525" width="150" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_WaiterSplit_di" bpmnElement="Gateway_WaiterSplit">
        <omgdc:Bounds x="460" y="790" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReadyCart_di" bpmnElement="Task_ReadyCart">
        <omgdc:Bounds x="560" y="700" width="140" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PrepareNonAlcoholic_di" bpmnElement="Task_PrepareNonAlcoholic">
        <omgdc:Bounds x="560" y="810" width="140" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_WaiterJoin_di" bpmnElement="Gateway_WaiterJoin">
        <omgdc:Bounds x="750" y="790" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_FinalJoin_di" bpmnElement="Gateway_FinalJoin">
        <omgdc:Bounds x="950" y="790" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Deliver_di" bpmnElement="Task_Deliver">
        <omgdc:Bounds x="1040" y="775" width="140" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Return_di" bpmnElement="Task_Return">
        <omgdc:Bounds x="1230" y="775" width="140" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Debit_di" bpmnElement="Task_Debit">
        <omgdc:Bounds x="1420" y="775" width="140" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="1610" y="792" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="106" y="100" />
        <omgdi:waypoint x="140" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="250" y="100" />
        <omgdi:waypoint x="290" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="310" y="80" />
        <omgdi:waypoint x="310" y="50" />
        <omgdi:waypoint x="370" y="50" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="310" y="120" />
        <omgdi:waypoint x="310" y="130" />
        <omgdi:waypoint x="390" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="310" y="120" />
        <omgdi:waypoint x="310" y="220" />
        <omgdi:waypoint x="370" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="435" y="85" />
        <omgdi:waypoint x="435" y="360" />
        <omgdi:waypoint x="560" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <omgdi:waypoint x="680" y="360" />
        <omgdi:waypoint x="970" y="360" />
        <omgdi:waypoint x="970" y="790" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <omgdi:waypoint x="430" y="130" />
        <omgdi:waypoint x="470" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <omgdi:waypoint x="410" y="150" />
        <omgdi:waypoint x="410" y="250" />
        <omgdi:waypoint x="820" y="250" />
        <omgdi:waypoint x="820" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <omgdi:waypoint x="535" y="165" />
        <omgdi:waypoint x="535" y="560" />
        <omgdi:waypoint x="650" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <omgdi:waypoint x="800" y="560" />
        <omgdi:waypoint x="820" y="560" />
        <omgdi:waypoint x="820" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <omgdi:waypoint x="820" y="150" />
        <omgdi:waypoint x="820" y="400" />
        <omgdi:waypoint x="970" y="400" />
        <omgdi:waypoint x="970" y="790" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <omgdi:waypoint x="435" y="255" />
        <omgdi:waypoint x="435" y="700" />
        <omgdi:waypoint x="480" y="700" />
        <omgdi:waypoint x="480" y="790" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <omgdi:waypoint x="500" y="800" />
        <omgdi:waypoint x="530" y="800" />
        <omgdi:waypoint x="530" y="735" />
        <omgdi:waypoint x="560" y="735" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <omgdi:waypoint x="500" y="810" />
        <omgdi:waypoint x="530" y="810" />
        <omgdi:waypoint x="530" y="845" />
        <omgdi:waypoint x="560" y="845" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <omgdi:waypoint x="700" y="735" />
        <omgdi:waypoint x="770" y="735" />
        <omgdi:waypoint x="770" y="790" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <omgdi:waypoint x="700" y="845" />
        <omgdi:waypoint x="770" y="845" />
        <omgdi:waypoint x="770" y="830" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <omgdi:waypoint x="790" y="810" />
        <omgdi:waypoint x="950" y="810" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19">
        <omgdi:waypoint x="990" y="810" />
        <omgdi:waypoint x="1040" y="810" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_20_di" bpmnElement="Flow_20">
        <omgdi:waypoint x="1180" y="810" />
        <omgdi:waypoint x="1230" y="810" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_21_di" bpmnElement="Flow_21">
        <omgdi:waypoint x="1370" y="810" />
        <omgdi:waypoint x="1420" y="810" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_22_di" bpmnElement="Flow_22">
        <omgdi:waypoint x="1560" y="810" />
        <omgdi:waypoint x="1610" y="810" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
