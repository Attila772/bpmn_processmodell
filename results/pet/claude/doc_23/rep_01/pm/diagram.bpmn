<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="d1" name="Order Ticket" dataObjectRef="d1_do" />
    <bpmn:dataObject id="d1_do" />
    <bpmn:dataObjectReference id="d2" name="Wine/Alcohol Order" dataObjectRef="d2_do" />
    <bpmn:dataObject id="d2_do" />
    <bpmn:dataStoreReference id="ds1" name="Guest Account System" />
    <bpmn:startEvent id="e1" name="Guest calls room service">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Order delivered and billed">
      <bpmn:incoming>sf16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="t1" name="Take down order">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>d1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t2" name="Submit order ticket to kitchen">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="t2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t2_dia0">
        <bpmn:sourceRef>d1</bpmn:sourceRef>
        <bpmn:targetRef>t2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Prepare food">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:property id="t3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t3_dia0">
        <bpmn:sourceRef>d1</bpmn:sourceRef>
        <bpmn:targetRef>t3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t4" name="Give order to sommelier">
      <bpmn:incoming>sf_g2_yes</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t4_doa0">
        <bpmn:targetRef>d2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t5" name="Fetch wine from cellar and prepare alcoholic beverages">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="t5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t5_dia0">
        <bpmn:sourceRef>d2</bpmn:sourceRef>
        <bpmn:targetRef>t5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t6" name="Assign order to waiter">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:property id="t6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t6_dia0">
        <bpmn:sourceRef>d1</bpmn:sourceRef>
        <bpmn:targetRef>t6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t7" name="Ready cart (tablecloth and silverware)">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t8" name="Prepare nonalcoholic drinks">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t9" name="Deliver order to guest's room">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:incoming>sf_g4_wait</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t10" name="Return to room-service station">
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t11" name="Debit guest's account">
      <bpmn:incoming>sf_g4_bill</bpmn:incoming>
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t11_doa0">
        <bpmn:targetRef>ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="g1" name="Takes order">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="g2" name="Includes alcohol?" isMarkerVisible="true">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf_g2_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_g2_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="g3" name="Join after kitchen/sommelier/cart ready">
      <bpmn:incoming>sf_g2_no</bpmn:incoming>
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="g4" name="Bill now or wait?" isMarkerVisible="true">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf_g4_bill</bpmn:outgoing>
      <bpmn:outgoing>sf_g4_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf1" sourceRef="e1" targetRef="t1" />
    <bpmn:sequenceFlow id="sf2" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="sf3" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="sf4" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="sf5" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="sf_g2_yes" sourceRef="g2" targetRef="t4" />
    <bpmn:sequenceFlow id="sf_g2_no" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="sf6" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="sf7" sourceRef="t3" targetRef="g3" />
    <bpmn:sequenceFlow id="sf8" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="sf9" sourceRef="t5" targetRef="g3" />
    <bpmn:sequenceFlow id="sf10" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="sf11" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="sf12" sourceRef="t8" targetRef="g3" />
    <bpmn:sequenceFlow id="sf13" sourceRef="g3" targetRef="t9" />
    <bpmn:sequenceFlow id="sf14" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="sf15" sourceRef="t10" targetRef="g4" />
    <bpmn:sequenceFlow id="sf_g4_bill" sourceRef="g4" targetRef="t11" />
    <bpmn:sequenceFlow id="sf_g4_wait" sourceRef="g4" targetRef="t9" />
    <bpmn:sequenceFlow id="sf16" sourceRef="t11" targetRef="e2" />
  </bpmn:process>
