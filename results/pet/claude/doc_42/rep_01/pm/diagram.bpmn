    <bpmn:sequenceFlow id="Flow_ToDeny" sourceRef="Gateway_RequestDecision" targetRef="Task_DenyRequest" name="request denied" />
    <bpmn:sequenceFlow id="Flow_ToPerform" sourceRef="Gateway_RequestDecision" targetRef="Task_PerformMeasurement" name="request accepted" />
    <bpmn:sequenceFlow id="SF5" sourceRef="Task_DenyRequest" targetRef="End_DenyRequest" />
    <bpmn:sequenceFlow id="SF6" sourceRef="Task_PerformMeasurement" targetRef="Gateway_MeasurementOutcome" />
    <bpmn:sequenceFlow id="Flow_ToInformFailure" sourceRef="Gateway_MeasurementOutcome" targetRef="Task_InformFailure" name="reading failed" />
    <bpmn:sequenceFlow id="Flow_ToTransmitValues" sourceRef="Gateway_MeasurementOutcome" targetRef="Task_TransmitValues" name="reading successful" />
    <bpmn:sequenceFlow id="SF7" sourceRef="Task_InformFailure" targetRef="End_InformFailure" />
