    <bpmn:messageFlow id="MF2" sourceRef="End_DenyRequest" targetRef="Start_ReceiveResult" name="Request Denial" />
    <bpmn:messageFlow id="MF3" sourceRef="End_InformFailure" targetRef="Start_ReceiveResult" name="Reading Failure Notice" />
    <bpmn:messageFlow id="MF4" sourceRef="End_TransmitValues" targetRef="Start_ReceiveResult" name="Measured Values" />
