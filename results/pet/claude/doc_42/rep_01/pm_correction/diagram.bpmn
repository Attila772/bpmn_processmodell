<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_msp_part" name="MSP" processRef="pool_msp_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="event_send_measurements_go" targetRef="event_receive_request_msp" name="Measurement Request" />
    <bpmn:messageFlow id="mf2" sourceRef="event_send_deny_msp" targetRef="event_receive_measurements_go" name="Request Denial" />
    <bpmn:messageFlow id="mf3" sourceRef="event_send_fail_msp" targetRef="event_receive_measurements_go" name="Reading Failure" />
    <bpmn:messageFlow id="mf4" sourceRef="event_send_values_msp" targetRef="event_receive_measurements_go" name="Measured Values" />
    <bpmn:messageFlow id="mf5" sourceRef="task_send_changed_values" targetRef="event_receive_changed_values_msp" name="Changed Values" />
    <bpmn:messageFlow id="mf6" sourceRef="task_transmit_readings" targetRef="event_receive_readings_sp" name="Readings" />
  </bpmn:collaboration>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_request" name="Measurement Request" dataObjectRef="data_request_do" />
    <bpmn:dataObject id="data_request_do" />
    <bpmn:dataObjectReference id="data_measured_values_p1" name="Measured Values" dataObjectRef="data_measured_values_p1_do" />
    <bpmn:dataObject id="data_measured_values_p1_do" />
    <bpmn:dataObjectReference id="data_changed_values" name="Changed Values" dataObjectRef="data_changed_values_do" />
    <bpmn:dataObject id="data_changed_values_do" />
    <bpmn:dataObjectReference id="data_readings" name="Readings" dataObjectRef="data_readings_do" />
    <bpmn:dataObject id="data_readings_do" />
    <bpmn:startEvent id="start_go" name="Start">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_send_measurements_go" name="Measurement request sent">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_measurements_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="event_receive_measurements_go" name="Measured values or notice received">
      <bpmn:outgoing>sf15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_measurements_go_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_go" name="End">
      <bpmn:incoming>sf18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_request" name="Request measurements">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_request_doa0">
        <bpmn:targetRef>data_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_process_values" name="Process the measured values">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:property id="task_process_values_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_process_values_dia0">
        <bpmn:sourceRef>data_measured_values_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_process_values_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_process_values_doa0">
        <bpmn:targetRef>data_changed_values</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_send_changed_values" name="Send changed values to MSP">
      <bpmn:incoming>sf16</bpmn:incoming>
      <bpmn:outgoing>sf17</bpmn:outgoing>
      <bpmn:property id="task_send_changed_values_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_changed_values_dia0">
        <bpmn:sourceRef>data_changed_values</bpmn:sourceRef>
        <bpmn:targetRef>task_send_changed_values_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_transmit_readings" name="Transmit readings to SP">
      <bpmn:incoming>sf17</bpmn:incoming>
      <bpmn:outgoing>sf18</bpmn:outgoing>
      <bpmn:property id="task_transmit_readings_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_transmit_readings_dia0">
        <bpmn:sourceRef>data_changed_values</bpmn:sourceRef>
        <bpmn:targetRef>task_transmit_readings_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_transmit_readings_doa0">
        <bpmn:targetRef>data_readings</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_go" targetRef="task_request" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task_request" targetRef="event_send_measurements_go" />
    <bpmn:sequenceFlow id="sf15" sourceRef="event_receive_measurements_go" targetRef="task_process_values" />
    <bpmn:sequenceFlow id="sf16" sourceRef="task_process_values" targetRef="task_send_changed_values" />
    <bpmn:sequenceFlow id="sf17" sourceRef="task_send_changed_values" targetRef="task_transmit_readings" />
    <bpmn:sequenceFlow id="sf18" sourceRef="task_transmit_readings" targetRef="end_go" />
  </bpmn:process>
  <bpmn:process id="pool_msp_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_request_p1" name="Measurement Request" dataObjectRef="data_request_p1_do" />
    <bpmn:dataObject id="data_request_p1_do" />
    <bpmn:dataObjectReference id="data_measured_values" name="Measured Values" dataObjectRef="data_measured_values_do" />
    <bpmn:dataObject id="data_measured_values_do" />
    <bpmn:startEvent id="event_receive_request_msp" name="Measurement request received">
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_request_msp_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="event_send_deny_msp" name="Denial sent">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_send_deny_msp_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="event_send_fail_msp" name="Failure notice sent">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_send_fail_msp_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="event_send_values_msp" name="Measured values sent">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_send_values_msp_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="event_receive_changed_values_msp" name="Changed values received">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_changed_values_msp_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msp" name="End">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:incoming>sf19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_request" name="Check received request">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="task_check_request_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_request_dia0">
        <bpmn:sourceRef>data_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_request_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_deny_request" name="Deny request">
      <bpmn:incoming>flow_deny</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="task_perform_measurement" name="Perform measurement">
      <bpmn:incoming>flow_perform</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_perform_measurement_doa0">
        <bpmn:targetRef>data_measured_values</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_inform_failure" name="Inform GO about failure of reading">
      <bpmn:incoming>flow_fail</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_transmit_values" name="Transmit measured values to GO">
      <bpmn:incoming>flow_success</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:property id="task_transmit_values_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_transmit_values_dia0">
        <bpmn:sourceRef>data_measured_values</bpmn:sourceRef>
        <bpmn:targetRef>task_transmit_values_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_msp_decision" name="Request valid?" isMarkerVisible="true">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>flow_deny</bpmn:outgoing>
      <bpmn:outgoing>flow_perform</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_msp_outcome" name="Reading successful?" isMarkerVisible="true">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>flow_fail</bpmn:outgoing>
      <bpmn:outgoing>flow_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf3" sourceRef="event_receive_request_msp" targetRef="task_check_request" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task_check_request" targetRef="gw_msp_decision" />
    <bpmn:sequenceFlow id="flow_deny" sourceRef="gw_msp_decision" targetRef="task_deny_request" name="deny request" />
    <bpmn:sequenceFlow id="flow_perform" sourceRef="gw_msp_decision" targetRef="task_perform_measurement" name="perform measurement" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task_deny_request" targetRef="event_send_deny_msp" />
    <bpmn:sequenceFlow id="sf6" sourceRef="event_send_deny_msp" targetRef="end_msp" />
    <bpmn:sequenceFlow id="sf7" sourceRef="task_perform_measurement" targetRef="gw_msp_outcome" />
    <bpmn:sequenceFlow id="flow_fail" sourceRef="gw_msp_outcome" targetRef="task_inform_failure" name="failure of reading" />
    <bpmn:sequenceFlow id="flow_success" sourceRef="gw_msp_outcome" targetRef="task_transmit_values" name="measurement successful" />
    <bpmn:sequenceFlow id="sf8" sourceRef="task_inform_failure" targetRef="event_send_fail_msp" />
    <bpmn:sequenceFlow id="sf9" sourceRef="event_send_fail_msp" targetRef="end_msp" />
    <bpmn:sequenceFlow id="sf10" sourceRef="task_transmit_values" targetRef="event_send_values_msp" />
    <bpmn:sequenceFlow id="sf11" sourceRef="event_send_values_msp" targetRef="event_receive_changed_values_msp" />
    <bpmn:sequenceFlow id="sf19" sourceRef="event_receive_changed_values_msp" targetRef="end_msp" />
  </bpmn:process>
  <bpmn:process id="pool_sp_proc" isExecutable="false">
    <bpmn:startEvent id="event_receive_readings_sp" name="Readings received">
      <bpmn:outgoing>sf20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_receive_readings_sp_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_sp" name="End">
      <bpmn:incoming>sf20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf20" sourceRef="event_receive_readings_sp" targetRef="end_sp" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
