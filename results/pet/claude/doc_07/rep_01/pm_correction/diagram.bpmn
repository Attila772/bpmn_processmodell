<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mspn_part" name="MSPN" processRef="pool_mspn_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_msg_to_go" targetRef="start_msg_from_mspn" name="Measurement Registration" />
    <bpmn:messageFlow id="mf2" sourceRef="end_msg_mspo" targetRef="start_msg_mspo" name="Assignment Notification" />
    <bpmn:messageFlow id="mf3" sourceRef="end_msg_mpo" targetRef="start_msg_mpo" name="Assignment Notification" />
    <bpmn:messageFlow id="mf4" sourceRef="end_msg_sp" targetRef="start_msg_sp" name="Assignment Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mspn_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_measurement" name="Measurement Registration Record" dataObjectRef="doc_measurement_do" />
    <bpmn:dataObject id="doc_measurement_do" />
    <bpmn:startEvent id="start_mspn" name="Start">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msg_to_go" name="Measurement registered - send to GO">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_to_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_register" name="MSPN registers the measurement">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_doa0">
        <bpmn:targetRef>doc_measurement</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf1" sourceRef="start_mspn" targetRef="task_register" />
    <bpmn:sequenceFlow id="sf2" sourceRef="task_register" targetRef="end_msg_to_go" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_measurement_p1" name="Measurement Registration Record" dataObjectRef="doc_measurement_p1_do" />
    <bpmn:dataObject id="doc_measurement_p1_do" />
    <bpmn:dataObjectReference id="doc_rejection" name="Rejection Notice" dataObjectRef="doc_rejection_do" />
    <bpmn:dataObject id="doc_rejection_do" />
    <bpmn:dataObjectReference id="doc_confirmation" name="Confirmation Notice" dataObjectRef="doc_confirmation_do" />
    <bpmn:dataObject id="doc_confirmation_do" />
    <bpmn:dataObjectReference id="doc_assignment" name="MSPN Assignment Record" dataObjectRef="doc_assignment_do" />
    <bpmn:dataObject id="doc_assignment_do" />
    <bpmn:startEvent id="start_msg_from_mspn" name="Measurement received from MSPN">
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_from_mspn_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msg_mspo" name="Assignment info sent to MSPO">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="end_msg_mspo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_msg_mpo" name="Assignment info sent to MPO">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="end_msg_mpo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_msg_sp" name="Assignment info sent to SP">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_sp_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go" name="GO Process End">
      <bpmn:incoming>sf5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_examine" name="GO examines the application of the MSPN">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="task_examine_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_dia0">
        <bpmn:sourceRef>doc_measurement_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_reject" name="GO rejects the application of the MSPN">
      <bpmn:incoming>flow_to_reject</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_reject_doa0">
        <bpmn:targetRef>doc_rejection</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_confirm" name="GO confirms the application of the MSPN">
      <bpmn:incoming>flow_to_confirm</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_confirm_doa0">
        <bpmn:targetRef>doc_confirmation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_assign" name="GO assigns the MSPN">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:property id="task_assign_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_assign_dia0">
        <bpmn:sourceRef>doc_confirmation</bpmn:sourceRef>
        <bpmn:targetRef>task_assign_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_assign_doa0">
        <bpmn:targetRef>doc_assignment</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_mspo" name="GO informs the MSPO about the assignment of MSPN">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:property id="task_inform_mspo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mspo_dia0">
        <bpmn:sourceRef>doc_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mspo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_mpo" name="GO informs the MPO about the assignment of MSPN">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="task_inform_mpo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mpo_dia0">
        <bpmn:sourceRef>doc_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mpo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_sp" name="GO informs the SP about the assignment of MSPN">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:property id="task_inform_sp_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_sp_dia0">
        <bpmn:sourceRef>doc_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_sp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decision" name="Application examined - reject or confirm?" isMarkerVisible="true">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>flow_to_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_to_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf3" sourceRef="start_msg_from_mspn" targetRef="task_examine" />
    <bpmn:sequenceFlow id="sf4" sourceRef="task_examine" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_to_reject" sourceRef="gw_decision" targetRef="task_reject" name="rejected" />
    <bpmn:sequenceFlow id="flow_to_confirm" sourceRef="gw_decision" targetRef="task_confirm" name="confirmed" />
    <bpmn:sequenceFlow id="sf5" sourceRef="task_reject" targetRef="end_go" />
    <bpmn:sequenceFlow id="sf6" sourceRef="task_confirm" targetRef="task_assign" />
    <bpmn:sequenceFlow id="sf7" sourceRef="task_assign" targetRef="task_inform_mspo" />
    <bpmn:sequenceFlow id="sf8" sourceRef="task_inform_mspo" targetRef="task_inform_mpo" />
    <bpmn:sequenceFlow id="sf9" sourceRef="task_inform_mpo" targetRef="task_inform_sp" />
    <bpmn:sequenceFlow id="sf10" sourceRef="task_inform_sp" targetRef="end_msg_mspo" />
    <bpmn:sequenceFlow id="sf11" sourceRef="end_msg_mspo" targetRef="end_msg_mpo" />
    <bpmn:sequenceFlow id="sf12" sourceRef="end_msg_mpo" targetRef="end_msg_sp" />
  </bpmn:process>
  <bpmn:process id="pool_mspo_proc" isExecutable="false">
    <bpmn:startEvent id="start_msg_mspo" name="Assignment info received">
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_mspo_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mspo_process" name="MSPO Process End">
      <bpmn:incoming>sf13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf13" sourceRef="start_msg_mspo" targetRef="end_mspo_process" />
  </bpmn:process>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:startEvent id="start_msg_mpo" name="Assignment info received">
      <bpmn:outgoing>sf14</bpmn:outgoing>
