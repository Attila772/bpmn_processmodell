    </bpmn:startEvent>
    <bpmn:endEvent id="end_sp_process" name="SP Process End">
      <bpmn:incoming>sf15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf15" sourceRef="start_msg_sp" targetRef="end_sp_process" />
  </bpmn:process>
