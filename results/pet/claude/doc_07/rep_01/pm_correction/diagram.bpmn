    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpo_process" name="MPO Process End">
      <bpmn:incoming>sf14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf14" sourceRef="start_msg_mpo" targetRef="end_mpo_process" />
  </bpmn:process>
  <bpmn:process id="pool_sp_proc" isExecutable="false">
