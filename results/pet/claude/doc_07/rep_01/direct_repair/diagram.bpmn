<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.com/bpmn/msp"
             id="Definitions_1">

  <collaboration id="Collaboration_1">
    <participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <participant id="Participant_MPO" name="MPO" processRef="Process_MPO"/>
    <participant id="Participant_SP" name="SP" processRef="Process_SP"/>

    <messageFlow id="MF_Register" sourceRef="Task_RegisterMeasurement" targetRef="Event_GOStart"/>
    <messageFlow id="MF_InformMSPO" sourceRef="Task_InformMSPO" targetRef="Event_MSPOStart"/>
    <messageFlow id="MF_InformMPO" sourceRef="Task_InformMPO" targetRef="Event_MPOStart"/>
    <messageFlow id="MF_InformSP" sourceRef="Task_InformSP" targetRef="Event_SPStart"/>
  </collaboration>

  <!-- MSPN Process -->
  <process id="Process_MSPN" isExecutable="false">
    <startEvent id="Event_MSPNStart" name="Start"/>
    <task id="Task_RegisterMeasurement" name="Register the measurement at the GO"/>
    <endEvent id="Event_MSPNEnd" name="Measurement registered"/>

    <sequenceFlow id="Flow_MSPN_1" sourceRef="Event_MSPNStart" targetRef="Task_RegisterMeasurement"/>
    <sequenceFlow id="Flow_MSPN_2" sourceRef="Task_RegisterMeasurement" targetRef="Event_MSPNEnd"/>
  </process>

  <!-- GO Process -->
  <process id="Process_GO" isExecutable="false">
    <startEvent id="Event_GOStart" name="Measurement received">
      <messageEventDefinition/>
    </startEvent>
    <task id="Task_ExamineApplication" name="Examine the application of the MSPN"/>
    <exclusiveGateway id="Gateway_Decision" name="Application decision"/>
    <task id="Task_RejectApplication" name="Reject the application of the MSPN"/>
    <task id="Task_ConfirmApplication" name="Confirm the application of the MSPN"/>
    <task id="Task_AssignMSPN" name="Assign the MSPN"/>
    <task id="Task_InformMSPO" name="Inform the MSPO about the assignment of MSPN"/>
    <task id="Task_InformMPO" name="Inform the MPO about the assignment of MSPN"/>
    <task id="Task_InformSP" name="Inform the SP about the assignment of MSPN"/>
    <endEvent id="Event_GORejected" name="Application rejected"/>
    <endEvent id="Event_GOEnd" name="Process completed"/>

    <sequenceFlow id="Flow_GO_1" sourceRef="Event_GOStart" targetRef="Task_ExamineApplication"/>
    <sequenceFlow id="Flow_GO_2" sourceRef="Task_ExamineApplication" targetRef="Gateway_Decision"/>
    <sequenceFlow id="Flow_GO_3" name="Reject" sourceRef="Gateway_Decision" targetRef="Task_RejectApplication"/>
    <sequenceFlow id="Flow_GO_4" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_ConfirmApplication"/>
    <sequenceFlow id="Flow_GO_5" sourceRef="Task_RejectApplication" targetRef="Event_GORejected"/>
    <sequenceFlow id="Flow_GO_6" sourceRef="Task_ConfirmApplication" targetRef="Task_AssignMSPN"/>
    <sequenceFlow id="Flow_GO_7" sourceRef="Task_AssignMSPN" targetRef="Task_InformMSPO"/>
    <sequenceFlow id="Flow_GO_8" sourceRef="Task_InformMSPO" targetRef="Task_InformMPO"/>
    <sequenceFlow id="Flow_GO_9" sourceRef="Task_InformMPO" targetRef="Task_InformSP"/>
    <sequenceFlow id="Flow_GO_10" sourceRef="Task_InformSP" targetRef="Event_GOEnd"/>
  </process>

  <!-- MSPO Process -->
  <process id="Process_MSPO" isExecutable="false">
    <startEvent id="Event_MSPOStart" name="Informed about assignment">
      <messageEventDefinition/>
    </startEvent>
    <endEvent id="Event_MSPOEnd" name="Information received"/>
    <sequenceFlow id="Flow_MSPO_1" sourceRef="Event_MSPOStart" targetRef="Event_MSPOEnd"/>
  </process>

  <!-- MPO Process -->
  <process id="Process_MPO" isExecutable="false">
    <startEvent id="Event_MPOStart" name="Informed about assignment">
      <messageEventDefinition/>
    </startEvent>
    <endEvent id="Event_MPOEnd" name="Information received"/>
    <sequenceFlow id="Flow_MPO_1" sourceRef="Event_MPOStart" targetRef="Event_MPOEnd"/>
  </process>

  <!-- SP Process -->
  <process id="Process_SP" isExecutable="false">
    <startEvent id="Event_SPStart" name="Informed about assignment">
      <messageEventDefinition/>
    </startEvent>
    <endEvent id="Event_SPEnd" name="Information received"/>
    <sequenceFlow id="Flow_SP_1" sourceRef="Event_SPStart" targetRef="Event_SPEnd"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Shape_Participant_MSPN" bpmnElement="Participant_MSPN" isHorizontal="true">
        <omgdc:Bounds x="60" y="20" width="800" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_MSPNStart" bpmnElement="Event_MSPNStart">
        <omgdc:Bounds x="100" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RegisterMeasurement" bpmnElement="Task_RegisterMeasurement">
        <omgdc:Bounds x="180" y="50" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_MSPNEnd" bpmnElement="Event_MSPNEnd">
        <omgdc:Bounds x="340" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_GO" bpmnElement="Participant_GO" isHorizontal="true">
        <omgdc:Bounds x="60" y="160" width="800" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GOStart" bpmnElement="Event_GOStart">
        <omgdc:Bounds x="100" y="240" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ExamineApplication" bpmnElement="Task_ExamineApplication">
        <omgdc:Bounds x="170" y="228" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Decision" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <omgdc:Bounds x="325" y="233" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RejectApplication" bpmnElement="Task_RejectApplication">
        <omgdc:Bounds x="410" y="160" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GORejected" bpmnElement="Event_GORejected">
        <omgdc:Bounds x="570" y="178" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ConfirmApplication" bpmnElement="Task_ConfirmApplication">
        <omgdc:Bounds x="410" y="260" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AssignMSPN" bpmnElement="Task_AssignMSPN">
        <omgdc:Bounds x="560" y="260" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InformMSPO" bpmnElement="Task_InformMSPO">
        <omgdc:Bounds x="710" y="260" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InformMPO" bpmnElement="Task_InformMPO">
        <omgdc:Bounds x="860" y="260" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InformSP" bpmnElement="Task_InformSP">
        <omgdc:Bounds x="1010" y="260" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GOEnd" bpmnElement="Event_GOEnd">
        <omgdc:Bounds x="1170" y="272" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_MSPO" bpmnElement="Participant_MSPO" isHorizontal="true">
        <omgdc:Bounds x="60" y="380" width="800" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_MSPOStart" bpmnElement="Event_MSPOStart">
        <omgdc:Bounds x="740" y="412" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_MSPOEnd" bpmnElement="Event_MSPOEnd">
        <omgdc:Bounds x="840" y="412" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_MPO" bpmnElement="Participant_MPO" isHorizontal="true">
        <omgdc:Bounds x="60" y="490" width="800" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_MPOStart" bpmnElement="Event_MPOStart">
        <omgdc:Bounds x="890" y="522" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_MPOEnd" bpmnElement="Event_MPOEnd">
        <omgdc:Bounds x="990" y="522" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_SP" bpmnElement="Participant_SP" isHorizontal="true">
        <omgdc:Bounds x="60" y="600" width="800" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SPStart" bpmnElement="Event_SPStart">
        <omgdc:Bounds x="1040" y="632" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SPEnd" bpmnElement="Event_SPEnd">
        <omgdc:Bounds x="1140" y="632" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_MSPN_1" bpmnElement="Flow_MSPN_1">
        <omgdi:waypoint x="136" y="80"/>
        <omgdi:waypoint x="180" y="80"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MSPN_2" bpmnElement="Flow_MSPN_2">
        <omgdi:waypoint x="300" y="80"/>
        <omgdi:waypoint x="340" y="80"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_GO_1" bpmnElement="Flow_GO_1">
        <omgdi:waypoint x="136" y="258"/>
        <omgdi:waypoint x="170" y="258"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_2" bpmnElement="Flow_GO_2">
        <omgdi:waypoint x="290" y="258"/>
        <omgdi:waypoint x="325" y="258"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_3" bpmnElement="Flow_GO_3">
        <omgdi:waypoint x="350" y="233"/>
        <omgdi:waypoint x="350" y="190"/>
        <omgdi:waypoint x="410" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_4" bpmnElement="Flow_GO_4">
        <omgdi:waypoint x="350" y="283"/>
        <omgdi:waypoint x="350" y="290"/>
        <omgdi:waypoint x="410" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_5" bpmnElement="Flow_GO_5">
        <omgdi:waypoint x="530" y="190"/>
        <omgdi:waypoint x="570" y="196"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_6" bpmnElement="Flow_GO_6">
        <omgdi:waypoint x="530" y="290"/>
        <omgdi:waypoint x="560" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_7" bpmnElement="Flow_GO_7">
        <omgdi:waypoint x="680" y="290"/>
        <omgdi:waypoint x="710" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_8" bpmnElement="Flow_GO_8">
        <omgdi:waypoint x="830" y="290"/>
        <omgdi:waypoint x="860" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_9" bpmnElement="Flow_GO_9">
        <omgdi:waypoint x="980" y="290"/>
        <omgdi:waypoint x="1010" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GO_10" bpmnElement="Flow_GO_10">
        <omgdi:waypoint x="1130" y="290"/>
        <omgdi:waypoint x="1170" y="290"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MSPO_1" bpmnElement="Flow_MSPO_1">
        <omgdi:waypoint x="776" y="430"/>
        <omgdi:waypoint x="840" y="430"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MPO_1" bpmnElement="Flow_MPO_1">
        <omgdi:waypoint x="926" y="540"/>
        <omgdi:waypoint x="990" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SP_1" bpmnElement="Flow_SP_1">
        <omgdi:waypoint x="1076" y="650"/>
        <omgdi:waypoint x="1140" y="650"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MF_Register" bpmnElement="MF_Register">
        <omgdi:waypoint x="240" y="110"/>
        <omgdi:waypoint x="118" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_InformMSPO" bpmnElement="MF_InformMSPO">
        <omgdi:waypoint x="770" y="320"/>
        <omgdi:waypoint x="758" y="412"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_InformMPO" bpmnElement="MF_InformMPO">
        <omgdi:waypoint x="920" y="320"/>
        <omgdi:waypoint x="908" y="522"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_InformSP" bpmnElement="MF_InformSP">
        <omgdi:waypoint x="1070" y="320"/>
        <omgdi:waypoint x="1058" y="632"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
