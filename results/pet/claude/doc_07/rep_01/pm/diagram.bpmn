  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mspn_part" name="MSPN" processRef="pool_mspn_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="msg_end_register" targetRef="msg_start_register" name="MeasurementRegistered" />
    <bpmn:messageFlow id="mf2" sourceRef="msg_end_inform_mspo" targetRef="msg_start_mspo" name="AssignmentInfoMSPO" />
    <bpmn:messageFlow id="mf3" sourceRef="msg_end_inform_mpo" targetRef="msg_start_mpo" name="AssignmentInfoMPO" />
    <bpmn:messageFlow id="mf4" sourceRef="msg_end_inform_sp" targetRef="msg_start_sp" name="AssignmentInfoSP" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mspn_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_mspn_application" name="MSPN Application" dataObjectRef="doc_mspn_application_do" />
    <bpmn:dataObject id="doc_mspn_application_do" />
    <bpmn:startEvent id="start_register" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="msg_end_register" name="Measurement registered">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_register_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_register" name="Register measurement at GO">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_doa0">
        <bpmn:targetRef>doc_mspn_application</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f1" sourceRef="start_register" targetRef="task_register" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_register" targetRef="msg_end_register" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_mspn_application_p1" name="MSPN Application" dataObjectRef="doc_mspn_application_p1_do" />
    <bpmn:dataObject id="doc_mspn_application_p1_do" />
    <bpmn:dataObjectReference id="doc_mspn_rejection" name="MSPN Rejection Notice" dataObjectRef="doc_mspn_rejection_do" />
    <bpmn:dataObject id="doc_mspn_rejection_do" />
    <bpmn:dataObjectReference id="doc_mspn_confirmation" name="MSPN Confirmation" dataObjectRef="doc_mspn_confirmation_do" />
    <bpmn:dataObject id="doc_mspn_confirmation_do" />
    <bpmn:dataObjectReference id="doc_mspn_assignment" name="MSPN Assignment" dataObjectRef="doc_mspn_assignment_do" />
    <bpmn:dataObject id="doc_mspn_assignment_do" />
    <bpmn:startEvent id="msg_start_register" name="Measurement received">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_start_register_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="msg_end_inform_mspo" name="Inform MSPO sent">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_end_inform_mspo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msg_end_inform_mpo" name="Inform MPO sent">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_end_inform_mpo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="msg_end_inform_sp" name="Inform SP sent">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:messageEventDefinition id="msg_end_inform_sp_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go" name="End">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_examine" name="Examine application of MSPN">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="task_examine_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_dia0">
        <bpmn:sourceRef>doc_mspn_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_reject" name="Reject application of MSPN">
      <bpmn:incoming>flow_to_reject</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:property id="task_reject_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_reject_dia0">
        <bpmn:sourceRef>doc_mspn_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_reject_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_reject_doa0">
        <bpmn:targetRef>doc_mspn_rejection</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_confirm" name="Confirm application of MSPN">
      <bpmn:incoming>flow_to_confirm</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:property id="task_confirm_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_confirm_dia0">
        <bpmn:sourceRef>doc_mspn_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_confirm_prop</bpmn:targetRef>
