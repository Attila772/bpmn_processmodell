      <bpmn:dataOutputAssociation id="task_confirm_doa0">
        <bpmn:targetRef>doc_mspn_confirmation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_assign" name="Assign MSPN">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
