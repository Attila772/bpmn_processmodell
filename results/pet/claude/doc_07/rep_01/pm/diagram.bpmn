        <bpmn:targetRef>doc_mspn_assignment</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decision" name="Application decision" isMarkerVisible="true">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>flow_to_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_to_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f3" sourceRef="msg_start_register" targetRef="task_examine" />
    <bpmn:sequenceFlow id="f4" sourceRef="task_examine" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_to_reject" sourceRef="gw_decision" targetRef="task_reject" name="rejected" />
    <bpmn:sequenceFlow id="flow_to_confirm" sourceRef="gw_decision" targetRef="task_confirm" name="confirmed" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_reject" targetRef="end_go" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_confirm" targetRef="task_assign" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_assign" targetRef="msg_end_inform_mspo" />
