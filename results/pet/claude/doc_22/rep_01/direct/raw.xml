<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_SPPUGO" name="SP / PU / GO" processRef="Process_SPPUGO" />
    <participant id="Participant_MPO" name="MPO" processRef="Process_MPO" />
    <messageFlow id="MF_Request" name="Change request" sourceRef="Task_SendRequest" targetRef="StartEvent_MsgReceived" />
    <messageFlow id="MF_Reject" name="Rejection" sourceRef="Task_RejectNotify" targetRef="Task_ReceiveOutcome" />
    <messageFlow id="MF_Report" name="Implementation report" sourceRef="Task_ReportImplementation" targetRef="Task_ReceiveOutcome" />
    <messageFlow id="MF_Failure" name="Failure notification" sourceRef="Task_NotifyFailure" targetRef="Task_ReceiveOutcome" />
  </collaboration>

  <process id="Process_SPPUGO" name="SP / PU / GO" isExecutable="false">
    <startEvent id="StartEvent_SPPUGO" name="Need for measuring point change">
      <outgoing>Flow_SP1</outgoing>
    </startEvent>

    <task id="Task_SendRequest" name="Request measuring point change">
      <incoming>Flow_SP1</incoming>
      <outgoing>Flow_SP2</outgoing>
    </task>

    <task id="Task_ReceiveOutcome" name="Receive outcome (rejection / implementation report / failure notice)">
      <incoming>Flow_SP2</incoming>
      <outgoing>Flow_SP3</outgoing>
    </task>

    <endEvent id="EndEvent_SPPUGO" name="Process finished">
      <incoming>Flow_SP3</incoming>
    </endEvent>

    <sequenceFlow id="Flow_SP1" sourceRef="StartEvent_SPPUGO" targetRef="Task_SendRequest" />
    <sequenceFlow id="Flow_SP2" sourceRef="Task_SendRequest" targetRef="Task_ReceiveOutcome" />
    <sequenceFlow id="Flow_SP3" sourceRef="Task_ReceiveOutcome" targetRef="EndEvent_SPPUGO" />
  </process>

  <process id="Process_MPO" name="MPO" isExecutable="false">
    <startEvent id="StartEvent_MsgReceived" name="Change request received from SP/PU/GO">
      <messageEventDefinition id="MessageEventDefinition_1" />
      <outgoing>Flow_M1</outgoing>
    </startEvent>

    <startEvent id="StartEvent_MPOInitiated" name="MPO causes a change himself">
      <outgoing>Flow_M2</outgoing>
    </startEvent>

    <exclusiveGateway id="Gateway_MergeStart" name="Change triggered">
      <incoming>Flow_M1</incoming>
      <incoming>Flow_M2</incoming>
      <outgoing>Flow_M3</outgoing>
    </exclusiveGateway>

    <task id="Task_Review" name="Review the change request">
      <incoming>Flow_M3</incoming>
      <outgoing>Flow_M4</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Decision" name="Reject or confirm?">
      <incoming>Flow_M4</incoming>
      <outgoing>Flow_M5_Reject</outgoing>
      <outgoing>Flow_M5_Confirm</outgoing>
    </exclusiveGateway>

    <task id="Task_RejectNotify" name="Reject the change request">
      <incoming>Flow_M5_Reject</incoming>
      <outgoing>Flow_M6</outgoing>
    </task>

    <endEvent id="EndEvent_Rejected" name="Request rejected">
      <incoming>Flow_M6</incoming>
    </endEvent>

    <task id="Task_PerformChange" name="Perform the measuring point change">
      <incoming>Flow_M5_Confirm</incoming>
      <outgoing>Flow_M7</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Outcome" name="Change successful?">
      <incoming>Flow_M7</incoming>
      <outgoing>Flow_M8_Success</outgoing>
      <outgoing>Flow_M8_Failure</outgoing>
    </exclusiveGateway>

    <task id="Task_ReportImplementation" name="Report implementation to SP/PU/GO">
      <incoming>Flow_M8_Success</incoming>
      <outgoing>Flow_M9</outgoing>
    </task>

    <endEvent id="EndEvent_Success" name="Change implemented">
      <incoming>Flow_M9</incoming>
    </endEvent>

    <task id="Task_NotifyFailure" name="Notify SP/PU/GO about failure of the change">
      <incoming>Flow_M8_Failure</incoming>
      <outgoing>Flow_M10</outgoing>
    </task>

    <endEvent id="EndEvent_Failure" name="Change failed">
      <incoming>Flow_M10</incoming>
    </endEvent>

    <sequenceFlow id="Flow_M1" sourceRef="StartEvent_MsgReceived" targetRef="Gateway_MergeStart" />
    <sequenceFlow id="Flow_M2" sourceRef="StartEvent_MPOInitiated" targetRef="Gateway_MergeStart" />
    <sequenceFlow id="Flow_M3" sourceRef="Gateway_MergeStart" targetRef="Task_Review" />
    <sequenceFlow id="Flow_M4" sourceRef="Task_Review" targetRef="Gateway_Decision" />
    <sequenceFlow id="Flow_M5_Reject" name="Reject" sourceRef="Gateway_Decision" targetRef="Task_RejectNotify" />
    <sequenceFlow id="Flow_M5_Confirm" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_PerformChange" />
    <sequenceFlow id="Flow_M6" sourceRef="Task_RejectNotify" targetRef="EndEvent_Rejected" />
    <sequenceFlow id="Flow_M7" sourceRef="Task_PerformChange" targetRef="Gateway_Outcome" />
    <sequenceFlow id="Flow_M8_Success" name="Successful" sourceRef="Gateway_Outcome" targetRef="Task_ReportImplementation" />
    <sequenceFlow id="Flow_M8_Failure" name="Failed" sourceRef="Gateway_Outcome" targetRef="Task_NotifyFailure" />
    <sequenceFlow id="Flow_M9" sourceRef="Task_ReportImplementation" targetRef="EndEvent_Success" />
    <sequenceFlow id="Flow_M10" sourceRef="Task_NotifyFailure" targetRef="EndEvent_Failure" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Shape_Participant_SPPUGO" bpmnElement="Participant_SPPUGO" isHorizontal="true">
        <omgdc:Bounds x="80" y="40" width="900" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_SPPUGO" bpmnElement="StartEvent_SPPUGO">
        <omgdc:Bounds x="120" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_SendRequest" bpmnElement="Task_SendRequest">
        <omgdc:Bounds x="200" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ReceiveOutcome" bpmnElement="Task_ReceiveOutcome">
        <omgdc:Bounds x="820" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_SPPUGO" bpmnElement="EndEvent_SPPUGO">
        <omgdc:Bounds x="990" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_MPO" bpmnElement="Participant_MPO" isHorizontal="true">
        <omgdc:Bounds x="80" y="280" width="1000" height="320" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_MsgReceived" bpmnElement="StartEvent_MsgReceived">
        <omgdc:Bounds x="120" y="330" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_MPOInitiated" bpmnElement="StartEvent_MPOInitiated">
        <omgdc:Bounds x="120" y="430" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_MergeStart" bpmnElement="Gateway_MergeStart">
        <omgdc:Bounds x="200" y="378" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_Review" bpmnElement="Task_Review">
        <omgdc:Bounds x="280" y="358" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_Decision" bpmnElement="Gateway_Decision">
        <omgdc:Bounds x="440" y="378" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_RejectNotify" bpmnElement="Task_RejectNotify">
        <omgdc:Bounds x="520" y="280" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Rejected" bpmnElement="EndEvent_Rejected">
        <omgdc:Bounds x="690" y="298" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_PerformChange" bpmnElement="Task_PerformChange">
        <omgdc:Bounds x="520" y="400" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_Outcome" bpmnElement="Gateway_Outcome">
        <omgdc:Bounds x="690" y="420" width="40" height="40" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ReportImplementation" bpmnElement="Task_ReportImplementation">
        <omgdc:Bounds x="780" y="340" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Success" bpmnElement="EndEvent_Success">
        <omgdc:Bounds x="960" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_NotifyFailure" bpmnElement="Task_NotifyFailure">
        <omgdc:Bounds x="780" y="460" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Failure" bpmnElement="EndEvent_Failure">
        <omgdc:Bounds x="960" y="482" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_SP1" bpmnElement="Flow_SP1">
        <omgdi:waypoint x="156" y="120" />
        <omgdi:waypoint x="200" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_SP2" bpmnElement="Flow_SP2">
        <omgdi:waypoint x="320" y="120" />
        <omgdi:waypoint x="820" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_SP3" bpmnElement="Flow_SP3">
        <omgdi:waypoint x="950" y="120" />
        <omgdi:waypoint x="990" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M1" bpmnElement="Flow_M1">
        <omgdi:waypoint x="156" y="348" />
        <omgdi:waypoint x="200" y="398" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M2" bpmnElement="Flow_M2">
        <omgdi:waypoint x="156" y="448" />
        <omgdi:waypoint x="200" y="398" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M3" bpmnElement="Flow_M3">
        <omgdi:waypoint x="240" y="398" />
        <omgdi:waypoint x="280" y="398" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M4" bpmnElement="Flow_M4">
        <omgdi:waypoint x="400" y="398" />
        <omgdi:waypoint x="440" y="398" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M5_Reject" bpmnElement="Flow_M5_Reject">
        <omgdi:waypoint x="460" y="378" />
        <omgdi:waypoint x="460" y="320" />
        <omgdi:waypoint x="520" y="320" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M5_Confirm" bpmnElement="Flow_M5_Confirm">
        <omgdi:waypoint x="460" y="418" />
        <omgdi:waypoint x="460" y="440" />
        <omgdi:waypoint x="520" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M6" bpmnElement="Flow_M6">
        <omgdi:waypoint x="650" y="320" />
        <omgdi:waypoint x="690" y="316" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M7" bpmnElement="Flow_M7">
        <omgdi:waypoint x="650" y="440" />
        <omgdi:waypoint x="690" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M8_Success" bpmnElement="Flow_M8_Success">
        <omgdi:waypoint x="710" y="420" />
        <omgdi:waypoint x="710" y="380" />
        <omgdi:waypoint x="780" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M8_Failure" bpmnElement="Flow_M8_Failure">
        <omgdi:waypoint x="710" y="460" />
        <omgdi:waypoint x="710" y="500" />
        <omgdi:waypoint x="780" y="500" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M9" bpmnElement="Flow_M9">
        <omgdi:waypoint x="930" y="380" />
        <omgdi:waypoint x="960" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_M10" bpmnElement="Flow_M10">
        <omgdi:waypoint x="930" y="500" />
        <omgdi:waypoint x="960" y="500" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MF_Request" bpmnElement="MF_Request">
        <omgdi:waypoint x="260" y="160" />
        <omgdi:waypoint x="260" y="250" />
        <omgdi:waypoint x="138" y="330" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MF_Reject" bpmnElement="MF_Reject">
        <omgdi:waypoint x="585" y="280" />
        <omgdi:waypoint x="585" y="200" />
        <omgdi:waypoint x="860" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MF_Report" bpmnElement="MF_Report">
        <omgdi:waypoint x="900" y="340" />
        <omgdi:waypoint x="885" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MF_Failure" bpmnElement="MF_Failure">
        <omgdi:waypoint x="900" y="460" />
        <omgdi:waypoint x="900" y="200" />
        <omgdi:waypoint x="880" y="160" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
