<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_spgo_part" name="SP / PU / GO" processRef="pool_spgo_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:messageFlow id="mf_1" sourceRef="start_request" targetRef="start_mpo_change" name="Change request submitted" />
    <bpmn:messageFlow id="mf_2" sourceRef="task_report_success" targetRef="end_notify_success" name="Implementation report" />
    <bpmn:messageFlow id="mf_3" sourceRef="task_report_failure" targetRef="end_notify_failure" name="Failure notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_spgo_proc" isExecutable="false">
    <bpmn:startEvent id="start_request" name="SP / PU / GO requests change">
      <bpmn:messageEventDefinition id="start_request_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_notify_success" name="SP / PU / GO notified of implementation">
      <bpmn:messageEventDefinition id="end_notify_success_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_notify_failure" name="SP / PU / GO notified of failure">
      <bpmn:incoming>flow_reject_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_notify_failure_msgdef" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_change_request" name="Change Request" dataObjectRef="doc_change_request_do" />
    <bpmn:dataObject id="doc_change_request_do" />
    <bpmn:dataObjectReference id="doc_rejection" name="Rejection Notice" dataObjectRef="doc_rejection_do" />
    <bpmn:dataObject id="doc_rejection_do" />
    <bpmn:dataObjectReference id="doc_confirmation" name="Confirmation Notice" dataObjectRef="doc_confirmation_do" />
    <bpmn:dataObject id="doc_confirmation_do" />
    <bpmn:dataObjectReference id="doc_change_record" name="Measuring Point Change Record" dataObjectRef="doc_change_record_do" />
    <bpmn:dataObject id="doc_change_record_do" />
    <bpmn:dataObjectReference id="doc_implementation_report" name="Implementation Report" dataObjectRef="doc_implementation_report_do" />
    <bpmn:dataObject id="doc_implementation_report_do" />
    <bpmn:dataObjectReference id="doc_failure_notification" name="Failure Notification" dataObjectRef="doc_failure_notification_do" />
    <bpmn:dataObject id="doc_failure_notification_do" />
    <bpmn:startEvent id="start_mpo_change" name="MPO initiates change / receives request">
      <bpmn:outgoing>flow_start_to_review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpo_change_msgdef" />
    </bpmn:startEvent>
    <bpmn:task id="task_review_request" name="MPO reviews the change request">
      <bpmn:incoming>flow_start_to_review</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_gw</bpmn:outgoing>
      <bpmn:property id="task_review_request_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_request_dia0">
        <bpmn:sourceRef>doc_change_request</bpmn:sourceRef>
        <bpmn:targetRef>task_review_request_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_reject" name="MPO rejects the change of the measuring point">
      <bpmn:incoming>flow_to_reject</bpmn:incoming>
      <bpmn:outgoing>flow_reject_to_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_reject_doa0">
        <bpmn:targetRef>doc_rejection</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_confirm" name="MPO confirms the request of the SP / PU / GO">
      <bpmn:incoming>flow_to_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_to_perform</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_confirm_doa0">
        <bpmn:targetRef>doc_confirmation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_perform_change" name="MPO performs the measuring point change">
      <bpmn:incoming>flow_confirm_to_perform</bpmn:incoming>
      <bpmn:outgoing>flow_perform_to_outcome</bpmn:outgoing>
      <bpmn:property id="task_perform_change_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_perform_change_dia0">
        <bpmn:sourceRef>doc_confirmation</bpmn:sourceRef>
        <bpmn:targetRef>task_perform_change_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_perform_change_doa0">
        <bpmn:targetRef>doc_change_record</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_report_success" name="MPO reports the implementation to the SP / PU / GO">
      <bpmn:incoming>flow_to_report_success</bpmn:incoming>
      <bpmn:property id="task_report_success_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_report_success_dia0">
        <bpmn:sourceRef>doc_change_record</bpmn:sourceRef>
        <bpmn:targetRef>task_report_success_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_report_success_doa0">
        <bpmn:targetRef>doc_implementation_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_report_failure" name="MPO notifies the SP / PU / GO about the failure of the changes">
      <bpmn:incoming>flow_to_report_failure</bpmn:incoming>
      <bpmn:property id="task_report_failure_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_report_failure_dia0">
        <bpmn:sourceRef>doc_change_record</bpmn:sourceRef>
        <bpmn:targetRef>task_report_failure_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_report_failure_doa0">
        <bpmn:targetRef>doc_failure_notification</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_decision" name="Change request decision" isMarkerVisible="true">
      <bpmn:incoming>flow_review_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_to_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_to_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_outcome" name="Implementation outcome" isMarkerVisible="true">
      <bpmn:incoming>flow_perform_to_outcome</bpmn:incoming>
      <bpmn:outgoing>flow_to_report_success</bpmn:outgoing>
      <bpmn:outgoing>flow_to_report_failure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_review" sourceRef="start_mpo_change" targetRef="task_review_request" />
    <bpmn:sequenceFlow id="flow_review_to_gw" sourceRef="task_review_request" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_to_reject" sourceRef="gw_decision" targetRef="task_reject" name="reject" />
    <bpmn:sequenceFlow id="flow_to_confirm" sourceRef="gw_decision" targetRef="task_confirm" name="confirm" />
    <bpmn:sequenceFlow id="flow_confirm_to_perform" sourceRef="task_confirm" targetRef="task_perform_change" />
    <bpmn:sequenceFlow id="flow_perform_to_outcome" sourceRef="task_perform_change" targetRef="gw_outcome" />
    <bpmn:sequenceFlow id="flow_to_report_success" sourceRef="gw_outcome" targetRef="task_report_success" name="success" />
    <bpmn:sequenceFlow id="flow_to_report_failure" sourceRef="gw_outcome" targetRef="task_report_failure" name="failure" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_spgo_part_di" bpmnElement="pool_spgo_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="700" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_mpo_part_di" bpmnElement="pool_mpo_part" isHorizontal="true">
        <dc:Bounds x="120" y="625" width="1520" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_notify_failure_di" bpmnElement="end_notify_failure">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_notify_success_di" bpmnElement="end_notify_success">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_di" bpmnElement="gw_decision">
        <dc:Bounds x="540" y="685" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_outcome_di" bpmnElement="gw_outcome">
        <dc:Bounds x="1110" y="685" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpo_change_di" bpmnElement="start_mpo_change">
        <dc:Bounds x="160" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_request_di" bpmnElement="start_request">
        <dc:Bounds x="160" y="350" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_confirm_di" bpmnElement="task_confirm">
        <dc:Bounds x="730" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_perform_change_di" bpmnElement="task_perform_change">
        <dc:Bounds x="920" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_reject_di" bpmnElement="task_reject">
        <dc:Bounds x="730" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_report_failure_di" bpmnElement="task_report_failure">
        <dc:Bounds x="1300" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_report_success_di" bpmnElement="task_report_success">
        <dc:Bounds x="1300" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_request_di" bpmnElement="task_review_request">
        <dc:Bounds x="350" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_change_request_di" bpmnElement="doc_change_request">
        <dc:Bounds x="370" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_rejection_di" bpmnElement="doc_rejection">
        <dc:Bounds x="750" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_confirmation_di" bpmnElement="doc_confirmation">
        <dc:Bounds x="845" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_change_record_di" bpmnElement="doc_change_record">
        <dc:Bounds x="1193" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_implementation_report_di" bpmnElement="doc_implementation_report">
        <dc:Bounds x="1320" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_failure_notification_di" bpmnElement="doc_failure_notification">
        <dc:Bounds x="1320" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_review_di" bpmnElement="flow_start_to_review">
        <di:waypoint x="178" y="703" />
        <di:waypoint x="400" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_to_gw_di" bpmnElement="flow_review_to_gw">
        <di:waypoint x="400" y="725" />
        <di:waypoint x="565" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_reject_di" bpmnElement="flow_to_reject">
        <di:waypoint x="565" y="710" />
        <di:waypoint x="780" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_confirm_di" bpmnElement="flow_to_confirm">
        <di:waypoint x="565" y="710" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirm_to_perform_di" bpmnElement="flow_confirm_to_perform">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="970" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_perform_to_outcome_di" bpmnElement="flow_perform_to_outcome">
        <di:waypoint x="970" y="725" />
        <di:waypoint x="1135" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_report_success_di" bpmnElement="flow_to_report_success">
        <di:waypoint x="1135" y="710" />
        <di:waypoint x="1350" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_report_failure_di" bpmnElement="flow_to_report_failure">
        <di:waypoint x="1135" y="710" />
        <di:waypoint x="1350" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reject_to_end_di" bpmnElement="flow_reject_to_end">
        <di:waypoint x="780" y="850" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_1_di" bpmnElement="mf_1">
        <di:waypoint x="178" y="368" />
        <di:waypoint x="178" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_2_di" bpmnElement="mf_2">
        <di:waypoint x="1350" y="850" />
        <di:waypoint x="178" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_3_di" bpmnElement="mf_3">
        <di:waypoint x="1350" y="725" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_review_request_dia0_di" bpmnElement="task_review_request_dia0">
        <di:waypoint x="388" y="975" />
        <di:waypoint x="400" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_reject_doa0_di" bpmnElement="task_reject_doa0">
        <di:waypoint x="780" y="850" />
        <di:waypoint x="768" y="975" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_confirm_doa0_di" bpmnElement="task_confirm_doa0">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="863" y="975" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_perform_change_dia0_di" bpmnElement="task_perform_change_dia0">
        <di:waypoint x="863" y="975" />
        <di:waypoint x="970" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_perform_change_doa0_di" bpmnElement="task_perform_change_doa0">
        <di:waypoint x="970" y="725" />
        <di:waypoint x="1211" y="975" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_report_success_dia0_di" bpmnElement="task_report_success_dia0">
        <di:waypoint x="1211" y="975" />
        <di:waypoint x="1350" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_report_success_doa0_di" bpmnElement="task_report_success_doa0">
        <di:waypoint x="1350" y="850" />
        <di:waypoint x="1338" y="975" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_report_failure_dia0_di" bpmnElement="task_report_failure_dia0">
        <di:waypoint x="1211" y="975" />
        <di:waypoint x="1350" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_report_failure_doa0_di" bpmnElement="task_report_failure_doa0">
        <di:waypoint x="1350" y="725" />
        <di:waypoint x="1338" y="975" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>