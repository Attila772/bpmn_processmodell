<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:messageFlow id="mf_dismissal" sourceRef="end_send_dismissal" targetRef="start_receive_dismissal" name="Dismissal" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:startEvent id="start_mpon" name="Start">
      <bpmn:outgoing>flow_start_to_send</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_dismissal" name="Dismissal sent">
      <bpmn:incoming>flow_start_to_send</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_dismissal_msgdef" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_to_send" sourceRef="start_mpon" targetRef="end_send_dismissal" />
  </bpmn:process>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_dismissal" name="Dismissal" dataObjectRef="data_dismissal_do" />
    <bpmn:dataObject id="data_dismissal_do" />
    <bpmn:startEvent id="start_receive_dismissal" name="Dismissal received">
      <bpmn:outgoing>flow_receive_to_review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_dismissal_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_oppose" name="Dismissal opposed">
      <bpmn:incoming>flow_oppose</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_confirm" name="Dismissal confirmed">
      <bpmn:incoming>flow_confirm</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_review_dismissal" name="Review the dismissal">
      <bpmn:incoming>flow_receive_to_review</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_gw</bpmn:outgoing>
      <bpmn:property id="task_review_dismissal_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_dismissal_dia0">
        <bpmn:sourceRef>data_dismissal</bpmn:sourceRef>
        <bpmn:targetRef>task_review_dismissal_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_decision" name="Dismissal decision" isMarkerVisible="true">
      <bpmn:incoming>flow_review_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_oppose</bpmn:outgoing>
      <bpmn:outgoing>flow_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_receive_to_review" sourceRef="start_receive_dismissal" targetRef="task_review_dismissal" />
    <bpmn:sequenceFlow id="flow_review_to_gw" sourceRef="task_review_dismissal" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_oppose" sourceRef="gw_decision" targetRef="end_oppose" name="opposes" />
    <bpmn:sequenceFlow id="flow_confirm" sourceRef="gw_decision" targetRef="end_confirm" name="confirms" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpon_part_di" bpmnElement="pool_mpon_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="700" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_mpoo_part_di" bpmnElement="pool_mpoo_part" isHorizontal="true">
        <dc:Bounds x="120" y="375" width="950" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_confirm_di" bpmnElement="end_confirm">
        <dc:Bounds x="730" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_oppose_di" bpmnElement="end_oppose">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_send_dismissal_di" bpmnElement="end_send_dismissal">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_di" bpmnElement="gw_decision">
        <dc:Bounds x="540" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpon_di" bpmnElement="start_mpon">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_receive_dismissal_di" bpmnElement="start_receive_dismissal">
        <dc:Bounds x="160" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_dismissal_di" bpmnElement="task_review_dismissal">
        <dc:Bounds x="350" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_dismissal_di" bpmnElement="data_dismissal">
        <dc:Bounds x="370" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_send_di" bpmnElement="flow_start_to_send">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_receive_to_review_di" bpmnElement="flow_receive_to_review">
        <di:waypoint x="178" y="453" />
        <di:waypoint x="400" y="475" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_to_gw_di" bpmnElement="flow_review_to_gw">
        <di:waypoint x="400" y="475" />
        <di:waypoint x="565" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_oppose_di" bpmnElement="flow_oppose">
        <di:waypoint x="565" y="460" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirm_di" bpmnElement="flow_confirm">
        <di:waypoint x="565" y="460" />
        <di:waypoint x="748" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_dismissal_di" bpmnElement="mf_dismissal">
        <di:waypoint x="368" y="118" />
        <di:waypoint x="178" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_review_dismissal_dia0_di" bpmnElement="task_review_dismissal_dia0">
        <di:waypoint x="388" y="725" />
        <di:waypoint x="400" y="475" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>