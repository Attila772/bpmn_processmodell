<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.com/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <messageFlow id="MessageFlow_1" name="Dismissal" sourceRef="Task_SendDismissal" targetRef="Task_ReviewDismissal"/>
  </collaboration>

  <process id="Process_MPON" name="MPON Process" isExecutable="false">
    <startEvent id="StartEvent_MPON" name="Start"/>
    <task id="Task_SendDismissal" name="Send dismissal to MPOO"/>
    <endEvent id="EndEvent_MPON" name="Dismissal Sent"/>

    <sequenceFlow id="Flow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_SendDismissal"/>
    <sequenceFlow id="Flow_MPON_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPON"/>
  </process>

  <process id="Process_MPOO" name="MPOO Process" isExecutable="false">
    <startEvent id="StartEvent_MPOO" name="Dismissal Received"/>
    <task id="Task_ReviewDismissal" name="Review dismissal"/>
    <exclusiveGateway id="Gateway_Decision" name="Dismissal Decision"/>
    <task id="Task_OpposeDismissal" name="Oppose dismissal of MPON"/>
    <task id="Task_ConfirmDismissal" name="Confirm dismissal of MPON"/>
    <endEvent id="EndEvent_Oppose" name="Dismissal Opposed"/>
    <endEvent id="EndEvent_Confirm" name="Dismissal Confirmed"/>

    <sequenceFlow id="Flow_MPOO_1" sourceRef="StartEvent_MPOO" targetRef="Task_ReviewDismissal"/>
    <sequenceFlow id="Flow_MPOO_2" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision"/>
    <sequenceFlow id="Flow_MPOO_3" name="Oppose" sourceRef="Gateway_Decision" targetRef="Task_OpposeDismissal"/>
    <sequenceFlow id="Flow_MPOO_4" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_ConfirmDismissal"/>
    <sequenceFlow id="Flow_MPOO_5" sourceRef="Task_OpposeDismissal" targetRef="EndEvent_Oppose"/>
    <sequenceFlow id="Flow_MPOO_6" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_Confirm"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_MPON_di" bpmnElement="Participant_MPON" isHorizontal="true">
        <omgdc:Bounds x="100" y="60" width="500" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_MPON_di" bpmnElement="StartEvent_MPON">
        <omgdc:Bounds x="150" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendDismissal_di" bpmnElement="Task_SendDismissal">
        <omgdc:Bounds x="240" y="98" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_MPON_di" bpmnElement="EndEvent_MPON">
        <omgdc:Bounds x="400" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Participant_MPOO_di" bpmnElement="Participant_MPOO" isHorizontal="true">
        <omgdc:Bounds x="100" y="260" width="700" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_MPOO_di" bpmnElement="StartEvent_MPOO">
        <omgdc:Bounds x="150" y="360" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewDismissal_di" bpmnElement="Task_ReviewDismissal">
        <omgdc:Bounds x="230" y="338" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <omgdc:Bounds x="380" y="353" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpposeDismissal_di" bpmnElement="Task_OpposeDismissal">
        <omgdc:Bounds x="480" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmDismissal_di" bpmnElement="Task_ConfirmDismissal">
        <omgdc:Bounds x="480" y="400" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Oppose_di" bpmnElement="EndEvent_Oppose">
        <omgdc:Bounds x="650" y="300" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Confirm_di" bpmnElement="EndEvent_Confirm">
        <omgdc:Bounds x="650" y="420" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_MPON_1_di" bpmnElement="Flow_MPON_1">
        <omgdi:waypoint x="186" y="138"/>
        <omgdi:waypoint x="240" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPON_2_di" bpmnElement="Flow_MPON_2">
        <omgdi:waypoint x="340" y="138"/>
        <omgdi:waypoint x="400" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPOO_1_di" bpmnElement="Flow_MPOO_1">
        <omgdi:waypoint x="186" y="378"/>
        <omgdi:waypoint x="230" y="378"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_2_di" bpmnElement="Flow_MPOO_2">
        <omgdi:waypoint x="330" y="378"/>
        <omgdi:waypoint x="380" y="378"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_3_di" bpmnElement="Flow_MPOO_3">
        <omgdi:waypoint x="405" y="353"/>
        <omgdi:waypoint x="405" y="320"/>
        <omgdi:waypoint x="480" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_4_di" bpmnElement="Flow_MPOO_4">
        <omgdi:waypoint x="405" y="403"/>
        <omgdi:waypoint x="405" y="440"/>
        <omgdi:waypoint x="480" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_5_di" bpmnElement="Flow_MPOO_5">
        <omgdi:waypoint x="600" y="320"/>
        <omgdi:waypoint x="650" y="318"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_6_di" bpmnElement="Flow_MPOO_6">
        <omgdi:waypoint x="600" y="440"/>
        <omgdi:waypoint x="650" y="438"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <omgdi:waypoint x="290" y="178"/>
        <omgdi:waypoint x="280" y="338"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
