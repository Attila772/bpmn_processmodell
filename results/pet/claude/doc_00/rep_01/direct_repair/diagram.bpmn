<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_MPON" name="MPON" processRef="Process_MPON" />
    <participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO" />
    <messageFlow id="MessageFlow_1" name="Dismissal" sourceRef="Task_SendDismissal" targetRef="Task_ReviewDismissal" />
  </collaboration>

  <process id="Process_MPON" isExecutable="false">
    <startEvent id="StartEvent_MPON" name="Start">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_SendDismissal" name="Send dismissal of MPON">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <endEvent id="EndEvent_MPON" name="End">
      <incoming>Flow_2</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_MPON" targetRef="Task_SendDismissal" />
    <sequenceFlow id="Flow_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPON" />
  </process>

  <process id="Process_MPOO" isExecutable="false">
    <startEvent id="StartEvent_MPOO" name="Start">
      <outgoing>Flow_3</outgoing>
    </startEvent>

    <task id="Task_ReviewDismissal" name="Review the dismissal">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Decision" name="Decision">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>

    <task id="Task_OpposeDismissal" name="Oppose the dismissal of MPON">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_7</outgoing>
    </task>

    <task id="Task_ConfirmDismissal" name="Confirm the dismissal of MPON">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_8</outgoing>
    </task>

    <endEvent id="EndEvent_MPOO" name="End">
      <incoming>Flow_7</incoming>
      <incoming>Flow_8</incoming>
    </endEvent>

    <sequenceFlow id="Flow_3" sourceRef="StartEvent_MPOO" targetRef="Task_ReviewDismissal" />
    <sequenceFlow id="Flow_4" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision" />
    <sequenceFlow id="Flow_5" name="Oppose" sourceRef="Gateway_Decision" targetRef="Task_OpposeDismissal" />
    <sequenceFlow id="Flow_6" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_ConfirmDismissal" />
    <sequenceFlow id="Flow_7" sourceRef="Task_OpposeDismissal" targetRef="EndEvent_MPOO" />
    <sequenceFlow id="Flow_8" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_MPOO" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_MPON_di" bpmnElement="Participant_MPON" isHorizontal="true">
        <omgdc:Bounds x="100" y="60" width="500" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MPON_di" bpmnElement="StartEvent_MPON">
        <omgdc:Bounds x="150" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendDismissal_di" bpmnElement="Task_SendDismissal">
        <omgdc:Bounds x="240" y="98" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MPON_di" bpmnElement="EndEvent_MPON">
        <omgdc:Bounds x="400" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="186" y="138" />
        <omgdi:waypoint x="240" y="138" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="340" y="138" />
        <omgdi:waypoint x="400" y="138" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_MPOO_di" bpmnElement="Participant_MPOO" isHorizontal="true">
        <omgdc:Bounds x="100" y="260" width="650" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MPOO_di" bpmnElement="StartEvent_MPOO">
        <omgdc:Bounds x="150" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewDismissal_di" bpmnElement="Task_ReviewDismissal">
        <omgdc:Bounds x="240" y="318" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <omgdc:Bounds x="395" y="333" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_OpposeDismissal_di" bpmnElement="Task_OpposeDismissal">
        <omgdc:Bounds x="500" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConfirmDismissal_di" bpmnElement="Task_ConfirmDismissal">
        <omgdc:Bounds x="500" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MPOO_di" bpmnElement="EndEvent_MPOO">
        <omgdc:Bounds x="680" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="186" y="358" />
        <omgdi:waypoint x="240" y="358" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="340" y="358" />
        <omgdi:waypoint x="395" y="358" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="420" y="333" />
        <omgdi:waypoint x="420" y="300" />
        <omgdi:waypoint x="500" y="300" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="420" y="383" />
        <omgdi:waypoint x="420" y="420" />
        <omgdi:waypoint x="500" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <omgdi:waypoint x="620" y="300" />
        <omgdi:waypoint x="698" y="300" />
        <omgdi:waypoint x="698" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <omgdi:waypoint x="620" y="420" />
        <omgdi:waypoint x="698" y="420" />
        <omgdi:waypoint x="698" y="376" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <omgdi:waypoint x="290" y="178" />
        <omgdi:waypoint x="290" y="318" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
