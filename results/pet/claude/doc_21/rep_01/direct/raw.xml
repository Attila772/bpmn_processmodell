<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:messageFlow id="MessageFlow_1" name="Dismissal" sourceRef="Task_SendDismissal" targetRef="StartEvent_MSPO"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MSPN" name="MSPN Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPN" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendDismissal" name="Send Dismissal">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MSPN" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_MSPN" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MSPN"/>
  </bpmn:process>

  <bpmn:process id="Process_MSPO" name="MSPO Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPO" name="Dismissal Received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_1"/>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_RejectDismissal" name="Reject Dismissal">
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmDismissal" name="Confirm Dismissal">
      <bpmn:incoming>Flow_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Rejected" name="Dismissal Rejected">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Confirmed" name="Dismissal Confirmed">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_3" sourceRef="StartEvent_MSPO" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_Reject" name="Reject" sourceRef="Gateway_Decision" targetRef="Task_RejectDismissal"/>
    <bpmn:sequenceFlow id="Flow_Confirm" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RejectDismissal" targetRef="EndEvent_Rejected"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_Confirmed"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_MSPN_di" bpmnElement="Participant_MSPN" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="500" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_MSPN_di" bpmnElement="StartEvent_MSPN">
        <dc:Bounds x="150" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendDismissal_di" bpmnElement="Task_SendDismissal">
        <dc:Bounds x="240" y="98" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_MSPN_di" bpmnElement="EndEvent_MSPN">
        <dc:Bounds x="400" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="186" y="138"/>
        <di:waypoint x="240" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="138"/>
        <di:waypoint x="400" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_MSPO_di" bpmnElement="Participant_MSPO" isHorizontal="true">
        <dc:Bounds x="100" y="260" width="700" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_MSPO_di" bpmnElement="StartEvent_MSPO">
        <dc:Bounds x="150" y="350" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewDismissal_di" bpmnElement="Task_ReviewDismissal">
        <dc:Bounds x="240" y="328" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="395" y="343" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectDismissal_di" bpmnElement="Task_RejectDismissal">
        <dc:Bounds x="520" y="280" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmDismissal_di" bpmnElement="Task_ConfirmDismissal">
        <dc:Bounds x="520" y="400" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="680" y="302" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Confirmed_di" bpmnElement="EndEvent_Confirmed">
        <dc:Bounds x="680" y="422" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="186" y="368"/>
        <di:waypoint x="240" y="368"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="340" y="368"/>
        <di:waypoint x="395" y="368"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_di" bpmnElement="Flow_Reject">
        <di:waypoint x="420" y="343"/>
        <di:waypoint x="420" y="320"/>
        <di:waypoint x="520" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Confirm_di" bpmnElement="Flow_Confirm">
        <di:waypoint x="420" y="393"/>
        <di:waypoint x="420" y="440"/>
        <di:waypoint x="520" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="620" y="320"/>
        <di:waypoint x="680" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="620" y="440"/>
        <di:waypoint x="680" y="440"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="290" y="178"/>
        <di:waypoint x="290" y="263"/>
        <di:waypoint x="168" y="263"/>
        <di:waypoint x="168" y="350"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
