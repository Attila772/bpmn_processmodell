<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.com/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <messageFlow id="MessageFlow_1" sourceRef="Task_SendDismissal" targetRef="Task_ReviewDismissal"/>
    <messageFlow id="MessageFlow_2" sourceRef="Task_RejectDismissal" targetRef="EndEvent_MSPN"/>
    <messageFlow id="MessageFlow_3" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_MSPN"/>
  </collaboration>

  <process id="Process_MSPN" name="MSPN" isExecutable="false">
    <startEvent id="StartEvent_MSPN" name="Start">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_SendDismissal" name="Send dismissal">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <endEvent id="EndEvent_MSPN" name="Dismissal outcome received">
      <incoming>Flow_2</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_MSPN" targetRef="Task_SendDismissal"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MSPN"/>
  </process>

  <process id="Process_MSPO" name="MSPO" isExecutable="false">
    <startEvent id="StartEvent_MSPO" name="Dismissal received">
      <outgoing>Flow_3</outgoing>
    </startEvent>

    <task id="Task_ReviewDismissal" name="Review the dismissal">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Decision" name="Decision">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>

    <task id="Task_RejectDismissal" name="Reject the dismissal">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_7</outgoing>
    </task>

    <task id="Task_ConfirmDismissal" name="Confirm the dismissal">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_8</outgoing>
    </task>

    <endEvent id="EndEvent_MSPO_Rejected" name="Dismissal rejected">
      <incoming>Flow_7</incoming>
    </endEvent>

    <endEvent id="EndEvent_MSPO_Confirmed" name="Dismissal confirmed">
      <incoming>Flow_8</incoming>
    </endEvent>

    <sequenceFlow id="Flow_3" sourceRef="StartEvent_MSPO" targetRef="Task_ReviewDismissal"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision"/>
    <sequenceFlow id="Flow_5" name="Reject" sourceRef="Gateway_Decision" targetRef="Task_RejectDismissal"/>
    <sequenceFlow id="Flow_6" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_ConfirmDismissal"/>
    <sequenceFlow id="Flow_7" sourceRef="Task_RejectDismissal" targetRef="EndEvent_MSPO_Rejected"/>
    <sequenceFlow id="Flow_8" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_MSPO_Confirmed"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_MSPN_di" bpmnElement="Participant_MSPN" isHorizontal="true">
        <omgdc:Bounds x="100" y="60" width="600" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MSPN_di" bpmnElement="StartEvent_MSPN">
        <omgdc:Bounds x="150" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendDismissal_di" bpmnElement="Task_SendDismissal">
        <omgdc:Bounds x="240" y="98" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MSPN_di" bpmnElement="EndEvent_MSPN">
        <omgdc:Bounds x="560" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="186" y="138"/>
        <omgdi:waypoint x="240" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="360" y="138"/>
        <omgdi:waypoint x="560" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_MSPO_di" bpmnElement="Participant_MSPO" isHorizontal="true">
        <omgdc:Bounds x="100" y="260" width="600" height="220"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MSPO_di" bpmnElement="StartEvent_MSPO">
        <omgdc:Bounds x="150" y="350" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewDismissal_di" bpmnElement="Task_ReviewDismissal">
        <omgdc:Bounds x="240" y="328" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <omgdc:Bounds x="400" y="343" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RejectDismissal_di" bpmnElement="Task_RejectDismissal">
        <omgdc:Bounds x="500" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConfirmDismissal_di" bpmnElement="Task_ConfirmDismissal">
        <omgdc:Bounds x="500" y="390" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MSPO_Rejected_di" bpmnElement="EndEvent_MSPO_Rejected">
        <omgdc:Bounds x="660" y="300" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MSPO_Confirmed_di" bpmnElement="EndEvent_MSPO_Confirmed">
        <omgdc:Bounds x="660" y="412" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="186" y="368"/>
        <omgdi:waypoint x="240" y="368"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="360" y="368"/>
        <omgdi:waypoint x="400" y="368"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="425" y="343"/>
        <omgdi:waypoint x="425" y="320"/>
        <omgdi:waypoint x="500" y="320"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="425" y="393"/>
        <omgdi:waypoint x="425" y="430"/>
        <omgdi:waypoint x="500" y="430"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <omgdi:waypoint x="620" y="320"/>
        <omgdi:waypoint x="660" y="318"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <omgdi:waypoint x="620" y="430"/>
        <omgdi:waypoint x="660" y="430"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <omgdi:waypoint x="300" y="178"/>
        <omgdi:waypoint x="300" y="328"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <omgdi:waypoint x="578" y="280"/>
        <omgdi:waypoint x="578" y="156"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_3_di" bpmnElement="MessageFlow_3">
        <omgdi:waypoint x="578" y="390"/>
        <omgdi:waypoint x="578" y="156"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
