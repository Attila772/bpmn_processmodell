<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpu_part" name="Mail Processing Unit" processRef="pool_mpu_proc" />
    <bpmn:participant id="pool_registry_part" name="Registry" processRef="pool_registry_proc" />
    <bpmn:participant id="pool_cashier_part" name="Cashier" processRef="pool_cashier_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="end_mail_distributed" targetRef="start_mail_received" name="Unopened Mail" />
    <bpmn:messageFlow id="mf2" sourceRef="end_send_to_cashier" targetRef="start_receive_matter_details" name="Matter Details" />
    <bpmn:messageFlow id="mf3" sourceRef="end_send_receipt_to_registry" targetRef="start_receipt_from_cashier" name="Receipt and Court File" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpu_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_unopened_mail" name="Unopened Mail" dataObjectRef="data_unopened_mail_do" />
    <bpmn:dataObject id="data_unopened_mail_do" />
    <bpmn:startEvent id="start_mail_collected" name="Mail collected from party">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mail_distributed" name="Mail distributed">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_mail_distributed_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_sort_unopened_mail" name="Sort unopened mail into business areas">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_sort_unopened_mail_doa0">
        <bpmn:targetRef>data_unopened_mail</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow1" sourceRef="start_mail_collected" targetRef="task_sort_unopened_mail" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task_sort_unopened_mail" targetRef="end_mail_distributed" />
  </bpmn:process>
  <bpmn:process id="pool_registry_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_unopened_mail_p1" name="Unopened Mail" dataObjectRef="data_unopened_mail_p1_do" />
    <bpmn:dataObject id="data_unopened_mail_p1_do" />
    <bpmn:dataObjectReference id="data_mail_register_entry" name="Incoming Mail Register Entry" dataObjectRef="data_mail_register_entry_do" />
    <bpmn:dataObject id="data_mail_register_entry_do" />
    <bpmn:dataObjectReference id="data_requisition_list" name="List of Requisition" dataObjectRef="data_requisition_list_do" />
    <bpmn:dataObject id="data_requisition_list_do" />
    <bpmn:dataObjectReference id="data_matter_details" name="Matter Details" dataObjectRef="data_matter_details_do" />
    <bpmn:dataObject id="data_matter_details_do" />
    <bpmn:dataObjectReference id="data_receipt_p1" name="Receipt" dataObjectRef="data_receipt_p1_do" />
    <bpmn:dataObject id="data_receipt_p1_do" />
    <bpmn:startEvent id="start_mail_received" name="Mail received at Registry">
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mail_received_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_requisition" name="Requisition list sent to party">
      <bpmn:incoming>flow6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_send_to_cashier" name="Matter details sent to Cashier">
      <bpmn:incoming>flow7</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_to_cashier_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_receipt_from_cashier" name="Receipt received from Cashier">
      <bpmn:outgoing>flow12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receipt_from_cashier_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_registry_process" name="Process completed">
      <bpmn:incoming>flow13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_open_sort_register" name="Open and sort mail, register in Mail Register">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
      <bpmn:property id="task_open_sort_register_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_open_sort_register_dia0">
        <bpmn:sourceRef>data_unopened_mail_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_open_sort_register_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_open_sort_register_doa0">
        <bpmn:targetRef>data_mail_register_entry</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_quality_check" name="Perform quality check on mail">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:outgoing>flow5</bpmn:outgoing>
      <bpmn:property id="task_quality_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_quality_check_dia0">
        <bpmn:sourceRef>data_mail_register_entry</bpmn:sourceRef>
        <bpmn:targetRef>task_quality_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_compile_requisition_list" name="Compile list of requisition with reason for rejection">
      <bpmn:incoming>flow_gw_to_requisition</bpmn:incoming>
      <bpmn:outgoing>flow6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_compile_requisition_list_doa0">
        <bpmn:targetRef>data_requisition_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_capture_matter_details" name="Capture matter details (types of action)">
      <bpmn:incoming>flow_gw_to_capture</bpmn:incoming>
      <bpmn:outgoing>flow7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_capture_matter_details_doa0">
        <bpmn:targetRef>data_matter_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_post_receipt" name="Put receipt and copied documents into envelope and post to party">
      <bpmn:incoming>flow12</bpmn:incoming>
      <bpmn:outgoing>flow13</bpmn:outgoing>
      <bpmn:property id="task_post_receipt_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_post_receipt_dia0">
        <bpmn:sourceRef>data_receipt_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_post_receipt_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_compliant" name="Mail compliant?" isMarkerVisible="true">
      <bpmn:incoming>flow5</bpmn:incoming>
      <bpmn:outgoing>flow_gw_to_requisition</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_to_capture</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow3" sourceRef="start_mail_received" targetRef="task_open_sort_register" />
    <bpmn:sequenceFlow id="flow4" sourceRef="task_open_sort_register" targetRef="task_quality_check" />
    <bpmn:sequenceFlow id="flow5" sourceRef="task_quality_check" targetRef="gw_compliant" />
    <bpmn:sequenceFlow id="flow_gw_to_requisition" sourceRef="gw_compliant" targetRef="task_compile_requisition_list" name="not compliant" />
    <bpmn:sequenceFlow id="flow_gw_to_capture" sourceRef="gw_compliant" targetRef="task_capture_matter_details" name="compliant" />
    <bpmn:sequenceFlow id="flow6" sourceRef="task_compile_requisition_list" targetRef="end_send_requisition" />
    <bpmn:sequenceFlow id="flow7" sourceRef="task_capture_matter_details" targetRef="end_send_to_cashier" />
    <bpmn:sequenceFlow id="flow12" sourceRef="start_receipt_from_cashier" targetRef="task_post_receipt" />
    <bpmn:sequenceFlow id="flow13" sourceRef="task_post_receipt" targetRef="end_registry_process" />
  </bpmn:process>
  <bpmn:process id="pool_cashier_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_matter_details_p1" name="Matter Details" dataObjectRef="data_matter_details_p1_do" />
    <bpmn:dataObject id="data_matter_details_p1_do" />
    <bpmn:dataObjectReference id="data_receipt" name="Receipt" dataObjectRef="data_receipt_do" />
    <bpmn:dataObject id="data_receipt_do" />
    <bpmn:dataObjectReference id="data_party_details" name="Party Details" dataObjectRef="data_party_details_do" />
    <bpmn:dataObject id="data_party_details_do" />
    <bpmn:dataObjectReference id="data_physical_court_file" name="Physical Court File" dataObjectRef="data_physical_court_file_do" />
    <bpmn:dataObject id="data_physical_court_file_do" />
    <bpmn:startEvent id="start_receive_matter_details" name="Matter details received">
      <bpmn:outgoing>flow8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_matter_details_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_receipt_to_registry" name="Receipt and file sent to Registry">
      <bpmn:incoming>flow11</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_receipt_to_registry_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_take_fees" name="Take applicable fees attached to mail">
      <bpmn:incoming>flow8</bpmn:incoming>
      <bpmn:outgoing>flow9</bpmn:outgoing>
      <bpmn:property id="task_take_fees_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_take_fees_dia0">
        <bpmn:sourceRef>data_matter_details_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_take_fees_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_take_fees_doa0">
        <bpmn:targetRef>data_receipt</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_capture_party_details" name="Capture Party Details">
      <bpmn:incoming>flow9</bpmn:incoming>
      <bpmn:outgoing>flow10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_capture_party_details_doa0">
        <bpmn:targetRef>data_party_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_print_physical_court_file" name="Print Physical Court File">
      <bpmn:incoming>flow10</bpmn:incoming>
      <bpmn:outgoing>flow11</bpmn:outgoing>
      <bpmn:property id="task_print_physical_court_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_print_physical_court_file_dia0">
        <bpmn:sourceRef>data_party_details</bpmn:sourceRef>
        <bpmn:targetRef>task_print_physical_court_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_print_physical_court_file_doa0">
        <bpmn:targetRef>data_physical_court_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow8" sourceRef="start_receive_matter_details" targetRef="task_take_fees" />
    <bpmn:sequenceFlow id="flow9" sourceRef="task_take_fees" targetRef="task_capture_party_details" />
    <bpmn:sequenceFlow id="flow10" sourceRef="task_capture_party_details" targetRef="task_print_physical_court_file" />
    <bpmn:sequenceFlow id="flow11" sourceRef="task_print_physical_court_file" targetRef="end_send_receipt_to_registry" />
  </bpmn:process>
