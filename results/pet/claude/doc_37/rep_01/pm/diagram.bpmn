<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpu_part" name="Mail Processing Unit" processRef="pool_mpu_proc" />
    <bpmn:participant id="pool_registry_part" name="Registry" processRef="pool_registry_proc" />
    <bpmn:participant id="pool_cashier_part" name="Cashier" processRef="pool_cashier_proc" />
    <bpmn:messageFlow id="mf_1" sourceRef="end_mpu_send" targetRef="start_registry_receive" name="Mail Handover" />
    <bpmn:messageFlow id="mf_2" sourceRef="end_send_to_cashier" targetRef="start_cashier_receive" name="Matter Details Handover" />
    <bpmn:messageFlow id="mf_3" sourceRef="end_cashier_send_receipt" targetRef="start_receive_receipt_info" name="Receipt Handover" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpu_proc" isExecutable="false">
    <bpmn:startEvent id="start_1" name="Mail collected from party">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpu_send" name="Mail sent to Registry">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_mpu_send_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_sort_mail" name="Sort unopened mail into business areas">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_sort_mail" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_sort_mail" targetRef="end_mpu_send" />
  </bpmn:process>
  <bpmn:process id="pool_registry_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_mail_register" name="Incoming Mail Register" dataObjectRef="data_mail_register_do" />
    <bpmn:dataObject id="data_mail_register_do" />
    <bpmn:dataObjectReference id="data_requisition_list" name="List of Requisition" dataObjectRef="data_requisition_list_do" />
    <bpmn:dataObject id="data_requisition_list_do" />
    <bpmn:dataObjectReference id="data_matter_details" name="Matter Details (Types of Action)" dataObjectRef="data_matter_details_do" />
    <bpmn:dataObject id="data_matter_details_do" />
    <bpmn:dataObjectReference id="data_receipt_p1" name="Receipt and Copied Documents" dataObjectRef="data_receipt_p1_do" />
    <bpmn:dataObject id="data_receipt_p1_do" />
    <bpmn:startEvent id="start_registry_receive" name="Mail received at Registry">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_registry_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_send_requisition" name="Requisition list sent to party">
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_send_to_cashier" name="Matter details sent to Cashier">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_send_to_cashier_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_receive_receipt_info" name="Registry receives receipt">
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_receive_receipt_info_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_process" name="Process completed">
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_open_sort_register" name="Open, sort and register mail">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_open_sort_register_doa0">
        <bpmn:targetRef>data_mail_register</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_quality_check" name="Perform quality check on mail">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_compile_requisition" name="Compile list of requisition">
      <bpmn:incoming>flow_gw_to_requisition</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_compile_requisition_doa0">
        <bpmn:targetRef>data_requisition_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task_capture_matter_details" name="Capture matter details (types of action)">
      <bpmn:incoming>flow_gw_to_capture</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_capture_matter_details_doa0">
        <bpmn:targetRef>data_matter_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_envelope_post" name="Put receipt and copied documents into envelope and post to party">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:property id="task_envelope_post_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_envelope_post_dia0">
        <bpmn:sourceRef>data_receipt_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_envelope_post_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_compliant" name="Mail compliant?" isMarkerVisible="true">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_gw_to_requisition</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_to_capture</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_3" sourceRef="start_registry_receive" targetRef="task_open_sort_register" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_open_sort_register" targetRef="task_quality_check" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_quality_check" targetRef="gw_compliant" />
    <bpmn:sequenceFlow id="flow_gw_to_requisition" sourceRef="gw_compliant" targetRef="task_compile_requisition" name="not compliant" />
    <bpmn:sequenceFlow id="flow_gw_to_capture" sourceRef="gw_compliant" targetRef="task_capture_matter_details" name="compliant" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_compile_requisition" targetRef="end_send_requisition" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_capture_matter_details" targetRef="end_send_to_cashier" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="start_receive_receipt_info" targetRef="task_envelope_post" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="task_envelope_post" targetRef="end_process" />
  </bpmn:process>
  <bpmn:process id="pool_cashier_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_matter_details_p1" name="Matter Details (Types of Action)" dataObjectRef="data_matter_details_p1_do" />
    <bpmn:dataObject id="data_matter_details_p1_do" />
    <bpmn:dataObjectReference id="data_receipt" name="Receipt and Copied Documents" dataObjectRef="data_receipt_do" />
    <bpmn:dataObject id="data_receipt_do" />
    <bpmn:dataObjectReference id="data_party_details" name="Party Details" dataObjectRef="data_party_details_do" />
    <bpmn:dataObject id="data_party_details_do" />
    <bpmn:dataObjectReference id="data_physical_court_file" name="Physical Court File" dataObjectRef="data_physical_court_file_do" />
    <bpmn:dataObject id="data_physical_court_file_do" />
    <bpmn:startEvent id="start_cashier_receive" name="Cashier receives matter details">
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_cashier_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_cashier_send_receipt" name="Receipt sent to Registry">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_cashier_send_receipt_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_take_fees" name="Take applicable fees attached to mail">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:property id="task_take_fees_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_take_fees_dia0">
        <bpmn:sourceRef>data_matter_details_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_take_fees_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_take_fees_doa0">
        <bpmn:targetRef>data_receipt</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task_capture_party_details" name="Capture Party Details">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_capture_party_details_doa0">
        <bpmn:targetRef>data_party_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_print_physical_file" name="Print the Physical Court File">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:property id="task_print_physical_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_print_physical_file_dia0">
        <bpmn:sourceRef>data_party_details</bpmn:sourceRef>
        <bpmn:targetRef>task_print_physical_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_print_physical_file_doa0">
        <bpmn:targetRef>data_physical_court_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_8" sourceRef="start_cashier_receive" targetRef="task_take_fees" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_take_fees" targetRef="task_capture_party_details" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_capture_party_details" targetRef="task_print_physical_file" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_print_physical_file" targetRef="end_cashier_send_receipt" />
  </bpmn:process>
