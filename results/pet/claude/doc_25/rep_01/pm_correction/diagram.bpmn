      <bpmndi:BPMNShape id="evt_recv_from_supervisor_di" bpmnElement="evt_recv_from_supervisor">
        <dc:Bounds x="160" y="1270" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_recv_vendor_confirmed_di" bpmnElement="evt_recv_vendor_confirmed">
        <dc:Bounds x="160" y="1730" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_notification_recv_di" bpmnElement="evt_send_notification_recv">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_to_purchase_di" bpmnElement="evt_send_to_purchase">
        <dc:Bounds x="730" y="935" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_vendor_confirmed_send_di" bpmnElement="evt_vendor_confirmed_send">
        <dc:Bounds x="920" y="1270" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_di" bpmnElement="gw_decision">
        <dc:Bounds x="540" y="685" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_vendor_valid_di" bpmnElement="gw_vendor_valid">
        <dc:Bounds x="1110" y="1270" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_submit_di" bpmnElement="start_submit">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_choose_different_vendor_di" bpmnElement="task_choose_different_vendor">
        <dc:Bounds x="920" y="1395" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_generate_po_di" bpmnElement="task_generate_po">
        <dc:Bounds x="350" y="1730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_make_quotations_di" bpmnElement="task_make_quotations">
        <dc:Bounds x="350" y="1270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receive_request_di" bpmnElement="task_receive_request">
        <dc:Bounds x="350" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_request_di" bpmnElement="task_register_request">
        <dc:Bounds x="160" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_comments_di" bpmnElement="task_review_comments">
        <dc:Bounds x="160" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_select_vendor_di" bpmnElement="task_select_vendor">
        <dc:Bounds x="540" y="1270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_notification_di" bpmnElement="task_send_notification">
        <dc:Bounds x="920" y="1730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_po_di" bpmnElement="task_send_po">
        <dc:Bounds x="540" y="1730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_wait_delivery_invoice_di" bpmnElement="task_wait_delivery_invoice">
        <dc:Bounds x="730" y="1730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_request_form_p1_di" bpmnElement="doc_request_form_p1">
        <dc:Bounds x="180" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_request_form_di" bpmnElement="doc_request_form">
        <dc:Bounds x="275" y="1075" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_request_form_p2_di" bpmnElement="doc_request_form_p2">
        <dc:Bounds x="370" y="1535" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_quotations_di" bpmnElement="doc_quotations">
