        <di:waypoint x="590" y="1770" />
        <di:waypoint x="780" y="1770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf11_di" bpmnElement="sf11">
        <di:waypoint x="780" y="1770" />
        <di:waypoint x="970" y="1770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf12_di" bpmnElement="sf12">
        <di:waypoint x="970" y="1770" />
        <di:waypoint x="1128" y="1748" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf14_di" bpmnElement="sf14">
        <di:waypoint x="210" y="390" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf1_di" bpmnElement="mf1">
