        <dc:Bounds x="465" y="1870" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_invoice_di" bpmnElement="doc_invoice">
        <dc:Bounds x="750" y="1870" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="210" y="725" />
