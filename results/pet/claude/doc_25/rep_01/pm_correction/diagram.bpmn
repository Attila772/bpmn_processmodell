      <bpmndi:BPMNEdge id="sf5_di" bpmnElement="sf5">
        <di:waypoint x="400" y="1310" />
        <di:waypoint x="590" y="1310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf6_di" bpmnElement="sf6">
        <di:waypoint x="590" y="1310" />
        <di:waypoint x="1135" y="1295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_invalid_di" bpmnElement="flow_invalid">
        <di:waypoint x="1135" y="1295" />
        <di:waypoint x="970" y="1435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf7_di" bpmnElement="sf7">
        <di:waypoint x="970" y="1435" />
        <di:waypoint x="1135" y="1295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_valid_di" bpmnElement="flow_valid">
        <di:waypoint x="1135" y="1295" />
        <di:waypoint x="938" y="1288" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf8_di" bpmnElement="sf8">
        <di:waypoint x="178" y="1748" />
        <di:waypoint x="400" y="1770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf9_di" bpmnElement="sf9">
        <di:waypoint x="400" y="1770" />
        <di:waypoint x="590" y="1770" />
      </bpmndi:BPMNEdge>
