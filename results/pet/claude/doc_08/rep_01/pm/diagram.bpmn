      <bpmn:incoming>f_g1_yes</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f_g4_yes</bpmn:outgoing>
      <bpmn:outgoing>f_g4_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g5" name="New Returns Filed (2nd check)?" isMarkerVisible="true">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f_g5_yes</bpmn:outgoing>
      <bpmn:outgoing>f_g5_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g6" name="Completed by 4:00pm?" isMarkerVisible="true">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f_g6_yes</bpmn:outgoing>
      <bpmn:outgoing>f_g6_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
