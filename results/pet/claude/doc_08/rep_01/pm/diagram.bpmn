  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataStoreReference id="ds1" name="Database" />
    <bpmn:dataObjectReference id="do1" name="Account Defaulter Table" dataObjectRef="do1_do" />
    <bpmn:dataObject id="do1_do" />
    <bpmn:dataStoreReference id="ds2" name="CRM System" />
    <bpmn:dataObjectReference id="do2" name="New Defaulting Accounts Table" dataObjectRef="do2_do" />
    <bpmn:dataObject id="do2_do" />
    <bpmn:dataObjectReference id="do3" name="Alert Message" dataObjectRef="do3_do" />
    <bpmn:dataObject id="do3_do" />
    <bpmn:dataObjectReference id="do4" name="Reconciliation Report" dataObjectRef="do4_do" />
    <bpmn:dataObject id="do4_do" />
    <bpmn:startEvent id="e1" name="Weekday Morning Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="e1_timerdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="e2" name="2:30 PM Deadline Missed">
      <bpmn:incoming>f_g4_no</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="e2_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="e3" name="4:00 PM Deadline Missed">
      <bpmn:incoming>f_g6_no</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="e3_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="e4" name="Process End - No Alert">
      <bpmn:incoming>f_g3_yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e5" name="Process End - Alert Sent (2:30)">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e6" name="Process End - Alert Sent (4:00)">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e7" name="Process End - Reconciled">
      <bpmn:incoming>f_g6_yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e8" name="Process End - No New Returns">
      <bpmn:incoming>f_g2_no</bpmn:incoming>
      <bpmn:incoming>f_g5_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t1" name="Backup Database">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="t2" name="Check Account Defaulter Table for New Records">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:property id="t2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t2_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t3" name="Check CRM System for New Returns">
      <bpmn:incoming>f_g1_no</bpmn:incoming>
      <bpmn:incoming>f_g4_yes</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:property id="t3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t3_dia0">
        <bpmn:sourceRef>ds2</bpmn:sourceRef>
        <bpmn:targetRef>t3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t4" name="Register Defaulting Accounts and Customers">
      <bpmn:incoming>f_g2_yes</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t4_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t4_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Produce New Defaulting Accounts Table">
      <bpmn:incoming>f_g3_no</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:property id="t5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t5_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t5_doa0">
        <bpmn:targetRef>do2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="t6" name="Send Table to Account Management">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:property id="t6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t6_dia0">
        <bpmn:sourceRef>do2</bpmn:sourceRef>
        <bpmn:targetRef>t6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t7" name="Send Alert to Supervisor (2:30pm)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t7_doa0">
        <bpmn:targetRef>do3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="t8" name="Reconcile with Existing Account Defaulters Table">
      <bpmn:incoming>f_g5_yes</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:property id="t8_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t8_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t8_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="t8_dia1">
        <bpmn:sourceRef>do2</bpmn:sourceRef>
        <bpmn:targetRef>t8_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t8_doa0">
        <bpmn:targetRef>do4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="t9" name="Send Message to Supervisor (4:00pm)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t9_doa0">
        <bpmn:targetRef>do3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="New Records in Account Defaulter Table?" isMarkerVisible="true">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f_g1_yes</bpmn:outgoing>
      <bpmn:outgoing>f_g1_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="New Returns Filed?" isMarkerVisible="true">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f_g2_no</bpmn:outgoing>
      <bpmn:outgoing>f_g2_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Client Codes Previously Advised?" isMarkerVisible="true">
