<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataStoreReference id="ds1" name="Database" />
    <bpmn:dataObjectReference id="do1" name="Account Defaulter table" dataObjectRef="do1_do" />
    <bpmn:dataObject id="do1_do" />
    <bpmn:dataStoreReference id="ds2" name="CRM system" />
    <bpmn:dataObjectReference id="do2" name="Table of defaulting accounts" dataObjectRef="do2_do" />
    <bpmn:dataObject id="do2_do" />
    <bpmn:dataObjectReference id="do4" name="Alert message" dataObjectRef="do4_do" />
    <bpmn:dataObject id="do4_do" />
    <bpmn:dataObjectReference id="do3" name="New defaulting account report" dataObjectRef="do3_do" />
    <bpmn:dataObject id="do3_do" />
    <bpmn:dataObjectReference id="do5" name="Supervisor message" dataObjectRef="do5_do" />
    <bpmn:dataObject id="do5_do" />
    <bpmn:startEvent id="ev1" name="Weekday morning starts">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="ev2" name="Deadline 2:30pm reached">
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ev2_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="ev3" name="Deadline 4:00pm reached">
      <bpmn:incoming>sf21b</bpmn:incoming>
      <bpmn:outgoing>sf22</bpmn:outgoing>
      <bpmn:outgoing>sf23</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ev3_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="ev4" name="Process end - no new records">
      <bpmn:incoming>sf4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev5" name="Process end - no new returns (first check)">
      <bpmn:incoming>sf7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev6" name="Process end - alert sent (2:30pm)">
      <bpmn:incoming>sf17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev7" name="Process end - report completed on time">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf18</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev8" name="Process end - no new returns (second check)">
      <bpmn:incoming>sf19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev9" name="Process end - reconciled on time">
      <bpmn:incoming>sf22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ev10" name="Process end - alert sent (4:00pm)">
      <bpmn:incoming>sf24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t1" name="Backup database">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="t2" name="Check Account Defaulter table for new records">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:property id="t2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t2_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t3" name="Check CRM system for new returns filed">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="t3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t3_dia0">
        <bpmn:sourceRef>ds2</bpmn:sourceRef>
        <bpmn:targetRef>t3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t4" name="Register all defaulting accounts and customers">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t4_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t4_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Produce table of defaulting accounts and send to account management">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t5_doa0">
        <bpmn:targetRef>do2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="t6" name="Send alert to supervisor (2:30pm deadline missed)">
      <bpmn:incoming>sf16</bpmn:incoming>
      <bpmn:outgoing>sf17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t6_doa0">
        <bpmn:targetRef>do4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="t7" name="Reconcile with existing Account Defaulter table">
      <bpmn:incoming>sf20</bpmn:incoming>
      <bpmn:outgoing>sf21</bpmn:outgoing>
      <bpmn:property id="t7_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t7_dia0">
        <bpmn:sourceRef>do1</bpmn:sourceRef>
        <bpmn:targetRef>t7_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="t7_dia1">
        <bpmn:sourceRef>do3</bpmn:sourceRef>
        <bpmn:targetRef>t7_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t7_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="t8" name="Send message to supervisor (4:00pm deadline missed)">
      <bpmn:incoming>sf23</bpmn:incoming>
      <bpmn:outgoing>sf24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t8_doa0">
        <bpmn:targetRef>do5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="t9" name="Check CRM system for new returns filed (second check)">
      <bpmn:incoming>sf18</bpmn:incoming>
      <bpmn:outgoing>sf18b</bpmn:outgoing>
      <bpmn:property id="t9_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t9_dia0">
        <bpmn:sourceRef>ds2</bpmn:sourceRef>
        <bpmn:targetRef>t9_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw1" name="New records in Account Defaulter table?" isMarkerVisible="true">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw2" name="New returns filed (CRM check 1)?" isMarkerVisible="true">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
      <bpmn:outgoing>sf8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw3" name="Defaulting client codes previously advised?" isMarkerVisible="true">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:outgoing>sf12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw4" name="Completed by 2:30pm?" isMarkerVisible="true">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw5" name="New returns filed (CRM check 2)?" isMarkerVisible="true">
      <bpmn:incoming>sf18b</bpmn:incoming>
      <bpmn:outgoing>sf19</bpmn:outgoing>
      <bpmn:outgoing>sf20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw6" name="Completed by 4:00pm?" isMarkerVisible="true">
      <bpmn:incoming>sf21</bpmn:incoming>
      <bpmn:outgoing>sf21b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
