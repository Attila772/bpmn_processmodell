    <bpmn:sequenceFlow id="sf2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="sf3" sourceRef="t2" targetRef="gw1" />
    <bpmn:sequenceFlow id="sf4" sourceRef="gw1" targetRef="ev4" name="no new records" />
