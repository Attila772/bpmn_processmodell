    <bpmn:sequenceFlow id="sf21" sourceRef="t7" targetRef="gw6" />
    <bpmn:sequenceFlow id="sf21b" sourceRef="gw6" targetRef="ev3" />
    <bpmn:sequenceFlow id="sf22" sourceRef="ev3" targetRef="ev9" name="completed on time" />
    <bpmn:sequenceFlow id="sf23" sourceRef="ev3" targetRef="t8" name="not completed - deadline passed" />
    <bpmn:sequenceFlow id="sf24" sourceRef="t8" targetRef="ev10" />
  </bpmn:process>
