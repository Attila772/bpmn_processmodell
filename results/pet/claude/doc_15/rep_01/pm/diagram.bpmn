        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_recheck_di" bpmnElement="task_recheck">
        <dc:Bounds x="160" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_draft_schedule_di" bpmnElement="doc_draft_schedule">
        <dc:Bounds x="370" y="490" width="36" height="50" />
