        <dc:Bounds x="180" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_draft_schedule_p1_di" bpmnElement="doc_draft_schedule_p1">
        <dc:Bounds x="370" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
