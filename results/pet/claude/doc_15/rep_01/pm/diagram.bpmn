      <bpmndi:BPMNShape id="task_check_dates_di" bpmnElement="task_check_dates">
        <dc:Bounds x="350" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_diary_di" bpmnElement="task_check_diary">
        <dc:Bounds x="350" y="1020" width="100" height="80" />
