<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do_claim" name="Geregistreerde claim" dataObjectRef="do_claim_do" />
    <bpmn:dataObject id="do_claim_do" />
    <bpmn:dataObjectReference id="do_recommendation" name="Vergoedingsvoorstel" dataObjectRef="do_recommendation_do" />
    <bpmn:dataObject id="do_recommendation_do" />
    <bpmn:startEvent id="start_1" name="Claim ontvangen">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_1" name="Claim handling process continues">
      <bpmn:incoming>flow_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_register" name="Claim registered">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_doa0">
        <bpmn:targetRef>do_claim</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_examine" name="Claim onderzoeken door claims officer">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_examine_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_dia0">
        <bpmn:sourceRef>do_claim</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_write_rec" name="Vergoedingsvoorstel opstellen">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_notok</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_write_rec_doa0">
        <bpmn:targetRef>do_recommendation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="task_check_rec" name="Vergoedingsvoorstel controleren">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:property id="task_check_rec_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_rec_dia0">
        <bpmn:sourceRef>do_recommendation</bpmn:sourceRef>
        <bpmn:targetRef>task_check_rec_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_ok" name="OK?" isMarkerVisible="true">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_ok</bpmn:outgoing>
      <bpmn:outgoing>flow_notok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_register" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_register" targetRef="task_examine" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_examine" targetRef="task_write_rec" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_write_rec" targetRef="task_check_rec" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_check_rec" targetRef="gw_ok" />
    <bpmn:sequenceFlow id="flow_ok" sourceRef="gw_ok" targetRef="end_1" name="OK" />
    <bpmn:sequenceFlow id="flow_notok" sourceRef="gw_ok" targetRef="task_write_rec" name="Not OK" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="1300" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ok_di" bpmnElement="gw_ok">
        <dc:Bounds x="1110" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_rec_di" bpmnElement="task_check_rec">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_examine_di" bpmnElement="task_examine">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_di" bpmnElement="task_register">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_write_rec_di" bpmnElement="task_write_rec">
        <dc:Bounds x="1300" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_claim_di" bpmnElement="do_claim">
        <dc:Bounds x="465" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_recommendation_di" bpmnElement="do_recommendation">
        <dc:Bounds x="1130" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="1350" y="265" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ok_di" bpmnElement="flow_ok">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1318" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notok_di" bpmnElement="flow_notok">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_register_doa0_di" bpmnElement="task_register_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_examine_dia0_di" bpmnElement="task_examine_dia0">
        <di:waypoint x="483" y="390" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_write_rec_doa0_di" bpmnElement="task_write_rec_doa0">
        <di:waypoint x="1350" y="265" />
        <di:waypoint x="1148" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_rec_dia0_di" bpmnElement="task_check_rec_dia0">
        <di:waypoint x="1148" y="390" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>