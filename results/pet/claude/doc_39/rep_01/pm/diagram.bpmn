<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="D1" name="Geregistreerde claim" dataObjectRef="D1_do" />
    <bpmn:dataObject id="D1_do" />
    <bpmn:dataObjectReference id="D2" name="Settlement aanbeveling" dataObjectRef="D2_do" />
    <bpmn:dataObject id="D2_do" />
    <bpmn:startEvent id="E1" name="Claim ontvangen">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="E2" name="Claim handling vervolgd">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T1" name="Claim registreren">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T1_doa0">
        <bpmn:targetRef>D1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T2" name="Claim onderzoeken">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:property id="T2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T2_dia0">
        <bpmn:sourceRef>D1</bpmn:sourceRef>
        <bpmn:targetRef>T2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T3" name="Settlement aanbeveling schrijven">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T3_doa0">
        <bpmn:targetRef>D2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="T4" name="Aanbeveling controleren">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:property id="T4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T4_dia0">
        <bpmn:sourceRef>D2</bpmn:sourceRef>
        <bpmn:targetRef>T4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="OK?" isMarkerVisible="true">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F1" sourceRef="E1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="G1" targetRef="T3" name="Not OK" />
    <bpmn:sequenceFlow id="F6" sourceRef="G1" targetRef="E2" name="OK" />
    <bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="G1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
