<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.com/bpmn/claims">

  <process id="ClaimHandlingProcess" name="Claim Handling Process" isExecutable="true">

    <laneSet id="LaneSet_1">
      <lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <flowNodeRef>StartEvent_ClaimRegistered</flowNodeRef>
        <flowNodeRef>Task_ExamineClaim</flowNodeRef>
        <flowNodeRef>Task_WriteRecommendation</flowNodeRef>
      </lane>
      <lane id="Lane_SeniorClaimsOfficer" name="Senior Claims Officer">
        <flowNodeRef>Task_CheckRecommendation</flowNodeRef>
        <flowNodeRef>Gateway_OKCheck</flowNodeRef>
        <flowNodeRef>EndEvent_ClaimHandled</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_ClaimRegistered" name="Claim Registered">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_ExamineClaim" name="Examine Claim">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <incoming>Flow_2</incoming>
      <incoming>Flow_NotOK</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <task id="Task_CheckRecommendation" name="Check Recommendation">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <exclusiveGateway id="Gateway_OKCheck" name="OK?">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_OK</outgoing>
      <outgoing>Flow_NotOK</outgoing>
    </exclusiveGateway>

    <endEvent id="EndEvent_ClaimHandled" name="Claim Handling Proceeds">
      <incoming>Flow_OK</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim" />
    <sequenceFlow id="Flow_2" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation" />
    <sequenceFlow id="Flow_3" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation" />
    <sequenceFlow id="Flow_4" sourceRef="Task_CheckRecommendation" targetRef="Gateway_OKCheck" />
    <sequenceFlow id="Flow_OK" name="OK" sourceRef="Gateway_OKCheck" targetRef="EndEvent_ClaimHandled" />
    <sequenceFlow id="Flow_NotOK" name="Not OK" sourceRef="Gateway_OKCheck" targetRef="Task_WriteRecommendation" />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ClaimHandlingProcess">

      <bpmndi:BPMNShape id="Shape_StartEvent" bpmnElement="StartEvent_ClaimRegistered">
        <omgdc:Bounds x="60" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ExamineClaim" bpmnElement="Task_ExamineClaim">
        <omgdc:Bounds x="140" y="98" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_WriteRecommendation" bpmnElement="Task_WriteRecommendation">
        <omgdc:Bounds x="280" y="98" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_CheckRecommendation" bpmnElement="Task_CheckRecommendation">
        <omgdc:Bounds x="420" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway" bpmnElement="Gateway_OKCheck" isMarkerVisible="true">
        <omgdc:Bounds x="560" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent" bpmnElement="EndEvent_ClaimHandled">
        <omgdc:Bounds x="660" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <omgdi:waypoint x="96" y="138" />
        <omgdi:waypoint x="140" y="138" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <omgdi:waypoint x="240" y="138" />
        <omgdi:waypoint x="280" y="138" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <omgdi:waypoint x="330" y="178" />
        <omgdi:waypoint x="330" y="260" />
        <omgdi:waypoint x="420" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <omgdi:waypoint x="520" y="260" />
        <omgdi:waypoint x="560" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_OK" bpmnElement="Flow_OK">
        <omgdi:waypoint x="610" y="260" />
        <omgdi:waypoint x="660" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_NotOK" bpmnElement="Flow_NotOK">
        <omgdi:waypoint x="585" y="235" />
        <omgdi:waypoint x="585" y="138" />
        <omgdi:waypoint x="380" y="138" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
