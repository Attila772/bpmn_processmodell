<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.com/bpmn/claimhandling">

  <process id="ClaimHandlingProcess" isExecutable="true">

    <laneSet id="LaneSet_1">
      <lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_RegisterClaim</flowNodeRef>
        <flowNodeRef>Task_ExamineClaim</flowNodeRef>
        <flowNodeRef>Task_WriteRecommendation</flowNodeRef>
      </lane>
      <lane id="Lane_SeniorClaimsOfficer" name="Senior Claims Officer">
        <flowNodeRef>Task_CheckRecommendation</flowNodeRef>
        <flowNodeRef>Gateway_ClaimOK</flowNodeRef>
        <flowNodeRef>EndEvent_ProceedHandling</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Claim Registered Trigger">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_RegisterClaim" name="Register claim">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <task id="Task_ExamineClaim" name="Examine claim">
      <incoming>Flow_2</incoming>
      <incoming>Flow_Loop</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <task id="Task_WriteRecommendation" name="Write settlement recommendation">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <task id="Task_CheckRecommendation" name="Check recommendation">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
    </task>

    <exclusiveGateway id="Gateway_ClaimOK" name="Claim OK?">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_NotOK</outgoing>
      <outgoing>Flow_OK</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="Flow_NotOK" name="Not OK" sourceRef="Gateway_ClaimOK" targetRef="Task_ExamineClaim" />
    <sequenceFlow id="Flow_Loop" sourceRef="Gateway_ClaimOK" targetRef="Task_ExamineClaim" />

    <sequenceFlow id="Flow_OK" name="OK" sourceRef="Gateway_ClaimOK" targetRef="EndEvent_ProceedHandling" />

    <endEvent id="EndEvent_ProceedHandling" name="Claim handling process proceeds">
      <incoming>Flow_OK</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_RegisterClaim" />
    <sequenceFlow id="Flow_2" sourceRef="Task_RegisterClaim" targetRef="Task_ExamineClaim" />
    <sequenceFlow id="Flow_3" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation" />
    <sequenceFlow id="Flow_4" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation" />
    <sequenceFlow id="Flow_5" sourceRef="Task_CheckRecommendation" targetRef="Gateway_ClaimOK" />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ClaimHandlingProcess">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="80" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RegisterClaim_di" bpmnElement="Task_RegisterClaim">
        <omgdc:Bounds x="160" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ExamineClaim_di" bpmnElement="Task_ExamineClaim">
        <omgdc:Bounds x="310" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_WriteRecommendation_di" bpmnElement="Task_WriteRecommendation">
        <omgdc:Bounds x="460" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckRecommendation_di" bpmnElement="Task_CheckRecommendation">
        <omgdc:Bounds x="610" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ClaimOK_di" bpmnElement="Gateway_ClaimOK" isMarkerVisible="true">
        <omgdc:Bounds x="760" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ProceedHandling_di" bpmnElement="EndEvent_ProceedHandling">
        <omgdc:Bounds x="870" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="116" y="178" />
        <omgdi:waypoint x="160" y="178" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="260" y="178" />
        <omgdi:waypoint x="310" y="178" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="410" y="178" />
        <omgdi:waypoint x="460" y="178" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="510" y="218" />
        <omgdi:waypoint x="510" y="340" />
        <omgdi:waypoint x="610" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="710" y="340" />
        <omgdi:waypoint x="760" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_OK_di" bpmnElement="Flow_OK">
        <omgdi:waypoint x="810" y="340" />
        <omgdi:waypoint x="870" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_NotOK_di" bpmnElement="Flow_NotOK">
        <omgdi:waypoint x="785" y="315" />
        <omgdi:waypoint x="785" y="100" />
        <omgdi:waypoint x="360" y="100" />
        <omgdi:waypoint x="360" y="138" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
