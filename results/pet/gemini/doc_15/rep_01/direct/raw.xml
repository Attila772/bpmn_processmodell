<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- Collaboration definition with Pools -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_TPA" name="Town Planning Authority" processRef="Process_TPA" />
    <bpmn:participant id="Participant_Committee" name="Independent Committee Members" processRef="Process_Committee" />
    <bpmn:messageFlow id="MessageFlow_1" name="Final Schedule Email" sourceRef="Task_SendSchedule" targetRef="Start_CommitteeProcess" />
    <bpmn:messageFlow id="MessageFlow_2" name="Conflict Advice" sourceRef="Task_AdviseConflicts" targetRef="Task_ReceiveAdvice" />
  </bpmn:collaboration>

  <!-- Process 1: Town Planning Authority -->
  <bpmn:process id="Process_TPA" isExecutable="true">
    <bpmn:laneSet id="LaneSet_TPA">
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Start_NovemberTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDraftDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecheckDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveAdvice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TPAProcess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestModifications</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_NovemberTrigger" name="November of each year">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:task id="Task_DraftSchedule" name="Draft schedule of meetings for next year">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AddDraftDates" name="Add draft dates to all calendars">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckDates" name="Check draft dates">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SuggestModifications" name="Suggest modifications">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RecheckDates" name="Recheck all dates and look for potential conflicts">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sendTask id="Task_SendSchedule" name="Send final schedule of meeting dates by email">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Task_ReceiveAdvice" name="Receive conflict advice from members">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:endEvent id="End_TPAProcess" name="Schedule finalized">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_NovemberTrigger" targetRef="Task_DraftSchedule" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_DraftSchedule" targetRef="Task_AddDraftDates" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AddDraftDates" targetRef="Task_CheckDates" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckDates" targetRef="Task_SuggestModifications" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SuggestModifications" targetRef="Task_RecheckDates" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RecheckDates" targetRef="Task_SendSchedule" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SendSchedule" targetRef="Task_ReceiveAdvice" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ReceiveAdvice" targetRef="End_TPAProcess" />
  </bpmn:process>

  <!-- Process 2: Independent Committee Members -->
  <bpmn:process id="Process_Committee" isExecutable="true">
    <bpmn:startEvent id="Start_CommitteeProcess" name="Schedule email received">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckDiaries" name="Check personal diaries">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sendTask id="Task_AdviseConflicts" name="Advise Coordination Unit of any conflicts">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_CommitteeProcess" name="Conflicts advised">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_9" sourceRef="Start_CommitteeProcess" targetRef="Task_CheckDiaries" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CheckDiaries" targetRef="Task_AdviseConflicts" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AdviseConflicts" targetRef="End_CommitteeProcess" />
  </bpmn:process>

  <!-- Diagram Visual Elements -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      
      <!-- Pool: Town Planning Authority -->
      <bpmndi:BPMNShape id="Participant_TPA_di" bpmnElement="Participant_TPA" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1200" height="340" />
      </bpmndi:BPMNShape>

      <!-- Lanes inside TPA -->
      <bpmndi:BPMNShape id="Lane_CoordinationUnit_di" bpmnElement="Lane_CoordinationUnit" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1170" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_SupportOfficer_di" bpmnElement="Lane_SupportOfficer" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1170" height="160" />
      </bpmndi:BPMNShape>

      <!-- Nodes in TPA Process -->
      <bpmndi:BPMNShape id="Start_NovemberTrigger_di" bpmnElement="Start_NovemberTrigger">
        <dc:Bounds x="232" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="217" y="185" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_DraftSchedule_di" bpmnElement="Task_DraftSchedule">
        <dc:Bounds x="310" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AddDraftDates_di" bpmnElement="Task_AddDraftDates">
        <dc:Bounds x="450" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckDates_di" bpmnElement="Task_CheckDates">
        <dc:Bounds x="450" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SuggestModifications_di" bpmnElement="Task_SuggestModifications">
        <dc:Bounds x="590" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RecheckDates_di" bpmnElement="Task_RecheckDates">
        <dc:Bounds x="590" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendSchedule_di" bpmnElement="Task_SendSchedule">
        <dc:Bounds x="730" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveAdvice_di" bpmnElement="Task_ReceiveAdvice">
        <dc:Bounds x="1050" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_TPAProcess_di" bpmnElement="End_TPAProcess">
        <dc:Bounds x="1212" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1185" y="185" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Flows in TPA Process -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="160" />
        <di:waypoint x="310" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="410" y="160" />
        <di:waypoint x="450" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="500" y="200" />
        <di:waypoint x="500" y="300" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="550" y="340" />
        <di:waypoint x="590" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="640" y="300" />
        <di:waypoint x="640" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="690" y="160" />
        <di:waypoint x="730" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="830" y="160" />
        <di:waypoint x="1050" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1150" y="160" />
        <di:waypoint x="1212" y="160" />
      </bpmndi:BPMNEdge>

      <!-- Pool: Committee Members -->
      <bpmndi:BPMNShape id="Participant_Committee_di" bpmnElement="Participant_Committee" isHorizontal="true">
        <dc:Bounds x="160" y="470" width="1200" height="180" />
      </bpmndi:BPMNShape>

      <!-- Nodes in Committee Process -->
      <bpmndi:BPMNShape id="Start_CommitteeProcess_di" bpmnElement="Start_CommitteeProcess">
        <dc:Bounds x="762" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="744" y="585" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckDiaries_di" bpmnElement="Task_CheckDiaries">
        <dc:Bounds x="870" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AdviseConflicts_di" bpmnElement="Task_AdviseConflicts">
        <dc:Bounds x="1050" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_CommitteeProcess_di" bpmnElement="End_CommitteeProcess">
        <dc:Bounds x="1212" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1188" y="585" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Flows in Committee Process -->
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="798" y="560" />
        <di:waypoint x="870" y="560" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="970" y="560" />
        <di:waypoint x="1050" y="560" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1150" y="560" />
        <di:waypoint x="1212" y="560" />
      </bpmndi:BPMNEdge>

      <!-- Message Flows -->
      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="780" y="200" />
        <di:waypoint x="780" y="542" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="794" y="360" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <di:waypoint x="1100" y="520" />
        <di:waypoint x="1100" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1114" y="360" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
