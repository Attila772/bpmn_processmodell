<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.org/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_TownPlanningAuthority" name="Town Planning Authority" processRef="Process_TownPlanningAuthority" />
    <bpmn:participant id="Participant_CommitteeMembers" name="Independent Committee Members" />
    <bpmn:messageFlow id="MessageFlow_1" name="Final Schedule Email" sourceRef="Activity_SendFinalSchedule" targetRef="Participant_CommitteeMembers" />
    <bpmn:messageFlow id="MessageFlow_2" name="Conflict Advice" sourceRef="Participant_CommitteeMembers" targetRef="Event_ConflictsAdvised" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TownPlanningAuthority" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartEvent_NovemberTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_DraftScheduleAndAddDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RecheckDatesAndLookForConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SendFinalSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ConflictsAdvised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ScheduleFinalized</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Activity_CheckDatesAndSuggestModifications</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_NovemberTrigger" name="November of each year reached">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_DraftScheduleAndAddDates" name="Draft schedule of meetings and add draft dates to calendars">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_CheckDatesAndSuggestModifications" name="Check dates and suggest modifications">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_RecheckDatesAndLookForConflicts" name="Recheck all dates and look for potential conflicts">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Activity_SendFinalSchedule" name="Send final schedule of meeting dates to Committee Members by email">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ConflictsAdvised" name="Receive conflict advice from members">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_ScheduleFinalized" name="Meeting schedule finalized">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_NovemberTrigger" targetRef="Activity_DraftScheduleAndAddDates" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_DraftScheduleAndAddDates" targetRef="Activity_CheckDatesAndSuggestModifications" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_CheckDatesAndSuggestModifications" targetRef="Activity_RecheckDatesAndLookForConflicts" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_RecheckDatesAndLookForConflicts" targetRef="Activity_SendFinalSchedule" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_SendFinalSchedule" targetRef="Event_ConflictsAdvised" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_ConflictsAdvised" targetRef="EndEvent_ScheduleFinalized" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_TownPlanningAuthority_di" bpmnElement="Participant_TownPlanningAuthority" isHorizontal="true">
        <dc:Bounds x="160" y="180" width="1020" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SupportOfficer_di" bpmnElement="Lane_SupportOfficer" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="990" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CoordinationUnit_di" bpmnElement="Lane_CoordinationUnit" isHorizontal="true">
        <dc:Bounds x="190" y="180" width="990" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_NovemberTrigger_di" bpmnElement="StartEvent_NovemberTrigger">
        <dc:Bounds x="242" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="217" y="315" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_DraftScheduleAndAddDates_di" bpmnElement="Activity_DraftScheduleAndAddDates">
        <dc:Bounds x="330" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CheckDatesAndSuggestModifications_di" bpmnElement="Activity_CheckDatesAndSuggestModifications">
        <dc:Bounds x="470" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RecheckDatesAndLookForConflicts_di" bpmnElement="Activity_RecheckDatesAndLookForConflicts">
        <dc:Bounds x="610" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SendFinalSchedule_di" bpmnElement="Activity_SendFinalSchedule">
        <dc:Bounds x="750" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ConflictsAdvised_di" bpmnElement="Event_ConflictsAdvised">
        <dc:Bounds x="902" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="880" y="235" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ScheduleFinalized_di" bpmnElement="EndEvent_ScheduleFinalized">
        <dc:Bounds x="1002" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="977" y="315" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="290" />
        <di:waypoint x="330" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="430" y="290" />
        <di:waypoint x="450" y="290" />
        <di:waypoint x="450" y="480" />
        <di:waypoint x="470" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="570" y="480" />
        <di:waypoint x="590" y="480" />
        <di:waypoint x="590" y="290" />
        <di:waypoint x="610" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="710" y="290" />
        <di:waypoint x="750" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="850" y="290" />
        <di:waypoint x="902" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="938" y="290" />
        <di:waypoint x="1002" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_CommitteeMembers_di" bpmnElement="Participant_CommitteeMembers" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1020" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="800" y="250" />
        <di:waypoint x="800" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="815" y="180" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <di:waypoint x="920" y="140" />
        <di:waypoint x="920" y="272" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="925" y="183" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
