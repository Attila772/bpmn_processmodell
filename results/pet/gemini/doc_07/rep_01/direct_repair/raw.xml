<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn">
  
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN" />
    <bpmn:participant id="Participant_GO" name="Grid Operator (GO)" processRef="Process_GO" />
    <bpmn:participant id="Participant_MSPO" name="MSPO" />
    <bpmn:participant id="Participant_MPO" name="MPO" />
    <bpmn:participant id="Participant_SP" name="SP" />
    
    <bpmn:messageFlow id="MF_Register" name="Measurement Registration Application" sourceRef="Task_MSPN_Register" targetRef="Start_GO" />
    <bpmn:messageFlow id="MF_Reject" name="Application Rejection" sourceRef="Task_GO_Reject" targetRef="Participant_MSPN" />
    <bpmn:messageFlow id="MF_Inform_MSPO" name="Assignment Notification" sourceRef="Task_GO_Inform_MSPO" targetRef="Participant_MSPO" />
    <bpmn:messageFlow id="MF_Inform_MPO" name="Assignment Notification" sourceRef="Task_GO_Inform_MPO" targetRef="Participant_MPO" />
    <bpmn:messageFlow id="MF_Inform_SP" name="Assignment Notification" sourceRef="Task_GO_Inform_SP" targetRef="Participant_SP" />
  </bpmn:collaboration>

  <bpmn:process id="Process_MSPN" isExecutable="false">
    <bpmn:startEvent id="Start_MSPN" name="Measurement Registration Needed">
      <bpmn:outgoing>SF_MSPN_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_MSPN_Register" name="Register Measurement at GO">
      <bpmn:incoming>SF_MSPN_1</bpmn:incoming>
      <bpmn:outgoing>SF_MSPN_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_MSPN" name="Registration Submitted">
      <bpmn:incoming>SF_MSPN_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_MSPN_1" sourceRef="Start_MSPN" targetRef="Task_MSPN_Register" />
    <bpmn:sequenceFlow id="SF_MSPN_2" sourceRef="Task_MSPN_Register" targetRef="End_MSPN" />
  </bpmn:process>

  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="Start_GO" name="Application Received">
      <bpmn:outgoing>SF_GO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_1" />
    </bpmn:startEvent>
    
    <bpmn:task id="Task_GO_Examine" name="Examine Application of MSPN">
      <bpmn:incoming>SF_GO_1</bpmn:incoming>
      <bpmn:outgoing>SF_GO_2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Application Approved?">
      <bpmn:incoming>SF_GO_2</bpmn:incoming>
      <bpmn:outgoing>SF_GO_Rejected</bpmn:outgoing>
      <bpmn:outgoing>SF_GO_Confirmed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sendTask id="Task_GO_Reject" name="Reject Application of MSPN">
      <bpmn:incoming>SF_GO_Rejected</bpmn:incoming>
      <bpmn:outgoing>SF_GO_EndReject</bpmn:outgoing>
    </bpmn:sendTask>
    
    <bpmn:endEvent id="End_GO_Rejected" name="Application Rejected">
      <bpmn:incoming>SF_GO_EndReject</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_GO_Confirm" name="Confirm Application of MSPN">
      <bpmn:incoming>SF_GO_Confirmed</bpmn:incoming>
      <bpmn:outgoing>SF_GO_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_GO_Assign" name="Assign MSPN">
      <bpmn:incoming>SF_GO_3</bpmn:incoming>
      <bpmn:outgoing>SF_GO_4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:parallelGateway id="Gateway_Split">
      <bpmn:incoming>SF_GO_4</bpmn:incoming>
      <bpmn:outgoing>SF_GO_ToMSPO</bpmn:outgoing>
      <bpmn:outgoing>SF_GO_ToMPO</bpmn:outgoing>
      <bpmn:outgoing>SF_GO_ToSP</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:sendTask id="Task_GO_Inform_MSPO" name="Inform MSPO about Assignment">
      <bpmn:incoming>SF_GO_ToMSPO</bpmn:incoming>
      <bpmn:outgoing>SF_GO_FromMSPO</bpmn:outgoing>
    </bpmn:sendTask>
    
    <bpmn:sendTask id="Task_GO_Inform_MPO" name="Inform MPO about Assignment">
      <bpmn:incoming>SF_GO_ToMPO</bpmn:incoming>
      <bpmn:outgoing>SF_GO_FromMPO</bpmn:outgoing>
    </bpmn:sendTask>
    
    <bpmn:sendTask id="Task_GO_Inform_SP" name="Inform SP about Assignment">
      <bpmn:incoming>SF_GO_ToSP</bpmn:incoming>
      <bpmn:outgoing>SF_GO_FromSP</bpmn:outgoing>
    </bpmn:sendTask>
    
    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>SF_GO_FromMSPO</bpmn:incoming>
      <bpmn:incoming>SF_GO_FromMPO</bpmn:incoming>
      <bpmn:incoming>SF_GO_FromSP</bpmn:incoming>
      <bpmn:outgoing>SF_GO_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:endEvent id="End_GO_Confirmed" name="MSPN Process Completed">
      <bpmn:incoming>SF_GO_5</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SF_GO_1" sourceRef="Start_GO" targetRef="Task_GO_Examine" />
    <bpmn:sequenceFlow id="SF_GO_2" sourceRef="Task_GO_Examine" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="SF_GO_Rejected" name="No" sourceRef="Gateway_Decision" targetRef="Task_GO_Reject" />
    <bpmn:sequenceFlow id="SF_GO_EndReject" sourceRef="Task_GO_Reject" targetRef="End_GO_Rejected" />
    <bpmn:sequenceFlow id="SF_GO_Confirmed" name="Yes" sourceRef="Gateway_Decision" targetRef="Task_GO_Confirm" />
    <bpmn:sequenceFlow id="SF_GO_3" sourceRef="Task_GO_Confirm" targetRef="Task_GO_Assign" />
    <bpmn:sequenceFlow id="SF_GO_4" sourceRef="Task_GO_Assign" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="SF_GO_ToMSPO" sourceRef="Gateway_Split" targetRef="Task_GO_Inform_MSPO" />
    <bpmn:sequenceFlow id="SF_GO_ToMPO" sourceRef="Gateway_Split" targetRef="Task_GO_Inform_MPO" />
    <bpmn:sequenceFlow id="SF_GO_ToSP" sourceRef="Gateway_Split" targetRef="Task_GO_Inform_SP" />
    <bpmn:sequenceFlow id="SF_GO_FromMSPO" sourceRef="Task_GO_Inform_MSPO" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="SF_GO_FromMPO" sourceRef="Task_GO_Inform_MPO" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="SF_GO_FromSP" sourceRef="Task_GO_Inform_SP" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="SF_GO_5" sourceRef="Gateway_Join" targetRef="End_GO_Confirmed" />
  </bpmn:process>

