<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mspn_part" name="MSPN" processRef="pool_mspn_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf_mspn_to_go" sourceRef="evt_mspn_send_app" targetRef="evt_go_recv_app" name="MSPN Application" />
    <bpmn:messageFlow id="mf_go_to_mspo" sourceRef="evt_go_end_mspo" targetRef="evt_mspo_start" name="Assignment Notification MSPO" />
    <bpmn:messageFlow id="mf_go_to_mpo" sourceRef="evt_go_end_mpo" targetRef="evt_mpo_start" name="Assignment Notification MPO" />
    <bpmn:messageFlow id="mf_go_to_sp" sourceRef="evt_go_end_sp" targetRef="evt_sp_start" name="Assignment Notification SP" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mspn_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_application" name="Application of MSPN" dataObjectRef="data_application_do" />
    <bpmn:dataObject id="data_application_do" />
    <bpmn:startEvent id="evt_mspn_start" name="Measurement registration initiated">
      <bpmn:outgoing>sf_mspn_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_mspn_send_app" name="Application sent">
      <bpmn:incoming>sf_mspn_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_mspn_send_app_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_register_measurement" name="Register measurement at GO">
      <bpmn:incoming>sf_mspn_1</bpmn:incoming>
      <bpmn:outgoing>sf_mspn_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_measurement_doa0">
        <bpmn:targetRef>data_application</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf_mspn_1" sourceRef="evt_mspn_start" targetRef="task_register_measurement" />
    <bpmn:sequenceFlow id="sf_mspn_2" sourceRef="task_register_measurement" targetRef="evt_mspn_send_app" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_application_p1" name="Application of MSPN" dataObjectRef="data_application_p1_do" />
    <bpmn:dataObject id="data_application_p1_do" />
    <bpmn:dataObjectReference id="data_assignment_notice" name="Assignment Notification" dataObjectRef="data_assignment_notice_do" />
    <bpmn:dataObject id="data_assignment_notice_do" />
    <bpmn:startEvent id="evt_go_recv_app" name="Application received">
      <bpmn:outgoing>sf_go_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_go_recv_app_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_go_rejected_end" name="Application Rejected">
      <bpmn:incoming>sf_go_reject_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_go_end_mspo" name="Assignment notification sent to MSPO">
      <bpmn:incoming>sf_go_mspo_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_go_end_mspo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_go_end_mpo" name="Assignment notification sent to MPO">
      <bpmn:incoming>sf_go_mpo_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_go_end_mpo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_go_end_sp" name="Assignment notification sent to SP">
      <bpmn:incoming>sf_go_sp_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_go_end_sp_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_examine_application" name="Examine application of MSPN">
      <bpmn:incoming>sf_go_1</bpmn:incoming>
      <bpmn:outgoing>sf_go_2</bpmn:outgoing>
      <bpmn:property id="task_examine_application_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_application_dia0">
        <bpmn:sourceRef>data_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_application_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_reject_application" name="Reject application of MSPN">
      <bpmn:incoming>sf_decision_reject</bpmn:incoming>
      <bpmn:outgoing>sf_go_reject_end</bpmn:outgoing>
      <bpmn:property id="task_reject_application_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_reject_application_dia0">
        <bpmn:sourceRef>data_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_reject_application_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_confirm_application" name="Confirm application of MSPN">
      <bpmn:incoming>sf_decision_confirm</bpmn:incoming>
      <bpmn:outgoing>sf_go_3</bpmn:outgoing>
      <bpmn:property id="task_confirm_application_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_confirm_application_dia0">
        <bpmn:sourceRef>data_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_confirm_application_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_assign_mspn" name="Assign MSPN">
      <bpmn:incoming>sf_go_3</bpmn:incoming>
      <bpmn:outgoing>sf_go_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_assign_mspn_doa0">
        <bpmn:targetRef>data_assignment_notice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_inform_mspo" name="Inform MSPO about assignment">
      <bpmn:incoming>sf_go_par_1</bpmn:incoming>
      <bpmn:outgoing>sf_go_mspo_end</bpmn:outgoing>
      <bpmn:property id="task_inform_mspo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mspo_dia0">
        <bpmn:sourceRef>data_assignment_notice</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mspo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_inform_mpo" name="Inform MPO about assignment">
      <bpmn:incoming>sf_go_par_2</bpmn:incoming>
      <bpmn:outgoing>sf_go_mpo_end</bpmn:outgoing>
      <bpmn:property id="task_inform_mpo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mpo_dia0">
        <bpmn:sourceRef>data_assignment_notice</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mpo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_inform_sp" name="Inform SP about assignment">
      <bpmn:incoming>sf_go_par_3</bpmn:incoming>
      <bpmn:outgoing>sf_go_sp_end</bpmn:outgoing>
      <bpmn:property id="task_inform_sp_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_sp_dia0">
        <bpmn:sourceRef>data_assignment_notice</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_sp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gtw_decision" name="Application Decision" isMarkerVisible="true">
      <bpmn:incoming>sf_go_2</bpmn:incoming>
      <bpmn:outgoing>sf_decision_reject</bpmn:outgoing>
      <bpmn:outgoing>sf_decision_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gtw_parallel_inform_split" name="Parallel Information Split">
      <bpmn:incoming>sf_go_4</bpmn:incoming>
      <bpmn:outgoing>sf_go_par_1</bpmn:outgoing>
      <bpmn:outgoing>sf_go_par_2</bpmn:outgoing>
      <bpmn:outgoing>sf_go_par_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="sf_go_1" sourceRef="evt_go_recv_app" targetRef="task_examine_application" />
    <bpmn:sequenceFlow id="sf_go_2" sourceRef="task_examine_application" targetRef="gtw_decision" />
    <bpmn:sequenceFlow id="sf_decision_reject" sourceRef="gtw_decision" targetRef="task_reject_application" name="Application Rejected" />
    <bpmn:sequenceFlow id="sf_decision_confirm" sourceRef="gtw_decision" targetRef="task_confirm_application" name="Application Confirmed" />
    <bpmn:sequenceFlow id="sf_go_reject_end" sourceRef="task_reject_application" targetRef="evt_go_rejected_end" />
    <bpmn:sequenceFlow id="sf_go_3" sourceRef="task_confirm_application" targetRef="task_assign_mspn" />
    <bpmn:sequenceFlow id="sf_go_4" sourceRef="task_assign_mspn" targetRef="gtw_parallel_inform_split" />
    <bpmn:sequenceFlow id="sf_go_par_1" sourceRef="gtw_parallel_inform_split" targetRef="task_inform_mspo" />
    <bpmn:sequenceFlow id="sf_go_par_2" sourceRef="gtw_parallel_inform_split" targetRef="task_inform_mpo" />
    <bpmn:sequenceFlow id="sf_go_par_3" sourceRef="gtw_parallel_inform_split" targetRef="task_inform_sp" />
    <bpmn:sequenceFlow id="sf_go_mspo_end" sourceRef="task_inform_mspo" targetRef="evt_go_end_mspo" />
    <bpmn:sequenceFlow id="sf_go_mpo_end" sourceRef="task_inform_mpo" targetRef="evt_go_end_mpo" />
    <bpmn:sequenceFlow id="sf_go_sp_end" sourceRef="task_inform_sp" targetRef="evt_go_end_sp" />
  </bpmn:process>
  <bpmn:process id="pool_mspo_proc" isExecutable="false">
    <bpmn:startEvent id="evt_mspo_start" name="Notification received by MSPO">
      <bpmn:outgoing>sf_mspo_flow</bpmn:outgoing>
