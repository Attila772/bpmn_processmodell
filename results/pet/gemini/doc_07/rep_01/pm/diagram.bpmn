  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mspn_part" name="MSPN" processRef="pool_mspn_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf_registration" sourceRef="evt_send_reg" targetRef="evt_rec_reg" name="Measurement Registration Application" />
    <bpmn:messageFlow id="mf_inform_mspo" sourceRef="evt_send_mspo" targetRef="evt_rec_mspo" name="Assignment Notice MSPO" />
    <bpmn:messageFlow id="mf_inform_mpo" sourceRef="evt_send_mpo" targetRef="evt_rec_mpo" name="Assignment Notice MPO" />
    <bpmn:messageFlow id="mf_inform_sp" sourceRef="evt_send_sp" targetRef="evt_rec_sp" name="Assignment Notice SP" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mspn_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_application" name="Application of the MSPN" dataObjectRef="doc_application_do" />
    <bpmn:dataObject id="doc_application_do" />
    <bpmn:startEvent id="evt_start_mspn" name="Measurement Registration Needed">
      <bpmn:outgoing>seq_mspn_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_send_reg" name="Measurement Registration Sent">
      <bpmn:incoming>seq_mspn_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_reg_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_register" name="Register measurement at GO">
      <bpmn:incoming>seq_mspn_1</bpmn:incoming>
      <bpmn:outgoing>seq_mspn_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_doa0">
        <bpmn:targetRef>doc_application</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="seq_mspn_1" sourceRef="evt_start_mspn" targetRef="task_register" />
    <bpmn:sequenceFlow id="seq_mspn_2" sourceRef="task_register" targetRef="evt_send_reg" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_application_p1" name="Application of the MSPN" dataObjectRef="doc_application_p1_do" />
    <bpmn:dataObject id="doc_application_p1_do" />
    <bpmn:startEvent id="evt_rec_reg" name="Measurement Registration Received">
      <bpmn:outgoing>seq_go_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_rec_reg_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_rejected" name="Application Rejected">
      <bpmn:incoming>seq_go_reject_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_send_mspo" name="Inform MSPO Sent">
      <bpmn:incoming>seq_go_5</bpmn:incoming>
      <bpmn:outgoing>seq_go_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_send_mspo_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_send_mpo" name="Inform MPO Sent">
      <bpmn:incoming>seq_go_7</bpmn:incoming>
      <bpmn:outgoing>seq_go_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_send_mpo_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="evt_send_sp" name="Inform SP Sent">
      <bpmn:incoming>seq_go_9</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_sp_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_examine" name="Examine application of MSPN">
      <bpmn:incoming>seq_go_1</bpmn:incoming>
      <bpmn:outgoing>seq_go_2</bpmn:outgoing>
      <bpmn:property id="task_examine_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_dia0">
        <bpmn:sourceRef>doc_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_reject" name="Reject application of MSPN">
      <bpmn:incoming>seq_to_reject</bpmn:incoming>
      <bpmn:outgoing>seq_go_reject_end</bpmn:outgoing>
      <bpmn:property id="task_reject_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_reject_dia0">
        <bpmn:sourceRef>doc_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_reject_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_confirm" name="Confirm application of MSPN">
      <bpmn:incoming>seq_to_confirm</bpmn:incoming>
      <bpmn:outgoing>seq_go_3</bpmn:outgoing>
      <bpmn:property id="task_confirm_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_confirm_dia0">
        <bpmn:sourceRef>doc_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_confirm_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_assign" name="Assign MSPN">
      <bpmn:incoming>seq_go_3</bpmn:incoming>
      <bpmn:outgoing>seq_go_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_inform_mspo" name="Inform MSPO about assignment">
      <bpmn:incoming>seq_go_4</bpmn:incoming>
      <bpmn:outgoing>seq_go_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_inform_mpo" name="Inform MPO about assignment">
      <bpmn:incoming>seq_go_6</bpmn:incoming>
      <bpmn:outgoing>seq_go_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_inform_sp" name="Inform SP about assignment">
      <bpmn:incoming>seq_go_8</bpmn:incoming>
      <bpmn:outgoing>seq_go_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_decision" name="Application Status?" isMarkerVisible="true">
      <bpmn:incoming>seq_go_2</bpmn:incoming>
      <bpmn:outgoing>seq_to_reject</bpmn:outgoing>
      <bpmn:outgoing>seq_to_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="seq_go_1" sourceRef="evt_rec_reg" targetRef="task_examine" />
    <bpmn:sequenceFlow id="seq_go_2" sourceRef="task_examine" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="seq_to_reject" sourceRef="gw_decision" targetRef="task_reject" name="Rejected" />
    <bpmn:sequenceFlow id="seq_go_reject_end" sourceRef="task_reject" targetRef="evt_end_rejected" />
    <bpmn:sequenceFlow id="seq_to_confirm" sourceRef="gw_decision" targetRef="task_confirm" name="Confirmed" />
    <bpmn:sequenceFlow id="seq_go_3" sourceRef="task_confirm" targetRef="task_assign" />
    <bpmn:sequenceFlow id="seq_go_4" sourceRef="task_assign" targetRef="task_inform_mspo" />
    <bpmn:sequenceFlow id="seq_go_5" sourceRef="task_inform_mspo" targetRef="evt_send_mspo" />
    <bpmn:sequenceFlow id="seq_go_6" sourceRef="evt_send_mspo" targetRef="task_inform_mpo" />
    <bpmn:sequenceFlow id="seq_go_7" sourceRef="task_inform_mpo" targetRef="evt_send_mpo" />
    <bpmn:sequenceFlow id="seq_go_8" sourceRef="evt_send_mpo" targetRef="task_inform_sp" />
    <bpmn:sequenceFlow id="seq_go_9" sourceRef="task_inform_sp" targetRef="evt_send_sp" />
  </bpmn:process>
  <bpmn:process id="pool_mspo_proc" isExecutable="false">
