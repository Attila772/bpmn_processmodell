<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://www.bpmn.org/schema/bpmn">

  <process id="mspn_registration_process" isExecutable="true">
    <startEvent id="start_event" name="Measurement Registration Requested">
      <outgoing">seq_start_to_register</outgoing>
    </startEvent>

    <task id="task_register_measurement" name="Register Measurement">
      <incoming">seq_start_to_register</incoming>
      <outgoing">seq_register_to_examine</outgoing>
    </task>

    <task id="task_examine_application" name="Examine Application of MSPN">
      <incoming">seq_register_to_examine</incoming>
      <outgoing">seq_examine_to_gateway</outgoing>
    </task>

    <exclusiveGateway id="gateway_approval" name="Application Approved?">
      <incoming">seq_examine_to_gateway</incoming>
      <outgoing">seq_gateway_to_reject</outgoing>
      <outgoing">seq_gateway_to_confirm</outgoing>
    </exclusiveGateway>

    <task id="task_reject_application" name="Reject Application of MSPN">
      <incoming">seq_gateway_to_reject</incoming>
      <outgoing">seq_reject_to_end</outgoing>
    </task>

    <endEvent id="end_event_rejected" name="Application Rejected">
      <incoming">seq_reject_to_end</incoming>
    </endEvent>

    <task id="task_confirm_application" name="Confirm Application of MSPN">
      <incoming">seq_gateway_to_confirm</incoming>
      <outgoing">seq_confirm_to_assign</outgoing>
    </task>

    <task id="task_assign_mspn" name="Assign MSPN">
      <incoming">seq_confirm_to_assign</incoming>
      <outgoing">seq_assign_to_inform_mspo</outgoing>
    </task>

    <task id="task_inform_mspo" name="Inform MSPO about Assignment">
      <incoming">seq_assign_to_inform_mspo</incoming>
      <outgoing">seq_inform_mspo_to_mpo</outgoing>
    </task>

    <task id="task_inform_mpo" name="Inform MPO about Assignment">
      <incoming">seq_inform_mspo_to_mpo</incoming>
      <outgoing">seq_inform_mpo_to_sp</outgoing>
    </task>

    <task id="task_inform_sp" name="Inform SP about Assignment">
      <incoming">seq_inform_mpo_to_sp</incoming>
      <outgoing">seq_inform_sp_to_end</outgoing>
    </task>

    <endEvent id="end_event_confirmed" name="MSPN Assigned and Parties Informed">
      <incoming">seq_inform_sp_to_end</incoming>
    </endEvent>

    <sequenceFlow id="seq_start_to_register" sourceRef="start_event" targetRef="task_register_measurement" />
    <sequenceFlow id="seq_register_to_examine" sourceRef="task_register_measurement" targetRef="task_examine_application" />
    <sequenceFlow id="seq_examine_to_gateway" sourceRef="task_examine_application" targetRef="gateway_approval" />
    <sequenceFlow id="seq_gateway_to_reject" name="No" sourceRef="gateway_approval" targetRef="task_reject_application" />
    <sequenceFlow id="seq_gateway_to_confirm" name="Yes" sourceRef="gateway_approval" targetRef="task_confirm_application" />
    <sequenceFlow id="seq_reject_to_end" sourceRef="task_reject_application" targetRef="end_event_rejected" />
    <sequenceFlow id="seq_confirm_to_assign" sourceRef="task_confirm_application" targetRef="task_assign_mspn" />
    <sequenceFlow id="seq_assign_to_inform_mspo" sourceRef="task_assign_mspn" targetRef="task_inform_mspo" />
    <sequenceFlow id="seq_inform_mspo_to_mpo" sourceRef="task_inform_mspo" targetRef="task_inform_mpo" />
    <sequenceFlow id="seq_inform_mpo_to_sp" sourceRef="task_inform_mpo" targetRef="task_inform_sp" />
    <sequenceFlow id="seq_inform_sp_to_end" sourceRef="task_inform_sp" targetRef="end_event_confirmed" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_mspn">
    <bpmndi:BPMNPlane id="BPMNPlane_mspn" bpmnElement="mspn_registration_process">
      <bpmndi:BPMNShape id="shape_start_event" bpmnElement="start_event">
        <omgdc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="130" y="225" width="81" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_register_measurement" bpmnElement="task_register_measurement">
        <omgdc:Bounds x="238" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_examine_application" bpmnElement="task_examine_application">
        <omgdc:Bounds x="388" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_gateway_approval" bpmnElement="gateway_approval" isMarkerVisible="true">
        <omgdc:Bounds x="538" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="536" y="138" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_reject_application" bpmnElement="task_reject_application">
        <omgdc:Bounds x="638" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end_event_rejected" bpmnElement="end_event_rejected">
        <omgdc:Bounds x="788" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="780" y="145" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_confirm_application" bpmnElement="task_confirm_application">
        <omgdc:Bounds x="638" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_assign_mspn" bpmnElement="task_assign_mspn">
        <omgdc:Bounds x="788" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_inform_mspo" bpmnElement="task_inform_mspo">
        <omgdc:Bounds x="938" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_inform_mpo" bpmnElement="task_inform_mpo">
        <omgdc:Bounds x="1088" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_inform_sp" bpmnElement="task_inform_sp">
        <omgdc:Bounds x="1238" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end_event_confirmed" bpmnElement="end_event_confirmed">
        <omgdc:Bounds x="1388" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1367" y="305" width="79" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_start_to_register" bpmnElement="seq_start_to_register">
        <omgdi:waypoint x="188" y="200" />
        <omgdi:waypoint x="238" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_register_to_examine" bpmnElement="seq_register_to_examine">
        <omgdi:waypoint x="338" y="200" />
        <omgdi:waypoint x="388" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_examine_to_gateway" bpmnElement="seq_examine_to_gateway">
        <omgdi:waypoint x="488" y="200" />
        <omgdi:waypoint x="538" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_gateway_to_reject" bpmnElement="seq_gateway_to_reject">
        <omgdi:waypoint x="563" y="175" />
        <omgdi:waypoint x="563" y="120" />
        <omgdi:waypoint x="638" y="120" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="571" y="145" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_gateway_to_confirm" bpmnElement="seq_gateway_to_confirm">
        <omgdi:waypoint x="563" y="225" />
        <omgdi:waypoint x="563" y="280" />
        <omgdi:waypoint x="638" y="280" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="569" y="250" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_reject_to_end" bpmnElement="seq_reject_to_end">
        <omgdi:waypoint x="738" y="120" />
        <omgdi:waypoint x="788" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_confirm_to_assign" bpmnElement="seq_confirm_to_assign">
        <omgdi:waypoint x="738" y="280" />
        <omgdi:waypoint x="788" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_assign_to_inform_mspo" bpmnElement="seq_assign_to_inform_mspo">
        <omgdi:waypoint x="888" y="280" />
        <omgdi:waypoint x="938" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_inform_mspo_to_mpo" bpmnElement="seq_inform_mspo_to_mpo">
        <omgdi:waypoint x="1038" y="280" />
        <omgdi:waypoint x="1088" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_inform_mpo_to_sp" bpmnElement="seq_inform_mpo_to_sp">
        <omgdi:waypoint x="1188" y="280" />
        <omgdi:waypoint x="1238" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_inform_sp_to_end" bpmnElement="seq_inform_sp_to_end">
        <omgdi:waypoint x="1338" y="280" />
        <omgdi:waypoint x="1388" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
