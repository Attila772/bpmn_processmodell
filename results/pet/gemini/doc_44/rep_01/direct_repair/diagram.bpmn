<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Bicycle_Manufacturing"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="BPMN modeling expert"
                  exporterVersion="1.0">

  <!-- Collaboration definition with pools and lanes -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Company" name="Custom Bicycle Manufacturer" processRef="Process_Bicycle_Manufacturing" />
  </bpmn:collaboration>

  <!-- Main Process Definition -->
  <bpmn:process id="Process_Bicycle_Manufacturing" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sales" name="Sales Department">
        <bpmn:flowNodeRef>Start_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipBicycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderFulfilled</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>SubProcess_ProcessPartList</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Engineering" name="Engineering Department">
        <bpmn:flowNodeRef>Task_PrepareAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleBicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow Nodes for Sales Department -->
    <bpmn:startEvent id="Start_OrderReceived" name="Order Received">
      <bpmn:outgoing">Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ReviewOrder" name="Accept or Reject Order">
      <bpmn:incoming">Flow_1</bpmn:incoming>
      <bpmn:outgoing">Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_OrderAccepted" name="Order Accepted?">
      <bpmn:incoming">Flow_2</bpmn:incoming>
      <bpmn:outgoing">Flow_Accepted</bpmn:outgoing>
      <bpmn:outgoing">Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_OrderRejected" name="Order Rejected">
      <bpmn:incoming">Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="Gateway_ParallelFork" name="Split Processing">
      <bpmn:incoming">Flow_Accepted</bpmn:incoming>
      <bpmn:outgoing">Flow_ToStorehouse</bpmn:outgoing>
      <bpmn:outgoing">Flow_ToEngineering</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- SubProcess for Processing Part List (Storehouse) -->
    <bpmn:subProcess id="SubProcess_ProcessPartList" name="Process Part List">
      <bpmn:incoming">Flow_ToStorehouse</bpmn:incoming>
      <bpmn:outgoing">Flow_StorehouseDone</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />

      <bpmn:startEvent id="Start_SubProcess" name="Part Processing Started">
        <bpmn:outgoing">SubFlow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:serviceTask id="Task_CheckPartAvailability" name="Check Required Quantity">
        <bpmn:incoming">SubFlow_1</bpmn:incoming>
        <bpmn:outgoing">SubFlow_2</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_PartAvailable" name="Part Available In-House?">
        <bpmn:incoming">SubFlow_2</bpmn:incoming>
        <bpmn:outgoing">SubFlow_Available</bpmn:outgoing>
        <bpmn:outgoing">SubFlow_NotAvailable</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:serviceTask id="Task_ReservePart" name="Reserve Part">
        <bpmn:incoming">SubFlow_Available</bpmn:incoming>
        <bpmn:outgoing">SubFlow_Merge1</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="Task_BackOrderPart" name="Back-Order Part">
        <bpmn:incoming">SubFlow_NotAvailable</bpmn:incoming>
        <bpmn:outgoing">SubFlow_Merge2</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_MergePartAction">
        <bpmn:incoming">SubFlow_Merge1</bpmn:incoming>
        <bpmn:incoming">SubFlow_Merge2</bpmn:incoming>
        <bpmn:outgoing">SubFlow_End</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:endEvent id="End_SubProcess" name="Part Processed">
        <bpmn:incoming">SubFlow_End</bpmn:incoming>
      </bpmn:endEvent>

      <!-- SubProcess Internal Sequence Flows -->
      <bpmn:sequenceFlow id="SubFlow_1" sourceRef="Start_SubProcess" targetRef="Task_CheckPartAvailability" />
      <bpmn:sequenceFlow id="SubFlow_2" sourceRef="Task_CheckPartAvailability" targetRef="Gateway_PartAvailable" />
      <bpmn:sequenceFlow id="SubFlow_Available" name="Yes" sourceRef="Gateway_PartAvailable" targetRef="Task_ReservePart" />
      <bpmn:sequenceFlow id="SubFlow_NotAvailable" name="No" sourceRef="Gateway_PartAvailable" targetRef="Task_BackOrderPart" />
      <bpmn:sequenceFlow id="SubFlow_Merge1" sourceRef="Task_ReservePart" targetRef="Gateway_MergePartAction" />
      <bpmn:sequenceFlow id="SubFlow_Merge2" sourceRef="Task_BackOrderPart" targetRef="Gateway_MergePartAction" />
      <bpmn:sequenceFlow id="SubFlow_End" sourceRef="Gateway_MergePartAction" targetRef="End_SubProcess" />
    </bpmn:subProcess>

    <!-- Engineering Activities -->
    <bpmn:userTask id="Task_PrepareAssembly" name="Prepare Assembly">
      <bpmn:incoming">Flow_ToEngineering</bpmn:incoming>
      <bpmn:outgoing">Flow_EngineeringDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Synchronization Parallel Gateway -->
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Synchronize Preparation">
      <bpmn:incoming">Flow_StorehouseDone</bpmn:incoming>
      <bpmn:incoming">Flow_EngineeringDone</bpmn:incoming>
      <bpmn:outgoing">Flow_ToAssembly</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_AssembleBicycle" name="Assemble Bicycle">
      <bpmn:incoming">Flow_ToAssembly</bpmn:incoming>
      <bpmn:outgoing">Flow_ToShipping</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Sales Activity and Process Completion -->
    <bpmn:userTask id="Task_ShipBicycle" name="Ship Bicycle to Customer">
      <bpmn:incoming">Flow_ToShipping</bpmn:incoming>
      <bpmn:outgoing">Flow_ToFinish</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_OrderFulfilled" name="Order Fulfilled">
      <bpmn:incoming">Flow_ToFinish</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Process Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_OrderReceived" targetRef="Task_ReviewOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReviewOrder" targetRef="Gateway_OrderAccepted" />
    <bpmn:sequenceFlow id="Flow_Accepted" name="Accepted" sourceRef="Gateway_OrderAccepted" targetRef="Gateway_ParallelFork" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_OrderAccepted" targetRef="End_OrderRejected" />
    <bpmn:sequenceFlow id="Flow_ToStorehouse" sourceRef="Gateway_ParallelFork" targetRef="SubProcess_ProcessPartList" />
    <bpmn:sequenceFlow id="Flow_ToEngineering" sourceRef="Gateway_ParallelFork" targetRef="Task_PrepareAssembly" />
    <bpmn:sequenceFlow id="Flow_StorehouseDone" sourceRef="SubProcess_ProcessPartList" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_EngineeringDone" sourceRef="Task_PrepareAssembly" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_ToAssembly" sourceRef="Gateway_ParallelJoin" targetRef="Task_AssembleBicycle" />
    <bpmn:sequenceFlow id="Flow_ToShipping" sourceRef="Task_AssembleBicycle" targetRef="Task_ShipBicycle" />
    <bpmn:sequenceFlow id="Flow_ToFinish" sourceRef="Task_ShipBicycle" targetRef="End_OrderFulfilled" />

  </bpmn:process>

  <!-- Diagram Layout Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      
      <!-- Participant Diagram Shapes -->
      <bpmndi:BPMNShape id="Participant_Company_di" bpmnElement="Participant_Company" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1350" height="690" />
      </bpmndi:BPMNShape>

      <!-- Lane Diagram Shapes -->
      <bpmndi:BPMNShape id="Lane_Sales_di" bpmnElement="Lane_Sales" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1320" height="220" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Lane_Storehouse_di" bpmnElement="Lane_Storehouse" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="1320" height="260" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Lane_Engineering_di" bpmnElement="Lane_Engineering" isHorizontal="true">
        <dc:Bounds x="190" y="560" width="1320" height="210" />
      </bpmndi:BPMNShape>

      <!-- Sales Nodes Diagram Shapes -->
      <bpmndi:BPMNShape id="Start_OrderReceived_di" bpmnElement="Start_OrderReceived">
        <dc:Bounds x="242" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="222" y="205" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewOrder_di" bpmnElement="Task_ReviewOrder">
        <dc:Bounds x="330" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_OrderAccepted_di" bpmnElement="Gateway_OrderAccepted" isMarkerVisible="true">
        <dc:Bounds x="485" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="469" y="125" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_OrderRejected_di" bpmnElement="End_OrderRejected">
        <dc:Bounds x="592" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="573" y="205" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ParallelFork_di" bpmnElement="Gateway_ParallelFork">
        <dc:Bounds x="595" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ShipBicycle_di" bpmnElement="Task_ShipBicycle">
        <dc:Bounds x="1270" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_OrderFulfilled_di" bpmnElement="End_OrderFulfilled">
        <dc:Bounds x="1422" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1406" y="205" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- SubProcess Shape & Children -->
      <bpmndi:BPMNShape id="SubProcess_ProcessPartList_di" bpmnElement="SubProcess_ProcessPartList" isExpanded="true">
        <dc:Bounds x="680" y="320" width="460" height="220" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_SubProcess_di" bpmnElement="Start_SubProcess">
        <dc:Bounds x="702" y="412" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckPartAvailability_di" bpmnElement="Task_CheckPartAvailability">
        <dc:Bounds x="760" y="390" width="90" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_PartAvailable_di" bpmnElement="Gateway_PartAvailable" isMarkerVisible="true">
        <dc:Bounds x="875" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReservePart_di" bpmnElement="Task_ReservePart">
        <dc:Bounds x="950" y="340" width="80" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_BackOrderPart_di" bpmnElement="Task_BackOrderPart">
        <dc:Bounds x="950" y="460" width="80" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergePartAction_di" bpmnElement="Gateway_MergePartAction" isMarkerVisible="true">
        <dc:Bounds x="1045" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_SubProcess_di" bpmnElement="End_SubProcess">
        <dc:Bounds x="1112" y="412" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Engineering Nodes Shapes -->
      <bpmndi:BPMNShape id="Task_PrepareAssembly_di" bpmnElement="Task_PrepareAssembly">
        <dc:Bounds x="680" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ParallelJoin_di" bpmnElement="Gateway_ParallelJoin">
        <dc:Bounds x="1175" y="635" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AssembleBicycle_di" bpmnElement="Task_AssembleBicycle">
        <dc:Bounds x="1270" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="180" />
        <di:waypoint x="330" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="430" y="180" />
        <di:waypoint x="485" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Accepted_di" bpmnElement="Flow_Accepted">
        <di:waypoint x="510" y="205" />
        <di:waypoint x="510" y="260" />
        <di:waypoint x="595" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="517" y="230" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="535" y="180" />
        <di:waypoint x="592" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="542" y="162" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToStorehouse_di" bpmnElement="Flow_ToStorehouse">
        <di:waypoint x="620" y="285" />
        <di:waypoint x="620" y="430" />
        <di:waypoint x="680" y="430" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEngineering_di" bpmnElement="Flow_ToEngineering">
        <di:waypoint x="620" y="285" />
        <di:waypoint x="620" y="660" />
        <di:waypoint x="680" y="660" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_StorehouseDone_di" bpmnElement="Flow_StorehouseDone">
        <di:waypoint x="1140" y="430" />
        <di:waypoint x="1200" y="430" />
        <di:waypoint x="1200" y="635" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_EngineeringDone_di" bpmnElement="Flow_EngineeringDone">
        <di:waypoint x="780" y="660" />
        <di:waypoint x="1175" y="660" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToAssembly_di" bpmnElement="Flow_ToAssembly">
        <di:waypoint x="1225" y="660" />
        <di:waypoint x="1270" y="660" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToShipping_di" bpmnElement="Flow_ToShipping">
        <di:waypoint x="1320" y="620" />
        <di:waypoint x="1320" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToFinish_di" bpmnElement="Flow_ToFinish">
        <di:waypoint x="1370" y="180" />
        <di:waypoint x="1422" y="180" />
      </bpmndi:BPMNEdge>

      <!-- SubProcess Internal Edges -->
      <bpmndi:BPMNEdge id="SubFlow_1_di" bpmnElement="SubFlow_1">
        <di:waypoint x="738" y="430" />
        <di:waypoint x="760" y="430" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubFlow_2_di" bpmnElement="SubFlow_2">
        <di:waypoint x="850" y="430" />
        <di:waypoint x="875" y="430" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubFlow_Available_di" bpmnElement="SubFlow_Available">
        <di:waypoint x="900" y="405" />
        <di:waypoint x="900" y="370" />
        <di:waypoint x="950" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="906" y="385" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubFlow_NotAvailable_di" bpmnElement="SubFlow_NotAvailable">
        <di:waypoint x="900" y="455" />
        <di:waypoint x="900" y="490" />
        <di:waypoint x="950" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="908" y="470" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubFlow_Merge1_di" bpmnElement="SubFlow_Merge1">
        <di:waypoint x="1030" y="370" />
        <di:waypoint x="1070" y="370" />
        <di:waypoint x="1070" y="405" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubFlow_Merge2_di" bpmnElement="SubFlow_Merge2">
        <di:waypoint x="1030" y="490" />
        <di:waypoint x="1070" y="490" />
        <di:waypoint x="1070" y="455" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubFlow_End_di" bpmnElement="SubFlow_End">
        <di:waypoint x="1095" y="430" />
        <di:waypoint x="1112" y="430" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
