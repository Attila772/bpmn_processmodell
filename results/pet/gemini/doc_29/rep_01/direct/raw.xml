        <omgdi:waypoint x="420" y="360" />
        <omgdi:waypoint x="420" y="255" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_updateDeclined_to_archive_di" bpmnElement="flow_updateDeclined_to_archive">
