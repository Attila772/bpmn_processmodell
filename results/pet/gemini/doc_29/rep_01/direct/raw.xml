        <omgdi:waypoint x="564" y="470" />
        <omgdi:waypoint x="590" y="470" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_accept_to_checkDocs_di" bpmnElement="flow_accept_to_checkDocs">
