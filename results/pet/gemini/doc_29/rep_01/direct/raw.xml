      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="gateway_docsComplete_di" bpmnElement="gateway_docsComplete" isMarkerVisible="true">
        <omgdc:Bounds x="745" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="731" y="166" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="task_moveCaseToAdmin_di" bpmnElement="task_moveCaseToAdmin">
        <omgdc:Bounds x="860" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endEvent_completed_di" bpmnElement="endEvent_completed">
        <omgdc:Bounds x="1022" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1000" y="255" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="task_requestOutstandingDocs_di" bpmnElement="task_requestOutstandingDocs">
        <omgdc:Bounds x="720" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="task_updateCaseDeclined_di" bpmnElement="task_updateCaseDeclined">
        <omgdc:Bounds x="590" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="task_updateCaseTimeout_di" bpmnElement="task_updateCaseTimeout">
        <omgdc:Bounds x="590" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="gateway_mergeCancellation_di" bpmnElement="gateway_mergeCancellation" isMarkerVisible="true">
        <omgdc:Bounds x="865" y="445" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="task_archiveWork_di" bpmnElement="task_archiveWork">
        <omgdc:Bounds x="960" y="430" width="100" height="80" />
