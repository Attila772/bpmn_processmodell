        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="778" y="285" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_admin_to_endCompleted_di" bpmnElement="flow_admin_to_endCompleted">
        <omgdi:waypoint x="960" y="230" />
        <omgdi:waypoint x="1022" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_requestDocs_to_eventBasedGateway_di" bpmnElement="flow_requestDocs_to_eventBasedGateway">
