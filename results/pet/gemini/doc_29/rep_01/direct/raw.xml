        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="480" y="255" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="event_twoWeeksTimeout_di" bpmnElement="event_twoWeeksTimeout">
        <omgdc:Bounds x="502" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="480" y="365" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="task_checkPrerequisiteDocs_di" bpmnElement="task_checkPrerequisiteDocs">
