        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_archive_declined_di" bpmnElement="task_archive_declined">
        <dc:Bounds x="1300" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_archive_timeout_di" bpmnElement="task_archive_timeout">
        <dc:Bounds x="1300" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_cust_review_di" bpmnElement="task_cust_review">
        <dc:Bounds x="350" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_generate_req_docs_di" bpmnElement="task_generate_req_docs">
