        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_update_declined_di" bpmnElement="task_update_declined">
        <dc:Bounds x="1110" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_update_timeout_di" bpmnElement="task_update_timeout">
        <dc:Bounds x="1110" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_wait_reply_di" bpmnElement="task_wait_reply">
        <dc:Bounds x="1680" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_mortgage_offer_di" bpmnElement="do_mortgage_offer">
