<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ClaimProcess"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:process id="ClaimHandlingProcess" name="Claim Handling Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:outgoing>Flow_StartToExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming>Flow_StartToExamine</bpmn:incoming>
      <bpmn:outgoing>Flow_ExamineToWrite</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>Flow_ExamineToWrite</bpmn:incoming>
      <bpmn:incoming>Flow_NotOK</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteToCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckRecommendation" name="Check Recommendation">
      <bpmn:incoming>Flow_WriteToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_RecommendationApproval" name="Recommendation OK?">
      <bpmn:incoming>Flow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ProceedClaimHandling" name="Proceed Claim Handling">
      <bpmn:incoming>Flow_OK</bpmn:incoming>
      <bpmn:outgoing>Flow_ProceedToEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ClaimProcessed" name="Claim Processed">
      <bpmn:incoming>Flow_ProceedToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToExamine" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim" />
    <bpmn:sequenceFlow id="Flow_ExamineToWrite" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation" />
    <bpmn:sequenceFlow id="Flow_WriteToCheck" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation" />
    <bpmn:sequenceFlow id="Flow_CheckToGateway" sourceRef="Task_CheckRecommendation" targetRef="Gateway_RecommendationApproval" />
    <bpmn:sequenceFlow id="Flow_OK" name="OK" sourceRef="Gateway_RecommendationApproval" targetRef="Task_ProceedClaimHandling" />
    <bpmn:sequenceFlow id="Flow_NotOK" name="Not OK" sourceRef="Gateway_RecommendationApproval" targetRef="Task_WriteRecommendation" />
    <bpmn:sequenceFlow id="Flow_ProceedToEnd" sourceRef="Task_ProceedClaimHandling" targetRef="EndEvent_ClaimProcessed" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ClaimProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_ClaimProcess" bpmnElement="ClaimHandlingProcess">
      <bpmndi:BPMNShape id="StartEvent_ClaimRegistered_di" bpmnElement="StartEvent_ClaimRegistered">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="128" y="145" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ExamineClaim_di" bpmnElement="Task_ExamineClaim">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_WriteRecommendation_di" bpmnElement="Task_WriteRecommendation">
        <dc:Bounds x="390" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckRecommendation_di" bpmnElement="Task_CheckRecommendation">
        <dc:Bounds x="540" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_RecommendationApproval_di" bpmnElement="Gateway_RecommendationApproval" isMarkerVisible="true">
        <dc:Bounds x="695" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="677" y="65" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProceedClaimHandling_di" bpmnElement="Task_ProceedClaimHandling">
        <dc:Bounds x="800" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ClaimProcessed_di" bpmnElement="EndEvent_ClaimProcessed">
        <dc:Bounds x="952" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="929" y="145" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_StartToExamine_di" bpmnElement="Flow_StartToExamine">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ExamineToWrite_di" bpmnElement="Flow_ExamineToWrite">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="390" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_WriteToCheck_di" bpmnElement="Flow_WriteToCheck">
        <di:waypoint x="490" y="120" />
        <di:waypoint x="540" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CheckToGateway_di" bpmnElement="Flow_CheckToGateway">
        <di:waypoint x="640" y="120" />
        <di:waypoint x="695" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_OK_di" bpmnElement="Flow_OK">
        <di:waypoint x="745" y="120" />
        <di:waypoint x="800" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="764" y="102" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_NotOK_di" bpmnElement="Flow_NotOK">
        <di:waypoint x="720" y="145" />
        <di:waypoint x="720" y="210" />
        <di:waypoint x="440" y="210" />
        <di:waypoint x="440" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="562" y="192" width="37" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ProceedToEnd_di" bpmnElement="Flow_ProceedToEnd">
        <di:waypoint x="900" y="120" />
        <di:waypoint x="952" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
