<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_1" name="Claim" dataObjectRef="data_1_do" />
    <bpmn:dataObject id="data_1_do" />
    <bpmn:dataObjectReference id="data_2" name="Settlement recommendation" dataObjectRef="data_2_do" />
    <bpmn:dataObject id="data_2_do" />
    <bpmn:startEvent id="event_1" name="Claim registered">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_2" name="Claim handling proceeded">
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_1" name="Examine claim">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:property id="task_1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_1_dia0">
        <bpmn:sourceRef>data_1</bpmn:sourceRef>
        <bpmn:targetRef>task_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_2" name="Write settlement recommendation">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_2_dia0">
        <bpmn:sourceRef>data_1</bpmn:sourceRef>
        <bpmn:targetRef>task_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_2_doa0">
        <bpmn:targetRef>data_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:userTask>
    <bpmn:userTask id="task_3" name="Check settlement recommendation">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_3_dia0">
        <bpmn:sourceRef>data_2</bpmn:sourceRef>
        <bpmn:targetRef>task_3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_1" name="Check status" isMarkerVisible="true">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="event_1" targetRef="task_1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_2" targetRef="task_3" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_3" targetRef="gateway_1" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="gateway_1" targetRef="event_2" name="OK" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="gateway_1" targetRef="task_2" name="Not OK" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_1_di" bpmnElement="event_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_2_di" bpmnElement="event_2">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_1_di" bpmnElement="gateway_1">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_di" bpmnElement="task_1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_2_di" bpmnElement="task_2">
        <dc:Bounds x="1110" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_3_di" bpmnElement="task_3">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_1_di" bpmnElement="data_1">
        <dc:Bounds x="750" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_2_di" bpmnElement="data_2">
        <dc:Bounds x="940" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_dia0_di" bpmnElement="task_1_dia0">
        <di:waypoint x="768" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_2_dia0_di" bpmnElement="task_2_dia0">
        <di:waypoint x="768" y="390" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_2_doa0_di" bpmnElement="task_2_doa0">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="958" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_3_dia0_di" bpmnElement="task_3_dia0">
        <di:waypoint x="958" y="390" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>