<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn">

  <bpmn:process id="Process_ClaimHandling" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:outgoing">Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming">Flow_1</bpmn:incoming>
      <bpmn:outgoing">Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming">Flow_2</bpmn:incoming>
      <bpmn:incoming">Flow_NotOK</bpmn:incoming>
      <bpmn:outgoing">Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckRecommendation" name="Check Recommendation">
      <bpmn:incoming">Flow_3</bpmn:incoming>
      <bpmn:outgoing">Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CheckStatus" name="Recommendation OK?">
      <bpmn:incoming">Flow_4</bpmn:incoming>
      <bpmn:outgoing">Flow_OK</bpmn:outgoing>
      <bpmn:outgoing">Flow_NotOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_ProceedHandling" name="Proceed with Claim Handling">
      <bpmn:incoming">Flow_OK</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckRecommendation" targetRef="Gateway_CheckStatus" />
    <bpmn:sequenceFlow id="Flow_OK" name="OK" sourceRef="Gateway_CheckStatus" targetRef="EndEvent_ProceedHandling" />
    <bpmn:sequenceFlow id="Flow_NotOK" name="Not OK" sourceRef="Gateway_CheckStatus" targetRef="Task_WriteRecommendation" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ClaimHandling">
      <bpmndi:BPMNShape id="StartEvent_ClaimRegistered_di" bpmnElement="StartEvent_ClaimRegistered">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="128" y="145" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ExamineClaim_di" bpmnElement="Task_ExamineClaim">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_WriteRecommendation_di" bpmnElement="Task_WriteRecommendation">
        <dc:Bounds x="390" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckRecommendation_di" bpmnElement="Task_CheckRecommendation">
        <dc:Bounds x="540" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_CheckStatus_di" bpmnElement="Gateway_CheckStatus" isMarkerVisible="true">
        <dc:Bounds x="695" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="677" y="56" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ProceedHandling_di" bpmnElement="EndEvent_ProceedHandling">
        <dc:Bounds x="812" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="793" y="145" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="390" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="490" y="120" />
        <di:waypoint x="540" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="640" y="120" />
        <di:waypoint x="695" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_OK_di" bpmnElement="Flow_OK">
        <di:waypoint x="745" y="120" />
        <di:waypoint x="812" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="770" y="102" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_NotOK_di" bpmnElement="Flow_NotOK">
        <di:waypoint x="720" y="145" />
        <di:waypoint x="720" y="210" />
        <di:waypoint x="440" y="210" />
        <di:waypoint x="440" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="561" y="192" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
