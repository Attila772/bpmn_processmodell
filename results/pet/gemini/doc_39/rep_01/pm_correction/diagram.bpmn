<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_claim" name="Claim" dataObjectRef="data_claim_do" />
    <bpmn:dataObject id="data_claim_do" />
    <bpmn:dataObjectReference id="data_settlement_recommendation" name="Settlement Recommendation" dataObjectRef="data_settlement_recommendation_do" />
    <bpmn:dataObject id="data_settlement_recommendation_do" />
    <bpmn:startEvent id="event_claim_registered" name="Claim registered">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_claim_handled" name="Claim handling process proceeds">
      <bpmn:incoming>flow_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_examine_claim" name="Examine claim">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:property id="task_examine_claim_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_claim_dia0">
        <bpmn:sourceRef>data_claim</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_claim_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_write_recommendation" name="Write settlement recommendation">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_not_ok</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_write_recommendation_doa0">
        <bpmn:targetRef>data_settlement_recommendation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_recommendation" name="Check recommendation">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_check_recommendation_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_recommendation_dia0">
        <bpmn:sourceRef>data_settlement_recommendation</bpmn:sourceRef>
        <bpmn:targetRef>task_check_recommendation_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_check_ok" name="Claim OK?" isMarkerVisible="true">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_not_ok</bpmn:outgoing>
      <bpmn:outgoing>flow_ok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="event_claim_registered" targetRef="task_examine_claim" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_examine_claim" targetRef="task_write_recommendation" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_write_recommendation" targetRef="task_check_recommendation" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_check_recommendation" targetRef="gateway_check_ok" />
    <bpmn:sequenceFlow id="flow_not_ok" sourceRef="gateway_check_ok" targetRef="task_write_recommendation" name="Not OK" />
    <bpmn:sequenceFlow id="flow_ok" sourceRef="gateway_check_ok" targetRef="event_claim_handled" name="OK" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_claim_handled_di" bpmnElement="event_claim_handled">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_claim_registered_di" bpmnElement="event_claim_registered">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_check_ok_di" bpmnElement="gateway_check_ok">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_recommendation_di" bpmnElement="task_check_recommendation">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_examine_claim_di" bpmnElement="task_examine_claim">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_write_recommendation_di" bpmnElement="task_write_recommendation">
        <dc:Bounds x="1110" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_claim_di" bpmnElement="data_claim">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_settlement_recommendation_di" bpmnElement="data_settlement_recommendation">
        <dc:Bounds x="940" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_not_ok_di" bpmnElement="flow_not_ok">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ok_di" bpmnElement="flow_ok">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_examine_claim_dia0_di" bpmnElement="task_examine_claim_dia0">
        <di:waypoint x="388" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_write_recommendation_doa0_di" bpmnElement="task_write_recommendation_doa0">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="958" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_recommendation_dia0_di" bpmnElement="task_check_recommendation_dia0">
        <di:waypoint x="958" y="390" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>