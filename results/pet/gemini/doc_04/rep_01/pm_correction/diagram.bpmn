<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="p1_part" name="Company / Underwriters" processRef="p1_proc" />
    <bpmn:participant id="p2_part" name="Securities and Exchange Commission (SEC)" processRef="p2_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="e2" targetRef="e3" name="Registration Statement Submission" />
    <bpmn:messageFlow id="mf2" sourceRef="e4" targetRef="e5" name="SEC Clearance Notification" />
  </bpmn:collaboration>
  <bpmn:process id="p1_proc" isExecutable="false">
    <bpmn:dataObjectReference id="d1" name="Registration Statement" dataObjectRef="d1_do" />
    <bpmn:dataObject id="d1_do" />
    <bpmn:dataObjectReference id="d2_p1" name="SEC Clearance" dataObjectRef="d2_p1_do" />
    <bpmn:dataObject id="d2_p1_do" />
    <bpmn:startEvent id="e1" name="Decision to go public made">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Registration statement submitted">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:messageEventDefinition id="e2_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="e5" name="SEC clearance received">
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e5_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="e6" name="Stock offered to public">
      <bpmn:incoming>sf15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e7" name="IPO Process cancelled">
      <bpmn:incoming>sf14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1" name="Select underwriters">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Provide procedural and financial advice">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="t3" name="Prepare registration statement">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t3_doa0">
        <bpmn:targetRef>d1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="t4" name="Check compliance with state blue-sky laws">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="t4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t4_dia0">
        <bpmn:sourceRef>d1</bpmn:sourceRef>
        <bpmn:targetRef>t4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t6" name="Firm up issue price">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Arrange road show to talk to potential investors">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Fix issue price">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:property id="t8_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t8_dia0">
        <bpmn:sourceRef>d2_p1</bpmn:sourceRef>
        <bpmn:targetRef>t8_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t9" name="Enter firm commitment to buy stock">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13_seq</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="Offer stock to the public">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="g1" name="Parallel work while awaiting approval">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:outgoing>sf7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="g2" name="Parallel work convergence">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="g3" name="Reason found not to proceed?" isMarkerVisible="true">
      <bpmn:incoming>sf13_seq</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:outgoing>sf14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf1" sourceRef="e1" targetRef="t1" />
    <bpmn:sequenceFlow id="sf2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="sf3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="sf4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="sf5" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="sf6" sourceRef="t4" targetRef="e2" />
    <bpmn:sequenceFlow id="sf7" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="sf8" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="sf9" sourceRef="t7" targetRef="g2" />
    <bpmn:sequenceFlow id="sf10" sourceRef="e5" targetRef="g2" />
    <bpmn:sequenceFlow id="sf11" sourceRef="g2" targetRef="t8" />
    <bpmn:sequenceFlow id="sf12" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="sf13_seq" sourceRef="t9" targetRef="g3" />
    <bpmn:sequenceFlow id="sf13" sourceRef="g3" targetRef="t10" name="No reason found not to do it" />
    <bpmn:sequenceFlow id="sf14" sourceRef="g3" targetRef="e7" name="Reason found not to do it" />
    <bpmn:sequenceFlow id="sf15" sourceRef="t10" targetRef="e6" />
  </bpmn:process>
  <bpmn:process id="p2_proc" isExecutable="false">
    <bpmn:dataObjectReference id="d1_p1" name="Registration Statement" dataObjectRef="d1_p1_do" />
    <bpmn:dataObject id="d1_p1_do" />
    <bpmn:dataObjectReference id="d2" name="SEC Clearance" dataObjectRef="d2_do" />
    <bpmn:dataObject id="d2_do" />
    <bpmn:startEvent id="e3" name="Registration statement received">
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e3_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="e4" name="SEC clearance granted">
      <bpmn:incoming>sf17</bpmn:incoming>
      <bpmn:messageEventDefinition id="e4_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="t5" name="Review and approve registration statement">
      <bpmn:incoming>sf16</bpmn:incoming>
      <bpmn:outgoing>sf17</bpmn:outgoing>
      <bpmn:property id="t5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t5_dia0">
        <bpmn:sourceRef>d1_p1</bpmn:sourceRef>
        <bpmn:targetRef>t5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t5_doa0">
        <bpmn:targetRef>d2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf16" sourceRef="e3" targetRef="t5" />
    <bpmn:sequenceFlow id="sf17" sourceRef="t5" targetRef="e4" />
  </bpmn:process>
