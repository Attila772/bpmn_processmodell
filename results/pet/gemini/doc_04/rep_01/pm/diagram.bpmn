<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_company_part" name="Company" processRef="pool_company_proc" />
    <bpmn:participant id="pool_underwriters_part" name="Underwriters" processRef="pool_underwriters_proc" />
    <bpmn:participant id="pool_sec_part" name="Securities and Exchange Commission (SEC)" processRef="pool_sec_proc" />
    <bpmn:messageFlow id="mf_select_underwriters" sourceRef="task_select_underwriters" targetRef="task_provide_advice" name="Underwriter Selection" />
    <bpmn:messageFlow id="mf_reg_statement_submission" sourceRef="event_reg_sent" targetRef="event_sec_received" name="Registration Statement Submission" />
    <bpmn:messageFlow id="mf_sec_clearance_transmission" sourceRef="event_sec_cleared" targetRef="event_clearance_received" name="SEC Clearance Transmission" />
  </bpmn:collaboration>
  <bpmn:process id="pool_company_proc" isExecutable="false">
    <bpmn:startEvent id="event_start" name="Decision to go public made">
      <bpmn:outgoing>sf_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_select_underwriters" name="Select underwriters">
      <bpmn:incoming>sf_c1</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_c1" sourceRef="event_start" targetRef="task_select_underwriters" />
  </bpmn:process>
  <bpmn:process id="pool_underwriters_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_reg_statement" name="Registration Statement" dataObjectRef="data_reg_statement_do" />
    <bpmn:dataObject id="data_reg_statement_do" />
    <bpmn:dataObjectReference id="data_sec_clearance_p1" name="SEC Clearance" dataObjectRef="data_sec_clearance_p1_do" />
    <bpmn:dataObject id="data_sec_clearance_p1_do" />
    <bpmn:dataObjectReference id="data_issue_price" name="Issue Price Specification" dataObjectRef="data_issue_price_do" />
    <bpmn:dataObject id="data_issue_price_do" />
    <bpmn:intermediateThrowEvent id="event_reg_sent" name="Registration statement submitted">
      <bpmn:incoming>sf_u7</bpmn:incoming>
      <bpmn:outgoing>sf_u9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_reg_sent_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="event_clearance_received" name="SEC Clearance received">
      <bpmn:incoming>sf_u9</bpmn:incoming>
      <bpmn:outgoing>sf_u10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_clearance_received_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="event_end_success" name="Stock offered to the public">
      <bpmn:incoming>sf_u15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="event_end_aborted" name="IPO Aborted">
      <bpmn:incoming>sf_proceed_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_provide_advice" name="Provide procedural and financial advice">
      <bpmn:outgoing>sf_u1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_prepare_reg_statement" name="Prepare registration statement">
      <bpmn:incoming>sf_u2</bpmn:incoming>
      <bpmn:outgoing>sf_u4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_prepare_reg_statement_doa0">
        <bpmn:targetRef>data_reg_statement</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_check_blue_sky_laws" name="Check compliance with blue-sky laws">
      <bpmn:incoming>sf_u3</bpmn:incoming>
      <bpmn:outgoing>sf_u5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_arrange_road_show" name="Arrange road show for potential investors">
      <bpmn:incoming>sf_u8</bpmn:incoming>
      <bpmn:outgoing>sf_u11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_fix_issue_price" name="Fix issue price">
      <bpmn:incoming>sf_u12</bpmn:incoming>
      <bpmn:outgoing>sf_u13</bpmn:outgoing>
      <bpmn:property id="task_fix_issue_price_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_fix_issue_price_dia0">
        <bpmn:sourceRef>data_sec_clearance_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_fix_issue_price_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_fix_issue_price_doa0">
        <bpmn:targetRef>data_issue_price</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_enter_firm_commitment" name="Enter into firm commitment to buy stock">
      <bpmn:incoming>sf_proceed_yes</bpmn:incoming>
      <bpmn:outgoing>sf_u14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_offer_public" name="Offer stock to the public">
      <bpmn:incoming>sf_u14</bpmn:incoming>
      <bpmn:outgoing>sf_u15</bpmn:outgoing>
      <bpmn:property id="task_offer_public_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_offer_public_dia0">
        <bpmn:sourceRef>data_issue_price</bpmn:sourceRef>
        <bpmn:targetRef>task_offer_public_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="gw_parallel_prep_start" name="Parallel Prep Start">
      <bpmn:incoming>sf_u1</bpmn:incoming>
      <bpmn:outgoing>sf_u2</bpmn:outgoing>
      <bpmn:outgoing>sf_u3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_parallel_prep_end" name="Parallel Prep End">
      <bpmn:incoming>sf_u4</bpmn:incoming>
      <bpmn:incoming>sf_u5</bpmn:incoming>
      <bpmn:outgoing>sf_u6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_parallel_await_start" name="Parallel Await Approval Start">
      <bpmn:incoming>sf_u6</bpmn:incoming>
      <bpmn:outgoing>sf_u7</bpmn:outgoing>
      <bpmn:outgoing>sf_u8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_parallel_await_end" name="Parallel Await Approval End">
      <bpmn:incoming>sf_u10</bpmn:incoming>
      <bpmn:incoming>sf_u11</bpmn:incoming>
      <bpmn:outgoing>sf_u12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gw_exclusive_proceed" name="Reason found not to proceed?" isMarkerVisible="true">
      <bpmn:incoming>sf_u13</bpmn:incoming>
      <bpmn:outgoing>sf_proceed_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_proceed_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_u1" sourceRef="task_provide_advice" targetRef="gw_parallel_prep_start" />
    <bpmn:sequenceFlow id="sf_u2" sourceRef="gw_parallel_prep_start" targetRef="task_prepare_reg_statement" />
    <bpmn:sequenceFlow id="sf_u3" sourceRef="gw_parallel_prep_start" targetRef="task_check_blue_sky_laws" />
    <bpmn:sequenceFlow id="sf_u4" sourceRef="task_prepare_reg_statement" targetRef="gw_parallel_prep_end" />
    <bpmn:sequenceFlow id="sf_u5" sourceRef="task_check_blue_sky_laws" targetRef="gw_parallel_prep_end" />
    <bpmn:sequenceFlow id="sf_u6" sourceRef="gw_parallel_prep_end" targetRef="gw_parallel_await_start" />
    <bpmn:sequenceFlow id="sf_u7" sourceRef="gw_parallel_await_start" targetRef="event_reg_sent" />
    <bpmn:sequenceFlow id="sf_u8" sourceRef="gw_parallel_await_start" targetRef="task_arrange_road_show" />
    <bpmn:sequenceFlow id="sf_u9" sourceRef="event_reg_sent" targetRef="event_clearance_received" />
    <bpmn:sequenceFlow id="sf_u10" sourceRef="event_clearance_received" targetRef="gw_parallel_await_end" />
    <bpmn:sequenceFlow id="sf_u11" sourceRef="task_arrange_road_show" targetRef="gw_parallel_await_end" />
    <bpmn:sequenceFlow id="sf_u12" sourceRef="gw_parallel_await_end" targetRef="task_fix_issue_price" />
    <bpmn:sequenceFlow id="sf_u13" sourceRef="task_fix_issue_price" targetRef="gw_exclusive_proceed" />
    <bpmn:sequenceFlow id="sf_proceed_yes" sourceRef="gw_exclusive_proceed" targetRef="task_enter_firm_commitment" name="No reason found not to proceed" />
    <bpmn:sequenceFlow id="sf_proceed_no" sourceRef="gw_exclusive_proceed" targetRef="event_end_aborted" name="Reason found not to proceed" />
    <bpmn:sequenceFlow id="sf_u14" sourceRef="task_enter_firm_commitment" targetRef="task_offer_public" />
    <bpmn:sequenceFlow id="sf_u15" sourceRef="task_offer_public" targetRef="event_end_success" />
  </bpmn:process>
  <bpmn:process id="pool_sec_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_reg_statement_p1" name="Registration Statement" dataObjectRef="data_reg_statement_p1_do" />
    <bpmn:dataObject id="data_reg_statement_p1_do" />
    <bpmn:dataObjectReference id="data_sec_clearance" name="SEC Clearance" dataObjectRef="data_sec_clearance_do" />
    <bpmn:dataObject id="data_sec_clearance_do" />
    <bpmn:startEvent id="event_sec_received" name="Registration statement received">
      <bpmn:outgoing>sf_sec1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_sec_received_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="event_sec_cleared" name="Clearance issued">
      <bpmn:incoming>sf_sec2</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_sec_cleared_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_review_approval" name="Review and approve registration statement">
      <bpmn:incoming>sf_sec1</bpmn:incoming>
      <bpmn:outgoing>sf_sec2</bpmn:outgoing>
      <bpmn:property id="task_review_approval_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_approval_dia0">
        <bpmn:sourceRef>data_reg_statement_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_approval_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_review_approval_doa0">
        <bpmn:targetRef>data_sec_clearance</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf_sec1" sourceRef="event_sec_received" targetRef="task_review_approval" />
    <bpmn:sequenceFlow id="sf_sec2" sourceRef="task_review_approval" targetRef="event_sec_cleared" />
  </bpmn:process>
