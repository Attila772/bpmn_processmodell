<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_IPO_Process"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_IPO">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company_IPO" />
    <bpmn:participant id="Participant_Underwriter" name="Underwriters" processRef="Process_Underwriter_IPO" />
    <bpmn:participant id="Participant_SEC" name="Securities and Exchange Commission (SEC)" />
    <bpmn:participant id="Participant_Investors" name="Potential Investors / Public" />
    <bpmn:messageFlow id="MF_Select_Underwriters" sourceRef="Activity_SelectUnderwriters" targetRef="StartEvent_Underwriter" />
    <bpmn:messageFlow id="MF_Submit_Registration" sourceRef="Activity_PrepareRegistration" targetRef="Participant_SEC" />
    <bpmn:messageFlow id="MF_SEC_Clearance" sourceRef="Participant_SEC" targetRef="Event_SEC_Clearance_Received" />
    <bpmn:messageFlow id="MF_Roadshow" sourceRef="Activity_ArrangeRoadshow" targetRef="Participant_Investors" />
    <bpmn:messageFlow id="MF_Offer_Public" sourceRef="Activity_OfferToPublic" targetRef="Participant_Investors" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Company_IPO" name="Company IPO Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Decision" name="Decision made to go public">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_SelectUnderwriters" name="Select underwriters">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_ReceiveAdvice" name="Receive procedural and financial advice">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Company" name="IPO Process Initiated">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_Decision" targetRef="Activity_SelectUnderwriters" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Activity_SelectUnderwriters" targetRef="Activity_ReceiveAdvice" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Activity_ReceiveAdvice" targetRef="EndEvent_Company" />
  </bpmn:process>

  <bpmn:process id="Process_Underwriter_IPO" name="Underwriters IPO Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Underwriter" name="Selected as Underwriter">
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_ProvideAdvice" name="Provide procedural and financial advice">
      <bpmn:incoming>Flow_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_U2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_EvaluateFacts" name="Evaluate fairness of presented facts">
      <bpmn:incoming>Flow_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_U3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HandleIssue" name="Fairly presented and willing to handle?">
      <bpmn:incoming>Flow_U3</bpmn:incoming>
      <bpmn:outgoing>Flow_Fair_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fair_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Refuse" name="Refuse to handle issue">
      <bpmn:incoming>Flow_Fair_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_Fork_Prep">
      <bpmn:incoming>Flow_Fair_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Activity_PrepareRegistration" name="Prepare and submit SEC registration statement">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_CheckBlueSky" name="Check compliance with state blue-sky laws">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Join_Prep">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:incoming>Flow_P4</bpmn:incoming>
      <bpmn:outgoing>Flow_U4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_Fork_Approval">
      <bpmn:incoming>Flow_U4</bpmn:incoming>
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="Event_SEC_Clearance_Received" name="SEC Clearance Received">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_SEC" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="SubProcess_FirmUpPrice" name="Firm up issue price while awaiting approval">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_Sub">
        <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Activity_ArrangeRoadshow" name="Arrange road show to talk to potential investors">
        <bpmn:incoming>Flow_S1</bpmn:incoming>
        <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="EndEvent_Sub">
        <bpmn:incoming>Flow_S2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S1" sourceRef="StartEvent_Sub" targetRef="Activity_ArrangeRoadshow" />
      <bpmn:sequenceFlow id="Flow_S2" sourceRef="Activity_ArrangeRoadshow" targetRef="EndEvent_Sub" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="Gateway_Join_Approval">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_U5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Activity_FixIssuePrice" name="Fix issue price immediately after clearance">
      <bpmn:incoming>Flow_U5</bpmn:incoming>
      <bpmn:outgoing>Flow_U6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_CommitToBuy" name="Enter firm commitment to buy stock">
      <bpmn:incoming>Flow_U6</bpmn:incoming>
      <bpmn:outgoing>Flow_U7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckReason" name="Any reason not to proceed?">
      <bpmn:incoming>Flow_U7</bpmn:incoming>
      <bpmn:outgoing>Flow_No_Reason</bpmn:outgoing>
      <bpmn:outgoing>Flow_Has_Reason</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_OfferToPublic" name="Offer stock to the public">
      <bpmn:incoming>Flow_No_Reason</bpmn:incoming>
      <bpmn:outgoing>Flow_U8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Completed" name="Issue Resold to Public">
      <bpmn:incoming>Flow_U8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Aborted" name="Offering Cancelled">
      <bpmn:incoming>Flow_Has_Reason</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_U1" sourceRef="StartEvent_Underwriter" targetRef="Activity_ProvideAdvice" />
    <bpmn:sequenceFlow id="Flow_U2" sourceRef="Activity_ProvideAdvice" targetRef="Activity_EvaluateFacts" />
    <bpmn:sequenceFlow id="Flow_U3" sourceRef="Activity_EvaluateFacts" targetRef="Gateway_HandleIssue" />
    <bpmn:sequenceFlow id="Flow_Fair_Yes" name="Yes" sourceRef="Gateway_HandleIssue" targetRef="Gateway_Fork_Prep" />
    <bpmn:sequenceFlow id="Flow_Fair_No" name="No" sourceRef="Gateway_HandleIssue" targetRef="EndEvent_Refuse" />
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Gateway_Fork_Prep" targetRef="Activity_PrepareRegistration" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Gateway_Fork_Prep" targetRef="Activity_CheckBlueSky" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Activity_PrepareRegistration" targetRef="Gateway_Join_Prep" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Activity_CheckBlueSky" targetRef="Gateway_Join_Prep" />
    <bpmn:sequenceFlow id="Flow_U4" sourceRef="Gateway_Join_Prep" targetRef="Gateway_Fork_Approval" />
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Gateway_Fork_Approval" targetRef="Event_SEC_Clearance_Received" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Gateway_Fork_Approval" targetRef="SubProcess_FirmUpPrice" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Event_SEC_Clearance_Received" targetRef="Gateway_Join_Approval" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="SubProcess_FirmUpPrice" targetRef="Gateway_Join_Approval" />
    <bpmn:sequenceFlow id="Flow_U5" sourceRef="Gateway_Join_Approval" targetRef="Activity_FixIssuePrice" />
    <bpmn:sequenceFlow id="Flow_U6" sourceRef="Activity_FixIssuePrice" targetRef="Activity_CommitToBuy" />
    <bpmn:sequenceFlow id="Flow_U7" sourceRef="Activity_CommitToBuy" targetRef="Gateway_CheckReason" />
    <bpmn:sequenceFlow id="Flow_No_Reason" name="No reason found" sourceRef="Gateway_CheckReason" targetRef="Activity_OfferToPublic" />
    <bpmn:sequenceFlow id="Flow_Has_Reason" name="Reason found" sourceRef="Gateway_CheckReason" targetRef="EndEvent_Aborted" />
    <bpmn:sequenceFlow id="Flow_U8" sourceRef="Activity_OfferToPublic" targetRef="EndEvent_Completed" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_IPO">
    <bpmndi:BPMNPlane id="BPMNPlane_IPO" bpmnElement="Collaboration_IPO">
      <!-- Company Pool -->
      <bpmndi:BPMNShape id="Shape_Participant_Company" bpmnElement="Participant_Company" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="600" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_Decision" bpmnElement="StartEvent_Decision">
        <dc:Bounds x="212" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="189" y="195" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_SelectUnderwriters" bpmnElement="Activity_SelectUnderwriters">
        <dc:Bounds x="300" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ReceiveAdvice" bpmnElement="Activity_ReceiveAdvice">
        <dc:Bounds x="450" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Company" bpmnElement="EndEvent_Company">
        <dc:Bounds x="602" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="590" y="195" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_C1" bpmnElement="Flow_C1">
        <di:waypoint x="248" y="170" />
        <di:waypoint x="300" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_C2" bpmnElement="Flow_C2">
        <di:waypoint x="400" y="170" />
        <di:waypoint x="450" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_C3" bpmnElement="Flow_C3">
        <di:waypoint x="550" y="170" />
        <di:waypoint x="602" y="170" />
      </bpmndi:BPMNEdge>

      <!-- External SEC Pool -->
      <bpmndi:BPMNShape id="Shape_Participant_SEC" bpmnElement="Participant_SEC" isHorizontal="true">
        <dc:Bounds x="800" y="80" width="300" height="60" />
      </bpmndi:BPMNShape>

      <!-- External Investors Pool -->
      <bpmndi:BPMNShape id="Shape_Participant_Investors" bpmnElement="Participant_Investors" isHorizontal="true">
        <dc:Bounds x="1150" y="80" width="600" height="60" />
      </bpmndi:BPMNShape>

      <!-- Underwriter Pool -->
      <bpmndi:BPMNShape id="Shape_Participant_Underwriter" bpmnElement="Participant_Underwriter" isHorizontal="true">
        <dc:Bounds x="160" y="300" width="1850" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_Underwriter" bpmnElement="StartEvent_Underwriter">
        <dc:Bounds x="212" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="199" y="465" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ProvideAdvice" bpmnElement="Activity_ProvideAdvice">
        <dc:Bounds x="290" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_EvaluateFacts" bpmnElement="Activity_EvaluateFacts">
        <dc:Bounds x="430" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_HandleIssue" bpmnElement="Gateway_HandleIssue" isMarkerVisible="true">
        <dc:Bounds x="575" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="560" y="375" width="81" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Refuse" bpmnElement="EndEvent_Refuse">
        <dc:Bounds x="582" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="560" y="585" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Fork_Prep" bpmnElement="Gateway_Fork_Prep">
        <dc:Bounds x="675" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_PrepareRegistration" bpmnElement="Activity_PrepareRegistration">
        <dc:Bounds x="770" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_CheckBlueSky" bpmnElement="Activity_CheckBlueSky">
        <dc:Bounds x="770" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Join_Prep" bpmnElement="Gateway_Join_Prep">
        <dc:Bounds x="915" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Fork_Approval" bpmnElement="Gateway_Fork_Approval">
        <dc:Bounds x="1015" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_SEC_Clearance_Received" bpmnElement="Event_SEC_Clearance_Received">
        <dc:Bounds x="1102" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1081" y="415" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_FirmUpPrice" bpmnElement="SubProcess_FirmUpPrice" isExpanded="true">
        <dc:Bounds x="1100" y="450" width="280" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_Sub" bpmnElement="StartEvent_Sub">
        <dc:Bounds x="1122" y="507" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ArrangeRoadshow" bpmnElement="Activity_ArrangeRoadshow">
        <dc:Bounds x="1180" y="485" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Sub" bpmnElement="EndEvent_Sub">
        <dc:Bounds x="1322" y="507" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_S1" bpmnElement="Flow_S1">
        <di:waypoint x="1158" y="525" />
        <di:waypoint x="1180" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_S2" bpmnElement="Flow_S2">
        <di:waypoint x="1290" y="525" />
        <di:waypoint x="1322" y="525" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Shape_Gateway_Join_Approval" bpmnElement="Gateway_Join_Approval">
        <dc:Bounds x="1425" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_FixIssuePrice" bpmnElement="Activity_FixIssuePrice">
        <dc:Bounds x="1510" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_CommitToBuy" bpmnElement="Activity_CommitToBuy">
        <dc:Bounds x="1650" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_CheckReason" bpmnElement="Gateway_CheckReason" isMarkerVisible="true">
        <dc:Bounds x="1795" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1783" y="378" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_OfferToPublic" bpmnElement="Activity_OfferToPublic">
        <dc:Bounds x="1890" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Completed" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="2032" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2012" y="465" width="77" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Aborted" bpmnElement="EndEvent_Aborted">
        <dc:Bounds x="1802" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1775" y="585" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flows Underwriter -->
      <bpmndi:BPMNEdge id="Edge_Flow_U1" bpmnElement="Flow_U1">
        <di:waypoint x="248" y="440" />
        <di:waypoint x="290" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U2" bpmnElement="Flow_U2">
        <di:waypoint x="390" y="440" />
        <di:waypoint x="430" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U3" bpmnElement="Flow_U3">
        <di:waypoint x="530" y="440" />
        <di:waypoint x="575" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Fair_Yes" bpmnElement="Flow_Fair_Yes">
        <di:waypoint x="625" y="440" />
        <di:waypoint x="675" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="641" y="422" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Fair_No" bpmnElement="Flow_Fair_No">
        <di:waypoint x="600" y="465" />
        <di:waypoint x="600" y="542" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="608" y="501" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P1" bpmnElement="Flow_P1">
        <di:waypoint x="700" y="415" />
        <di:waypoint x="700" y="390" />
        <di:waypoint x="770" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P2" bpmnElement="Flow_P2">
        <di:waypoint x="700" y="465" />
        <di:waypoint x="700" y="510" />
        <di:waypoint x="770" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P3" bpmnElement="Flow_P3">
        <di:waypoint x="870" y="390" />
        <di:waypoint x="940" y="390" />
        <di:waypoint x="940" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P4" bpmnElement="Flow_P4">
        <di:waypoint x="870" y="510" />
        <di:waypoint x="940" y="510" />
        <di:waypoint x="940" y="465" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_U4" bpmnElement="Flow_U4">
        <di:waypoint x="965" y="440" />
        <di:waypoint x="1015" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A1" bpmnElement="Flow_A1">
        <di:waypoint x="1040" y="415" />
        <di:waypoint x="1040" y="390" />
        <di:waypoint x="1102" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A2" bpmnElement="Flow_A2">
        <di:waypoint x="1040" y="465" />
        <di:waypoint x="1040" y="525" />
        <di:waypoint x="1100" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A3" bpmnElement="Flow_A3">
        <di:waypoint x="1138" y="390" />
        <di:waypoint x="1450" y="390" />
        <di:waypoint x="1450" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A4" bpmnElement="Flow_A4">
        <di:waypoint x="1380" y="525" />
        <di:waypoint x="1450" y="525" />
        <di:waypoint x="1450" y="465" />
      </bpmndi:BPMNEdge>
