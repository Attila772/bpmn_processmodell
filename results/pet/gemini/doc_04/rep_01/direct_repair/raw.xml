<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="definitions_IPO_Process"
             targetNamespace="http://www.example.org/bpmn">

  <collaboration id="collaboration_1">
    <participant id="participant_company" name="Company" processRef="process_company" />
    <participant id="participant_underwriters" name="Underwriters" processRef="process_underwriters" />
    <participant id="participant_sec" name="SEC" />
    
    <messageFlow id="msg_1" name="Underwriter Selection" sourceRef="task_select_underwriters" targetRef="start_underwriter_process" />
    <messageFlow id="msg_2" name="Registration Statement" sourceRef="task_prepare_reg_statement" targetRef="participant_sec" />
    <messageFlow id="msg_3" name="SEC Clearance" sourceRef="participant_sec" targetRef="event_sec_clearance_received" />
  </collaboration>

  <process id="process_company" isExecutable="false">
    <startEvent id="start_company" name="Decision to Go Public Made">
      <outgoing>seq_c1</outgoing>
    </startEvent>
    <task id="task_select_underwriters" name="Select Underwriters">
      <incoming>seq_c1</incoming>
      <outgoing>seq_c2</outgoing>
    </task>
    <endEvent id="end_company" name="Company Process Completed">
      <incoming>seq_c2</incoming>
    </endEvent>

    <sequenceFlow id="seq_c1" sourceRef="start_company" targetRef="task_select_underwriters" />
    <sequenceFlow id="seq_c2" sourceRef="task_select_underwriters" targetRef="end_company" />
  </process>

  <process id="process_underwriters" isExecutable="false">
    <startEvent id="start_underwriter_process" name="Engaged by Company">
      <outgoing>seq_u1</outgoing>
    </startEvent>

    <task id="task_provide_advice" name="Provide Procedural and Financial Advice">
      <incoming>seq_u1</incoming>
      <outgoing>seq_u2</outgoing>
    </task>

    <task id="task_assess_issue" name="Assess Issue Fairness &amp; Reputation Risk">
      <incoming>seq_u2</incoming>
      <outgoing>seq_u3</outgoing>
    </task>

    <exclusiveGateway id="gateway_reputation_check" name="Issue Facts Fairly Presented?">
      <incoming>seq_u3</incoming>
      <outgoing>seq_fair_yes</outgoing>
      <outgoing>seq_fair_no</outgoing>
    </exclusiveGateway>

    <endEvent id="end_rejected" name="Refuse to Handle Issue">
      <incoming>seq_fair_no</incoming>
    </endEvent>

    <parallelGateway id="gateway_prep_split" name="Split Preparation Work">
      <incoming>seq_fair_yes</incoming>
      <outgoing>seq_p1</outgoing>
      <outgoing>seq_p2</outgoing>
    </parallelGateway>

    <task id="task_prepare_reg_statement" name="Prepare and Submit SEC Registration Statement">
      <incoming>seq_p1</incoming>
      <outgoing>seq_p3</outgoing>
    </task>

    <task id="task_check_blue_sky" name="Check Compliance with State Blue-Sky Laws">
      <incoming>seq_p2</incoming>
      <outgoing>seq_p4</outgoing>
    </task>

    <parallelGateway id="gateway_prep_join" name="Join Preparation Work">
      <incoming>seq_p3</incoming>
      <incoming>seq_p4</incoming>
      <outgoing>seq_u4</outgoing>
    </parallelGateway>

    <parallelGateway id="gateway_approval_split" name="Split Approval Phase">
      <incoming>seq_u4</incoming>
      <outgoing>seq_a1</outgoing>
      <outgoing>seq_a2</outgoing>
    </parallelGateway>

    <intermediateCatchEvent id="event_sec_clearance_received" name="Receive SEC Clearance">
      <incoming>seq_a1</incoming>
      <outgoing>seq_a3</outgoing>
      <messageEventDefinition id="msg_def_sec" />
    </intermediateCatchEvent>

    <task id="task_firm_up_price" name="Firm Up Issue Price &amp; Arrange Road Show">
      <incoming>seq_a2</incoming>
      <outgoing>seq_a4</outgoing>
    </task>

    <parallelGateway id="gateway_approval_join" name="Join Approval Phase">
      <incoming>seq_a3</incoming>
      <incoming>seq_a4</incoming>
      <outgoing>seq_u5</outgoing>
    </parallelGateway>

    <task id="task_fix_issue_price" name="Fix Issue Price Immediately">
      <incoming>seq_u5</incoming>
      <outgoing>seq_u6</outgoing>
    </task>

    <exclusiveGateway id="gateway_final_review" name="Reason Not to Proceed Found?">
      <incoming>seq_u6</incoming>
      <outgoing>seq_proceed_yes</outgoing>
      <outgoing>seq_proceed_no</outgoing>
    </exclusiveGateway>

    <endEvent id="end_aborted" name="Abort Issue Handling">
      <incoming>seq_proceed_no</incoming>
    </endEvent>

    <task id="task_buy_stock" name="Enter Firm Commitment to Buy Stock">
      <incoming>seq_proceed_yes</incoming>
      <outgoing>seq_u7</outgoing>
    </task>

    <task id="task_resell_public" name="Offer and Resell Stock to Public">
      <incoming>seq_u7</incoming>
      <outgoing>seq_u8</outgoing>
    </task>

    <endEvent id="end_completed" name="Public Offering Completed">
      <incoming>seq_u8</incoming>
    </endEvent>

    <sequenceFlow id="seq_u1" sourceRef="start_underwriter_process" targetRef="task_provide_advice" />
    <sequenceFlow id="seq_u2" sourceRef="task_provide_advice" targetRef="task_assess_issue" />
    <sequenceFlow id="seq_u3" sourceRef="task_assess_issue" targetRef="gateway_reputation_check" />
    <sequenceFlow id="seq_fair_yes" name="Yes" sourceRef="gateway_reputation_check" targetRef="gateway_prep_split" />
    <sequenceFlow id="seq_fair_no" name="No" sourceRef="gateway_reputation_check" targetRef="end_rejected" />
    <sequenceFlow id="seq_p1" sourceRef="gateway_prep_split" targetRef="task_prepare_reg_statement" />
    <sequenceFlow id="seq_p2" sourceRef="gateway_prep_split" targetRef="task_check_blue_sky" />
    <sequenceFlow id="seq_p3" sourceRef="task_prepare_reg_statement" targetRef="gateway_prep_join" />
    <sequenceFlow id="seq_p4" sourceRef="task_check_blue_sky" targetRef="gateway_prep_join" />
    <sequenceFlow id="seq_u4" sourceRef="gateway_prep_join" targetRef="gateway_approval_split" />
    <sequenceFlow id="seq_a1" sourceRef="gateway_approval_split" targetRef="event_sec_clearance_received" />
    <sequenceFlow id="seq_a2" sourceRef="gateway_approval_split" targetRef="task_firm_up_price" />
    <sequenceFlow id="seq_a3" sourceRef="event_sec_clearance_received" targetRef="gateway_approval_join" />
    <sequenceFlow id="seq_a4" sourceRef="task_firm_up_price" targetRef="gateway_approval_join" />
    <sequenceFlow id="seq_u5" sourceRef="gateway_approval_join" targetRef="task_fix_issue_price" />
    <sequenceFlow id="seq_u6" sourceRef="task_fix_issue_price" targetRef="gateway_final_review" />
    <sequenceFlow id="seq_proceed_yes" name="No Reasons Found" sourceRef="gateway_final_review" targetRef="task_buy_stock" />
    <sequenceFlow id="seq_proceed_no" name="Reason Found" sourceRef="gateway_final_review" targetRef="end_aborted" />
    <sequenceFlow id="seq_u7" sourceRef="task_buy_stock" targetRef="task_resell_public" />
    <sequenceFlow id="seq_u8" sourceRef="task_resell_public" targetRef="end_completed" />
  </process>

