<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:process id="ClaimsNotificationProcess" name="Claims Notification Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim received">
      <bpmn:outgoing">SequenceFlow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckInsurance" name="Check if claimant is insured">
      <bpmn:incoming">SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_IsInsured" name="Claimant insured?">
      <bpmn:incoming">SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_NotInsured</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_Insured</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_InformRejection" name="Inform claimant that claim is rejected">
      <bpmn:incoming">SequenceFlow_NotInsured</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_03</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_ClaimRejected" name="Claim rejected">
      <bpmn:incoming">SequenceFlow_03</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_EvaluateSeverity" name="Evaluate severity of the claim">
      <bpmn:incoming">SequenceFlow_Insured</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ClaimSeverity" name="Claim severity?">
      <bpmn:incoming">SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Simple</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_Complex</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_SendSimpleForms" name="Send simple claim forms to claimant">
      <bpmn:incoming">SequenceFlow_Simple</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_05</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_SendComplexForms" name="Send complex claim forms to claimant">
      <bpmn:incoming">SequenceFlow_Complex</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_06</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:exclusiveGateway id="Gateway_FormsSent">
      <bpmn:incoming">SequenceFlow_05</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:receiveTask id="Task_ReceiveForms" name="Receive forms from claimant">
      <bpmn:incoming">SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_08</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:exclusiveGateway id="Gateway_MergeCheck">
      <bpmn:incoming">SequenceFlow_08</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CheckCompleteness" name="Check forms for completeness">
      <bpmn:incoming">SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_FormsComplete" name="Forms complete?">
      <bpmn:incoming">SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Complete</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_Incomplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_RegisterClaim" name="Register claim in Claims Management system">
      <bpmn:incoming">SequenceFlow_Complete</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ClaimRegistered" name="Claim registered">
      <bpmn:incoming">SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_InformUpdate" name="Inform claimant to update forms">
      <bpmn:incoming">SequenceFlow_Incomplete</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_13</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Task_ReceiveUpdatedForms" name="Receive updated forms">
      <bpmn:incoming">SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_12</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_ClaimReceived" targetRef="Task_CheckInsurance" />
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_CheckInsurance" targetRef="Gateway_IsInsured" />
    <bpmn:sequenceFlow id="SequenceFlow_NotInsured" name="No" sourceRef="Gateway_IsInsured" targetRef="Task_InformRejection" />
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_InformRejection" targetRef="EndEvent_ClaimRejected" />
    <bpmn:sequenceFlow id="SequenceFlow_Insured" name="Yes" sourceRef="Gateway_IsInsured" targetRef="Task_EvaluateSeverity" />
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_ClaimSeverity" />
    <bpmn:sequenceFlow id="SequenceFlow_Simple" name="Simple" sourceRef="Gateway_ClaimSeverity" targetRef="Task_SendSimpleForms" />
    <bpmn:sequenceFlow id="SequenceFlow_Complex" name="Complex" sourceRef="Gateway_ClaimSeverity" targetRef="Task_SendComplexForms" />
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_SendSimpleForms" targetRef="Gateway_FormsSent" />
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_SendComplexForms" targetRef="Gateway_FormsSent" />
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Gateway_FormsSent" targetRef="Task_ReceiveForms" />
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_ReceiveForms" targetRef="Gateway_MergeCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Gateway_MergeCheck" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_CheckCompleteness" targetRef="Gateway_FormsComplete" />
    <bpmn:sequenceFlow id="SequenceFlow_Complete" name="Yes" sourceRef="Gateway_FormsComplete" targetRef="Task_RegisterClaim" />
    <bpmn:sequenceFlow id="SequenceFlow_Incomplete" name="No" sourceRef="Gateway_FormsComplete" targetRef="Task_InformUpdate" />
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_RegisterClaim" targetRef="EndEvent_ClaimRegistered" />
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_InformUpdate" targetRef="Task_ReceiveUpdatedForms" />
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_ReceiveUpdatedForms" targetRef="Gateway_MergeCheck" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ClaimsNotificationProcess">
      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_ClaimReceived_di" bpmnElement="StartEvent_ClaimReceived">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="225" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Check Insurance -->
      <bpmndi:BPMNShape id="Task_CheckInsurance_di" bpmnElement="Task_CheckInsurance">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Is Insured -->
      <bpmndi:BPMNShape id="Gateway_IsInsured_di" bpmnElement="Gateway_IsInsured" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="376" y="145" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

