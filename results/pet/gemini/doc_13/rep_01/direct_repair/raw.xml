          <dc:Bounds x="645" y="125" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Evaluate Severity -->
      <bpmndi:BPMNShape id="Task_EvaluateSeverity_di" bpmnElement="Task_EvaluateSeverity">
        <dc:Bounds x="500" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Claim Severity -->
      <bpmndi:BPMNShape id="Gateway_ClaimSeverity_di" bpmnElement="Gateway_ClaimSeverity" isMarkerVisible="true">
        <dc:Bounds x="655" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="643" y="261" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Send Simple Forms -->
      <bpmndi:BPMNShape id="Task_SendSimpleForms_di" bpmnElement="Task_SendSimpleForms">
        <dc:Bounds x="760" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task Send Complex Forms -->
      <bpmndi:BPMNShape id="Task_SendComplexForms_di" bpmnElement="Task_SendComplexForms">
        <dc:Bounds x="760" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Forms Sent -->
      <bpmndi:BPMNShape id="Gateway_FormsSent_di" bpmnElement="Gateway_FormsSent" isMarkerVisible="true">
        <dc:Bounds x="915" y="285" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Task Receive Forms -->
      <bpmndi:BPMNShape id="Task_ReceiveForms_di" bpmnElement="Task_ReceiveForms">
        <dc:Bounds x="1010" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Merge Check -->
      <bpmndi:BPMNShape id="Gateway_MergeCheck_di" bpmnElement="Gateway_MergeCheck" isMarkerVisible="true">
        <dc:Bounds x="1165" y="285" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Task Check Completeness -->
      <bpmndi:BPMNShape id="Task_CheckCompleteness_di" bpmnElement="Task_CheckCompleteness">
        <dc:Bounds x="1260" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Forms Complete -->
      <bpmndi:BPMNShape id="Gateway_FormsComplete_di" bpmnElement="Gateway_FormsComplete" isMarkerVisible="true">
        <dc:Bounds x="1415" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1398" y="261" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Register Claim -->
      <bpmndi:BPMNShape id="Task_RegisterClaim_di" bpmnElement="Task_RegisterClaim">
        <dc:Bounds x="1520" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event Claim Registered -->
      <bpmndi:BPMNShape id="EndEvent_ClaimRegistered_di" bpmnElement="EndEvent_ClaimRegistered">
        <dc:Bounds x="1682" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1660" y="335" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Inform Update -->
      <bpmndi:BPMNShape id="Task_InformUpdate_di" bpmnElement="Task_InformUpdate">
        <dc:Bounds x="1520" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task Receive Updated Forms -->
      <bpmndi:BPMNShape id="Task_ReceiveUpdatedForms_di" bpmnElement="Task_ReceiveUpdatedForms">
        <dc:Bounds x="1340" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="SequenceFlow_01_di" bpmnElement="SequenceFlow_01">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_02_di" bpmnElement="SequenceFlow_02">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_NotInsured_di" bpmnElement="SequenceFlow_NotInsured">
        <di:waypoint x="420" y="175" />
        <di:waypoint x="420" y="100" />
        <di:waypoint x="500" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="135" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_03_di" bpmnElement="SequenceFlow_03">
        <di:waypoint x="600" y="100" />
        <di:waypoint x="662" y="100" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Insured_di" bpmnElement="SequenceFlow_Insured">
        <di:waypoint x="420" y="225" />
        <di:waypoint x="420" y="310" />
        <di:waypoint x="500" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="426" y="265" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_04_di" bpmnElement="SequenceFlow_04">
        <di:waypoint x="600" y="310" />
        <di:waypoint x="655" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Simple_di" bpmnElement="SequenceFlow_Simple">
        <di:waypoint x="680" y="285" />
        <di:waypoint x="680" y="240" />
        <di:waypoint x="760" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="693" y="220" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Complex_di" bpmnElement="SequenceFlow_Complex">
        <di:waypoint x="680" y="335" />
        <di:waypoint x="680" y="380" />
        <di:waypoint x="760" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="688" y="388" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_05_di" bpmnElement="SequenceFlow_05">
        <di:waypoint x="860" y="240" />
        <di:waypoint x="940" y="240" />
        <di:waypoint x="940" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_06_di" bpmnElement="SequenceFlow_06">
        <di:waypoint x="860" y="380" />
        <di:waypoint x="940" y="380" />
        <di:waypoint x="940" y="335" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_07_di" bpmnElement="SequenceFlow_07">
        <di:waypoint x="965" y="310" />
        <di:waypoint x="1010" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_08_di" bpmnElement="SequenceFlow_08">
        <di:waypoint x="1110" y="310" />
        <di:waypoint x="1165" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_09_di" bpmnElement="SequenceFlow_09">
        <di:waypoint x="1215" y="310" />
        <di:waypoint x="1260" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_10_di" bpmnElement="SequenceFlow_10">
        <di:waypoint x="1360" y="310" />
        <di:waypoint x="1415" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Complete_di" bpmnElement="SequenceFlow_Complete">
        <di:waypoint x="1465" y="310" />
        <di:waypoint x="1520" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1484" y="292" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_11_di" bpmnElement="SequenceFlow_11">
        <di:waypoint x="1620" y="310" />
        <di:waypoint x="1682" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Incomplete_di" bpmnElement="SequenceFlow_Incomplete">
        <di:waypoint x="1440" y="335" />
        <di:waypoint x="1440" y="440" />
        <di:waypoint x="1520" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1448" y="385" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_13_di" bpmnElement="SequenceFlow_13">
        <di:waypoint x="1520" y="440" />
        <di:waypoint x="1440" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_12_di" bpmnElement="SequenceFlow_12">
