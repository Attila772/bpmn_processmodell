<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:process id="ClaimsNotificationProcess" name="Claims Notification Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim Received">
      <bpmn:outgoing">SequenceFlow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckInsurance" name="Check Claimant Insurance Status">
      <bpmn:incoming">SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_IsInsured" name="Is Claimant Insured?">
      <bpmn:incoming">SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_InsuredNo</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_InsuredYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_InformRejection" name="Inform Claimant of Rejection">
      <bpmn:incoming">SequenceFlow_InsuredNo</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_03</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_ClaimRejected" name="Claim Rejected">
      <bpmn:incoming">SequenceFlow_03</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_EvaluateSeverity" name="Evaluate Claim Severity">
      <bpmn:incoming">SequenceFlow_InsuredYes</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ClaimSeverity" name="Claim Severity?">
      <bpmn:incoming">SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Simple</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_Complex</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_SendSimpleForms" name="Send Simple Claim Forms">
      <bpmn:incoming">SequenceFlow_Simple</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_05</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_SendComplexForms" name="Send Complex Claim Forms">
      <bpmn:incoming">SequenceFlow_Complex</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_06</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:exclusiveGateway id="Gateway_FormsSentMerge">
      <bpmn:incoming">SequenceFlow_05</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:receiveTask id="Task_ReceiveForms" name="Receive Completed Forms">
      <bpmn:incoming">SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_08</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:exclusiveGateway id="Gateway_LoopMerge">
      <bpmn:incoming">SequenceFlow_08</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_UpdatedReceived</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CheckCompleteness" name="Check Forms for Completeness">
      <bpmn:incoming">SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_AreFormsComplete" name="Are Forms Complete?">
      <bpmn:incoming">SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_FormsCompleteYes</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_FormsCompleteNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_RegisterClaim" name="Register Claim in Claims Management System">
      <bpmn:incoming">SequenceFlow_FormsCompleteYes</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:incoming">SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_InformUpdateRequired" name="Inform Claimant to Update Forms">
      <bpmn:incoming">SequenceFlow_FormsCompleteNo</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_12</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Task_ReceiveUpdatedForms" name="Receive Updated Forms">
      <bpmn:incoming">SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_UpdatedReceived</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_ClaimReceived" targetRef="Task_CheckInsurance" />
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_CheckInsurance" targetRef="Gateway_IsInsured" />
    <bpmn:sequenceFlow id="SequenceFlow_InsuredNo" name="No" sourceRef="Gateway_IsInsured" targetRef="Task_InformRejection" />
    <bpmn:sequenceFlow id="SequenceFlow_InsuredYes" name="Yes" sourceRef="Gateway_IsInsured" targetRef="Task_EvaluateSeverity" />
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_InformRejection" targetRef="EndEvent_ClaimRejected" />
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_ClaimSeverity" />
    <bpmn:sequenceFlow id="SequenceFlow_Simple" name="Simple" sourceRef="Gateway_ClaimSeverity" targetRef="Task_SendSimpleForms" />
    <bpmn:sequenceFlow id="SequenceFlow_Complex" name="Complex" sourceRef="Gateway_ClaimSeverity" targetRef="Task_SendComplexForms" />
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_SendSimpleForms" targetRef="Gateway_FormsSentMerge" />
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_SendComplexForms" targetRef="Gateway_FormsSentMerge" />
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Gateway_FormsSentMerge" targetRef="Task_ReceiveForms" />
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_ReceiveForms" targetRef="Gateway_LoopMerge" />
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Gateway_LoopMerge" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_CheckCompleteness" targetRef="Gateway_AreFormsComplete" />
    <bpmn:sequenceFlow id="SequenceFlow_FormsCompleteYes" name="Yes" sourceRef="Gateway_AreFormsComplete" targetRef="Task_RegisterClaim" />
    <bpmn:sequenceFlow id="SequenceFlow_FormsCompleteNo" name="No" sourceRef="Gateway_AreFormsComplete" targetRef="Task_InformUpdateRequired" />
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_RegisterClaim" targetRef="EndEvent_ClaimRegistered" />
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_InformUpdateRequired" targetRef="Task_ReceiveUpdatedForms" />
    <bpmn:sequenceFlow id="SequenceFlow_UpdatedReceived" sourceRef="Task_ReceiveUpdatedForms" targetRef="Gateway_LoopMerge" />
  </bpmn:process>

