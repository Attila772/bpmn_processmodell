<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_OfficeSupply"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:collaboration id="Collaboration_OfficeSupply">
    <bpmn:participant id="Participant_OfficeSupply" name="Office Supply Request Process" processRef="Process_OfficeSupply" />
  </bpmn:collaboration>

  <bpmn:process id="Process_OfficeSupply" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Employee" name="Employee / Petitioner">
        <bpmn:flowNodeRef>StartEvent_RequestSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewComments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReorderOrCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Immediate Supervisor">
        <bpmn:flowNodeRef>Task_ApproveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupervisorDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Purchasing" name="Purchase Department">
        <bpmn:flowNodeRef>SubProcess_MakeQuotations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VendorValid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateSendPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_WaitDeliveryAndInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Node Definitions -->
    <bpmn:startEvent id="StartEvent_RequestSubmitted" name="Office Supply Request Submitted">
      <bpmn:outgoing>Flow_StartToApprove</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ApproveRequest" name="Review and Decide Request">
      <bpmn:incoming>Flow_StartToApprove</bpmn:incoming>
      <bpmn:incoming>Flow_ResubmittedToApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SupervisorDecision" name="Supervisor Decision?">
      <bpmn:incoming>Flow_ApproveToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionToApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionToChange</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionToRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ReviewComments" name="Review Change Comments">
      <bpmn:incoming>Flow_DecisionToChange</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ReorderOrCancel" name="Update or Cancel?">
      <bpmn:incoming>Flow_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Resubmit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_RequestCancelled" name="Request Cancelled">
      <bpmn:incoming>Flow_Cancel</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:subProcess id="SubProcess_MakeQuotations" name="Make Quotations">
      <bpmn:incoming>Flow_DecisionToApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_QuotationsToSelectVendor</bpmn:outgoing>
      
      <bpmn:startEvent id="SubStart_1" name="Start Quotations">
        <bpmn:outgoing>SubFlow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="SubTask_RequestQuotes" name="Request Vendor Quotations">
        <bpmn:incoming>SubFlow_1</bpmn:incoming>
        <bpmn:outgoing>SubFlow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SubTask_CompareQuotes" name="Compare Quotations">
        <bpmn:incoming>SubFlow_2</bpmn:incoming>
        <bpmn:outgoing>SubFlow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SubEnd_1" name="Quotations Completed">
        <bpmn:incoming>SubFlow_3</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="SubFlow_1" sourceRef="SubStart_1" targetRef="SubTask_RequestQuotes" />
      <bpmn:sequenceFlow id="SubFlow_2" sourceRef="SubTask_RequestQuotes" targetRef="SubTask_CompareQuotes" />
      <bpmn:sequenceFlow id="SubFlow_3" sourceRef="SubTask_CompareQuotes" targetRef="SubEnd_1" />
    </bpmn:subProcess>

    <bpmn:userTask id="Task_SelectVendor" name="Select Vendor">
      <bpmn:incoming>Flow_QuotationsToSelectVendor</bpmn:incoming>
      <bpmn:incoming>Flow_VendorInvalidToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectToVendorGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_VendorValid" name="Is Vendor Valid?">
      <bpmn:incoming>Flow_SelectToVendorGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_VendorValidToPO</bpmn:outgoing>
      <bpmn:outgoing>Flow_VendorInvalidToSelect</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_GenerateSendPO" name="Generate and Send Purchase Order">
      <bpmn:incoming>Flow_VendorValidToPO</bpmn:incoming>
      <bpmn:outgoing>Flow_POToWait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="Event_WaitDeliveryAndInvoice" name="Wait for Delivery and Invoice">
      <bpmn:incoming>Flow_POToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitToNotify</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_SendNotification" name="Send Result Notification to User">
      <bpmn:incoming>Flow_WaitToNotify</bpmn:incoming>
      <bpmn:incoming>Flow_DecisionToRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_FinalOutcome" name="Final Result?">
      <bpmn:incoming>Flow_NotifyToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalToCompleted</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinalToRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Request Fulfilled">
      <bpmn:incoming>Flow_FinalToCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_RequestRejected" name="Request Rejected">
      <bpmn:incoming>Flow_FinalToRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToApprove" sourceRef="StartEvent_RequestSubmitted" targetRef="Task_ApproveRequest" />
    <bpmn:sequenceFlow id="Flow_ApproveToGateway" sourceRef="Task_ApproveRequest" targetRef="Gateway_SupervisorDecision" />
    
    <bpmn:sequenceFlow id="Flow_DecisionToApproved" name="Approved" sourceRef="Gateway_SupervisorDecision" targetRef="SubProcess_MakeQuotations" />
    <bpmn:sequenceFlow id="Flow_DecisionToChange" name="Change Required" sourceRef="Gateway_SupervisorDecision" targetRef="Task_ReviewComments" />
    <bpmn:sequenceFlow id="Flow_DecisionToRejected" name="Rejected" sourceRef="Gateway_SupervisorDecision" targetRef="Task_SendNotification" />

    <bpmn:sequenceFlow id="Flow_ReviewToGateway" sourceRef="Task_ReviewComments" targetRef="Gateway_ReorderOrCancel" />
    <bpmn:sequenceFlow id="Flow_Resubmit" name="Resubmit Request" sourceRef="Gateway_ReorderOrCancel" targetRef="Task_ApproveRequest" />
    <bpmn:sequenceFlow id="Flow_Cancel" name="Cancel Request" sourceRef="Gateway_ReorderOrCancel" targetRef="EndEvent_RequestCancelled" />

    <bpmn:sequenceFlow id="Flow_QuotationsToSelectVendor" sourceRef="SubProcess_MakeQuotations" targetRef="Task_SelectVendor" />
    <bpmn:sequenceFlow id="Flow_SelectToVendorGateway" sourceRef="Task_SelectVendor" targetRef="Gateway_VendorValid" />
    <bpmn:sequenceFlow id="Flow_VendorValidToPO" name="Yes" sourceRef="Gateway_VendorValid" targetRef="Task_GenerateSendPO" />
    <bpmn:sequenceFlow id="Flow_VendorInvalidToSelect" name="No (Choose Different)" sourceRef="Gateway_VendorValid" targetRef="Task_SelectVendor" />

    <bpmn:sequenceFlow id="Flow_POToWait" sourceRef="Task_GenerateSendPO" targetRef="Event_WaitDeliveryAndInvoice" />
    <bpmn:sequenceFlow id="Flow_WaitToNotify" sourceRef="Event_WaitDeliveryAndInvoice" targetRef="Task_SendNotification" />
    <bpmn:sequenceFlow id="Flow_NotifyToGateway" sourceRef="Task_SendNotification" targetRef="Gateway_FinalOutcome" />
    <bpmn:sequenceFlow id="Flow_FinalToCompleted" name="Fulfilled" sourceRef="Gateway_FinalOutcome" targetRef="EndEvent_ProcessCompleted" />
    <bpmn:sequenceFlow id="Flow_FinalToRejected" name="Rejected" sourceRef="Gateway_FinalOutcome" targetRef="EndEvent_RequestRejected" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_OfficeSupply">
      <bpmndi:BPMNShape id="Participant_OfficeSupply_di" bpmnElement="Participant_OfficeSupply" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1480" height="730" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1450" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1450" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Purchasing_di" bpmnElement="Lane_Purchasing" isHorizontal="true">
        <dc:Bounds x="190" y="410" width="1450" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="620" width="1450" height="190" />
      </bpmndi:BPMNShape>

      <!-- Nodes & DI -->
      <!-- Employee Lane -->
      <bpmndi:BPMNShape id="StartEvent_RequestSubmitted_di" bpmnElement="StartEvent_RequestSubmitted">
        <dc:Bounds x="242" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="218" y="195" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewComments_di" bpmnElement="Task_ReviewComments">
        <dc:Bounds x="470" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ReorderOrCancel_di" bpmnElement="Gateway_ReorderOrCancel" isMarkerVisible="true">
        <dc:Bounds x="615" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="596" y="115" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_RequestCancelled_di" bpmnElement="EndEvent_RequestCancelled">
        <dc:Bounds x="722" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="716" y="195" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Supervisor Lane -->
      <bpmndi:BPMNShape id="Task_ApproveRequest_di" bpmnElement="Task_ApproveRequest">
        <dc:Bounds x="320" y="295" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_SupervisorDecision_di" bpmnElement="Gateway_SupervisorDecision" isMarkerVisible="true">
        <dc:Bounds x="495" y="310" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="432" y="348" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Purchasing Lane -->
      <bpmndi:BPMNShape id="SubProcess_MakeQuotations_di" bpmnElement="SubProcess_MakeQuotations" isExpanded="false">
        <dc:Bounds x="610" y="470" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SelectVendor_di" bpmnElement="Task_SelectVendor">
        <dc:Bounds x="780" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_VendorValid_di" bpmnElement="Gateway_VendorValid" isMarkerVisible="true">
        <dc:Bounds x="935" y="485" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="921" y="461" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- System Lane -->
      <bpmndi:BPMNShape id="Task_GenerateSendPO_di" bpmnElement="Task_GenerateSendPO">
        <dc:Bounds x="1040" y="670" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_WaitDeliveryAndInvoice_di" bpmnElement="Event_WaitDeliveryAndInvoice">
        <dc:Bounds x="1192" y="692" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1170" y="735" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendNotification_di" bpmnElement="Task_SendNotification">
        <dc:Bounds x="1280" y="670" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_FinalOutcome_di" bpmnElement="Gateway_FinalOutcome" isMarkerVisible="true">
        <dc:Bounds x="1425" y="685" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1418" y="661" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ProcessCompleted_di" bpmnElement="EndEvent_ProcessCompleted">
        <dc:Bounds x="1532" y="642" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1509" y="685" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_RequestRejected_di" bpmnElement="EndEvent_RequestRejected">
        <dc:Bounds x="1532" y="732" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1507" y="775" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Flow Connectors -->
      <bpmndi:BPMNEdge id="Flow_StartToApprove_di" bpmnElement="Flow_StartToApprove">
        <di:waypoint x="278" y="170" />
        <di:waypoint x="299" y="170" />
        <di:waypoint x="299" y="335" />
        <di:waypoint x="320" y="335" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ApproveToGateway_di" bpmnElement="Flow_ApproveToGateway">
        <di:waypoint x="420" y="335" />
        <di:waypoint x="495" y="335" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_DecisionToApproved_di" bpmnElement="Flow_DecisionToApproved">
        <di:waypoint x="520" y="360" />
        <di:waypoint x="520" y="510" />
        <di:waypoint x="610" y="510" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="527" y="433" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_DecisionToChange_di" bpmnElement="Flow_DecisionToChange">
        <di:waypoint x="520" y="310" />
        <di:waypoint x="520" y="210" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="526" y="253" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_DecisionToRejected_di" bpmnElement="Flow_DecisionToRejected">
        <di:waypoint x="545" y="335" />
        <di:waypoint x="1330" y="335" />
        <di:waypoint x="1330" y="670" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="916" y="317" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ReviewToGateway_di" bpmnElement="Flow_ReviewToGateway">
        <di:waypoint x="570" y="170" />
        <di:waypoint x="615" y="170" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Resubmit_di" bpmnElement="Flow_Resubmit">
        <di:waypoint x="640" y="145" />
        <di:waypoint x="640" y="100" />
        <di:waypoint x="370" y="100" />
        <di:waypoint x="370" y="295" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="82" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Cancel_di" bpmnElement="Flow_Cancel">
        <di:waypoint x="665" y="170" />
        <di:waypoint x="722" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="655" y="152" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_QuotationsToSelectVendor_di" bpmnElement="Flow_QuotationsToSelectVendor">
        <di:waypoint x="730" y="510" />
        <di:waypoint x="780" y="510" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_SelectToVendorGateway_di" bpmnElement="Flow_SelectToVendorGateway">
        <di:waypoint x="880" y="510" />
        <di:waypoint x="935" y="510" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_VendorValidToPO_di" bpmnElement="Flow_VendorValidToPO">
        <di:waypoint x="960" y="535" />
        <di:waypoint x="960" y="710" />
        <di:waypoint x="1040" y="710" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="966" y="620" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_VendorInvalidToSelect_di" bpmnElement="Flow_VendorInvalidToSelect">
        <di:waypoint x="960" y="485" />
        <di:waypoint x="960" y="430" />
        <di:waypoint x="830" y="430" />
        <di:waypoint x="830" y="470" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="862" y="412" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_POToWait_di" bpmnElement="Flow_POToWait">
        <di:waypoint x="1140" y="710" />
        <di:waypoint x="1192" y="710" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_WaitToNotify_di" bpmnElement="Flow_WaitToNotify">
        <di:waypoint x="1228" y="710" />
        <di:waypoint x="1280" y="710" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_NotifyToGateway_di" bpmnElement="Flow_NotifyToGateway">
        <di:waypoint x="1380" y="710" />
        <di:waypoint x="1425" y="710" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_FinalToCompleted_di" bpmnElement="Flow_FinalToCompleted">
        <di:waypoint x="1450" y="685" />
        <di:waypoint x="1450" y="660" />
        <di:waypoint x="1532" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1460" y="643" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_FinalToRejected_di" bpmnElement="Flow_FinalToRejected">
        <di:waypoint x="1450" y="735" />
        <di:waypoint x="1450" y="750" />
        <di:waypoint x="1532" y="750" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1458" y="758" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
