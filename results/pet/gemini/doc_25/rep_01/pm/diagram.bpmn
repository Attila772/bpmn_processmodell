<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_obj_request" name="Office Supply Request" dataObjectRef="data_obj_request_do" />
    <bpmn:dataObject id="data_obj_request_do" />
    <bpmn:dataObjectReference id="data_obj_vendor_selection" name="Vendor Selection &amp; Quotation" dataObjectRef="data_obj_vendor_selection_do" />
    <bpmn:dataObject id="data_obj_vendor_selection_do" />
    <bpmn:dataStoreReference id="data_store_system" name="System Database" />
    <bpmn:dataObjectReference id="data_obj_po" name="Purchase Order" dataObjectRef="data_obj_po_do" />
    <bpmn:dataObject id="data_obj_po_do" />
    <bpmn:dataObjectReference id="data_obj_invoice" name="Invoice" dataObjectRef="data_obj_invoice_do" />
    <bpmn:dataObject id="data_obj_invoice_do" />
    <bpmn:startEvent id="start_event_1" name="Office supply request submitted">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_rejected" name="Process ended (Rejected)">
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_completed" name="Process completed">
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_submit_request" name="Submit office supply request">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_submit_request_doa0">
        <bpmn:targetRef>data_obj_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_evaluate_request" name="Evaluate request">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_evaluate_request_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_evaluate_request_dia0">
        <bpmn:sourceRef>data_obj_request</bpmn:sourceRef>
        <bpmn:targetRef>task_evaluate_request_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_review_comments" name="Review comments for change request">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_review_comments_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_comments_dia0">
        <bpmn:sourceRef>data_obj_request</bpmn:sourceRef>
        <bpmn:targetRef>task_review_comments_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_review_comments_doa0">
        <bpmn:targetRef>data_obj_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_make_quotations" name="Make quotations and select a vendor">
      <bpmn:incoming>flow_dec_approval</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:property id="task_make_quotations_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_make_quotations_dia0">
        <bpmn:sourceRef>data_obj_request</bpmn:sourceRef>
        <bpmn:targetRef>task_make_quotations_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_make_quotations_doa0">
        <bpmn:targetRef>data_obj_vendor_selection</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_choose_different_vendor" name="Choose a different vendor">
      <bpmn:incoming>flow_vendor_invalid</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:property id="task_choose_different_vendor_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_choose_different_vendor_dia0">
        <bpmn:sourceRef>data_store_system</bpmn:sourceRef>
        <bpmn:targetRef>task_choose_different_vendor_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_choose_different_vendor_doa0">
        <bpmn:targetRef>data_obj_vendor_selection</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_generate_send_po" name="Generate and send purchase order">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:property id="task_generate_send_po_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_generate_send_po_dia0">
        <bpmn:sourceRef>data_obj_vendor_selection</bpmn:sourceRef>
        <bpmn:targetRef>task_generate_send_po_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_generate_send_po_doa0">
        <bpmn:targetRef>data_obj_po</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="task_wait_delivery_invoice" name="Wait for product delivery and invoice">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_wait_delivery_invoice_doa0">
        <bpmn:targetRef>data_obj_invoice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:serviceTask id="task_notify_rejection" name="Send notification of rejection">
      <bpmn:incoming>flow_dec_rejection</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_notify_change_required" name="Send notification of change required">
      <bpmn:incoming>flow_dec_change</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_notify_approval" name="Send notification of result">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_supervisor_decision" name="Supervisor Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_dec_rejection</bpmn:outgoing>
      <bpmn:outgoing>flow_dec_change</bpmn:outgoing>
      <bpmn:outgoing>flow_dec_approval</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_vendor_valid" name="Is vendor valid in system?" isMarkerVisible="true">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_vendor_invalid</bpmn:outgoing>
      <bpmn:outgoing>flow_vendor_valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_merge_vendor" name="Merge Vendor Selection" isMarkerVisible="true">
      <bpmn:incoming>flow_vendor_valid</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_event_1" targetRef="task_submit_request" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_submit_request" targetRef="task_evaluate_request" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_evaluate_request" targetRef="gateway_supervisor_decision" />
    <bpmn:sequenceFlow id="flow_dec_rejection" sourceRef="gateway_supervisor_decision" targetRef="task_notify_rejection" name="Rejected" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_notify_rejection" targetRef="end_event_rejected" />
    <bpmn:sequenceFlow id="flow_dec_change" sourceRef="gateway_supervisor_decision" targetRef="task_notify_change_required" name="Ask for a change" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_notify_change_required" targetRef="task_review_comments" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_review_comments" targetRef="task_evaluate_request" />
    <bpmn:sequenceFlow id="flow_dec_approval" sourceRef="gateway_supervisor_decision" targetRef="task_make_quotations" name="Approved" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_make_quotations" targetRef="gateway_vendor_valid" />
    <bpmn:sequenceFlow id="flow_vendor_invalid" sourceRef="gateway_vendor_valid" targetRef="task_choose_different_vendor" name="No" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_choose_different_vendor" targetRef="gateway_vendor_valid" />
    <bpmn:sequenceFlow id="flow_vendor_valid" sourceRef="gateway_vendor_valid" targetRef="gateway_merge_vendor" name="Yes" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="gateway_merge_vendor" targetRef="task_generate_send_po" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_generate_send_po" targetRef="task_wait_delivery_invoice" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_wait_delivery_invoice" targetRef="task_notify_approval" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="task_notify_approval" targetRef="end_event_completed" />
  </bpmn:process>
