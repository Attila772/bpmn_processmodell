<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="evt_start" name="Service degradation perceived">
      <bpmn:outgoing>seq_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end" name="Process finished">
      <bpmn:incoming>seq_flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="task_send_problem_list" name="Send problem parameters list to Customer Service">
      <bpmn:incoming>seq_flow_1</bpmn:incoming>
      <bpmn:outgoing>seq_flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="task_enter_problem_report" name="Enter problem report into system T">
      <bpmn:incoming>seq_flow_2</bpmn:incoming>
      <bpmn:outgoing>seq_flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="seq_flow_1" sourceRef="evt_start" targetRef="task_send_problem_list" />
    <bpmn:sequenceFlow id="seq_flow_2" sourceRef="task_send_problem_list" targetRef="task_enter_problem_report" />
    <bpmn:sequenceFlow id="seq_flow_3" sourceRef="task_enter_problem_report" targetRef="evt_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_di" bpmnElement="evt_end">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_di" bpmnElement="evt_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_enter_problem_report_di" bpmnElement="task_enter_problem_report">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_problem_list_di" bpmnElement="task_send_problem_list">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="seq_flow_1_di" bpmnElement="seq_flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_2_di" bpmnElement="seq_flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_3_di" bpmnElement="seq_flow_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>