<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_InvoiceProcessing"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- COLLABORATION -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_GO" name="Grid Operator (GO)" processRef="Process_GO" />
    <bpmn:participant id="Participant_MPON" name="New Metering Point Operator (MPON)" processRef="Process_MPON" />
    <bpmn:participant id="Participant_MPOO" name="Old Metering Point Operator (MPOO)" />
    <bpmn:participant id="Participant_MSPO" name="Metering Service Provider Old (MSPO)" />

    <!-- MESSAGE FLOWS -->
    <bpmn:messageFlow id="MF_MPOO_Bill1_GO" name="Bill: Continuation of Metering Point Ops" sourceRef="Participant_MPOO" targetRef="Start_Bill1_GO" />
    <bpmn:messageFlow id="MF_MSPO_Bill2_GO" name="Bill: Continuation of Measurement" sourceRef="Participant_MSPO" targetRef="Start_Bill2_GO" />
    <bpmn:messageFlow id="MF_MSPO_Bill3_GO" name="Bill: Additional Readings" sourceRef="Participant_MSPO" targetRef="Start_Bill3_GO" />
    <bpmn:messageFlow id="MF_MPOO_Bill4_GO" name="Bill: Equipment Acquisition" sourceRef="Participant_MPOO" targetRef="Start_Bill4_GO" />
    <bpmn:messageFlow id="MF_MPOO_Bill4_MPON" name="Bill: Equipment Acquisition" sourceRef="Participant_MPOO" targetRef="Start_Bill4_MPON" />

    <bpmn:messageFlow id="MF_GO_PaymentAdvice" name="Payment Advice / Confirmation" sourceRef="Task_GO_SendPaymentAdvice" targetRef="Participant_MPOO" />
    <bpmn:messageFlow id="MF_GO_Rejection" name="Invoice Rejection" sourceRef="Task_GO_SendRejection" targetRef="Participant_MPOO" />
    <bpmn:messageFlow id="MF_MPON_PaymentAdvice" name="Payment Advice / Confirmation" sourceRef="Task_MPON_SendPaymentAdvice" targetRef="Participant_MPOO" />
    <bpmn:messageFlow id="MF_MPON_Rejection" name="Invoice Rejection" sourceRef="Task_MPON_SendRejection" targetRef="Participant_MPOO" />
  </bpmn:collaboration>

  <!-- PROCESS: GO -->
  <bpmn:process id="Process_GO" name="Grid Operator Invoice Handling" isExecutable="false">
    <!-- Start Events -->
    <bpmn:startEvent id="Start_Bill1_GO" name="Bill for Continuation of MPO Received">
      <bpmn:outgoing>Flow_GO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_GO_1" />
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Bill2_GO" name="Bill for Continuation of Measurement Received">
      <bpmn:outgoing>Flow_GO_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_GO_2" />
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Bill3_GO" name="Bill for Additional Readings Received">
      <bpmn:outgoing>Flow_GO_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_GO_3" />
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Bill4_GO" name="Bill for Equipment Acquisition Received">
      <bpmn:outgoing>Flow_GO_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_GO_4" />
    </bpmn:startEvent>

    <!-- Gateway Merging Invoice Trigger Sources -->
    <bpmn:exclusiveGateway id="Gateway_GO_MergeIncoming" name="Merge Incoming Bills">
      <bpmn:incoming">Flow_GO_1</bpmn:incoming>
      <bpmn:incoming">Flow_GO_2</bpmn:incoming>
      <bpmn:incoming">Flow_GO_3</bpmn:incoming>
      <bpmn:incoming">Flow_GO_4</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_ToExamine</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Examine Bill -->
    <bpmn:task id="Task_GO_ExamineBill" name="Examine Bill">
      <bpmn:incoming">Flow_GO_ToExamine</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_ToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_GO_Decision" name="Is Bill Accepted?">
      <bpmn:incoming">Flow_GO_ToDecision</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_Accepted</bpmn:outgoing>
      <bpmn:outgoing">Flow_GO_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Response Tasks -->
    <bpmn:task id="Task_GO_SendPaymentAdvice" name="Confirm Invoice with Payment Advice">
      <bpmn:incoming">Flow_GO_Accepted</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_End1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GO_SendRejection" name="Reject Invoice">
      <bpmn:incoming">Flow_GO_Rejected</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_End2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_GO_Confirmed" name="Invoice Confirmed">
      <bpmn:incoming">Flow_GO_End1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_GO_Rejected" name="Invoice Rejected">
      <bpmn:incoming">Flow_GO_End2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows GO -->
    <bpmn:sequenceFlow id="Flow_GO_1" sourceRef="Start_Bill1_GO" targetRef="Gateway_GO_MergeIncoming" />
    <bpmn:sequenceFlow id="Flow_GO_2" sourceRef="Start_Bill2_GO" targetRef="Gateway_GO_MergeIncoming" />
    <bpmn:sequenceFlow id="Flow_GO_3" sourceRef="Start_Bill3_GO" targetRef="Gateway_GO_MergeIncoming" />
    <bpmn:sequenceFlow id="Flow_GO_4" sourceRef="Start_Bill4_GO" targetRef="Gateway_GO_MergeIncoming" />
    <bpmn:sequenceFlow id="Flow_GO_ToExamine" sourceRef="Gateway_GO_MergeIncoming" targetRef="Task_GO_ExamineBill" />
    <bpmn:sequenceFlow id="Flow_GO_ToDecision" sourceRef="Task_GO_ExamineBill" targetRef="Gateway_GO_Decision" />
    <bpmn:sequenceFlow id="Flow_GO_Accepted" name="Accepted" sourceRef="Gateway_GO_Decision" targetRef="Task_GO_SendPaymentAdvice" />
    <bpmn:sequenceFlow id="Flow_GO_Rejected" name="Rejected" sourceRef="Gateway_GO_Decision" targetRef="Task_GO_SendRejection" />
    <bpmn:sequenceFlow id="Flow_GO_End1" sourceRef="Task_GO_SendPaymentAdvice" targetRef="End_GO_Confirmed" />
    <bpmn:sequenceFlow id="Flow_GO_End2" sourceRef="Task_GO_SendRejection" targetRef="End_GO_Rejected" />
  </bpmn:process>

  <!-- PROCESS: MPON -->
  <bpmn:process id="Process_MPON" name="MPON Invoice Handling" isExecutable="false">
    <bpmn:startEvent id="Start_Bill4_MPON" name="Bill for Equipment Acquisition Received">
      <bpmn:outgoing">Flow_MPON_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_MPON_1" />
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_ExamineBill" name="Examine Bill">
      <bpmn:incoming">Flow_MPON_1</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_ToDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MPON_Decision" name="Is Bill Accepted?">
      <bpmn:incoming">Flow_MPON_ToDecision</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_Accepted</bpmn:outgoing>
      <bpmn:outgoing">Flow_MPON_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_MPON_SendPaymentAdvice" name="Confirm Invoice with Payment Advice">
      <bpmn:incoming">Flow_MPON_Accepted</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_End1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MPON_SendRejection" name="Reject Invoice">
      <bpmn:incoming">Flow_MPON_Rejected</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_End2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_MPON_Confirmed" name="Invoice Confirmed">
      <bpmn:incoming">Flow_MPON_End1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_MPON_Rejected" name="Invoice Rejected">
      <bpmn:incoming">Flow_MPON_End2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows MPON -->
    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="Start_Bill4_MPON" targetRef="Task_MPON_ExamineBill" />
    <bpmn:sequenceFlow id="Flow_MPON_ToDecision" sourceRef="Task_MPON_ExamineBill" targetRef="Gateway_MPON_Decision" />
    <bpmn:sequenceFlow id="Flow_MPON_Accepted" name="Accepted" sourceRef="Gateway_MPON_Decision" targetRef="Task_MPON_SendPaymentAdvice" />
    <bpmn:sequenceFlow id="Flow_MPON_Rejected" name="Rejected" sourceRef="Gateway_MPON_Decision" targetRef="Task_MPON_SendRejection" />
    <bpmn:sequenceFlow id="Flow_MPON_End1" sourceRef="Task_MPON_SendPaymentAdvice" targetRef="End_MPON_Confirmed" />
    <bpmn:sequenceFlow id="Flow_MPON_End2" sourceRef="Task_MPON_SendRejection" targetRef="End_MPON_Rejected" />
  </bpmn:process>

