    <bpmn:messageFlow id="mf_mpoo_equip_go" sourceRef="mpoo_send_bill_equip_go_end" targetRef="go_start_bill_equip" name="Bill for equipment acquisition" />
    <bpmn:messageFlow id="mf_mpoo_equip_mpon" sourceRef="mpoo_send_bill_equip_mpon_end" targetRef="mpon_start_bill_equip" name="Bill for equipment acquisition" />
