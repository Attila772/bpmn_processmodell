      <bpmn:outgoing>sf_go_merge_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t_go_reject_invoice_doa0">
        <bpmn:targetRef>doc_response_p2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_go_incoming" name="Merge incoming bills" isMarkerVisible="true">
      <bpmn:incoming>sf_go_in_1</bpmn:incoming>
      <bpmn:incoming>sf_go_in_2</bpmn:incoming>
      <bpmn:incoming>sf_go_in_3</bpmn:incoming>
