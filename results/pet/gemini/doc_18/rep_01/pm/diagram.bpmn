    <bpmn:sequenceFlow id="sf_go_in_1" sourceRef="go_start_bill_mpo" targetRef="gw_go_incoming" />
    <bpmn:sequenceFlow id="sf_go_in_2" sourceRef="go_start_bill_meas" targetRef="gw_go_incoming" />
