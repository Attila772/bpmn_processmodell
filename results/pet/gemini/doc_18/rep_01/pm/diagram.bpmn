    <bpmn:sequenceFlow id="sf_go_merge_2" sourceRef="t_go_reject_invoice" targetRef="gw_go_merge_resp" />
    <bpmn:sequenceFlow id="sf_go_end" sourceRef="gw_go_merge_resp" targetRef="go_send_response_end" />
  </bpmn:process>
