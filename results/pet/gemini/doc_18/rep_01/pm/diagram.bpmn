    <bpmn:sequenceFlow id="sf_mpoo_start" sourceRef="mpoo_start" targetRef="gw_mpoo_type" />
    <bpmn:sequenceFlow id="sf_mpoo_1" sourceRef="gw_mpoo_type" targetRef="t_mpoo_send_bill_mpo" name="temporary continuation of metering point operations" />
    <bpmn:sequenceFlow id="sf_mpoo_2" sourceRef="gw_mpoo_type" targetRef="t_mpoo_send_bill_equip_go" name="equipment acquisition to GO" />
    <bpmn:sequenceFlow id="sf_mpoo_3" sourceRef="gw_mpoo_type" targetRef="t_mpoo_send_bill_equip_mpon" name="equipment acquisition to MPON" />
