      <bpmn:incoming>flow_mspo_meas</bpmn:incoming>
      <bpmn:outgoing>flow_mspo_meas_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mspo_send_meas_bill_doa0">
