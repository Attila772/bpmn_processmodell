      <bpmn:outgoing>flow_go_in4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_bill_mpoo_equip_received_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="event_go_response_sent" name="Payment advice or rejection sent by GO">
      <bpmn:incoming>flow_go_outcome_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_go_response_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_go_examine_bill" name="Examine bill">
      <bpmn:incoming>flow_go_examine</bpmn:incoming>
      <bpmn:outgoing>flow_go_decide</bpmn:outgoing>
      <bpmn:property id="task_go_examine_bill_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_go_examine_bill_dia0">
        <bpmn:sourceRef>data_bill_ops_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_go_examine_bill_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_go_examine_bill_dia1">
        <bpmn:sourceRef>data_bill_meas_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_go_examine_bill_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_go_examine_bill_dia2">
        <bpmn:sourceRef>data_bill_read_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_go_examine_bill_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_go_examine_bill_dia3">
        <bpmn:sourceRef>data_bill_equip_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_go_examine_bill_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_go_confirm_invoice" name="Confirm invoice with payment advice">
      <bpmn:incoming>flow_go_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_go_confirm_join</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_go_confirm_invoice_doa0">
        <bpmn:targetRef>data_payment_advice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_go_reject_invoice" name="Reject invoice">
      <bpmn:incoming>flow_go_reject</bpmn:incoming>
      <bpmn:outgoing>flow_go_reject_join</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_go_reject_invoice_doa0">
        <bpmn:targetRef>data_rejection_notice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_go_incoming" name="Incoming Bill" isMarkerVisible="true">
      <bpmn:incoming>flow_go_in1</bpmn:incoming>
      <bpmn:incoming>flow_go_in2</bpmn:incoming>
      <bpmn:incoming>flow_go_in3</bpmn:incoming>
      <bpmn:incoming>flow_go_in4</bpmn:incoming>
      <bpmn:outgoing>flow_go_examine</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_go_decision" name="Invoice Decision?" isMarkerVisible="true">
      <bpmn:incoming>flow_go_decide</bpmn:incoming>
      <bpmn:outgoing>flow_go_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_go_reject</bpmn:outgoing>
