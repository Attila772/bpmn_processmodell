    <bpmn:dataObject id="data_payment_advice_do" />
    <bpmn:dataObjectReference id="data_rejection_notice" name="Invoice rejection" dataObjectRef="data_rejection_notice_do" />
    <bpmn:dataObject id="data_rejection_notice_do" />
    <bpmn:startEvent id="event_bill_mpoo_ops_received" name="Bill for temporary continuation of metering point operations received">
      <bpmn:outgoing>flow_go_in1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_bill_mpoo_ops_received_msgdef" />
