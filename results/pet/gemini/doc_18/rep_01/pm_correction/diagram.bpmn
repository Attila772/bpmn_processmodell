    <bpmn:exclusiveGateway id="gw_go_outcome_join" name="Outcome Join" isMarkerVisible="true">
      <bpmn:incoming>flow_go_confirm_join</bpmn:incoming>
      <bpmn:incoming>flow_go_reject_join</bpmn:incoming>
      <bpmn:outgoing>flow_go_outcome_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_go_in1" sourceRef="event_bill_mpoo_ops_received" targetRef="gw_go_incoming" />
    <bpmn:sequenceFlow id="flow_go_in2" sourceRef="event_bill_mspo_meas_received" targetRef="gw_go_incoming" />
    <bpmn:sequenceFlow id="flow_go_in3" sourceRef="event_bill_mspo_read_received" targetRef="gw_go_incoming" />
    <bpmn:sequenceFlow id="flow_go_in4" sourceRef="event_bill_mpoo_equip_received_go" targetRef="gw_go_incoming" />
    <bpmn:sequenceFlow id="flow_go_examine" sourceRef="gw_go_incoming" targetRef="task_go_examine_bill" />
    <bpmn:sequenceFlow id="flow_go_decide" sourceRef="task_go_examine_bill" targetRef="gw_go_decision" />
    <bpmn:sequenceFlow id="flow_go_confirm" sourceRef="gw_go_decision" targetRef="task_go_confirm_invoice" name="Confirm invoice" />
    <bpmn:sequenceFlow id="flow_go_reject" sourceRef="gw_go_decision" targetRef="task_go_reject_invoice" name="Reject invoice" />
    <bpmn:sequenceFlow id="flow_go_confirm_join" sourceRef="task_go_confirm_invoice" targetRef="gw_go_outcome_join" />
    <bpmn:sequenceFlow id="flow_go_reject_join" sourceRef="task_go_reject_invoice" targetRef="gw_go_outcome_join" />
    <bpmn:sequenceFlow id="flow_go_outcome_end" sourceRef="gw_go_outcome_join" targetRef="event_go_response_sent" />
  </bpmn:process>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
