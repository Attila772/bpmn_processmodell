    <bpmn:startEvent id="event_bill_mspo_read_received" name="Bill for additional readings received">
      <bpmn:outgoing>flow_go_in3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_bill_mspo_read_received_msgdef" />
    </bpmn:startEvent>
