    <bpmn:endEvent id="event_go_response_received_mspo" name="Payment advice or rejection received by MSPO from GO">
      <bpmn:messageEventDefinition id="event_go_response_received_mspo_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="event_start_mspo" name="MSPO Billing Process Started">
      <bpmn:outgoing>flow_mspo_start</bpmn:outgoing>
    </bpmn:startEvent>
