    <bpmn:task id="task_mspo_send_read_bill" name="Send bill for additional readings">
      <bpmn:incoming>flow_mspo_read</bpmn:incoming>
      <bpmn:outgoing>flow_mspo_read_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mspo_send_read_bill_doa0">
        <bpmn:targetRef>data_bill_read</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_mspo_bill_type" name="MSPO Bill Type?" isMarkerVisible="true">
      <bpmn:incoming>flow_mspo_start</bpmn:incoming>
      <bpmn:outgoing>flow_mspo_meas</bpmn:outgoing>
      <bpmn:outgoing>flow_mspo_read</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_mspo_start" sourceRef="event_start_mspo" targetRef="gw_mspo_bill_type" />
    <bpmn:sequenceFlow id="flow_mspo_meas" sourceRef="gw_mspo_bill_type" targetRef="task_mspo_send_meas_bill" name="Temporary continuation of measurement" />
    <bpmn:sequenceFlow id="flow_mspo_read" sourceRef="gw_mspo_bill_type" targetRef="task_mspo_send_read_bill" name="Additional readings" />
    <bpmn:sequenceFlow id="flow_mspo_meas_end" sourceRef="task_mspo_send_meas_bill" targetRef="event_bill_mspo_meas_sent" />
    <bpmn:sequenceFlow id="flow_mspo_read_end" sourceRef="task_mspo_send_read_bill" targetRef="event_bill_mspo_read_sent" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_bill_ops_p1" name="Bill for temporary continuation of metering point operations" dataObjectRef="data_bill_ops_p1_do" />
    <bpmn:dataObject id="data_bill_ops_p1_do" />
    <bpmn:dataObjectReference id="data_bill_meas_p1" name="Bill for temporary continuation of measurement" dataObjectRef="data_bill_meas_p1_do" />
    <bpmn:dataObject id="data_bill_meas_p1_do" />
    <bpmn:dataObjectReference id="data_bill_read_p1" name="Bill for additional readings" dataObjectRef="data_bill_read_p1_do" />
    <bpmn:dataObject id="data_bill_read_p1_do" />
    <bpmn:dataObjectReference id="data_bill_equip_p1" name="Bill for equipment acquisition" dataObjectRef="data_bill_equip_p1_do" />
    <bpmn:dataObject id="data_bill_equip_p1_do" />
