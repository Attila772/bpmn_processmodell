<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:messageFlow id="mf_mpoo_ops_to_go" sourceRef="event_bill_mpoo_ops_sent" targetRef="event_bill_mpoo_ops_received" name="Bill for temporary continuation of metering point operations" />
    <bpmn:messageFlow id="mf_mspo_meas_to_go" sourceRef="event_bill_mspo_meas_sent" targetRef="event_bill_mspo_meas_received" name="Bill for temporary continuation of measurement" />
    <bpmn:messageFlow id="mf_mspo_read_to_go" sourceRef="event_bill_mspo_read_sent" targetRef="event_bill_mspo_read_received" name="Bill for additional readings" />
    <bpmn:messageFlow id="mf_mpoo_equip_to_go" sourceRef="event_bill_mpoo_equip_sent_go" targetRef="event_bill_mpoo_equip_received_go" name="Bill for equipment acquisition" />
    <bpmn:messageFlow id="mf_mpoo_equip_to_mpon" sourceRef="event_bill_mpoo_equip_sent_mpon" targetRef="event_bill_mpoo_equip_received_mpon" name="Bill for equipment acquisition" />
    <bpmn:messageFlow id="mf_go_to_mpoo" sourceRef="event_go_response_sent" targetRef="event_go_response_received_mpoo" name="Payment advice or rejection" />
    <bpmn:messageFlow id="mf_go_to_mspo" sourceRef="event_go_response_sent" targetRef="event_go_response_received_mspo" name="Payment advice or rejection" />
    <bpmn:messageFlow id="mf_mpon_to_mpoo" sourceRef="event_mpon_response_sent" targetRef="event_mpon_response_received_mpoo" name="Payment advice or rejection" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_bill_ops" name="Bill for temporary continuation of metering point operations" dataObjectRef="data_bill_ops_do" />
    <bpmn:dataObject id="data_bill_ops_do" />
    <bpmn:dataObjectReference id="data_bill_equip" name="Bill for equipment acquisition" dataObjectRef="data_bill_equip_do" />
    <bpmn:dataObject id="data_bill_equip_do" />
    <bpmn:endEvent id="event_bill_mpoo_ops_sent" name="Bill for temporary continuation of metering point operations sent">
      <bpmn:incoming>flow_mpoo_ops_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_bill_mpoo_ops_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="event_bill_mpoo_equip_sent_go" name="Bill for equipment acquisition sent to GO">
      <bpmn:incoming>flow_mpoo_to_go</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_bill_mpoo_equip_sent_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="event_bill_mpoo_equip_sent_mpon" name="Bill for equipment acquisition sent to MPON">
      <bpmn:incoming>flow_mpoo_to_mpon</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_bill_mpoo_equip_sent_mpon_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="event_go_response_received_mpoo" name="Payment advice or rejection received by MPOO from GO">
      <bpmn:messageEventDefinition id="event_go_response_received_mpoo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="event_mpon_response_received_mpoo" name="Payment advice or rejection received by MPOO from MPON">
      <bpmn:messageEventDefinition id="event_mpon_response_received_mpoo_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="event_start_mpoo" name="MPOO Billing Process Started">
      <bpmn:outgoing>flow_mpoo_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_mpoo_send_ops_bill" name="Send bill for temporary continuation of metering point operations">
      <bpmn:incoming>flow_mpoo_ops</bpmn:incoming>
      <bpmn:outgoing>flow_mpoo_ops_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mpoo_send_ops_bill_doa0">
        <bpmn:targetRef>data_bill_ops</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_mpoo_send_equip_bill" name="Send bill for equipment acquisition">
      <bpmn:incoming>flow_mpoo_equip</bpmn:incoming>
      <bpmn:outgoing>flow_mpoo_equip_gw</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mpoo_send_equip_bill_doa0">
        <bpmn:targetRef>data_bill_equip</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_mpoo_bill_type" name="MPOO Bill Type?" isMarkerVisible="true">
      <bpmn:incoming>flow_mpoo_start</bpmn:incoming>
      <bpmn:outgoing>flow_mpoo_ops</bpmn:outgoing>
      <bpmn:outgoing>flow_mpoo_equip</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_mpoo_recipient" name="Recipient?" isMarkerVisible="true">
      <bpmn:incoming>flow_mpoo_equip_gw</bpmn:incoming>
      <bpmn:outgoing>flow_mpoo_to_go</bpmn:outgoing>
      <bpmn:outgoing>flow_mpoo_to_mpon</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_mpoo_start" sourceRef="event_start_mpoo" targetRef="gw_mpoo_bill_type" />
    <bpmn:sequenceFlow id="flow_mpoo_ops" sourceRef="gw_mpoo_bill_type" targetRef="task_mpoo_send_ops_bill" name="Metering point operations" />
    <bpmn:sequenceFlow id="flow_mpoo_equip" sourceRef="gw_mpoo_bill_type" targetRef="task_mpoo_send_equip_bill" name="Equipment acquisition" />
    <bpmn:sequenceFlow id="flow_mpoo_ops_end" sourceRef="task_mpoo_send_ops_bill" targetRef="event_bill_mpoo_ops_sent" />
    <bpmn:sequenceFlow id="flow_mpoo_equip_gw" sourceRef="task_mpoo_send_equip_bill" targetRef="gw_mpoo_recipient" />
    <bpmn:sequenceFlow id="flow_mpoo_to_go" sourceRef="gw_mpoo_recipient" targetRef="event_bill_mpoo_equip_sent_go" name="GO" />
    <bpmn:sequenceFlow id="flow_mpoo_to_mpon" sourceRef="gw_mpoo_recipient" targetRef="event_bill_mpoo_equip_sent_mpon" name="MPON" />
  </bpmn:process>
  <bpmn:process id="pool_mspo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_bill_meas" name="Bill for temporary continuation of measurement" dataObjectRef="data_bill_meas_do" />
    <bpmn:dataObject id="data_bill_meas_do" />
    <bpmn:dataObjectReference id="data_bill_read" name="Bill for additional readings" dataObjectRef="data_bill_read_do" />
    <bpmn:dataObject id="data_bill_read_do" />
