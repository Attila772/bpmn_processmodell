<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definitions_invoice_handling"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- COLLABORATION -->
  <collaboration id="collaboration_invoice_handling">
    <participant id="participant_mpoo" name="Meter Point Operation Owner (MPOO)" processRef="process_mpoo" />
    <participant id="participant_mspo" name="Metering Service Provider Owner (MSPO)" processRef="process_mspo" />
    <participant id="participant_go" name="Grid Operator (GO)" processRef="process_go" />
    <participant id="participant_mpon" name="New Metering Point Operator (MPON)" processRef="process_mpon" />

    <!-- Message Flows for Billing MPOO -> GO -->
    <messageFlow id="mf_mpoo_cont_go" name="Bill for Cont. Metering Operations" sourceRef="task_mpoo_send_cont" targetRef="start_go_cont_bill" />
    <messageFlow id="mf_mpoo_acq_go" name="Bill for Equipment Acquisition" sourceRef="task_mpoo_send_acq" targetRef="start_go_acq_bill" />

    <!-- Message Flows for Billing MPOO -> MPON -->
    <messageFlow id="mf_mpoo_acq_mpon" name="Bill for Equipment Acquisition" sourceRef="task_mpoo_send_acq" targetRef="start_mpon_acq_bill" />

    <!-- Message Flows for Billing MSPO -> GO -->
    <messageFlow id="mf_mspo_cont_go" name="Bill for Cont. Measurement" sourceRef="task_mspo_send_cont" targetRef="start_go_mspo_cont_bill" />
    <messageFlow id="mf_mspo_read_go" name="Bill for Additional Readings" sourceRef="task_mspo_send_read" targetRef="start_go_mspo_read_bill" />

    <!-- Message Flows for Responses GO -> MPOO / MSPO -->
    <messageFlow id="mf_go_confirm_mpoo" name="Payment Advice" sourceRef="task_go_send_confirm" targetRef="event_mpoo_receive_response" />
    <messageFlow id="mf_go_reject_mpoo" name="Invoice Rejection" sourceRef="task_go_send_reject" targetRef="event_mpoo_receive_response" />
    <messageFlow id="mf_go_confirm_mspo" name="Payment Advice" sourceRef="task_go_send_confirm" targetRef="event_mspo_receive_response" />
    <messageFlow id="mf_go_reject_mspo" name="Invoice Rejection" sourceRef="task_go_send_reject" targetRef="event_mspo_receive_response" />

    <!-- Message Flows for Responses MPON -> MPOO -->
    <messageFlow id="mf_mpon_confirm_mpoo" name="Payment Advice" sourceRef="task_mpon_send_confirm" targetRef="event_mpoo_receive_response" />
    <messageFlow id="mf_mpon_reject_mpoo" name="Invoice Rejection" sourceRef="task_mpon_send_reject" targetRef="event_mpoo_receive_response" />
  </collaboration>

  <!-- MPOO PROCESS -->
  <process id="process_mpoo" isExecutable="false">
    <startEvent id="start_mpoo" name="Invoice Needed">
      <outgoing>sf_mpoo_1</outgoing>
    </startEvent>
    <exclusiveGateway id="gw_mpoo_bill_type" name="Select Bill Type">
      <incoming>sf_mpoo_1</incoming>
      <outgoing>sf_mpoo_to_cont</outgoing>
      <outgoing>sf_mpoo_to_acq</outgoing>
    </exclusiveGateway>
    <sendTask id="task_mpoo_send_cont" name="Send Bill for Temporary Continuation of Metering Point Operations">
      <incoming>sf_mpoo_to_cont</incoming>
      <outgoing>sf_mpoo_2</outgoing>
    </sendTask>
    <sendTask id="task_mpoo_send_acq" name="Send Bill for Equipment Acquisition">
      <incoming>sf_mpoo_to_acq</incoming>
      <outgoing>sf_mpoo_3</outgoing>
    </sendTask>
    <exclusiveGateway id="gw_mpoo_join">
      <incoming>sf_mpoo_2</incoming>
      <incoming>sf_mpoo_3</incoming>
      <outgoing>sf_mpoo_4</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="event_mpoo_receive_response" name="Receive Response">
      <incoming>sf_mpoo_4</incoming>
      <outgoing>sf_mpoo_5</outgoing>
      <messageEventDefinition id="med_mpoo_response" />
    </intermediateCatchEvent>
    <endEvent id="end_mpoo" name="Invoice Processed">
      <incoming>sf_mpoo_5</incoming>
    </endEvent>

    <sequenceFlow id="sf_mpoo_1" sourceRef="start_mpoo" targetRef="gw_mpoo_bill_type" />
    <sequenceFlow id="sf_mpoo_to_cont" name="Continuation Bill" sourceRef="gw_mpoo_bill_type" targetRef="task_mpoo_send_cont" />
    <sequenceFlow id="sf_mpoo_to_acq" name="Equipment Acquisition Bill" sourceRef="gw_mpoo_bill_type" targetRef="task_mpoo_send_acq" />
    <sequenceFlow id="sf_mpoo_2" sourceRef="task_mpoo_send_cont" targetRef="gw_mpoo_join" />
    <sequenceFlow id="sf_mpoo_3" sourceRef="task_mpoo_send_acq" targetRef="gw_mpoo_join" />
    <sequenceFlow id="sf_mpoo_4" sourceRef="gw_mpoo_join" targetRef="event_mpoo_receive_response" />
    <sequenceFlow id="sf_mpoo_5" sourceRef="event_mpoo_receive_response" targetRef="end_mpoo" />
  </process>

  <!-- MSPO PROCESS -->
  <process id="process_mspo" isExecutable="false">
    <startEvent id="start_mspo" name="Invoice Needed">
      <outgoing>sf_mspo_1</outgoing>
    </startEvent>
    <exclusiveGateway id="gw_mspo_bill_type" name="Select Bill Type">
      <incoming>sf_mspo_1</incoming>
      <outgoing>sf_mspo_to_cont</outgoing>
      <outgoing>sf_mspo_to_read</outgoing>
    </exclusiveGateway>
    <sendTask id="task_mspo_send_cont" name="Send Bill for Temporary Continuation of Measurement">
      <incoming>sf_mspo_to_cont</incoming>
      <outgoing>sf_mspo_2</outgoing>
    </sendTask>
    <sendTask id="task_mspo_send_read" name="Send Bill for Additional Readings">
      <incoming>sf_mspo_to_read</incoming>
      <outgoing>sf_mspo_3</outgoing>
    </sendTask>
    <exclusiveGateway id="gw_mspo_join">
      <incoming>sf_mspo_2</incoming>
      <incoming>sf_mspo_3</incoming>
      <outgoing>sf_mspo_4</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="event_mspo_receive_response" name="Receive Response">
      <incoming>sf_mspo_4</incoming>
      <outgoing>sf_mspo_5</outgoing>
      <messageEventDefinition id="med_mspo_response" />
    </intermediateCatchEvent>
    <endEvent id="end_mspo" name="Invoice Processed">
      <incoming>sf_mspo_5</incoming>
    </endEvent>

    <sequenceFlow id="sf_mspo_1" sourceRef="start_mspo" targetRef="gw_mspo_bill_type" />
    <sequenceFlow id="sf_mspo_to_cont" name="Continuation Bill" sourceRef="gw_mspo_bill_type" targetRef="task_mspo_send_cont" />
    <sequenceFlow id="sf_mspo_to_read" name="Additional Readings Bill" sourceRef="gw_mspo_bill_type" targetRef="task_mspo_send_read" />
    <sequenceFlow id="sf_mspo_2" sourceRef="task_mspo_send_cont" targetRef="gw_mspo_join" />
    <sequenceFlow id="sf_mspo_3" sourceRef="task_mspo_send_read" targetRef="gw_mspo_join" />
    <sequenceFlow id="sf_mspo_4" sourceRef="gw_mspo_join" targetRef="event_mspo_receive_response" />
    <sequenceFlow id="sf_mspo_5" sourceRef="event_mspo_receive_response" targetRef="end_mspo" />
  </process>

  <!-- GO PROCESS -->
  <process id="process_go" isExecutable="false">
    <eventBasedGateway id="gw_go_start_events">
      <outgoing>sf_go_1</outgoing>
      <outgoing>sf_go_2</outgoing>
      <outgoing>sf_go_3</outgoing>
      <outgoing>sf_go_4</outgoing>
    </eventBasedGateway>

    <intermediateCatchEvent id="start_go_cont_bill" name="Bill Received (MPOO Cont. Metering)">
      <incoming>sf_go_1</incoming>
      <outgoing>sf_go_5</outgoing>
      <messageEventDefinition id="med_go_1" />
    </intermediateCatchEvent>

    <intermediateCatchEvent id="start_go_mspo_cont_bill" name="Bill Received (MSPO Cont. Measurement)">
      <incoming>sf_go_2</incoming>
      <outgoing>sf_go_6</outgoing>
      <messageEventDefinition id="med_go_2" />
    </intermediateCatchEvent>

    <intermediateCatchEvent id="start_go_mspo_read_bill" name="Bill Received (MSPO Add. Readings)">
      <incoming>sf_go_3</incoming>
      <outgoing>sf_go_7</outgoing>
      <messageEventDefinition id="med_go_3" />
    </intermediateCatchEvent>

    <intermediateCatchEvent id="start_go_acq_bill" name="Bill Received (MPOO Equipment Acq.)">
      <incoming>sf_go_4</incoming>
      <outgoing>sf_go_8</outgoing>
      <messageEventDefinition id="med_go_4" />
    </intermediateCatchEvent>

    <exclusiveGateway id="gw_go_bill_merge">
      <incoming>sf_go_5</incoming>
      <incoming>sf_go_6</incoming>
      <incoming>sf_go_7</incoming>
      <incoming>sf_go_8</incoming>
      <outgoing>sf_go_9</outgoing>
    </exclusiveGateway>

    <userTask id="task_go_examine_bill" name="Examine Bill">
      <incoming>sf_go_9</incoming>
      <outgoing>sf_go_10</outgoing>
    </userTask>

    <exclusiveGateway id="gw_go_decision" name="Bill Accepted?">
      <incoming>sf_go_10</incoming>
      <outgoing>sf_go_accept</outgoing>
      <outgoing>sf_go_reject</outgoing>
    </exclusiveGateway>

    <sendTask id="task_go_send_confirm" name="Confirm Invoice with Payment Advice">
      <incoming>sf_go_accept</incoming>
      <outgoing>sf_go_11</outgoing>
    </sendTask>

    <sendTask id="task_go_send_reject" name="Reject Invoice">
      <incoming>sf_go_reject</incoming>
      <outgoing>sf_go_12</outgoing>
    </sendTask>

    <exclusiveGateway id="gw_go_end_merge">
      <incoming>sf_go_11</incoming>
      <incoming>sf_go_12</incoming>
      <outgoing>sf_go_13</outgoing>
    </exclusiveGateway>

    <endEvent id="end_go" name="Billing Process Completed">
      <incoming>sf_go_13</incoming>
    </endEvent>

    <sequenceFlow id="sf_go_1" sourceRef="gw_go_start_events" targetRef="start_go_cont_bill" />
    <sequenceFlow id="sf_go_2" sourceRef="gw_go_start_events" targetRef="start_go_mspo_cont_bill" />
    <sequenceFlow id="sf_go_3" sourceRef="gw_go_start_events" targetRef="start_go_mspo_read_bill" />
    <sequenceFlow id="sf_go_4" sourceRef="gw_go_start_events" targetRef="start_go_acq_bill" />
    <sequenceFlow id="sf_go_5" sourceRef="start_go_cont_bill" targetRef="gw_go_bill_merge" />
    <sequenceFlow id="sf_go_6" sourceRef="start_go_mspo_cont_bill" targetRef="gw_go_bill_merge" />
    <sequenceFlow id="sf_go_7" sourceRef="start_go_mspo_read_bill" targetRef="gw_go_bill_merge" />
    <sequenceFlow id="sf_go_8" sourceRef="start_go_acq_bill" targetRef="gw_go_bill_merge" />
    <sequenceFlow id="sf_go_9" sourceRef="gw_go_bill_merge" targetRef="task_go_examine_bill" />
    <sequenceFlow id="sf_go_10" sourceRef="task_go_examine_bill" targetRef="gw_go_decision" />
    <sequenceFlow id="sf_go_accept" name="Yes" sourceRef="gw_go_decision" targetRef="task_go_send_confirm" />
    <sequenceFlow id="sf_go_reject" name="No" sourceRef="gw_go_decision" targetRef="task_go_send_reject" />
    <sequenceFlow id="sf_go_11" sourceRef="task_go_send_confirm" targetRef="gw_go_end_merge" />
    <sequenceFlow id="sf_go_12" sourceRef="task_go_send_reject" targetRef="gw_go_end_merge" />
    <sequenceFlow id="sf_go_13" sourceRef="gw_go_end_merge" targetRef="end_go" />
  </process>

  <!-- MPON PROCESS -->
  <process id="process_mpon" isExecutable="false">
    <startEvent id="start_mpon_acq_bill" name="Bill Received for Equipment Acquisition">
      <outgoing>sf_mpon_1</outgoing>
      <messageEventDefinition id="med_mpon_1" />
    </startEvent>

    <userTask id="task_mpon_examine_bill" name="Examine Bill">
      <incoming>sf_mpon_1</incoming>
      <outgoing>sf_mpon_2</outgoing>
    </userTask>

    <exclusiveGateway id="gw_mpon_decision" name="Bill Accepted?">
      <incoming>sf_mpon_2</incoming>
      <outgoing>sf_mpon_accept</outgoing>
      <outgoing>sf_mpon_reject</outgoing>
    </exclusiveGateway>

    <sendTask id="task_mpon_send_confirm" name="Confirm Invoice with Payment Advice">
      <incoming>sf_mpon_accept</incoming>
      <outgoing>sf_mpon_3</outgoing>
    </sendTask>

    <sendTask id="task_mpon_send_reject" name="Reject Invoice">
      <incoming>sf_mpon_reject</incoming>
      <outgoing>sf_mpon_4</outgoing>
    </sendTask>

    <exclusiveGateway id="gw_mpon_end_merge">
      <incoming>sf_mpon_3</incoming>
      <incoming>sf_mpon_4</incoming>
      <outgoing>sf_mpon_5</outgoing>
    </exclusiveGateway>

    <endEvent id="end_mpon" name="Billing Process Completed">
      <incoming>sf_mpon_5</incoming>
    </endEvent>

    <sequenceFlow id="sf_mpon_1" sourceRef="start_mpon_acq_bill" targetRef="task_mpon_examine_bill" />
    <sequenceFlow id="sf_mpon_2" sourceRef="task_mpon_examine_bill" targetRef="gw_mpon_decision" />
    <sequenceFlow id="sf_mpon_accept" name="Yes" sourceRef="gw_mpon_decision" targetRef="task_mpon_send_confirm" />
    <sequenceFlow id="sf_mpon_reject" name="No" sourceRef="gw_mpon_decision" targetRef="task_mpon_send_reject" />
    <sequenceFlow id="sf_mpon_3" sourceRef="task_mpon_send_confirm" targetRef="gw_mpon_end_merge" />
    <sequenceFlow id="sf_mpon_4" sourceRef="task_mpon_send_reject" targetRef="gw_mpon_end_merge" />
    <sequenceFlow id="sf_mpon_5" sourceRef="gw_mpon_end_merge" targetRef="end_mpon" />
  </process>

  <!-- BPMN DIAGRAM -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration_invoice_handling">
      <!-- MPOO Participant -->
      <bpmndi:BPMNShape id="participant_mpoo_di" bpmnElement="participant_mpoo" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1050" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_di" bpmnElement="start_mpoo">
        <dc:Bounds x="210" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="192" y="235" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_mpoo_bill_type_di" bpmnElement="gw_mpoo_bill_type" isMarkerVisible="true">
        <dc:Bounds x="290" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="277" y="161" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_mpoo_send_cont_di" bpmnElement="task_mpoo_send_cont">
        <dc:Bounds x="390" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_mpoo_send_acq_di" bpmnElement="task_mpoo_send_acq">
        <dc:Bounds x="390" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_mpoo_join_di" bpmnElement="gw_mpoo_join" isMarkerVisible="true">
        <dc:Bounds x="540" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_mpoo_receive_response_di" bpmnElement="event_mpoo_receive_response">
        <dc:Bounds x="640" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="613" y="162" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mpoo_di" bpmnElement="end_mpoo">
        <dc:Bounds x="730" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="704" y="235" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="sf_mpoo_1_di" bpmnElement="sf_mpoo_1">
        <di:waypoint x="246" y="210" />
        <di:waypoint x="290" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mpoo_to_cont_di" bpmnElement="sf_mpoo_to_cont">
        <di:waypoint x="315" y="185" />
        <di:waypoint x="315" y="150" />
        <di:waypoint x="390" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mpoo_to_acq_di" bpmnElement="sf_mpoo_to_acq">
        <di:waypoint x="315" y="235" />
        <di:waypoint x="315" y="270" />
        <di:waypoint x="390" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mpoo_2_di" bpmnElement="sf_mpoo_2">
        <di:waypoint x="490" y="150" />
        <di:waypoint x="565" y="150" />
        <di:waypoint x="565" y="185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mpoo_3_di" bpmnElement="sf_mpoo_3">
        <di:waypoint x="490" y="270" />
        <di:waypoint x="565" y="270" />
        <di:waypoint x="565" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mpoo_4_di" bpmnElement="sf_mpoo_4">
        <di:waypoint x="590" y="210" />
        <di:waypoint x="640" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mpoo_5_di" bpmnElement="sf_mpoo_5">
        <di:waypoint x="676" y="210" />
        <di:waypoint x="730" y="210" />
      </bpmndi:BPMNEdge>

      <!-- MSPO Participant -->
      <bpmndi:BPMNShape id="participant_mspo_di" bpmnElement="participant_mspo" isHorizontal="true">
        <dc:Bounds x="160" y="400" width="1050" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mspo_di" bpmnElement="start_mspo">
        <dc:Bounds x="210" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="192" y="555" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_mspo_bill_type_di" bpmnElement="gw_mspo_bill_type" isMarkerVisible="true">
        <dc:Bounds x="290" y="505" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_mspo_send_cont_di" bpmnElement="task_mspo_send_cont">
        <dc:Bounds x="390" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_mspo_send_read_di" bpmnElement="task_mspo_send_read">
        <dc:Bounds x="390" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_mspo_join_di" bpmnElement="gw_mspo_join" isMarkerVisible="true">
        <dc:Bounds x="540" y="505" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_mspo_receive_response_di" bpmnElement="event_mspo_receive_response">
        <dc:Bounds x="640" y="512" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mspo_di" bpmnElement="end_mspo">
        <dc:Bounds x="730" y="512" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="sf_mspo_1_di" bpmnElement="sf_mspo_1">
        <di:waypoint x="246" y="530" />
        <di:waypoint x="290" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mspo_to_cont_di" bpmnElement="sf_mspo_to_cont">
        <di:waypoint x="315" y="505" />
        <di:waypoint x="315" y="470" />
        <di:waypoint x="390" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mspo_to_read_di" bpmnElement="sf_mspo_to_read">
        <di:waypoint x="315" y="555" />
        <di:waypoint x="315" y="600" />
        <di:waypoint x="390" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mspo_2_di" bpmnElement="sf_mspo_2">
        <di:waypoint x="490" y="470" />
        <di:waypoint x="565" y="470" />
        <di:waypoint x="565" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mspo_3_di" bpmnElement="sf_mspo_3">
