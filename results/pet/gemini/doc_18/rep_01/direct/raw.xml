        <di:waypoint x="565" y="600" />
        <di:waypoint x="565" y="555" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mspo_4_di" bpmnElement="sf_mspo_4">
        <di:waypoint x="590" y="530" />
        <di:waypoint x="640" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_mspo_5_di" bpmnElement="sf_mspo_5">
        <di:waypoint x="676" y="530" />
        <di:waypoint x="730" y="530" />
      </bpmndi:BPMNEdge>

      <!-- GO Participant -->
      <bpmndi:BPMNShape id="participant_go_di" bpmnElement="participant_go" isHorizontal="true">
        <dc:Bounds x="160" y="720" width="1050" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_go_start_events_di" bpmnElement="gw_go_start_events">
        <dc:Bounds x="220" y="885" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_go_cont_bill_di" bpmnElement="start_go_cont_bill">
        <dc:Bounds x="310" y="752" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_go_mspo_cont_bill_di" bpmnElement="start_go_mspo_cont_bill">
        <dc:Bounds x="310" y="832" width="36" height="36" />
