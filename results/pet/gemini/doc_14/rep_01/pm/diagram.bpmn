<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_meeting_folders" name="Meeting Folders" dataObjectRef="data_meeting_folders_do" />
    <bpmn:dataObject id="data_meeting_folders_do" />
    <bpmn:dataObjectReference id="data_documents" name="Meeting Documents" dataObjectRef="data_documents_do" />
    <bpmn:dataObject id="data_documents_do" />
    <bpmn:dataObjectReference id="data_minutes" name="Minutes &amp; Action Points" dataObjectRef="data_minutes_do" />
    <bpmn:dataObject id="data_minutes_do" />
    <bpmn:startEvent id="event_start" name="Dates Finalized">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="event_timer_1week" name="One Week Before Meeting">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="event_timer_1week_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="event_end" name="Process Completed">
      <bpmn:incoming>flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_update_calendars_folders" name="Update group calendars, create meeting folders, and upload documents">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_update_calendars_folders_doa0">
        <bpmn:targetRef>data_meeting_folders</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_update_calendars_folders_doa1">
        <bpmn:targetRef>data_documents</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_advise_members" name="Advise Committee Members to read related documents">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_advise_members_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_advise_members_dia0">
        <bpmn:sourceRef>data_documents</bpmn:sourceRef>
        <bpmn:targetRef>task_advise_members_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_read_documents" name="Read all related documents">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:property id="task_read_documents_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_read_documents_dia0">
        <bpmn:sourceRef>data_documents</bpmn:sourceRef>
        <bpmn:targetRef>task_read_documents_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_hold_meeting" name="Hold meeting">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_produce_minutes" name="Produce minutes including Action Points">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_produce_minutes_doa0">
        <bpmn:targetRef>data_minutes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_qa_check" name="Conduct QA check on minutes">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:property id="task_qa_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_qa_check_dia0">
        <bpmn:sourceRef>data_minutes</bpmn:sourceRef>
        <bpmn:targetRef>task_qa_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_qa_check_doa0">
        <bpmn:targetRef>data_minutes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_send_minutes" name="Send minutes to all Committee Members">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:property id="task_send_minutes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_minutes_dia0">
        <bpmn:sourceRef>data_minutes</bpmn:sourceRef>
        <bpmn:targetRef>task_send_minutes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_update_records" name="Update all departmental records">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:property id="task_update_records_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_update_records_dia0">
        <bpmn:sourceRef>data_minutes</bpmn:sourceRef>
        <bpmn:targetRef>task_update_records_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="event_start" targetRef="task_update_calendars_folders" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_update_calendars_folders" targetRef="event_timer_1week" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="event_timer_1week" targetRef="task_advise_members" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_advise_members" targetRef="task_read_documents" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_read_documents" targetRef="task_hold_meeting" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_hold_meeting" targetRef="task_produce_minutes" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_produce_minutes" targetRef="task_qa_check" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_qa_check" targetRef="task_send_minutes" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_send_minutes" targetRef="task_update_records" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_update_records" targetRef="event_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_end_di" bpmnElement="event_end">
        <dc:Bounds x="2060" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_start_di" bpmnElement="event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_timer_1week_di" bpmnElement="event_timer_1week">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_advise_members_di" bpmnElement="task_advise_members">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_hold_meeting_di" bpmnElement="task_hold_meeting">
