<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Committee Meeting Management Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartEvent_DatesFinalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QACheckMinutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFoldersAndUploadDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMinutesToMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateDepartmentalRecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CommitteeMembers" name="Committee Members">
        <bpmn:flowNodeRef>Task_ReadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DatesFinalized" name="Dates Finalized">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flows & Tasks -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_DatesFinalized" targetRef="Task_UpdateCalendars" />

    <bpmn:userTask id="Task_UpdateCalendars" name="Update All Group Calendars">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateFoldersAndUploadDocs" />

    <bpmn:userTask id="Task_CreateFoldersAndUploadDocs" name="Create Meeting Folders &amp; Upload Documents">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CreateFoldersAndUploadDocs" targetRef="Task_AdviseMembers" />

    <bpmn:sendTask id="Task_AdviseMembers" name="Advise Committee Members (1 Week Prior)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AdviseMembers" targetRef="Task_ReadDocuments" />

    <bpmn:userTask id="Task_ReadDocuments" name="Read Related Documents">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReadDocuments" targetRef="Task_HoldMeeting" />

    <bpmn:userTask id="Task_HoldMeeting" name="Hold Meeting">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_HoldMeeting" targetRef="Task_ProduceMinutes" />

    <bpmn:userTask id="Task_ProduceMinutes" name="Produce Minutes &amp; Action Points">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ProduceMinutes" targetRef="Task_QACheckMinutes" />

    <bpmn:userTask id="Task_QACheckMinutes" name="Conduct QA Check on Minutes (Within 5 Days)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_QACheckMinutes" targetRef="Task_SendMinutesToMembers" />

    <bpmn:sendTask id="Task_SendMinutesToMembers" name="Send Approved Minutes to Committee Members">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SendMinutesToMembers" targetRef="Task_UpdateDepartmentalRecords" />

    <bpmn:userTask id="Task_UpdateDepartmentalRecords" name="Update Departmental Records">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_UpdateDepartmentalRecords" targetRef="EndEvent_ProcessCompleted" />

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1680" height="460" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_CoordinationUnit_di" bpmnElement="Lane_CoordinationUnit" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1650" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_SupportOfficer_di" bpmnElement="Lane_SupportOfficer" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="1650" height="160" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_CommitteeMembers_di" bpmnElement="Lane_CommitteeMembers" isHorizontal="true">
        <dc:Bounds x="190" y="390" width="1650" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_DatesFinalized_di" bpmnElement="StartEvent_DatesFinalized">
        <dc:Bounds x="242" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="223" y="102" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_UpdateCalendars_di" bpmnElement="Task_UpdateCalendars">
        <dc:Bounds x="310" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CreateFoldersAndUploadDocs_di" bpmnElement="Task_CreateFoldersAndUploadDocs">
        <dc:Bounds x="450" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AdviseMembers_di" bpmnElement="Task_AdviseMembers">
        <dc:Bounds x="590" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReadDocuments_di" bpmnElement="Task_ReadDocuments">
        <dc:Bounds x="730" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_HoldMeeting_di" bpmnElement="Task_HoldMeeting">
        <dc:Bounds x="870" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProduceMinutes_di" bpmnElement="Task_ProduceMinutes">
        <dc:Bounds x="1010" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_QACheckMinutes_di" bpmnElement="Task_QACheckMinutes">
        <dc:Bounds x="1150" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendMinutesToMembers_di" bpmnElement="Task_SendMinutesToMembers">
        <dc:Bounds x="1290" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_UpdateDepartmentalRecords_di" bpmnElement="Task_UpdateDepartmentalRecords">
        <dc:Bounds x="1430" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ProcessCompleted_di" bpmnElement="EndEvent_ProcessCompleted">
        <dc:Bounds x="1582" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1573" y="335" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="150" />
        <di:waypoint x="294" y="150" />
        <di:waypoint x="294" y="310" />
        <di:waypoint x="310" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="410" y="310" />
        <di:waypoint x="450" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="550" y="310" />
        <di:waypoint x="590" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="690" y="310" />
        <di:waypoint x="710" y="310" />
        <di:waypoint x="710" y="460" />
        <di:waypoint x="730" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="830" y="460" />
        <di:waypoint x="870" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="970" y="460" />
        <di:waypoint x="990" y="460" />
        <di:waypoint x="990" y="310" />
        <di:waypoint x="1010" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1110" y="310" />
        <di:waypoint x="1130" y="310" />
        <di:waypoint x="1130" y="150" />
        <di:waypoint x="1150" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1250" y="150" />
        <di:waypoint x="1270" y="150" />
        <di:waypoint x="1270" y="310" />
        <di:waypoint x="1290" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1390" y="310" />
        <di:waypoint x="1430" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1530" y="310" />
        <di:waypoint x="1582" y="310" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
