<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- COLLABORATION PROCESS -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CommitteeMeetingProcess" name="Committee Meeting Process" processRef="Process_CommitteeMeeting" />
  </bpmn:collaboration>

  <!-- PROCESS -->
  <bpmn:process id="Process_CommitteeMeeting" isExecutable="true">

    <!-- LANES -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Start_DatesFinalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QACheckMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMinutesToMembers</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMeetingFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateDepartmentalRecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProcessCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CommitteeMembers" name="Committee Members">
        <bpmn:flowNodeRef>Task_ReadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- FLOW NODES -->
    <!-- Start Event -->
    <bpmn:startEvent id="Start_DatesFinalized" name="Dates Finalized">
      <bpmn:outgoing">SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Support Officer Setup Tasks -->
    <bpmn:task id="Task_UpdateCalendars" name="Update Group Calendars">
      <bpmn:incoming">SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateMeetingFolders" name="Create Meeting Folders">
      <bpmn:incoming">SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_UploadDocuments" name="Upload Appropriate Documents">
      <bpmn:incoming">SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AdviseMembers" name="Advise Committee Members (1 Week Prior)">
      <bpmn:incoming">SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Committee Members Tasks -->
    <bpmn:task id="Task_ReadDocuments" name="Read Related Documents">
      <bpmn:incoming">SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_HoldMeeting" name="Hold Committee Meeting">
      <bpmn:incoming">SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Post Meeting Tasks -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce Minutes &amp; Action Points">
      <bpmn:incoming">SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_QACheckMinutes" name="Conduct QA Check on Minutes (Within 5 Working Days)">
      <bpmn:incoming">SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendMinutesToMembers" name="Send Minutes to Committee Members">
      <bpmn:incoming">SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_UpdateDepartmentalRecords" name="Update Departmental Records">
      <bpmn:incoming">SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_ProcessCompleted" name="Meeting Process Completed">
      <bpmn:incoming">SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_DatesFinalized" targetRef="Task_UpdateCalendars" />
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateMeetingFolders" />
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_CreateMeetingFolders" targetRef="Task_UploadDocuments" />
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_UploadDocuments" targetRef="Task_AdviseMembers" />
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_AdviseMembers" targetRef="Task_ReadDocuments" />
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_ReadDocuments" targetRef="Task_HoldMeeting" />
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_HoldMeeting" targetRef="Task_ProduceMinutes" />
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_ProduceMinutes" targetRef="Task_QACheckMinutes" />
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Task_QACheckMinutes" targetRef="Task_SendMinutesToMembers" />
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_SendMinutesToMembers" targetRef="Task_UpdateDepartmentalRecords" />
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_UpdateDepartmentalRecords" targetRef="End_ProcessCompleted" />

  </bpmn:process>

  <!-- DIAGRAM LAYOUT -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <!-- Participant / Pool -->
      <bpmndi:BPMNShape id="Participant_CommitteeMeetingProcess_di" bpmnElement="Participant_CommitteeMeetingProcess" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1680" height="420" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_CoordinationUnit_di" bpmnElement="Lane_CoordinationUnit" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1650" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SupportOfficer_di" bpmnElement="Lane_SupportOfficer" isHorizontal="true">
        <dc:Bounds x="190" y="210" width="1650" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CommitteeMembers_di" bpmnElement="Lane_CommitteeMembers" isHorizontal="true">
        <dc:Bounds x="190" y="360" width="1650" height="140" />
      </bpmndi:BPMNShape>

      <!-- Elements -->
      <!-- Start Event -->
      <bpmndi:BPMNShape id="Start_DatesFinalized_di" bpmnElement="Start_DatesFinalized">
        <dc:Bounds x="232" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="213" y="170" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task: Update Calendars -->
      <bpmndi:BPMNShape id="Task_UpdateCalendars_di" bpmnElement="Task_UpdateCalendars">
        <dc:Bounds x="310" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Create Meeting Folders -->
      <bpmndi:BPMNShape id="Task_CreateMeetingFolders_di" bpmnElement="Task_CreateMeetingFolders">
        <dc:Bounds x="440" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Upload Documents -->
      <bpmndi:BPMNShape id="Task_UploadDocuments_di" bpmnElement="Task_UploadDocuments">
        <dc:Bounds x="570" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Advise Members -->
      <bpmndi:BPMNShape id="Task_AdviseMembers_di" bpmnElement="Task_AdviseMembers">
        <dc:Bounds x="700" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Read Documents -->
      <bpmndi:BPMNShape id="Task_ReadDocuments_di" bpmnElement="Task_ReadDocuments">
        <dc:Bounds x="830" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Hold Meeting -->
      <bpmndi:BPMNShape id="Task_HoldMeeting_di" bpmnElement="Task_HoldMeeting">
        <dc:Bounds x="960" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Produce Minutes -->
      <bpmndi:BPMNShape id="Task_ProduceMinutes_di" bpmnElement="Task_ProduceMinutes">
        <dc:Bounds x="1090" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: QA Check Minutes -->
      <bpmndi:BPMNShape id="Task_QACheckMinutes_di" bpmnElement="Task_QACheckMinutes">
        <dc:Bounds x="1220" y="105" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Send Minutes to Members -->
      <bpmndi:BPMNShape id="Task_SendMinutesToMembers_di" bpmnElement="Task_SendMinutesToMembers">
        <dc:Bounds x="1350" y="105" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Update Departmental Records -->
      <bpmndi:BPMNShape id="Task_UpdateDepartmentalRecords_di" bpmnElement="Task_UpdateDepartmentalRecords">
        <dc:Bounds x="1480" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event -->
      <bpmndi:BPMNShape id="End_ProcessCompleted_di" bpmnElement="End_ProcessCompleted">
        <dc:Bounds x="1622" y="267" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1598" y="310" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="SequenceFlow_01_di" bpmnElement="SequenceFlow_01">
        <di:waypoint x="268" y="145" />
        <di:waypoint x="289" y="145" />
        <di:waypoint x="289" y="285" />
        <di:waypoint x="310" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_02_di" bpmnElement="SequenceFlow_02">
        <di:waypoint x="410" y="285" />
        <di:waypoint x="440" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_03_di" bpmnElement="SequenceFlow_03">
        <di:waypoint x="540" y="285" />
        <di:waypoint x="570" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_04_di" bpmnElement="SequenceFlow_04">
        <di:waypoint x="670" y="285" />
        <di:waypoint x="700" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_05_di" bpmnElement="SequenceFlow_05">
        <di:waypoint x="800" y="285" />
        <di:waypoint x="815" y="285" />
        <di:waypoint x="815" y="430" />
        <di:waypoint x="830" y="430" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_06_di" bpmnElement="SequenceFlow_06">
        <di:waypoint x="930" y="430" />
        <di:waypoint x="960" y="430" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_07_di" bpmnElement="SequenceFlow_07">
        <di:waypoint x="1060" y="430" />
        <di:waypoint x="1075" y="430" />
        <di:waypoint x="1075" y="285" />
        <di:waypoint x="1090" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_08_di" bpmnElement="SequenceFlow_08">
        <di:waypoint x="1190" y="285" />
        <di:waypoint x="1205" y="285" />
        <di:waypoint x="1205" y="145" />
        <di:waypoint x="1220" y="145" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_09_di" bpmnElement="SequenceFlow_09">
        <di:waypoint x="1320" y="145" />
        <di:waypoint x="1350" y="145" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_10_di" bpmnElement="SequenceFlow_10">
        <di:waypoint x="1450" y="145" />
        <di:waypoint x="1465" y="145" />
        <di:waypoint x="1465" y="285" />
        <di:waypoint x="1480" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_11_di" bpmnElement="SequenceFlow_11">
        <di:waypoint x="1580" y="285" />
        <di:waypoint x="1622" y="285" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
