<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_order_ticket" name="Order Ticket" dataObjectRef="data_order_ticket_do" />
    <bpmn:dataObject id="data_order_ticket_do" />
    <bpmn:dataStoreReference id="store_billing_system" name="Guest Account / Billing System" />
    <bpmn:startEvent id="evt_start" name="Guest calls room service">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end" name="Order completed and billed">
      <bpmn:incoming>flow_debit_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_take_order" name="Take down the order">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_take_order_doa0">
        <bpmn:targetRef>data_order_ticket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_submit_kitchen" name="Submit order ticket to kitchen">
      <bpmn:incoming>flow_mgr_to_kitchen</bpmn:incoming>
      <bpmn:outgoing>flow_kitchen_submit_to_prep</bpmn:outgoing>
      <bpmn:property id="task_submit_kitchen_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_submit_kitchen_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_submit_kitchen_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_give_sommelier_order" name="Give order to sommelier">
      <bpmn:incoming>flow_alc_yes</bpmn:incoming>
      <bpmn:outgoing>flow_sommelier_to_prep</bpmn:outgoing>
      <bpmn:property id="task_give_sommelier_order_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_give_sommelier_order_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_give_sommelier_order_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_assign_waiter" name="Assign order to waiter">
      <bpmn:incoming>flow_mgr_to_assign_waiter</bpmn:incoming>
      <bpmn:outgoing>flow_assign_to_prep_cart</bpmn:outgoing>
      <bpmn:property id="task_assign_waiter_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_assign_waiter_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_assign_waiter_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_prep_food" name="Prepare food">
      <bpmn:incoming>flow_kitchen_submit_to_prep</bpmn:incoming>
      <bpmn:outgoing>flow_food_to_join</bpmn:outgoing>
      <bpmn:property id="task_prep_food_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prep_food_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_prep_food_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_prep_beverages" name="Fetch wine and prepare alcoholic beverages">
      <bpmn:incoming>flow_sommelier_to_prep</bpmn:incoming>
      <bpmn:outgoing>flow_prep_to_alc_join</bpmn:outgoing>
      <bpmn:property id="task_prep_beverages_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prep_beverages_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_prep_beverages_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_prep_cart_and_nonalc" name="Ready cart and prepare nonalcoholic drinks">
      <bpmn:incoming>flow_assign_to_prep_cart</bpmn:incoming>
      <bpmn:outgoing>flow_cart_to_join</bpmn:outgoing>
      <bpmn:property id="task_prep_cart_and_nonalc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prep_cart_and_nonalc_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_prep_cart_and_nonalc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_deliver_order" name="Deliver order to guest's room">
      <bpmn:incoming>flow_join_to_deliver</bpmn:incoming>
      <bpmn:outgoing>flow_deliver_to_debit</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_debit_account" name="Debit guest's account">
      <bpmn:incoming>flow_deliver_to_debit</bpmn:incoming>
      <bpmn:outgoing>flow_debit_to_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_debit_account_doa0">
        <bpmn:targetRef>store_billing_system</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gtw_parallel_split_mgr" name="Parallel Order Distribution">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_mgr_to_kitchen</bpmn:outgoing>
      <bpmn:outgoing>flow_mgr_to_alc_dec</bpmn:outgoing>
      <bpmn:outgoing>flow_mgr_to_assign_waiter</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gtw_alc_decision" name="Includes alcoholic beverage?" isMarkerVisible="true">
      <bpmn:incoming>flow_mgr_to_alc_dec</bpmn:incoming>
      <bpmn:outgoing>flow_alc_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_alc_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_alc_join" name="Sommelier Branch Join" isMarkerVisible="true">
      <bpmn:incoming>flow_alc_no</bpmn:incoming>
      <bpmn:incoming>flow_prep_to_alc_join</bpmn:incoming>
      <bpmn:outgoing>flow_alc_join_to_par_join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gtw_parallel_join_waiter" name="Preparation Synchronization">
      <bpmn:incoming>flow_food_to_join</bpmn:incoming>
      <bpmn:incoming>flow_alc_join_to_par_join</bpmn:incoming>
      <bpmn:incoming>flow_cart_to_join</bpmn:incoming>
      <bpmn:outgoing>flow_join_to_deliver</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start" targetRef="task_take_order" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_take_order" targetRef="gtw_parallel_split_mgr" />
    <bpmn:sequenceFlow id="flow_mgr_to_kitchen" sourceRef="gtw_parallel_split_mgr" targetRef="task_submit_kitchen" />
    <bpmn:sequenceFlow id="flow_mgr_to_alc_dec" sourceRef="gtw_parallel_split_mgr" targetRef="gtw_alc_decision" />
    <bpmn:sequenceFlow id="flow_mgr_to_assign_waiter" sourceRef="gtw_parallel_split_mgr" targetRef="task_assign_waiter" />
    <bpmn:sequenceFlow id="flow_alc_yes" sourceRef="gtw_alc_decision" targetRef="task_give_sommelier_order" name="Yes (80%)" />
    <bpmn:sequenceFlow id="flow_alc_no" sourceRef="gtw_alc_decision" targetRef="gtw_alc_join" name="No (20%)" />
    <bpmn:sequenceFlow id="flow_sommelier_to_prep" sourceRef="task_give_sommelier_order" targetRef="task_prep_beverages" />
    <bpmn:sequenceFlow id="flow_prep_to_alc_join" sourceRef="task_prep_beverages" targetRef="gtw_alc_join" />
    <bpmn:sequenceFlow id="flow_kitchen_submit_to_prep" sourceRef="task_submit_kitchen" targetRef="task_prep_food" />
    <bpmn:sequenceFlow id="flow_assign_to_prep_cart" sourceRef="task_assign_waiter" targetRef="task_prep_cart_and_nonalc" />
    <bpmn:sequenceFlow id="flow_food_to_join" sourceRef="task_prep_food" targetRef="gtw_parallel_join_waiter" />
    <bpmn:sequenceFlow id="flow_alc_join_to_par_join" sourceRef="gtw_alc_join" targetRef="gtw_parallel_join_waiter" />
    <bpmn:sequenceFlow id="flow_cart_to_join" sourceRef="task_prep_cart_and_nonalc" targetRef="gtw_parallel_join_waiter" />
    <bpmn:sequenceFlow id="flow_join_to_deliver" sourceRef="gtw_parallel_join_waiter" targetRef="task_deliver_order" />
    <bpmn:sequenceFlow id="flow_deliver_to_debit" sourceRef="task_deliver_order" targetRef="task_debit_account" />
    <bpmn:sequenceFlow id="flow_debit_to_end" sourceRef="task_debit_account" targetRef="evt_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_di" bpmnElement="evt_end">
        <dc:Bounds x="1680" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_di" bpmnElement="evt_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_alc_decision_di" bpmnElement="gtw_alc_decision">
        <dc:Bounds x="730" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_alc_join_di" bpmnElement="gtw_alc_join">
        <dc:Bounds x="1300" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_parallel_join_waiter_di" bpmnElement="gtw_parallel_join_waiter">
        <dc:Bounds x="1110" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_parallel_split_mgr_di" bpmnElement="gtw_parallel_split_mgr">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assign_waiter_di" bpmnElement="task_assign_waiter">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_debit_account_di" bpmnElement="task_debit_account">
        <dc:Bounds x="1490" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_deliver_order_di" bpmnElement="task_deliver_order">
        <dc:Bounds x="1300" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_give_sommelier_order_di" bpmnElement="task_give_sommelier_order">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prep_beverages_di" bpmnElement="task_prep_beverages">
        <dc:Bounds x="1110" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prep_cart_and_nonalc_di" bpmnElement="task_prep_cart_and_nonalc">
        <dc:Bounds x="920" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prep_food_di" bpmnElement="task_prep_food">
        <dc:Bounds x="920" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_kitchen_di" bpmnElement="task_submit_kitchen">
        <dc:Bounds x="730" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_take_order_di" bpmnElement="task_take_order">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_order_ticket_di" bpmnElement="data_order_ticket">
        <dc:Bounds x="831" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="store_billing_system_di" bpmnElement="store_billing_system">
        <dc:Bounds x="1510" y="490" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mgr_to_kitchen_di" bpmnElement="flow_mgr_to_kitchen">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mgr_to_alc_dec_di" bpmnElement="flow_mgr_to_alc_dec">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mgr_to_assign_waiter_di" bpmnElement="flow_mgr_to_assign_waiter">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_alc_yes_di" bpmnElement="flow_alc_yes">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_alc_no_di" bpmnElement="flow_alc_no">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sommelier_to_prep_di" bpmnElement="flow_sommelier_to_prep">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_prep_to_alc_join_di" bpmnElement="flow_prep_to_alc_join">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_kitchen_submit_to_prep_di" bpmnElement="flow_kitchen_submit_to_prep">
        <di:waypoint x="780" y="390" />
        <di:waypoint x="970" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assign_to_prep_cart_di" bpmnElement="flow_assign_to_prep_cart">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_food_to_join_di" bpmnElement="flow_food_to_join">
        <di:waypoint x="970" y="390" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_alc_join_to_par_join_di" bpmnElement="flow_alc_join_to_par_join">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cart_to_join_di" bpmnElement="flow_cart_to_join">
        <di:waypoint x="970" y="265" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_to_deliver_di" bpmnElement="flow_join_to_deliver">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_deliver_to_debit_di" bpmnElement="flow_deliver_to_debit">
        <di:waypoint x="1350" y="265" />
        <di:waypoint x="1540" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_debit_to_end_di" bpmnElement="flow_debit_to_end">
        <di:waypoint x="1540" y="140" />
        <di:waypoint x="1698" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_take_order_doa0_di" bpmnElement="task_take_order_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="849" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_submit_kitchen_dia0_di" bpmnElement="task_submit_kitchen_dia0">
        <di:waypoint x="849" y="515" />
        <di:waypoint x="780" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_give_sommelier_order_dia0_di" bpmnElement="task_give_sommelier_order_dia0">
        <di:waypoint x="849" y="515" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_assign_waiter_dia0_di" bpmnElement="task_assign_waiter_dia0">
        <di:waypoint x="849" y="515" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_prep_food_dia0_di" bpmnElement="task_prep_food_dia0">
        <di:waypoint x="849" y="515" />
        <di:waypoint x="970" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_prep_beverages_dia0_di" bpmnElement="task_prep_beverages_dia0">
        <di:waypoint x="849" y="515" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_prep_cart_and_nonalc_dia0_di" bpmnElement="task_prep_cart_and_nonalc_dia0">
        <di:waypoint x="849" y="515" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_debit_account_doa0_di" bpmnElement="task_debit_account_doa0">
        <di:waypoint x="1540" y="140" />
        <di:waypoint x="1535" y="515" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>