      <!-- Sommelier Shapes -->
      <bpmndi:BPMNShape id="task_fetch_alcohol_di" bpmnElement="task_fetch_alcohol">
        <omgdc:Bounds x="670" y="525" width="120" height="70" />
      </bpmndi:BPMNShape>

      <!-- Waiter Shapes -->
