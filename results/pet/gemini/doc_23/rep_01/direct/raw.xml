      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="seq_to_alcohol_check_di" bpmnElement="seq_to_alcohol_check">
        <omgdi:waypoint x="485" y="200" />
        <omgdi:waypoint x="525" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="seq_alcohol_yes_di" bpmnElement="seq_alcohol_yes">
