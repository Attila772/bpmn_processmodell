      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="join_manager_tasks_di" bpmnElement="join_manager_tasks" isMarkerVisible="true">
        <omgdc:Bounds x="855" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Kitchen Shapes -->
