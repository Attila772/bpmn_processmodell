        <omgdc:Bounds x="1220" y="680" width="110" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="task_debit_account_di" bpmnElement="task_debit_account">
        <omgdc:Bounds x="1380" y="680" width="110" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="end_order_fulfilled_di" bpmnElement="end_order_fulfilled">
