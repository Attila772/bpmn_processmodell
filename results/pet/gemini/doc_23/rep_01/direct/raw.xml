        <omgdi:waypoint x="790" y="250" />
        <omgdi:waypoint x="790" y="225" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="558" y="232" width="44" height="14" />
        </bpmndi:BPMNLabel>
