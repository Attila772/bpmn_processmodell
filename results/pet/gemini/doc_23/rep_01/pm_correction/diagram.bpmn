<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="doc_order_ticket" name="Order Ticket" dataObjectRef="doc_order_ticket_do" />
    <bpmn:dataObject id="doc_order_ticket_do" />
    <bpmn:dataStoreReference id="store_guest_account" name="Guest Account Billing System" />
    <bpmn:startEvent id="event_guest_call" name="Guest calls room service">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_order_delivered" name="Order delivered and guest billed">
      <bpmn:incoming>flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_take_order" name="Take down order">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_take_order_doa0">
        <bpmn:targetRef>doc_order_ticket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_submit_kitchen_order" name="Submit order ticket to kitchen">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_submit_kitchen_order_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_submit_kitchen_order_dia0">
        <bpmn:sourceRef>doc_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_submit_kitchen_order_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_assign_waiter" name="Assign order to waiter">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:property id="task_assign_waiter_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_assign_waiter_dia0">
        <bpmn:sourceRef>doc_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_assign_waiter_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_prepare_food" name="Prepare food">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:property id="task_prepare_food_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prepare_food_dia0">
        <bpmn:sourceRef>doc_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_prepare_food_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_fetch_prepare_beverages" name="Fetch wine and prepare alcoholic beverages">
      <bpmn:incoming>flow_alcohol_yes</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:property id="task_fetch_prepare_beverages_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_fetch_prepare_beverages_dia0">
        <bpmn:sourceRef>doc_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_fetch_prepare_beverages_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_ready_cart" name="Ready cart and prepare nonalcoholic drinks">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:property id="task_ready_cart_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_ready_cart_dia0">
        <bpmn:sourceRef>doc_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_ready_cart_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_deliver_order" name="Deliver order to guest room">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_debit_account" name="Debit guest account">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_debit_account_doa0">
        <bpmn:targetRef>store_guest_account</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gw_parallel_split_mgr" name="Parallel Order Distribution">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gw_check_alcohol" name="Includes wine or alcoholic beverage?" isMarkerVisible="true">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_alcohol_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_alcohol_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_join_alcohol" name="Alcohol Preparation Join" isMarkerVisible="true">
      <bpmn:incoming>flow_alcohol_no</bpmn:incoming>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_parallel_join_preparation" name="Preparation Join">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="event_guest_call" targetRef="task_take_order" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_take_order" targetRef="gw_parallel_split_mgr" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="gw_parallel_split_mgr" targetRef="task_submit_kitchen_order" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="gw_parallel_split_mgr" targetRef="gw_check_alcohol" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="gw_parallel_split_mgr" targetRef="task_assign_waiter" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_submit_kitchen_order" targetRef="task_prepare_food" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_prepare_food" targetRef="gw_parallel_join_preparation" />
    <bpmn:sequenceFlow id="flow_alcohol_yes" sourceRef="gw_check_alcohol" targetRef="task_fetch_prepare_beverages" name="Yes (80%)" />
    <bpmn:sequenceFlow id="flow_alcohol_no" sourceRef="gw_check_alcohol" targetRef="gw_join_alcohol" name="No (20%)" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_fetch_prepare_beverages" targetRef="gw_join_alcohol" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="gw_join_alcohol" targetRef="gw_parallel_join_preparation" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_assign_waiter" targetRef="task_ready_cart" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_ready_cart" targetRef="gw_parallel_join_preparation" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="gw_parallel_join_preparation" targetRef="task_deliver_order" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="task_deliver_order" targetRef="task_debit_account" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="task_debit_account" targetRef="event_order_delivered" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_guest_call_di" bpmnElement="event_guest_call">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_order_delivered_di" bpmnElement="event_order_delivered">
        <dc:Bounds x="1870" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_check_alcohol_di" bpmnElement="gw_check_alcohol">
        <dc:Bounds x="730" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_join_alcohol_di" bpmnElement="gw_join_alcohol">
        <dc:Bounds x="1110" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_join_preparation_di" bpmnElement="gw_parallel_join_preparation">
        <dc:Bounds x="1300" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_split_mgr_di" bpmnElement="gw_parallel_split_mgr">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assign_waiter_di" bpmnElement="task_assign_waiter">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_debit_account_di" bpmnElement="task_debit_account">
        <dc:Bounds x="1680" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_deliver_order_di" bpmnElement="task_deliver_order">
        <dc:Bounds x="1490" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_fetch_prepare_beverages_di" bpmnElement="task_fetch_prepare_beverages">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prepare_food_di" bpmnElement="task_prepare_food">
        <dc:Bounds x="920" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ready_cart_di" bpmnElement="task_ready_cart">
        <dc:Bounds x="920" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_kitchen_order_di" bpmnElement="task_submit_kitchen_order">
        <dc:Bounds x="730" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_take_order_di" bpmnElement="task_take_order">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_order_ticket_di" bpmnElement="doc_order_ticket">
        <dc:Bounds x="781" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="store_guest_account_di" bpmnElement="store_guest_account">
        <dc:Bounds x="1700" y="490" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="780" y="390" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7">
        <di:waypoint x="970" y="265" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_alcohol_yes_di" bpmnElement="flow_alcohol_yes">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_alcohol_no_di" bpmnElement="flow_alcohol_no">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_8_di" bpmnElement="flow_8">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_9_di" bpmnElement="flow_9">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_10_di" bpmnElement="flow_10">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="970" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_11_di" bpmnElement="flow_11">
        <di:waypoint x="970" y="390" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_12_di" bpmnElement="flow_12">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="1540" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_13_di" bpmnElement="flow_13">
        <di:waypoint x="1540" y="140" />
        <di:waypoint x="1730" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_14_di" bpmnElement="flow_14">
        <di:waypoint x="1730" y="140" />
        <di:waypoint x="1888" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_take_order_doa0_di" bpmnElement="task_take_order_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="799" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_submit_kitchen_order_dia0_di" bpmnElement="task_submit_kitchen_order_dia0">
        <di:waypoint x="799" y="515" />
        <di:waypoint x="780" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_assign_waiter_dia0_di" bpmnElement="task_assign_waiter_dia0">
        <di:waypoint x="799" y="515" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_prepare_food_dia0_di" bpmnElement="task_prepare_food_dia0">
        <di:waypoint x="799" y="515" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_fetch_prepare_beverages_dia0_di" bpmnElement="task_fetch_prepare_beverages_dia0">
        <di:waypoint x="799" y="515" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_ready_cart_dia0_di" bpmnElement="task_ready_cart_dia0">
        <di:waypoint x="799" y="515" />
        <di:waypoint x="970" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_debit_account_doa0_di" bpmnElement="task_debit_account_doa0">
        <di:waypoint x="1730" y="140" />
        <di:waypoint x="1725" y="515" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>