<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_secretarial_office_part" name="Secretarial Office" processRef="pool_secretarial_office_proc" />
    <bpmn:participant id="pool_nursing_officer_part" name="Nursing Officer" processRef="pool_nursing_officer_proc" />
    <bpmn:participant id="pool_medical_team_leader_part" name="Medical Team / Team Leader" processRef="pool_medical_team_leader_proc" />
    <bpmn:participant id="pool_first_intaker_part" name="First Intaker (Social-Medical Worker)" processRef="pool_first_intaker_proc" />
    <bpmn:participant id="pool_second_intaker_part" name="Second Intaker (Physician)" processRef="pool_second_intaker_proc" />
    <bpmn:participant id="pool_family_doctor_part" name="Family Doctor" processRef="pool_family_doctor_proc" />
    <bpmn:messageFlow id="mf_1" sourceRef="evt_msg_end_call_transfer" targetRef="evt_msg_start_nursing_call" name="Call transfer" />
    <bpmn:messageFlow id="mf_2" sourceRef="evt_msg_end_form_handin" targetRef="evt_msg_start_form_receive" name="Registration form" />
    <bpmn:messageFlow id="mf_3" sourceRef="evt_msg_end_assign_handin" targetRef="evt_msg_start_assign_receive" name="Assignment list" />
    <bpmn:messageFlow id="mf_4" sourceRef="evt_msg_end_reg_cards_send_1" targetRef="evt_msg_start_reg_card_rec_1" name="Registration card" />
    <bpmn:messageFlow id="mf_5" sourceRef="evt_msg_end_reg_cards_send_2" targetRef="evt_msg_start_reg_card_rec_2" name="Registration card" />
    <bpmn:messageFlow id="mf_6" sourceRef="evt_msg_end_req_letter" targetRef="evt_msg_start_doc_letter" name="Request letter" />
    <bpmn:messageFlow id="mf_7" sourceRef="evt_msg_end_doc_copy" targetRef="evt_msg_start_copy_rec" name="Medical file copy" />
    <bpmn:messageFlow id="mf_8" sourceRef="evt_msg_end_notify_2nd" targetRef="evt_msg_start_notify_2nd_rec" name="Medical file receipt notification" />
    <bpmn:messageFlow id="mf_9" sourceRef="evt_msg_end_tape_send" targetRef="evt_msg_start_tape_rec" name="Dictaphone tape" />
  </bpmn:collaboration>
  <bpmn:process id="pool_secretarial_office_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_reg_form_p1" name="Registration Form" dataObjectRef="do_reg_form_p1_do" />
    <bpmn:dataObject id="do_reg_form_p1_do" />
    <bpmn:dataStoreReference id="ds_info_system" name="Information System" />
    <bpmn:dataObjectReference id="do_system_print" name="Information System Print" dataObjectRef="do_system_print_do" />
    <bpmn:dataObject id="do_system_print_do" />
    <bpmn:dataObjectReference id="do_patient_file" name="Patient File" dataObjectRef="do_patient_file_do" />
    <bpmn:dataObject id="do_patient_file_do" />
    <bpmn:dataObjectReference id="do_reg_cards" name="Registration Cards" dataObjectRef="do_reg_cards_do" />
    <bpmn:dataObject id="do_reg_cards_do" />
    <bpmn:dataObjectReference id="do_list_new_notices" name="List of New Notices" dataObjectRef="do_list_new_notices_do" />
    <bpmn:dataObject id="do_list_new_notices_do" />
    <bpmn:dataObjectReference id="do_assignment_list_p1" name="Assignment List" dataObjectRef="do_assignment_list_p1_do" />
    <bpmn:dataObject id="do_assignment_list_p1_do" />
    <bpmn:dataObjectReference id="do_req_letter" name="Request Letter for Medical File" dataObjectRef="do_req_letter_do" />
    <bpmn:dataObject id="do_req_letter_do" />
    <bpmn:dataObjectReference id="do_med_file_copy_p1" name="Copy of Medical File" dataObjectRef="do_med_file_copy_p1_do" />
    <bpmn:dataObject id="do_med_file_copy_p1_do" />
    <bpmn:dataObjectReference id="do_dictaphone_tape_p1" name="Dictaphone Tape" dataObjectRef="do_dictaphone_tape_p1_do" />
    <bpmn:dataObject id="do_dictaphone_tape_p1_do" />
    <bpmn:dataObjectReference id="do_list_completed_meetings" name="List of Patients Reaching Completed Status" dataObjectRef="do_list_completed_meetings_do" />
    <bpmn:dataObject id="do_list_completed_meetings_do" />
    <bpmn:dataObjectReference id="do_treatment_plan" name="Treatment Plan" dataObjectRef="do_treatment_plan_do" />
    <bpmn:dataObject id="do_treatment_plan_do" />
    <bpmn:startEvent id="evt_start" name="Telephone notice received from Family Doctor">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_end_call_transfer" name="Doctor transferred to Nursing Officer">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_end_call_transfer_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_start_form_receive" name="Registration form received">
      <bpmn:outgoing>sf_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_start_form_receive_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_start_assign_receive" name="Assignment list received">
      <bpmn:outgoing>sf_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_start_assign_receive_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_end_reg_cards_send_1" name="Registration card sent to First Intaker">
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_end_reg_cards_send_1_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_end_reg_cards_send_2" name="Registration card sent to Second Intaker">
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_end_reg_cards_send_2_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_end_req_letter" name="Request letter sent to Family Doctor">
      <bpmn:incoming>sf_16</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_end_req_letter_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_start_copy_rec" name="Medical file copy received">
      <bpmn:outgoing>sf_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_start_copy_rec_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_end_notify_2nd" name="Second intaker informed of medical file receipt">
      <bpmn:incoming>sf_20</bpmn:incoming>
      <bpmn:outgoing>sf_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_end_notify_2nd_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_start_tape_rec" name="Dictaphone tape received">
      <bpmn:outgoing>sf_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_start_tape_rec_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="evt_end_intake" name="Intake procedure ended">
      <bpmn:incoming>sf_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_inquire_patient_info" name="Inquire after name and residence of patient">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_store_and_print" name="Store information in system and print">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:property id="task_store_and_print_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_and_print_dia0">
        <bpmn:sourceRef>do_reg_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_and_print_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_and_print_doa0">
        <bpmn:targetRef>ds_info_system</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_store_and_print_doa1">
        <bpmn:targetRef>do_system_print</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_new_patient" name="Check if patient is new and create patient file if needed">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
      <bpmn:property id="task_check_new_patient_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_new_patient_dia0">
        <bpmn:sourceRef>do_reg_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_new_patient_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_check_new_patient_dia1">
        <bpmn:sourceRef>do_system_print</bpmn:sourceRef>
        <bpmn:targetRef>task_check_new_patient_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_check_new_patient_doa0">
        <bpmn:targetRef>do_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_produce_reg_cards" name="Produce two registration cards for intakers">
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
      <bpmn:property id="task_produce_reg_cards_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_produce_reg_cards_dia0">
        <bpmn:sourceRef>do_patient_file</bpmn:sourceRef>
        <bpmn:targetRef>task_produce_reg_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_produce_reg_cards_doa0">
        <bpmn:targetRef>do_reg_cards</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_add_to_new_notices" name="Add new patient to list of new notices">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_add_to_new_notices_doa0">
        <bpmn:targetRef>do_list_new_notices</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_store_assignment_and_pass_cards" name="Store assignments in system and pass registration cards">
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
      <bpmn:property id="task_store_assignment_and_pass_cards_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_assignment_and_pass_cards_dia0">
        <bpmn:sourceRef>do_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_assignment_and_pass_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_store_assignment_and_pass_cards_dia1">
        <bpmn:sourceRef>do_reg_cards</bpmn:sourceRef>
        <bpmn:targetRef>task_store_assignment_and_pass_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_assignment_and_pass_cards_doa0">
        <bpmn:targetRef>ds_info_system</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_med_file_req" name="Check if medical file is required">
      <bpmn:incoming>sf_14</bpmn:incoming>
      <bpmn:outgoing>sf_15</bpmn:outgoing>
      <bpmn:property id="task_check_med_file_req_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_med_file_req_dia0">
        <bpmn:sourceRef>do_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_med_file_req_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_prepare_send_req_letter" name="Prepare and send letter requesting medical file copy">
      <bpmn:incoming>sf_req_yes</bpmn:incoming>
      <bpmn:outgoing>sf_16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_prepare_send_req_letter_doa0">
        <bpmn:targetRef>do_req_letter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_process_med_file_copy" name="Add copy to patient file and inform second intaker">
      <bpmn:incoming>sf_19</bpmn:incoming>
      <bpmn:outgoing>sf_20</bpmn:outgoing>
      <bpmn:property id="task_process_med_file_copy_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_process_med_file_copy_dia0">
        <bpmn:sourceRef>do_med_file_copy_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_process_med_file_copy_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_process_med_file_copy_doa0">
        <bpmn:targetRef>do_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_type_and_file_tape" name="Type out dictaphone tape and add to patient file">
      <bpmn:incoming>sf_30</bpmn:incoming>
      <bpmn:outgoing>sf_31</bpmn:outgoing>
      <bpmn:property id="task_type_and_file_tape_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_type_and_file_tape_dia0">
        <bpmn:sourceRef>do_dictaphone_tape_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_type_and_file_tape_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_type_and_file_tape_doa0">
        <bpmn:targetRef>do_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_update_status_list" name="Put patient on list of completed meetings and provide to team-leader">
      <bpmn:incoming>sf_23</bpmn:incoming>
      <bpmn:outgoing>sf_33</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_update_status_list_doa0">
        <bpmn:targetRef>do_list_completed_meetings</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_formulate_treatment_plan" name="Formulate treatment plan at Wednesday staff meeting">
      <bpmn:incoming>sf_34</bpmn:incoming>
      <bpmn:outgoing>sf_35</bpmn:outgoing>
      <bpmn:property id="task_formulate_treatment_plan_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_formulate_treatment_plan_dia0">
        <bpmn:sourceRef>do_list_completed_meetings</bpmn:sourceRef>
        <bpmn:targetRef>task_formulate_treatment_plan_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_formulate_treatment_plan_dia1">
        <bpmn:sourceRef>do_patient_file</bpmn:sourceRef>
        <bpmn:targetRef>task_formulate_treatment_plan_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_formulate_treatment_plan_doa0">
        <bpmn:targetRef>do_treatment_plan</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gtw_med_file_req" name="Medical file required?" isMarkerVisible="true">
      <bpmn:incoming>sf_15</bpmn:incoming>
      <bpmn:outgoing>sf_req_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_req_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_med_file_join" name="Medical file path merge" isMarkerVisible="true">
      <bpmn:incoming>sf_21</bpmn:incoming>
      <bpmn:incoming>sf_req_no</bpmn:incoming>
      <bpmn:outgoing>sf_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gtw_parallel_intakes_start" name="Parallel intake activities">
      <bpmn:incoming>sf_22</bpmn:incoming>
      <bpmn:outgoing>sf_23</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gtw_parallel_intakes_join" name="Complete intake activities">
      <bpmn:incoming>sf_31</bpmn:incoming>
      <bpmn:incoming>sf_32</bpmn:incoming>
      <bpmn:incoming>sf_33</bpmn:incoming>
      <bpmn:outgoing>sf_34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="sf_1" sourceRef="evt_start" targetRef="task_inquire_patient_info" />
    <bpmn:sequenceFlow id="sf_2" sourceRef="task_inquire_patient_info" targetRef="evt_msg_end_call_transfer" />
    <bpmn:sequenceFlow id="sf_5" sourceRef="evt_msg_start_form_receive" targetRef="task_store_and_print" />
    <bpmn:sequenceFlow id="sf_6" sourceRef="task_store_and_print" targetRef="task_check_new_patient" />
    <bpmn:sequenceFlow id="sf_7" sourceRef="task_check_new_patient" targetRef="task_produce_reg_cards" />
    <bpmn:sequenceFlow id="sf_8" sourceRef="task_produce_reg_cards" targetRef="task_add_to_new_notices" />
    <bpmn:sequenceFlow id="sf_11" sourceRef="evt_msg_start_assign_receive" targetRef="task_store_assignment_and_pass_cards" />
    <bpmn:sequenceFlow id="sf_12" sourceRef="task_store_assignment_and_pass_cards" targetRef="evt_msg_end_reg_cards_send_1" />
    <bpmn:sequenceFlow id="sf_13" sourceRef="evt_msg_end_reg_cards_send_1" targetRef="evt_msg_end_reg_cards_send_2" />
    <bpmn:sequenceFlow id="sf_14" sourceRef="evt_msg_end_reg_cards_send_2" targetRef="task_check_med_file_req" />
    <bpmn:sequenceFlow id="sf_15" sourceRef="task_check_med_file_req" targetRef="gtw_med_file_req" />
    <bpmn:sequenceFlow id="sf_req_yes" sourceRef="gtw_med_file_req" targetRef="task_prepare_send_req_letter" name="Medical file required" />
    <bpmn:sequenceFlow id="sf_16" sourceRef="task_prepare_send_req_letter" targetRef="evt_msg_end_req_letter" />
    <bpmn:sequenceFlow id="sf_19" sourceRef="evt_msg_start_copy_rec" targetRef="task_process_med_file_copy" />
    <bpmn:sequenceFlow id="sf_20" sourceRef="task_process_med_file_copy" targetRef="evt_msg_end_notify_2nd" />
    <bpmn:sequenceFlow id="sf_21" sourceRef="evt_msg_end_notify_2nd" targetRef="gtw_med_file_join" />
    <bpmn:sequenceFlow id="sf_req_no" sourceRef="gtw_med_file_req" targetRef="gtw_med_file_join" name="Medical file not required" />
    <bpmn:sequenceFlow id="sf_22" sourceRef="gtw_med_file_join" targetRef="gtw_parallel_intakes_start" />
    <bpmn:sequenceFlow id="sf_23" sourceRef="gtw_parallel_intakes_start" targetRef="task_update_status_list" />
    <bpmn:sequenceFlow id="sf_30" sourceRef="evt_msg_start_tape_rec" targetRef="task_type_and_file_tape" />
    <bpmn:sequenceFlow id="sf_31" sourceRef="task_type_and_file_tape" targetRef="gtw_parallel_intakes_join" />
    <bpmn:sequenceFlow id="sf_33" sourceRef="task_update_status_list" targetRef="gtw_parallel_intakes_join" />
    <bpmn:sequenceFlow id="sf_34" sourceRef="gtw_parallel_intakes_join" targetRef="task_formulate_treatment_plan" />
    <bpmn:sequenceFlow id="sf_35" sourceRef="task_formulate_treatment_plan" targetRef="evt_end_intake" />
  </bpmn:process>
  <bpmn:process id="pool_nursing_officer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_reg_form" name="Registration Form" dataObjectRef="do_reg_form_do" />
    <bpmn:dataObject id="do_reg_form_do" />
    <bpmn:intermediateThrowEvent id="evt_msg_start_nursing_call" name="Call transferred from Secretarial Office">
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_start_nursing_call_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_end_form_handin" name="Registration form handed in">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_end_form_handin_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_full_inquiry" name="Make full inquiry into mental, health, and social state">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_full_inquiry_doa0">
        <bpmn:targetRef>do_reg_form</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_3" sourceRef="evt_msg_start_nursing_call" targetRef="task_full_inquiry" />
    <bpmn:sequenceFlow id="sf_4" sourceRef="task_full_inquiry" targetRef="evt_msg_end_form_handin" />
  </bpmn:process>
  <bpmn:process id="pool_medical_team_leader_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do_list_new_notices_p1" name="List of New Notices" dataObjectRef="do_list_new_notices_p1_do" />
    <bpmn:dataObject id="do_list_new_notices_p1_do" />
    <bpmn:dataObjectReference id="do_assignment_list" name="Assignment List" dataObjectRef="do_assignment_list_do" />
    <bpmn:dataObject id="do_assignment_list_do" />
    <bpmn:intermediateThrowEvent id="evt_msg_end_assign_handin" name="Assignment list handed in">
      <bpmn:incoming>sf_10</bpmn:incoming>
