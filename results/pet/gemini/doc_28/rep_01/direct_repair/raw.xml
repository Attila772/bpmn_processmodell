        <omgdc:Bounds x="560" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- More Secretarial Office Nodes -->
      <bpmndi:BPMNShape id="Task_StoreAndPrintInfo_di" bpmnElement="Task_StoreAndPrintInfo">
        <omgdc:Bounds x="560" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_IsNewPatient_di" bpmnElement="Gateway_IsNewPatient" isMarkerVisible="true">
        <omgdc:Bounds x="695" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreatePatientFile_di" bpmnElement="Task_CreatePatientFile">
        <omgdc:Bounds x="780" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergePatientFile_di" bpmnElement="Gateway_MergePatientFile" isMarkerVisible="true">
        <omgdc:Bounds x="915" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StoreFormsInFile_di" bpmnElement="Task_StoreFormsInFile">
        <omgdc:Bounds x="990" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProduceRegistrationCards_di" bpmnElement="Task_ProduceRegistrationCards">
        <omgdc:Bounds x="1120" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AddToListOfNewNotices_di" bpmnElement="Task_AddToListOfNewNotices">
        <omgdc:Bounds x="1250" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_WednesdayMeeting_di" bpmnElement="Catch_WednesdayMeeting">
        <omgdc:Bounds x="1382" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Medical Team Leader Node -->
      <bpmndi:BPMNShape id="Task_AssignIntakersAndDetermineMedFile_di" bpmnElement="Task_AssignIntakersAndDetermineMedFile">
        <omgdc:Bounds x="1350" y="880" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Secretarial Office Nodes Continued -->
      <bpmndi:BPMNShape id="Task_StoreAssignments_di" bpmnElement="Task_StoreAssignments">
        <omgdc:Bounds x="1480" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PassRegistrationCards_di" bpmnElement="Task_PassRegistrationCards">
        <omgdc:Bounds x="1610" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MedicalFileRequired_di" bpmnElement="Gateway_MedicalFileRequired" isMarkerVisible="true">
        <omgdc:Bounds x="1745" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareAndSendRequestLetter_di" bpmnElement="Task_PrepareAndSendRequestLetter">
        <omgdc:Bounds x="1830" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_ReceiveMedicalFileCopy_di" bpmnElement="Catch_ReceiveMedicalFileCopy">
        <omgdc:Bounds x="1962" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformSecondIntaker_di" bpmnElement="Task_InformSecondIntaker">
        <omgdc:Bounds x="2030" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AddCopyAndPutOnList_di" bpmnElement="Task_AddCopyAndPutOnList">
        <omgdc:Bounds x="2030" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeBeforeSubprocess_di" bpmnElement="Gateway_MergeBeforeSubprocess" isMarkerVisible="true">
        <omgdc:Bounds x="1745" y="285" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- SubProcess -->
