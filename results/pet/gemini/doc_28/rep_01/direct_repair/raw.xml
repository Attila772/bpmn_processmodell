        <omgdc:Bounds x="1350" y="320" width="600" height="170" />
      </bpmndi:BPMNShape>

      <!-- SubProcess Content -->
      <bpmndi:BPMNShape id="SubStart_Meetings_di" bpmnElement="SubStart_Meetings">
        <omgdc:Bounds x="1370" y="380" width="36" height="36" />
      </bpmndi:BPMNShape>
