        <omgdc:Bounds x="1425" y="373" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubTask_1stIntakerPlanMeeting_di" bpmnElement="SubTask_1stIntakerPlanMeeting">
        <omgdc:Bounds x="1490" y="330" width="90" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubTask_1stIntakerExamine_di" bpmnElement="SubTask_1stIntakerExamine">
        <omgdc:Bounds x="1600" y="330" width="90" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubTask_1stIntakerFileNotes_di" bpmnElement="SubTask_1stIntakerFileNotes">
        <omgdc:Bounds x="1710" y="330" width="90" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubTask_2ndIntakerPlanMeeting_di" bpmnElement="SubTask_2ndIntakerPlanMeeting">
        <omgdc:Bounds x="1490" y="415" width="90" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubTask_2ndIntakerRecordDictaphone_di" bpmnElement="SubTask_2ndIntakerRecordDictaphone">
        <omgdc:Bounds x="1600" y="415" width="90" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubTask_TypeOutTapes_di" bpmnElement="SubTask_TypeOutTapes">
        <omgdc:Bounds x="1710" y="415" width="90" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubGateway_Join_di" bpmnElement="SubGateway_Join">
        <omgdc:Bounds x="1825" y="373" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubEnd_Meetings_di" bpmnElement="SubEnd_Meetings">
        <omgdc:Bounds x="1892" y="380" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Final Nodes in Secretarial Office -->
      <bpmndi:BPMNShape id="Task_ProvideListToTeamLeader_di" bpmnElement="Task_ProvideListToTeamLeader">
        <omgdc:Bounds x="2000" y="365" width="100" height="80" />
      </bpmndi:BPMNShape>
