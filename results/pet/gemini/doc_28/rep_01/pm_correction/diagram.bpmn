<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_secretarial_office_part" name="Secretarial Office" processRef="pool_secretarial_office_proc" />
    <bpmn:participant id="pool_nursing_officer_part" name="Nursing Officer" processRef="pool_nursing_officer_proc" />
    <bpmn:participant id="pool_medical_team_part" name="Medical Team / Staff Meeting" processRef="pool_medical_team_proc" />
    <bpmn:participant id="pool_first_intaker_part" name="First Intaker (Social-Medical Worker)" processRef="pool_first_intaker_proc" />
    <bpmn:participant id="pool_second_intaker_part" name="Second Intaker (Physician)" processRef="pool_second_intaker_proc" />
    <bpmn:messageFlow id="mf_call_transfer" sourceRef="evt_call_transferred" targetRef="evt_start_nursing" name="Transferred Call" />
    <bpmn:messageFlow id="mf_hand_in_form" sourceRef="evt_form_handed_in" targetRef="evt_receive_reg_form" name="Registration Form" />
    <bpmn:messageFlow id="mf_assignment_list" sourceRef="evt_assignment_list_sent" targetRef="evt_receive_assignment_list" name="Assignment List" />
    <bpmn:messageFlow id="mf_reg_card_1st" sourceRef="evt_reg_card_sent_1st" targetRef="evt_receive_reg_card_1st" name="Registration Card 1" />
    <bpmn:messageFlow id="mf_reg_card_2nd" sourceRef="evt_reg_card_sent_2nd" targetRef="evt_receive_reg_card_2nd" name="Registration Card 2" />
    <bpmn:messageFlow id="mf_notify_2nd" sourceRef="evt_notify_2nd_intaker" targetRef="evt_receive_med_info_notification" name="Medical File Notification" />
    <bpmn:messageFlow id="mf_dictaphone_tape" sourceRef="evt_dictaphone_tape_sent" targetRef="evt_receive_dictaphone_tape" name="Dictaphone Tape" />
    <bpmn:messageFlow id="mf_ready_list" sourceRef="evt_ready_for_meeting_sent" targetRef="evt_receive_ready_patients_list" name="Ready Patients List" />
  </bpmn:collaboration>
  <bpmn:process id="pool_secretarial_office_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_registration_form_p1" name="Registration Form" dataObjectRef="doc_registration_form_p1_do" />
    <bpmn:dataObject id="doc_registration_form_p1_do" />
    <bpmn:dataStoreReference id="sys_info_system" name="Information System" />
    <bpmn:dataObjectReference id="doc_printed_info" name="Information System Printout" dataObjectRef="doc_printed_info_do" />
    <bpmn:dataObject id="doc_printed_info_do" />
    <bpmn:dataObjectReference id="doc_patient_file" name="Patient File" dataObjectRef="doc_patient_file_do" />
    <bpmn:dataObject id="doc_patient_file_do" />
    <bpmn:dataObjectReference id="doc_registration_card_1" name="Registration Card (1st Intaker)" dataObjectRef="doc_registration_card_1_do" />
    <bpmn:dataObject id="doc_registration_card_1_do" />
    <bpmn:dataObjectReference id="doc_registration_card_2" name="Registration Card (2nd Intaker)" dataObjectRef="doc_registration_card_2_do" />
    <bpmn:dataObject id="doc_registration_card_2_do" />
    <bpmn:dataObjectReference id="doc_new_notices_list" name="List of New Notices" dataObjectRef="doc_new_notices_list_do" />
    <bpmn:dataObject id="doc_new_notices_list_do" />
    <bpmn:dataObjectReference id="doc_assignment_list_p1" name="Assignment List" dataObjectRef="doc_assignment_list_p1_do" />
    <bpmn:dataObject id="doc_assignment_list_p1_do" />
    <bpmn:dataObjectReference id="doc_request_letter" name="Medical File Request Letter" dataObjectRef="doc_request_letter_do" />
    <bpmn:dataObject id="doc_request_letter_do" />
    <bpmn:dataObjectReference id="doc_ready_patients_list" name="List of Completed Intake Patients" dataObjectRef="doc_ready_patients_list_do" />
    <bpmn:dataObject id="doc_ready_patients_list_do" />
    <bpmn:startEvent id="evt_start_notice" name="Telephone notice received">
      <bpmn:outgoing>sf_sec_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_notice_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_call_transferred" name="Doctor transferred to nursing officer">
      <bpmn:incoming>sf_sec_3</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_call_transferred_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_receive_reg_form" name="Registration form received">
      <bpmn:outgoing>sf_sec_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_reg_form_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_receive_assignment_list" name="Assignment list received">
      <bpmn:incoming>sf_sec_8</bpmn:incoming>
      <bpmn:outgoing>sf_sec_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_assignment_list_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_reg_card_sent_1st" name="Registration card sent to 1st intaker">
      <bpmn:incoming>sf_sec_req_no</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_reg_card_sent_1st_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_reg_card_sent_2nd" name="Registration card sent to 2nd intaker">
      <bpmn:incoming>sf_sec_req_2nd</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_reg_card_sent_2nd_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_req_letter_sent" name="Request letter sent to family doctor">
      <bpmn:incoming>sf_sec_12</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_req_letter_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_receive_dictaphone_tape" name="Dictaphone tape received">
      <bpmn:outgoing>sf_sec_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_dictaphone_tape_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_med_file_received" name="Medical file copy received from doctor">
      <bpmn:outgoing>sf_sec_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_med_file_received_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_notify_2nd_intaker" name="Notification sent to 2nd intaker">
      <bpmn:incoming>sf_sec_14</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_notify_2nd_intaker_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_ready_for_meeting_sent" name="Patient list for staff meeting provided">
      <bpmn:incoming>sf_sec_18</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_ready_for_meeting_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_inquire_patient_info" name="Inquire name and residence of patient">
      <bpmn:incoming>sf_sec_1</bpmn:incoming>
      <bpmn:outgoing>sf_sec_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_put_through_doctor" name="Put doctor through to responsible nursing officer">
      <bpmn:incoming>sf_sec_2</bpmn:incoming>
      <bpmn:outgoing>sf_sec_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_store_and_print_info" name="Store information in information system and print">
      <bpmn:incoming>sf_sec_4</bpmn:incoming>
      <bpmn:outgoing>sf_sec_5</bpmn:outgoing>
      <bpmn:property id="task_store_and_print_info_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_and_print_info_dia0">
        <bpmn:sourceRef>doc_registration_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_and_print_info_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_and_print_info_doa0">
        <bpmn:targetRef>sys_info_system</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_store_and_print_info_doa1">
        <bpmn:targetRef>doc_printed_info</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_patient_file" name="Create patient file and store form &amp; print">
      <bpmn:incoming>sf_sec_5</bpmn:incoming>
      <bpmn:outgoing>sf_sec_6</bpmn:outgoing>
      <bpmn:property id="task_create_patient_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_patient_file_dia0">
        <bpmn:sourceRef>doc_registration_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_create_patient_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_create_patient_file_dia1">
        <bpmn:sourceRef>doc_printed_info</bpmn:sourceRef>
        <bpmn:targetRef>task_create_patient_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_patient_file_doa0">
        <bpmn:targetRef>doc_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_produce_reg_cards" name="Produce two registration cards for intakers">
      <bpmn:incoming>sf_sec_6</bpmn:incoming>
      <bpmn:outgoing>sf_sec_7</bpmn:outgoing>
      <bpmn:property id="task_produce_reg_cards_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_produce_reg_cards_dia0">
        <bpmn:sourceRef>doc_patient_file</bpmn:sourceRef>
        <bpmn:targetRef>task_produce_reg_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_produce_reg_cards_doa0">
        <bpmn:targetRef>doc_registration_card_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_produce_reg_cards_doa1">
        <bpmn:targetRef>doc_registration_card_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_add_to_new_notices_list" name="Add new patient on the list of new notices">
      <bpmn:incoming>sf_sec_7</bpmn:incoming>
      <bpmn:outgoing>sf_sec_8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_add_to_new_notices_list_doa0">
        <bpmn:targetRef>doc_new_notices_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_store_assignments" name="Store assignment of each patient in information system">
      <bpmn:incoming>sf_sec_9</bpmn:incoming>
      <bpmn:outgoing>sf_sec_10</bpmn:outgoing>
      <bpmn:property id="task_store_assignments_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_assignments_dia0">
        <bpmn:sourceRef>doc_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_assignments_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_assignments_doa0">
        <bpmn:targetRef>sys_info_system</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_pass_reg_cards" name="Pass produced registration cards to intakers">
      <bpmn:incoming>sf_sec_10</bpmn:incoming>
      <bpmn:outgoing>sf_sec_11</bpmn:outgoing>
      <bpmn:outgoing>sf_sec_req_2nd</bpmn:outgoing>
      <bpmn:property id="task_pass_reg_cards_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_pass_reg_cards_dia0">
        <bpmn:sourceRef>doc_registration_card_1</bpmn:sourceRef>
        <bpmn:targetRef>task_pass_reg_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_pass_reg_cards_dia1">
        <bpmn:sourceRef>doc_registration_card_2</bpmn:sourceRef>
        <bpmn:targetRef>task_pass_reg_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_prepare_send_request_letter" name="Prepare and send letter requesting copy of medical file">
      <bpmn:incoming>sf_sec_req_yes</bpmn:incoming>
      <bpmn:outgoing>sf_sec_12</bpmn:outgoing>
      <bpmn:property id="task_prepare_send_request_letter_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prepare_send_request_letter_dia0">
        <bpmn:sourceRef>doc_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_prepare_send_request_letter_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_prepare_send_request_letter_doa0">
        <bpmn:targetRef>doc_request_letter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_process_received_med_file" name="Inform 2nd intaker and add copy to patient file">
      <bpmn:incoming>sf_sec_13</bpmn:incoming>
      <bpmn:outgoing>sf_sec_14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_process_received_med_file_doa0">
        <bpmn:targetRef>doc_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_type_out_tapes" name="Type out dictaphone tapes and add information to patient file">
      <bpmn:incoming>sf_sec_15</bpmn:incoming>
      <bpmn:outgoing>sf_sec_16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_type_out_tapes_doa0">
        <bpmn:targetRef>doc_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_update_status_and_list" name="Put patient on list of patients reaching completed status">
      <bpmn:incoming>sf_sec_16</bpmn:incoming>
      <bpmn:outgoing>sf_sec_17</bpmn:outgoing>
      <bpmn:property id="task_update_status_and_list_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_update_status_and_list_dia0">
        <bpmn:sourceRef>doc_patient_file</bpmn:sourceRef>
        <bpmn:targetRef>task_update_status_and_list_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_update_status_and_list_doa0">
        <bpmn:targetRef>doc_ready_patients_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_provide_ready_list" name="Provide team-leader with list of completed patients for Wednesday meeting">
      <bpmn:incoming>sf_sec_17</bpmn:incoming>
      <bpmn:outgoing>sf_sec_18</bpmn:outgoing>
      <bpmn:property id="task_provide_ready_list_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_provide_ready_list_dia0">
        <bpmn:sourceRef>doc_ready_patients_list</bpmn:sourceRef>
        <bpmn:targetRef>task_provide_ready_list_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_med_file_required" name="Medical file required?" isMarkerVisible="true">
      <bpmn:incoming>sf_sec_11</bpmn:incoming>
      <bpmn:outgoing>sf_sec_req_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_sec_req_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_sec_1" sourceRef="evt_start_notice" targetRef="task_inquire_patient_info" />
    <bpmn:sequenceFlow id="sf_sec_2" sourceRef="task_inquire_patient_info" targetRef="task_put_through_doctor" />
    <bpmn:sequenceFlow id="sf_sec_3" sourceRef="task_put_through_doctor" targetRef="evt_call_transferred" />
    <bpmn:sequenceFlow id="sf_sec_4" sourceRef="evt_receive_reg_form" targetRef="task_store_and_print_info" />
    <bpmn:sequenceFlow id="sf_sec_5" sourceRef="task_store_and_print_info" targetRef="task_create_patient_file" />
    <bpmn:sequenceFlow id="sf_sec_6" sourceRef="task_create_patient_file" targetRef="task_produce_reg_cards" />
    <bpmn:sequenceFlow id="sf_sec_7" sourceRef="task_produce_reg_cards" targetRef="task_add_to_new_notices_list" />
    <bpmn:sequenceFlow id="sf_sec_8" sourceRef="task_add_to_new_notices_list" targetRef="evt_receive_assignment_list" />
    <bpmn:sequenceFlow id="sf_sec_9" sourceRef="evt_receive_assignment_list" targetRef="task_store_assignments" />
    <bpmn:sequenceFlow id="sf_sec_10" sourceRef="task_store_assignments" targetRef="task_pass_reg_cards" />
    <bpmn:sequenceFlow id="sf_sec_11" sourceRef="task_pass_reg_cards" targetRef="gw_med_file_required" />
    <bpmn:sequenceFlow id="sf_sec_req_yes" sourceRef="gw_med_file_required" targetRef="task_prepare_send_request_letter" name="Yes" />
    <bpmn:sequenceFlow id="sf_sec_req_no" sourceRef="gw_med_file_required" targetRef="evt_reg_card_sent_1st" name="No" />
    <bpmn:sequenceFlow id="sf_sec_req_2nd" sourceRef="task_pass_reg_cards" targetRef="evt_reg_card_sent_2nd" />
    <bpmn:sequenceFlow id="sf_sec_12" sourceRef="task_prepare_send_request_letter" targetRef="evt_req_letter_sent" />
    <bpmn:sequenceFlow id="sf_sec_13" sourceRef="evt_med_file_received" targetRef="task_process_received_med_file" />
    <bpmn:sequenceFlow id="sf_sec_14" sourceRef="task_process_received_med_file" targetRef="evt_notify_2nd_intaker" />
    <bpmn:sequenceFlow id="sf_sec_15" sourceRef="evt_receive_dictaphone_tape" targetRef="task_type_out_tapes" />
    <bpmn:sequenceFlow id="sf_sec_16" sourceRef="task_type_out_tapes" targetRef="task_update_status_and_list" />
    <bpmn:sequenceFlow id="sf_sec_17" sourceRef="task_update_status_and_list" targetRef="task_provide_ready_list" />
    <bpmn:sequenceFlow id="sf_sec_18" sourceRef="task_provide_ready_list" targetRef="evt_ready_for_meeting_sent" />
  </bpmn:process>
  <bpmn:process id="pool_nursing_officer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_registration_form" name="Registration Form" dataObjectRef="doc_registration_form_do" />
    <bpmn:dataObject id="doc_registration_form_do" />
    <bpmn:startEvent id="evt_start_nursing" name="Call received from doctor">
      <bpmn:outgoing>sf_nurse_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_nursing_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_form_handed_in" name="Registration form handed in">
      <bpmn:incoming>sf_nurse_3</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_form_handed_in_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_inquire_mental_state" name="Make full inquiry into mental, health, and social state of patient">
      <bpmn:incoming>sf_nurse_1</bpmn:incoming>
      <bpmn:outgoing>sf_nurse_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_inquire_mental_state_doa0">
        <bpmn:targetRef>doc_registration_form</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_hand_in_form" name="Hand in registration form at secretarial office">
      <bpmn:incoming>sf_nurse_2</bpmn:incoming>
      <bpmn:outgoing>sf_nurse_3</bpmn:outgoing>
      <bpmn:property id="task_hand_in_form_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_hand_in_form_dia0">
        <bpmn:sourceRef>doc_registration_form</bpmn:sourceRef>
        <bpmn:targetRef>task_hand_in_form_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="sf_nurse_1" sourceRef="evt_start_nursing" targetRef="task_inquire_mental_state" />
    <bpmn:sequenceFlow id="sf_nurse_2" sourceRef="task_inquire_mental_state" targetRef="task_hand_in_form" />
    <bpmn:sequenceFlow id="sf_nurse_3" sourceRef="task_hand_in_form" targetRef="evt_form_handed_in" />
  </bpmn:process>
  <bpmn:process id="pool_medical_team_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_new_notices_list_p1" name="List of New Notices" dataObjectRef="doc_new_notices_list_p1_do" />
    <bpmn:dataObject id="doc_new_notices_list_p1_do" />
    <bpmn:dataObjectReference id="doc_assignment_list" name="Assignment List" dataObjectRef="doc_assignment_list_do" />
    <bpmn:dataObject id="doc_assignment_list_do" />
    <bpmn:dataObjectReference id="doc_ready_patients_list_p1" name="List of Completed Intake Patients" dataObjectRef="doc_ready_patients_list_p1_do" />
    <bpmn:dataObject id="doc_ready_patients_list_p1_do" />
    <bpmn:dataObjectReference id="doc_patient_file_p2" name="Patient File" dataObjectRef="doc_patient_file_p2_do" />
    <bpmn:dataObject id="doc_patient_file_p2_do" />
    <bpmn:dataObjectReference id="doc_treatment_plan" name="Treatment Plan" dataObjectRef="doc_treatment_plan_do" />
    <bpmn:dataObject id="doc_treatment_plan_do" />
    <bpmn:endEvent id="evt_assignment_list_sent" name="Assignment list completed">
      <bpmn:incoming>sf_team_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_assignment_list_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_receive_ready_patients_list" name="Ready patients list received">
      <bpmn:outgoing>sf_team_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_ready_patients_list_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_intake" name="Intake procedure completed">
      <bpmn:incoming>sf_team_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_team_assignment" name="Start team assignment">
      <bpmn:outgoing>sf_team_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_assign_intakers" name="Assign new patients to 1st and 2nd intakers">
