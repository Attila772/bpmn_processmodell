<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_sp_part" name="SP / PU / GO" processRef="pool_sp_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:messageFlow id="mf_change_request" sourceRef="evt_end_req_sent" targetRef="evt_start_mpo_req" name="Change Request" />
    <bpmn:messageFlow id="mf_rejection" sourceRef="evt_end_mpo_rejected" targetRef="evt_start_sp_rejected" name="Rejection Notification" />
    <bpmn:messageFlow id="mf_implementation" sourceRef="evt_end_mpo_impl" targetRef="evt_start_sp_impl" name="Implementation Report" />
    <bpmn:messageFlow id="mf_failure" sourceRef="evt_end_mpo_failed" targetRef="evt_start_sp_failed" name="Failure Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_sp_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_change_request" name="Change Request" dataObjectRef="data_change_request_do" />
    <bpmn:dataObject id="data_change_request_do" />
    <bpmn:startEvent id="evt_start_sp" name="Change requested by SP / PU / GO">
      <bpmn:outgoing>sf_sp1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_req_sent" name="Send change request">
      <bpmn:incoming>sf_sp2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_req_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_sp_rejected" name="Receive rejection">
      <bpmn:outgoing>sf_sp_rej1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_sp_rejected_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_sp_rejected" name="Request rejected">
      <bpmn:incoming>sf_sp_rej1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_sp_impl" name="Receive implementation report">
      <bpmn:outgoing>sf_sp_imp1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_sp_impl_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_sp_impl" name="Change completed">
      <bpmn:incoming>sf_sp_imp1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_sp_failed" name="Receive failure notification">
      <bpmn:outgoing>sf_sp_fail1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_sp_failed_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_sp_failed" name="Change failed">
      <bpmn:incoming>sf_sp_fail1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_request_change" name="Request changes to MPO">
      <bpmn:incoming>sf_sp1</bpmn:incoming>
      <bpmn:outgoing>sf_sp2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_request_change_doa0">
        <bpmn:targetRef>data_change_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf_sp1" sourceRef="evt_start_sp" targetRef="task_request_change" />
    <bpmn:sequenceFlow id="sf_sp2" sourceRef="task_request_change" targetRef="evt_end_req_sent" />
    <bpmn:sequenceFlow id="sf_sp_rej1" sourceRef="evt_start_sp_rejected" targetRef="evt_end_sp_rejected" />
    <bpmn:sequenceFlow id="sf_sp_imp1" sourceRef="evt_start_sp_impl" targetRef="evt_end_sp_impl" />
    <bpmn:sequenceFlow id="sf_sp_fail1" sourceRef="evt_start_sp_failed" targetRef="evt_end_sp_failed" />
  </bpmn:process>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_change_request_p1" name="Change Request" dataObjectRef="data_change_request_p1_do" />
    <bpmn:dataObject id="data_change_request_p1_do" />
    <bpmn:dataObjectReference id="data_impl_report" name="Implementation Report" dataObjectRef="data_impl_report_do" />
    <bpmn:dataObject id="data_impl_report_do" />
    <bpmn:dataObjectReference id="data_failure_notice" name="Failure Notification" dataObjectRef="data_failure_notice_do" />
    <bpmn:dataObject id="data_failure_notice_do" />
    <bpmn:startEvent id="evt_start_mpo_req" name="Receive change request from SP / PU / GO">
      <bpmn:outgoing>sf_mpo_start1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mpo_req_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_mpo_internal" name="Internal MPO change caused">
      <bpmn:outgoing>sf_mpo_start2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mpo_rejected" name="Send rejection notification">
      <bpmn:incoming>sf_reject_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mpo_rejected_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_mpo_impl" name="Send implementation report">
      <bpmn:incoming>sf_report_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mpo_impl_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_mpo_failed" name="Send failure notification">
      <bpmn:incoming>sf_notify_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mpo_failed_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_review_request" name="Review change request">
      <bpmn:incoming>sf_mpo_rev</bpmn:incoming>
      <bpmn:outgoing>sf_review_to_gw</bpmn:outgoing>
      <bpmn:property id="task_review_request_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_request_dia0">
        <bpmn:sourceRef>data_change_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_request_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_reject_request" name="Reject change of measuring point">
      <bpmn:incoming>sf_dec_reject</bpmn:incoming>
      <bpmn:outgoing>sf_reject_to_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_confirm_request" name="Confirm request">
      <bpmn:incoming>sf_dec_confirm</bpmn:incoming>
      <bpmn:outgoing>sf_confirm_to_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_perform_change" name="Perform measuring point change">
      <bpmn:incoming>sf_merge_to_perform</bpmn:incoming>
      <bpmn:outgoing>sf_perform_to_gw</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_report_impl" name="Report implementation to SP / PU / GO">
      <bpmn:incoming>sf_impl_success</bpmn:incoming>
      <bpmn:outgoing>sf_report_to_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_report_impl_doa0">
        <bpmn:targetRef>data_impl_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_notify_failure" name="Notify SP / PU / GO about failure of changes">
      <bpmn:incoming>sf_impl_failed</bpmn:incoming>
      <bpmn:outgoing>sf_notify_to_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_notify_failure_doa0">
        <bpmn:targetRef>data_failure_notice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_start_mpo" name="Source of Change" isMarkerVisible="true">
      <bpmn:incoming>sf_mpo_start1</bpmn:incoming>
      <bpmn:incoming>sf_mpo_start2</bpmn:incoming>
      <bpmn:outgoing>sf_mpo_rev</bpmn:outgoing>
      <bpmn:outgoing>sf_mpo_direct_change</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_review_decision" name="Request Accepted?" isMarkerVisible="true">
      <bpmn:incoming>sf_review_to_gw</bpmn:incoming>
      <bpmn:outgoing>sf_dec_reject</bpmn:outgoing>
      <bpmn:outgoing>sf_dec_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_merge_changes" name="Merge Change Triggers" isMarkerVisible="true">
      <bpmn:incoming>sf_mpo_direct_change</bpmn:incoming>
      <bpmn:incoming>sf_confirm_to_merge</bpmn:incoming>
      <bpmn:outgoing>sf_merge_to_perform</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_impl_result" name="Implementation Successful?" isMarkerVisible="true">
      <bpmn:incoming>sf_perform_to_gw</bpmn:incoming>
      <bpmn:outgoing>sf_impl_success</bpmn:outgoing>
      <bpmn:outgoing>sf_impl_failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_mpo_start1" sourceRef="evt_start_mpo_req" targetRef="gw_start_mpo" name="Requested by SP / PU / GO" />
    <bpmn:sequenceFlow id="sf_mpo_start2" sourceRef="evt_start_mpo_internal" targetRef="gw_start_mpo" name="Caused by MPO" />
    <bpmn:sequenceFlow id="sf_mpo_rev" sourceRef="gw_start_mpo" targetRef="task_review_request" name="Requested by SP / PU / GO" />
    <bpmn:sequenceFlow id="sf_mpo_direct_change" sourceRef="gw_start_mpo" targetRef="gw_merge_changes" name="Caused by MPO" />
    <bpmn:sequenceFlow id="sf_review_to_gw" sourceRef="task_review_request" targetRef="gw_review_decision" />
    <bpmn:sequenceFlow id="sf_dec_reject" sourceRef="gw_review_decision" targetRef="task_reject_request" name="Rejected" />
    <bpmn:sequenceFlow id="sf_reject_to_end" sourceRef="task_reject_request" targetRef="evt_end_mpo_rejected" />
    <bpmn:sequenceFlow id="sf_dec_confirm" sourceRef="gw_review_decision" targetRef="task_confirm_request" name="Confirmed" />
    <bpmn:sequenceFlow id="sf_confirm_to_merge" sourceRef="task_confirm_request" targetRef="gw_merge_changes" />
    <bpmn:sequenceFlow id="sf_merge_to_perform" sourceRef="gw_merge_changes" targetRef="task_perform_change" />
    <bpmn:sequenceFlow id="sf_perform_to_gw" sourceRef="task_perform_change" targetRef="gw_impl_result" />
    <bpmn:sequenceFlow id="sf_impl_success" sourceRef="gw_impl_result" targetRef="task_report_impl" name="Success" />
    <bpmn:sequenceFlow id="sf_report_to_end" sourceRef="task_report_impl" targetRef="evt_end_mpo_impl" />
    <bpmn:sequenceFlow id="sf_impl_failed" sourceRef="gw_impl_result" targetRef="task_notify_failure" name="Failure" />
    <bpmn:sequenceFlow id="sf_notify_to_end" sourceRef="task_notify_failure" targetRef="evt_end_mpo_failed" />
  </bpmn:process>
