        <di:waypoint x="1252" y="380" />
      </bpmndi:BPMNEdge>

      <!-- Message Flow Edges -->
      <bpmndi:BPMNEdge id="MessageFlow_Request_di" bpmnElement="MessageFlow_Request">
        <di:waypoint x="250" y="140" />
        <di:waypoint x="250" y="382" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="259" y="163" width="82" height="14" />
