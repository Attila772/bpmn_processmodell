<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_MeasuringPointChange"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- Collaboration for choreography/interaction context -->
  <bpmn:collaboration id="Collaboration_01">
    <bpmn:participant id="Participant_MPO" name="Metering Point Operator (MPO)" processRef="Process_MPO_Change" />
    <bpmn:participant id="Participant_External" name="SP / PU / GO" />
    <bpmn:messageFlow id="MessageFlow_Request" name="Change Request" sourceRef="Participant_External" targetRef="StartEvent_RequestReceived" />
    <bpmn:messageFlow id="MessageFlow_Rejection" name="Rejection Notification" sourceRef="Task_RejectRequest" targetRef="Participant_External" />
    <bpmn:messageFlow id="MessageFlow_Confirmation" name="Confirmation Notification" sourceRef="Task_ConfirmRequest" targetRef="Participant_External" />
    <bpmn:messageFlow id="MessageFlow_Implementation" name="Implementation Report" sourceRef="Task_ReportImplementation" targetRef="Participant_External" />
    <bpmn:messageFlow id="MessageFlow_Failure" name="Failure Notification" sourceRef="Task_NotifyFailure" targetRef="Participant_External" />
  </bpmn:collaboration>

  <!-- Process definition for MPO -->
  <bpmn:process id="Process_MPO_Change" name="Measuring Point Change Process" isExecutable="true">
    
    <!-- Start Events -->
    <bpmn:startEvent id="StartEvent_InternalTrigger" name="MPO Causes Change">
      <bpmn:outgoing>SequenceFlow_InternalToMerge</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_RequestReceived" name="Change Request Received from SP/PU/GO">
      <bpmn:messageEventDefinition id="MessageEventDefinition_01" />
      <bpmn:outgoing>SequenceFlow_RequestToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Review Phase -->
    <bpmn:userTask id="Task_ReviewRequest" name="Review Change Request">
      <bpmn:incoming>SequenceFlow_RequestToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToGatewayDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Review Decision?">
      <bpmn:incoming>SequenceFlow_ReviewToGatewayDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionToReject</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DecisionToConfirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A: Rejection -->
    <bpmn:sendTask id="Task_RejectRequest" name="Reject Change Request">
      <bpmn:incoming>SequenceFlow_DecisionToReject</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectToEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="Change Request Rejected">
      <bpmn:incoming>SequenceFlow_RejectToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path B: Confirmation & Merge -->
    <bpmn:sendTask id="Task_ConfirmRequest" name="Confirm Change Request">
      <bpmn:incoming>SequenceFlow_DecisionToConfirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmToMerge</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:exclusiveGateway id="Gateway_MergeTriggers" name="Merge Triggers">
      <bpmn:incoming>SequenceFlow_InternalToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConfirmToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToPerform</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Execution Phase -->
    <bpmn:serviceTask id="Task_PerformChange" name="Perform Measuring Point Change">
      <bpmn:incoming>SequenceFlow_MergeToPerform</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PerformToOutcome</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ExecutionOutcome" name="Change Successful?">
      <bpmn:incoming>SequenceFlow_PerformToOutcome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OutcomeToSuccess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OutcomeToFailure</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Outcomes -->
    <bpmn:sendTask id="Task_ReportImplementation" name="Report Implementation">
      <bpmn:incoming>SequenceFlow_OutcomeToSuccess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportToEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Completed" name="Change Implemented">
      <bpmn:incoming>SequenceFlow_ReportToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_NotifyFailure" name="Notify Failure of Changes">
      <bpmn:incoming>SequenceFlow_OutcomeToFailure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailureToEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Failed" name="Change Failed">
      <bpmn:incoming>SequenceFlow_FailureToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InternalToMerge" sourceRef="StartEvent_InternalTrigger" targetRef="Gateway_MergeTriggers" />
    <bpmn:sequenceFlow id="SequenceFlow_RequestToReview" sourceRef="StartEvent_RequestReceived" targetRef="Task_ReviewRequest" />
    <bpmn:sequenceFlow id="SequenceFlow_ReviewToGatewayDecision" sourceRef="Task_ReviewRequest" targetRef="Gateway_ReviewDecision" />
    <bpmn:sequenceFlow id="SequenceFlow_DecisionToReject" name="Rejected" sourceRef="Gateway_ReviewDecision" targetRef="Task_RejectRequest" />
    <bpmn:sequenceFlow id="SequenceFlow_DecisionToConfirm" name="Confirmed" sourceRef="Gateway_ReviewDecision" targetRef="Task_ConfirmRequest" />
    <bpmn:sequenceFlow id="SequenceFlow_RejectToEnd" sourceRef="Task_RejectRequest" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmToMerge" sourceRef="Task_ConfirmRequest" targetRef="Gateway_MergeTriggers" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeToPerform" sourceRef="Gateway_MergeTriggers" targetRef="Task_PerformChange" />
    <bpmn:sequenceFlow id="SequenceFlow_PerformToOutcome" sourceRef="Task_PerformChange" targetRef="Gateway_ExecutionOutcome" />
    <bpmn:sequenceFlow id="SequenceFlow_OutcomeToSuccess" name="Yes" sourceRef="Gateway_ExecutionOutcome" targetRef="Task_ReportImplementation" />
    <bpmn:sequenceFlow id="SequenceFlow_OutcomeToFailure" name="No" sourceRef="Gateway_ExecutionOutcome" targetRef="Task_NotifyFailure" />
    <bpmn:sequenceFlow id="SequenceFlow_ReportToEnd" sourceRef="Task_ReportImplementation" targetRef="EndEvent_Completed" />
    <bpmn:sequenceFlow id="SequenceFlow_FailureToEnd" sourceRef="Task_NotifyFailure" targetRef="EndEvent_Failed" />

  </bpmn:process>

  <!-- BPMN Diagram Layout -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_01">
      
