      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ReviewToGatewayDecision_di" bpmnElement="SequenceFlow_ReviewToGatewayDecision">
        <di:waypoint x="420" y="400" />
