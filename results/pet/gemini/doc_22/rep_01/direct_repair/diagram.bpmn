      <!-- MPO Sequence Flows -->
      <bpmndi:BPMNEdge id="SequenceFlow_MPO_2_di" bpmnElement="SequenceFlow_MPO_2">
        <di:waypoint x="338" y="420" />
        <di:waypoint x="380" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_MPO_3_di" bpmnElement="SequenceFlow_MPO_3">
        <di:waypoint x="480" y="420" />
        <di:waypoint x="515" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_Rejected_di" bpmnElement="SequenceFlow_Rejected">
        <di:waypoint x="565" y="420" />
        <di:waypoint x="610" y="420" />
        <bpmndi:BPMNLabel>
