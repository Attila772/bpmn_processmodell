        <di:waypoint x="952" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_SP_8_di" bpmnElement="SequenceFlow_SP_8">
        <di:waypoint x="875" y="235" />
        <di:waypoint x="875" y="250" />
        <di:waypoint x="952" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_SP_9_di" bpmnElement="SequenceFlow_SP_9">
        <di:waypoint x="988" y="160" />
        <di:waypoint x="1052" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_SP_10_di" bpmnElement="SequenceFlow_SP_10">
