      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_SP_Completed_di" bpmnElement="End_SP_Completed">
        <dc:Bounds x="1052" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1038" y="185" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_SP_Failed_di" bpmnElement="End_SP_Failed">
        <dc:Bounds x="1052" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="275" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- SP Sequence Flows -->
      <bpmndi:BPMNEdge id="SequenceFlow_SP_1_di" bpmnElement="SequenceFlow_SP_1">
        <di:waypoint x="248" y="170" />
        <di:waypoint x="300" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_SP_2_di" bpmnElement="SequenceFlow_SP_2">
