        <bpmndi:BPMNLabel>
          <dc:Bounds x="627" y="145" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_ConfirmationReceived_di" bpmnElement="Event_ConfirmationReceived">
