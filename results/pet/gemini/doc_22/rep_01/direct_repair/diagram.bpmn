      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_Accepted_di" bpmnElement="SequenceFlow_Accepted">
        <di:waypoint x="540" y="445" />
        <di:waypoint x="540" y="530" />
        <di:waypoint x="610" y="530" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="546" y="485" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_MPO_4_di" bpmnElement="SequenceFlow_MPO_4">
        <di:waypoint x="710" y="420" />
        <di:waypoint x="752" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_MPO_5_di" bpmnElement="SequenceFlow_MPO_5">
        <di:waypoint x="710" y="530" />
        <di:waypoint x="745" y="530" />
      </bpmndi:BPMNEdge>
