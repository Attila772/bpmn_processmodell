      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_SP_4_di" bpmnElement="SequenceFlow_SP_4">
        <di:waypoint x="475" y="195" />
        <di:waypoint x="475" y="210" />
        <di:waypoint x="552" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_SP_5_di" bpmnElement="SequenceFlow_SP_5">
        <di:waypoint x="588" y="120" />
        <di:waypoint x="652" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_SP_6_di" bpmnElement="SequenceFlow_SP_6">
