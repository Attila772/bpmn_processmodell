      <bpmndi:BPMNShape id="Gateway_SP_ExecutionResult_di" bpmnElement="Gateway_SP_ExecutionResult" isMarkerVisible="true">
        <dc:Bounds x="850" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="836" y="155" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_SuccessReportReceived_di" bpmnElement="Event_SuccessReportReceived">
        <dc:Bounds x="952" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="932" y="104" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_FailureReportReceived_di" bpmnElement="Event_FailureReportReceived">
        <dc:Bounds x="952" y="232" width="36" height="36" />
