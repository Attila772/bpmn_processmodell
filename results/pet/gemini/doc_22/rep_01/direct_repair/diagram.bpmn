<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- Collaboration definition -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_SP_PU_GO" name="SP / PU / GO" processRef="Process_SP_PU_GO" />
    <bpmn:participant id="Participant_MPO" name="Meter Point Operator (MPO)" processRef="Process_MPO" />
    <bpmn:messageFlow id="MF_RequestChange" name="Change Request" sourceRef="Task_RequestChange" targetRef="Start_RequestReceived" />
    <bpmn:messageFlow id="MF_Rejection" name="Rejection Notification" sourceRef="Task_RejectRequest" targetRef="Event_RejectionReceived" />
    <bpmn:messageFlow id="MF_Confirmation" name="Confirmation Notification" sourceRef="Task_ConfirmRequest" targetRef="Event_ConfirmationReceived" />
    <bpmn:messageFlow id="MF_ReportSuccess" name="Success Report" sourceRef="Task_ReportImplementation" targetRef="Event_SuccessReportReceived" />
    <bpmn:messageFlow id="MF_ReportFailure" name="Failure Notification" sourceRef="Task_NotifyFailure" targetRef="Event_FailureReportReceived" />
  </bpmn:collaboration>

  <!-- Process: SP / PU / GO -->
  <bpmn:process id="Process_SP_PU_GO" isExecutable="false">
    <bpmn:startEvent id="Start_SP" name="Change Needed by SP/PU/GO">
      <bpmn:outgoing>SequenceFlow_SP_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_RequestChange" name="Request Change to Measuring Point">
      <bpmn:incoming>SequenceFlow_SP_1</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_SP_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_SP_Response" name="Await Response">
      <bpmn:incoming">SequenceFlow_SP_2</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_SP_3</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_SP_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_RejectionReceived" name="Rejection Received">
      <bpmn:incoming">SequenceFlow_SP_3</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_SP_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ConfirmationReceived" name="Confirmation Received">
      <bpmn:incoming">SequenceFlow_SP_4</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_SP_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_SP_Rejected" name="Request Rejected">
      <bpmn:incoming">SequenceFlow_SP_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="Gateway_SP_ExecutionResult" name="Await Execution Result">
      <bpmn:incoming">SequenceFlow_SP_6</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_SP_7</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_SP_8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_SuccessReportReceived" name="Success Report Received">
      <bpmn:incoming">SequenceFlow_SP_7</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_SP_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_FailureReportReceived" name="Failure Notification Received">
      <bpmn:incoming">SequenceFlow_SP_8</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_SP_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_SP_Completed" name="Change Implemented">
      <bpmn:incoming">SequenceFlow_SP_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_SP_Failed" name="Change Failed">
      <bpmn:incoming">SequenceFlow_SP_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_SP_1" sourceRef="Start_SP" targetRef="Task_RequestChange" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_2" sourceRef="Task_RequestChange" targetRef="Gateway_SP_Response" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_3" sourceRef="Gateway_SP_Response" targetRef="Event_RejectionReceived" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_4" sourceRef="Gateway_SP_Response" targetRef="Event_ConfirmationReceived" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_5" sourceRef="Event_RejectionReceived" targetRef="End_SP_Rejected" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_6" sourceRef="Event_ConfirmationReceived" targetRef="Gateway_SP_ExecutionResult" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_7" sourceRef="Gateway_SP_ExecutionResult" targetRef="Event_SuccessReportReceived" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_8" sourceRef="Gateway_SP_ExecutionResult" targetRef="Event_FailureReportReceived" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_9" sourceRef="Event_SuccessReportReceived" targetRef="End_SP_Completed" />
    <bpmn:sequenceFlow id="SequenceFlow_SP_10" sourceRef="Event_FailureReportReceived" targetRef="End_SP_Failed" />
  </bpmn:process>

  <!-- Process: MPO -->
  <bpmn:process id="Process_MPO" isExecutable="false">
    <bpmn:startEvent id="Start_MPO_Internal" name="MPO Internal Change Initiated">
      <bpmn:outgoing>SequenceFlow_MPO_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_RequestReceived" name="Change Request Received">
      <bpmn:outgoing">SequenceFlow_MPO_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_5" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewRequest" name="Review Change Request">
      <bpmn:incoming">SequenceFlow_MPO_2</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_MPO_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Request Acceptable?">
      <bpmn:incoming">SequenceFlow_MPO_3</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Accepted</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RejectRequest" name="Reject Change Request">
      <bpmn:incoming">SequenceFlow_Rejected</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_MPO_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_MPO_Rejected" name="Change Request Rejected">
      <bpmn:incoming">SequenceFlow_MPO_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_ConfirmRequest" name="Confirm Change Request">
      <bpmn:incoming">SequenceFlow_Accepted</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_MPO_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_MergeInitiation">
      <bpmn:incoming">SequenceFlow_MPO_1</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_MPO_5</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_MPO_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PerformChange" name="Perform Measuring Point Change">
      <bpmn:incoming">SequenceFlow_MPO_6</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_MPO_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ExecutionOutcome" name="Change Successful?">
      <bpmn:incoming">SequenceFlow_MPO_7</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Success</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_ReportImplementation" name="Report Implementation to SP / PU / GO">
      <bpmn:incoming">SequenceFlow_Success</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_MPO_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_NotifyFailure" name="Notify Failure to SP / PU / GO">
      <bpmn:incoming">SequenceFlow_Failed</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_MPO_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_MPO_Success" name="Change Completed">
      <bpmn:incoming">SequenceFlow_MPO_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_MPO_Failure" name="Change Execution Failed">
      <bpmn:incoming">SequenceFlow_MPO_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_MPO_1" sourceRef="Start_MPO_Internal" targetRef="Gateway_MergeInitiation" />
    <bpmn:sequenceFlow id="SequenceFlow_MPO_2" sourceRef="Start_RequestReceived" targetRef="Task_ReviewRequest" />
    <bpmn:sequenceFlow id="SequenceFlow_MPO_3" sourceRef="Task_ReviewRequest" targetRef="Gateway_ReviewDecision" />
    <bpmn:sequenceFlow id="SequenceFlow_Accepted" name="Yes" sourceRef="Gateway_ReviewDecision" targetRef="Task_ConfirmRequest" />
    <bpmn:sequenceFlow id="SequenceFlow_Rejected" name="No" sourceRef="Gateway_ReviewDecision" targetRef="Task_RejectRequest" />
    <bpmn:sequenceFlow id="SequenceFlow_MPO_4" sourceRef="Task_RejectRequest" targetRef="End_MPO_Rejected" />
    <bpmn:sequenceFlow id="SequenceFlow_MPO_5" sourceRef="Task_ConfirmRequest" targetRef="Gateway_MergeInitiation" />
    <bpmn:sequenceFlow id="SequenceFlow_MPO_6" sourceRef="Gateway_MergeInitiation" targetRef="Task_PerformChange" />
    <bpmn:sequenceFlow id="SequenceFlow_MPO_7" sourceRef="Task_PerformChange" targetRef="Gateway_ExecutionOutcome" />
    <bpmn:sequenceFlow id="SequenceFlow_Success" name="Yes" sourceRef="Gateway_ExecutionOutcome" targetRef="Task_ReportImplementation" />
    <bpmn:sequenceFlow id="SequenceFlow_Failed" name="No" sourceRef="Gateway_ExecutionOutcome" targetRef="Task_NotifyFailure" />
    <bpmn:sequenceFlow id="SequenceFlow_MPO_8" sourceRef="Task_ReportImplementation" targetRef="End_MPO_Success" />
    <bpmn:sequenceFlow id="SequenceFlow_MPO_9" sourceRef="Task_NotifyFailure" targetRef="End_MPO_Failure" />
  </bpmn:process>

  <!-- Diagram Interchange -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <!-- SP / PU / GO Pool -->
      <bpmndi:BPMNShape id="Participant_SP_PU_GO_di" bpmnElement="Participant_SP_PU_GO" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1200" height="240" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_SP_di" bpmnElement="Start_SP">
        <dc:Bounds x="212" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="189" y="195" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RequestChange_di" bpmnElement="Task_RequestChange">
