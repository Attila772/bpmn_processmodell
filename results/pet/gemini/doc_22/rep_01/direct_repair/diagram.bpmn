      <bpmndi:BPMNShape id="End_MPO_Rejected_di" bpmnElement="End_MPO_Rejected">
        <dc:Bounds x="752" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="728" y="445" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConfirmRequest_di" bpmnElement="Task_ConfirmRequest">
        <dc:Bounds x="610" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_MPO_Internal_di" bpmnElement="Start_MPO_Internal">
        <dc:Bounds x="212" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="191" y="645" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

