<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_VacationRequest"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  
  <bpmn:collaboration id="Collaboration_VacationRequest">
    <bpmn:participant id="Participant_VacationProcess" name="Vacation Request Process" processRef="Process_VacationRequest" />
  </bpmn:collaboration>

  <bpmn:process id="Process_VacationRequest" name="Vacation Request Process" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_VacationProcess">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_RequestSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRejectionReasons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Immediate Supervisor">
        <bpmn:flowNodeRef>Task_ApproveOrRejectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_NotifyHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteManagementProcedures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestSubmitted" name="Vacation Request Submitted">
      <bpmn:outgoing>Flow_StartToSupervisor</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flows from Start -->
    <bpmn:sequenceFlow id="Flow_StartToSupervisor" sourceRef="StartEvent_RequestSubmitted" targetRef="Task_ApproveOrRejectRequest" />

    <!-- Supervisor Tasks & Gateway -->
    <bpmn:userTask id="Task_ApproveOrRejectRequest" name="Approve or Reject Vacation Request">
      <bpmn:incoming>Flow_StartToSupervisor</bpmn:incoming>
      <bpmn:outgoing>Flow_SupervisorToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_SupervisorToGateway" sourceRef="Task_ApproveOrRejectRequest" targetRef="Gateway_ApprovalDecision" />

    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Request Approved?">
      <bpmn:incoming>Flow_SupervisorToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rejection Branch -->
    <bpmn:sequenceFlow id="Flow_Rejected" name="No (Rejected)" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ReviewRejectionReasons" />

    <bpmn:userTask id="Task_ReviewRejectionReasons" name="Review Rejection Reasons">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToRejectionEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_ReviewToRejectionEnd" sourceRef="Task_ReviewRejectionReasons" targetRef="EndEvent_RequestRejected" />

    <bpmn:endEvent id="EndEvent_RequestRejected" name="Vacation Request Rejected">
      <bpmn:incoming>Flow_ReviewToRejectionEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Approval Branch -->
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes (Approved)" sourceRef="Gateway_ApprovalDecision" targetRef="Task_NotifyHR" />

    <bpmn:sendTask id="Task_NotifyHR" name="Notify HR Representative">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToHRProcedures</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sequenceFlow id="Flow_NotifyToHRProcedures" sourceRef="Task_NotifyHR" targetRef="Task_CompleteManagementProcedures" />

    <bpmn:userTask id="Task_CompleteManagementProcedures" name="Complete Management Procedures">
      <bpmn:incoming>Flow_NotifyToHRProcedures</bpmn:incoming>
      <bpmn:outgoing>Flow_HRProceduresToApprovalEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_HRProceduresToApprovalEnd" sourceRef="Task_CompleteManagementProcedures" targetRef="EndEvent_RequestApproved" />

    <bpmn:endEvent id="EndEvent_RequestApproved" name="Vacation Request Processed">
      <bpmn:incoming>Flow_HRProceduresToApprovalEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_VacationRequest">
    <bpmndi:BPMNPlane id="BPMNPlane_VacationRequest" bpmnElement="Collaboration_VacationRequest">
      
      <!-- Process Participant / Pool -->
      <bpmndi:BPMNShape id="Participant_VacationProcess_di" bpmnElement="Participant_VacationProcess" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="910" height="480" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="880" height="150" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="880" height="170" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_HR_di" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="190" y="400" width="880" height="160" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_RequestSubmitted_di" bpmnElement="StartEvent_RequestSubmitted">
        <dc:Bounds x="242" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="217" y="175" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Supervisor Task -->
      <bpmndi:BPMNShape id="Task_ApproveOrRejectRequest_di" bpmnElement="Task_ApproveOrRejectRequest">
        <dc:Bounds x="330" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <!-- Gateway -->
      <bpmndi:BPMNShape id="Gateway_ApprovalDecision_di" bpmnElement="Gateway_ApprovalDecision" isMarkerVisible="true">
        <dc:Bounds x="485" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="483" y="350" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Review Rejection Task -->
      <bpmndi:BPMNShape id="Task_ReviewRejectionReasons_di" bpmnElement="Task_ReviewRejectionReasons">
        <dc:Bounds x="600" y="110" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <!-- End Event Rejected -->
      <bpmndi:BPMNShape id="EndEvent_RequestRejected_di" bpmnElement="EndEvent_RequestRejected">
        <dc:Bounds x="762" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="737" y="175" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Send Task (Notify HR) -->
      <bpmndi:BPMNShape id="Task_NotifyHR_di" bpmnElement="Task_NotifyHR">
        <dc:Bounds x="600" y="440" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <!-- Complete Procedures Task -->
      <bpmndi:BPMNShape id="Task_CompleteManagementProcedures_di" bpmnElement="Task_CompleteManagementProcedures">
        <dc:Bounds x="760" y="440" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <!-- End Event Approved -->
      <bpmndi:BPMNShape id="EndEvent_RequestApproved_di" bpmnElement="EndEvent_RequestApproved">
        <dc:Bounds x="922" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="897" y="505" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_StartToSupervisor_di" bpmnElement="Flow_StartToSupervisor">
        <di:waypoint x="278" y="150" />
        <di:waypoint x="304" y="150" />
        <di:waypoint x="304" y="315" />
        <di:waypoint x="330" y="315" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_SupervisorToGateway_di" bpmnElement="Flow_SupervisorToGateway">
        <di:waypoint x="430" y="315" />
        <di:waypoint x="485" y="315" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="510" y="290" />
        <di:waypoint x="510" y="150" />
        <di:waypoint x="600" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="521" y="218" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ReviewToRejectionEnd_di" bpmnElement="Flow_ReviewToRejectionEnd">
        <di:waypoint x="700" y="150" />
        <di:waypoint x="762" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="510" y="340" />
        <di:waypoint x="510" y="480" />
        <di:waypoint x="600" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="518" y="408" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_NotifyToHRProcedures_di" bpmnElement="Flow_NotifyToHRProcedures">
        <di:waypoint x="700" y="480" />
        <di:waypoint x="760" y="480" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_HRProceduresToApprovalEnd_di" bpmnElement="Flow_HRProceduresToApprovalEnd">
        <di:waypoint x="860" y="480" />
        <di:waypoint x="922" y="480" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
