<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_VacationProcess" name="Vacation Request Process" processRef="Process_VacationRequest" />
  </bpmn:collaboration>

  <bpmn:process id="Process_VacationRequest" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_RequestSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitVacationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRejectionReasons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Immediate Supervisor">
        <bpmn:flowNodeRef>Task_ApproveOrRejectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_NotifyHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteManagementProcedures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_RequestSubmitted" name="Vacation Needed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SubmitVacationRequest" name="Submit Vacation Request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ApproveOrRejectRequest" name="Approve or Reject Vacation Request">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Request Approved?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ReviewRejectionReasons" name="Review Rejection Reasons">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_RequestRejected" name="Vacation Request Rejected">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_NotifyHR" name="Generate HR Notification">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_CompleteManagementProcedures" name="Complete HR Management Procedures">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_RequestApproved" name="Vacation Request Processed">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_RequestSubmitted" targetRef="Task_SubmitVacationRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitVacationRequest" targetRef="Task_ApproveOrRejectRequest" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ApproveOrRejectRequest" targetRef="Gateway_ApprovalDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes" sourceRef="Gateway_ApprovalDecision" targetRef="Task_NotifyHR" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="No" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ReviewRejectionReasons" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_NotifyHR" targetRef="Task_CompleteManagementProcedures" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReviewRejectionReasons" targetRef="EndEvent_RequestRejected" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CompleteManagementProcedures" targetRef="EndEvent_RequestApproved" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_VacationProcess_di" bpmnElement="Participant_VacationProcess" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="980" height="490" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="950" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="950" height="170" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_HR_di" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="190" y="400" width="950" height="170" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_RequestSubmitted_di" bpmnElement="StartEvent_RequestSubmitted">
        <dc:Bounds x="242" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="220" y="175" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SubmitVacationRequest_di" bpmnElement="Task_SubmitVacationRequest">
        <dc:Bounds x="330" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ApproveOrRejectRequest_di" bpmnElement="Task_ApproveOrRejectRequest">
        <dc:Bounds x="330" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ApprovalDecision_di" bpmnElement="Gateway_ApprovalDecision" isMarkerVisible="true">
        <dc:Bounds x="485" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="483" y="255" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewRejectionReasons_di" bpmnElement="Task_ReviewRejectionReasons">
        <dc:Bounds x="610" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_RequestRejected_di" bpmnElement="EndEvent_RequestRejected">
        <dc:Bounds x="772" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="748" y="175" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyHR_di" bpmnElement="Task_NotifyHR">
        <dc:Bounds x="610" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CompleteManagementProcedures_di" bpmnElement="Task_CompleteManagementProcedures">
        <dc:Bounds x="770" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_RequestApproved_di" bpmnElement="EndEvent_RequestApproved">
        <dc:Bounds x="932" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="908" y="505" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="150" />
        <di:waypoint x="330" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="380" y="190" />
        <di:waypoint x="380" y="270" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="430" y="310" />
        <di:waypoint x="485" y="310" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="510" y="285" />
        <di:waypoint x="510" y="150" />
        <di:waypoint x="610" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="518" y="215" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="510" y="335" />
        <di:waypoint x="510" y="480" />
        <di:waypoint x="610" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="516" y="405" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="710" y="150" />
        <di:waypoint x="772" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="710" y="480" />
        <di:waypoint x="770" y="480" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="870" y="480" />
        <di:waypoint x="932" y="480" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
