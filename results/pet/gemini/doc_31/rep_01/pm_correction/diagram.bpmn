<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_employee_part" name="Employee" processRef="pool_employee_proc" />
    <bpmn:participant id="pool_supervisor_part" name="Immediate Supervisor" processRef="pool_supervisor_proc" />
    <bpmn:participant id="pool_hr_part" name="Human Resources Representative" processRef="pool_hr_proc" />
    <bpmn:messageFlow id="msg_flow_request" sourceRef="evt_send_request" targetRef="evt_receive_request" name="Vacation Request" />
    <bpmn:messageFlow id="msg_flow_rejection" sourceRef="evt_send_rejection" targetRef="evt_receive_rejection" name="Rejection Notice" />
    <bpmn:messageFlow id="msg_flow_approval" sourceRef="evt_send_approval_notification" targetRef="evt_receive_approval_notification" name="Approval Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_employee_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request" name="Vacation Request" dataObjectRef="data_vacation_request_do" />
    <bpmn:dataObject id="data_vacation_request_do" />
    <bpmn:dataObjectReference id="data_rejection_notice" name="Rejection Notice" dataObjectRef="data_rejection_notice_do" />
    <bpmn:dataObject id="data_rejection_notice_do" />
    <bpmn:startEvent id="evt_start_employee" name="Vacation Request Needed">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_rejection_reviewed" name="Rejection Processed">
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_send_request" name="Send Vacation Request">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_receive_rejection" name="Receive Rejection Notice">
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_rejection_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit_request" name="Submit vacation request">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_submit_request_doa0">
        <bpmn:targetRef>data_vacation_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_review_rejection" name="Review rejection reasons">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_review_rejection_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_rejection_dia0">
        <bpmn:sourceRef>data_rejection_notice</bpmn:sourceRef>
        <bpmn:targetRef>task_review_rejection_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_employee" targetRef="task_submit_request" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_submit_request" targetRef="evt_send_request" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="evt_receive_rejection" targetRef="task_review_rejection" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_review_rejection" targetRef="evt_end_rejection_reviewed" />
  </bpmn:process>
  <bpmn:process id="pool_supervisor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request_p1" name="Vacation Request" dataObjectRef="data_vacation_request_p1_do" />
    <bpmn:dataObject id="data_vacation_request_p1_do" />
    <bpmn:startEvent id="evt_receive_request" name="Receive Vacation Request">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_request_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_send_rejection" name="Send Rejection Notice">
      <bpmn:incoming>flow_rejected</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_rejection_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_send_approval_notification" name="Send Approval Notification">
      <bpmn:incoming>flow_approved</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_approval_notification_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_approve_reject" name="Approve or reject request">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_approve_reject_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_approve_reject_dia0">
        <bpmn:sourceRef>data_vacation_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_reject_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gtw_approval" name="Is request approved?" isMarkerVisible="true">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_rejected</bpmn:outgoing>
      <bpmn:outgoing>flow_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_3" sourceRef="evt_receive_request" targetRef="task_approve_reject" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_approve_reject" targetRef="gtw_approval" />
    <bpmn:sequenceFlow id="flow_rejected" sourceRef="gtw_approval" targetRef="evt_send_rejection" name="Rejected" />
    <bpmn:sequenceFlow id="flow_approved" sourceRef="gtw_approval" targetRef="evt_send_approval_notification" name="Approved" />
  </bpmn:process>
  <bpmn:process id="pool_hr_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_approval_notification" name="Approval Notification" dataObjectRef="data_approval_notification_do" />
    <bpmn:dataObject id="data_approval_notification_do" />
    <bpmn:endEvent id="evt_end_hr_completed" name="Vacation Approved and Processed">
      <bpmn:incoming>flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_receive_approval_notification" name="Receive Approval Notification">
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_approval_notification_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_hr_management" name="Complete management procedures">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:property id="task_hr_management_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_hr_management_dia0">
        <bpmn:sourceRef>data_approval_notification</bpmn:sourceRef>
        <bpmn:targetRef>task_hr_management_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_7" sourceRef="evt_receive_approval_notification" targetRef="task_hr_management" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_hr_management" targetRef="evt_end_hr_completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_employee_part_di" bpmnElement="pool_employee_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_supervisor_part_di" bpmnElement="pool_supervisor_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="950" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_hr_part_di" bpmnElement="pool_hr_part" isHorizontal="true">
        <dc:Bounds x="120" y="960" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_hr_completed_di" bpmnElement="evt_end_hr_completed">
        <dc:Bounds x="540" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_rejection_reviewed_di" bpmnElement="evt_end_rejection_reviewed">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_receive_approval_notification_di" bpmnElement="evt_receive_approval_notification">
        <dc:Bounds x="160" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_receive_rejection_di" bpmnElement="evt_receive_rejection">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_receive_request_di" bpmnElement="evt_receive_request">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_approval_notification_di" bpmnElement="evt_send_approval_notification">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_rejection_di" bpmnElement="evt_send_rejection">
        <dc:Bounds x="730" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_request_di" bpmnElement="evt_send_request">
        <dc:Bounds x="540" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_employee_di" bpmnElement="evt_start_employee">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_approval_di" bpmnElement="gtw_approval">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_reject_di" bpmnElement="task_approve_reject">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_hr_management_di" bpmnElement="task_hr_management">
        <dc:Bounds x="350" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_rejection_di" bpmnElement="task_review_rejection">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_request_di" bpmnElement="task_submit_request">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_di" bpmnElement="data_vacation_request">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_rejection_notice_di" bpmnElement="data_rejection_notice">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_p1_di" bpmnElement="data_vacation_request_p1">
        <dc:Bounds x="370" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_approval_notification_di" bpmnElement="data_approval_notification">
        <dc:Bounds x="370" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejected_di" bpmnElement="flow_rejected">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approved_di" bpmnElement="flow_approved">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7">
        <di:waypoint x="178" y="1038" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_8_di" bpmnElement="flow_8">
        <di:waypoint x="400" y="1060" />
        <di:waypoint x="558" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_request_di" bpmnElement="msg_flow_request">
        <di:waypoint x="558" y="243" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_rejection_di" bpmnElement="msg_flow_rejection">
        <di:waypoint x="748" y="703" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_approval_di" bpmnElement="msg_flow_approval">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_submit_request_doa0_di" bpmnElement="task_submit_request_doa0">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="388" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_review_rejection_dia0_di" bpmnElement="task_review_rejection_dia0">
        <di:waypoint x="388" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_approve_reject_dia0_di" bpmnElement="task_approve_reject_dia0">
        <di:waypoint x="388" y="850" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_hr_management_dia0_di" bpmnElement="task_hr_management_dia0">
        <di:waypoint x="388" y="1185" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>