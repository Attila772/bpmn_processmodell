<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_employee_part" name="Employee" processRef="pool_employee_proc" />
    <bpmn:participant id="pool_supervisor_part" name="Immediate Supervisor" processRef="pool_supervisor_proc" />
    <bpmn:participant id="pool_hr_part" name="Human Resources" processRef="pool_hr_proc" />
    <bpmn:messageFlow id="mf_submit_request" sourceRef="evt_send_req" targetRef="evt_rec_req" name="Vacation Request" />
    <bpmn:messageFlow id="mf_send_rejection" sourceRef="evt_send_rejection" targetRef="evt_rec_rejection" name="Rejection Notification" />
    <bpmn:messageFlow id="mf_send_approval" sourceRef="evt_send_approval" targetRef="evt_rec_approval" name="Approval Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_employee_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vac_req" name="Vacation Request" dataObjectRef="data_vac_req_do" />
    <bpmn:dataObject id="data_vac_req_do" />
    <bpmn:dataObjectReference id="data_rej_notif" name="Rejection Notification" dataObjectRef="data_rej_notif_do" />
    <bpmn:dataObject id="data_rej_notif_do" />
    <bpmn:startEvent id="evt_start_emp" name="Vacation request needed">
      <bpmn:outgoing>sf_emp_start_to_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_send_req" name="Vacation Request Submitted">
      <bpmn:incoming>sf_emp_submit_to_send</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_req_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_rec_rejection" name="Rejection Received">
      <bpmn:outgoing>sf_emp_rec_rej_to_review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_rec_rejection_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_review" name="Rejection Reviewed">
      <bpmn:incoming>sf_emp_review_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_submit_req" name="Submit vacation request">
      <bpmn:incoming>sf_emp_start_to_submit</bpmn:incoming>
      <bpmn:outgoing>sf_emp_submit_to_send</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_submit_req_doa0">
        <bpmn:targetRef>data_vac_req</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_review_rejection" name="Review rejection reasons">
      <bpmn:incoming>sf_emp_rec_rej_to_review</bpmn:incoming>
      <bpmn:outgoing>sf_emp_review_to_end</bpmn:outgoing>
      <bpmn:property id="task_review_rejection_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_rejection_dia0">
        <bpmn:sourceRef>data_rej_notif</bpmn:sourceRef>
        <bpmn:targetRef>task_review_rejection_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_emp_start_to_submit" sourceRef="evt_start_emp" targetRef="task_submit_req" />
    <bpmn:sequenceFlow id="sf_emp_submit_to_send" sourceRef="task_submit_req" targetRef="evt_send_req" />
    <bpmn:sequenceFlow id="sf_emp_rec_rej_to_review" sourceRef="evt_rec_rejection" targetRef="task_review_rejection" />
    <bpmn:sequenceFlow id="sf_emp_review_to_end" sourceRef="task_review_rejection" targetRef="evt_end_review" />
  </bpmn:process>
  <bpmn:process id="pool_supervisor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vac_req_p1" name="Vacation Request" dataObjectRef="data_vac_req_p1_do" />
    <bpmn:dataObject id="data_vac_req_p1_do" />
    <bpmn:startEvent id="evt_rec_req" name="Vacation Request Received">
      <bpmn:outgoing>sf_sup_rec_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_rec_req_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_send_rejection" name="Rejection Sent">
      <bpmn:incoming>sf_sup_to_rej</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_rejection_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_send_approval" name="Approval Notification Sent">
      <bpmn:incoming>sf_sup_to_app</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_approval_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_approve_reject" name="Approve or reject the request">
      <bpmn:incoming>sf_sup_rec_to_task</bpmn:incoming>
      <bpmn:outgoing>sf_sup_task_to_gw</bpmn:outgoing>
      <bpmn:property id="task_approve_reject_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_approve_reject_dia0">
        <bpmn:sourceRef>data_vac_req_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_reject_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_approval" name="Is request approved?" isMarkerVisible="true">
      <bpmn:incoming>sf_sup_task_to_gw</bpmn:incoming>
      <bpmn:outgoing>sf_sup_to_rej</bpmn:outgoing>
      <bpmn:outgoing>sf_sup_to_app</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_sup_rec_to_task" sourceRef="evt_rec_req" targetRef="task_approve_reject" />
    <bpmn:sequenceFlow id="sf_sup_task_to_gw" sourceRef="task_approve_reject" targetRef="gw_approval" />
    <bpmn:sequenceFlow id="sf_sup_to_rej" sourceRef="gw_approval" targetRef="evt_send_rejection" name="Rejected" />
    <bpmn:sequenceFlow id="sf_sup_to_app" sourceRef="gw_approval" targetRef="evt_send_approval" name="Approved" />
  </bpmn:process>
  <bpmn:process id="pool_hr_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_app_notif" name="Approval Notification" dataObjectRef="data_app_notif_do" />
    <bpmn:dataObject id="data_app_notif_do" />
    <bpmn:startEvent id="evt_rec_approval" name="Approval Notification Received">
      <bpmn:outgoing>sf_hr_rec_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_rec_approval_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_hr" name="Management Procedures Completed">
      <bpmn:incoming>sf_hr_task_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_complete_procedures" name="Complete management procedures">
      <bpmn:incoming>sf_hr_rec_to_task</bpmn:incoming>
      <bpmn:outgoing>sf_hr_task_to_end</bpmn:outgoing>
      <bpmn:property id="task_complete_procedures_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_complete_procedures_dia0">
        <bpmn:sourceRef>data_app_notif</bpmn:sourceRef>
        <bpmn:targetRef>task_complete_procedures_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_hr_rec_to_task" sourceRef="evt_rec_approval" targetRef="task_complete_procedures" />
    <bpmn:sequenceFlow id="sf_hr_task_to_end" sourceRef="task_complete_procedures" targetRef="evt_end_hr" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_employee_part_di" bpmnElement="pool_employee_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_supervisor_part_di" bpmnElement="pool_supervisor_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="950" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_hr_part_di" bpmnElement="pool_hr_part" isHorizontal="true">
        <dc:Bounds x="120" y="960" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_hr_di" bpmnElement="evt_end_hr">
        <dc:Bounds x="540" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_review_di" bpmnElement="evt_end_review">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_rec_approval_di" bpmnElement="evt_rec_approval">
        <dc:Bounds x="160" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_rec_rejection_di" bpmnElement="evt_rec_rejection">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_rec_req_di" bpmnElement="evt_rec_req">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_approval_di" bpmnElement="evt_send_approval">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_rejection_di" bpmnElement="evt_send_rejection">
        <dc:Bounds x="730" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_req_di" bpmnElement="evt_send_req">
        <dc:Bounds x="540" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_emp_di" bpmnElement="evt_start_emp">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_approval_di" bpmnElement="gw_approval">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_reject_di" bpmnElement="task_approve_reject">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_complete_procedures_di" bpmnElement="task_complete_procedures">
        <dc:Bounds x="350" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_rejection_di" bpmnElement="task_review_rejection">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_req_di" bpmnElement="task_submit_req">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vac_req_di" bpmnElement="data_vac_req">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_rej_notif_di" bpmnElement="data_rej_notif">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vac_req_p1_di" bpmnElement="data_vac_req_p1">
        <dc:Bounds x="370" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_app_notif_di" bpmnElement="data_app_notif">
        <dc:Bounds x="370" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf_emp_start_to_submit_di" bpmnElement="sf_emp_start_to_submit">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_emp_submit_to_send_di" bpmnElement="sf_emp_submit_to_send">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_emp_rec_rej_to_review_di" bpmnElement="sf_emp_rec_rej_to_review">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_emp_review_to_end_di" bpmnElement="sf_emp_review_to_end">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_sup_rec_to_task_di" bpmnElement="sf_sup_rec_to_task">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_sup_task_to_gw_di" bpmnElement="sf_sup_task_to_gw">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_sup_to_rej_di" bpmnElement="sf_sup_to_rej">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_sup_to_app_di" bpmnElement="sf_sup_to_app">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hr_rec_to_task_di" bpmnElement="sf_hr_rec_to_task">
        <di:waypoint x="178" y="1038" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hr_task_to_end_di" bpmnElement="sf_hr_task_to_end">
        <di:waypoint x="400" y="1060" />
        <di:waypoint x="558" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_submit_request_di" bpmnElement="mf_submit_request">
        <di:waypoint x="558" y="243" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_send_rejection_di" bpmnElement="mf_send_rejection">
        <di:waypoint x="748" y="703" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_send_approval_di" bpmnElement="mf_send_approval">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_submit_req_doa0_di" bpmnElement="task_submit_req_doa0">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="388" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_review_rejection_dia0_di" bpmnElement="task_review_rejection_dia0">
        <di:waypoint x="388" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_approve_reject_dia0_di" bpmnElement="task_approve_reject_dia0">
        <di:waypoint x="388" y="850" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_complete_procedures_dia0_di" bpmnElement="task_complete_procedures_dia0">
        <di:waypoint x="388" y="1185" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>