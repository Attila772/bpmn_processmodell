<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn">

  <!-- Collaboration definition with Pools and Lanes -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Insurer" name="Car Insurer" processRef="Process_Insurer" />
    <bpmn:messageFlow id="MF_SubmitClaim" name="Claim Documentation" sourceRef="Participant_Customer" targetRef="StartEvent_ClaimReceived" />
    <bpmn:messageFlow id="MF_SendLetter" name="Notification Letter" sourceRef="Task_SendLetter" targetRef="Participant_Customer" />
  </bpmn:collaboration>

  <!-- Empty Process for Customer Pool -->
  <bpmn:process id="Process_Customer" isExecutable="false" />

  <!-- Car Insurer Process -->
  <bpmn:process id="Process_Insurer" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Notification" name="Notification Department">
        <bpmn:flowNodeRef>StartEvent_ClaimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Handling" name="Handling Department">
        <bpmn:flowNodeRef>Task_CheckInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssessmentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClaimProcessed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim received">
      <bpmn:outgoing">SF_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <!-- Notification Department Tasks -->
    <bpmn:task id="Task_CheckCompleteness" name="Check documents for completeness">
      <bpmn:incoming">SF_1</bpmn:incoming>
      <bpmn:outgoing">SF_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RegisterClaim" name="Register claim">
      <bpmn:incoming">SF_2</bpmn:incoming>
      <bpmn:outgoing">SF_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Handling Department Tasks -->
    <bpmn:task id="Task_CheckInsurance" name="Check insurance">
      <bpmn:incoming">SF_3</bpmn:incoming>
      <bpmn:outgoing">SF_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PerformAssessment" name="Perform assessment">
      <bpmn:incoming">SF_4</bpmn:incoming>
      <bpmn:outgoing">SF_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Assessment Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_AssessmentOutcome" name="Assessment positive?">
      <bpmn:incoming">SF_5</bpmn:incoming>
      <bpmn:outgoing">SF_Positive</bpmn:outgoing>
      <bpmn:outgoing">SF_Negative</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Positive Path Tasks -->
    <bpmn:task id="Task_PhoneGarage" name="Phone garage to authorise repairs">
      <bpmn:incoming">SF_Positive</bpmn:incoming>
      <bpmn:outgoing">SF_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SchedulePayment" name="Schedule payment">
      <bpmn:incoming">SF_6</bpmn:incoming>
      <bpmn:outgoing">SF_7</bpmn:outgoing>
    </bpmn:task>

    <!-- Negative Path Task -->
    <bpmn:task id="Task_RejectClaim" name="Reject claim">
      <bpmn:incoming">SF_Negative</bpmn:incoming>
      <bpmn:outgoing">SF_8</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming">SF_7</bpmn:incoming>
      <bpmn:incoming">SF_8</bpmn:incoming>
      <bpmn:outgoing">SF_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Common Final Steps -->
    <bpmn:task id="Task_SendLetter" name="Send letter to customer">
      <bpmn:incoming">SF_9</bpmn:incoming>
      <bpmn:outgoing">SF_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ClaimProcessed" name="Claim process completed">
      <bpmn:incoming">SF_10</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_1" sourceRef="StartEvent_ClaimReceived" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="SF_2" sourceRef="Task_CheckCompleteness" targetRef="Task_RegisterClaim" />
    <bpmn:sequenceFlow id="SF_3" sourceRef="Task_RegisterClaim" targetRef="Task_CheckInsurance" />
    <bpmn:sequenceFlow id="SF_4" sourceRef="Task_CheckInsurance" targetRef="Task_PerformAssessment" />
    <bpmn:sequenceFlow id="SF_5" sourceRef="Task_PerformAssessment" targetRef="Gateway_AssessmentOutcome" />
    <bpmn:sequenceFlow id="SF_Positive" name="Yes" sourceRef="Gateway_AssessmentOutcome" targetRef="Task_PhoneGarage" />
    <bpmn:sequenceFlow id="SF_Negative" name="No" sourceRef="Gateway_AssessmentOutcome" targetRef="Task_RejectClaim" />
    <bpmn:sequenceFlow id="SF_6" sourceRef="Task_PhoneGarage" targetRef="Task_SchedulePayment" />
    <bpmn:sequenceFlow id="SF_7" sourceRef="Task_SchedulePayment" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="SF_8" sourceRef="Task_RejectClaim" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="SF_9" sourceRef="Gateway_Merge" targetRef="Task_SendLetter" />
    <bpmn:sequenceFlow id="SF_10" sourceRef="Task_SendLetter" targetRef="EndEvent_ClaimProcessed" />
  </bpmn:process>

  <!-- Visual Diagram Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <!-- Customer Pool -->
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="120" y="60" width="1380" height="100" />
      </bpmndi:BPMNShape>

      <!-- Insurer Pool -->
      <bpmndi:BPMNShape id="Participant_Insurer_di" bpmnElement="Participant_Insurer" isHorizontal="true">
        <dc:Bounds x="120" y="200" width="1380" height="380" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Notification_di" bpmnElement="Lane_Notification" isHorizontal="true">
        <dc:Bounds x="150" y="200" width="1350" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Handling_di" bpmnElement="Lane_Handling" isHorizontal="true">
        <dc:Bounds x="150" y="350" width="1350" height="230" />
      </bpmndi:BPMNShape>

      <!-- Notification Department Elements -->
      <bpmndi:BPMNShape id="StartEvent_ClaimReceived_di" bpmnElement="StartEvent_ClaimReceived">
        <dc:Bounds x="212" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="295" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckCompleteness_di" bpmnElement="Task_CheckCompleteness">
        <dc:Bounds x="290" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RegisterClaim_di" bpmnElement="Task_RegisterClaim">
        <dc:Bounds x="430" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Handling Department Elements -->
      <bpmndi:BPMNShape id="Task_CheckInsurance_di" bpmnElement="Task_CheckInsurance">
        <dc:Bounds x="430" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PerformAssessment_di" bpmnElement="Task_PerformAssessment">
        <dc:Bounds x="570" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_AssessmentOutcome_di" bpmnElement="Gateway_AssessmentOutcome" isMarkerVisible="true">
        <dc:Bounds x="715" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="709" y="405" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PhoneGarage_di" bpmnElement="Task_PhoneGarage">
        <dc:Bounds x="810" y="370" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SchedulePayment_di" bpmnElement="Task_SchedulePayment">
        <dc:Bounds x="950" y="370" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RejectClaim_di" bpmnElement="Task_RejectClaim">
        <dc:Bounds x="810" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="1095" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendLetter_di" bpmnElement="Task_SendLetter">
        <dc:Bounds x="1190" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ClaimProcessed_di" bpmnElement="EndEvent_ClaimProcessed">
        <dc:Bounds x="1342" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1325" y="485" width="71" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="SF_1_di" bpmnElement="SF_1">
        <di:waypoint x="248" y="270" />
        <di:waypoint x="290" y="270" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_2_di" bpmnElement="SF_2">
        <di:waypoint x="390" y="270" />
        <di:waypoint x="430" y="270" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_3_di" bpmnElement="SF_3">
        <di:waypoint x="480" y="310" />
        <di:waypoint x="480" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_4_di" bpmnElement="SF_4">
        <di:waypoint x="530" y="460" />
        <di:waypoint x="570" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_5_di" bpmnElement="SF_5">
        <di:waypoint x="670" y="460" />
        <di:waypoint x="715" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_Positive_di" bpmnElement="SF_Positive">
        <di:waypoint x="740" y="435" />
        <di:waypoint x="740" y="410" />
        <di:waypoint x="810" y="410" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="746" y="392" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_Negative_di" bpmnElement="SF_Negative">
        <di:waypoint x="740" y="485" />
        <di:waypoint x="740" y="520" />
        <di:waypoint x="810" y="520" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="748" y="523" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_6_di" bpmnElement="SF_6">
        <di:waypoint x="910" y="410" />
        <di:waypoint x="950" y="410" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_7_di" bpmnElement="SF_7">
        <di:waypoint x="1050" y="410" />
        <di:waypoint x="1120" y="410" />
        <di:waypoint x="1120" y="435" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_8_di" bpmnElement="SF_8">
        <di:waypoint x="910" y="520" />
        <di:waypoint x="1120" y="520" />
        <di:waypoint x="1120" y="485" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_9_di" bpmnElement="SF_9">
        <di:waypoint x="1145" y="460" />
        <di:waypoint x="1190" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SF_10_di" bpmnElement="SF_10">
        <di:waypoint x="1290" y="460" />
        <di:waypoint x="1342" y="460" />
      </bpmndi:BPMNEdge>

      <!-- Message Flow Edges -->
      <bpmndi:BPMNEdge id="MF_SubmitClaim_di" bpmnElement="MF_SubmitClaim">
        <di:waypoint x="230" y="160" />
        <di:waypoint x="230" y="252" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="236" y="176" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MF_SendLetter_di" bpmnElement="MF_SendLetter">
        <di:waypoint x="1240" y="420" />
        <di:waypoint x="1240" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1247" y="176" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
