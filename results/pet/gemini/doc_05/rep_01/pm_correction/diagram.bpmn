      <bpmndi:BPMNShape id="pool_handling_part_di" bpmnElement="pool_handling_part" isHorizontal="true">
        <dc:Bounds x="120" y="835" width="1900" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_cust_di" bpmnElement="evt_end_cust">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_cust_send_di" bpmnElement="evt_end_cust_send">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_handling_send_di" bpmnElement="evt_end_handling_send">
        <dc:Bounds x="1680" y="895" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_notif_send_di" bpmnElement="evt_end_notif_send">
