        <di:waypoint x="388" y="725" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_register_claim_doa0_di" bpmnElement="task_register_claim_doa0">
        <di:waypoint x="590" y="600" />
        <di:waypoint x="578" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_insurance_dia0_di" bpmnElement="task_check_insurance_dia0">
        <di:waypoint x="388" y="1185" />
        <di:waypoint x="400" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_send_letter_doa0_di" bpmnElement="task_send_letter_doa0">
        <di:waypoint x="1540" y="935" />
        <di:waypoint x="1528" y="1185" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>