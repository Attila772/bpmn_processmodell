<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_customer_part" name="Customer" processRef="pool_customer_proc" />
    <bpmn:participant id="pool_notification_part" name="Notification department" processRef="pool_notification_proc" />
    <bpmn:participant id="pool_handling_part" name="Handling department" processRef="pool_handling_proc" />
    <bpmn:messageFlow id="mf_cust_to_notif" sourceRef="evt_end_cust_send" targetRef="evt_start_notif" name="Relevant documentation" />
    <bpmn:messageFlow id="mf_notif_to_handling" sourceRef="evt_end_notif_send" targetRef="evt_start_handling" name="Registered claim" />
    <bpmn:messageFlow id="mf_handling_to_cust" sourceRef="evt_end_handling_send" targetRef="evt_start_cust_recv" name="Letter" />
  </bpmn:collaboration>
  <bpmn:process id="pool_customer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_doc" name="Relevant documentation" dataObjectRef="data_doc_do" />
    <bpmn:dataObject id="data_doc_do" />
    <bpmn:startEvent id="evt_start_cust" name="Submit claim">
      <bpmn:outgoing>sf_cust_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_cust_send" name="Claim documentation sent">
      <bpmn:incoming>sf_cust_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_cust_send_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_cust_recv" name="Outcome letter received">
      <bpmn:outgoing>sf_cust_recv_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_cust_recv_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_cust" name="Process complete for customer">
      <bpmn:incoming>sf_cust_recv_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_submit_claim" name="Submit claim documentation">
      <bpmn:incoming>sf_cust_1</bpmn:incoming>
      <bpmn:outgoing>sf_cust_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_submit_claim_doa0">
        <bpmn:targetRef>data_doc</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf_cust_1" sourceRef="evt_start_cust" targetRef="task_submit_claim" />
    <bpmn:sequenceFlow id="sf_cust_2" sourceRef="task_submit_claim" targetRef="evt_end_cust_send" />
    <bpmn:sequenceFlow id="sf_cust_recv_1" sourceRef="evt_start_cust_recv" targetRef="evt_end_cust" />
  </bpmn:process>
  <bpmn:process id="pool_notification_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_doc_p1" name="Relevant documentation" dataObjectRef="data_doc_p1_do" />
    <bpmn:dataObject id="data_doc_p1_do" />
    <bpmn:dataObjectReference id="data_claim" name="Claim registration record" dataObjectRef="data_claim_do" />
    <bpmn:dataObject id="data_claim_do" />
    <bpmn:startEvent id="evt_start_notif" name="Claim documentation received">
      <bpmn:outgoing>sf_notif_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_notif_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_notif_send" name="Claim registered sent">
      <bpmn:incoming>sf_notif_3</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_notif_send_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_completeness" name="Check documents upon completeness">
      <bpmn:incoming>sf_notif_1</bpmn:incoming>
      <bpmn:outgoing>sf_notif_2</bpmn:outgoing>
      <bpmn:property id="task_check_completeness_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_completeness_dia0">
        <bpmn:sourceRef>data_doc_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_completeness_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_register_claim" name="Register the claim">
      <bpmn:incoming>sf_notif_2</bpmn:incoming>
      <bpmn:outgoing>sf_notif_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_claim_doa0">
        <bpmn:targetRef>data_claim</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_notif_1" sourceRef="evt_start_notif" targetRef="task_check_completeness" />
    <bpmn:sequenceFlow id="sf_notif_2" sourceRef="task_check_completeness" targetRef="task_register_claim" />
    <bpmn:sequenceFlow id="sf_notif_3" sourceRef="task_register_claim" targetRef="evt_end_notif_send" />
  </bpmn:process>
  <bpmn:process id="pool_handling_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_claim_p1" name="Claim registration record" dataObjectRef="data_claim_p1_do" />
    <bpmn:dataObject id="data_claim_p1_do" />
    <bpmn:dataObjectReference id="data_letter" name="Outcome letter" dataObjectRef="data_letter_do" />
    <bpmn:dataObject id="data_letter_do" />
    <bpmn:startEvent id="evt_start_handling" name="Registered claim received">
      <bpmn:outgoing>sf_hand_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_handling_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_handling_send" name="Letter sent to customer">
      <bpmn:incoming>sf_hand_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_handling_send_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_insurance" name="Check the insurance">
      <bpmn:incoming>sf_hand_1</bpmn:incoming>
      <bpmn:outgoing>sf_hand_2</bpmn:outgoing>
      <bpmn:property id="task_check_insurance_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_insurance_dia0">
        <bpmn:sourceRef>data_claim_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_insurance_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_perform_assessment" name="Perform assessment">
      <bpmn:incoming>sf_hand_2</bpmn:incoming>
      <bpmn:outgoing>sf_hand_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_phone_garage" name="Phone garage to authorise repairs">
      <bpmn:incoming>sf_assess_pos</bpmn:incoming>
      <bpmn:outgoing>sf_hand_pos_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_schedule_payment" name="Schedule the payment">
      <bpmn:incoming>sf_hand_pos_2</bpmn:incoming>
      <bpmn:outgoing>sf_hand_pos_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_reject_claim" name="Reject the claim">
      <bpmn:incoming>sf_assess_neg</bpmn:incoming>
      <bpmn:outgoing>sf_hand_neg_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="task_send_letter" name="Send letter to customer">
      <bpmn:incoming>sf_hand_join</bpmn:incoming>
      <bpmn:outgoing>sf_hand_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_letter_doa0">
        <bpmn:targetRef>data_letter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="xor_assessment" name="Assessment positive?" isMarkerVisible="true">
      <bpmn:incoming>sf_hand_3</bpmn:incoming>
      <bpmn:outgoing>sf_assess_pos</bpmn:outgoing>
      <bpmn:outgoing>sf_assess_neg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="xor_join_outcome" name="Merge outcome" isMarkerVisible="true">
      <bpmn:incoming>sf_hand_pos_3</bpmn:incoming>
      <bpmn:incoming>sf_hand_neg_2</bpmn:incoming>
      <bpmn:outgoing>sf_hand_join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_hand_1" sourceRef="evt_start_handling" targetRef="task_check_insurance" />
    <bpmn:sequenceFlow id="sf_hand_2" sourceRef="task_check_insurance" targetRef="task_perform_assessment" />
    <bpmn:sequenceFlow id="sf_hand_3" sourceRef="task_perform_assessment" targetRef="xor_assessment" />
    <bpmn:sequenceFlow id="sf_assess_pos" sourceRef="xor_assessment" targetRef="task_phone_garage" name="Positive" />
    <bpmn:sequenceFlow id="sf_hand_pos_2" sourceRef="task_phone_garage" targetRef="task_schedule_payment" />
    <bpmn:sequenceFlow id="sf_hand_pos_3" sourceRef="task_schedule_payment" targetRef="xor_join_outcome" />
    <bpmn:sequenceFlow id="sf_assess_neg" sourceRef="xor_assessment" targetRef="task_reject_claim" name="Negative" />
    <bpmn:sequenceFlow id="sf_hand_neg_2" sourceRef="task_reject_claim" targetRef="xor_join_outcome" />
    <bpmn:sequenceFlow id="sf_hand_join" sourceRef="xor_join_outcome" targetRef="task_send_letter" />
    <bpmn:sequenceFlow id="sf_hand_end" sourceRef="task_send_letter" targetRef="evt_end_handling_send" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_customer_part_di" bpmnElement="pool_customer_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_notification_part_di" bpmnElement="pool_notification_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="950" height="275" />
