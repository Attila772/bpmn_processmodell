      <bpmndi:BPMNShape id="evt_start_cust_recv_di" bpmnElement="evt_start_cust_recv">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_handling_di" bpmnElement="evt_start_handling">
        <dc:Bounds x="160" y="895" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_notif_di" bpmnElement="evt_start_notif">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_completeness_di" bpmnElement="task_check_completeness">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_insurance_di" bpmnElement="task_check_insurance">
        <dc:Bounds x="350" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_perform_assessment_di" bpmnElement="task_perform_assessment">
        <dc:Bounds x="540" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_phone_garage_di" bpmnElement="task_phone_garage">
        <dc:Bounds x="920" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_claim_di" bpmnElement="task_register_claim">
        <dc:Bounds x="540" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_reject_claim_di" bpmnElement="task_reject_claim">
        <dc:Bounds x="920" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_schedule_payment_di" bpmnElement="task_schedule_payment">
        <dc:Bounds x="1110" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_letter_di" bpmnElement="task_send_letter">
        <dc:Bounds x="1490" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_claim_di" bpmnElement="task_submit_claim">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="xor_assessment_di" bpmnElement="xor_assessment">
        <dc:Bounds x="730" y="895" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="xor_join_outcome_di" bpmnElement="xor_join_outcome">
        <dc:Bounds x="1300" y="895" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_doc_di" bpmnElement="data_doc">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_doc_p1_di" bpmnElement="data_doc_p1">
        <dc:Bounds x="370" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_claim_di" bpmnElement="data_claim">
        <dc:Bounds x="560" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_claim_p1_di" bpmnElement="data_claim_p1">
        <dc:Bounds x="370" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_letter_di" bpmnElement="data_letter">
        <dc:Bounds x="1510" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf_cust_1_di" bpmnElement="sf_cust_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_cust_2_di" bpmnElement="sf_cust_2">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_notif_1_di" bpmnElement="sf_notif_1">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_notif_2_di" bpmnElement="sf_notif_2">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="590" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_notif_3_di" bpmnElement="sf_notif_3">
        <di:waypoint x="590" y="600" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hand_1_di" bpmnElement="sf_hand_1">
        <di:waypoint x="178" y="913" />
        <di:waypoint x="400" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hand_2_di" bpmnElement="sf_hand_2">
        <di:waypoint x="400" y="935" />
        <di:waypoint x="590" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hand_3_di" bpmnElement="sf_hand_3">
        <di:waypoint x="590" y="935" />
        <di:waypoint x="755" y="920" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_assess_pos_di" bpmnElement="sf_assess_pos">
        <di:waypoint x="755" y="920" />
        <di:waypoint x="970" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hand_pos_2_di" bpmnElement="sf_hand_pos_2">
        <di:waypoint x="970" y="935" />
        <di:waypoint x="1160" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hand_pos_3_di" bpmnElement="sf_hand_pos_3">
        <di:waypoint x="1160" y="935" />
        <di:waypoint x="1325" y="920" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_assess_neg_di" bpmnElement="sf_assess_neg">
        <di:waypoint x="755" y="920" />
        <di:waypoint x="970" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hand_neg_2_di" bpmnElement="sf_hand_neg_2">
        <di:waypoint x="970" y="1060" />
        <di:waypoint x="1325" y="920" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_hand_join_di" bpmnElement="sf_hand_join">
        <di:waypoint x="1325" y="920" />
        <di:waypoint x="1540" y="935" />
      </bpmndi:BPMNEdge>
