        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_notif_to_handling_di" bpmnElement="mf_notif_to_handling">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="178" y="913" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_handling_to_cust_di" bpmnElement="mf_handling_to_cust">
        <di:waypoint x="1698" y="913" />
        <di:waypoint x="178" y="243" />
      </bpmndi:BPMNEdge>
