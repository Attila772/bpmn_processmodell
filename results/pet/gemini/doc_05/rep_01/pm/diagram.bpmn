      <bpmndi:BPMNShape id="task_hand_prepare_letter_di" bpmnElement="task_hand_prepare_letter">
        <dc:Bounds x="1490" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_hand_reject_di" bpmnElement="task_hand_reject">
        <dc:Bounds x="920" y="1020" width="100" height="80" />
