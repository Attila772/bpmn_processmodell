<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_customer_part" name="Customer" processRef="pool_customer_proc" />
    <bpmn:participant id="pool_notification_part" name="Notification Department" processRef="pool_notification_proc" />
    <bpmn:participant id="pool_handling_part" name="Handling Department" processRef="pool_handling_proc" />
    <bpmn:messageFlow id="mf_cust_to_notif" sourceRef="event_cust_send" targetRef="event_notif_start" name="Claim Documentation" />
    <bpmn:messageFlow id="mf_notif_to_hand" sourceRef="event_notif_end" targetRef="event_hand_start" name="Registered Claim" />
    <bpmn:messageFlow id="mf_hand_to_cust" sourceRef="event_hand_send_letter" targetRef="event_cust_receive_letter" name="Decision Letter" />
  </bpmn:collaboration>
  <bpmn:process id="pool_customer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_doc" name="Relevant Documentation" dataObjectRef="data_doc_do" />
    <bpmn:dataObject id="data_doc_do" />
    <bpmn:startEvent id="event_cust_start" name="Claim needed">
      <bpmn:outgoing>sf_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_cust_send" name="Claim submitted">
      <bpmn:incoming>sf_c2</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_cust_send_msgdef" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="event_cust_receive_letter" name="Letter received">
      <bpmn:outgoing>sf_c3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_cust_receive_letter_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="event_cust_end" name="Process finished for customer">
      <bpmn:incoming>sf_c3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_cust_submit" name="Submit claim and relevant documentation">
      <bpmn:incoming>sf_c1</bpmn:incoming>
      <bpmn:outgoing>sf_c2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_cust_submit_doa0">
        <bpmn:targetRef>data_doc</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf_c1" sourceRef="event_cust_start" targetRef="task_cust_submit" />
    <bpmn:sequenceFlow id="sf_c2" sourceRef="task_cust_submit" targetRef="event_cust_send" />
    <bpmn:sequenceFlow id="sf_c3" sourceRef="event_cust_receive_letter" targetRef="event_cust_end" />
  </bpmn:process>
  <bpmn:process id="pool_notification_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_doc_p1" name="Relevant Documentation" dataObjectRef="data_doc_p1_do" />
    <bpmn:dataObject id="data_doc_p1_do" />
    <bpmn:dataObjectReference id="data_claim" name="Claim Record" dataObjectRef="data_claim_do" />
    <bpmn:dataObject id="data_claim_do" />
    <bpmn:startEvent id="event_notif_start" name="Claim received">
      <bpmn:outgoing>sf_n1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_notif_start_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="event_notif_end" name="Claim registered">
      <bpmn:incoming>sf_n3</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_notif_end_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_notif_check" name="Check documents upon completeness">
      <bpmn:incoming>sf_n1</bpmn:incoming>
      <bpmn:outgoing>sf_n2</bpmn:outgoing>
      <bpmn:property id="task_notif_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_notif_check_dia0">
        <bpmn:sourceRef>data_doc_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_notif_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_notif_register" name="Register claim">
      <bpmn:incoming>sf_n2</bpmn:incoming>
      <bpmn:outgoing>sf_n3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_notif_register_doa0">
        <bpmn:targetRef>data_claim</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="sf_n1" sourceRef="event_notif_start" targetRef="task_notif_check" />
    <bpmn:sequenceFlow id="sf_n2" sourceRef="task_notif_check" targetRef="task_notif_register" />
    <bpmn:sequenceFlow id="sf_n3" sourceRef="task_notif_register" targetRef="event_notif_end" />
  </bpmn:process>
  <bpmn:process id="pool_handling_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_claim_p1" name="Claim Record" dataObjectRef="data_claim_p1_do" />
    <bpmn:dataObject id="data_claim_p1_do" />
    <bpmn:dataObjectReference id="data_letter" name="Decision Letter" dataObjectRef="data_letter_do" />
    <bpmn:dataObject id="data_letter_do" />
    <bpmn:startEvent id="event_hand_start" name="Claim picked up">
      <bpmn:outgoing>sf_h1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_hand_start_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="event_hand_send_letter" name="Letter sent to customer">
      <bpmn:incoming>sf_h8</bpmn:incoming>
      <bpmn:outgoing>sf_h9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_hand_send_letter_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="event_hand_end" name="Process completed">
      <bpmn:incoming>sf_h9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_hand_check_ins" name="Check insurance">
      <bpmn:incoming>sf_h1</bpmn:incoming>
      <bpmn:outgoing>sf_h2</bpmn:outgoing>
      <bpmn:property id="task_hand_check_ins_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_hand_check_ins_dia0">
        <bpmn:sourceRef>data_claim_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_hand_check_ins_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_hand_assess" name="Perform assessment">
      <bpmn:incoming>sf_h2</bpmn:incoming>
      <bpmn:outgoing>sf_h3</bpmn:outgoing>
      <bpmn:property id="task_hand_assess_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_hand_assess_dia0">
        <bpmn:sourceRef>data_claim_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_hand_assess_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_hand_phone_garage" name="Phone garage to authorise repairs">
      <bpmn:incoming>sf_pos</bpmn:incoming>
      <bpmn:outgoing>sf_h4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_hand_sched_pay" name="Schedule payment">
      <bpmn:incoming>sf_h4</bpmn:incoming>
      <bpmn:outgoing>sf_h5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_hand_reject" name="Reject claim">
      <bpmn:incoming>sf_neg</bpmn:incoming>
      <bpmn:outgoing>sf_h6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_hand_prepare_letter" name="Prepare decision letter">
      <bpmn:incoming>sf_h7</bpmn:incoming>
      <bpmn:outgoing>sf_h8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_hand_prepare_letter_doa0">
        <bpmn:targetRef>data_letter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gtw_assess" name="Assessment positive?" isMarkerVisible="true">
      <bpmn:incoming>sf_h3</bpmn:incoming>
      <bpmn:outgoing>sf_pos</bpmn:outgoing>
      <bpmn:outgoing>sf_neg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_join" name="Merge paths" isMarkerVisible="true">
      <bpmn:incoming>sf_h5</bpmn:incoming>
      <bpmn:incoming>sf_h6</bpmn:incoming>
      <bpmn:outgoing>sf_h7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_h1" sourceRef="event_hand_start" targetRef="task_hand_check_ins" />
    <bpmn:sequenceFlow id="sf_h2" sourceRef="task_hand_check_ins" targetRef="task_hand_assess" />
    <bpmn:sequenceFlow id="sf_h3" sourceRef="task_hand_assess" targetRef="gtw_assess" />
    <bpmn:sequenceFlow id="sf_pos" sourceRef="gtw_assess" targetRef="task_hand_phone_garage" name="Positive" />
    <bpmn:sequenceFlow id="sf_h4" sourceRef="task_hand_phone_garage" targetRef="task_hand_sched_pay" />
    <bpmn:sequenceFlow id="sf_h5" sourceRef="task_hand_sched_pay" targetRef="gtw_join" />
    <bpmn:sequenceFlow id="sf_neg" sourceRef="gtw_assess" targetRef="task_hand_reject" name="Negative" />
    <bpmn:sequenceFlow id="sf_h6" sourceRef="task_hand_reject" targetRef="gtw_join" />
    <bpmn:sequenceFlow id="sf_h7" sourceRef="gtw_join" targetRef="task_hand_prepare_letter" />
    <bpmn:sequenceFlow id="sf_h8" sourceRef="task_hand_prepare_letter" targetRef="event_hand_send_letter" />
    <bpmn:sequenceFlow id="sf_h9" sourceRef="event_hand_send_letter" targetRef="event_hand_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
