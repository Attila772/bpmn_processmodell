<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ExpenseReportProcess"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:process id="ExpenseReportProcess" name="Expense Report Process" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ExpenseReportReceived" name="Expense Report Received">
      <bpmn:outgoing">SequenceFlow_StartToAccountGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Account Gateway -->
    <bpmn:exclusiveGateway id="Gateway_HasAccount" name="Employee has account?">
      <bpmn:incoming">SequenceFlow_StartToAccountGateway</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_AccountNo</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_AccountYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create Account Task -->
    <bpmn:task id="Task_CreateAccount" name="Create New Account">
      <bpmn:incoming">SequenceFlow_AccountNo</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_AccountCreatedToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway Account -->
    <bpmn:exclusiveGateway id="Gateway_MergeAccount">
      <bpmn:incoming">SequenceFlow_AccountYes</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_AccountCreatedToMerge</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_AccountToAmountGateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Amount Gateway for Auto Approval -->
    <bpmn:exclusiveGateway id="Gateway_AmountCheck" name="Amount under $200?">
      <bpmn:incoming">SequenceFlow_AccountToAmountGateway</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_AutoApproved</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_RequiresSupervisor</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Supervisor Approval Task -->
    <bpmn:userTask id="Task_SupervisorApproval" name="Review Expense Report by Supervisor">
      <bpmn:incoming">SequenceFlow_RequiresSupervisor</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_SupervisorToApprovalGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Approval Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalStatus" name="Approved?">
      <bpmn:incoming">SequenceFlow_SupervisorToApprovalGateway</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_ApprovedBySupervisor</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Merge Gateway Approved -->
    <bpmn:exclusiveGateway id="Gateway_MergeApproval">
      <bpmn:incoming">SequenceFlow_AutoApproved</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_ApprovedBySupervisor</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_ApprovalToReimburse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send Rejection Email Task -->
    <bpmn:sendTask id="Task_SendRejectionEmail" name="Send Rejection Email to Employee">
      <bpmn:incoming">SequenceFlow_Rejected</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_RejectionToEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- End Event Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Expense Report Rejected">
      <bpmn:incoming">SequenceFlow_RejectionToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Deposit Reimbursement Task -->
    <bpmn:task id="Task_DepositReimbursement" name="Reimburse to Direct Deposit Bank Account">
      <bpmn:incoming">SequenceFlow_ApprovalToReimburse</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_ReimburseToCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event Completed -->
    <bpmn:endEvent id="EndEvent_Completed" name="Expense Report Processed">
      <bpmn:incoming">SequenceFlow_ReimburseToCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 7-Day Boundary Non-Interrupting Timer -->
    <bpmn:boundaryEvent id="BoundaryEvent_7Days" name="7 Days Passed" cancelActivity="false" attachedToRef="Task_SupervisorApproval">
      <bpmn:outgoing">SequenceFlow_7DaysToNotification</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_7Days">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- Send Approval In Progress Email Task -->
    <bpmn:sendTask id="Task_SendProgressEmail" name="Send Approval In Progress Email">
      <bpmn:incoming">SequenceFlow_7DaysToNotification</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_ProgressEmailEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- End Event 7-Day Email Sent -->
    <bpmn:endEvent id="EndEvent_ProgressNotified" name="Progress Notification Sent">
      <bpmn:incoming">SequenceFlow_ProgressEmailEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 30-Day Boundary Interrupting Timer -->
    <bpmn:boundaryEvent id="BoundaryEvent_30Days" name="30 Days Passed" cancelActivity="true" attachedToRef="Task_SupervisorApproval">
      <bpmn:outgoing">SequenceFlow_30DaysToCancellation</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_30Days">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- Send Cancellation Email Task -->
    <bpmn:sendTask id="Task_SendCancellationEmail" name="Send Cancellation Email Notice">
      <bpmn:incoming">SequenceFlow_30DaysToCancellation</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_CancellationToEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- End Event Cancelled -->
    <bpmn:endEvent id="EndEvent_Cancelled" name="Process Stopped (Re-submission Required)">
      <bpmn:incoming">SequenceFlow_CancellationToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAccountGateway" sourceRef="StartEvent_ExpenseReportReceived" targetRef="Gateway_HasAccount" />
    <bpmn:sequenceFlow id="SequenceFlow_AccountNo" name="No" sourceRef="Gateway_HasAccount" targetRef="Task_CreateAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!hasAccount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_AccountYes" name="Yes" sourceRef="Gateway_HasAccount" targetRef="Gateway_MergeAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasAccount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_AccountCreatedToMerge" sourceRef="Task_CreateAccount" targetRef="Gateway_MergeAccount" />
    <bpmn:sequenceFlow id="SequenceFlow_AccountToAmountGateway" sourceRef="Gateway_MergeAccount" targetRef="Gateway_AmountCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_AutoApproved" name="Yes (&lt; $200)" sourceRef="Gateway_AmountCheck" targetRef="Gateway_MergeApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &lt; 200}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_RequiresSupervisor" name="No (&gt;= $200)" sourceRef="Gateway_AmountCheck" targetRef="Task_SupervisorApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt;= 200}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_SupervisorToApprovalGateway" sourceRef="Task_SupervisorApproval" targetRef="Gateway_ApprovalStatus" />
    <bpmn:sequenceFlow id="SequenceFlow_ApprovedBySupervisor" name="Approved" sourceRef="Gateway_ApprovalStatus" targetRef="Gateway_MergeApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_Rejected" name="Rejected" sourceRef="Gateway_ApprovalStatus" targetRef="Task_SendRejectionEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_RejectionToEnd" sourceRef="Task_SendRejectionEmail" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalToReimburse" sourceRef="Gateway_MergeApproval" targetRef="Task_DepositReimbursement" />
    <bpmn:sequenceFlow id="SequenceFlow_ReimburseToCompleted" sourceRef="Task_DepositReimbursement" targetRef="EndEvent_Completed" />
    <bpmn:sequenceFlow id="SequenceFlow_7DaysToNotification" sourceRef="BoundaryEvent_7Days" targetRef="Task_SendProgressEmail" />
    <bpmn:sequenceFlow id="SequenceFlow_ProgressEmailEnd" sourceRef="Task_SendProgressEmail" targetRef="EndEvent_ProgressNotified" />
    <bpmn:sequenceFlow id="SequenceFlow_30DaysToCancellation" sourceRef="BoundaryEvent_30Days" targetRef="Task_SendCancellationEmail" />
    <bpmn:sequenceFlow id="SequenceFlow_CancellationToEnd" sourceRef="Task_SendCancellationEmail" targetRef="EndEvent_Cancelled" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ExpenseReportProcess">
      
      <!-- Start Event -->
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_ExpenseReportReceived">
        <dc:Bounds x="152" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="132" y="255" width="77" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Gateway Has Account -->
      <bpmndi:BPMNShape id="Gateway_HasAccount_di" bpmnElement="Gateway_HasAccount" isMarkerVisible="true">
        <dc:Bounds x="245" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="235" y="168" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Create Account -->
      <bpmndi:BPMNShape id="Task_CreateAccount_di" bpmnElement="Task_CreateAccount">
        <dc:Bounds x="350" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Merge Account -->
      <bpmndi:BPMNShape id="Gateway_MergeAccount_di" bpmnElement="Gateway_MergeAccount" isMarkerVisible="true">
        <dc:Bounds x="505" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Gateway Amount Check -->
      <bpmndi:BPMNShape id="Gateway_AmountCheck_di" bpmnElement="Gateway_AmountCheck" isMarkerVisible="true">
        <dc:Bounds x="605" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="596" y="168" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Supervisor Approval -->
      <bpmndi:BPMNShape id="Task_SupervisorApproval_di" bpmnElement="Task_SupervisorApproval">
        <dc:Bounds x="720" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Approval Status -->
      <bpmndi:BPMNShape id="Gateway_ApprovalStatus_di" bpmnElement="Gateway_ApprovalStatus" isMarkerVisible="true">
        <dc:Bounds x="875" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="874" y="281" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Gateway Merge Approval -->
      <bpmndi:BPMNShape id="Gateway_MergeApproval_di" bpmnElement="Gateway_MergeApproval" isMarkerVisible="true">
        <dc:Bounds x="875" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Task Deposit Reimbursement -->
      <bpmndi:BPMNShape id="Task_DepositReimbursement_di" bpmnElement="Task_DepositReimbursement">
        <dc:Bounds x="980" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event Completed -->
      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="1132" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1111" y="255" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Send Rejection Email -->
      <bpmndi:BPMNShape id="Task_SendRejectionEmail_di" bpmnElement="Task_SendRejectionEmail">
        <dc:Bounds x="980" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event Rejected -->
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1132" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1111" y="455" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Send Progress Email -->
      <bpmndi:BPMNShape id="Task_SendProgressEmail_di" bpmnElement="Task_SendProgressEmail">
        <dc:Bounds x="810" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event Progress Notified -->
      <bpmndi:BPMNShape id="EndEvent_ProgressNotified_di" bpmnElement="EndEvent_ProgressNotified">
        <dc:Bounds x="962" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="951" y="555" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Send Cancellation Email -->
      <bpmndi:BPMNShape id="Task_SendCancellationEmail_di" bpmnElement="Task_SendCancellationEmail">
        <dc:Bounds x="630" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event Cancelled -->
      <bpmndi:BPMNShape id="EndEvent_Cancelled_di" bpmnElement="EndEvent_Cancelled">
        <dc:Bounds x="522" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="555" width="85" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Boundary Event 7 Days -->
      <bpmndi:BPMNShape id="BoundaryEvent_7Days_di" bpmnElement="BoundaryEvent_7Days">
        <dc:Bounds x="782" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="814" y="383" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Boundary Event 30 Days -->
      <bpmndi:BPMNShape id="BoundaryEvent_30Days_di" bpmnElement="BoundaryEvent_30Days">
        <dc:Bounds x="722" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="651" y="383" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="SequenceFlow_StartToAccountGateway_di" bpmnElement="SequenceFlow_StartToAccountGateway">
        <di:waypoint x="188" y="230" />
        <di:waypoint x="245" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AccountNo_di" bpmnElement="SequenceFlow_AccountNo">
        <di:waypoint x="270" y="255" />
        <di:waypoint x="270" y="330" />
        <di:waypoint x="350" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="278" y="290" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AccountYes_di" bpmnElement="SequenceFlow_AccountYes">
        <di:waypoint x="295" y="230" />
        <di:waypoint x="505" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="391" y="212" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AccountCreatedToMerge_di" bpmnElement="SequenceFlow_AccountCreatedToMerge">
        <di:waypoint x="450" y="330" />
        <di:waypoint x="530" y="330" />
        <di:waypoint x="530" y="255" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AccountToAmountGateway_di" bpmnElement="SequenceFlow_AccountToAmountGateway">
        <di:waypoint x="555" y="230" />
        <di:waypoint x="605" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AutoApproved_di" bpmnElement="SequenceFlow_AutoApproved">
        <di:waypoint x="655" y="230" />
        <di:waypoint x="875" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="734" y="212" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_RequiresSupervisor_di" bpmnElement="SequenceFlow_RequiresSupervisor">
        <di:waypoint x="630" y="255" />
        <di:waypoint x="630" y="330" />
        <di:waypoint x="720" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="635" y="290" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_SupervisorToApprovalGateway_di" bpmnElement="SequenceFlow_SupervisorToApprovalGateway">
        <di:waypoint x="820" y="330" />
        <di:waypoint x="875" y="330" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ApprovedBySupervisor_di" bpmnElement="SequenceFlow_ApprovedBySupervisor">
        <di:waypoint x="900" y="305" />
        <di:waypoint x="900" y="255" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="907" y="277" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Rejected_di" bpmnElement="SequenceFlow_Rejected">
        <di:waypoint x="900" y="355" />
        <di:waypoint x="900" y="430" />
        <di:waypoint x="980" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="908" y="390" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_RejectionToEnd_di" bpmnElement="SequenceFlow_RejectionToEnd">
        <di:waypoint x="1080" y="430" />
        <di:waypoint x="1132" y="430" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ApprovalToReimburse_di" bpmnElement="SequenceFlow_ApprovalToReimburse">
        <di:waypoint x="925" y="230" />
        <di:waypoint x="980" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ReimburseToCompleted_di" bpmnElement="SequenceFlow_ReimburseToCompleted">
        <di:waypoint x="1080" y="230" />
        <di:waypoint x="1132" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_7DaysToNotification_di" bpmnElement="SequenceFlow_7DaysToNotification">
        <di:waypoint x="800" y="388" />
        <di:waypoint x="800" y="530" />
        <di:waypoint x="810" y="530" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ProgressEmailEnd_di" bpmnElement="SequenceFlow_ProgressEmailEnd">
        <di:waypoint x="910" y="530" />
        <di:waypoint x="962" y="530" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_30DaysToCancellation_di" bpmnElement="SequenceFlow_30DaysToCancellation">
        <di:waypoint x="740" y="388" />
        <di:waypoint x="740" y="530" />
        <di:waypoint x="730" y="530" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_CancellationToEnd_di" bpmnElement="SequenceFlow_CancellationToEnd">
        <di:waypoint x="630" y="530" />
        <di:waypoint x="558" y="530" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
