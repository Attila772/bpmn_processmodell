        <di:waypoint x="1030" y="230" />
        <di:waypoint x="1105" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1037" y="275" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_SupervisorRejected_di" bpmnElement="SequenceFlow_SupervisorRejected">
        <di:waypoint x="1055" y="350" />
        <di:waypoint x="1110" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1061" y="332" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ToReimbursement_di" bpmnElement="SequenceFlow_ToReimbursement">
        <di:waypoint x="1155" y="230" />
        <di:waypoint x="1210" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ToApprovedEnd_di" bpmnElement="SequenceFlow_ToApprovedEnd">
        <di:waypoint x="1310" y="230" />
        <di:waypoint x="1362" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ToRejectedEnd_di" bpmnElement="SequenceFlow_ToRejectedEnd">
