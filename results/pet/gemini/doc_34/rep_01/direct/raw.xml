        <bpmndi:BPMNLabel>
          <dc:Bounds x="1236" y="375" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Timer Tasks & End Events -->
      <bpmndi:BPMNShape id="Task_SendProgressEmail_di" bpmnElement="Task_SendProgressEmail">
        <dc:Bounds x="980" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ProgressNoticeSent_di" bpmnElement="EndEvent_ProgressNoticeSent">
        <dc:Bounds x="1122" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1104" y="505" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendCancellationEmail_di" bpmnElement="Task_SendCancellationEmail">
        <dc:Bounds x="980" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Cancelled_di" bpmnElement="EndEvent_Cancelled">
