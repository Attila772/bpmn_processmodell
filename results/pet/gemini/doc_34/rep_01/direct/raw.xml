        <bpmndi:BPMNLabel>
          <dc:Bounds x="1350" y="255" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
