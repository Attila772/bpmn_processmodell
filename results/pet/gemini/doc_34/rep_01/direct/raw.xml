          <dc:Bounds x="1098" y="615" width="84" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Boundary Events -->
      <bpmndi:BPMNShape id="Timer_7Days_di" bpmnElement="Timer_7Days">
        <dc:Bounds x="882" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="821" y="408" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

