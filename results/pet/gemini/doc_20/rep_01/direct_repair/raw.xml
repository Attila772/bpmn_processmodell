<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_OrderProcessing"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:process id="Process_OrderFulfillment" name="Order Fulfillment Process" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="New order received from sales">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Determine parts, quantities, and delivery date -->
    <bpmn:userTask id="Task_DetermineDetails" name="Determine necessary parts, quantities, and delivery date">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Enter data into PPS -->
    <bpmn:userTask id="Task_EnterDataPPS" name="Enter information into Production Planning System (PPS)">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Transfer data manually to ERP -->
    <bpmn:userTask id="Task_TransferDataERP" name="Transfer data manually to ERP system">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Are parts missing? -->
    <bpmn:exclusiveGateway id="Gateway_ProcurementCheck" name="Are parts missing and need to be procured?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcureYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProcureNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Procure missing parts -->
    <bpmn:userTask id="Task_ProcureParts" name="Procure missing parts">
      <bpmn:incoming>Flow_ProcureYes</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Merge Procurement Paths -->
    <bpmn:exclusiveGateway id="Gateway_ProcurementMerge">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_ProcureNo</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Catch Event: Notice from PPS -->
    <bpmn:intermediateCatchEvent id="Event_NoticeReceived" name="Receive notice to start production">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_01" />
    </bpmn:intermediateCatchEvent>

    <!-- Task 5: Implement production -->
    <bpmn:userTask id="Task_ImplementProduction" name="Implement production order">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 6: Quality check -->
    <bpmn:userTask id="Task_QualityCheck" name="Check order for quality">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order fulfilled successfully">
      <bpmn:incoming>Flow_09</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_OrderReceived" targetRef="Task_DetermineDetails" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_DetermineDetails" targetRef="Task_EnterDataPPS" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_EnterDataPPS" targetRef="Task_TransferDataERP" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_TransferDataERP" targetRef="Gateway_ProcurementCheck" />
    
    <bpmn:sequenceFlow id="Flow_ProcureYes" name="Yes" sourceRef="Gateway_ProcurementCheck" targetRef="Task_ProcureParts" />
    <bpmn:sequenceFlow id="Flow_ProcureNo" name="No" sourceRef="Gateway_ProcurementCheck" targetRef="Gateway_ProcurementMerge" />
    
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ProcureParts" targetRef="Gateway_ProcurementMerge" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_ProcurementMerge" targetRef="Event_NoticeReceived" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Event_NoticeReceived" targetRef="Task_ImplementProduction" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ImplementProduction" targetRef="Task_QualityCheck" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_QualityCheck" targetRef="EndEvent_OrderCompleted" />

  </bpmn:process>

  <!-- BPMN Diagram Graphical Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_OrderFulfillment">
      
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_OrderReceived">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="129" y="145" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_DetermineDetails_di" bpmnElement="Task_DetermineDetails">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_EnterDataPPS_di" bpmnElement="Task_EnterDataPPS">
        <dc:Bounds x="390" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TransferDataERP_di" bpmnElement="Task_TransferDataERP">
        <dc:Bounds x="540" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ProcurementCheck_di" bpmnElement="Gateway_ProcurementCheck" isMarkerVisible="true">
        <dc:Bounds x="695" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="680" y="50" width="81" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcureParts_di" bpmnElement="Task_ProcureParts">
        <dc:Bounds x="790" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ProcurementMerge_di" bpmnElement="Gateway_ProcurementMerge" isMarkerVisible="true">
        <dc:Bounds x="945" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_NoticeReceived_di" bpmnElement="Event_NoticeReceived">
        <dc:Bounds x="1042" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1022" y="145" width="77" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ImplementProduction_di" bpmnElement="Task_ImplementProduction">
        <dc:Bounds x="1130" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_QualityCheck_di" bpmnElement="Task_QualityCheck">
        <dc:Bounds x="1280" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_OrderCompleted_di" bpmnElement="EndEvent_OrderCompleted">
        <dc:Bounds x="1432" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1415" y="145" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="390" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="490" y="120" />
        <di:waypoint x="540" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="640" y="120" />
        <di:waypoint x="695" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ProcureYes_di" bpmnElement="Flow_ProcureYes">
        <di:waypoint x="745" y="120" />
        <di:waypoint x="790" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="759" y="102" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ProcureNo_di" bpmnElement="Flow_ProcureNo">
        <di:waypoint x="720" y="145" />
        <di:waypoint x="720" y="210" />
        <di:waypoint x="970" y="210" />
        <di:waypoint x="970" y="145" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="732" y="192" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="890" y="120" />
        <di:waypoint x="945" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="995" y="120" />
        <di:waypoint x="1042" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="1078" y="120" />
        <di:waypoint x="1130" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="1230" y="120" />
        <di:waypoint x="1280" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="1380" y="120" />
        <di:waypoint x="1432" y="120" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
