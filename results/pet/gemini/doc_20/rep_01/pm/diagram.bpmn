<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_obj_1" name="Order Details (Parts, Quantities, Delivery Date)" dataObjectRef="data_obj_1_do" />
    <bpmn:dataObject id="data_obj_1_do" />
    <bpmn:dataObjectReference id="data_obj_2" name="List of parts to be procured" dataObjectRef="data_obj_2_do" />
    <bpmn:dataObject id="data_obj_2_do" />
    <bpmn:startEvent id="event_1" name="Order received from Sales">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_1_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="event_2" name="Notice from PPS to start production">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_2_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="event_3" name="Order Completed">
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_1" name="Determine necessary parts, quantities, and delivery date">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_1_doa0">
        <bpmn:targetRef>data_obj_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task_2" name="Enter information into PPS">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_2_dia0">
        <bpmn:sourceRef>data_obj_1</bpmn:sourceRef>
        <bpmn:targetRef>task_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_2_doa0">
        <bpmn:targetRef>data_obj_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_3" name="Transfer procurement data manually to ERP">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_3_dia0">
        <bpmn:sourceRef>data_obj_2</bpmn:sourceRef>
        <bpmn:targetRef>task_3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_4" name="Procure missing parts">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_5" name="Implement production">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="task_6" name="Check order quality">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_1" name="Are parts missing?" isMarkerVisible="true">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_2" name="Merge Procurement Paths" isMarkerVisible="true">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="event_1" targetRef="task_1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_2" targetRef="task_3" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_3" targetRef="gateway_1" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="gateway_1" targetRef="task_4" name="Parts are missing" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="gateway_1" targetRef="gateway_2" name="No parts missing" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_4" targetRef="gateway_2" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="gateway_2" targetRef="event_2" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="event_2" targetRef="task_5" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_5" targetRef="task_6" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_6" targetRef="event_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_1_di" bpmnElement="event_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_2_di" bpmnElement="event_2">
        <dc:Bounds x="1490" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_3_di" bpmnElement="event_3">
        <dc:Bounds x="2060" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_1_di" bpmnElement="gateway_1">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_2_di" bpmnElement="gateway_2">
        <dc:Bounds x="1300" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_di" bpmnElement="task_1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_2_di" bpmnElement="task_2">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_3_di" bpmnElement="task_3">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_4_di" bpmnElement="task_4">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_5_di" bpmnElement="task_5">
        <dc:Bounds x="1680" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_6_di" bpmnElement="task_6">
        <dc:Bounds x="1870" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_obj_1_di" bpmnElement="data_obj_1">
        <dc:Bounds x="465" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_obj_2_di" bpmnElement="data_obj_2">
        <dc:Bounds x="655" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_8_di" bpmnElement="flow_8">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="1508" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_9_di" bpmnElement="flow_9">
        <di:waypoint x="1508" y="118" />
        <di:waypoint x="1730" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_10_di" bpmnElement="flow_10">
        <di:waypoint x="1730" y="140" />
        <di:waypoint x="1920" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_11_di" bpmnElement="flow_11">
        <di:waypoint x="1920" y="140" />
        <di:waypoint x="2078" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_doa0_di" bpmnElement="task_1_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_2_dia0_di" bpmnElement="task_2_dia0">
        <di:waypoint x="483" y="265" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_2_doa0_di" bpmnElement="task_2_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="673" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_3_dia0_di" bpmnElement="task_3_dia0">
        <di:waypoint x="673" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>