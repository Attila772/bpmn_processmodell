<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_SwitchOver"
             targetNamespace="http://bpmn.org/schema/bpmn"
             exporter="Camunda Modeler"
             exporterVersion="5.0.0">

  <!-- COLLABORATION -->
  <collaboration id="Collaboration_SwitchOver">
    <participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <participant id="Participant_NewSupplier" name="New Supplier (Customer Service)" processRef="Process_NewSupplier" />
    <participant id="Participant_GridOperator" name="Grid Operator" processRef="Process_GridOperator" />
    <participant id="Participant_OldSupplier" name="Old Supplier" processRef="Process_OldSupplier" />

    <!-- Message Flows -->
    <messageFlow id="MF_1" name="Switch-over Request" sourceRef="Task_Cust_RequestSwitch" targetRef="Start_SwitchRequestReceived" />
    <messageFlow id="MF_2" name="Confirmation Document" sourceRef="Task_SendConfirmationDoc" targetRef="Task_Cust_CheckContract" />
    <messageFlow id="MF_3" name="Grid Request" sourceRef="Task_SendGridRequest" targetRef="Start_GridRequestReceived" />
    <messageFlow id="MF_4" name="Conflict Notification" sourceRef="Task_InformConflict" targetRef="Task_ResolveConflict" />
    <messageFlow id="MF_5" name="Grid Response" sourceRef="Task_SendGridResponse" targetRef="Catch_GridResponse" />
    <messageFlow id="MF_6" name="Termination Notice" sourceRef="Task_TerminateOldAgreement" targetRef="Task_Old_ProcessTermination" />
    <messageFlow id="MF_7" name="Withdrawal / Confirmation" sourceRef="Task_Cust_CheckContract" targetRef="Catch_CustomerDecision" />
    <messageFlow id="MF_8" name="Services Consumption Report" sourceRef="Task_SendMeterData" targetRef="Catch_MeterDataReceived" />
    <messageFlow id="MF_9" name="Services Consumption Report" sourceRef="Task_SendMeterData" targetRef="Task_Old_ReceiveMeterData" />
    <messageFlow id="MF_10" name="Final Billing (Grid)" sourceRef="Task_ComputeSendFinalBillingGrid" targetRef="Task_Old_ReceiveGridBilling" />
    <messageFlow id="MF_11" name="Final Billing (Customer)" sourceRef="Task_Old_SendFinalBilling" targetRef="Task_Cust_ReceiveFinalBilling" />
  </collaboration>

  <!-- PROCESS 1: Customer -->
  <process id="Process_Customer" isExecutable="false">
    <startEvent id="Start_Customer" name="Desire to Switch Supplier">
      <outgoing>Flow_C1</outgoing>
    </startEvent>
    <task id="Task_Cust_RequestSwitch" name="Submit Switch-over Request">
      <incoming>Flow_C1</incoming>
      <outgoing>Flow_C2</outgoing>
    </task>
    <task id="Task_Cust_CheckContract" name="Check Contract Details &amp; Decide">
      <incoming>Flow_C2</incoming>
      <outgoing>Flow_C3</outgoing>
    </task>
    <task id="Task_Cust_ReceiveFinalBilling" name="Receive Final Billing from Old Supplier">
      <incoming>Flow_C3</incoming>
      <outgoing>Flow_C4</outgoing>
    </task>
    <endEvent id="End_Customer" name="Customer Process Ended">
      <incoming>Flow_C4</incoming>
    </endEvent>

    <sequenceFlow id="Flow_C1" sourceRef="Start_Customer" targetRef="Task_Cust_RequestSwitch" />
    <sequenceFlow id="Flow_C2" sourceRef="Task_Cust_RequestSwitch" targetRef="Task_Cust_CheckContract" />
    <sequenceFlow id="Flow_C3" sourceRef="Task_Cust_CheckContract" targetRef="Task_Cust_ReceiveFinalBilling" />
    <sequenceFlow id="Flow_C4" sourceRef="Task_Cust_ReceiveFinalBilling" targetRef="End_Customer" />
  </process>

  <!-- PROCESS 2: New Supplier (Customer Service) -->
  <process id="Process_NewSupplier" isExecutable="true">
    <startEvent id="Start_SwitchRequestReceived" name="Switch-over Request Received">
      <outgoing>Flow_NS1</outgoing>
      <messageEventDefinition id="MED_1" />
    </startEvent>

    <task id="Task_EnterCRM" name="Enter Customer Data into CRM">
      <incoming>Flow_NS1</incoming>
      <outgoing>Flow_NS2</outgoing>
    </task>

    <task id="Task_CompareData" name="Compare with Internal Customer DB">
      <incoming>Flow_NS2</incoming>
      <outgoing>Flow_NS3</outgoing>
    </task>

    <exclusiveGateway id="GW_DataErrors" name="Data Errors Found?">
      <incoming>Flow_NS3</incoming>
      <outgoing>Flow_ErrorYes</outgoing>
      <outgoing>Flow_ErrorNo</outgoing>
    </exclusiveGateway>

    <task id="Task_CorrectErrors" name="Correct Errors via Error List">
      <incoming>Flow_ErrorYes</incoming>
      <outgoing>Flow_NS4</outgoing>
    </task>

    <exclusiveGateway id="GW_MergeErrors" name="Merge">
      <incoming>Flow_ErrorNo</incoming>
      <incoming>Flow_NS4</incoming>
      <outgoing>Flow_NS5</outgoing>
    </exclusiveGateway>

    <exclusiveGateway id="GW_CustomerExists" name="Customer Exists in DB?">
      <incoming>Flow_NS5</incoming>
      <outgoing>Flow_CustExistsYes</outgoing>
      <outgoing>Flow_CustExistsNo</outgoing>
    </exclusiveGateway>

    <task id="Task_CreateCustomerObject" name="Create New Customer Object">
      <incoming>Flow_CustExistsNo</incoming>
      <outgoing>Flow_NS6</outgoing>
    </task>

    <exclusiveGateway id="GW_MergeCustomerObj" name="Merge Customer Object">
      <incoming>Flow_CustExistsYes</incoming>
      <incoming>Flow_NS6</incoming>
      <outgoing>Flow_NS7</outgoing>
    </exclusiveGateway>

    <task id="Task_PrepareContractDocs" name="Prepare Contract Documents">
      <incoming>Flow_NS7</incoming>
      <incoming>Flow_LoopDocs</incoming>
      <outgoing>Flow_NS8</outgoing>
    </task>

    <task id="Task_AutomatedCheckCIS" name="Automated Check in CIS">
      <incoming>Flow_NS8</incoming>
      <outgoing>Flow_NS9</outgoing>
    </task>

    <exclusiveGateway id="GW_CheckDocsSuccess" name="Contract Generation Successful?">
      <incoming>Flow_NS9</incoming>
      <outgoing>Flow_DocsSuccessYes</outgoing>
      <outgoing>Flow_DocsSuccessNo</outgoing>
    </exclusiveGateway>

    <task id="Task_AnalyzeResolveIssues" name="Analyze and Resolve Contract Generation Issues">
      <incoming>Flow_DocsSuccessNo</incoming>
      <outgoing>Flow_LoopDocs</outgoing>
    </task>

    <task id="Task_SendConfirmationDoc" name="Send Confirmation Document to Customer">
      <incoming>Flow_DocsSuccessYes</incoming>
      <outgoing>Flow_NS10</outgoing>
    </task>

    <task id="Task_SendGridRequest" name="Send Switch Request to Grid Operator (via CIS)">
      <incoming>Flow_NS10</incoming>
      <outgoing>Flow_NS11</outgoing>
    </task>

    <intermediateCatchEvent id="Catch_GridResponse" name="Receive Response Comment from Grid">
      <incoming>Flow_NS11</incoming>
      <outgoing>Flow_NS12</outgoing>
      <messageEventDefinition id="MED_2" />
    </intermediateCatchEvent>

    <exclusiveGateway id="GW_GridObjections" name="Grid Objections / Supplier Concurrence?">
      <incoming>Flow_NS12</incoming>
      <outgoing>Flow_ConcurrenceNo</outgoing>
      <outgoing>Flow_ConcurrenceYes</outgoing>
    </exclusiveGateway>

    <task id="Task_ResolveConflict" name="Resolve Supplier Concurrence Conflict">
      <incoming>Flow_ConcurrenceYes</incoming>
      <outgoing>Flow_NS13</outgoing>
    </task>

    <task id="Task_CreateCISContract" name="Create CIS Contract">
      <incoming>Flow_ConcurrenceNo</incoming>
      <incoming>Flow_NS13</incoming>
      <outgoing>Flow_NS14</outgoing>
    </task>

    <eventBasedGateway id="GW_CustomerDecision" name="Await Customer Decision">
      <incoming>Flow_NS14</incoming>
      <outgoing>Flow_ToCatchDecision</outgoing>
      <outgoing>Flow_To7DaysTimer</outgoing>
    </eventBasedGateway>

    <intermediateCatchEvent id="Catch_CustomerDecision" name="Customer Message Received">
      <incoming>Flow_ToCatchDecision</incoming>
      <outgoing>Flow_NS15</outgoing>
      <messageEventDefinition id="MED_3" />
    </intermediateCatchEvent>

    <intermediateCatchEvent id="Timer_7Days" name="7 Days Passed">
      <incoming>Flow_To7DaysTimer</incoming>
      <outgoing>Flow_NS16</outgoing>
      <timerEventDefinition id="TED_1">
        <timeDuration xsi:type="tFormalExpression">P7D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <exclusiveGateway id="GW_DecisionOutcome" name="Customer Decision Outcome">
      <incoming>Flow_NS15</incoming>
      <outgoing>Flow_Withdrawal</outgoing>
      <outgoing>Flow_Confirmed</outgoing>
    </exclusiveGateway>

    <exclusiveGateway id="GW_MergeAcceptance" name="Contract Accepted">
      <incoming>Flow_Confirmed</incoming>
      <incoming>Flow_NS16</incoming>
      <outgoing>Flow_NS17</outgoing>
    </exclusiveGateway>

    <endEvent id="End_Withdrawal" name="Process Ended (Withdrawal)">
      <incoming>Flow_Withdrawal</incoming>
    </endEvent>

    <intermediateCatchEvent id="Catch_MeterDataReceived" name="Receive Meter Data from Grid Operator">
      <incoming>Flow_NS17</incoming>
      <outgoing>Flow_NS18</outgoing>
      <messageEventDefinition id="MED_4" />
    </intermediateCatchEvent>

    <task id="Task_ImportMeterData" name="Import Meter Data to Internal Systems">
      <incoming>Flow_NS18</incoming>
      <outgoing>Flow_NS19</outgoing>
    </task>

    <endEvent id="End_NewCustomerWon" name="New Customer Process Completed">
      <incoming>Flow_NS19</incoming>
    </endEvent>

    <!-- Sequence Flows Process 2 -->
    <sequenceFlow id="Flow_NS1" sourceRef="Start_SwitchRequestReceived" targetRef="Task_EnterCRM" />
    <sequenceFlow id="Flow_NS2" sourceRef="Task_EnterCRM" targetRef="Task_CompareData" />
    <sequenceFlow id="Flow_NS3" sourceRef="Task_CompareData" targetRef="GW_DataErrors" />
    <sequenceFlow id="Flow_ErrorYes" name="Yes" sourceRef="GW_DataErrors" targetRef="Task_CorrectErrors" />
    <sequenceFlow id="Flow_ErrorNo" name="No" sourceRef="GW_DataErrors" targetRef="GW_MergeErrors" />
    <sequenceFlow id="Flow_NS4" sourceRef="Task_CorrectErrors" targetRef="GW_MergeErrors" />
    <sequenceFlow id="Flow_NS5" sourceRef="GW_MergeErrors" targetRef="GW_CustomerExists" />
    <sequenceFlow id="Flow_CustExistsYes" name="Yes" sourceRef="GW_CustomerExists" targetRef="GW_MergeCustomerObj" />
    <sequenceFlow id="Flow_CustExistsNo" name="No" sourceRef="GW_CustomerExists" targetRef="Task_CreateCustomerObject" />
    <sequenceFlow id="Flow_NS6" sourceRef="Task_CreateCustomerObject" targetRef="GW_MergeCustomerObj" />
    <sequenceFlow id="Flow_NS7" sourceRef="GW_MergeCustomerObj" targetRef="Task_PrepareContractDocs" />
    <sequenceFlow id="Flow_NS8" sourceRef="Task_PrepareContractDocs" targetRef="Task_AutomatedCheckCIS" />
    <sequenceFlow id="Flow_NS9" sourceRef="Task_AutomatedCheckCIS" targetRef="GW_CheckDocsSuccess" />
    <sequenceFlow id="Flow_DocsSuccessNo" name="Negative Response" sourceRef="GW_CheckDocsSuccess" targetRef="Task_AnalyzeResolveIssues" />
    <sequenceFlow id="Flow_LoopDocs" sourceRef="Task_AnalyzeResolveIssues" targetRef="Task_PrepareContractDocs" />
    <sequenceFlow id="Flow_DocsSuccessYes" name="Positive Response" sourceRef="GW_CheckDocsSuccess" targetRef="Task_SendConfirmationDoc" />
    <sequenceFlow id="Flow_NS10" sourceRef="Task_SendConfirmationDoc" targetRef="Task_SendGridRequest" />
    <sequenceFlow id="Flow_NS11" sourceRef="Task_SendGridRequest" targetRef="Catch_GridResponse" />
    <sequenceFlow id="Flow_NS12" sourceRef="Catch_GridResponse" targetRef="GW_GridObjections" />
    <sequenceFlow id="Flow_ConcurrenceYes" name="Supplier Concurrence" sourceRef="GW_GridObjections" targetRef="Task_ResolveConflict" />
    <sequenceFlow id="Flow_ConcurrenceNo" name="No Objections" sourceRef="GW_GridObjections" targetRef="Task_CreateCISContract" />
    <sequenceFlow id="Flow_NS13" sourceRef="Task_ResolveConflict" targetRef="Task_CreateCISContract" />
    <sequenceFlow id="Flow_NS14" sourceRef="Task_CreateCISContract" targetRef="GW_CustomerDecision" />
    <sequenceFlow id="Flow_ToCatchDecision" sourceRef="GW_CustomerDecision" targetRef="Catch_CustomerDecision" />
    <sequenceFlow id="Flow_To7DaysTimer" sourceRef="GW_CustomerDecision" targetRef="Timer_7Days" />
    <sequenceFlow id="Flow_NS15" sourceRef="Catch_CustomerDecision" targetRef="GW_DecisionOutcome" />
    <sequenceFlow id="Flow_Withdrawal" name="Withdrawal" sourceRef="GW_DecisionOutcome" targetRef="End_Withdrawal" />
    <sequenceFlow id="Flow_Confirmed" name="Confirmation" sourceRef="GW_DecisionOutcome" targetRef="GW_MergeAcceptance" />
    <sequenceFlow id="Flow_NS16" sourceRef="Timer_7Days" targetRef="GW_MergeAcceptance" />
    <sequenceFlow id="Flow_NS17" sourceRef="GW_MergeAcceptance" targetRef="Catch_MeterDataReceived" />
    <sequenceFlow id="Flow_NS18" sourceRef="Catch_MeterDataReceived" targetRef="Task_ImportMeterData" />
    <sequenceFlow id="Flow_NS19" sourceRef="Task_ImportMeterData" targetRef="End_NewCustomerWon" />
  </process>

  <!-- PROCESS 3: Grid Operator -->
  <process id="Process_GridOperator" isExecutable="false">
    <startEvent id="Start_GridRequestReceived" name="Grid Request Received">
      <outgoing>Flow_GO1</outgoing>
      <messageEventDefinition id="MED_5" />
    </startEvent>

    <task id="Task_CheckConcurrence" name="Check Switch Request for Supplier Concurrence">
      <incoming>Flow_GO1</incoming>
      <outgoing>Flow_GO2</outgoing>
    </task>

    <exclusiveGateway id="GW_GridConcurrence" name="Supplier Concurrence Detected?">
      <incoming>Flow_GO2</incoming>
      <outgoing>Flow_GridConcYes</outgoing>
      <outgoing>Flow_GridConcNo</outgoing>
    </exclusiveGateway>

    <task id="Task_InformConflict" name="Inform Involved Suppliers &amp; Demand Resolution">
      <incoming>Flow_GridConcYes</incoming>
      <outgoing>Flow_GO3</outgoing>
    </task>

    <exclusiveGateway id="GW_MergeGridResponse" name="Merge Response">
      <incoming>Flow_GridConcNo</incoming>
      <incoming>Flow_GO3</incoming>
      <outgoing>Flow_GO4</outgoing>
    </exclusiveGateway>

    <task id="Task_SendGridResponse" name="Transmit Response Comment">
      <incoming>Flow_GO4</incoming>
      <outgoing>Flow_GO5</outgoing>
    </task>

    <task id="Task_TerminateOldAgreement" name="Communicate with Old Supplier &amp; Terminate Agreement">
      <incoming>Flow_GO5</incoming>
      <outgoing>Flow_GO6</outgoing>
    </task>

    <intermediateCatchEvent id="Timer_SwitchDate" name="On Switch-Date (Max 10 Days post Supply Start)">
      <incoming>Flow_GO6</incoming>
      <outgoing>Flow_GO7</outgoing>
      <timerEventDefinition id="TED_2" />
    </intermediateCatchEvent>

    <parallelGateway id="GW_ForkGridData" name="Fork Billing &amp; Meter Data">
      <incoming>Flow_GO7</incoming>
      <outgoing>Flow_GO8</outgoing>
      <outgoing>Flow_GO9</outgoing>
    </parallelGateway>

    <task id="Task_SendMeterData" name="Transmit Power Meter Data (Consumption Report)">
      <incoming>Flow_GO8</incoming>
      <outgoing>Flow_GO10</outgoing>
    </task>

    <task id="Task_ComputeSendFinalBillingGrid" name="Compute &amp; Send Final Billing to Old Supplier">
      <incoming>Flow_GO9</incoming>
      <outgoing>Flow_GO11</outgoing>
    </task>

    <parallelGateway id="GW_JoinGridData" name="Join Grid Tasks">
      <incoming>Flow_GO10</incoming>
      <incoming>Flow_GO11</incoming>
      <outgoing>Flow_GO12</outgoing>
    </parallelGateway>

    <endEvent id="End_GridOperator" name="Grid Operator Process Ended">
      <incoming>Flow_GO12</incoming>
    </endEvent>

    <!-- Sequence Flows Process 3 -->
    <sequenceFlow id="Flow_GO1" sourceRef="Start_GridRequestReceived" targetRef="Task_CheckConcurrence" />
    <sequenceFlow id="Flow_GO2" sourceRef="Task_CheckConcurrence" targetRef="GW_GridConcurrence" />
    <sequenceFlow id="Flow_GridConcYes" name="Yes" sourceRef="GW_GridConcurrence" targetRef="Task_InformConflict" />
    <sequenceFlow id="Flow_GridConcNo" name="No" sourceRef="GW_GridConcurrence" targetRef="GW_MergeGridResponse" />
    <sequenceFlow id="Flow_GO3" sourceRef="Task_InformConflict" targetRef="GW_MergeGridResponse" />
    <sequenceFlow id="Flow_GO4" sourceRef="GW_MergeGridResponse" targetRef="Task_SendGridResponse" />
    <sequenceFlow id="Flow_GO5" sourceRef="Task_SendGridResponse" targetRef="Task_TerminateOldAgreement" />
    <sequenceFlow id="Flow_GO6" sourceRef="Task_TerminateOldAgreement" targetRef="Timer_SwitchDate" />
    <sequenceFlow id="Flow_GO7" sourceRef="Timer_SwitchDate" targetRef="GW_ForkGridData" />
    <sequenceFlow id="Flow_GO8" sourceRef="GW_ForkGridData" targetRef="Task_SendMeterData" />
    <sequenceFlow id="Flow_GO9" sourceRef="GW_ForkGridData" targetRef="Task_ComputeSendFinalBillingGrid" />
    <sequenceFlow id="Flow_GO10" sourceRef="Task_SendMeterData" targetRef="GW_JoinGridData" />
    <sequenceFlow id="Flow_GO11" sourceRef="Task_ComputeSendFinalBillingGrid" targetRef="GW_JoinGridData" />
    <sequenceFlow id="Flow_GO12" sourceRef="GW_JoinGridData" targetRef="End_GridOperator" />
  </process>

  <!-- PROCESS 4: Old Supplier -->
  <process id="Process_OldSupplier" isExecutable="false">
    <startEvent id="Start_OldSupplier" name="Termination Request Received">
      <outgoing>Flow_OS1</outgoing>
    </startEvent>

    <task id="Task_Old_ProcessTermination" name="Process Termination of Sales Agreement">
      <incoming>Flow_OS1</incoming>
      <outgoing>Flow_OS2</outgoing>
    </task>

    <parallelGateway id="GW_Old_WaitFork" name="Await Meter Data &amp; Billing">
      <incoming>Flow_OS2</incoming>
      <outgoing>Flow_OS3</outgoing>
      <outgoing>Flow_OS4</outgoing>
    </parallelGateway>

    <task id="Task_Old_ReceiveMeterData" name="Receive Meter Data">
      <incoming>Flow_OS3</incoming>
      <outgoing>Flow_OS5</outgoing>
    </task>

    <task id="Task_Old_ReceiveGridBilling" name="Receive Final Billing from Grid Operator">
      <incoming>Flow_OS4</incoming>
      <outgoing>Flow_OS6</outgoing>
    </task>

    <parallelGateway id="GW_Old_WaitJoin" name="Join Inputs">
      <incoming>Flow_OS5</incoming>
      <incoming>Flow_OS6</incoming>
      <outgoing>Flow_OS7</outgoing>
    </parallelGateway>

    <task id="Task_Old_SendFinalBilling" name="Create and Send Final Billing to Customer">
      <incoming>Flow_OS7</incoming>
      <outgoing>Flow_OS8</outgoing>
    </task>

    <endEvent id="End_OldSupplier" name="Old Supplier Process Ended">
      <incoming>Flow_OS8</incoming>
    </endEvent>

    <!-- Sequence Flows Process 4 -->
    <sequenceFlow id="Flow_OS1" sourceRef="Start_OldSupplier" targetRef="Task_Old_ProcessTermination" />
    <sequenceFlow id="Flow_OS2" sourceRef="Task_Old_ProcessTermination" targetRef="GW_Old_WaitFork" />
    <sequenceFlow id="Flow_OS3" sourceRef="GW_Old_WaitFork" targetRef="Task_Old_ReceiveMeterData" />
    <sequenceFlow id="Flow_OS4" sourceRef="GW_Old_WaitFork" targetRef="Task_Old_ReceiveGridBilling" />
    <sequenceFlow id="Flow_OS5" sourceRef="Task_Old_ReceiveMeterData" targetRef="GW_Old_WaitJoin" />
    <sequenceFlow id="Flow_OS6" sourceRef="Task_Old_ReceiveGridBilling" targetRef="GW_Old_WaitJoin" />
    <sequenceFlow id="Flow_OS7" sourceRef="GW_Old_WaitJoin" targetRef="Task_Old_SendFinalBilling" />
    <sequenceFlow id="Flow_OS8" sourceRef="Task_Old_SendFinalBilling" targetRef="End_OldSupplier" />
  </process>

  <!-- BPMN DIAGRAM -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_SwitchOver">
    <bpmndi:BPMNPlane id="BPMNPlane_SwitchOver" bpmnElement="Collaboration_SwitchOver">

      <!-- Customer Pool -->
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2200" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Customer_di" bpmnElement="Start_Customer">
        <dc:Bounds x="212" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="191" y="185" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cust_RequestSwitch_di" bpmnElement="Task_Cust_RequestSwitch">
        <dc:Bounds x="300" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cust_CheckContract_di" bpmnElement="Task_Cust_CheckContract">
        <dc:Bounds x="1520" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cust_ReceiveFinalBilling_di" bpmnElement="Task_Cust_ReceiveFinalBilling">
        <dc:Bounds x="2100" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Customer_di" bpmnElement="End_Customer">
        <dc:Bounds x="2282" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2256" y="185" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- New Supplier Pool -->
      <bpmndi:BPMNShape id="Participant_NewSupplier_di" bpmnElement="Participant_NewSupplier" isHorizontal="true">
        <dc:Bounds x="160" y="280" width="2200" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_SwitchRequestReceived_di" bpmnElement="Start_SwitchRequestReceived">
        <dc:Bounds x="212" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="187" y="425" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterCRM_di" bpmnElement="Task_EnterCRM">
        <dc:Bounds x="300" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CompareData_di" bpmnElement="Task_CompareData">
        <dc:Bounds x="430" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_DataErrors_di" bpmnElement="GW_DataErrors" isMarkerVisible="true">
        <dc:Bounds x="565" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="557" y="345" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CorrectErrors_di" bpmnElement="Task_CorrectErrors">
        <dc:Bounds x="650" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_MergeErrors_di" bpmnElement="GW_MergeErrors" isMarkerVisible="true">
        <dc:Bounds x="785" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_CustomerExists_di" bpmnElement="GW_CustomerExists" isMarkerVisible="true">
        <dc:Bounds x="865" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="850" y="345" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateCustomerObject_di" bpmnElement="Task_CreateCustomerObject">
        <dc:Bounds x="950" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_MergeCustomerObj_di" bpmnElement="GW_MergeCustomerObj" isMarkerVisible="true">
        <dc:Bounds x="1085" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareContractDocs_di" bpmnElement="Task_PrepareContractDocs">
        <dc:Bounds x="1160" y="360" width="100" height="80" />
