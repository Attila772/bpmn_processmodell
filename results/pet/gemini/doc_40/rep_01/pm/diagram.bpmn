  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_party_part" name="Party" processRef="pool_party_proc" />
    <bpmn:participant id="pool_back_office_part" name="Client Service Back Office (Small Claims Registry Operations)" processRef="pool_back_office_proc" />
    <bpmn:participant id="pool_police_part" name="Queensland Police" processRef="pool_police_proc" />
