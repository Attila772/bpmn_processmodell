    <bpmn:messageFlow id="mf_bo_to_mc" sourceRef="evt_end_bo_file" targetRef="evt_start_mc" name="Expanded SCT physical file" />
  </bpmn:collaboration>
  <bpmn:process id="pool_party_proc" isExecutable="false">
