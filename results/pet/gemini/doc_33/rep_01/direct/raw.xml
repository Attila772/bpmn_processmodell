        <dc:Bounds x="160" y="80" x="1560" y="820" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Marketing_di" bpmnElement="Lane_Marketing" isHorizontal="true">
        <dc:Bounds x="190" y="80" x="1530" y="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CallCenter_di" bpmnElement="Lane_CallCenter" isHorizontal="true">
        <dc:Bounds x="190" y="320" x="1530" y="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HeadOfDev_di" bpmnElement="Lane_HeadOfDev" isHorizontal="true">
        <dc:Bounds x="190" y="480" x="1530" y="160" />
      </bpmndi:BPMNShape>
