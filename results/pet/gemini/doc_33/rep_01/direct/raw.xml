        <bpmndi:BPMNLabel>
          <dc:Bounds x="223" y="195" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_DetermineContact_di" bpmnElement="Task_DetermineContact">
