          <dc:Bounds x="1627" y="785" width="47" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="268" y="170" />
        <di:waypoint x="300" y="170" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="400" y="170" />
        <di:waypoint x="435" y="170" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToBuy_di" bpmnElement="Flow_ToBuy">
        <di:waypoint x="460" y="145" />
        <di:waypoint x="460" y="120" />
        <di:waypoint x="520" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToExhibitions_di" bpmnElement="Flow_ToExhibitions">
        <di:waypoint x="485" y="170" />
        <di:waypoint x="520" y="170" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToNetwork_di" bpmnElement="Flow_ToNetwork">
        <di:waypoint x="460" y="195" />
        <di:waypoint x="460" y="260" />
        <di:waypoint x="520" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_FromBuy_di" bpmnElement="Flow_FromBuy">
        <di:waypoint x="620" y="120" />
        <di:waypoint x="680" y="120" />
        <di:waypoint x="680" y="145" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_FromExhibitions_di" bpmnElement="Flow_FromExhibitions">
        <di:waypoint x="620" y="170" />
        <di:waypoint x="655" y="170" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_FromNetwork_di" bpmnElement="Flow_FromNetwork">
        <di:waypoint x="620" y="260" />
        <di:waypoint x="680" y="260" />
        <di:waypoint x="680" y="195" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToCallCenter_di" bpmnElement="Flow_ToCallCenter">
        <di:waypoint x="680" y="195" />
        <di:waypoint x="680" y="360" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="730" y="400" />
        <di:waypoint x="765" y="400" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_InterestedYes_di" bpmnElement="Flow_InterestedYes">
        <di:waypoint x="815" y="400" />
        <di:waypoint x="910" y="400" />
        <di:waypoint x="910" y="735" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="854" y="382" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_InterestedNo_di" bpmnElement="Flow_InterestedNo">
        <di:waypoint x="790" y="425" />
        <di:waypoint x="790" y="535" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="798" y="463" width="15" height="14" />
