          <dc:Bounds x="767" y="655" width="47" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sales Lane Elements -->
      <bpmndi:BPMNShape id="Gateway_AcquiredMerge_di" bpmnElement="Gateway_AcquiredMerge" isMarkerVisible="true">
        <dc:Bounds x="885" y="735" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_PresentationType_di" bpmnElement="Gateway_PresentationType" isMarkerVisible="true">
        <dc:Bounds x="975" y="735" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="968" y="705" width="64" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SalesPresentation_di" bpmnElement="Task_SalesPresentation">
        <dc:Bounds x="1060" y="670" width="100" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PreSalesPresentation_di" bpmnElement="Task_PreSalesPresentation">
        <dc:Bounds x="1060" y="780" width="100" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_PresentationMerge_di" bpmnElement="Gateway_PresentationMerge" isMarkerVisible="true">
        <dc:Bounds x="1185" y="735" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_WaitTwoWeeks_di" bpmnElement="Event_WaitTwoWeeks">
        <dc:Bounds x="1262" y="742" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1248" y="785" width="65" height="14" />
        </bpmndi:BPMNLabel>
