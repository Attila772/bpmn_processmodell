        <dc:Bounds x="520" y="230" width="100" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergeContact_di" bpmnElement="Gateway_MergeContact" isMarkerVisible="true">
        <dc:Bounds x="655" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Call Center Lane Elements -->
      <bpmndi:BPMNShape id="Task_CallCustomer_di" bpmnElement="Task_CallCustomer">
        <dc:Bounds x="630" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>

