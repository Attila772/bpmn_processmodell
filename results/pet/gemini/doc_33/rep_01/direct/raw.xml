<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Customer Acquisition Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">

    <!-- Lanes -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Marketing" name="Marketing">
        <bpmn:flowNodeRef>Start_Acquisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DetermineContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ParticipateExhibitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersonalNetwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeContact</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_CallCenter" name="Call Center">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Interested</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HeadOfDev" name="Head of Development">
        <bpmn:flowNodeRef>Gateway_BudgetHuge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersonalAcquisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotInterested</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sales" name="Sales / Pre-Sales">
        <bpmn:flowNodeRef>Gateway_AcquiredMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PresentationType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SalesPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreSalesPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PresentationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_WaitTwoWeeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CustomerContacted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowUpCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUpMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateQuotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_QuotationCreated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Phase 1: Determine Contact Details -->
    <bpmn:startEvent id="Start_Acquisition" name="Acquisition Needed">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_DetermineContact" name="Determine Contact Details">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="Gateway_DetermineContact" name="How are details obtained?">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBuy</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToExhibitions</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToNetwork</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Task_BuyDetails" name="Buy details for cold calls">
      <bpmn:incoming>Flow_ToBuy</bpmn:incoming>
      <bpmn:outgoing>Flow_FromBuy</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ParticipateExhibitions" name="Participate in exhibitions">
      <bpmn:incoming>Flow_ToExhibitions</bpmn:incoming>
      <bpmn:outgoing>Flow_FromExhibitions</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PersonalNetwork" name="Identify interested personal contacts">
      <bpmn:incoming>Flow_ToNetwork</bpmn:incoming>
      <bpmn:outgoing>Flow_FromNetwork</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="Gateway_MergeContact">
      <bpmn:incoming>Flow_FromBuy</bpmn:incoming>
      <bpmn:incoming>Flow_FromExhibitions</bpmn:incoming>
      <bpmn:incoming>Flow_FromNetwork</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCallCenter</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Phase 2: Call Center Qualification -->
    <bpmn:task id="Task_CallCustomer" name="Call customer (Determine contact person, budget, and interest)">
      <bpmn:incoming>Flow_ToCallCenter</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Interested" name="Is customer interested?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_InterestedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_InterestedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_BudgetHuge" name="Is potential budget huge?">
      <bpmn:incoming>Flow_InterestedNo</bpmn:incoming>
      <bpmn:outgoing>Flow_BudgetHugeYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_BudgetHugeNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_PersonalAcquisition" name="Head of Development tries personal acquisition">
      <bpmn:incoming>Flow_BudgetHugeYes</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_NotInterested" name="Customer Dropped">
      <bpmn:incoming>Flow_BudgetHugeNo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_AcquiredMerge">
      <bpmn:incoming>Flow_InterestedYes</bpmn:incoming>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPresentationGateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Phase 3: Online Presentation -->
    <bpmn:exclusiveGateway id="Gateway_PresentationType" name="Technical presentation required?">
      <bpmn:incoming>Flow_ToPresentationGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PresStandard</bpmn:outgoing>
      <bpmn:outgoing>Flow_PresTechnical</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_SalesPresentation" name="Give detailed online presentation (Sales Rep)">
      <bpmn:incoming>Flow_PresStandard</bpmn:incoming>
      <bpmn:outgoing>Flow_FromSalesPres</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PreSalesPresentation" name="Give technical online presentation (Pre-Sales)">
      <bpmn:incoming>Flow_PresTechnical</bpmn:incoming>
      <bpmn:outgoing>Flow_FromPreSalesPres</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_PresentationMerge">
      <bpmn:incoming>Flow_FromSalesPres</bpmn:incoming>
      <bpmn:incoming>Flow_FromPreSalesPres</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWait</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Phase 4: Follow-up & Quotation -->
    <bpmn:intermediateCatchEvent id="Event_WaitTwoWeeks" name="Wait 2 weeks">
      <bpmn:incoming>Flow_ToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterWait</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_CustomerContacted" name="Has customer contacted back?">
      <bpmn:incoming>Flow_AfterWait</bpmn:incoming>
      <bpmn:outgoing>Flow_ContactedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContactedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_FollowUpCall" name="Call customer (Sales Rep follow-up)">
      <bpmn:incoming>Flow_ContactedNo</bpmn:incoming>
      <bpmn:outgoing>Flow_FromFollowUp</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_FollowUpMerge">
      <bpmn:incoming>Flow_ContactedYes</bpmn:incoming>
      <bpmn:incoming>Flow_FromFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQuotation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CreateQuotation" name="Create Quotation">
      <bpmn:incoming>Flow_ToQuotation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFinish</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_QuotationCreated" name="Quotation Created">
      <bpmn:incoming>Flow_ToFinish</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Acquisition" targetRef="Task_DetermineContact" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_DetermineContact" targetRef="Gateway_DetermineContact" />
    
    <bpmn:sequenceFlow id="Flow_ToBuy" name="Buy cold call details" sourceRef="Gateway_DetermineContact" targetRef="Task_BuyDetails" />
    <bpmn:sequenceFlow id="Flow_ToExhibitions" name="Exhibition leads" sourceRef="Gateway_DetermineContact" targetRef="Task_ParticipateExhibitions" />
    <bpmn:sequenceFlow id="Flow_ToNetwork" name="Personal network" sourceRef="Gateway_DetermineContact" targetRef="Task_PersonalNetwork" />
    
    <bpmn:sequenceFlow id="Flow_FromBuy" sourceRef="Task_BuyDetails" targetRef="Gateway_MergeContact" />
    <bpmn:sequenceFlow id="Flow_FromExhibitions" sourceRef="Task_ParticipateExhibitions" targetRef="Gateway_MergeContact" />
    <bpmn:sequenceFlow id="Flow_FromNetwork" sourceRef="Task_PersonalNetwork" targetRef="Gateway_MergeContact" />
    
    <bpmn:sequenceFlow id="Flow_ToCallCenter" sourceRef="Gateway_MergeContact" targetRef="Task_CallCustomer" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CallCustomer" targetRef="Gateway_Interested" />
    
    <bpmn:sequenceFlow id="Flow_InterestedYes" name="Yes" sourceRef="Gateway_Interested" targetRef="Gateway_AcquiredMerge" />
    <bpmn:sequenceFlow id="Flow_InterestedNo" name="No" sourceRef="Gateway_Interested" targetRef="Gateway_BudgetHuge" />
    
    <bpmn:sequenceFlow id="Flow_BudgetHugeYes" name="Yes" sourceRef="Gateway_BudgetHuge" targetRef="Task_PersonalAcquisition" />
    <bpmn:sequenceFlow id="Flow_BudgetHugeNo" name="No" sourceRef="Gateway_BudgetHuge" targetRef="End_NotInterested" />
    
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PersonalAcquisition" targetRef="Gateway_AcquiredMerge" />
    
    <bpmn:sequenceFlow id="Flow_ToPresentationGateway" sourceRef="Gateway_AcquiredMerge" targetRef="Gateway_PresentationType" />
    
    <bpmn:sequenceFlow id="Flow_PresStandard" name="No (Standard)" sourceRef="Gateway_PresentationType" targetRef="Task_SalesPresentation" />
    <bpmn:sequenceFlow id="Flow_PresTechnical" name="Yes (More technical)" sourceRef="Gateway_PresentationType" targetRef="Task_PreSalesPresentation" />
    
    <bpmn:sequenceFlow id="Flow_FromSalesPres" sourceRef="Task_SalesPresentation" targetRef="Gateway_PresentationMerge" />
    <bpmn:sequenceFlow id="Flow_FromPreSalesPres" sourceRef="Task_PreSalesPresentation" targetRef="Gateway_PresentationMerge" />
    
    <bpmn:sequenceFlow id="Flow_ToWait" sourceRef="Gateway_PresentationMerge" targetRef="Event_WaitTwoWeeks" />
    <bpmn:sequenceFlow id="Flow_AfterWait" sourceRef="Event_WaitTwoWeeks" targetRef="Gateway_CustomerContacted" />
    
    <bpmn:sequenceFlow id="Flow_ContactedYes" name="Yes" sourceRef="Gateway_CustomerContacted" targetRef="Gateway_FollowUpMerge" />
    <bpmn:sequenceFlow id="Flow_ContactedNo" name="No" sourceRef="Gateway_CustomerContacted" targetRef="Task_FollowUpCall" />
    
    <bpmn:sequenceFlow id="Flow_FromFollowUp" sourceRef="Task_FollowUpCall" targetRef="Gateway_FollowUpMerge" />
    <bpmn:sequenceFlow id="Flow_ToQuotation" sourceRef="Gateway_FollowUpMerge" targetRef="Task_CreateQuotation" />
    <bpmn:sequenceFlow id="Flow_ToFinish" sourceRef="Task_CreateQuotation" targetRef="End_QuotationCreated" />

  </bpmn:process>

  <!-- BPMN Diagram Layout -->
