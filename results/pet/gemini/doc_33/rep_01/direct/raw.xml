        <dc:Bounds x="1435" y="735" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CreateQuotation_di" bpmnElement="Task_CreateQuotation">
        <dc:Bounds x="1500" y="720" width="100" height="80" />
      </bpmndi:BPMNShape>

