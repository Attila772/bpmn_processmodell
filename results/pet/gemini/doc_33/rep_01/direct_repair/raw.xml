<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_CustomerAcquisition"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- COLLABORATION -->
  <bpmn:collaboration id="Collaboration_CustomerAcquisition">
    <bpmn:participant id="Participant_Company" name="Customer Acquisition Process" processRef="Process_CustomerAcquisition" />
  </bpmn:collaboration>

  <!-- PROCESS -->
  <bpmn:process id="Process_CustomerAcquisition" isExecutable="true">

    <!-- LANES -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Marketing" name="Marketing / Lead Gen">
        <bpmn:flowNodeRef>Start_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AcquireDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exhibitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersonalContacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CallCenter" name="Call Center Agent">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BudgetCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotInterested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HeadOfDev" name="Head of Development">
        <bpmn:flowNodeRef>Task_HeadOfDevAcquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DevInterest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales Representative">
        <bpmn:flowNodeRef>Task_SalesPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowUpCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateQuotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_QuotationCreated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PreSales" name="Pre-Sales Employee">
        <bpmn:flowNodeRef>Task_TechPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Customer" name="Customer Interactions">
        <bpmn:flowNodeRef>Gateway_PresType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergePres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CustomerResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CustomerContacted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_2WeeksTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeResponse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- FLOW NODES -->
    <!-- Marketing / Lead Gen -->
    <bpmn:startEvent id="Start_Process" name="Potential customer identified">
      <bpmn:outgoing>Flow_ToAcquireGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:inclusiveGateway id="Gateway_AcquireDetails" name="How were details obtained?">
      <bpmn:incoming>Flow_ToAcquireGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBuyDetails</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToExhibitions</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToPersonalContacts</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Task_BuyDetails" name="Buy details for cold calls">
      <bpmn:incoming>Flow_ToBuyDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_FromBuyDetails</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Exhibitions" name="Participate in exhibitions">
      <bpmn:incoming>Flow_ToExhibitions</bpmn:incoming>
      <bpmn:outgoing>Flow_FromExhibitions</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PersonalContacts" name="Identify interested personal contact">
      <bpmn:incoming>Flow_ToPersonalContacts</bpmn:incoming>
      <bpmn:outgoing>Flow_FromPersonalContacts</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="Gateway_MergeDetails">
      <bpmn:incoming>Flow_FromBuyDetails</bpmn:incoming>
      <bpmn:incoming>Flow_FromExhibitions</bpmn:incoming>
      <bpmn:incoming>Flow_FromPersonalContacts</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCallCustomer</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Call Center Agent -->
    <bpmn:task id="Task_CallCustomer" name="Call customer (Determine contact person, budget, and interest)">
      <bpmn:incoming>Flow_ToCallCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInterestGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Interest" name="Generally interested?">
      <bpmn:incoming>Flow_ToInterestGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_InterestedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_InterestedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_BudgetCheck" name="Potential project budget is huge?">
      <bpmn:incoming>Flow_InterestedNo</bpmn:incoming>
      <bpmn:outgoing>Flow_BudgetHuge</bpmn:outgoing>
      <bpmn:outgoing>Flow_BudgetNotHuge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_NotInterested" name="Customer not acquired">
      <bpmn:incoming>Flow_BudgetNotHuge</bpmn:incoming>
      <bpmn:incoming>Flow_DevInterestNo</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Head of Development -->
    <bpmn:task id="Task_HeadOfDevAcquire" name="Personally try to acquire customer">
      <bpmn:incoming>Flow_BudgetHuge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDevInterestGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_DevInterest" name="Customer interested now?">
      <bpmn:incoming>Flow_ToDevInterestGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DevInterestYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DevInterestNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Customer / Routing for Presentation -->
    <bpmn:exclusiveGateway id="Gateway_PresType" name="Presentation type required?">
      <bpmn:incoming>Flow_InterestedYes</bpmn:incoming>
      <bpmn:incoming>Flow_DevInterestYes</bpmn:incoming>
      <bpmn:outgoing>Flow_PresStandard</bpmn:outgoing>
      <bpmn:outgoing>Flow_PresTechnical</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sales & PreSales Tasks -->
    <bpmn:task id="Task_SalesPresentation" name="Give detailed online presentation (Standard)">
      <bpmn:incoming>Flow_PresStandard</bpmn:incoming>
      <bpmn:outgoing>Flow_FromSalesPres</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TechPresentation" name="Give detailed technical online presentation">
      <bpmn:incoming>Flow_PresTechnical</bpmn:incoming>
      <bpmn:outgoing>Flow_FromTechPres</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MergePres">
      <bpmn:incoming>Flow_FromSalesPres</bpmn:incoming>
      <bpmn:incoming>Flow_FromTechPres</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCustomerWait</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Waiting for Customer -->
    <bpmn:eventBasedGateway id="Gateway_CustomerResponse" name="Wait for customer response">
      <bpmn:incoming>Flow_ToCustomerWait</bpmn:incoming>
      <bpmn:outgoing>Flow_ToContactedEvent</bpmn:outgoing>
      <bpmn:outgoing>Flow_To2WeeksTimer</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_CustomerContacted" name="Customer contacts back within 2 weeks">
      <bpmn:incoming>Flow_ToContactedEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_FromContactedEvent</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_2WeeksTimer" name="2 weeks timeout">
      <bpmn:incoming>Flow_To2WeeksTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_FromTimer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_FollowUpCall" name="Call customer for follow-up">
      <bpmn:incoming>Flow_FromTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_FromFollowUp</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MergeResponse">
      <bpmn:incoming>Flow_FromContactedEvent</bpmn:incoming>
      <bpmn:incoming>Flow_FromFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateQuotation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CreateQuotation" name="Create quotation">
      <bpmn:incoming>Flow_ToCreateQuotation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQuotationCreated</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_QuotationCreated" name="Quotation created">
      <bpmn:incoming>Flow_ToQuotationCreated</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_ToAcquireGateway" sourceRef="Start_Process" targetRef="Gateway_AcquireDetails" />
    <bpmn:sequenceFlow id="Flow_ToBuyDetails" sourceRef="Gateway_AcquireDetails" targetRef="Task_BuyDetails" />
    <bpmn:sequenceFlow id="Flow_ToExhibitions" sourceRef="Gateway_AcquireDetails" targetRef="Task_Exhibitions" />
    <bpmn:sequenceFlow id="Flow_ToPersonalContacts" sourceRef="Gateway_AcquireDetails" targetRef="Task_PersonalContacts" />
    
    <bpmn:sequenceFlow id="Flow_FromBuyDetails" sourceRef="Task_BuyDetails" targetRef="Gateway_MergeDetails" />
    <bpmn:sequenceFlow id="Flow_FromExhibitions" sourceRef="Task_Exhibitions" targetRef="Gateway_MergeDetails" />
    <bpmn:sequenceFlow id="Flow_FromPersonalContacts" sourceRef="Task_PersonalContacts" targetRef="Gateway_MergeDetails" />
    
    <bpmn:sequenceFlow id="Flow_ToCallCustomer" sourceRef="Gateway_MergeDetails" targetRef="Task_CallCustomer" />
    <bpmn:sequenceFlow id="Flow_ToInterestGateway" sourceRef="Task_CallCustomer" targetRef="Gateway_Interest" />
    
    <bpmn:sequenceFlow id="Flow_InterestedYes" name="Yes" sourceRef="Gateway_Interest" targetRef="Gateway_PresType" />
    <bpmn:sequenceFlow id="Flow_InterestedNo" name="No" sourceRef="Gateway_Interest" targetRef="Gateway_BudgetCheck" />
    
    <bpmn:sequenceFlow id="Flow_BudgetNotHuge" name="No" sourceRef="Gateway_BudgetCheck" targetRef="End_NotInterested" />
    <bpmn:sequenceFlow id="Flow_BudgetHuge" name="Yes (Huge)" sourceRef="Gateway_BudgetCheck" targetRef="Task_HeadOfDevAcquire" />
    
    <bpmn:sequenceFlow id="Flow_ToDevInterestGateway" sourceRef="Task_HeadOfDevAcquire" targetRef="Gateway_DevInterest" />
    <bpmn:sequenceFlow id="Flow_DevInterestYes" name="Yes" sourceRef="Gateway_DevInterest" targetRef="Gateway_PresType" />
    <bpmn:sequenceFlow id="Flow_DevInterestNo" name="No" sourceRef="Gateway_DevInterest" targetRef="End_NotInterested" />
    
    <bpmn:sequenceFlow id="Flow_PresStandard" name="Standard" sourceRef="Gateway_PresType" targetRef="Task_SalesPresentation" />
    <bpmn:sequenceFlow id="Flow_PresTechnical" name="Technical" sourceRef="Gateway_PresType" targetRef="Task_TechPresentation" />
    
    <bpmn:sequenceFlow id="Flow_FromSalesPres" sourceRef="Task_SalesPresentation" targetRef="Gateway_MergePres" />
    <bpmn:sequenceFlow id="Flow_FromTechPres" sourceRef="Task_TechPresentation" targetRef="Gateway_MergePres" />
    
    <bpmn:sequenceFlow id="Flow_ToCustomerWait" sourceRef="Gateway_MergePres" targetRef="Gateway_CustomerResponse" />
    
    <bpmn:sequenceFlow id="Flow_ToContactedEvent" sourceRef="Gateway_CustomerResponse" targetRef="Event_CustomerContacted" />
    <bpmn:sequenceFlow id="Flow_To2WeeksTimer" sourceRef="Gateway_CustomerResponse" targetRef="Event_2WeeksTimer" />
    
    <bpmn:sequenceFlow id="Flow_FromContactedEvent" sourceRef="Event_CustomerContacted" targetRef="Gateway_MergeResponse" />
    <bpmn:sequenceFlow id="Flow_FromTimer" sourceRef="Event_2WeeksTimer" targetRef="Task_FollowUpCall" />
    <bpmn:sequenceFlow id="Flow_FromFollowUp" sourceRef="Task_FollowUpCall" targetRef="Gateway_MergeResponse" />
    
    <bpmn:sequenceFlow id="Flow_ToCreateQuotation" sourceRef="Gateway_MergeResponse" targetRef="Task_CreateQuotation" />
    <bpmn:sequenceFlow id="Flow_ToQuotationCreated" sourceRef="Task_CreateQuotation" targetRef="End_QuotationCreated" />

  </bpmn:process>

  <!-- DIAGRAM -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_CustomerAcquisition">
    <bpmndi:BPMNPlane id="BPMNPlane_CustomerAcquisition" bpmnElement="Collaboration_CustomerAcquisition">
      
      <!-- Pool -->
      <bpmndi:BPMNShape id="Participant_Company_di" bpmnElement="Participant_Company" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1680" height="910" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Marketing_di" bpmnElement="Lane_Marketing" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1650" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CallCenter_di" bpmnElement="Lane_CallCenter" isHorizontal="true">
        <dc:Bounds x="190" y="270" width="1650" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HeadOfDev_di" bpmnElement="Lane_HeadOfDev" isHorizontal="true">
        <dc:Bounds x="190" y="430" width="1650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true">
        <dc:Bounds x="190" y="570" width="1650" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sales_di" bpmnElement="Lane_Sales" isHorizontal="true">
        <dc:Bounds x="190" y="720" width="1650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PreSales_di" bpmnElement="Lane_PreSales" isHorizontal="true">
        <dc:Bounds x="190" y="860" width="1650" height="130" />
      </bpmndi:BPMNShape>

      <!-- Marketing Elements -->
      <bpmndi:BPMNShape id="Start_Process_di" bpmnElement="Start_Process">
        <dc:Bounds x="232" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="206" y="195" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_AcquireDetails_di" bpmnElement="Gateway_AcquireDetails" isMarkerVisible="true">
        <dc:Bounds x="315" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="300" y="108" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_BuyDetails_di" bpmnElement="Task_BuyDetails">
        <dc:Bounds x="410" y="90" width="100" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Exhibitions_di" bpmnElement="Task_Exhibitions">
        <dc:Bounds x="410" y="145" width="100" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PersonalContacts_di" bpmnElement="Task_PersonalContacts">
        <dc:Bounds x="410" y="200" width="100" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergeDetails_di" bpmnElement="Gateway_MergeDetails" isMarkerVisible="true">
        <dc:Bounds x="555" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Call Center Elements -->
      <bpmndi:BPMNShape id="Task_CallCustomer_di" bpmnElement="Task_CallCustomer">
        <dc:Bounds x="530" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Interest_di" bpmnElement="Gateway_Interest" isMarkerVisible="true">
        <dc:Bounds x="675" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="672" y="295" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_BudgetCheck_di" bpmnElement="Gateway_BudgetCheck" isMarkerVisible="true">
        <dc:Bounds x="785" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="771" y="288" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_NotInterested_di" bpmnElement="End_NotInterested">
        <dc:Bounds x="912" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="896" y="375" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Head of Dev Elements -->
      <bpmndi:BPMNShape id="Task_HeadOfDevAcquire_di" bpmnElement="Task_HeadOfDevAcquire">
        <dc:Bounds x="760" y="460" width="100" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_DevInterest_di" bpmnElement="Gateway_DevInterest" isMarkerVisible="true">
        <dc:Bounds x="905" y="465" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="892" y="428" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Presentation Routing & Execution -->
      <bpmndi:BPMNShape id="Gateway_PresType_di" bpmnElement="Gateway_PresType" isMarkerVisible="true">
        <dc:Bounds x="995" y="625" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="636" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SalesPresentation_di" bpmnElement="Task_SalesPresentation">
        <dc:Bounds x="1090" y="750" width="100" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TechPresentation_di" bpmnElement="Task_TechPresentation">
        <dc:Bounds x="1090" y="890" width="100" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergePres_di" bpmnElement="Gateway_MergePres" isMarkerVisible="true">
        <dc:Bounds x="1225" y="625" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Customer Wait & Response -->
      <bpmndi:BPMNShape id="Gateway_CustomerResponse_di" bpmnElement="Gateway_CustomerResponse">
        <dc:Bounds x="1315" y="625" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1298" y="588" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_CustomerContacted_di" bpmnElement="Event_CustomerContacted">
        <dc:Bounds x="1412" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1393" y="645" width="74" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_2WeeksTimer_di" bpmnElement="Event_2WeeksTimer">
        <dc:Bounds x="1412" y="662" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1391" y="705" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FollowUpCall_di" bpmnElement="Task_FollowUpCall">
        <dc:Bounds x="1490" y="750" width="100" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergeResponse_di" bpmnElement="Gateway_MergeResponse" isMarkerVisible="true">
        <dc:Bounds x="1605" y="625" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CreateQuotation_di" bpmnElement="Task_CreateQuotation">
        <dc:Bounds x="1600" y="750" width="100" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_QuotationCreated_di" bpmnElement="End_QuotationCreated">
        <dc:Bounds x="1752" y="762" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1727" y="805" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_ToAcquireGateway_di" bpmnElement="Flow_ToAcquireGateway">
        <di:waypoint x="268" y="170" />
        <di:waypoint x="315" y="170" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToBuyDetails_di" bpmnElement="Flow_ToBuyDetails">
        <di:waypoint x="340" y="145" />
        <di:waypoint x="340" y="115" />
        <di:waypoint x="410" y="115" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToExhibitions_di" bpmnElement="Flow_ToExhibitions">
        <di:waypoint x="365" y="170" />
        <di:waypoint x="410" y="170" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToPersonalContacts_di" bpmnElement="Flow_ToPersonalContacts">
        <di:waypoint x="340" y="195" />
        <di:waypoint x="340" y="225" />
        <di:waypoint x="410" y="225" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_FromBuyDetails_di" bpmnElement="Flow_FromBuyDetails">
        <di:waypoint x="510" y="115" />
        <di:waypoint x="580" y="115" />
        <di:waypoint x="580" y="145" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_FromExhibitions_di" bpmnElement="Flow_FromExhibitions">
        <di:waypoint x="510" y="170" />
        <di:waypoint x="555" y="170" />
      </bpmndi:BPMNEdge>

