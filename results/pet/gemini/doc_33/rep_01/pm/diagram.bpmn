<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_contact_details" name="Customer Contact Details" dataObjectRef="data_contact_details_do" />
    <bpmn:dataObject id="data_contact_details_do" />
    <bpmn:dataObjectReference id="data_quotation" name="Quotation" dataObjectRef="data_quotation_do" />
    <bpmn:dataObject id="data_quotation_do" />
    <bpmn:startEvent id="start_event" name="Need for potential customers">
      <bpmn:outgoing>flow_start_to_gtw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="timer_wait_2_weeks" name="Wait 2 weeks for customer contact">
      <bpmn:incoming>flow_pres_to_timer</bpmn:incoming>
      <bpmn:outgoing>flow_timer_to_check_contact</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_wait_2_weeks_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_event_not_interested" name="Customer not interested">
      <bpmn:incoming>flow_normal_budget</bpmn:incoming>
      <bpmn:incoming>flow_head_fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_quotation_created" name="Quotation created">
      <bpmn:incoming>flow_quotation_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_buy_details" name="Buy details for cold calls">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_buy_to_merge</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_buy_details_doa0">
        <bpmn:targetRef>data_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_exhibitions" name="Participate in exhibitions">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_exh_to_merge</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_exhibitions_doa0">
        <bpmn:targetRef>data_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_personal_contacts" name="Identify interested contacts">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_pers_to_merge</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_personal_contacts_doa0">
        <bpmn:targetRef>data_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_call_customer" name="Call customer to determine contact person, budget, and interest">
      <bpmn:incoming>flow_merge_to_call</bpmn:incoming>
      <bpmn:outgoing>flow_call_to_check_interest</bpmn:outgoing>
      <bpmn:property id="task_call_customer_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_call_customer_dia0">
        <bpmn:sourceRef>data_contact_details</bpmn:sourceRef>
        <bpmn:targetRef>task_call_customer_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_head_acquire" name="Personally try to acquire customer">
      <bpmn:incoming>flow_huge_budget</bpmn:incoming>
      <bpmn:outgoing>flow_head_to_check</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_sales_pres" name="Give detailed online presentation (Sales)">
      <bpmn:incoming>flow_non_technical</bpmn:incoming>
      <bpmn:outgoing>flow_sales_pres_to_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_presales_pres" name="Give detailed online presentation (Technical)">
      <bpmn:incoming>flow_technical</bpmn:incoming>
      <bpmn:outgoing>flow_presales_pres_to_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_follow_up_call" name="Call customer for follow-up">
      <bpmn:incoming>flow_not_contacted</bpmn:incoming>
      <bpmn:outgoing>flow_follow_up_to_merge</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_create_quotation" name="Create quotation">
      <bpmn:incoming>flow_merge_to_quotation</bpmn:incoming>
      <bpmn:outgoing>flow_quotation_to_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_quotation_doa0">
        <bpmn:targetRef>data_quotation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gtw_aquisition_method" name="How details are determined?" isMarkerVisible="true">
      <bpmn:incoming>flow_start_to_gtw</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_merge_acquisition" name="Merge acquisition methods" isMarkerVisible="true">
      <bpmn:incoming>flow_buy_to_merge</bpmn:incoming>
      <bpmn:incoming>flow_exh_to_merge</bpmn:incoming>
      <bpmn:incoming>flow_pers_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_call</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_check_interest" name="Is customer interested?" isMarkerVisible="true">
      <bpmn:incoming>flow_call_to_check_interest</bpmn:incoming>
      <bpmn:outgoing>flow_interested</bpmn:outgoing>
      <bpmn:outgoing>flow_not_interested</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_check_budget" name="Is potential budget huge?" isMarkerVisible="true">
      <bpmn:incoming>flow_not_interested</bpmn:incoming>
      <bpmn:outgoing>flow_normal_budget</bpmn:outgoing>
      <bpmn:outgoing>flow_huge_budget</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_check_head_success" name="Is customer interested in the end?" isMarkerVisible="true">
      <bpmn:incoming>flow_head_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_head_success</bpmn:outgoing>
      <bpmn:outgoing>flow_head_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_merge_interest" name="Merge interested leads" isMarkerVisible="true">
      <bpmn:incoming>flow_interested</bpmn:incoming>
      <bpmn:incoming>flow_head_success</bpmn:incoming>
      <bpmn:outgoing>flow_merge_interest_to_pres_type</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_pres_type" name="Is presentation technical?" isMarkerVisible="true">
      <bpmn:incoming>flow_merge_interest_to_pres_type</bpmn:incoming>
      <bpmn:outgoing>flow_non_technical</bpmn:outgoing>
      <bpmn:outgoing>flow_technical</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_merge_pres" name="Merge presentations" isMarkerVisible="true">
      <bpmn:incoming>flow_sales_pres_to_merge</bpmn:incoming>
      <bpmn:incoming>flow_presales_pres_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_pres_to_timer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_customer_contacted" name="Did customer contact back within 2 weeks?" isMarkerVisible="true">
      <bpmn:incoming>flow_timer_to_check_contact</bpmn:incoming>
      <bpmn:outgoing>flow_contacted</bpmn:outgoing>
      <bpmn:outgoing>flow_not_contacted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_merge_before_quotation" name="Merge before quotation" isMarkerVisible="true">
      <bpmn:incoming>flow_contacted</bpmn:incoming>
      <bpmn:incoming>flow_follow_up_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_quotation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_gtw" sourceRef="start_event" targetRef="gtw_aquisition_method" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="gtw_aquisition_method" targetRef="task_buy_details" name="Buy details" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="gtw_aquisition_method" targetRef="task_exhibitions" name="Exhibitions" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="gtw_aquisition_method" targetRef="task_personal_contacts" name="Personal contacts" />
    <bpmn:sequenceFlow id="flow_buy_to_merge" sourceRef="task_buy_details" targetRef="gtw_merge_acquisition" />
    <bpmn:sequenceFlow id="flow_exh_to_merge" sourceRef="task_exhibitions" targetRef="gtw_merge_acquisition" />
    <bpmn:sequenceFlow id="flow_pers_to_merge" sourceRef="task_personal_contacts" targetRef="gtw_merge_acquisition" />
    <bpmn:sequenceFlow id="flow_merge_to_call" sourceRef="gtw_merge_acquisition" targetRef="task_call_customer" />
    <bpmn:sequenceFlow id="flow_call_to_check_interest" sourceRef="task_call_customer" targetRef="gtw_check_interest" />
    <bpmn:sequenceFlow id="flow_interested" sourceRef="gtw_check_interest" targetRef="gtw_merge_interest" name="Yes" />
    <bpmn:sequenceFlow id="flow_not_interested" sourceRef="gtw_check_interest" targetRef="gtw_check_budget" name="No" />
    <bpmn:sequenceFlow id="flow_normal_budget" sourceRef="gtw_check_budget" targetRef="end_event_not_interested" name="No" />
    <bpmn:sequenceFlow id="flow_huge_budget" sourceRef="gtw_check_budget" targetRef="task_head_acquire" name="Yes" />
    <bpmn:sequenceFlow id="flow_head_to_check" sourceRef="task_head_acquire" targetRef="gtw_check_head_success" />
    <bpmn:sequenceFlow id="flow_head_success" sourceRef="gtw_check_head_success" targetRef="gtw_merge_interest" name="Yes" />
    <bpmn:sequenceFlow id="flow_head_fail" sourceRef="gtw_check_head_success" targetRef="end_event_not_interested" name="No" />
    <bpmn:sequenceFlow id="flow_merge_interest_to_pres_type" sourceRef="gtw_merge_interest" targetRef="gtw_pres_type" />
    <bpmn:sequenceFlow id="flow_non_technical" sourceRef="gtw_pres_type" targetRef="task_sales_pres" name="No" />
    <bpmn:sequenceFlow id="flow_technical" sourceRef="gtw_pres_type" targetRef="task_presales_pres" name="Yes" />
    <bpmn:sequenceFlow id="flow_sales_pres_to_merge" sourceRef="task_sales_pres" targetRef="gtw_merge_pres" />
    <bpmn:sequenceFlow id="flow_presales_pres_to_merge" sourceRef="task_presales_pres" targetRef="gtw_merge_pres" />
    <bpmn:sequenceFlow id="flow_pres_to_timer" sourceRef="gtw_merge_pres" targetRef="timer_wait_2_weeks" />
    <bpmn:sequenceFlow id="flow_timer_to_check_contact" sourceRef="timer_wait_2_weeks" targetRef="gtw_customer_contacted" />
    <bpmn:sequenceFlow id="flow_contacted" sourceRef="gtw_customer_contacted" targetRef="gtw_merge_before_quotation" name="Yes" />
    <bpmn:sequenceFlow id="flow_not_contacted" sourceRef="gtw_customer_contacted" targetRef="task_follow_up_call" name="No" />
    <bpmn:sequenceFlow id="flow_follow_up_to_merge" sourceRef="task_follow_up_call" targetRef="gtw_merge_before_quotation" />
    <bpmn:sequenceFlow id="flow_merge_to_quotation" sourceRef="gtw_merge_before_quotation" targetRef="task_create_quotation" />
    <bpmn:sequenceFlow id="flow_quotation_to_end" sourceRef="task_create_quotation" targetRef="end_event_quotation_created" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_event_not_interested_di" bpmnElement="end_event_not_interested">
        <dc:Bounds x="1870" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_quotation_created_di" bpmnElement="end_event_quotation_created">
        <dc:Bounds x="2820" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_aquisition_method_di" bpmnElement="gtw_aquisition_method">
        <dc:Bounds x="350" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_check_budget_di" bpmnElement="gtw_check_budget">
        <dc:Bounds x="1300" y="100" width="50" height="50" />
