      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_check_interest_di" bpmnElement="gtw_check_interest">
        <dc:Bounds x="1110" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_customer_contacted_di" bpmnElement="gtw_customer_contacted">
        <dc:Bounds x="2250" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_merge_acquisition_di" bpmnElement="gtw_merge_acquisition">
        <dc:Bounds x="730" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_merge_before_quotation_di" bpmnElement="gtw_merge_before_quotation">
        <dc:Bounds x="2630" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_merge_interest_di" bpmnElement="gtw_merge_interest">
        <dc:Bounds x="1870" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_merge_pres_di" bpmnElement="gtw_merge_pres">
        <dc:Bounds x="1870" y="350" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_pres_type_di" bpmnElement="gtw_pres_type">
        <dc:Bounds x="1490" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_buy_details_di" bpmnElement="task_buy_details">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_call_customer_di" bpmnElement="task_call_customer">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_create_quotation_di" bpmnElement="task_create_quotation">
        <dc:Bounds x="2630" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_exhibitions_di" bpmnElement="task_exhibitions">
        <dc:Bounds x="540" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_follow_up_call_di" bpmnElement="task_follow_up_call">
        <dc:Bounds x="2440" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_head_acquire_di" bpmnElement="task_head_acquire">
        <dc:Bounds x="1490" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_personal_contacts_di" bpmnElement="task_personal_contacts">
        <dc:Bounds x="540" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_presales_pres_di" bpmnElement="task_presales_pres">
        <dc:Bounds x="1680" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_sales_pres_di" bpmnElement="task_sales_pres">
        <dc:Bounds x="1680" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="timer_wait_2_weeks_di" bpmnElement="timer_wait_2_weeks">
        <dc:Bounds x="2060" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_contact_details_di" bpmnElement="data_contact_details">
        <dc:Bounds x="655" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_quotation_di" bpmnElement="data_quotation">
        <dc:Bounds x="2650" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_gtw_di" bpmnElement="flow_start_to_gtw">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="375" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="375" y="125" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="375" y="125" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="375" y="125" />
        <di:waypoint x="590" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_buy_to_merge_di" bpmnElement="flow_buy_to_merge">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_exh_to_merge_di" bpmnElement="flow_exh_to_merge">
        <di:waypoint x="590" y="265" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_pers_to_merge_di" bpmnElement="flow_pers_to_merge">
        <di:waypoint x="590" y="390" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_to_call_di" bpmnElement="flow_merge_to_call">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_call_to_check_interest_di" bpmnElement="flow_call_to_check_interest">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_di" bpmnElement="flow_interested">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1895" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_not_interested_di" bpmnElement="flow_not_interested">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_normal_budget_di" bpmnElement="flow_normal_budget">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="1888" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_huge_budget_di" bpmnElement="flow_huge_budget">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="1540" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_head_to_check_di" bpmnElement="flow_head_to_check">
        <di:waypoint x="1540" y="265" />
        <di:waypoint x="1705" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_head_success_di" bpmnElement="flow_head_success">
        <di:waypoint x="1705" y="125" />
        <di:waypoint x="1895" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_head_fail_di" bpmnElement="flow_head_fail">
        <di:waypoint x="1705" y="125" />
        <di:waypoint x="1888" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_interest_to_pres_type_di" bpmnElement="flow_merge_interest_to_pres_type">
        <di:waypoint x="1895" y="250" />
        <di:waypoint x="1515" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_non_technical_di" bpmnElement="flow_non_technical">
        <di:waypoint x="1515" y="125" />
        <di:waypoint x="1730" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_technical_di" bpmnElement="flow_technical">
        <di:waypoint x="1515" y="125" />
        <di:waypoint x="1730" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sales_pres_to_merge_di" bpmnElement="flow_sales_pres_to_merge">
        <di:waypoint x="1730" y="390" />
        <di:waypoint x="1895" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_presales_pres_to_merge_di" bpmnElement="flow_presales_pres_to_merge">
        <di:waypoint x="1730" y="265" />
        <di:waypoint x="1895" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_pres_to_timer_di" bpmnElement="flow_pres_to_timer">
        <di:waypoint x="1895" y="375" />
        <di:waypoint x="2078" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_timer_to_check_contact_di" bpmnElement="flow_timer_to_check_contact">
        <di:waypoint x="2078" y="118" />
        <di:waypoint x="2275" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_contacted_di" bpmnElement="flow_contacted">
        <di:waypoint x="2275" y="125" />
