        <di:waypoint x="673" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_personal_network_doa0_di" bpmnElement="task_personal_network_doa0">
        <di:waypoint x="590" y="390" />
        <di:waypoint x="673" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_call_customer_dia0_di" bpmnElement="task_call_customer_dia0">
        <di:waypoint x="673" y="515" />
