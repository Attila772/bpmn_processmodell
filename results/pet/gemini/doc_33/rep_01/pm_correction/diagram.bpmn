        <di:waypoint x="2648" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_buy_details_doa0_di" bpmnElement="task_buy_details_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="673" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_exhibitions_doa0_di" bpmnElement="task_exhibitions_doa0">
