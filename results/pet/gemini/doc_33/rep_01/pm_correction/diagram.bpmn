      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_create_quotation_doa0_di" bpmnElement="task_create_quotation_doa0">
        <di:waypoint x="2490" y="140" />
        <di:waypoint x="2478" y="515" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>