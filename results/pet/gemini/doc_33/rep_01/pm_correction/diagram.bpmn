      <bpmndi:BPMNShape id="gw_customer_response_di" bpmnElement="gw_customer_response">
        <dc:Bounds x="2060" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_follow_up_join_di" bpmnElement="gw_follow_up_join">
        <dc:Bounds x="2630" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_interest_check_di" bpmnElement="gw_interest_check">
        <dc:Bounds x="1110" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_interest_join_di" bpmnElement="gw_interest_join">
        <dc:Bounds x="1680" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_presentation_join_di" bpmnElement="gw_presentation_join">
        <dc:Bounds x="1870" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_presentation_type_di" bpmnElement="gw_presentation_type">
        <dc:Bounds x="1490" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_buy_details_di" bpmnElement="task_buy_details">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_call_customer_di" bpmnElement="task_call_customer">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_create_quotation_di" bpmnElement="task_create_quotation">
        <dc:Bounds x="2440" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_exhibitions_di" bpmnElement="task_exhibitions">
        <dc:Bounds x="540" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_follow_up_call_di" bpmnElement="task_follow_up_call">
        <dc:Bounds x="2440" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_head_acquire_di" bpmnElement="task_head_acquire">
        <dc:Bounds x="1490" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_personal_network_di" bpmnElement="task_personal_network">
        <dc:Bounds x="540" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_sales_presentation_di" bpmnElement="task_sales_presentation">
        <dc:Bounds x="1680" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_tech_presentation_di" bpmnElement="task_tech_presentation">
        <dc:Bounds x="1680" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_contact_details_di" bpmnElement="data_contact_details">
        <dc:Bounds x="655" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_quotation_di" bpmnElement="data_quotation">
        <dc:Bounds x="2460" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="375" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_source_buy_di" bpmnElement="flow_source_buy">
        <di:waypoint x="375" y="125" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_source_exhibitions_di" bpmnElement="flow_source_exhibitions">
        <di:waypoint x="375" y="125" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_source_network_di" bpmnElement="flow_source_network">
        <di:waypoint x="375" y="125" />
        <di:waypoint x="590" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_buy_di" bpmnElement="flow_join_buy">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_exhibitions_di" bpmnElement="flow_join_exhibitions">
        <di:waypoint x="590" y="265" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_network_di" bpmnElement="flow_join_network">
        <di:waypoint x="590" y="390" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_yes_di" bpmnElement="flow_interested_yes">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1705" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_no_di" bpmnElement="flow_interested_no">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_budget_huge_di" bpmnElement="flow_budget_huge">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="1540" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_budget_normal_di" bpmnElement="flow_budget_normal">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="2648" y="118" />
      </bpmndi:BPMNEdge>
