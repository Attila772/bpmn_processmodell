<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_contact_details" name="Contact details" dataObjectRef="data_contact_details_do" />
    <bpmn:dataObject id="data_contact_details_do" />
    <bpmn:dataObjectReference id="data_quotation" name="Quotation" dataObjectRef="data_quotation_do" />
    <bpmn:dataObject id="data_quotation_do" />
    <bpmn:startEvent id="event_start" name="Need to acquire potential customers">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="event_wait_2_weeks" name="Wait 2 weeks for customer feedback">
      <bpmn:incoming>flow_responded_no</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="event_wait_2_weeks_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="event_end" name="Customer acquisition finished">
      <bpmn:incoming>flow_budget_normal</bpmn:incoming>
      <bpmn:incoming>flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_buy_details" name="Buy details for cold calls">
      <bpmn:incoming>flow_source_buy</bpmn:incoming>
      <bpmn:outgoing>flow_join_buy</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_buy_details_doa0">
        <bpmn:targetRef>data_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_exhibitions" name="Participate in exhibitions">
      <bpmn:incoming>flow_source_exhibitions</bpmn:incoming>
      <bpmn:outgoing>flow_join_exhibitions</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_exhibitions_doa0">
        <bpmn:targetRef>data_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_personal_network" name="Identify interested contacts via personal network">
      <bpmn:incoming>flow_source_network</bpmn:incoming>
      <bpmn:outgoing>flow_join_network</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_personal_network_doa0">
        <bpmn:targetRef>data_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_call_customer" name="Call customer to determine contact person, budget, and interest">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_call_customer_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_call_customer_dia0">
        <bpmn:sourceRef>data_contact_details</bpmn:sourceRef>
        <bpmn:targetRef>task_call_customer_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="task_head_acquire" name="Personally try to acquire customer">
      <bpmn:incoming>flow_budget_huge</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_sales_presentation" name="Give standard detailed online presentation">
      <bpmn:incoming>flow_pres_standard</bpmn:incoming>
      <bpmn:outgoing>flow_join_standard</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tech_presentation" name="Give technical detailed online presentation">
      <bpmn:incoming>flow_pres_technical</bpmn:incoming>
      <bpmn:outgoing>flow_join_technical</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_follow_up_call" name="Call customer after 2 weeks">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_create_quotation" name="Create quotation">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_quotation_doa0">
        <bpmn:targetRef>data_quotation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_contact_source" name="How to get contact details?" isMarkerVisible="true">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_source_buy</bpmn:outgoing>
      <bpmn:outgoing>flow_source_exhibitions</bpmn:outgoing>
      <bpmn:outgoing>flow_source_network</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_contact_source_join" name="Contact details obtained" isMarkerVisible="true">
      <bpmn:incoming>flow_join_buy</bpmn:incoming>
      <bpmn:incoming>flow_join_exhibitions</bpmn:incoming>
      <bpmn:incoming>flow_join_network</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_interest_check" name="Is customer generally interested?" isMarkerVisible="true">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_interested_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_interested_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_budget_check" name="Is potential budget huge?" isMarkerVisible="true">
      <bpmn:incoming>flow_interested_no</bpmn:incoming>
      <bpmn:outgoing>flow_budget_huge</bpmn:outgoing>
      <bpmn:outgoing>flow_budget_normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_interest_join" name="Customer interest confirmed?" isMarkerVisible="true">
      <bpmn:incoming>flow_interested_yes</bpmn:incoming>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_presentation_type" name="Type of presentation required?" isMarkerVisible="true">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_pres_standard</bpmn:outgoing>
      <bpmn:outgoing>flow_pres_technical</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_presentation_join" name="Presentation finished" isMarkerVisible="true">
      <bpmn:incoming>flow_join_standard</bpmn:incoming>
      <bpmn:incoming>flow_join_technical</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_customer_response" name="Customer responds within 2 weeks?" isMarkerVisible="true">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_responded_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_responded_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_follow_up_join" name="Ready for quotation" isMarkerVisible="true">
      <bpmn:incoming>flow_responded_yes</bpmn:incoming>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="event_start" targetRef="gw_contact_source" />
    <bpmn:sequenceFlow id="flow_source_buy" sourceRef="gw_contact_source" targetRef="task_buy_details" name="Buy details for cold calls" />
    <bpmn:sequenceFlow id="flow_source_exhibitions" sourceRef="gw_contact_source" targetRef="task_exhibitions" name="Participate in exhibitions" />
    <bpmn:sequenceFlow id="flow_source_network" sourceRef="gw_contact_source" targetRef="task_personal_network" name="Personal network contact" />
    <bpmn:sequenceFlow id="flow_join_buy" sourceRef="task_buy_details" targetRef="gw_contact_source_join" />
    <bpmn:sequenceFlow id="flow_join_exhibitions" sourceRef="task_exhibitions" targetRef="gw_contact_source_join" />
    <bpmn:sequenceFlow id="flow_join_network" sourceRef="task_personal_network" targetRef="gw_contact_source_join" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="gw_contact_source_join" targetRef="task_call_customer" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_call_customer" targetRef="gw_interest_check" />
    <bpmn:sequenceFlow id="flow_interested_yes" sourceRef="gw_interest_check" targetRef="gw_interest_join" name="Yes" />
    <bpmn:sequenceFlow id="flow_interested_no" sourceRef="gw_interest_check" targetRef="gw_budget_check" name="No" />
    <bpmn:sequenceFlow id="flow_budget_huge" sourceRef="gw_budget_check" targetRef="task_head_acquire" name="Yes" />
    <bpmn:sequenceFlow id="flow_budget_normal" sourceRef="gw_budget_check" targetRef="event_end" name="No" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_head_acquire" targetRef="gw_interest_join" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="gw_interest_join" targetRef="gw_presentation_type" />
    <bpmn:sequenceFlow id="flow_pres_standard" sourceRef="gw_presentation_type" targetRef="task_sales_presentation" name="Standard presentation" />
    <bpmn:sequenceFlow id="flow_pres_technical" sourceRef="gw_presentation_type" targetRef="task_tech_presentation" name="Technical presentation" />
    <bpmn:sequenceFlow id="flow_join_standard" sourceRef="task_sales_presentation" targetRef="gw_presentation_join" />
    <bpmn:sequenceFlow id="flow_join_technical" sourceRef="task_tech_presentation" targetRef="gw_presentation_join" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="gw_presentation_join" targetRef="gw_customer_response" />
    <bpmn:sequenceFlow id="flow_responded_yes" sourceRef="gw_customer_response" targetRef="gw_follow_up_join" name="Yes" />
    <bpmn:sequenceFlow id="flow_responded_no" sourceRef="gw_customer_response" targetRef="event_wait_2_weeks" name="No (2 weeks passed)" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="event_wait_2_weeks" targetRef="task_follow_up_call" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_follow_up_call" targetRef="gw_follow_up_join" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="gw_follow_up_join" targetRef="task_create_quotation" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_create_quotation" targetRef="event_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_end_di" bpmnElement="event_end">
        <dc:Bounds x="2630" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
