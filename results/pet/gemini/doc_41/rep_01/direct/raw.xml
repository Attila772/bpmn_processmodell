<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="definitions_car_accident_claim"
             targetNamespace="http://bpmn.org/examples"
             exporter="BPMN Modeler"
             exporterVersion="1.0">

  <!-- Collaboration definition -->
  <collaboration id="collaboration_1">
    <participant id="participant_1" name="Car Accident Claims Process" processRef="process_car_accident_claim" />
  </collaboration>

  <!-- Process definition -->
  <process id="process_car_accident_claim" isExecutable="true">
    
    <!-- Lanes -->
    <laneSet id="laneSet_1">
      <lane id="lane_system" name="System / Database">
        <flowNodeRef>start_event_1</flowNodeRef>
        <flowNodeRef>task_search_police_report</flowNodeRef>
        <flowNodeRef>task_file_docs</flowNodeRef>
      </lane>
      <lane id="lane_claims_handler" name="Claims Handler">
        <flowNodeRef>task_calculate_estimate</flowNodeRef>
        <flowNodeRef>task_create_action_plan</flowNodeRef>
      </lane>
      <lane id="lane_claims_manager" name="Claims Manager">
        <flowNodeRef>task_negotiate_settlement</flowNodeRef>
        <flowNodeRef>task_inform_claimant</flowNodeRef>
        <flowNodeRef>end_event_1</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Data Objects & Stores -->
    <dataStoreReference id="dataStore_police_db" name="Police Report Database" />
    <dataStoreReference id="dataStore_dms" name="Document Management System" />

    <dataObject id="dataObject_claim_doc" name="Claim Documentation" />
    <dataObjectReference id="dataObjectRef_claim_doc" name="Claim Documentation" dataObjectRef="dataObject_claim_doc" />

    <dataObject id="dataObject_police_report" name="Police Report" />
    <dataObjectReference id="dataObjectRef_police_report" name="Police Report" dataObjectRef="dataObject_police_report" />

    <dataObject id="dataObject_claim_file" name="Claim File" />
    <dataObjectReference id="dataObjectRef_claim_file" name="Claim File" dataObjectRef="dataObject_claim_file" />

    <dataObject id="dataObject_action_plan_checklist" name="Action Plan Checklist" />
    <dataObjectReference id="dataObjectRef_action_plan_checklist" name="Action Plan Checklist" dataObjectRef="dataObject_action_plan_checklist" />

    <dataObject id="dataObject_action_plan" name="Action Plan" />
    <dataObjectReference id="dataObjectRef_action_plan" name="Action Plan" dataObjectRef="dataObject_action_plan" />

    <!-- Process Nodes -->
    <startEvent id="start_event_1" name="Car accident claim received">
      <outgoing>flow_1</outgoing>
    </startEvent>

    <serviceTask id="task_search_police_report" name="Search Police Report">
      <incoming>flow_1</incoming>
      <outgoing>flow_2</outgoing>
      <property id="property_search_police_report" name="property" />
      <dataInputAssociation id="dia_1">
        <sourceRef>dataStore_police_db</sourceRef>
        <targetRef>property_search_police_report</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="doa_1">
        <sourceRef>task_search_police_report</sourceRef>
        <targetRef>dataObjectRef_police_report</targetRef>
      </dataOutputAssociation>
    </serviceTask>

    <task id="task_file_docs" name="Put Police Report and Claim Documentation in File">
      <incoming>flow_2</incoming>
      <outgoing>flow_3</outgoing>
      <property id="property_file_docs" name="property" />
      <dataInputAssociation id="dia_2">
        <sourceRef>dataObjectRef_police_report</sourceRef>
        <targetRef>property_file_docs</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="dia_3">
        <sourceRef>dataObjectRef_claim_doc</sourceRef>
        <targetRef>property_file_docs</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="doa_2">
        <sourceRef>task_file_docs</sourceRef>
        <targetRef>dataObjectRef_claim_file</targetRef>
      </dataOutputAssociation>
    </task>

    <userTask id="task_calculate_estimate" name="Calculate Initial Claim Estimate">
      <incoming>flow_3</incoming>
      <outgoing>flow_4</outgoing>
      <property id="property_calculate_estimate" name="property" />
      <dataInputAssociation id="dia_4">
        <sourceRef>dataObjectRef_claim_file</sourceRef>
        <targetRef>property_calculate_estimate</targetRef>
      </dataInputAssociation>
    </userTask>

    <userTask id="task_create_action_plan" name="Create Action Plan">
      <incoming>flow_4</incoming>
      <outgoing>flow_5</outgoing>
      <property id="property_create_action_plan" name="property" />
      <dataInputAssociation id="dia_5">
        <sourceRef>dataObjectRef_action_plan_checklist</sourceRef>
        <targetRef>property_create_action_plan</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="doa_3">
        <sourceRef>task_create_action_plan</sourceRef>
        <targetRef>dataObjectRef_action_plan</targetRef>
      </dataOutputAssociation>
    </userTask>

    <userTask id="task_negotiate_settlement" name="Negotiate Settlement">
      <incoming>flow_5</incoming>
      <outgoing>flow_6</outgoing>
      <property id="property_negotiate_settlement" name="property" />
      <dataInputAssociation id="dia_6">
        <sourceRef>dataObjectRef_action_plan</sourceRef>
        <targetRef>property_negotiate_settlement</targetRef>
      </dataInputAssociation>
    </userTask>

    <sendTask id="task_inform_claimant" name="Inform Claimant of Outcome">
      <incoming>flow_6</incoming>
      <outgoing>flow_7</outgoing>
    </sendTask>

    <endEvent id="end_event_1" name="Claim process ended">
      <incoming>flow_7</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="flow_1" sourceRef="start_event_1" targetRef="task_search_police_report" />
    <sequenceFlow id="flow_2" sourceRef="task_search_police_report" targetRef="task_file_docs" />
    <sequenceFlow id="flow_3" sourceRef="task_file_docs" targetRef="task_calculate_estimate" />
    <sequenceFlow id="flow_4" sourceRef="task_calculate_estimate" targetRef="task_create_action_plan" />
    <sequenceFlow id="flow_5" sourceRef="task_create_action_plan" targetRef="task_negotiate_settlement" />
    <sequenceFlow id="flow_6" sourceRef="task_negotiate_settlement" targetRef="task_inform_claimant" />
    <sequenceFlow id="flow_7" sourceRef="task_inform_claimant" targetRef="end_event_1" />

    <!-- Association between DataStore DMS and Checklist Data Object -->
    <association id="assoc_dms_checklist" sourceRef="dataStore_dms" targetRef="dataObjectRef_action_plan_checklist" />

  </process>

  <!-- BPMN Diagram Layout -->
