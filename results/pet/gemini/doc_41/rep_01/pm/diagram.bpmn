<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_obj_2" name="Claim Documentation" dataObjectRef="data_obj_2_do" />
    <bpmn:dataObject id="data_obj_2_do" />
    <bpmn:dataStoreReference id="data_store_1" name="Police Report database" />
    <bpmn:dataObjectReference id="data_obj_1" name="Police Report" dataObjectRef="data_obj_1_do" />
    <bpmn:dataObject id="data_obj_1_do" />
    <bpmn:dataObjectReference id="data_obj_3" name="Claim File" dataObjectRef="data_obj_3_do" />
    <bpmn:dataObject id="data_obj_3_do" />
    <bpmn:dataObjectReference id="data_obj_4" name="Initial Claim Estimate" dataObjectRef="data_obj_4_do" />
    <bpmn:dataObject id="data_obj_4_do" />
    <bpmn:dataStoreReference id="data_store_2" name="Document Management system" />
    <bpmn:dataObjectReference id="data_obj_5" name="Action Plan Checklist" dataObjectRef="data_obj_5_do" />
    <bpmn:dataObject id="data_obj_5_do" />
    <bpmn:dataObjectReference id="data_obj_6" name="Action Plan" dataObjectRef="data_obj_6_do" />
    <bpmn:dataObject id="data_obj_6_do" />
    <bpmn:startEvent id="event_start" name="Claim Process Started">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_end" name="Claim Process Ended">
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_1" name="Search Police Report and compile claim file">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:property id="task_1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_1_dia0">
        <bpmn:sourceRef>data_obj_2</bpmn:sourceRef>
        <bpmn:targetRef>task_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_1_dia1">
        <bpmn:sourceRef>data_store_1</bpmn:sourceRef>
        <bpmn:targetRef>task_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_1_doa0">
        <bpmn:targetRef>data_obj_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_1_doa1">
        <bpmn:targetRef>data_obj_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_2" name="Calculate initial claim estimate">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_2_dia0">
        <bpmn:sourceRef>data_obj_3</bpmn:sourceRef>
        <bpmn:targetRef>task_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_2_doa0">
        <bpmn:targetRef>data_obj_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_3" name="Create Action Plan">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_3_dia0">
        <bpmn:sourceRef>data_store_2</bpmn:sourceRef>
        <bpmn:targetRef>task_3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_3_dia1">
        <bpmn:sourceRef>data_obj_5</bpmn:sourceRef>
        <bpmn:targetRef>task_3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_3_doa0">
        <bpmn:targetRef>data_obj_6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_4" name="Negotiate settlement on claim estimate">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:property id="task_4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_4_dia0">
        <bpmn:sourceRef>data_obj_4</bpmn:sourceRef>
        <bpmn:targetRef>task_4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_4_dia1">
        <bpmn:sourceRef>data_obj_6</bpmn:sourceRef>
        <bpmn:targetRef>task_4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_5" name="Inform claimant of outcome">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_1" sourceRef="event_start" targetRef="task_1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_2" targetRef="task_3" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_3" targetRef="task_4" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_4" targetRef="task_5" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_5" targetRef="event_end" />
  </bpmn:process>
