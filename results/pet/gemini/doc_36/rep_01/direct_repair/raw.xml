<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.org/schema/bpmn"
             exporter="Camunda Modeler"
             exporterVersion="5.0.0">

  <process id="CourtPreparationProcess" name="Court Preparation Process" isExecutable="true">
    
    <!-- Start Event: Morning Process Starts -->
    <startEvent id="StartEvent_Morning" name="Morning preparation started">
      <outgoing>Flow_01</outgoing>
    </startEvent>

    <!-- Task: Check Files -->
    <userTask id="Task_CheckFiles" name="Check files to be processed">
      <incoming>Flow_01</incoming>
      <outgoing>Flow_02</outgoing>
    </userTask>

    <!-- Exclusive Gateway: Missing Files? -->
    <exclusiveGateway id="Gateway_MissingFiles" name="Files missing?">
      <incoming>Flow_02</incoming>
      <outgoing>Flow_Missing_Yes</outgoing>
      <outgoing>Flow_Missing_No</outgoing>
    </exclusiveGateway>

    <!-- Task: Search for Missing Files -->
    <userTask id="Task_SearchFiles" name="Initiate search for missing files">
      <incoming>Flow_Missing_Yes</incoming>
      <outgoing>Flow_03</outgoing>
    </userTask>

    <!-- Task: Physically Track Files -->
    <userTask id="Task_TrackFiles" name="Physically track files to intended location">
      <incoming>Flow_Missing_No</incoming>
      <outgoing>Flow_04</outgoing>
    </userTask>

    <!-- Exclusive Gateway: Merge File Preparation Paths -->
    <exclusiveGateway id="Gateway_MergeFiles" name="Files Ready Gateway">
      <incoming>Flow_03</incoming>
      <incoming>Flow_04</incoming>
      <outgoing>Flow_05</outgoing>
    </exclusiveGateway>

    <!-- Parallel Gateway: Fork Parallel Activities -->
    <parallelGateway id="Gateway_ForkParallel" name="Fork Parallel Tasks">
      <incoming>Flow_05</incoming>
      <outgoing>Flow_To_HandOver</outgoing>
      <outgoing>Flow_To_DistributeList</outgoing>
    </parallelGateway>

    <!-- Task: Hand Files to Associate -->
    <userTask id="Task_HandOverFiles" name="Hand files to Associate">
      <incoming>Flow_To_HandOver</incoming>
      <outgoing>Flow_From_HandOver</outgoing>
    </userTask>

    <!-- Task: Distribute Judge's Lawlist -->
    <userTask id="Task_DistributeLawlist" name="Distribute Judge's Lawlist to relevant people">
      <incoming>Flow_To_DistributeList</incoming>
      <outgoing>Flow_From_DistributeList</outgoing>
    </userTask>

    <!-- Parallel Gateway: Join Parallel Activities -->
    <parallelGateway id="Gateway_JoinParallel" name="Join Parallel Tasks">
      <incoming>Flow_From_HandOver</incoming>
      <incoming>Flow_From_DistributeList</incoming>
      <outgoing>Flow_To_ConductHearings</outgoing>
    </parallelGateway>

    <!-- Task: Conduct Directions Hearings -->
    <userTask id="Task_ConductHearings" name="Conduct directions hearings">
      <incoming>Flow_To_ConductHearings</incoming>
      <outgoing>Flow_To_End</outgoing>
    </userTask>

    <!-- End Event -->
    <endEvent id="EndEvent_ProcessCompleted" name="Directions hearings conducted">
      <incoming>Flow_To_End</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_Morning" targetRef="Task_CheckFiles" />
    <sequenceFlow id="Flow_02" sourceRef="Task_CheckFiles" targetRef="Gateway_MissingFiles" />
    <sequenceFlow id="Flow_Missing_Yes" name="Yes" sourceRef="Gateway_MissingFiles" targetRef="Task_SearchFiles" />
    <sequenceFlow id="Flow_Missing_No" name="No" sourceRef="Gateway_MissingFiles" targetRef="Task_TrackFiles" />
    <sequenceFlow id="Flow_03" sourceRef="Task_SearchFiles" targetRef="Gateway_MergeFiles" />
    <sequenceFlow id="Flow_04" sourceRef="Task_TrackFiles" targetRef="Gateway_MergeFiles" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_MergeFiles" targetRef="Gateway_ForkParallel" />
    <sequenceFlow id="Flow_To_HandOver" sourceRef="Gateway_ForkParallel" targetRef="Task_HandOverFiles" />
    <sequenceFlow id="Flow_To_DistributeList" sourceRef="Gateway_ForkParallel" targetRef="Task_DistributeLawlist" />
    <sequenceFlow id="Flow_From_HandOver" sourceRef="Task_HandOverFiles" targetRef="Gateway_JoinParallel" />
    <sequenceFlow id="Flow_From_DistributeList" sourceRef="Task_DistributeLawlist" targetRef="Gateway_JoinParallel" />
    <sequenceFlow id="Flow_To_ConductHearings" sourceRef="Gateway_JoinParallel" targetRef="Task_ConductHearings" />
    <sequenceFlow id="Flow_To_End" sourceRef="Task_ConductHearings" targetRef="EndEvent_ProcessCompleted" />

  </process>

  <!-- BPMN Diagram Graphical Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="CourtPreparationProcess">
      
      <!-- Start Event Shape -->
      <bpmndi:BPMNShape id="StartEvent_Morning_di" bpmnElement="StartEvent_Morning">
        <dc:Bounds x="152" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="132" y="235" width="77" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Check Files Task Shape -->
      <bpmndi:BPMNShape id="Task_CheckFiles_di" bpmnElement="Task_CheckFiles">
        <dc:Bounds x="240" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Missing Files Gateway Shape -->
      <bpmndi:BPMNShape id="Gateway_MissingFiles_di" bpmnElement="Gateway_MissingFiles" isMarkerVisible="true">
        <dc:Bounds x="395" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="384" y="161" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Search Files Task Shape -->
      <bpmndi:BPMNShape id="Task_SearchFiles_di" bpmnElement="Task_SearchFiles">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Track Files Task Shape -->
      <bpmndi:BPMNShape id="Task_TrackFiles_di" bpmnElement="Task_TrackFiles">
        <dc:Bounds x="500" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Merge Files Gateway Shape -->
      <bpmndi:BPMNShape id="Gateway_MergeFiles_di" bpmnElement="Gateway_MergeFiles" isMarkerVisible="true">
        <dc:Bounds x="655" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Fork Parallel Gateway Shape -->
      <bpmndi:BPMNShape id="Gateway_ForkParallel_di" bpmnElement="Gateway_ForkParallel">
        <dc:Bounds x="755" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Hand Over Files Task Shape -->
      <bpmndi:BPMNShape id="Task_HandOverFiles_di" bpmnElement="Task_HandOverFiles">
        <dc:Bounds x="860" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Distribute Lawlist Task Shape -->
      <bpmndi:BPMNShape id="Task_DistributeLawlist_di" bpmnElement="Task_DistributeLawlist">
        <dc:Bounds x="860" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Join Parallel Gateway Shape -->
      <bpmndi:BPMNShape id="Gateway_JoinParallel_di" bpmnElement="Gateway_JoinParallel">
        <dc:Bounds x="1015" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Conduct Hearings Task Shape -->
      <bpmndi:BPMNShape id="Task_ConductHearings_di" bpmnElement="Task_ConductHearings">
        <dc:Bounds x="1120" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event Shape -->
      <bpmndi:BPMNShape id="EndEvent_ProcessCompleted_di" bpmnElement="EndEvent_ProcessCompleted">
        <dc:Bounds x="1282" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1274" y="235" width="53" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edge Connections -->
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="188" y="210" />
        <di:waypoint x="240" y="210" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="340" y="210" />
        <di:waypoint x="395" y="210" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Missing_Yes_di" bpmnElement="Flow_Missing_Yes">
        <di:waypoint x="420" y="185" />
        <di:waypoint x="420" y="120" />
        <di:waypoint x="500" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="426" y="150" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Missing_No_di" bpmnElement="Flow_Missing_No">
        <di:waypoint x="420" y="235" />
        <di:waypoint x="420" y="300" />
        <di:waypoint x="500" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="265" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="600" y="120" />
        <di:waypoint x="680" y="120" />
        <di:waypoint x="680" y="185" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="600" y="300" />
        <di:waypoint x="680" y="300" />
        <di:waypoint x="680" y="235" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="705" y="210" />
        <di:waypoint x="755" y="210" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_HandOver_di" bpmnElement="Flow_To_HandOver">
        <di:waypoint x="780" y="185" />
        <di:waypoint x="780" y="120" />
        <di:waypoint x="860" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_DistributeList_di" bpmnElement="Flow_To_DistributeList">
        <di:waypoint x="780" y="235" />
        <di:waypoint x="780" y="300" />
        <di:waypoint x="860" y="300" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_From_HandOver_di" bpmnElement="Flow_From_HandOver">
        <di:waypoint x="960" y="120" />
        <di:waypoint x="1040" y="120" />
        <di:waypoint x="1040" y="185" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_From_DistributeList_di" bpmnElement="Flow_From_DistributeList">
        <di:waypoint x="960" y="300" />
        <di:waypoint x="1040" y="300" />
        <di:waypoint x="1040" y="235" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_ConductHearings_di" bpmnElement="Flow_To_ConductHearings">
        <di:waypoint x="1065" y="210" />
        <di:waypoint x="1120" y="210" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End">
        <di:waypoint x="1220" y="210" />
        <di:waypoint x="1282" y="210" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
