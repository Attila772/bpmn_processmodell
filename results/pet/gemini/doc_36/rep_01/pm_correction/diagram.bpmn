<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_court_files" name="Court Files" dataObjectRef="data_court_files_do" />
    <bpmn:dataObject id="data_court_files_do" />
    <bpmn:dataObjectReference id="data_judges_lawlist" name="Judge's Lawlist" dataObjectRef="data_judges_lawlist_do" />
    <bpmn:dataObject id="data_judges_lawlist_do" />
    <bpmn:startEvent id="event_start" name="Morning process started">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_end" name="Directions hearings completed">
      <bpmn:incoming>sf_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="task_check_files" name="Check unprocessed files for today's court hearing">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
      <bpmn:property id="task_check_files_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_files_dia0">
        <bpmn:sourceRef>data_court_files</bpmn:sourceRef>
        <bpmn:targetRef>task_check_files_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_initiate_search" name="Initiate search for missing files">
      <bpmn:incoming>sf_missing_yes</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_track_files" name="Physically track files to intended location">
      <bpmn:incoming>sf_missing_no</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:property id="task_track_files_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_track_files_dia0">
        <bpmn:sourceRef>data_court_files</bpmn:sourceRef>
        <bpmn:targetRef>task_track_files_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_hand_files_to_associate" name="Hand files to Associate">
      <bpmn:incoming>sf_para_1</bpmn:incoming>
      <bpmn:outgoing>sf_join_1</bpmn:outgoing>
      <bpmn:property id="task_hand_files_to_associate_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_hand_files_to_associate_dia0">
        <bpmn:sourceRef>data_court_files</bpmn:sourceRef>
        <bpmn:targetRef>task_hand_files_to_associate_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_distribute_lawlist" name="Distribute Judge's Lawlist to relevant people">
      <bpmn:incoming>sf_para_2</bpmn:incoming>
      <bpmn:outgoing>sf_join_2</bpmn:outgoing>
      <bpmn:property id="task_distribute_lawlist_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_distribute_lawlist_dia0">
        <bpmn:sourceRef>data_judges_lawlist</bpmn:sourceRef>
        <bpmn:targetRef>task_distribute_lawlist_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_conduct_hearings" name="Conduct directions hearings">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_missing_files" name="Are files missing?" isMarkerVisible="true">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_missing_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_missing_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_merge_search" name="Files located" isMarkerVisible="true">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_parallel_split" name="Parallel handoff and distribution">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_para_1</bpmn:outgoing>
      <bpmn:outgoing>sf_para_2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_parallel_join" name="Handoff and distribution complete">
      <bpmn:incoming>sf_join_1</bpmn:incoming>
      <bpmn:incoming>sf_join_2</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="sf_1" sourceRef="event_start" targetRef="task_check_files" />
    <bpmn:sequenceFlow id="sf_2" sourceRef="task_check_files" targetRef="gw_missing_files" />
    <bpmn:sequenceFlow id="sf_missing_yes" sourceRef="gw_missing_files" targetRef="task_initiate_search" name="Files missing" />
    <bpmn:sequenceFlow id="sf_missing_no" sourceRef="gw_missing_files" targetRef="task_track_files" name="Files not missing" />
    <bpmn:sequenceFlow id="sf_3" sourceRef="task_initiate_search" targetRef="gw_merge_search" />
    <bpmn:sequenceFlow id="sf_4" sourceRef="task_track_files" targetRef="gw_merge_search" />
    <bpmn:sequenceFlow id="sf_5" sourceRef="gw_merge_search" targetRef="gw_parallel_split" />
    <bpmn:sequenceFlow id="sf_para_1" sourceRef="gw_parallel_split" targetRef="task_hand_files_to_associate" />
    <bpmn:sequenceFlow id="sf_para_2" sourceRef="gw_parallel_split" targetRef="task_distribute_lawlist" />
    <bpmn:sequenceFlow id="sf_join_1" sourceRef="task_hand_files_to_associate" targetRef="gw_parallel_join" />
    <bpmn:sequenceFlow id="sf_join_2" sourceRef="task_distribute_lawlist" targetRef="gw_parallel_join" />
    <bpmn:sequenceFlow id="sf_6" sourceRef="gw_parallel_join" targetRef="task_conduct_hearings" />
    <bpmn:sequenceFlow id="sf_7" sourceRef="task_conduct_hearings" targetRef="event_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_end_di" bpmnElement="event_end">
        <dc:Bounds x="1870" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_start_di" bpmnElement="event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_search_di" bpmnElement="gw_merge_search">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_missing_files_di" bpmnElement="gw_missing_files">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_join_di" bpmnElement="gw_parallel_join">
        <dc:Bounds x="1490" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_split_di" bpmnElement="gw_parallel_split">
        <dc:Bounds x="1110" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_files_di" bpmnElement="task_check_files">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_conduct_hearings_di" bpmnElement="task_conduct_hearings">
        <dc:Bounds x="1680" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_distribute_lawlist_di" bpmnElement="task_distribute_lawlist">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_hand_files_to_associate_di" bpmnElement="task_hand_files_to_associate">
        <dc:Bounds x="1300" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_initiate_search_di" bpmnElement="task_initiate_search">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_track_files_di" bpmnElement="task_track_files">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_court_files_di" bpmnElement="data_court_files">
        <dc:Bounds x="813" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_judges_lawlist_di" bpmnElement="data_judges_lawlist">
        <dc:Bounds x="1320" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf_1_di" bpmnElement="sf_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_2_di" bpmnElement="sf_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_missing_yes_di" bpmnElement="sf_missing_yes">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_missing_no_di" bpmnElement="sf_missing_no">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_3_di" bpmnElement="sf_3">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_4_di" bpmnElement="sf_4">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_5_di" bpmnElement="sf_5">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_para_1_di" bpmnElement="sf_para_1">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_para_2_di" bpmnElement="sf_para_2">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_join_1_di" bpmnElement="sf_join_1">
        <di:waypoint x="1350" y="265" />
        <di:waypoint x="1515" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_join_2_di" bpmnElement="sf_join_2">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1515" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_6_di" bpmnElement="sf_6">
        <di:waypoint x="1515" y="125" />
        <di:waypoint x="1730" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_7_di" bpmnElement="sf_7">
        <di:waypoint x="1730" y="140" />
        <di:waypoint x="1888" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_files_dia0_di" bpmnElement="task_check_files_dia0">
        <di:waypoint x="831" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_track_files_dia0_di" bpmnElement="task_track_files_dia0">
        <di:waypoint x="831" y="390" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_hand_files_to_associate_dia0_di" bpmnElement="task_hand_files_to_associate_dia0">
        <di:waypoint x="831" y="390" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_distribute_lawlist_dia0_di" bpmnElement="task_distribute_lawlist_dia0">
        <di:waypoint x="1338" y="390" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>