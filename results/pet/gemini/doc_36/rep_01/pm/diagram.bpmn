<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_obj_1" name="Case Files" dataObjectRef="data_obj_1_do" />
    <bpmn:dataObject id="data_obj_1_do" />
    <bpmn:dataObjectReference id="data_obj_2" name="Judge's Lawlist" dataObjectRef="data_obj_2_do" />
    <bpmn:dataObject id="data_obj_2_do" />
    <bpmn:startEvent id="start_event_1" name="Morning process started">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_1" name="Directions hearings conducted">
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_1" name="Check files yet to be processed">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:property id="task_1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_1_dia0">
        <bpmn:sourceRef>data_obj_1</bpmn:sourceRef>
        <bpmn:targetRef>task_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_2" name="Initiate search for missing files">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_3" name="Physically track files to intended location">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_3_dia0">
        <bpmn:sourceRef>data_obj_1</bpmn:sourceRef>
        <bpmn:targetRef>task_3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_4" name="Hand files to the Associate">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:property id="task_4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_4_dia0">
        <bpmn:sourceRef>data_obj_1</bpmn:sourceRef>
        <bpmn:targetRef>task_4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_5" name="Distribute Judge's Lawlist to relevant people">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:property id="task_5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_5_dia0">
        <bpmn:sourceRef>data_obj_2</bpmn:sourceRef>
        <bpmn:targetRef>task_5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_6" name="Conduct directions hearings">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:property id="task_6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_6_dia0">
        <bpmn:sourceRef>data_obj_1</bpmn:sourceRef>
        <bpmn:targetRef>task_6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_6_dia1">
        <bpmn:sourceRef>data_obj_2</bpmn:sourceRef>
        <bpmn:targetRef>task_6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_1" name="Are files missing?" isMarkerVisible="true">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_2" name="Merge search/track" isMarkerVisible="true">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gateway_3" name="Parallel split for handing files and lawlist">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gateway_4" name="Parallel join for handing files and lawlist">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_event_1" targetRef="task_1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_1" targetRef="gateway_1" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="gateway_1" targetRef="task_2" name="Files missing" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="gateway_1" targetRef="task_3" name="Files not missing" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_2" targetRef="gateway_2" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_3" targetRef="gateway_2" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="gateway_2" targetRef="gateway_3" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="gateway_3" targetRef="task_4" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="gateway_3" targetRef="task_5" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_4" targetRef="gateway_4" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_5" targetRef="gateway_4" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="gateway_4" targetRef="task_6" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="task_6" targetRef="end_event_1" />
  </bpmn:process>
