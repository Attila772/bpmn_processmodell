<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.org/schema/bpmn">

  <process id="Court_Preparation_Process" isExecutable="true">
    
    <!-- Start Event: Morning Process Triggered -->
    <startEvent id="StartEvent_Morning" name="Morning Process Started">
      <outgoing">Flow_1</outgoing>
    </startEvent>

    <!-- Task: Check Unprocessed Files -->
    <userTask id="Task_CheckFiles" name="Check Unprocessed Files">
      <incoming>Flow_1</incoming>
      <outgoing">Flow_2</outgoing>
    </userTask>

    <!-- Exclusive Gateway: Are Files Missing? -->
    <exclusiveGateway id="Gateway_CheckMissing" name="Files Missing?">
      <incoming>Flow_2</incoming>
      <outgoing">Flow_Missing</outgoing>
      <outgoing">Flow_NotMissing</outgoing>
    </exclusiveGateway>

    <!-- Task: Search for Missing Files -->
    <userTask id="Task_SearchFiles" name="Initiate Search for Missing Files">
      <incoming>Flow_Missing</incoming>
      <outgoing">Flow_SearchDone</outgoing>
    </userTask>

    <!-- Task: Physically Track Files -->
    <userTask id="Task_TrackFiles" name="Physically Track Files to Intended Location">
      <incoming>Flow_NotMissing</incoming>
      <outgoing">Flow_TrackDone</outgoing>
    </userTask>

    <!-- Exclusive Gateway: Merge Files Readiness -->
    <exclusiveGateway id="Gateway_FilesReady" name="Files Ready Gateway">
      <incoming>Flow_SearchDone</incoming>
      <incoming>Flow_TrackDone</incoming>
      <outgoing">Flow_ToParallelSplit</outgoing>
    </exclusiveGateway>

    <!-- Parallel Gateway: Fork Parallel Preparation Tasks -->
    <parallelGateway id="Gateway_ParallelSplit" name="Parallel Split">
      <incoming>Flow_ToParallelSplit</incoming>
      <outgoing">Flow_ToHandover</outgoing>
      <outgoing">Flow_ToDistribute</outgoing>
    </parallelGateway>

    <!-- Task: Hand Files to Associate -->
    <userTask id="Task_HandoverFiles" name="Hand Over Files to Associate">
      <incoming>Flow_ToHandover</incoming>
      <outgoing">Flow_HandoverDone</outgoing>
    </userTask>

    <!-- Task: Distribute Judge's Law List -->
    <userTask id="Task_DistributeLawlist" name="Distribute Judge's Law List to Relevant People">
      <incoming>Flow_ToDistribute</incoming>
      <outgoing">Flow_DistributeDone</outgoing>
    </userTask>

    <!-- Parallel Gateway: Join Parallel Preparation Tasks -->
    <parallelGateway id="Gateway_ParallelJoin" name="Parallel Join">
      <incoming>Flow_HandoverDone</incoming>
      <incoming>Flow_DistributeDone</incoming>
      <outgoing">Flow_ToConductHearings</outgoing>
    </parallelGateway>

    <!-- Task: Conduct Directions Hearings -->
    <userTask id="Task_ConductHearings" name="Conduct Directions Hearings">
      <incoming>Flow_ToConductHearings</incoming>
      <outgoing">Flow_End</outgoing>
    </userTask>

    <!-- End Event -->
    <endEvent id="EndEvent_Completed" name="Preparation and Hearings Completed">
      <incoming>Flow_End</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_Morning" targetRef="Task_CheckFiles"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_CheckFiles" targetRef="Gateway_CheckMissing"/>
    <sequenceFlow id="Flow_Missing" name="Yes" sourceRef="Gateway_CheckMissing" targetRef="Task_SearchFiles"/>
    <sequenceFlow id="Flow_NotMissing" name="No" sourceRef="Gateway_CheckMissing" targetRef="Task_TrackFiles"/>
    <sequenceFlow id="Flow_SearchDone" sourceRef="Task_SearchFiles" targetRef="Gateway_FilesReady"/>
    <sequenceFlow id="Flow_TrackDone" sourceRef="Task_TrackFiles" targetRef="Gateway_FilesReady"/>
    <sequenceFlow id="Flow_ToParallelSplit" sourceRef="Gateway_FilesReady" targetRef="Gateway_ParallelSplit"/>
    <sequenceFlow id="Flow_ToHandover" sourceRef="Gateway_ParallelSplit" targetRef="Task_HandoverFiles"/>
    <sequenceFlow id="Flow_ToDistribute" sourceRef="Gateway_ParallelSplit" targetRef="Task_DistributeLawlist"/>
    <sequenceFlow id="Flow_HandoverDone" sourceRef="Task_HandoverFiles" targetRef="Gateway_ParallelJoin"/>
    <sequenceFlow id="Flow_DistributeDone" sourceRef="Task_DistributeLawlist" targetRef="Gateway_ParallelJoin"/>
    <sequenceFlow id="Flow_ToConductHearings" sourceRef="Gateway_ParallelJoin" targetRef="Task_ConductHearings"/>
    <sequenceFlow id="Flow_End" sourceRef="Task_ConductHearings" targetRef="EndEvent_Completed"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Court_Preparation_Process">
      
      <bpmndi:BPMNShape id="Shape_StartEvent_Morning" bpmnElement="StartEvent_Morning">
        <dc:Bounds x="152" y="192" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="131" y="235" width="80" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_CheckFiles" bpmnElement="Task_CheckFiles">
        <dc:Bounds x="240" y="170" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_CheckMissing" bpmnElement="Gateway_CheckMissing" isMarkerVisible="true">
        <dc:Bounds x="395" y="185" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="385" y="155" width="71" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_SearchFiles" bpmnElement="Task_SearchFiles">
        <dc:Bounds x="500" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_TrackFiles" bpmnElement="Task_TrackFiles">
        <dc:Bounds x="500" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_FilesReady" bpmnElement="Gateway_FilesReady" isMarkerVisible="true">
        <dc:Bounds x="655" y="185" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ParallelSplit" bpmnElement="Gateway_ParallelSplit">
        <dc:Bounds x="755" y="185" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_HandoverFiles" bpmnElement="Task_HandoverFiles">
        <dc:Bounds x="850" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_DistributeLawlist" bpmnElement="Task_DistributeLawlist">
        <dc:Bounds x="850" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ParallelJoin" bpmnElement="Gateway_ParallelJoin">
        <dc:Bounds x="1005" y="185" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ConductHearings" bpmnElement="Task_ConductHearings">
        <dc:Bounds x="1100" y="170" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_Completed" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="1252" y="192" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1230" y="235" width="81" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="188" y="210"/>
        <di:waypoint x="240" y="210"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="340" y="210"/>
        <di:waypoint x="395" y="210"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_Missing" bpmnElement="Flow_Missing">
        <di:waypoint x="420" y="185"/>
        <di:waypoint x="420" y="120"/>
        <di:waypoint x="500" y="120"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="426" y="150" width="18" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_NotMissing" bpmnElement="Flow_NotMissing">
        <di:waypoint x="420" y="235"/>
        <di:waypoint x="420" y="300"/>
        <di:waypoint x="500" y="300"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="265" width="15" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_SearchDone" bpmnElement="Flow_SearchDone">
        <di:waypoint x="600" y="120"/>
        <di:waypoint x="680" y="120"/>
        <di:waypoint x="680" y="185"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_TrackDone" bpmnElement="Flow_TrackDone">
        <di:waypoint x="600" y="300"/>
        <di:waypoint x="680" y="300"/>
        <di:waypoint x="680" y="235"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToParallelSplit" bpmnElement="Flow_ToParallelSplit">
        <di:waypoint x="705" y="210"/>
        <di:waypoint x="755" y="210"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToHandover" bpmnElement="Flow_ToHandover">
        <di:waypoint x="780" y="185"/>
        <di:waypoint x="780" y="120"/>
        <di:waypoint x="850" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToDistribute" bpmnElement="Flow_ToDistribute">
        <di:waypoint x="780" y="235"/>
        <di:waypoint x="780" y="300"/>
        <di:waypoint x="850" y="300"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_HandoverDone" bpmnElement="Flow_HandoverDone">
        <di:waypoint x="950" y="120"/>
        <di:waypoint x="1030" y="120"/>
        <di:waypoint x="1030" y="185"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_DistributeDone" bpmnElement="Flow_DistributeDone">
        <di:waypoint x="950" y="300"/>
        <di:waypoint x="1030" y="300"/>
        <di:waypoint x="1030" y="235"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToConductHearings" bpmnElement="Flow_ToConductHearings">
        <di:waypoint x="1055" y="210"/>
        <di:waypoint x="1100" y="210"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_End" bpmnElement="Flow_End">
        <di:waypoint x="1200" y="210"/>
        <di:waypoint x="1252" y="210"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
