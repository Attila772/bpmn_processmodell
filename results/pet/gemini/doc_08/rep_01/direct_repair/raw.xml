<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn">

  <bpmn:process id="Process_DailyDefaulterCheck" name="Daily Defaulter Check Process" isExecutable="true">

    <!-- Start Event: Weekday Morning -->
    <bpmn:startEvent id="StartEvent_WeekdayMorning" name="Every weekday morning">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_WeekdayMorning">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R5/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <!-- Task: Backup Database -->
    <bpmn:serviceTask id="Task_BackupDatabase" name="Backup Database">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Check Account Defaulter Table -->
    <bpmn:serviceTask id="Task_CheckDefaulterTable" name="Check Account Defaulter table for new records">
      <bpmn:incoming">SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: New Defaulter Records? -->
    <bpmn:exclusiveGateway id="Gateway_NewRecords" name="New records found?">
      <bpmn:incoming">SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_NoNewRecords</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_NewRecordsExist</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check CRM for New Returns (Initial) -->
    <bpmn:serviceTask id="Task_CheckCRM_Initial" name="Check CRM system for new returns">
      <bpmn:incoming">SequenceFlow_NoNewRecords</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_NewRecordsExist</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: New Returns Exist? -->
    <bpmn:exclusiveGateway id="Gateway_NewReturnsExist" name="New returns exist?">
      <bpmn:incoming">SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_ReturnsExist</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_NoReturns</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: No Returns -->
    <bpmn:endEvent id="EndEvent_NoReturns" name="Process ended (No new returns)">
      <bpmn:incoming">SequenceFlow_NoReturns</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Subprocess: Phase 1 Processing (Deadline 2:30 PM) -->
    <bpmn:subProcess id="SubProcess_Phase1" name="Phase 1: Registration and Reporting">
      <bpmn:incoming">SequenceFlow_ReturnsExist</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Phase1Complete</bpmn:outgoing>

      <bpmn:startEvent id="StartEvent_Sub1">
        <bpmn:outgoing">SubFlow_01</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:serviceTask id="Task_RegisterAccounts" name="Register all defaulting accounts and customers">
        <bpmn:incoming">SubFlow_01</bpmn:incoming>
        <bpmn:outgoing">SubFlow_02</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_Advised" name="Client codes previously advised?">
        <bpmn:incoming">SubFlow_02</bpmn:incoming>
        <bpmn:outgoing">SubFlow_NotAdvised</bpmn:outgoing>
        <bpmn:outgoing">SubFlow_Advised</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:serviceTask id="Task_ProduceTable" name="Produce table of defaulting accounts">
        <bpmn:incoming">SubFlow_NotAdvised</bpmn:incoming>
        <bpmn:outgoing">SubFlow_03</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:sendTask id="Task_SendToAccountManagement" name="Send table to Account Management">
        <bpmn:incoming">SubFlow_03</bpmn:incoming>
        <bpmn:outgoing">SubFlow_04</bpmn:outgoing>
      </bpmn:sendTask>

      <bpmn:exclusiveGateway id="Gateway_MergePhase1" name="Phase 1 Merge">
        <bpmn:incoming">SubFlow_04</bpmn:incoming>
        <bpmn:incoming">SubFlow_Advised</bpmn:incoming>
        <bpmn:outgoing">SubFlow_05</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:endEvent id="EndEvent_Sub1">
        <bpmn:incoming">SubFlow_05</bpmn:incoming>
      </bpmn:endEvent>

      <!-- Subprocess Sequence Flows -->
      <bpmn:sequenceFlow id="SubFlow_01" sourceRef="StartEvent_Sub1" targetRef="Task_RegisterAccounts" />
      <bpmn:sequenceFlow id="SubFlow_02" sourceRef="Task_RegisterAccounts" targetRef="Gateway_Advised" />
      <bpmn:sequenceFlow id="SubFlow_NotAdvised" name="No" sourceRef="Gateway_Advised" targetRef="Task_ProduceTable" />
      <bpmn:sequenceFlow id="SubFlow_Advised" name="Yes" sourceRef="Gateway_Advised" targetRef="Gateway_MergePhase1" />
      <bpmn:sequenceFlow id="SubFlow_03" sourceRef="Task_ProduceTable" targetRef="Task_SendToAccountManagement" />
      <bpmn:sequenceFlow id="SubFlow_04" sourceRef="Task_SendToAccountManagement" targetRef="Gateway_MergePhase1" />
      <bpmn:sequenceFlow id="SubFlow_05" sourceRef="Gateway_MergePhase1" targetRef="EndEvent_Sub1" />
    </bpmn:subProcess>

    <!-- Boundary Timer Event: 2:30 PM -->
    <bpmn:boundaryEvent id="BoundaryTimer_230PM" name="2:30 PM Deadline" cancelActivity="false" attachedToRef="SubProcess_Phase1">
      <bpmn:outgoing">SequenceFlow_230PMAlert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_230PM">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">14:30:00</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- Send Task: Alert Supervisor at 2:30 PM -->
    <bpmn:sendTask id="Task_AlertSupervisor230" name="Send alert to Supervisor (2:30 PM)">
      <bpmn:incoming">SequenceFlow_230PMAlert</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Alert230End</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Alert230" name="Supervisor alerted (2:30 PM)">
      <bpmn:incoming">SequenceFlow_Alert230End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Subprocess: Phase 2 Reconciliation (Deadline 4:00 PM) -->
    <bpmn:subProcess id="SubProcess_Phase2" name="Phase 2: CRM Recheck and Reconciliation">
      <bpmn:incoming">SequenceFlow_Phase1Complete</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Phase2Complete</bpmn:outgoing>

      <bpmn:startEvent id="StartEvent_Sub2">
        <bpmn:outgoing">SubFlow2_01</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:serviceTask id="Task_CheckCRM_Phase2" name="Check CRM system for new returns">
        <bpmn:incoming">SubFlow2_01</bpmn:incoming>
        <bpmn:outgoing">SubFlow2_02</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_Phase2NewReturns" name="New returns filed?">
        <bpmn:incoming">SubFlow2_02</bpmn:incoming>
        <bpmn:outgoing">SubFlow2_ReturnsFiled</bpmn:outgoing>
        <bpmn:outgoing">SubFlow2_NoReturnsFiled</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:serviceTask id="Task_Reconcile" name="Reconcile with existing Account Defaulters table">
        <bpmn:incoming">SubFlow2_ReturnsFiled</bpmn:incoming>
        <bpmn:outgoing">SubFlow2_03</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_MergePhase2" name="Phase 2 Merge">
        <bpmn:incoming">SubFlow2_03</bpmn:incoming>
        <bpmn:incoming">SubFlow2_NoReturnsFiled</bpmn:incoming>
        <bpmn:outgoing">SubFlow2_04</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:endEvent id="EndEvent_Sub2">
        <bpmn:incoming">SubFlow2_04</bpmn:incoming>
      </bpmn:endEvent>

      <!-- Subprocess 2 Sequence Flows -->
      <bpmn:sequenceFlow id="SubFlow2_01" sourceRef="StartEvent_Sub2" targetRef="Task_CheckCRM_Phase2" />
      <bpmn:sequenceFlow id="SubFlow2_02" sourceRef="Task_CheckCRM_Phase2" targetRef="Gateway_Phase2NewReturns" />
      <bpmn:sequenceFlow id="SubFlow2_ReturnsFiled" name="Yes" sourceRef="Gateway_Phase2NewReturns" targetRef="Task_Reconcile" />
      <bpmn:sequenceFlow id="SubFlow2_NoReturnsFiled" name="No" sourceRef="Gateway_Phase2NewReturns" targetRef="Gateway_MergePhase2" />
      <bpmn:sequenceFlow id="SubFlow2_03" sourceRef="Task_Reconcile" targetRef="Gateway_MergePhase2" />
      <bpmn:sequenceFlow id="SubFlow2_04" sourceRef="Gateway_MergePhase2" targetRef="EndEvent_Sub2" />
    </bpmn:subProcess>

    <!-- Boundary Timer Event: 4:00 PM -->
    <bpmn:boundaryEvent id="BoundaryTimer_400PM" name="4:00 PM Deadline" cancelActivity="false" attachedToRef="SubProcess_Phase2">
      <bpmn:outgoing">SequenceFlow_400PMAlert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_400PM">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">16:00:00</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- Send Task: Alert Supervisor at 4:00 PM -->
    <bpmn:sendTask id="Task_AlertSupervisor400" name="Send message to Supervisor (4:00 PM)">
      <bpmn:incoming">SequenceFlow_400PMAlert</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_Alert400End</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Alert400" name="Supervisor alerted (4:00 PM)">
      <bpmn:incoming">SequenceFlow_Alert400End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Process Normal Completion End Event -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process completed successfully">
      <bpmn:incoming">SequenceFlow_Phase2Complete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Top-Level Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_WeekdayMorning" targetRef="Task_BackupDatabase" />
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_BackupDatabase" targetRef="Task_CheckDefaulterTable" />
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_CheckDefaulterTable" targetRef="Gateway_NewRecords" />
    <bpmn:sequenceFlow id="SequenceFlow_NoNewRecords" name="No" sourceRef="Gateway_NewRecords" targetRef="Task_CheckCRM_Initial" />
    <bpmn:sequenceFlow id="SequenceFlow_NewRecordsExist" name="Yes" sourceRef="Gateway_NewRecords" targetRef="Task_CheckCRM_Initial" />
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_CheckCRM_Initial" targetRef="Gateway_NewReturnsExist" />
    <bpmn:sequenceFlow id="SequenceFlow_ReturnsExist" name="Yes" sourceRef="Gateway_NewReturnsExist" targetRef="SubProcess_Phase1" />
    <bpmn:sequenceFlow id="SequenceFlow_NoReturns" name="No" sourceRef="Gateway_NewReturnsExist" targetRef="EndEvent_NoReturns" />
    <bpmn:sequenceFlow id="SequenceFlow_Phase1Complete" sourceRef="SubProcess_Phase1" targetRef="SubProcess_Phase2" />
    <bpmn:sequenceFlow id="SequenceFlow_230PMAlert" sourceRef="BoundaryTimer_230PM" targetRef="Task_AlertSupervisor230" />
    <bpmn:sequenceFlow id="SequenceFlow_Alert230End" sourceRef="Task_AlertSupervisor230" targetRef="EndEvent_Alert230" />
    <bpmn:sequenceFlow id="SequenceFlow_Phase2Complete" sourceRef="SubProcess_Phase2" targetRef="EndEvent_ProcessCompleted" />
    <bpmn:sequenceFlow id="SequenceFlow_400PMAlert" sourceRef="BoundaryTimer_400PM" targetRef="Task_AlertSupervisor400" />
    <bpmn:sequenceFlow id="SequenceFlow_Alert400End" sourceRef="Task_AlertSupervisor400" targetRef="EndEvent_Alert400" />

  </bpmn:process>

