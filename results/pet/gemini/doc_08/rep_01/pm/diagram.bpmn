<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataStoreReference id="ds_account_defaulter_table" name="Account Defaulter Table" />
    <bpmn:dataStoreReference id="ds_crm" name="CRM System" />
    <bpmn:dataObjectReference id="do_defaulter_report" name="Table of Defaulting Accounts Report" dataObjectRef="do_defaulter_report_do" />
    <bpmn:dataObject id="do_defaulter_report_do" />
    <bpmn:startEvent id="evt_start" name="Weekday Morning Start">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="evt_start_timerdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_normal" name="Process Completed Successfully">
      <bpmn:incoming>sf_rec_yes</bpmn:incoming>
      <bpmn:incoming>sf_ret1_no</bpmn:incoming>
      <bpmn:incoming>sf_ret2_no</bpmn:incoming>
      <bpmn:incoming>sf_400_yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_alert_230" name="Send Alert to Supervisor (2:30 PM Timeout)">
      <bpmn:incoming>sf_230_no</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_alert_230_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_alert_400" name="Send Message to Supervisor (4:00 PM Timeout)">
      <bpmn:incoming>sf_400_no</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_alert_400_msgdef" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_backup_db" name="Back up database">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_check_defaulter_table" name="Check Account Defaulter table for new records">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:property id="task_check_defaulter_table_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_defaulter_table_dia0">
        <bpmn:sourceRef>ds_account_defaulter_table</bpmn:sourceRef>
        <bpmn:targetRef>task_check_defaulter_table_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_check_crm_1" name="Check CRM system for new returns">
      <bpmn:incoming>sf_rec_no</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:property id="task_check_crm_1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_crm_1_dia0">
        <bpmn:sourceRef>ds_crm</bpmn:sourceRef>
        <bpmn:targetRef>task_check_crm_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_register_accounts" name="Register all defaulting accounts and customers">
      <bpmn:incoming>sf_ret1_yes</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_accounts_doa0">
        <bpmn:targetRef>ds_account_defaulter_table</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_produce_send_table" name="Produce table of defaulting accounts and send to account management">
      <bpmn:incoming>sf_adv_no</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_produce_send_table_doa0">
        <bpmn:targetRef>do_defaulter_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_check_crm_2" name="Check CRM system for new returns after report completion">
      <bpmn:incoming>sf_230_yes</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
      <bpmn:property id="task_check_crm_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_crm_2_dia0">
        <bpmn:sourceRef>ds_crm</bpmn:sourceRef>
        <bpmn:targetRef>task_check_crm_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_reconcile" name="Reconcile with existing Account Defaulters table">
      <bpmn:incoming>sf_ret2_yes</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
      <bpmn:property id="task_reconcile_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_reconcile_dia0">
        <bpmn:sourceRef>ds_crm</bpmn:sourceRef>
        <bpmn:targetRef>task_reconcile_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_reconcile_doa0">
        <bpmn:targetRef>ds_account_defaulter_table</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_new_records_exist" name="New records found?" isMarkerVisible="true">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_rec_no</bpmn:outgoing>
      <bpmn:outgoing>sf_rec_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_new_returns_1" name="New returns exist?" isMarkerVisible="true">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_ret1_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_ret1_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_client_advised" name="Client codes previously advised?" isMarkerVisible="true">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_adv_no</bpmn:outgoing>
      <bpmn:outgoing>sf_adv_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_timer_230" name="Completed by 2:30 PM?" isMarkerVisible="true">
      <bpmn:incoming>sf_adv_yes</bpmn:incoming>
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_230_no</bpmn:outgoing>
      <bpmn:outgoing>sf_230_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_new_returns_2" name="New returns filed?" isMarkerVisible="true">
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_ret2_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_ret2_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_timer_400" name="Completed by 4:00 PM?" isMarkerVisible="true">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_400_no</bpmn:outgoing>
      <bpmn:outgoing>sf_400_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_1" sourceRef="evt_start" targetRef="task_backup_db" />
    <bpmn:sequenceFlow id="sf_2" sourceRef="task_backup_db" targetRef="task_check_defaulter_table" />
    <bpmn:sequenceFlow id="sf_3" sourceRef="task_check_defaulter_table" targetRef="gw_new_records_exist" />
    <bpmn:sequenceFlow id="sf_rec_no" sourceRef="gw_new_records_exist" targetRef="task_check_crm_1" name="No new records" />
    <bpmn:sequenceFlow id="sf_rec_yes" sourceRef="gw_new_records_exist" targetRef="evt_end_normal" name="New records exist" />
    <bpmn:sequenceFlow id="sf_4" sourceRef="task_check_crm_1" targetRef="gw_new_returns_1" />
    <bpmn:sequenceFlow id="sf_ret1_yes" sourceRef="gw_new_returns_1" targetRef="task_register_accounts" name="New returns exist" />
    <bpmn:sequenceFlow id="sf_ret1_no" sourceRef="gw_new_returns_1" targetRef="evt_end_normal" name="No new returns" />
    <bpmn:sequenceFlow id="sf_5" sourceRef="task_register_accounts" targetRef="gw_client_advised" />
    <bpmn:sequenceFlow id="sf_adv_no" sourceRef="gw_client_advised" targetRef="task_produce_send_table" name="Not previously advised" />
    <bpmn:sequenceFlow id="sf_adv_yes" sourceRef="gw_client_advised" targetRef="gw_timer_230" name="Previously advised" />
    <bpmn:sequenceFlow id="sf_6" sourceRef="task_produce_send_table" targetRef="gw_timer_230" />
    <bpmn:sequenceFlow id="sf_230_no" sourceRef="gw_timer_230" targetRef="evt_alert_230" name="Not completed by 2:30 PM" />
    <bpmn:sequenceFlow id="sf_230_yes" sourceRef="gw_timer_230" targetRef="task_check_crm_2" name="Completed before 2:30 PM" />
    <bpmn:sequenceFlow id="sf_7" sourceRef="task_check_crm_2" targetRef="gw_new_returns_2" />
    <bpmn:sequenceFlow id="sf_ret2_yes" sourceRef="gw_new_returns_2" targetRef="task_reconcile" name="New returns filed" />
    <bpmn:sequenceFlow id="sf_ret2_no" sourceRef="gw_new_returns_2" targetRef="evt_end_normal" name="No new returns filed" />
    <bpmn:sequenceFlow id="sf_8" sourceRef="task_reconcile" targetRef="gw_timer_400" />
    <bpmn:sequenceFlow id="sf_400_no" sourceRef="gw_timer_400" targetRef="evt_alert_400" name="Not completed by 4:00 PM" />
    <bpmn:sequenceFlow id="sf_400_yes" sourceRef="gw_timer_400" targetRef="evt_end_normal" name="Completed before 4:00 PM" />
  </bpmn:process>
