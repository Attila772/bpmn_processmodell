<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- COLLABORATION -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON (Meter Point Operator New)" processRef="Process_MPON" />
    <bpmn:participant id="Participant_MPOO" name="MPOO (Meter Point Operator Old)" processRef="Process_MPOO" />
    <bpmn:participant id="Participant_GO" name="GO (Grid Operator)" processRef="Process_GO" />
    <bpmn:participant id="Participant_MSP" name="MSP (Meter Service Provider)" processRef="Process_MSP" />

    <!-- MESSAGE FLOWS -->
    <bpmn:messageFlow id="MF_NotifyIntent" name="Equipment Change Intention" sourceRef="Task_MPON_NotifyIntent" targetRef="Start_MPOO" />
    <bpmn:messageFlow id="MF_SelfDismount" name="Self-dismount Announcement" sourceRef="Task_MPOO_AnnounceSelfDismount" targetRef="Event_MPON_ReceiveSelfDismount" />
    <bpmn:messageFlow id="MF_NoSelfDismount" name="No Self-dismount Notification" sourceRef="Task_MPOO_NotifyNoSelfDismount" targetRef="Event_MPON_ReceiveNoSelfDismount" />
    <bpmn:messageFlow id="MF_SendFinalReading" name="Final Reading Values" sourceRef="Task_MPON_SendFinalReading" targetRef="Event_GO_ReceiveFinalReading" />
    <bpmn:messageFlow id="MF_SendDeviceChanges" name="Device Changes, Master Data &amp; Install Reading" sourceRef="Task_MPON_SendDeviceChanges" targetRef="Event_GO_ReceiveDeviceChanges" />
    <bpmn:messageFlow id="MF_NotifyMSP" name="Device Changes, Master Data, Dismount &amp; Install Readings" sourceRef="Task_GO_NotifyMSP" targetRef="Start_MSP" />
  </bpmn:collaboration>

  <!-- PROCESS: MPON -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="Start_MPON" name="Start Equipment Change">
      <bpmn:outgoing">Flow_MPON_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_MPON_NotifyIntent" name="Notify MPOO about equipment change intention">
      <bpmn:incoming">Flow_MPON_1</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:eventBasedGateway id="Gateway_MPON_DecisionReceive">
      <bpmn:incoming">Flow_MPON_2</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_3</bpmn:outgoing>
      <bpmn:outgoing">Flow_MPON_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_MPON_ReceiveSelfDismount" name="Self-dismount announced">
      <bpmn:incoming">Flow_MPON_3</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_MPON_1" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_MPON_ReceiveNoSelfDismount" name="No self-dismount notified">
      <bpmn:incoming">Flow_MPON_4</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_MPON_2" />
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_MPON_PerformReading" name="Perform final reading">
      <bpmn:incoming">Flow_MPON_6</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MPON_DismountOld" name="Dismount old equipment">
      <bpmn:incoming">Flow_MPON_7</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MPON_MergeDismount">
      <bpmn:incoming">Flow_MPON_5</bpmn:incoming>
      <bpmn:incoming">Flow_MPON_8</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_MPON_MountNew" name="Mount new device">
      <bpmn:incoming">Flow_MPON_9</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MPON_ReadInstalledMeter" name="Read meter count from installed meter">
      <bpmn:incoming">Flow_MPON_10</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sendTask id="Task_MPON_SendFinalReading" name="Send values of final reading to GO">
      <bpmn:incoming">Flow_MPON_11</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_12</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_MPON_SendDeviceChanges" name="Tell GO about device changes, master data and install meter count">
      <bpmn:incoming">Flow_MPON_12</bpmn:incoming>
      <bpmn:outgoing">Flow_MPON_13</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_MPON" name="Equipment Change Completed (MPON)">
      <bpmn:incoming">Flow_MPON_13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows MPON -->
    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="Start_MPON" targetRef="Task_MPON_NotifyIntent" />
    <bpmn:sequenceFlow id="Flow_MPON_2" sourceRef="Task_MPON_NotifyIntent" targetRef="Gateway_MPON_DecisionReceive" />
    <bpmn:sequenceFlow id="Flow_MPON_3" sourceRef="Gateway_MPON_DecisionReceive" targetRef="Event_MPON_ReceiveSelfDismount" />
    <bpmn:sequenceFlow id="Flow_MPON_4" sourceRef="Gateway_MPON_DecisionReceive" targetRef="Event_MPON_ReceiveNoSelfDismount" />
    <bpmn:sequenceFlow id="Flow_MPON_5" sourceRef="Event_MPON_ReceiveSelfDismount" targetRef="Gateway_MPON_MergeDismount" />
    <bpmn:sequenceFlow id="Flow_MPON_6" sourceRef="Event_MPON_ReceiveNoSelfDismount" targetRef="Task_MPON_PerformReading" />
    <bpmn:sequenceFlow id="Flow_MPON_7" sourceRef="Task_MPON_PerformReading" targetRef="Task_MPON_DismountOld" />
    <bpmn:sequenceFlow id="Flow_MPON_8" sourceRef="Task_MPON_DismountOld" targetRef="Gateway_MPON_MergeDismount" />
    <bpmn:sequenceFlow id="Flow_MPON_9" sourceRef="Gateway_MPON_MergeDismount" targetRef="Task_MPON_MountNew" />
    <bpmn:sequenceFlow id="Flow_MPON_10" sourceRef="Task_MPON_MountNew" targetRef="Task_MPON_ReadInstalledMeter" />
    <bpmn:sequenceFlow id="Flow_MPON_11" sourceRef="Task_MPON_ReadInstalledMeter" targetRef="Task_MPON_SendFinalReading" />
    <bpmn:sequenceFlow id="Flow_MPON_12" sourceRef="Task_MPON_SendFinalReading" targetRef="Task_MPON_SendDeviceChanges" />
    <bpmn:sequenceFlow id="Flow_MPON_13" sourceRef="Task_MPON_SendDeviceChanges" targetRef="End_MPON" />
  </bpmn:process>

  <!-- PROCESS: MPOO -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="Start_MPOO" name="Intention Notification Received">
      <bpmn:outgoing">Flow_MPOO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_MPOO_Start" />
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_MPOO_SelfDismountDecision" name="Self dismounting?">
      <bpmn:incoming">Flow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing">Flow_MPOO_Yes</bpmn:outgoing>
      <bpmn:outgoing">Flow_MPOO_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_MPOO_AnnounceSelfDismount" name="Announce self dismounting to MPON">
      <bpmn:incoming">Flow_MPOO_Yes</bpmn:incoming>
      <bpmn:outgoing">Flow_MPOO_2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:task id="Task_MPOO_PerformReading" name="Perform final reading">
      <bpmn:incoming">Flow_MPOO_2</bpmn:incoming>
      <bpmn:outgoing">Flow_MPOO_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MPOO_DismountOld" name="Dismount old equipment">
      <bpmn:incoming">Flow_MPOO_3</bpmn:incoming>
      <bpmn:outgoing">Flow_MPOO_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_MPOO_SelfDismount" name="Self-dismounting Finished">
      <bpmn:incoming">Flow_MPOO_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_MPOO_NotifyNoSelfDismount" name="Notify MPON about no self-dismounting">
      <bpmn:incoming">Flow_MPOO_No</bpmn:incoming>
      <bpmn:outgoing">Flow_MPOO_5</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_MPOO_NoSelfDismount" name="No Self-dismount Notified">
      <bpmn:incoming">Flow_MPOO_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows MPOO -->
    <bpmn:sequenceFlow id="Flow_MPOO_1" sourceRef="Start_MPOO" targetRef="Gateway_MPOO_SelfDismountDecision" />
    <bpmn:sequenceFlow id="Flow_MPOO_Yes" name="Yes" sourceRef="Gateway_MPOO_SelfDismountDecision" targetRef="Task_MPOO_AnnounceSelfDismount" />
    <bpmn:sequenceFlow id="Flow_MPOO_No" name="No" sourceRef="Gateway_MPOO_SelfDismountDecision" targetRef="Task_MPOO_NotifyNoSelfDismount" />
    <bpmn:sequenceFlow id="Flow_MPOO_2" sourceRef="Task_MPOO_AnnounceSelfDismount" targetRef="Task_MPOO_PerformReading" />
    <bpmn:sequenceFlow id="Flow_MPOO_3" sourceRef="Task_MPOO_PerformReading" targetRef="Task_MPOO_DismountOld" />
    <bpmn:sequenceFlow id="Flow_MPOO_4" sourceRef="Task_MPOO_DismountOld" targetRef="End_MPOO_SelfDismount" />
    <bpmn:sequenceFlow id="Flow_MPOO_5" sourceRef="Task_MPOO_NotifyNoSelfDismount" targetRef="End_MPOO_NoSelfDismount" />
  </bpmn:process>

  <!-- PROCESS: GO -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="Event_GO_ReceiveFinalReading" name="Final reading values received">
      <bpmn:outgoing">Flow_GO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_GO_1" />
    </bpmn:startEvent>

    <bpmn:intermediateCatchEvent id="Event_GO_ReceiveDeviceChanges" name="Device changes &amp; master data received">
      <bpmn:incoming">Flow_GO_1</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_GO_2" />
    </bpmn:intermediateCatchEvent>

    <bpmn:sendTask id="Task_GO_NotifyMSP" name="Notify MSP about device changes, master data, dismount &amp; install meter counts">
      <bpmn:incoming">Flow_GO_2</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_3</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_GO" name="GO Notification Completed">
      <bpmn:incoming">Flow_GO_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows GO -->
    <bpmn:sequenceFlow id="Flow_GO_1" sourceRef="Event_GO_ReceiveFinalReading" targetRef="Event_GO_ReceiveDeviceChanges" />
    <bpmn:sequenceFlow id="Flow_GO_2" sourceRef="Event_GO_ReceiveDeviceChanges" targetRef="Task_GO_NotifyMSP" />
    <bpmn:sequenceFlow id="Flow_GO_3" sourceRef="Task_GO_NotifyMSP" targetRef="End_GO" />
  </bpmn:process>

  <!-- PROCESS: MSP -->
  <bpmn:process id="Process_MSP" isExecutable="false">
    <bpmn:startEvent id="Start_MSP" name="Device changes and meter counts received">
      <bpmn:outgoing">Flow_MSP_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_MSP_Start" />
    </bpmn:startEvent>

    <bpmn:endEvent id="End_MSP" name="MSP Informed">
      <bpmn:incoming">Flow_MSP_1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows MSP -->
    <bpmn:sequenceFlow id="Flow_MSP_1" sourceRef="Start_MSP" targetRef="End_MSP" />
  </bpmn:process>

  <!-- BPMN DIAGRAM -->
