<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://www.example.org/bpmn"
             id="EquipmentChangeDefinitions">

  <collaboration id="collaboration_1">
    <participant id="participant_mpon" name="MPON" processRef="process_mpon" />
    <participant id="participant_mpoo" name="MPOO" processRef="process_mpoo" />
    <participant id="participant_go" name="GO" processRef="process_go" />
    <participant id="participant_msp" name="MSP" processRef="process_msp" />

    <messageFlow id="mf_1" name="Equipment Change Intention" sourceRef="task_notify_intention" targetRef="start_mpoo" />
    <messageFlow id="mf_2" name="Self-Dismounting Announcement" sourceRef="task_mpoo_announce_self" targetRef="event_rcv_dismount_response" />
    <messageFlow id="mf_3" name="No Self-Dismounting Notification" sourceRef="task_mpoo_notify_no_self" targetRef="event_rcv_dismount_response" />
    <messageFlow id="mf_4" name="Final Reading Values" sourceRef="task_mpon_send_final_reading" targetRef="event_go_rcv_final_reading" />
    <messageFlow id="mf_5" name="Device Changes, Master Data &amp; Meter Count (Install)" sourceRef="task_mpon_tell_go_changes" targetRef="event_go_rcv_device_changes" />
    <messageFlow id="mf_6" name="Device Changes, Master Data &amp; Meter Counts (Dismount &amp; Install)" sourceRef="task_go_notify_msp" targetRef="start_msp" />
  </collaboration>

  <process id="process_mpon" isExecutable="false">
    <startEvent id="start_mpon" name="Equipment change required">
      <outgoing">seq_mpon_1</outgoing>
    </startEvent>

    <sendTask id="task_notify_intention" name="Notify MPOO about equipment change intentions">
      <incoming>seq_mpon_1</incoming>
      <outgoing>seq_mpon_2</outgoing>
    </sendTask>

    <eventBasedGateway id="ev_gtw_dismount_resp" name="Wait for MPOO decision">
      <incoming>seq_mpon_2</incoming>
      <outgoing>seq_mpon_3</outgoing>
    </eventBasedGateway>

    <intermediateCatchEvent id="event_rcv_dismount_response" name="Receive dismounting decision">
      <incoming>seq_mpon_3</incoming>
      <outgoing>seq_mpon_5</outgoing>
      <messageEventDefinition id="med_1" />
    </intermediateCatchEvent>

    <exclusiveGateway id="gtw_mpoo_dismounts" name="MPOO self dismounts?">
      <incoming>seq_mpon_5</incoming>
      <outgoing>seq_mpoo_dismounts_yes</outgoing>
      <outgoing>seq_mpoo_dismounts_no</outgoing>
    </exclusiveGateway>

    <task id="task_mpon_read" name="Perform final reading">
      <incoming>seq_mpoo_dismounts_no</incoming>
      <outgoing>seq_mpon_6</outgoing>
    </task>

    <task id="task_mpon_dismount" name="Dismount old equipment">
      <incoming>seq_mpon_6</incoming>
      <outgoing>seq_mpon_7</outgoing>
    </task>

    <exclusiveGateway id="gtw_dismount_merge">
      <incoming>seq_mpoo_dismounts_yes</incoming>
      <incoming>seq_mpon_7</incoming>
      <outgoing>seq_mpon_8</outgoing>
    </exclusiveGateway>

    <task id="task_mpon_mount" name="Mount new device">
      <incoming>seq_mpon_8</incoming>
      <outgoing>seq_mpon_9</outgoing>
    </task>

    <task id="task_mpon_read_new" name="Read meter count from installed meter">
      <incoming>seq_mpon_9</incoming>
      <outgoing>seq_mpon_10</outgoing>
    </task>

    <sendTask id="task_mpon_send_final_reading" name="Send values of final reading to GO">
      <incoming>seq_mpon_10</incoming>
      <outgoing>seq_mpon_11</outgoing>
    </sendTask>

    <sendTask id="task_mpon_tell_go_changes" name="Tell GO about device changes, master data and meter count at installation">
      <incoming>seq_mpon_11</incoming>
      <outgoing>seq_mpon_12</outgoing>
    </sendTask>

    <endEvent id="end_mpon" name="Equipment change completed by MPON">
      <incoming>seq_mpon_12</incoming>
    </endEvent>

    <sequenceFlow id="seq_mpon_1" sourceRef="start_mpon" targetRef="task_notify_intention" />
    <sequenceFlow id="seq_mpon_2" sourceRef="task_notify_intention" targetRef="ev_gtw_dismount_resp" />
    <sequenceFlow id="seq_mpon_3" sourceRef="ev_gtw_dismount_resp" targetRef="event_rcv_dismount_response" />
    <sequenceFlow id="seq_mpon_5" sourceRef="event_rcv_dismount_response" targetRef="gtw_mpoo_dismounts" />
    <sequenceFlow id="seq_mpoo_dismounts_yes" name="Yes" sourceRef="gtw_mpoo_dismounts" targetRef="gtw_dismount_merge" />
    <sequenceFlow id="seq_mpoo_dismounts_no" name="No" sourceRef="gtw_mpoo_dismounts" targetRef="task_mpon_read" />
    <sequenceFlow id="seq_mpon_6" sourceRef="task_mpon_read" targetRef="task_mpon_dismount" />
    <sequenceFlow id="seq_mpon_7" sourceRef="task_mpon_dismount" targetRef="gtw_dismount_merge" />
    <sequenceFlow id="seq_mpon_8" sourceRef="gtw_dismount_merge" targetRef="task_mpon_mount" />
    <sequenceFlow id="seq_mpon_9" sourceRef="task_mpon_mount" targetRef="task_mpon_read_new" />
    <sequenceFlow id="seq_mpon_10" sourceRef="task_mpon_read_new" targetRef="task_mpon_send_final_reading" />
    <sequenceFlow id="seq_mpon_11" sourceRef="task_mpon_send_final_reading" targetRef="task_mpon_tell_go_changes" />
    <sequenceFlow id="seq_mpon_12" sourceRef="task_mpon_tell_go_changes" targetRef="end_mpon" />
  </process>

  <process id="process_mpoo" isExecutable="false">
    <startEvent id="start_mpoo" name="Equipment change intention received">
      <outgoing>seq_mpoo_1</outgoing>
      <messageEventDefinition id="med_2" />
    </startEvent>

    <exclusiveGateway id="gtw_mpoo_decision" name="Decide on self-dismounting">
      <incoming>seq_mpoo_1</incoming>
      <outgoing>seq_mpoo_self</outgoing>
      <outgoing>seq_mpoo_noself</outgoing>
    </exclusiveGateway>

    <sendTask id="task_mpoo_announce_self" name="Announce self dismounting to MPON">
      <incoming>seq_mpoo_self</incoming>
      <outgoing>seq_mpoo_2</outgoing>
    </sendTask>

    <sendTask id="task_mpoo_notify_no_self" name="Notify MPON about no self-dismounting">
      <incoming>seq_mpoo_noself</incoming>
      <outgoing>seq_mpoo_3</outgoing>
    </sendTask>

    <task id="task_mpoo_read" name="Perform final reading">
      <incoming>seq_mpoo_2</incoming>
      <outgoing>seq_mpoo_4</outgoing>
    </task>

    <task id="task_mpoo_dismount" name="Dismount old equipment">
      <incoming>seq_mpoo_4</incoming>
      <outgoing>seq_mpoo_5</outgoing>
    </task>

    <exclusiveGateway id="gtw_mpoo_end">
      <incoming>seq_mpoo_3</incoming>
      <incoming>seq_mpoo_5</incoming>
      <outgoing>seq_mpoo_6</outgoing>
    </exclusiveGateway>

    <endEvent id="end_mpoo" name="MPOO action finished">
      <incoming>seq_mpoo_6</incoming>
    </endEvent>

    <sequenceFlow id="seq_mpoo_1" sourceRef="start_mpoo" targetRef="gtw_mpoo_decision" />
    <sequenceFlow id="seq_mpoo_self" name="Self dismounting" sourceRef="gtw_mpoo_decision" targetRef="task_mpoo_announce_self" />
    <sequenceFlow id="seq_mpoo_noself" name="No self dismounting" sourceRef="gtw_mpoo_decision" targetRef="task_mpoo_notify_no_self" />
    <sequenceFlow id="seq_mpoo_2" sourceRef="task_mpoo_announce_self" targetRef="task_mpoo_read" />
    <sequenceFlow id="seq_mpoo_3" sourceRef="task_mpoo_notify_no_self" targetRef="gtw_mpoo_end" />
    <sequenceFlow id="seq_mpoo_4" sourceRef="task_mpoo_read" targetRef="task_mpoo_dismount" />
    <sequenceFlow id="seq_mpoo_5" sourceRef="task_mpoo_dismount" targetRef="gtw_mpoo_end" />
    <sequenceFlow id="seq_mpoo_6" sourceRef="gtw_mpoo_end" targetRef="end_mpoo" />
  </process>

  <process id="process_go" isExecutable="false">
    <startEvent id="event_go_rcv_final_reading" name="Receive final reading values">
      <outgoing>seq_go_1</outgoing>
      <messageEventDefinition id="med_3" />
    </startEvent>

    <intermediateCatchEvent id="event_go_rcv_device_changes" name="Receive device changes, master data and meter count at installation">
      <incoming>seq_go_1</incoming>
      <outgoing>seq_go_2</outgoing>
      <messageEventDefinition id="med_4" />
    </intermediateCatchEvent>

    <sendTask id="task_go_notify_msp" name="Notify MSP about device changes, master data, meter count at dismounting, and meter count at installation">
      <incoming>seq_go_2</incoming>
      <outgoing>seq_go_3</outgoing>
    </sendTask>

    <endEvent id="end_go" name="GO notifications processed">
      <incoming>seq_go_3</incoming>
    </endEvent>

    <sequenceFlow id="seq_go_1" sourceRef="event_go_rcv_final_reading" targetRef="event_go_rcv_device_changes" />
    <sequenceFlow id="seq_go_2" sourceRef="event_go_rcv_device_changes" targetRef="task_go_notify_msp" />
    <sequenceFlow id="seq_go_3" sourceRef="task_go_notify_msp" targetRef="end_go" />
  </process>

  <process id="process_msp" isExecutable="false">
    <startEvent id="start_msp" name="Receive device changes, master data, and meter counts">
      <outgoing>seq_msp_1</outgoing>
      <messageEventDefinition id="med_5" />
    </startEvent>

    <endEvent id="end_msp" name="MSP process completed">
      <incoming>seq_msp_1</incoming>
    </endEvent>

    <sequenceFlow id="seq_msp_1" sourceRef="start_msp" targetRef="end_msp" />
  </process>

