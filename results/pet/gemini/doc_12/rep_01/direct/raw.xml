<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.org/schema/bpmn">

  <!-- Collaboration -->
  <collaboration id="Collaboration_1">
    <participant id="Participant_AssemblerAG" name="Assembler AG" processRef="Process_AssemblerAG" />
    <participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier" />
    <messageFlow id="MessageFlow_Order" name="Order" sourceRef="Task_SendOrder" targetRef="StartEvent_SupplierOrderReceived" />
    <messageFlow id="MessageFlow_Invoice" name="Invoice" sourceRef="Task_SendInvoice" targetRef="Task_ReceiveInvoice" />
  </collaboration>

  <!-- Process: Assembler AG -->
  <process id="Process_AssemblerAG" isExecutable="true">
    <startEvent id="StartEvent_Monthly" name="First of the month">
      <timerEventDefinition id="TimerEventDefinition_1">
        <timeCycle xsi:type="tFormalExpression">R/P1M</timeCycle>
      </timerEventDefinition>
    </startEvent>
    
    <sendTask id="Task_SendOrder" name="Send order to supplier">
      <incoming>SequenceFlow_AG_1</incoming>
      <outgoing>SequenceFlow_AG_2</outgoing>
    </sendTask>
    
    <receiveTask id="Task_ReceiveInvoice" name="Receive invoice">
      <incoming>SequenceFlow_AG_2</incoming>
      <outgoing>SequenceFlow_AG_3</outgoing>
    </receiveTask>
    
    <endEvent id="EndEvent_AG" name="Order completed">
      <incoming>SequenceFlow_AG_3</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_AG_1" sourceRef="StartEvent_Monthly" targetRef="Task_SendOrder" />
    <sequenceFlow id="SequenceFlow_AG_2" sourceRef="Task_SendOrder" targetRef="Task_ReceiveInvoice" />
    <sequenceFlow id="SequenceFlow_AG_3" sourceRef="Task_ReceiveInvoice" targetRef="EndEvent_AG" />
  </process>

  <!-- Process: Supplier -->
  <process id="Process_Supplier" isExecutable="true">
    <startEvent id="StartEvent_SupplierOrderReceived" name="Order received">
      <messageEventDefinition id="MessageEventDefinition_1" />
    </startEvent>

    <serviceTask id="Task_ProcessOrder" name="Process order">
      <incoming>SequenceFlow_Sup_1</incoming>
      <outgoing>SequenceFlow_Sup_2</outgoing>
    </serviceTask>

    <sendTask id="Task_SendInvoice" name="Send invoice to Assembler AG">
      <incoming>SequenceFlow_Sup_2</incoming>
      <outgoing>SequenceFlow_Sup_3</outgoing>
    </sendTask>

    <endEvent id="EndEvent_Supplier" name="Invoice sent">
      <incoming>SequenceFlow_Sup_3</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_Sup_1" sourceRef="StartEvent_SupplierOrderReceived" targetRef="Task_ProcessOrder" />
    <sequenceFlow id="SequenceFlow_Sup_2" sourceRef="Task_ProcessOrder" targetRef="Task_SendInvoice" />
    <sequenceFlow id="SequenceFlow_Sup_3" sourceRef="Task_SendInvoice" targetRef="EndEvent_Supplier" />
  </process>

  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      
      <!-- Participant: Assembler AG -->
      <bpmndi:BPMNShape id="Participant_AssemblerAG_di" bpmnElement="Participant_AssemblerAG" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="600" height="160" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="StartEvent_Monthly_di" bpmnElement="StartEvent_Monthly">
        <dc:Bounds x="212" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="188" y="185" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendOrder_di" bpmnElement="Task_SendOrder">
        <dc:Bounds x="300" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveInvoice_di" bpmnElement="Task_ReceiveInvoice">
        <dc:Bounds x="550" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_AG_di" bpmnElement="EndEvent_AG">
        <dc:Bounds x="702" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="680" y="185" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="SequenceFlow_AG_1_di" bpmnElement="SequenceFlow_AG_1">
        <di:waypoint x="248" y="160" />
        <di:waypoint x="300" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AG_2_di" bpmnElement="SequenceFlow_AG_2">
        <di:waypoint x="400" y="160" />
        <di:waypoint x="550" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AG_3_di" bpmnElement="SequenceFlow_AG_3">
        <di:waypoint x="650" y="160" />
        <di:waypoint x="702" y="160" />
      </bpmndi:BPMNEdge>

      <!-- Participant: Supplier -->
      <bpmndi:BPMNShape id="Participant_Supplier_di" bpmnElement="Participant_Supplier" isHorizontal="true">
        <dc:Bounds x="160" y="300" width="600" height="160" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_SupplierOrderReceived_di" bpmnElement="StartEvent_SupplierOrderReceived">
        <dc:Bounds x="332" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="314" y="405" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcessOrder_di" bpmnElement="Task_ProcessOrder">
        <dc:Bounds x="420" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendInvoice_di" bpmnElement="Task_SendInvoice">
        <dc:Bounds x="550" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Supplier_di" bpmnElement="EndEvent_Supplier">
        <dc:Bounds x="702" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="691" y="405" width="59" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="SequenceFlow_Sup_1_di" bpmnElement="SequenceFlow_Sup_1">
        <di:waypoint x="368" y="380" />
        <di:waypoint x="420" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Sup_2_di" bpmnElement="SequenceFlow_Sup_2">
        <di:waypoint x="520" y="380" />
        <di:waypoint x="550" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Sup_3_di" bpmnElement="SequenceFlow_Sup_3">
        <di:waypoint x="650" y="380" />
        <di:waypoint x="702" y="380" />
      </bpmndi:BPMNEdge>

      <!-- Message Flows -->
      <bpmndi:BPMNEdge id="MessageFlow_Order_di" bpmnElement="MessageFlow_Order">
        <di:waypoint x="350" y="200" />
        <di:waypoint x="350" y="362" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="360" y="278" width="29" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Invoice_di" bpmnElement="MessageFlow_Invoice">
        <di:waypoint x="600" y="340" />
        <di:waypoint x="600" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="608" y="278" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
