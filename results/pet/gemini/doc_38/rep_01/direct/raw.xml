<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_LoanApproval"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  
  <bpmn:process id="LoanApprovalProcess" name="Loan Approval Process" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_LoanRequested" name="Loan Request Received">
      <bpmn:outgoing">SequenceFlow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start" />
    </bpmn:startEvent>

    <!-- Service Task: Risk Assessment WS -->
    <bpmn:serviceTask id="ServiceTask_AssessRisk" name="Assess Risk (Risk Assessment WS)" implementation="##WebService">
      <bpmn:incoming">SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Risk & Amount Evaluation -->
    <bpmn:exclusiveGateway id="Gateway_RiskEvaluation" name="Evaluate Risk and Amount">
      <bpmn:incoming">SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_LowRiskSmallAmount</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_HighRisk</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_NeedsFurtherReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task: Approver WS -->
    <bpmn:serviceTask id="ServiceTask_ApproverService" name="Approve Loan (Approver WS)" implementation="##WebService">
      <bpmn:incoming">SequenceFlow_NeedsFurtherReview</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Merge Assessment / Approval Results -->
    <bpmn:exclusiveGateway id="Gateway_MergeResults">
      <bpmn:incoming">SequenceFlow_LowRiskSmallAmount</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_ToFeedback</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send Task: Send Feedback to Customer -->
    <bpmn:sendTask id="SendTask_SendFeedback" name="Send Feedback to Customer" implementation="##WebService">
      <bpmn:incoming">SequenceFlow_ToFeedback</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_HighRisk</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_04</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_LoanProcessed" name="Loan Processed">
      <bpmn:incoming">SequenceFlow_04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_LoanRequested" targetRef="ServiceTask_AssessRisk" />
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="ServiceTask_AssessRisk" targetRef="Gateway_RiskEvaluation" />
    
    <bpmn:sequenceFlow id="SequenceFlow_LowRiskSmallAmount" name="Low Risk &#38; Amount &#lt; $10,000 (Approved)" sourceRef="Gateway_RiskEvaluation" targetRef="Gateway_MergeResults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskLevel == 'LOW' &amp;&amp; amount &lt; 10000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_HighRisk" name="High Risk (Denied)" sourceRef="Gateway_RiskEvaluation" targetRef="SendTask_SendFeedback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskLevel == 'HIGH'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_NeedsFurtherReview" name="Further Review or Amount &#gt;= $10,000" sourceRef="Gateway_RiskEvaluation" targetRef="ServiceTask_ApproverService">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskLevel == 'MEDIUM' || amount &gt;= 10000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="ServiceTask_ApproverService" targetRef="Gateway_MergeResults" />
    <bpmn:sequenceFlow id="SequenceFlow_ToFeedback" sourceRef="Gateway_MergeResults" targetRef="SendTask_SendFeedback" />
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="SendTask_SendFeedback" targetRef="EndEvent_LoanProcessed" />

  </bpmn:process>

  <!-- BPMN Diagram Graphical Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="LoanApprovalProcess">
      
      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_LoanRequested_di" bpmnElement="StartEvent_LoanRequested">
        <dc:Bounds x="152" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="255" width="71" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Service Task: Risk Assessment -->
      <bpmndi:BPMNShape id="ServiceTask_AssessRisk_di" bpmnElement="ServiceTask_AssessRisk">
        <dc:Bounds x="240" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Risk Evaluation -->
      <bpmndi:BPMNShape id="Gateway_RiskEvaluation_di" bpmnElement="Gateway_RiskEvaluation" isMarkerVisible="true">
        <dc:Bounds x="395" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="381" y="166" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Service Task: Approver Service -->
      <bpmndi:BPMNShape id="ServiceTask_ApproverService_di" bpmnElement="ServiceTask_ApproverService">
        <dc:Bounds x="530" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Merge Results -->
      <bpmndi:BPMNShape id="Gateway_MergeResults_di" bpmnElement="Gateway_MergeResults" isMarkerVisible="true">
        <dc:Bounds x="685" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Send Task: Send Feedback -->
      <bpmndi:BPMNShape id="SendTask_SendFeedback_di" bpmnElement="SendTask_SendFeedback">
        <dc:Bounds x="780" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event -->
      <bpmndi:BPMNShape id="EndEvent_LoanProcessed_di" bpmnElement="EndEvent_LoanProcessed">
        <dc:Bounds x="932" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="911" y="255" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="SequenceFlow_01_di" bpmnElement="SequenceFlow_01">
        <di:waypoint x="188" y="230" />
        <di:waypoint x="240" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_02_di" bpmnElement="SequenceFlow_02">
        <di:waypoint x="340" y="230" />
        <di:waypoint x="395" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_LowRiskSmallAmount_di" bpmnElement="SequenceFlow_LowRiskSmallAmount">
        <di:waypoint x="445" y="230" />
        <di:waypoint x="685" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="521" y="196" width="88" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_HighRisk_di" bpmnElement="SequenceFlow_HighRisk">
        <di:waypoint x="420" y="205" />
        <di:waypoint x="420" y="120" />
        <di:waypoint x="830" y="120" />
        <di:waypoint x="830" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="581" y="86" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_NeedsFurtherReview_di" bpmnElement="SequenceFlow_NeedsFurtherReview">
        <di:waypoint x="420" y="255" />
        <di:waypoint x="420" y="340" />
        <di:waypoint x="530" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="346" width="84" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_03_di" bpmnElement="SequenceFlow_03">
        <di:waypoint x="630" y="340" />
        <di:waypoint x="710" y="340" />
        <di:waypoint x="710" y="255" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ToFeedback_di" bpmnElement="SequenceFlow_ToFeedback">
        <di:waypoint x="735" y="230" />
        <di:waypoint x="780" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_04_di" bpmnElement="SequenceFlow_04">
        <di:waypoint x="880" y="230" />
        <di:waypoint x="932" y="230" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
