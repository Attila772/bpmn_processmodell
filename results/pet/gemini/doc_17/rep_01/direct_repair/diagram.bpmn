<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definitions_job_posting"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="collaboration_1">
    <participant id="participant_hr_clerk" name="HR Clerk" processRef="process_job_posting" />
  </collaboration>

  <process id="process_job_posting" isExecutable="false">
    <!-- Start Event -->
    <startEvent id="start_event_vacancy_reported" name="Vacancy reported">
      <outgoing>flow_01</outgoing>
    </startEvent>

    <!-- Task: Create Job Description -->
    <userTask id="task_create_job_description" name="Create job description">
      <incoming>flow_01</incoming>
      <incoming>flow_04</incoming>
      <outgoing>flow_02</outgoing>
    </userTask>

    <!-- Gateway: Is Information Clear? -->
    <exclusiveGateway id="gateway_info_clear" name="Information clear?">
      <incoming>flow_02</incoming>
      <outgoing>flow_03</outgoing>
      <outgoing>flow_05</outgoing>
    </exclusiveGateway>

    <!-- Task: Ask Department for Clarification -->
    <userTask id="task_ask_department" name="Ask Department for clarification">
      <incoming>flow_03</incoming>
      <outgoing>flow_04</outgoing>
    </userTask>

    <!-- Task: Submit Job Description for Consideration -->
    <userTask id="task_submit_description" name="Submit job description for consideration">
      <incoming>flow_05</incoming>
      <incoming>flow_10</incoming>
      <outgoing>flow_06</outgoing>
    </userTask>

    <!-- Task: Wait for Approval -->
    <receiveTask id="task_wait_for_approval" name="Wait for approval">
      <incoming>flow_06</incoming>
      <outgoing>flow_07</outgoing>
    </receiveTask>

    <!-- Gateway: Is Job Description Approved? -->
    <exclusiveGateway id="gateway_approved" name="Approved?">
      <incoming>flow_07</incoming>
      <outgoing>flow_08</outgoing>
      <outgoing>flow_09</outgoing>
    </exclusiveGateway>

    <!-- Task: Correct Job Description -->
    <userTask id="task_correct_description" name="Correct job description">
      <incoming>flow_09</incoming>
      <outgoing>flow_10</outgoing>
    </userTask>

    <!-- Task: Post the Job -->
    <userTask id="task_post_job" name="Post the job">
      <incoming>flow_08</incoming>
      <outgoing>flow_11</outgoing>
    </userTask>

    <!-- End Event -->
    <endEvent id="end_event_job_posted" name="Job posted">
      <incoming>flow_11</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="flow_01" sourceRef="start_event_vacancy_reported" targetRef="task_create_job_description" />
    <sequenceFlow id="flow_02" sourceRef="task_create_job_description" targetRef="gateway_info_clear" />
    <sequenceFlow id="flow_03" name="No (confusion)" sourceRef="gateway_info_clear" targetRef="task_ask_department" />
    <sequenceFlow id="flow_04" sourceRef="task_ask_department" targetRef="task_create_job_description" />
    <sequenceFlow id="flow_05" name="Yes" sourceRef="gateway_info_clear" targetRef="task_submit_description" />
    <sequenceFlow id="flow_06" sourceRef="task_submit_description" targetRef="task_wait_for_approval" />
    <sequenceFlow id="flow_07" sourceRef="task_wait_for_approval" targetRef="gateway_approved" />
    <sequenceFlow id="flow_08" name="Yes" sourceRef="gateway_approved" targetRef="task_post_job" />
    <sequenceFlow id="flow_09" name="No (rejected, correction requested)" sourceRef="gateway_approved" targetRef="task_correct_description" />
    <sequenceFlow id="flow_10" sourceRef="task_correct_description" targetRef="task_submit_description" />
    <sequenceFlow id="flow_11" sourceRef="task_post_job" targetRef="end_event_job_posted" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration_1">
      <bpmndi:BPMNShape id="shape_participant_hr_clerk" bpmnElement="participant_hr_clerk" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1280" height="360" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_start_event_vacancy_reported" bpmnElement="start_event_vacancy_reported">
        <dc:Bounds x="222" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="198" y="245" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_create_job_description" bpmnElement="task_create_job_description">
        <dc:Bounds x="300" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_gateway_info_clear" bpmnElement="gateway_info_clear" isMarkerVisible="true">
        <dc:Bounds x="445" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="165" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_ask_department" bpmnElement="task_ask_department">
        <dc:Bounds x="420" y="310" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_submit_description" bpmnElement="task_submit_description">
        <dc:Bounds x="550" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_wait_for_approval" bpmnElement="task_wait_for_approval">
        <dc:Bounds x="700" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_gateway_approved" bpmnElement="gateway_approved" isMarkerVisible="true">
        <dc:Bounds x="845" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="844" y="165" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_correct_description" bpmnElement="task_correct_description">
        <dc:Bounds x="820" y="310" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_post_job" bpmnElement="task_post_job">
        <dc:Bounds x="970" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end_event_job_posted" bpmnElement="end_event_job_posted">
        <dc:Bounds x="1122" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1114" y="245" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_flow_01" bpmnElement="flow_01">
        <di:waypoint x="258" y="220" />
        <di:waypoint x="300" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_02" bpmnElement="flow_02">
        <di:waypoint x="400" y="220" />
        <di:waypoint x="445" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_03" bpmnElement="flow_03">
        <di:waypoint x="470" y="245" />
        <di:waypoint x="470" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="474" y="270" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_04" bpmnElement="flow_04">
        <di:waypoint x="420" y="350" />
        <di:waypoint x="350" y="350" />
        <di:waypoint x="350" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_05" bpmnElement="flow_05">
        <di:waypoint x="495" y="220" />
        <di:waypoint x="550" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="514" y="202" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_06" bpmnElement="flow_06">
        <di:waypoint x="650" y="220" />
        <di:waypoint x="700" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_07" bpmnElement="flow_07">
        <di:waypoint x="800" y="220" />
        <di:waypoint x="845" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_08" bpmnElement="flow_08">
        <di:waypoint x="895" y="220" />
        <di:waypoint x="970" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="924" y="202" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_09" bpmnElement="flow_09">
        <di:waypoint x="870" y="245" />
        <di:waypoint x="870" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="874" y="260" width="71" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_10" bpmnElement="flow_10">
        <di:waypoint x="820" y="350" />
        <di:waypoint x="600" y="350" />
        <di:waypoint x="600" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_11" bpmnElement="flow_11">
        <di:waypoint x="1070" y="220" />
        <di:waypoint x="1122" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
