<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.org/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_LeadProcessing" name="Lead Processing" processRef="Process_LeadProcessing" />
  </bpmn:collaboration>
  <bpmn:process id="Process_LeadProcessing" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckOpenLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectTopFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstructSalesAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_NoteReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LeadProcessed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesAssistant" name="Sales Assistant">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsInterested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNoteToManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreCustomers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoMoreLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_1" name="Leads need processing">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:userTask id="Task_CheckOpenLeads" name="Check open leads">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:userTask id="Task_SelectTopFive" name="Select top five leads">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:task id="Task_InstructSalesAssistant" name="Tell Sales Assistant to call leads">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CallCustomer" name="Call customer contact person">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_NextCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_IsInterested" name="Is customer interested?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_InterestedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_InterestedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_SendNoteToManager" name="Send note to Manager">
      <bpmn:incoming>Flow_InterestedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:intermediateCatchEvent id="Event_NoteReceived" name="Note received">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    
    <bpmn:userTask id="Task_ProcessLead" name="Process lead">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:endEvent id="EndEvent_LeadProcessed" name="Lead processed">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:exclusiveGateway id="Gateway_MoreCustomers" name="More selected customers to call?">
      <bpmn:incoming>Flow_InterestedNo</bpmn:incoming>
      <bpmn:outgoing>Flow_NextCustomer</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoMoreCustomers</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:endEvent id="EndEvent_NoMoreLeads" name="All selected leads contacted">
      <bpmn:incoming>Flow_NoMoreCustomers</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckOpenLeads" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckOpenLeads" targetRef="Task_SelectTopFive" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectTopFive" targetRef="Task_InstructSalesAssistant" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_InstructSalesAssistant" targetRef="Task_CallCustomer" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CallCustomer" targetRef="Gateway_IsInterested" />
    <bpmn:sequenceFlow id="Flow_InterestedYes" name="Yes" sourceRef="Gateway_IsInterested" targetRef="Task_SendNoteToManager" />
    <bpmn:sequenceFlow id="Flow_InterestedNo" name="No" sourceRef="Gateway_IsInterested" targetRef="Gateway_MoreCustomers" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SendNoteToManager" targetRef="Event_NoteReceived" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_NoteReceived" targetRef="Task_ProcessLead" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ProcessLead" targetRef="EndEvent_LeadProcessed" />
    <bpmn:sequenceFlow id="Flow_NextCustomer" name="Yes" sourceRef="Gateway_MoreCustomers" targetRef="Task_CallCustomer" />
    <bpmn:sequenceFlow id="Flow_NoMoreCustomers" name="No" sourceRef="Gateway_MoreCustomers" targetRef="EndEvent_NoMoreLeads" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" executionObject="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_LeadProcessing_di" bpmnElement="Participant_LeadProcessing" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1280" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1250" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SalesAssistant_di" bpmnElement="Lane_SalesAssistant" isHorizontal="true">
        <dc:Bounds x="190" y="290" width="1250" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="232" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="221" y="195" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckOpenLeads_di" bpmnElement="Task_CheckOpenLeads">
        <dc:Bounds x="310" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectTopFive_di" bpmnElement="Task_SelectTopFive">
        <dc:Bounds x="450" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InstructSalesAssistant_di" bpmnElement="Task_InstructSalesAssistant">
        <dc:Bounds x="590" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CallCustomer_di" bpmnElement="Task_CallCustomer">
        <dc:Bounds x="590" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_IsInterested_di" bpmnElement="Gateway_IsInterested" isMarkerVisible="true">
        <dc:Bounds x="735" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="731" y="422" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendNoteToManager_di" bpmnElement="Task_SendNoteToManager">
        <dc:Bounds x="830" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_NoteReceived_di" bpmnElement="Event_NoteReceived">
        <dc:Bounds x="862" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="846" y="122" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessLead_di" bpmnElement="Task_ProcessLead">
        <dc:Bounds x="950" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LeadProcessed_di" bpmnElement="EndEvent_LeadProcessed">
        <dc:Bounds x="1092" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1071" y="195" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MoreCustomers_di" bpmnElement="Gateway_MoreCustomers" isMarkerVisible="true">
        <dc:Bounds x="1175" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1164" y="320" width="73" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_NoMoreLeads_di" bpmnElement="EndEvent_NoMoreLeads">
        <dc:Bounds x="1322" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1297" y="415" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="170" />
        <di:waypoint x="310" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="410" y="170" />
        <di:waypoint x="450" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="550" y="170" />
        <di:waypoint x="590" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="640" y="210" />
        <di:waypoint x="640" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="690" y="390" />
        <di:waypoint x="735" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InterestedYes_di" bpmnElement="Flow_InterestedYes">
        <di:waypoint x="785" y="390" />
        <di:waypoint x="830" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="799" y="372" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InterestedNo_di" bpmnElement="Flow_InterestedNo">
        <di:waypoint x="760" y="415" />
        <di:waypoint x="760" y="470" />
        <di:waypoint x="1200" y="470" />
        <di:waypoint x="1200" y="415" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="768" y="433" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="880" y="350" />
        <di:waypoint x="880" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="898" y="170" />
        <di:waypoint x="950" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1050" y="170" />
        <di:waypoint x="1092" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NextCustomer_di" bpmnElement="Flow_NextCustomer">
        <di:waypoint x="1200" y="415" />
        <di:waypoint x="1200" y="490" />
        <di:waypoint x="610" y="490" />
        <di:waypoint x="610" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1171" y="433" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoMoreCustomers_di" bpmnElement="Flow_NoMoreCustomers">
        <di:waypoint x="1225" y="390" />
        <di:waypoint x="1322" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1266" y="372" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
