<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf_dereg_request" sourceRef="end_dereg_sent" targetRef="start_go_dereg" name="Deregistration Request" />
    <bpmn:messageFlow id="mf_dereg_rejection" sourceRef="end_go_rejected" targetRef="start_mpoo_rejected" name="Deregistration Rejection" />
    <bpmn:messageFlow id="mf_continuation_obligation" sourceRef="end_go_obligation" targetRef="start_mpoo_obligation" name="Continuation Obligation" />
    <bpmn:messageFlow id="mf_continuation_confirmation" sourceRef="end_mpoo_continuation" targetRef="start_go_continuation" name="Continuation Confirmation" />
    <bpmn:messageFlow id="mf_inform_mpoo" sourceRef="end_go_inform_mpoo" targetRef="start_mpoo_assignment_info" name="Assignment Information MPOO" />
    <bpmn:messageFlow id="mf_inform_mspo" sourceRef="end_go_inform_mspo" targetRef="start_mspo_assignment_info" name="Assignment Information MSPO" />
    <bpmn:messageFlow id="mf_inform_sp" sourceRef="end_go_inform_sp" targetRef="start_sp_assignment_info" name="Assignment Information SP" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:startEvent id="start_mpoo" name="Deregistration initiated">
      <bpmn:outgoing>sf_mpoo_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_dereg_sent" name="Deregistration sent">
      <bpmn:incoming>sf_mpoo_end_req</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_dereg_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_mpoo_rejected" name="Rejection received">
      <bpmn:outgoing>sf_mpoo_rejected_start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpoo_rejected_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpoo_rejected_process" name="Process ended (Rejected)">
      <bpmn:incoming>sf_mpoo_rejected_start</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_mpoo_continuation" name="Continuation confirmed to GO">
      <bpmn:incoming>sf_mpoo_confirm_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_mpoo_continuation_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_mpoo_assignment_info" name="Assignment information received by MPOO">
      <bpmn:outgoing>sf_mpoo_assign_info</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpoo_assignment_info_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpoo_process" name="MPOO process finished">
      <bpmn:incoming>sf_mpoo_assign_info</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_mpoo_obligation" name="Obligation received by MPOO">
      <bpmn:outgoing>sf_mpoo_oblige_start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpoo_obligation_msgdef" />
    </bpmn:startEvent>
    <bpmn:task id="task_mpoo_deregister" name="Deregister at GO">
      <bpmn:incoming>sf_mpoo_start</bpmn:incoming>
      <bpmn:outgoing>sf_mpoo_end_req</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_mpoo_confirm_continuation" name="Confirm continuation to GO">
      <bpmn:incoming>sf_mpoo_oblige_start</bpmn:incoming>
      <bpmn:outgoing>sf_mpoo_confirm_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf_mpoo_start" sourceRef="start_mpoo" targetRef="task_mpoo_deregister" />
    <bpmn:sequenceFlow id="sf_mpoo_end_req" sourceRef="task_mpoo_deregister" targetRef="end_dereg_sent" />
    <bpmn:sequenceFlow id="sf_mpoo_rejected_start" sourceRef="start_mpoo_rejected" targetRef="end_mpoo_rejected_process" />
    <bpmn:sequenceFlow id="sf_mpoo_oblige_start" sourceRef="start_mpoo_obligation" targetRef="task_mpoo_confirm_continuation" />
    <bpmn:sequenceFlow id="sf_mpoo_confirm_to_end" sourceRef="task_mpoo_confirm_continuation" targetRef="end_mpoo_continuation" />
    <bpmn:sequenceFlow id="sf_mpoo_assign_info" sourceRef="start_mpoo_assignment_info" targetRef="end_mpoo_process" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:startEvent id="start_go_dereg" name="Deregistration received">
      <bpmn:outgoing>sf_go_start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_go_dereg_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_go_rejected" name="Deregistration rejected">
      <bpmn:incoming>sf_go_reject_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_go_rejected_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_go_continuation" name="Continuation confirmation received">
      <bpmn:outgoing>sf_go_cont_received</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_go_continuation_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_go_inform_mpoo" name="Inform MPOO sent">
      <bpmn:incoming>sf_go_inf_mpoo_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_go_inform_mpoo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go_inform_mspo" name="Inform MSPO sent">
      <bpmn:incoming>sf_go_inf_mspo_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_go_inform_mspo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go_inform_sp" name="Inform SP sent">
      <bpmn:incoming>sf_go_inf_sp_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_go_inform_sp_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go_obligation" name="Obligation sent to MPOO">
      <bpmn:incoming>sf_go_oblige_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_go_obligation_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_go_verify" name="Verify deregistration">
      <bpmn:incoming>sf_go_start</bpmn:incoming>
      <bpmn:outgoing>sf_go_verify_to_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_reject" name="Reject deregistration of MPOO">
      <bpmn:incoming>sf_go_verify_to_reject</bpmn:incoming>
      <bpmn:outgoing>sf_go_reject_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_confirm" name="Preliminarily confirm deregistration of MPOO">
      <bpmn:incoming>sf_go_verify_to_confirm</bpmn:incoming>
      <bpmn:outgoing>sf_go_confirm_to_prep</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_prepare_readmission" name="Prepare readmission of measuring point">
      <bpmn:incoming>sf_go_confirm_to_prep</bpmn:incoming>
      <bpmn:outgoing>sf_go_prep_to_oblige_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_oblige_mpoo" name="Oblige MPOO to continue operations">
      <bpmn:incoming>sf_go_oblige_yes</bpmn:incoming>
      <bpmn:outgoing>sf_go_oblige_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_equipment" name="Perform equipment acquisition and / or equipment changes">
      <bpmn:incoming>sf_go_merge_to_equipment</bpmn:incoming>
      <bpmn:outgoing>sf_go_equip_to_assign</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_assign" name="Assign GO as MPO">
      <bpmn:incoming>sf_go_equip_to_assign</bpmn:incoming>
      <bpmn:outgoing>sf_go_assign_to_parallel</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_inform_mpoo" name="Inform MPOO about end/beginning of assignment">
      <bpmn:incoming>sf_go_par_to_mpoo</bpmn:incoming>
      <bpmn:outgoing>sf_go_inf_mpoo_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_inform_mspo" name="Inform MSPO about assignment of GO">
      <bpmn:incoming>sf_go_par_to_mspo</bpmn:incoming>
      <bpmn:outgoing>sf_go_inf_mspo_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_go_inform_sp" name="Inform SP about assignment of GO">
      <bpmn:incoming>sf_go_par_to_sp</bpmn:incoming>
      <bpmn:outgoing>sf_go_inf_sp_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_verification" name="Deregistration verified?" isMarkerVisible="true">
      <bpmn:incoming>sf_go_verify_to_gw</bpmn:incoming>
      <bpmn:outgoing>sf_go_verify_to_reject</bpmn:outgoing>
      <bpmn:outgoing>sf_go_verify_to_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_oblige_check" name="Oblige MPOO to continue?" isMarkerVisible="true">
      <bpmn:incoming>sf_go_prep_to_oblige_gw</bpmn:incoming>
      <bpmn:outgoing>sf_go_oblige_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_go_oblige_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_go_continuation_merge" name="Merge continuation flow" isMarkerVisible="true">
      <bpmn:incoming>sf_go_cont_received</bpmn:incoming>
      <bpmn:incoming>sf_go_oblige_no</bpmn:incoming>
      <bpmn:outgoing>sf_go_merge_to_equipment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_go_inform_parallel" name="Parallel notifications">
      <bpmn:incoming>sf_go_assign_to_parallel</bpmn:incoming>
      <bpmn:outgoing>sf_go_par_to_mpoo</bpmn:outgoing>
      <bpmn:outgoing>sf_go_par_to_mspo</bpmn:outgoing>
      <bpmn:outgoing>sf_go_par_to_sp</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="sf_go_start" sourceRef="start_go_dereg" targetRef="task_go_verify" />
    <bpmn:sequenceFlow id="sf_go_verify_to_gw" sourceRef="task_go_verify" targetRef="gw_verification" />
    <bpmn:sequenceFlow id="sf_go_verify_to_reject" sourceRef="gw_verification" targetRef="task_go_reject" name="Rejected" />
    <bpmn:sequenceFlow id="sf_go_reject_to_end" sourceRef="task_go_reject" targetRef="end_go_rejected" />
    <bpmn:sequenceFlow id="sf_go_verify_to_confirm" sourceRef="gw_verification" targetRef="task_go_confirm" name="Confirmed" />
    <bpmn:sequenceFlow id="sf_go_confirm_to_prep" sourceRef="task_go_confirm" targetRef="task_go_prepare_readmission" />
    <bpmn:sequenceFlow id="sf_go_prep_to_oblige_gw" sourceRef="task_go_prepare_readmission" targetRef="gw_oblige_check" />
    <bpmn:sequenceFlow id="sf_go_oblige_yes" sourceRef="gw_oblige_check" targetRef="task_go_oblige_mpoo" name="Yes" />
    <bpmn:sequenceFlow id="sf_go_oblige_to_end" sourceRef="task_go_oblige_mpoo" targetRef="end_go_obligation" />
    <bpmn:sequenceFlow id="sf_go_cont_received" sourceRef="start_go_continuation" targetRef="gw_go_continuation_merge" />
    <bpmn:sequenceFlow id="sf_go_oblige_no" sourceRef="gw_oblige_check" targetRef="gw_go_continuation_merge" name="No" />
    <bpmn:sequenceFlow id="sf_go_merge_to_equipment" sourceRef="gw_go_continuation_merge" targetRef="task_go_equipment" />
    <bpmn:sequenceFlow id="sf_go_equip_to_assign" sourceRef="task_go_equipment" targetRef="task_go_assign" />
    <bpmn:sequenceFlow id="sf_go_assign_to_parallel" sourceRef="task_go_assign" targetRef="gw_go_inform_parallel" />
    <bpmn:sequenceFlow id="sf_go_par_to_mpoo" sourceRef="gw_go_inform_parallel" targetRef="task_go_inform_mpoo" />
    <bpmn:sequenceFlow id="sf_go_par_to_mspo" sourceRef="gw_go_inform_parallel" targetRef="task_go_inform_mspo" />
    <bpmn:sequenceFlow id="sf_go_par_to_sp" sourceRef="gw_go_inform_parallel" targetRef="task_go_inform_sp" />
    <bpmn:sequenceFlow id="sf_go_inf_mpoo_end" sourceRef="task_go_inform_mpoo" targetRef="end_go_inform_mpoo" />
    <bpmn:sequenceFlow id="sf_go_inf_mspo_end" sourceRef="task_go_inform_mspo" targetRef="end_go_inform_mspo" />
    <bpmn:sequenceFlow id="sf_go_inf_sp_end" sourceRef="task_go_inform_sp" targetRef="end_go_inform_sp" />
  </bpmn:process>
  <bpmn:process id="pool_mspo_proc" isExecutable="false">
    <bpmn:startEvent id="start_mspo_assignment_info" name="Assignment information received by MSPO">
      <bpmn:outgoing>sf_mspo_assign_info</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mspo_assignment_info_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mspo_process" name="MSPO informed">
      <bpmn:incoming>sf_mspo_assign_info</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf_mspo_assign_info" sourceRef="start_mspo_assignment_info" targetRef="end_mspo_process" />
  </bpmn:process>
  <bpmn:process id="pool_sp_proc" isExecutable="false">
    <bpmn:startEvent id="start_sp_assignment_info" name="Assignment information received by SP">
      <bpmn:outgoing>sf_sp_assign_info</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_sp_assignment_info_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_sp_process" name="SP informed">
      <bpmn:incoming>sf_sp_assign_info</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf_sp_assign_info" sourceRef="start_sp_assignment_info" targetRef="end_sp_process" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpoo_part_di" bpmnElement="pool_mpoo_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_go_part_di" bpmnElement="pool_go_part" isHorizontal="true">
        <dc:Bounds x="120" y="750" width="1710" height="775" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_mspo_part_di" bpmnElement="pool_mspo_part" isHorizontal="true">
        <dc:Bounds x="120" y="1585" width="700" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_sp_part_di" bpmnElement="pool_sp_part" isHorizontal="true">
        <dc:Bounds x="120" y="1920" width="700" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_dereg_sent_di" bpmnElement="end_dereg_sent">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_go_inform_mpoo_di" bpmnElement="end_go_inform_mpoo">
        <dc:Bounds x="1300" y="810" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_go_inform_mspo_di" bpmnElement="end_go_inform_mspo">
        <dc:Bounds x="1300" y="935" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_go_inform_sp_di" bpmnElement="end_go_inform_sp">
        <dc:Bounds x="1300" y="1060" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_go_obligation_di" bpmnElement="end_go_obligation">
        <dc:Bounds x="1490" y="810" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_go_rejected_di" bpmnElement="end_go_rejected">
        <dc:Bounds x="920" y="810" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mpoo_continuation_di" bpmnElement="end_mpoo_continuation">
        <dc:Bounds x="540" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mpoo_process_di" bpmnElement="end_mpoo_process">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mpoo_rejected_process_di" bpmnElement="end_mpoo_rejected_process">
        <dc:Bounds x="350" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mspo_process_di" bpmnElement="end_mspo_process">
        <dc:Bounds x="350" y="1645" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_sp_process_di" bpmnElement="end_sp_process">
        <dc:Bounds x="350" y="1980" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_go_continuation_merge_di" bpmnElement="gw_go_continuation_merge">
        <dc:Bounds x="1300" y="1185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_go_inform_parallel_di" bpmnElement="gw_go_inform_parallel">
        <dc:Bounds x="920" y="935" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_oblige_check_di" bpmnElement="gw_oblige_check">
        <dc:Bounds x="1110" y="810" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_verification_di" bpmnElement="gw_verification">
        <dc:Bounds x="540" y="810" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_go_continuation_di" bpmnElement="start_go_continuation">
        <dc:Bounds x="160" y="810" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_go_dereg_di" bpmnElement="start_go_dereg">
        <dc:Bounds x="160" y="935" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_di" bpmnElement="start_mpoo">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_assignment_info_di" bpmnElement="start_mpoo_assignment_info">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_obligation_di" bpmnElement="start_mpoo_obligation">
        <dc:Bounds x="160" y="350" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_rejected_di" bpmnElement="start_mpoo_rejected">
        <dc:Bounds x="160" y="475" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mspo_assignment_info_di" bpmnElement="start_mspo_assignment_info">
        <dc:Bounds x="160" y="1645" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_sp_assignment_info_di" bpmnElement="start_sp_assignment_info">
        <dc:Bounds x="160" y="1980" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_assign_di" bpmnElement="task_go_assign">
        <dc:Bounds x="730" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_confirm_di" bpmnElement="task_go_confirm">
        <dc:Bounds x="730" y="935" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_equipment_di" bpmnElement="task_go_equipment">
        <dc:Bounds x="540" y="935" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_inform_mpoo_di" bpmnElement="task_go_inform_mpoo">
        <dc:Bounds x="1110" y="935" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_inform_mspo_di" bpmnElement="task_go_inform_mspo">
        <dc:Bounds x="1110" y="1060" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_inform_sp_di" bpmnElement="task_go_inform_sp">
        <dc:Bounds x="1110" y="1185" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_oblige_mpoo_di" bpmnElement="task_go_oblige_mpoo">
        <dc:Bounds x="1300" y="1310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_prepare_readmission_di" bpmnElement="task_go_prepare_readmission">
        <dc:Bounds x="920" y="1060" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_reject_di" bpmnElement="task_go_reject">
