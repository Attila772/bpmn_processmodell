<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.org/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_GO" name="Grid Operator (GO)" processRef="Process_GO" />
    <bpmn:participant id="Participant_MPOO" name="Meter Point Operator Old (MPOO)" />
    <bpmn:participant id="Participant_MSPO" name="Meter Service Provider Old (MSPO)" />
    <bpmn:participant id="Participant_SP" name="Supplier (SP)" />
    <bpmn:messageFlow id="MF_1" name="Deregistration request" sourceRef="Participant_MPOO" targetRef="StartEvent_1" />
    <bpmn:messageFlow id="MF_2" name="Rejection notice" sourceRef="Task_RejectDereg" targetRef="Participant_MPOO" />
    <bpmn:messageFlow id="MF_3" name="Preliminary confirmation" sourceRef="Task_PrelimConfirm" targetRef="Participant_MPOO" />
    <bpmn:messageFlow id="MF_4" name="Obligation to continue operation" sourceRef="Task_ObligeMPOO" targetRef="Participant_MPOO" />
    <bpmn:messageFlow id="MF_5" name="Confirmation of continuation" sourceRef="Participant_MPOO" targetRef="Task_ReceiveContinuationConfirm" />
    <bpmn:messageFlow id="MF_6" name="Inform end/begin of assignment" sourceRef="Task_InformMPOO" targetRef="Participant_MPOO" />
    <bpmn:messageFlow id="MF_7" name="Inform assignment" sourceRef="Task_InformMSPO" targetRef="Participant_MSPO" />
    <bpmn:messageFlow id="MF_8" name="Inform assignment" sourceRef="Task_InformSP" targetRef="Participant_SP" />
  </bpmn:collaboration>

  <bpmn:process id="Process_GO" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Deregistration received from MPOO">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:task id="Task_VerifyDereg" name="Verify deregistration">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Verification" name="Deregistration valid?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_RejectDereg" name="Reject deregistration of MPOO">
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_EndRejected</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>Flow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_PrelimConfirm" name="Preliminarily confirm deregistration">
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:task id="Task_PrepareReadmission" name="Prepare readmission of measuring point">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Oblige" name="Oblige MPOO to continue operations?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_ObligeYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ObligeNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_ObligeMPOO" name="Oblige MPOO to continue operation">
      <bpmn:incoming>Flow_ObligeYes</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Task_ReceiveContinuationConfirm" name="Receive continuation confirmation from MPOO">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:exclusiveGateway id="Gateway_MergeOblige" name="Merge">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_ObligeNo</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_EquipmentAcquisition" name="Perform equipment acquisition and/or changes">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AssignGO" name="Assign GO as MPO">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_ParallelInform" name="Split informing stakeholders">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Inform1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Inform2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Inform3</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="Task_InformMPOO" name="Inform MPOO about end/beginning of assignment">
      <bpmn:incoming>Flow_Inform1</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge1</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_InformMSPO" name="Inform MSPO about assignment of GO">
      <bpmn:incoming>Flow_Inform2</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_InformSP" name="Inform SP about assignment of GO">
      <bpmn:incoming>Flow_Inform3</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge3</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Join informing stakeholders">
      <bpmn:incoming>Flow_Merge1</bpmn:incoming>
      <bpmn:incoming>Flow_Merge2</bpmn:incoming>
      <bpmn:incoming>Flow_Merge3</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_VerifyDereg" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_VerifyDereg" targetRef="Gateway_Verification" />
    <bpmn:sequenceFlow id="Flow_Reject" name="No" sourceRef="Gateway_Verification" targetRef="Task_RejectDereg" />
    <bpmn:sequenceFlow id="Flow_Approve" name="Yes" sourceRef="Gateway_Verification" targetRef="Task_PrelimConfirm" />
    <bpmn:sequenceFlow id="Flow_EndRejected" sourceRef="Task_RejectDereg" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_PrelimConfirm" targetRef="Task_PrepareReadmission" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PrepareReadmission" targetRef="Gateway_Oblige" />
    <bpmn:sequenceFlow id="Flow_ObligeYes" name="Yes" sourceRef="Gateway_Oblige" targetRef="Task_ObligeMPOO" />
    <bpmn:sequenceFlow id="Flow_ObligeNo" name="No" sourceRef="Gateway_Oblige" targetRef="Gateway_MergeOblige" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ObligeMPOO" targetRef="Task_ReceiveContinuationConfirm" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ReceiveContinuationConfirm" targetRef="Gateway_MergeOblige" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_MergeOblige" targetRef="Task_EquipmentAcquisition" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_EquipmentAcquisition" targetRef="Task_AssignGO" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AssignGO" targetRef="Gateway_ParallelInform" />
    <bpmn:sequenceFlow id="Flow_Inform1" sourceRef="Gateway_ParallelInform" targetRef="Task_InformMPOO" />
    <bpmn:sequenceFlow id="Flow_Inform2" sourceRef="Gateway_ParallelInform" targetRef="Task_InformMSPO" />
    <bpmn:sequenceFlow id="Flow_Inform3" sourceRef="Gateway_ParallelInform" targetRef="Task_InformSP" />
    <bpmn:sequenceFlow id="Flow_Merge1" sourceRef="Task_InformMPOO" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_Merge2" sourceRef="Task_InformMSPO" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_Merge3" sourceRef="Task_InformSP" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_ParallelJoin" targetRef="EndEvent_Completed" />
  </bpmn:process>

