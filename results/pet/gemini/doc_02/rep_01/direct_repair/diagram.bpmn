<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CRS" name="Computer Repair Service (CRS)" processRef="Process_ComputerRepair" />
    <bpmn:participant id="Participant_Customer" name="Customer" />
    <bpmn:messageFlow id="MessageFlow_BringComputer" name="Defective Computer" sourceRef="Participant_Customer" targetRef="StartEvent_ComputerReceived" />
    <bpmn:messageFlow id="MessageFlow_CostCalculation" name="Repair Cost Calculation" sourceRef="Task_CheckDefect" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MessageFlow_CustomerDecision" name="Accept / Reject Decision" sourceRef="Participant_Customer" targetRef="Gateway_CostAcceptable" />
    <bpmn:messageFlow id="MessageFlow_TakeHome" name="Unrepaired Computer" sourceRef="EndEvent_TakenHomeUnrepaired" targetRef="Participant_Customer" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ComputerRepair" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_CRS" name="CRS Staff">
        <bpmn:flowNodeRef>StartEvent_ComputerReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDefect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CostAcceptable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TakenHomeUnrepaired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ArbitraryRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RepairFinished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_ComputerReceived" name="Defective computer brought in">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_CheckDefect" name="Check defect and calculate repair costs">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CostAcceptable" name="Are costs acceptable?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CostsAccepted</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CostsRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_TakenHomeUnrepaired" name="Computer taken home unrepaired">
      <bpmn:incoming>SequenceFlow_CostsRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:subProcess id="SubProcess_ArbitraryRepair" name="Arbitrary Repair Execution">
      <bpmn:incoming>SequenceFlow_CostsAccepted</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubProcessDone</bpmn:outgoing>

      <bpmn:startEvent id="SubStart_1">
        <bpmn:outgoing>SubSeq_1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:inclusiveGateway id="SubGateway_Split" name="Choose Repair Activity">
        <bpmn:incoming>SubSeq_1</bpmn:incoming>
        <bpmn:outgoing>SubSeq_ToHW</bpmn:outgoing>
        <bpmn:outgoing>SubSeq_ToSW</bpmn:outgoing>
      </bpmn:inclusiveGateway>

      <bpmn:task id="Task_RepairHW" name="Check and repair hardware">
        <bpmn:incoming>SubSeq_ToHW</bpmn:incoming>
        <bpmn:outgoing>SubSeq_FromHW</bpmn:outgoing>
      </bpmn:task>

      <bpmn:task id="Task_TestHW" name="Test functionality (Hardware)">
        <bpmn:incoming>SubSeq_FromHW</bpmn:incoming>
        <bpmn:outgoing>SubSeq_TestHWDone</bpmn:outgoing>
      </bpmn:task>

      <bpmn:task id="Task_RepairSW" name="Check and configure software">
        <bpmn:incoming>SubSeq_ToSW</bpmn:incoming>
        <bpmn:outgoing>SubSeq_FromSW</bpmn:outgoing>
      </bpmn:task>

      <bpmn:task id="Task_TestSW" name="Test functionality (Software)">
        <bpmn:incoming>SubSeq_FromSW</bpmn:incoming>
        <bpmn:outgoing>SubSeq_TestSWDone</bpmn:outgoing>
      </bpmn:task>

      <bpmn:inclusiveGateway id="SubGateway_Join">
        <bpmn:incoming>SubSeq_TestHWDone</bpmn:incoming>
        <bpmn:incoming>SubSeq_TestSWDone</bpmn:incoming>
        <bpmn:outgoing>SubSeq_ToSubEnd</bpmn:outgoing>
      </bpmn:inclusiveGateway>

      <bpmn:endEvent id="SubEnd_1">
        <bpmn:incoming>SubSeq_ToSubEnd</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="SubSeq_1" sourceRef="SubStart_1" targetRef="SubGateway_Split" />
      <bpmn:sequenceFlow id="SubSeq_ToHW" sourceRef="SubGateway_Split" targetRef="Task_RepairHW" />
      <bpmn:sequenceFlow id="SubSeq_FromHW" sourceRef="Task_RepairHW" targetRef="Task_TestHW" />
      <bpmn:sequenceFlow id="SubSeq_TestHWDone" sourceRef="Task_TestHW" targetRef="SubGateway_Join" />
      <bpmn:sequenceFlow id="SubSeq_ToSW" sourceRef="SubGateway_Split" targetRef="Task_RepairSW" />
      <bpmn:sequenceFlow id="SubSeq_FromSW" sourceRef="Task_RepairSW" targetRef="Task_TestSW" />
      <bpmn:sequenceFlow id="SubSeq_TestSWDone" sourceRef="Task_TestSW" targetRef="SubGateway_Join" />
      <bpmn:sequenceFlow id="SubSeq_ToSubEnd" sourceRef="SubGateway_Join" targetRef="SubEnd_1" />
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_ErrorDetected" name="Error detected during test?">
      <bpmn:incoming>SequenceFlow_SubProcessDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoError</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_RepairFinished" name="Repair finished successfully">
      <bpmn:incoming>SequenceFlow_NoError</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_ComputerReceived" targetRef="Task_CheckDefect" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_CheckDefect" targetRef="Gateway_CostAcceptable" />
    <bpmn:sequenceFlow id="SequenceFlow_CostsAccepted" name="Yes" sourceRef="Gateway_CostAcceptable" targetRef="SubProcess_ArbitraryRepair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${costsAcceptable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CostsRejected" name="No" sourceRef="Gateway_CostAcceptable" targetRef="EndEvent_TakenHomeUnrepaired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${costsAcceptable == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_SubProcessDone" sourceRef="SubProcess_ArbitraryRepair" targetRef="Gateway_ErrorDetected" />
    <bpmn:sequenceFlow id="SequenceFlow_NoError" name="No" sourceRef="Gateway_ErrorDetected" targetRef="EndEvent_RepairFinished">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorDetected == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_LoopBack" name="Yes" sourceRef="Gateway_ErrorDetected" targetRef="SubProcess_ArbitraryRepair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorDetected == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1380" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Participant_CRS_di" bpmnElement="Participant_CRS" isHorizontal="true">
        <dc:Bounds x="160" y="220" width="1380" height="420" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_CRS_di" bpmnElement="Lane_CRS" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="1350" height="420" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_ComputerReceived_di" bpmnElement="StartEvent_ComputerReceived">
        <dc:Bounds x="242" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="216" y="405" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckDefect_di" bpmnElement="Task_CheckDefect">
        <dc:Bounds x="330" y="340" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_CostAcceptable_di" bpmnElement="Gateway_CostAcceptable" isMarkerVisible="true">
        <dc:Bounds x="485" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="479" y="318" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_TakenHomeUnrepaired_di" bpmnElement="EndEvent_TakenHomeUnrepaired">
        <dc:Bounds x="492" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="471" y="535" width="79" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ErrorDetected_di" bpmnElement="Gateway_ErrorDetected" isMarkerVisible="true">
        <dc:Bounds x="1345" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1334" y="318" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_RepairFinished_di" bpmnElement="EndEvent_RepairFinished">
        <dc:Bounds x="1462" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1444" y="405" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubProcess_ArbitraryRepair_di" bpmnElement="SubProcess_ArbitraryRepair" isExpanded="true">
        <dc:Bounds x="600" y="260" width="690" height="320" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubStart_1_di" bpmnElement="SubStart_1">
        <dc:Bounds x="630" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubGateway_Split_di" bpmnElement="SubGateway_Split">
        <dc:Bounds x="715" y="385" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="702" y="348" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RepairHW_di" bpmnElement="Task_RepairHW">
        <dc:Bounds x="810" y="300" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TestHW_di" bpmnElement="Task_TestHW">
        <dc:Bounds x="960" y="300" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RepairSW_di" bpmnElement="Task_RepairSW">
        <dc:Bounds x="810" y="450" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TestSW_di" bpmnElement="Task_TestSW">
        <dc:Bounds x="960" y="450" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubGateway_Join_di" bpmnElement="SubGateway_Join">
        <dc:Bounds x="1115" y="385" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubEnd_1_di" bpmnElement="SubEnd_1">
        <dc:Bounds x="1212" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="SubSeq_1_di" bpmnElement="SubSeq_1">
        <di:waypoint x="666" y="410" />
        <di:waypoint x="715" y="410" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubSeq_ToHW_di" bpmnElement="SubSeq_ToHW">
        <di:waypoint x="740" y="385" />
        <di:waypoint x="740" y="340" />
        <di:waypoint x="810" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubSeq_FromHW_di" bpmnElement="SubSeq_FromHW">
        <di:waypoint x="910" y="340" />
        <di:waypoint x="960" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubSeq_TestHWDone_di" bpmnElement="SubSeq_TestHWDone">
        <di:waypoint x="1060" y="340" />
        <di:waypoint x="1140" y="340" />
        <di:waypoint x="1140" y="385" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubSeq_ToSW_di" bpmnElement="SubSeq_ToSW">
        <di:waypoint x="740" y="435" />
        <di:waypoint x="740" y="490" />
        <di:waypoint x="810" y="490" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubSeq_FromSW_di" bpmnElement="SubSeq_FromSW">
        <di:waypoint x="910" y="490" />
        <di:waypoint x="960" y="490" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubSeq_TestSWDone_di" bpmnElement="SubSeq_TestSWDone">
        <di:waypoint x="1060" y="490" />
        <di:waypoint x="1140" y="490" />
        <di:waypoint x="1140" y="435" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SubSeq_ToSubEnd_di" bpmnElement="SubSeq_ToSubEnd">
        <di:waypoint x="1165" y="410" />
        <di:waypoint x="1212" y="410" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_1_di" bpmnElement="SequenceFlow_1">
        <di:waypoint x="278" y="380" />
        <di:waypoint x="330" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_2_di" bpmnElement="SequenceFlow_2">
        <di:waypoint x="430" y="380" />
        <di:waypoint x="485" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_CostsAccepted_di" bpmnElement="SequenceFlow_CostsAccepted">
        <di:waypoint x="535" y="380" />
        <di:waypoint x="600" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="559" y="362" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_CostsRejected_di" bpmnElement="SequenceFlow_CostsRejected">
        <di:waypoint x="510" y="405" />
        <di:waypoint x="510" y="492" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="518" y="446" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_SubProcessDone_di" bpmnElement="SequenceFlow_SubProcessDone">
        <di:waypoint x="1290" y="380" />
        <di:waypoint x="1345" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_NoError_di" bpmnElement="SequenceFlow_NoError">
        <di:waypoint x="1395" y="380" />
        <di:waypoint x="1462" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1420" y="362" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_LoopBack_di" bpmnElement="SequenceFlow_LoopBack">
        <di:waypoint x="1370" y="405" />
        <di:waypoint x="1370" y="600" />
        <di:waypoint x="945" y="600" />
        <di:waypoint x="945" y="580" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1149" y="582" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_BringComputer_di" bpmnElement="MessageFlow_BringComputer">
        <di:waypoint x="260" y="160" />
        <di:waypoint x="260" y="362" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="270" y="186" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_CostCalculation_di" bpmnElement="MessageFlow_CostCalculation">
        <di:waypoint x="380" y="340" />
        <di:waypoint x="380" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="390" y="186" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_CustomerDecision_di" bpmnElement="MessageFlow_CustomerDecision">
        <di:waypoint x="510" y="160" />
        <di:waypoint x="510" y="355" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="520" y="186" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_TakeHome_di" bpmnElement="MessageFlow_TakeHome">
        <di:waypoint x="510" y="492" />
        <di:waypoint x="510" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="520" y="246" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
