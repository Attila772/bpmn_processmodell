<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- Collaboration defining Pools and Message Flows -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO" />
    <bpmn:participant id="Participant_GO" name="Grid Operator (GO)" processRef="Process_GO" />
    <bpmn:participant id="Participant_MPO" name="Metering Point Operator (MPO)" processRef="Process_MPO" />
    <bpmn:participant id="Participant_SP" name="Supplier (SP)" processRef="Process_SP" />

    <!-- Message Flows -->
    <bpmn:messageFlow id="MsgFlow_Deregistration" name="Deregistration Request" sourceRef="Task_MSPO_Deregister" targetRef="StartEvent_GO_Received" />
    <bpmn:messageFlow id="MsgFlow_Rejection" name="Rejection Notification" sourceRef="Task_GO_Reject" targetRef="Event_MSPO_RejectionReceived" />
    <bpmn:messageFlow id="MsgFlow_InformMSPO" name="End of MSPO / Start of GO Assignment" sourceRef="Task_GO_InformMSPO" targetRef="Event_MSPO_ConfirmationReceived" />
    <bpmn:messageFlow id="MsgFlow_InformMPO" name="GO Assignment Notification" sourceRef="Task_GO_InformMPO" targetRef="Event_MPO_NotificationReceived" />
    <bpmn:messageFlow id="MsgFlow_InformSP" name="GO Assignment Notification" sourceRef="Task_GO_InformSP" targetRef="Event_SP_NotificationReceived" />
  </bpmn:collaboration>

  <!-- Process MSPO -->
  <bpmn:process id="Process_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPO" name="Deregistration Initiated">
      <bpmn:outgoing>Flow_MSPO_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_MSPO_Deregister" name="Deregister at the GO">
      <bpmn:incoming>Flow_MSPO_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MSPO_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="Gateway_MSPO_Wait" name="Wait for Response">
      <bpmn:incoming>Flow_MSPO_2</bpmn:incoming>
      <bpmn:outgoing>Flow_MSPO_ToReject</bpmn:outgoing>
      <bpmn:outgoing>Flow_MSPO_ToConfirm</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_MSPO_RejectionReceived" name="Deregistration Rejected">
      <bpmn:incoming>Flow_MSPO_ToReject</bpmn:incoming>
      <bpmn:outgoing>Flow_MSPO_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_MSPO_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_MSPO_ConfirmationReceived" name="Deregistration Confirmed &#38; End Informed">
      <bpmn:incoming>Flow_MSPO_ToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_MSPO_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_MSPO_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_MSPO_Rejected" name="Deregistration Failed">
      <bpmn:incoming>Flow_MSPO_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_MSPO_Completed" name="Deregistration Completed">
      <bpmn:incoming>Flow_MSPO_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_MSPO_1" sourceRef="StartEvent_MSPO" targetRef="Task_MSPO_Deregister" />
    <bpmn:sequenceFlow id="Flow_MSPO_2" sourceRef="Task_MSPO_Deregister" targetRef="Gateway_MSPO_Wait" />
    <bpmn:sequenceFlow id="Flow_MSPO_ToReject" sourceRef="Gateway_MSPO_Wait" targetRef="Event_MSPO_RejectionReceived" />
    <bpmn:sequenceFlow id="Flow_MSPO_ToConfirm" sourceRef="Gateway_MSPO_Wait" targetRef="Event_MSPO_ConfirmationReceived" />
    <bpmn:sequenceFlow id="Flow_MSPO_3" sourceRef="Event_MSPO_RejectionReceived" targetRef="EndEvent_MSPO_Rejected" />
    <bpmn:sequenceFlow id="Flow_MSPO_4" sourceRef="Event_MSPO_ConfirmationReceived" targetRef="EndEvent_MSPO_Completed" />
  </bpmn:process>

  <!-- Process GO -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO_Received" name="Deregistration Request Received">
      <bpmn:outgoing>Flow_GO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_GO_1" />
    </bpmn:startEvent>
    <bpmn:task id="Task_GO_Verify" name="Verify the Deregistration">
      <bpmn:incoming>Flow_GO_1</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GO_Decision" name="Verification Successful?">
      <bpmn:incoming>Flow_GO_2</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_GO_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_GO_Reject" name="Reject Deregistration of the MSPO">
      <bpmn:incoming>Flow_GO_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_GO_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>Flow_GO_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_GO_PrelimConfirm" name="Preliminarily Confirm Deregistration">
      <bpmn:incoming>Flow_GO_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GO_AssignSelf" name="Assign Himself as MSP">
      <bpmn:incoming>Flow_GO_4</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_GO_Parallel" name="Inform Stakeholders">
      <bpmn:incoming>Flow_GO_5</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_P1</bpmn:outgoing>
      <bpmn:outgoing>Flow_GO_P2</bpmn:outgoing>
      <bpmn:outgoing>Flow_GO_P3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_GO_InformMSPO" name="Inform MSPO about End of Assignment and Beginning of GO Assignment">
      <bpmn:incoming>Flow_GO_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_Join1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GO_InformMPO" name="Inform MPO about Assignment of GO">
      <bpmn:incoming>Flow_GO_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_Join2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GO_InformSP" name="Inform SP about Assignment of GO">
      <bpmn:incoming>Flow_GO_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_Join3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_GO_ParallelJoin">
      <bpmn:incoming>Flow_GO_Join1</bpmn:incoming>
      <bpmn:incoming>Flow_GO_Join2</bpmn:incoming>
      <bpmn:incoming>Flow_GO_Join3</bpmn:incoming>
      <bpmn:outgoing>Flow_GO_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_GO_Completed" name="Assignment Completed">
      <bpmn:incoming>Flow_GO_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_GO_1" sourceRef="StartEvent_GO_Received" targetRef="Task_GO_Verify" />
    <bpmn:sequenceFlow id="Flow_GO_2" sourceRef="Task_GO_Verify" targetRef="Gateway_GO_Decision" />
    <bpmn:sequenceFlow id="Flow_GO_Rejected" name="No" sourceRef="Gateway_GO_Decision" targetRef="Task_GO_Reject" />
    <bpmn:sequenceFlow id="Flow_GO_Approved" name="Yes" sourceRef="Gateway_GO_Decision" targetRef="Task_GO_PrelimConfirm" />
    <bpmn:sequenceFlow id="Flow_GO_3" sourceRef="Task_GO_Reject" targetRef="EndEvent_GO_Rejected" />
    <bpmn:sequenceFlow id="Flow_GO_4" sourceRef="Task_GO_PrelimConfirm" targetRef="Task_GO_AssignSelf" />
    <bpmn:sequenceFlow id="Flow_GO_5" sourceRef="Task_GO_AssignSelf" targetRef="Gateway_GO_Parallel" />
    <bpmn:sequenceFlow id="Flow_GO_P1" sourceRef="Gateway_GO_Parallel" targetRef="Task_GO_InformMSPO" />
    <bpmn:sequenceFlow id="Flow_GO_P2" sourceRef="Gateway_GO_Parallel" targetRef="Task_GO_InformMPO" />
    <bpmn:sequenceFlow id="Flow_GO_P3" sourceRef="Gateway_GO_Parallel" targetRef="Task_GO_InformSP" />
    <bpmn:sequenceFlow id="Flow_GO_Join1" sourceRef="Task_GO_InformMSPO" targetRef="Gateway_GO_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_GO_Join2" sourceRef="Task_GO_InformMPO" targetRef="Gateway_GO_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_GO_Join3" sourceRef="Task_GO_InformSP" targetRef="Gateway_GO_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_GO_6" sourceRef="Gateway_GO_ParallelJoin" targetRef="EndEvent_GO_Completed" />
  </bpmn:process>

  <!-- Process MPO -->
  <bpmn:process id="Process_MPO" isExecutable="false">
    <bpmn:startEvent id="Event_MPO_NotificationReceived" name="GO Assignment Notification Received">
      <bpmn:outgoing>Flow_MPO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_MPO_1" />
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_MPO_Finished" name="Notification Processed">
      <bpmn:incoming>Flow_MPO_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPO_1" sourceRef="Event_MPO_NotificationReceived" targetRef="EndEvent_MPO_Finished" />
  </bpmn:process>

  <!-- Process SP -->
  <bpmn:process id="Process_SP" isExecutable="false">
    <bpmn:startEvent id="Event_SP_NotificationReceived" name="GO Assignment Notification Received">
      <bpmn:outgoing>Flow_SP_1</bpmn:outgoing>
