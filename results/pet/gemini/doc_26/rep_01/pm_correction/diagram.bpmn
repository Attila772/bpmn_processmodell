<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="event_start" name="Deregistration Requested">
      <bpmn:outgoing>seq_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_end_rejected" name="Deregistration Rejected">
      <bpmn:incoming>seq_flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="event_end_confirmed" name="Deregistration Processed">
      <bpmn:incoming>seq_flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_deregister" name="Deregister at GO">
      <bpmn:incoming>seq_flow_1</bpmn:incoming>
      <bpmn:outgoing>seq_flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_verify" name="Verify deregistration">
      <bpmn:incoming>seq_flow_2</bpmn:incoming>
      <bpmn:outgoing>seq_flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_reject" name="Reject deregistration of MSPO">
      <bpmn:incoming>seq_flow_4</bpmn:incoming>
      <bpmn:outgoing>seq_flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_prelim_confirm" name="Preliminarily confirm deregistration of MSPO">
      <bpmn:incoming>seq_flow_6</bpmn:incoming>
      <bpmn:outgoing>seq_flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_assign_self" name="Assign himself as MSP">
      <bpmn:incoming>seq_flow_7</bpmn:incoming>
      <bpmn:outgoing>seq_flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_mspo" name="Inform MSPO about end and beginning of assignment">
      <bpmn:incoming>seq_flow_8</bpmn:incoming>
      <bpmn:outgoing>seq_flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_mpo" name="Inform MPO about assignment of GO">
      <bpmn:incoming>seq_flow_9</bpmn:incoming>
      <bpmn:outgoing>seq_flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_sp" name="Inform SP about assignment of GO">
      <bpmn:incoming>seq_flow_10</bpmn:incoming>
      <bpmn:outgoing>seq_flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_verification_result" name="Deregistration Valid?" isMarkerVisible="true">
      <bpmn:incoming>seq_flow_3</bpmn:incoming>
      <bpmn:outgoing>seq_flow_4</bpmn:outgoing>
      <bpmn:outgoing>seq_flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="seq_flow_1" sourceRef="event_start" targetRef="task_deregister" />
    <bpmn:sequenceFlow id="seq_flow_2" sourceRef="task_deregister" targetRef="task_verify" />
    <bpmn:sequenceFlow id="seq_flow_3" sourceRef="task_verify" targetRef="gateway_verification_result" />
    <bpmn:sequenceFlow id="seq_flow_4" sourceRef="gateway_verification_result" targetRef="task_reject" name="Rejected" />
    <bpmn:sequenceFlow id="seq_flow_5" sourceRef="task_reject" targetRef="event_end_rejected" />
    <bpmn:sequenceFlow id="seq_flow_6" sourceRef="gateway_verification_result" targetRef="task_prelim_confirm" name="Preliminarily Confirmed" />
    <bpmn:sequenceFlow id="seq_flow_7" sourceRef="task_prelim_confirm" targetRef="task_assign_self" />
    <bpmn:sequenceFlow id="seq_flow_8" sourceRef="task_assign_self" targetRef="task_inform_mspo" />
    <bpmn:sequenceFlow id="seq_flow_9" sourceRef="task_inform_mspo" targetRef="task_inform_mpo" />
    <bpmn:sequenceFlow id="seq_flow_10" sourceRef="task_inform_mpo" targetRef="task_inform_sp" />
    <bpmn:sequenceFlow id="seq_flow_11" sourceRef="task_inform_sp" targetRef="event_end_confirmed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_end_confirmed_di" bpmnElement="event_end_confirmed">
        <dc:Bounds x="1870" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_end_rejected_di" bpmnElement="event_end_rejected">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_start_di" bpmnElement="event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_verification_result_di" bpmnElement="gateway_verification_result">
        <dc:Bounds x="730" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assign_self_di" bpmnElement="task_assign_self">
        <dc:Bounds x="1110" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_deregister_di" bpmnElement="task_deregister">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_mpo_di" bpmnElement="task_inform_mpo">
        <dc:Bounds x="1490" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_mspo_di" bpmnElement="task_inform_mspo">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_sp_di" bpmnElement="task_inform_sp">
        <dc:Bounds x="1680" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prelim_confirm_di" bpmnElement="task_prelim_confirm">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_reject_di" bpmnElement="task_reject">
        <dc:Bounds x="920" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_verify_di" bpmnElement="task_verify">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="seq_flow_1_di" bpmnElement="seq_flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_2_di" bpmnElement="seq_flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_3_di" bpmnElement="seq_flow_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_4_di" bpmnElement="seq_flow_4">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_5_di" bpmnElement="seq_flow_5">
        <di:waypoint x="970" y="265" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_6_di" bpmnElement="seq_flow_6">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_7_di" bpmnElement="seq_flow_7">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_8_di" bpmnElement="seq_flow_8">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_9_di" bpmnElement="seq_flow_9">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1540" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_10_di" bpmnElement="seq_flow_10">
        <di:waypoint x="1540" y="140" />
        <di:waypoint x="1730" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_11_di" bpmnElement="seq_flow_11">
        <di:waypoint x="1730" y="140" />
        <di:waypoint x="1888" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>