<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://www.bpmn.org/process"
             exporter="Camunda Modeler"
             exporterVersion="5.0.0">

  <!-- Collaboration definition specifying participants and pools -->
  <collaboration id="Collaboration_1">
    <participant id="Participant_Party" name="Party" />
    <participant id="Participant_Court" name="Court Processing" processRef="Process_MailHandling" />
    <messageFlow id="MessageFlow_1" name="Send Mail" sourceRef="Participant_Party" targetRef="StartEvent_MailReceived" />
    <messageFlow id="MessageFlow_2" name="Requisition List" sourceRef="Task_SendRequisition" targetRef="Participant_Party" />
    <messageFlow id="MessageFlow_3" name="Receipt &#38; Copied Documents" sourceRef="Task_PostReceipt" targetRef="Participant_Party" />
  </collaboration>

  <!-- Main Process definition -->
  <process id="Process_MailHandling" isExecutable="true">
    
    <!-- Lane Set defining organization units and roles -->
    <laneSet id="LaneSet_1">
      <lane id="Lane_MPU" name="Mail Processing Unit (Mail Clerk)">
        <flowNodeRef>StartEvent_MailReceived</flowNodeRef>
        <flowNodeRef>Task_CollectMail</flowNodeRef>
        <flowNodeRef>Task_SortUnopenedMail</flowNodeRef>
        <flowNodeRef>Task_DistributeMail</flowNodeRef>
      </lane>
      <lane id="Lane_Registry" name="Registry (Registry Staff)">
        <flowNodeRef>Task_OpenAndSortMail</flowNodeRef>
        <flowNodeRef>Task_RegisterIncomingMail</flowNodeRef>
      </lane>
      <lane id="Lane_ARM" name="Assistant Registry Manager">
        <flowNodeRef>Task_PerformQualityCheck</flowNodeRef>
        <flowNodeRef>Gateway_ComplianceCheck</flowNodeRef>
        <flowNodeRef>Task_CompileRequisition</flowNodeRef>
        <flowNodeRef>Task_SendRequisition</flowNodeRef>
        <flowNodeRef>EndEvent_Rejected</flowNodeRef>
        <flowNodeRef>Task_CaptureMatterDetails</flowNodeRef>
        <flowNodeRef>Gateway_ForkParallel</flowNodeRef>
        <flowNodeRef>Task_PostReceipt</flowNodeRef>
        <flowNodeRef>Gateway_JoinParallel</flowNodeRef>
        <flowNodeRef>EndEvent_Processed</flowNodeRef>
      </lane>
      <lane id="Lane_Cashier" name="Cashier">
        <flowNodeRef>Task_TakeFees</flowNodeRef>
        <flowNodeRef>Task_CapturePartyDetails</flowNodeRef>
        <flowNodeRef>Task_PrintCourtFile</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Nodes for Mail Processing Unit -->
    <startEvent id="StartEvent_MailReceived" name="Daily Mail Arrived">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    
    <userTask id="Task_CollectMail" name="Collect Daily Mail">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </userTask>

    <userTask id="Task_SortUnopenedMail" name="Sort Unopened Mail into Business Areas">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </userTask>

    <userTask id="Task_DistributeMail" name="Distribute Mail to Registry">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </userTask>

    <!-- Nodes for Registry -->
    <userTask id="Task_OpenAndSortMail" name="Open and Sort Mail into Groups">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
    </userTask>

    <userTask id="Task_RegisterIncomingMail" name="Register Mail in Manual Incoming Mail Register">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </userTask>

    <!-- Nodes for Assistant Registry Manager -->
    <userTask id="Task_PerformQualityCheck" name="Perform Quality Check">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
    </userTask>

    <exclusiveGateway id="Gateway_ComplianceCheck" name="Mail Compliant?">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_NonCompliant</outgoing>
      <outgoing>Flow_Compliant</outgoing>
    </exclusiveGateway>

    <!-- Rejection Path -->
    <userTask id="Task_CompileRequisition" name="Compile Requisition List">
      <incoming>Flow_NonCompliant</incoming>
      <outgoing>Flow_8</outgoing>
    </userTask>

    <sendTask id="Task_SendRequisition" name="Send Requisition List to Party">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
    </sendTask>

    <endEvent id="EndEvent_Rejected" name="Mail Rejected">
      <incoming>Flow_9</incoming>
    </endEvent>

    <!-- Acceptance Path -->
    <userTask id="Task_CaptureMatterDetails" name="Capture Matter Details (Action Types)">
      <incoming>Flow_Compliant</incoming>
      <outgoing>Flow_10</outgoing>
    </userTask>

    <parallelGateway id="Gateway_ForkParallel">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_ToCashier</outgoing>
      <outgoing>Flow_ToCashierParallel</outgoing>
    </parallelGateway>

    <!-- Cashier Tasks -->
    <userTask id="Task_TakeFees" name="Take Applicable Fees Attached">
      <incoming>Flow_ToCashier</incoming>
      <outgoing>Flow_11</outgoing>
    </userTask>

    <userTask id="Task_PostReceipt" name="Post Receipt and Copied Documents in Envelope">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_13</outgoing>
    </userTask>

    <userTask id="Task_CapturePartyDetails" name="Capture Party Details">
      <incoming>Flow_ToCashierParallel</incoming>
      <outgoing>Flow_12</outgoing>
    </userTask>

    <userTask id="Task_PrintCourtFile" name="Print Physical Court File">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_14</outgoing>
    </userTask>

    <!-- Parallel Join and End -->
    <parallelGateway id="Gateway_JoinParallel">
      <incoming>Flow_13</incoming>
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
    </parallelGateway>

    <endEvent id="EndEvent_Processed" name="Mail Processing Completed">
      <incoming>Flow_15</incoming>
    </endEvent>

    <!-- Sequence Flow Connections -->
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_MailReceived" targetRef="Task_CollectMail" />
    <sequenceFlow id="Flow_2" sourceRef="Task_CollectMail" targetRef="Task_SortUnopenedMail" />
    <sequenceFlow id="Flow_3" sourceRef="Task_SortUnopenedMail" targetRef="Task_DistributeMail" />
    <sequenceFlow id="Flow_4" sourceRef="Task_DistributeMail" targetRef="Task_OpenAndSortMail" />
    <sequenceFlow id="Flow_5" sourceRef="Task_OpenAndSortMail" targetRef="Task_RegisterIncomingMail" />
    <sequenceFlow id="Flow_6" sourceRef="Task_RegisterIncomingMail" targetRef="Task_PerformQualityCheck" />
    <sequenceFlow id="Flow_7" sourceRef="Task_PerformQualityCheck" targetRef="Gateway_ComplianceCheck" />
    
    <sequenceFlow id="Flow_NonCompliant" name="No" sourceRef="Gateway_ComplianceCheck" targetRef="Task_CompileRequisition" />
    <sequenceFlow id="Flow_8" sourceRef="Task_CompileRequisition" targetRef="Task_SendRequisition" />
    <sequenceFlow id="Flow_9" sourceRef="Task_SendRequisition" targetRef="EndEvent_Rejected" />

    <sequenceFlow id="Flow_Compliant" name="Yes" sourceRef="Gateway_ComplianceCheck" targetRef="Task_CaptureMatterDetails" />
    <sequenceFlow id="Flow_10" sourceRef="Task_CaptureMatterDetails" targetRef="Gateway_ForkParallel" />
    
    <sequenceFlow id="Flow_ToCashier" sourceRef="Gateway_ForkParallel" targetRef="Task_TakeFees" />
    <sequenceFlow id="Flow_11" sourceRef="Task_TakeFees" targetRef="Task_PostReceipt" />
    
    <sequenceFlow id="Flow_ToCashierParallel" sourceRef="Gateway_ForkParallel" targetRef="Task_CapturePartyDetails" />
    <sequenceFlow id="Flow_12" sourceRef="Task_CapturePartyDetails" targetRef="Task_PrintCourtFile" />
    
    <sequenceFlow id="Flow_13" sourceRef="Task_PostReceipt" targetRef="Gateway_JoinParallel" />
    <sequenceFlow id="Flow_14" sourceRef="Task_PrintCourtFile" targetRef="Gateway_JoinParallel" />
    <sequenceFlow id="Flow_15" sourceRef="Gateway_JoinParallel" targetRef="EndEvent_Processed" />

  </process>

