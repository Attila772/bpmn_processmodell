        <dc:Bounds x="600" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_IsCompliant_di" bpmnElement="Gateway_IsCompliant" isMarkerVisible="true">
        <dc:Bounds x="745" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="741" y="535" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Requisition_di" bpmnElement="Task_Requisition">
        <dc:Bounds x="840" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="982" y="572" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="961" y="615" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CaptureMatterDetails_di" bpmnElement="Task_CaptureMatterDetails">
        <dc:Bounds x="840" y="630" width="100" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_TakeFees_di" bpmnElement="Task_TakeFees">
        <dc:Bounds x="840" y="750" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ParallelSplit_di" bpmnElement="Gateway_ParallelSplit">
        <dc:Bounds x="1005" y="765" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PostReceipt_di" bpmnElement="Task_PostReceipt">
        <dc:Bounds x="1110" y="550" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CapturePartyDetails_di" bpmnElement="Task_CapturePartyDetails">
        <dc:Bounds x="1110" y="750" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PrintCourtFile_di" bpmnElement="Task_PrintCourtFile">
        <dc:Bounds x="1260" y="750" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ParallelJoin_di" bpmnElement="Gateway_ParallelJoin">
        <dc:Bounds x="1425" y="765" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1532" y="772" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1511" y="815" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Flow Edges -->
      <bpmndi:BPMNEdge id="SequenceFlow_1_di" bpmnElement="SequenceFlow_1">
        <di:waypoint x="278" y="290" />
        <di:waypoint x="320" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_2_di" bpmnElement="SequenceFlow_2">
        <di:waypoint x="420" y="290" />
        <di:waypoint x="460" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_3_di" bpmnElement="SequenceFlow_3">
        <di:waypoint x="560" y="290" />
        <di:waypoint x="600" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_4_di" bpmnElement="SequenceFlow_4">
        <di:waypoint x="650" y="330" />
        <di:waypoint x="650" y="395" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_5_di" bpmnElement="SequenceFlow_5">
        <di:waypoint x="650" y="475" />
        <di:waypoint x="650" y="550" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_6_di" bpmnElement="SequenceFlow_6">
        <di:waypoint x="700" y="590" />
        <di:waypoint x="745" y="590" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_NonCompliant_di" bpmnElement="SequenceFlow_NonCompliant">
        <di:waypoint x="795" y="590" />
        <di:waypoint x="840" y="590" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="808" y="572" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_Compliant_di" bpmnElement="SequenceFlow_Compliant">
        <di:waypoint x="770" y="615" />
        <di:waypoint x="770" y="665" />
        <di:waypoint x="840" y="665" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="776" y="637" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_7_di" bpmnElement="SequenceFlow_7">
        <di:waypoint x="940" y="590" />
        <di:waypoint x="982" y="590" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_8_di" bpmnElement="SequenceFlow_8">
        <di:waypoint x="890" y="700" />
        <di:waypoint x="890" y="750" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_9_di" bpmnElement="SequenceFlow_9">
        <di:waypoint x="940" y="790" />
        <di:waypoint x="1005" y="790" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ToPost_di" bpmnElement="SequenceFlow_ToPost">
        <di:waypoint x="1030" y="765" />
        <di:waypoint x="1030" y="590" />
        <di:waypoint x="1110" y="590" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ToCashierParallel_di" bpmnElement="SequenceFlow_ToCashierParallel">
        <di:waypoint x="1055" y="790" />
        <di:waypoint x="1110" y="790" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_10_di" bpmnElement="SequenceFlow_10">
        <di:waypoint x="1210" y="790" />
        <di:waypoint x="1260" y="790" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_FromPost_di" bpmnElement="SequenceFlow_FromPost">
        <di:waypoint x="1230" y="590" />
        <di:waypoint x="1450" y="590" />
        <di:waypoint x="1450" y="765" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_FromPrint_di" bpmnElement="SequenceFlow_FromPrint">
        <di:waypoint x="1360" y="790" />
        <di:waypoint x="1425" y="790" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_11_di" bpmnElement="SequenceFlow_11">
        <di:waypoint x="1475" y="790" />
        <di:waypoint x="1532" y="790" />
      </bpmndi:BPMNEdge>

      <!-- Message Flow Edges -->
      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="260" y="180" />
        <di:waypoint x="260" y="272" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="266" y="203" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <di:waypoint x="890" y="550" />
        <di:waypoint x="890" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="896" y="203" width="77" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_3_di" bpmnElement="MessageFlow_3">
        <di:waypoint x="1170" y="550" />
