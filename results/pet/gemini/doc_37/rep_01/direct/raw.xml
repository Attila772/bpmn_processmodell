<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- Collaboration definition with Pools and Lanes -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Party" name="Party" processRef="Process_Party" />
    <bpmn:participant id="Participant_Court" name="Court Administrative System" processRef="Process_Court" />
    <bpmn:messageFlow id="MessageFlow_1" name="Daily Mail" sourceRef="Participant_Party" targetRef="StartEvent_1" />
    <bpmn:messageFlow id="MessageFlow_2" name="Requisition List / Rejected Mail" sourceRef="Task_Requisition" targetRef="Participant_Party" />
    <bpmn:messageFlow id="MessageFlow_3" name="Receipt and Copied Documents" sourceRef="Task_PostReceipt" targetRef="Participant_Party" />
  </bpmn:collaboration>

  <!-- Empty Process for External Party -->
  <bpmn:process id="Process_Party" isExecutable="false" />

  <!-- Main Court Process -->
  <bpmn:process id="Process_Court" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MPU" name="Mail Processing Unit">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortUnopened</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeMail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Registry" name="Registry (Mail Clerk)">
        <bpmn:flowNodeRef>Task_OpenSortRegister</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ARM" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>Task_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsCompliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Requisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptureMatterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cashier" name="Cashier">
        <bpmn:flowNodeRef>Task_TakeFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapturePartyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintCourtFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Nodes & Flow elements -->
    <bpmn:startEvent id="StartEvent_1" name="Daily Mail Received">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:userTask id="Task_CollectMail" name="Collect Mail on Daily Basis">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SortUnopened" name="Sort Unopened Mail into Business Areas">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_DistributeMail" name="Distribute Mail to Registry">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="Task_OpenSortRegister" name="Open, Sort and Register Mail in Incoming Mail Register">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_QualityCheck" name="Perform Quality Check">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_IsCompliant" name="Is Mail Compliant?">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NonCompliant</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Compliant</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Requisition" name="Compile Requisition List &amp; Send Back to Party">
      <bpmn:incoming>SequenceFlow_NonCompliant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="Mail Processing Rejected">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_CaptureMatterDetails" name="Capture Matter Details (Types of Action)">
      <bpmn:incoming>SequenceFlow_Compliant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TakeFees" name="Take Applicable Fees Attached to Mail">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gateway_ParallelSplit">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPost</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToCashierParallel</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_PostReceipt" name="Envelope and Post Receipt &amp; Copied Documents to Party">
      <bpmn:incoming>SequenceFlow_ToPost</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FromPost</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CapturePartyDetails" name="Capture Party Details">
      <bpmn:incoming>SequenceFlow_ToCashierParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PrintCourtFile" name="Print Physical Court File">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FromPrint</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gateway_ParallelJoin">
      <bpmn:incoming>SequenceFlow_FromPost</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FromPrint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="EndEvent_Approved" name="Mail Processing Completed">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CollectMail" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_CollectMail" targetRef="Task_SortUnopened" />
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_SortUnopened" targetRef="Task_DistributeMail" />
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_DistributeMail" targetRef="Task_OpenSortRegister" />
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_OpenSortRegister" targetRef="Task_QualityCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_QualityCheck" targetRef="Gateway_IsCompliant" />
    <bpmn:sequenceFlow id="SequenceFlow_NonCompliant" name="No" sourceRef="Gateway_IsCompliant" targetRef="Task_Requisition" />
    <bpmn:sequenceFlow id="SequenceFlow_Compliant" name="Yes" sourceRef="Gateway_IsCompliant" targetRef="Task_CaptureMatterDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_Requisition" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_CaptureMatterDetails" targetRef="Task_TakeFees" />
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_TakeFees" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="SequenceFlow_ToPost" sourceRef="Gateway_ParallelSplit" targetRef="Task_PostReceipt" />
    <bpmn:sequenceFlow id="SequenceFlow_ToCashierParallel" sourceRef="Gateway_ParallelSplit" targetRef="Task_CapturePartyDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_CapturePartyDetails" targetRef="Task_PrintCourtFile" />
    <bpmn:sequenceFlow id="SequenceFlow_FromPost" sourceRef="Task_PostReceipt" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="SequenceFlow_FromPrint" sourceRef="Task_PrintCourtFile" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_ParallelJoin" targetRef="EndEvent_Approved" />
  </bpmn:process>

  <!-- BPMN Diagram Layout -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Party_di" bpmnElement="Participant_Party" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1680" height="100" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Participant_Court_di" bpmnElement="Participant_Court" isHorizontal="true">
        <dc:Bounds x="160" y="220" width="1680" height="660" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_MPU_di" bpmnElement="Lane_MPU" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="1650" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Registry_di" bpmnElement="Lane_Registry" isHorizontal="true">
        <dc:Bounds x="190" y="370" width="1650" height="130" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_ARM_di" bpmnElement="Lane_ARM" isHorizontal="true">
