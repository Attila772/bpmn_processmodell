<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- Collaboration definitions for Pool and Black-box Pools -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPO" name="Metering Point Operator (MPO)" processRef="Process_MPO" />
    <bpmn:participant id="Participant_FaultDetector" name="Fault Detector" />
    <bpmn:participant id="Participant_GO" name="Grid Operator (GO)" />
    <bpmn:participant id="Participant_MSP" name="Meter Service Provider (MSP)" />
    
    <bpmn:messageFlow id="MF_ReportFault" name="Report Fault" sourceRef="Participant_FaultDetector" targetRef="StartEvent_FaultReported" />
    <bpmn:messageFlow id="MF_InformGO_Confirmation" name="Inform Fault Confirmation" sourceRef="Task_InformGO_Confirmation" targetRef="Participant_GO" />
    <bpmn:messageFlow id="MF_InformMSP_Confirmation" name="Inform Fault Confirmation" sourceRef="Task_InformMSP_Confirmation" targetRef="Participant_MSP" />
    <bpmn:messageFlow id="MF_ShareRepairResults" name="Share Repair Results" sourceRef="Task_ShareRepairResults" targetRef="Participant_FaultDetector" />
    <bpmn:messageFlow id="MF_InformGO_Resolution" name="Inform Resolution" sourceRef="Task_InformGO_Resolution" targetRef="Participant_GO" />
    <bpmn:messageFlow id="MF_InformMSP_Resolution" name="Inform Resolution" sourceRef="Task_InformMSP_Resolution" targetRef="Participant_MSP" />
  </bpmn:collaboration>

  <!-- MPO Process -->
  <bpmn:process id="Process_MPO" isExecutable="true">
    <bpmn:startEvent id="StartEvent_FaultReported" name="Failure reported by Fault Detector">
      <bpmn:outgoing">Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_OwnSuspicion" name="Own suspicion of fault">
      <bpmn:outgoing">Flow_2</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_MergeStart" name="Trigger Source">
      <bpmn:incoming">Flow_1</bpmn:incoming>
      <bpmn:incoming">Flow_2</bpmn:incoming>
      <bpmn:outgoing">Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ExamineFailure" name="Examine failure">
      <bpmn:incoming">Flow_3</bpmn:incoming>
      <bpmn:outgoing">Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_FailureConfirmed" name="Failure confirmed?">
      <bpmn:incoming">Flow_4</bpmn:incoming>
      <bpmn:outgoing">Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing">Flow_Confirmed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_RejectFailure" name="Reject failure">
      <bpmn:incoming">Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing">Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_FailureRejected" name="Failure rejected">
      <bpmn:incoming">Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="Gateway_ForkInformConfirmation">
      <bpmn:incoming">Flow_Confirmed</bpmn:incoming>
      <bpmn:outgoing">Flow_ToInformGO</bpmn:outgoing>
      <bpmn:outgoing">Flow_ToInformMSP</bpmn:outgoing>
      <bpmn:outgoing">Flow_ToFixFault</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="Task_InformGO_Confirmation" name="Inform GO about confirmed failure">
      <bpmn:incoming">Flow_ToInformGO</bpmn:incoming>
      <bpmn:outgoing">Flow_6</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_InformMSP_Confirmation" name="Inform MSP about confirmed failure">
      <bpmn:incoming">Flow_ToInformMSP</bpmn:incoming>
      <bpmn:outgoing">Flow_7</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:task id="Task_FixFault" name="Fix fault at measuring device">
      <bpmn:incoming">Flow_ToFixFault</bpmn:incoming>
      <bpmn:outgoing">Flow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_JoinConfirmationAndFix">
      <bpmn:incoming">Flow_6</bpmn:incoming>
      <bpmn:incoming">Flow_7</bpmn:incoming>
      <bpmn:incoming">Flow_8</bpmn:incoming>
      <bpmn:outgoing">Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:parallelGateway id="Gateway_ForkResolution">
      <bpmn:incoming">Flow_9</bpmn:incoming>
      <bpmn:outgoing">Flow_ToShareResults</bpmn:outgoing>
      <bpmn:outgoing">Flow_ToInformGOResolution</bpmn:outgoing>
      <bpmn:outgoing">Flow_ToInformMSPResolution</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="Task_ShareRepairResults" name="Share repair results with Fault Detector">
      <bpmn:incoming">Flow_ToShareResults</bpmn:incoming>
      <bpmn:outgoing">Flow_10</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_InformGO_Resolution" name="Inform GO about resolution">
      <bpmn:incoming">Flow_ToInformGOResolution</bpmn:incoming>
      <bpmn:outgoing">Flow_11</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_InformMSP_Resolution" name="Inform MSP about resolution">
      <bpmn:incoming">Flow_ToInformMSPResolution</bpmn:incoming>
      <bpmn:outgoing">Flow_12</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:parallelGateway id="Gateway_JoinResolution">
      <bpmn:incoming">Flow_10</bpmn:incoming>
      <bpmn:incoming">Flow_11</bpmn:incoming>
      <bpmn:incoming">Flow_12</bpmn:incoming>
      <bpmn:outgoing">Flow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="EndEvent_FaultResolved" name="Interference resolved and communicated">
      <bpmn:incoming">Flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_FaultReported" targetRef="Gateway_MergeStart" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="StartEvent_OwnSuspicion" targetRef="Gateway_MergeStart" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_MergeStart" targetRef="Task_ExamineFailure" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ExamineFailure" targetRef="Gateway_FailureConfirmed" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="No (Reject)" sourceRef="Gateway_FailureConfirmed" targetRef="Task_RejectFailure" />
    <bpmn:sequenceFlow id="Flow_Confirmed" name="Yes (Confirm)" sourceRef="Gateway_FailureConfirmed" targetRef="Gateway_ForkInformConfirmation" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RejectFailure" targetRef="EndEvent_FailureRejected" />
    <bpmn:sequenceFlow id="Flow_ToInformGO" sourceRef="Gateway_ForkInformConfirmation" targetRef="Task_InformGO_Confirmation" />
    <bpmn:sequenceFlow id="Flow_ToInformMSP" sourceRef="Gateway_ForkInformConfirmation" targetRef="Task_InformMSP_Confirmation" />
    <bpmn:sequenceFlow id="Flow_ToFixFault" sourceRef="Gateway_ForkInformConfirmation" targetRef="Task_FixFault" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_InformGO_Confirmation" targetRef="Gateway_JoinConfirmationAndFix" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_InformMSP_Confirmation" targetRef="Gateway_JoinConfirmationAndFix" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_FixFault" targetRef="Gateway_JoinConfirmationAndFix" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_JoinConfirmationAndFix" targetRef="Gateway_ForkResolution" />
    <bpmn:sequenceFlow id="Flow_ToShareResults" sourceRef="Gateway_ForkResolution" targetRef="Task_ShareRepairResults" />
    <bpmn:sequenceFlow id="Flow_ToInformGOResolution" sourceRef="Gateway_ForkResolution" targetRef="Task_InformGO_Resolution" />
    <bpmn:sequenceFlow id="Flow_ToInformMSPResolution" sourceRef="Gateway_ForkResolution" targetRef="Task_InformMSP_Resolution" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ShareRepairResults" targetRef="Gateway_JoinResolution" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_InformGO_Resolution" targetRef="Gateway_JoinResolution" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_InformMSP_Resolution" targetRef="Gateway_JoinResolution" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_JoinResolution" targetRef="EndEvent_FaultResolved" />
  </bpmn:process>

