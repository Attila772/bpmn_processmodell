    <bpmn:startEvent id="Start_ReportReceived" name="Failure Reported by Fault Detector">
      <bpmn:outgoing>Flow_StartReport_To_Merge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_OwnSuspicion" name="Suspicion of Own Fault">
      <bpmn:outgoing>Flow_StartSuspicion_To_Merge</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_StartMerge">
      <bpmn:incoming>Flow_StartReport_To_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_StartSuspicion_To_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_To_Examine</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ExamineFailure" name="Examine Failure">
      <bpmn:incoming>Flow_Merge_To_Examine</bpmn:incoming>
      <bpmn:outgoing>Flow_Examine_To_Decision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_FailureConfirmed" name="Failure Confirmed?">
      <bpmn:incoming>Flow_Examine_To_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_To_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_To_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_RejectFailure" name="Reject Failure">
      <bpmn:incoming>Flow_Decision_To_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_To_End</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_Rejected" name="Failure Rejected">
      <bpmn:incoming>Flow_Reject_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="Gateway_InformParallel">
