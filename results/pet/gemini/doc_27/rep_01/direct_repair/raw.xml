      <bpmn:outgoing>Flow_Parallel_To_InformGO</bpmn:outgoing>
      <bpmn:outgoing>Flow_Parallel_To_InformMSP</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="Task_InformGO" name="Inform GO of Failure">
      <bpmn:incoming>Flow_Parallel_To_InformGO</bpmn:incoming>
      <bpmn:outgoing>Flow_InformGO_To_InformMerge</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_InformMSP" name="Inform MSP of Failure">
      <bpmn:incoming>Flow_Parallel_To_InformMSP</bpmn:incoming>
      <bpmn:outgoing>Flow_InformMSP_To_InformMerge</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:parallelGateway id="Gateway_InformMerge">
