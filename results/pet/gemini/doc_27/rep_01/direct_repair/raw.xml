        <bpmn:flowNodeRef>Gateway_FailureConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformGO</bpmn:flowNodeRef>
