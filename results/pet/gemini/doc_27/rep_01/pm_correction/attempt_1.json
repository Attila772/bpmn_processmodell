      "target_id": "gw_entry_mpo",
      "condition_name": null
    },
    {
      "id": "flow_mpo_3",
      "source_id": "gw_entry_mpo",
      "target_id": "task_examine_failure",
      "condition_name": null
    },
    {
      "id": "flow_mpo_4",
