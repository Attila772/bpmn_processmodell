    },
    {
      "id": "flow_conf",
      "source_id": "gw_decision_mpo",
      "target_id": "gw_parallel_inform",
      "condition_name": "Failure confirmed"
    },
    {
      "id": "flow_p1",
      "source_id": "gw_parallel_inform",
      "target_id": "event_msg_send_conf_go",
      "condition_name": null
    },
    {
      "id": "flow_p2",
      "source_id": "gw_parallel_inform",
      "target_id": "event_msg_send_conf_msp",
