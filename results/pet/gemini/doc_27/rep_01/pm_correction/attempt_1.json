{
  "name": "Fault Detection and Resolution Process",
  "resources": [
    {
      "name": "Fault Detector",
      "capacity": 1,
      "resource_type": "external_party"
    },
    {
      "name": "MPO",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "GO",
      "capacity": 1,
      "resource_type": "external_party"
    },
    {
      "name": "MSP",
      "capacity": 1,
      "resource_type": "external_party"
    }
  ],
  "events": [
    {
      "id": "event_start_fd",
      "name": "Fault reported by Fault Detector",
      "event_position": "start",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "event_start_mpo",
      "name": "MPO suspicion of own fault",
      "event_position": "start",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "event_msg_send_report",
      "name": "Send fault report to MPO",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Failure Report"
    },
    {
      "id": "event_msg_receive_report",
      "name": "Receive failure report from Fault Detector",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Failure Report"
    },
    {
      "id": "event_msg_send_conf_go",
      "name": "Send confirmation to GO",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Failure Confirmation"
    },
    {
      "id": "event_msg_receive_conf_go",
      "name": "Receive confirmation from MPO",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Failure Confirmation"
    },
    {
      "id": "event_msg_send_conf_msp",
      "name": "Send confirmation to MSP",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Failure Confirmation"
    },
    {
      "id": "event_msg_receive_conf_msp",
      "name": "Receive confirmation from MPO",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Failure Confirmation"
    },
    {
      "id": "event_msg_send_repair_fd",
      "name": "Share repair results with Fault Detector",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Repair Results"
    },
    {
      "id": "event_msg_receive_repair_fd",
      "name": "Receive repair results from MPO",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Repair Results"
    },
    {
      "id": "event_msg_send_res_go",
      "name": "Inform GO of interference resolution",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Interference Resolution Notice"
    },
    {
      "id": "event_msg_receive_res_go",
      "name": "Receive resolution notice from MPO",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Interference Resolution Notice"
    },
    {
      "id": "event_msg_send_res_msp",
      "name": "Inform MSP of interference resolution",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Interference Resolution Notice"
    },
    {
      "id": "event_msg_receive_res_msp",
      "name": "Receive resolution notice from MPO",
      "event_position": "end",
      "trigger_type": "message",
      "message_name": "Interference Resolution Notice"
    },
    {
      "id": "event_end_mpo_rejected",
      "name": "Failure Rejected",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "event_end_go_conf",
      "name": "GO notified of confirmed failure",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "event_end_msp_conf",
      "name": "MSP notified of confirmed failure",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    }
  ],
  "tasks": [
    {
      "id": "task_report_failure",
      "name": "Report failure",
      "bpmn_type": "bpmn:Task",
      "resource_name": "Fault Detector",
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [],
      "output_data_ids": [
        "doc_failure_report"
      ]
    },
    {
      "id": "task_examine_failure",
      "name": "Examine the failure",
      "bpmn_type": "bpmn:UserTask",
      "resource_name": "MPO",
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [
        "doc_failure_report"
      ],
      "output_data_ids": []
    },
    {
      "id": "task_fix_fault",
      "name": "Fix fault at measuring device",
      "bpmn_type": "bpmn:ManualTask",
      "resource_name": "MPO",
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [
        "store_measuring_device"
      ],
      "output_data_ids": [
        "store_measuring_device",
        "doc_repair_results"
      ]
    }
  ],
  "gateways": [
    {
      "id": "gw_entry_mpo",
      "name": "Failure Trigger Gateway",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": null
    },
    {
      "id": "gw_decision_mpo",
      "name": "Failure Confirmed?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_rej",
          "condition": "Failure rejected"
        },
        {
          "flow_id": "flow_conf",
          "condition": "Failure confirmed"
        }
      ]
    },
    {
      "id": "gw_parallel_inform",
      "name": "Inform GO and MSP Parallel Gateway",
      "gateway_type": "parallel",
      "branch_probabilities": null,
      "branch_conditions": null
    }
  ],
  "sequence_flows": [
    {
      "id": "flow_fd_1",
      "source_id": "event_start_fd",
      "target_id": "task_report_failure",
      "condition_name": null
    },
    {
      "id": "flow_fd_2",
      "source_id": "task_report_failure",
