<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn">

  <!-- Collaboration definition -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON" />
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO" />
    <bpmn:messageFlow id="MessageFlow_1" name="Device Takeover Bid Request" sourceRef="Task_MPON_RequestBid" targetRef="StartEvent_MPOO_ReceiveRequest" />
    <bpmn:messageFlow id="MessageFlow_2" name="Equipment Takeover Tender" sourceRef="Task_MPOO_SendTender" targetRef="Task_MPON_ReceiveTender" />
    <bpmn:messageFlow id="MessageFlow_3" name="Order" sourceRef="Task_MPON_PlaceOrder" targetRef="Task_MPOO_ReceiveOrder" />
    <bpmn:messageFlow id="MessageFlow_4" name="Order Confirmation &amp; Master Data" sourceRef="Task_MPOO_ConfirmOrder" targetRef="Task_MPON_ReceiveConfirmation" />
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON" name="Device Takeover Needed">
      <bpmn:outgoing>Flow_MPON_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_MPON_RequestBid" name="Request Device Takeover Bid">
      <bpmn:incoming>Flow_MPON_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Task_MPON_ReceiveTender" name="Receive Equipment Takeover Tender">
      <bpmn:incoming>Flow_MPON_2</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_3</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:sendTask id="Task_MPON_PlaceOrder" name="Place Order">
      <bpmn:incoming>Flow_MPON_3</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_4</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Task_MPON_ReceiveConfirmation" name="Receive Order Confirmation &amp; Master Data">
      <bpmn:incoming>Flow_MPON_4</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_5</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:endEvent id="EndEvent_MPON" name="Takeover Process Completed">
      <bpmn:incoming>Flow_MPON_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_MPON_RequestBid" />
    <bpmn:sequenceFlow id="Flow_MPON_2" sourceRef="Task_MPON_RequestBid" targetRef="Task_MPON_ReceiveTender" />
    <bpmn:sequenceFlow id="Flow_MPON_3" sourceRef="Task_MPON_ReceiveTender" targetRef="Task_MPON_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_MPON_4" sourceRef="Task_MPON_PlaceOrder" targetRef="Task_MPON_ReceiveConfirmation" />
    <bpmn:sequenceFlow id="Flow_MPON_5" sourceRef="Task_MPON_ReceiveConfirmation" targetRef="EndEvent_MPON" />
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO_ReceiveRequest" name="Bid Request Received">
      <bpmn:outgoing>Flow_MPOO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_MPOO_SendTender" name="Send Equipment Takeover Tender">
      <bpmn:incoming>Flow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Task_MPOO_ReceiveOrder" name="Receive Order">
      <bpmn:incoming>Flow_MPOO_2</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_3</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:sendTask id="Task_MPOO_ConfirmOrder" name="Confirm Order &amp; Send Master Data">
      <bpmn:incoming>Flow_MPOO_3</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_4</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_MPOO" name="Takeover Order Fulfilled">
      <bpmn:incoming>Flow_MPOO_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_MPOO_1" sourceRef="StartEvent_MPOO_ReceiveRequest" targetRef="Task_MPOO_SendTender" />
    <bpmn:sequenceFlow id="Flow_MPOO_2" sourceRef="Task_MPOO_SendTender" targetRef="Task_MPOO_ReceiveOrder" />
    <bpmn:sequenceFlow id="Flow_MPOO_3" sourceRef="Task_MPOO_ReceiveOrder" targetRef="Task_MPOO_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_MPOO_4" sourceRef="Task_MPOO_ConfirmOrder" targetRef="EndEvent_MPOO" />
  </bpmn:process>

  <!-- Diagram Interchange -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      
      <!-- MPON Pool -->
      <bpmndi:BPMNShape id="Participant_MPON_di" bpmnElement="Participant_MPON" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="880" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MPON_di" bpmnElement="StartEvent_MPON">
        <dc:Bounds x="212" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="188" y="195" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_RequestBid_di" bpmnElement="Task_MPON_RequestBid">
        <dc:Bounds x="290" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_ReceiveTender_di" bpmnElement="Task_MPON_ReceiveTender">
        <dc:Bounds x="440" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_PlaceOrder_di" bpmnElement="Task_MPON_PlaceOrder">
        <dc:Bounds x="590" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_ReceiveConfirmation_di" bpmnElement="Task_MPON_ReceiveConfirmation">
        <dc:Bounds x="740" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MPON_di" bpmnElement="EndEvent_MPON">
        <dc:Bounds x="892" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="866" y="195" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_MPON_1_di" bpmnElement="Flow_MPON_1">
        <di:waypoint x="248" y="170" />
        <di:waypoint x="290" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPON_2_di" bpmnElement="Flow_MPON_2">
        <di:waypoint x="390" y="170" />
        <di:waypoint x="440" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPON_3_di" bpmnElement="Flow_MPON_3">
        <di:waypoint x="540" y="170" />
        <di:waypoint x="590" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPON_4_di" bpmnElement="Flow_MPON_4">
        <di:waypoint x="690" y="170" />
        <di:waypoint x="740" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPON_5_di" bpmnElement="Flow_MPON_5">
        <di:waypoint x="840" y="170" />
        <di:waypoint x="892" y="170" />
      </bpmndi:BPMNEdge>

      <!-- MPOO Pool -->
      <bpmndi:BPMNShape id="Participant_MPOO_di" bpmnElement="Participant_MPOO" isHorizontal="true">
        <dc:Bounds x="160" y="320" width="880" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_MPOO_ReceiveRequest_di" bpmnElement="StartEvent_MPOO_ReceiveRequest">
        <dc:Bounds x="322" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="308" y="435" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPOO_SendTender_di" bpmnElement="Task_MPOO_SendTender">
        <dc:Bounds x="440" y="370" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPOO_ReceiveOrder_di" bpmnElement="Task_MPOO_ReceiveOrder">
        <dc:Bounds x="590" y="370" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPOO_ConfirmOrder_di" bpmnElement="Task_MPOO_ConfirmOrder">
        <dc:Bounds x="740" y="370" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_MPOO_di" bpmnElement="EndEvent_MPOO">
        <dc:Bounds x="892" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="872" y="435" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_MPOO_1_di" bpmnElement="Flow_MPOO_1">
        <di:waypoint x="358" y="410" />
        <di:waypoint x="440" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_2_di" bpmnElement="Flow_MPOO_2">
        <di:waypoint x="540" y="410" />
        <di:waypoint x="590" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_3_di" bpmnElement="Flow_MPOO_3">
        <di:waypoint x="690" y="410" />
        <di:waypoint x="740" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MPOO_4_di" bpmnElement="Flow_MPOO_4">
        <di:waypoint x="840" y="410" />
        <di:waypoint x="892" y="410" />
      </bpmndi:BPMNEdge>

      <!-- Message Flows -->
      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="340" y="210" />
        <di:waypoint x="340" y="392" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="250" y="286" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <di:waypoint x="490" y="370" />
        <di:waypoint x="490" y="210" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="500" y="286" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_3_di" bpmnElement="MessageFlow_3">
        <di:waypoint x="640" y="210" />
        <di:waypoint x="640" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="645" y="288" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_4_di" bpmnElement="MessageFlow_4">
        <di:waypoint x="790" y="370" />
        <di:waypoint x="790" y="210" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="280" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
