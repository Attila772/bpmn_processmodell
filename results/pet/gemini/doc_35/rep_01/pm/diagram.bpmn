    <bpmn:dataObject id="do4_p1_do" />
    <bpmn:dataObjectReference id="do5_p1" name="Master Data" dataObjectRef="do5_p1_do" />
    <bpmn:dataObject id="do5_p1_do" />
    <bpmn:startEvent id="e1" name="Need for device takeover">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Takeover request sent">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:messageEventDefinition id="e2_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="e5" name="Tender received">
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e5_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="e6" name="Order sent">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:messageEventDefinition id="e6_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="e9" name="Confirmation and master data received">
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e9_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="e10" name="Device takeover completed">
      <bpmn:incoming>sf10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t1" name="Request device takeover bid">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>do1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t3" name="Place order">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:property id="t3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t3_dia0">
        <bpmn:sourceRef>do2_p1</bpmn:sourceRef>
        <bpmn:targetRef>t3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t3_doa0">
        <bpmn:targetRef>do3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t5" name="Process order confirmation and master data">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:property id="t5_prop" name="__targetRef_placeholder" />
