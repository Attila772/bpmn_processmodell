  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="p1_part" name="MPON" processRef="p1_proc" />
    <bpmn:participant id="p2_part" name="MPOO" processRef="p2_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="e2" targetRef="e3" name="Device takeover bid request" />
    <bpmn:messageFlow id="mf2" sourceRef="e4" targetRef="e5" name="Equipment takeover tender" />
    <bpmn:messageFlow id="mf3" sourceRef="e6" targetRef="e7" name="Device order" />
    <bpmn:messageFlow id="mf4" sourceRef="e8" targetRef="e9" name="Order confirmation and master data" />
  </bpmn:collaboration>
  <bpmn:process id="p1_proc" isExecutable="false">
    <bpmn:dataObjectReference id="do1" name="Device Takeover Request Bid" dataObjectRef="do1_do" />
    <bpmn:dataObject id="do1_do" />
    <bpmn:dataObjectReference id="do2_p1" name="Tender for Equipment Takeover" dataObjectRef="do2_p1_do" />
    <bpmn:dataObject id="do2_p1_do" />
    <bpmn:dataObjectReference id="do3" name="Order" dataObjectRef="do3_do" />
    <bpmn:dataObject id="do3_do" />
