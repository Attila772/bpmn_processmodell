      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_mpoo_2_doa1">
        <bpmn:targetRef>doc_master_data</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_mpoo_1" sourceRef="event_rec_req" targetRef="task_mpoo_1" />
    <bpmn:sequenceFlow id="flow_mpoo_2" sourceRef="task_mpoo_1" targetRef="event_send_tender" />
    <bpmn:sequenceFlow id="flow_mpoo_3" sourceRef="event_rec_order" targetRef="task_mpoo_2" />
    <bpmn:sequenceFlow id="flow_mpoo_4" sourceRef="task_mpoo_2" targetRef="event_send_confirm" />
