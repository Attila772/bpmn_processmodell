  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:messageFlow id="msg_flow_1" sourceRef="event_send_req" targetRef="event_rec_req" name="Device takeover bid request" />
    <bpmn:messageFlow id="msg_flow_2" sourceRef="event_send_tender" targetRef="event_rec_tender" name="Equipment takeover tender" />
    <bpmn:messageFlow id="msg_flow_3" sourceRef="event_send_order" targetRef="event_rec_order" name="Equipment takeover order" />
    <bpmn:messageFlow id="msg_flow_4" sourceRef="event_send_confirm" targetRef="event_rec_confirm" name="Order confirmation and master data" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_req" name="Device Takeover Bid Request" dataObjectRef="doc_req_do" />
    <bpmn:dataObject id="doc_req_do" />
    <bpmn:dataObjectReference id="doc_tender_p1" name="Equipment Takeover Tender" dataObjectRef="doc_tender_p1_do" />
    <bpmn:dataObject id="doc_tender_p1_do" />
    <bpmn:dataObjectReference id="doc_order" name="Equipment Takeover Order" dataObjectRef="doc_order_do" />
    <bpmn:dataObject id="doc_order_do" />
    <bpmn:startEvent id="event_start_mpon" name="Device takeover needed">
      <bpmn:outgoing>flow_mpon_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="event_send_req" name="Request sent">
      <bpmn:incoming>flow_mpon_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_req_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="event_rec_tender" name="Tender received">
      <bpmn:outgoing>flow_mpon_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_rec_tender_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="event_send_order" name="Order sent">
      <bpmn:incoming>flow_mpon_4</bpmn:incoming>
      <bpmn:messageEventDefinition id="event_send_order_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="event_rec_confirm" name="Confirmation and master data received">
      <bpmn:incoming>flow_mpon_5</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="event_rec_confirm_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="task_mpon_1" name="Request device takeover bid">
      <bpmn:incoming>flow_mpon_1</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mpon_1_doa0">
        <bpmn:targetRef>doc_req</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_mpon_2" name="Place order">
      <bpmn:incoming>flow_mpon_3</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_4</bpmn:outgoing>
      <bpmn:property id="task_mpon_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_mpon_2_dia0">
        <bpmn:sourceRef>doc_tender_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_mpon_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_mpon_2_doa0">
        <bpmn:targetRef>doc_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_mpon_1" sourceRef="event_start_mpon" targetRef="task_mpon_1" />
    <bpmn:sequenceFlow id="flow_mpon_2" sourceRef="task_mpon_1" targetRef="event_send_req" />
