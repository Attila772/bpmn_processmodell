    <bpmn:sequenceFlow id="flow_mpon_4" sourceRef="task_mpon_2" targetRef="event_send_order" />
    <bpmn:sequenceFlow id="flow_mpon_5" sourceRef="event_rec_confirm" targetRef="event_rec_confirm" />
  </bpmn:process>
