<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  
  <!-- Collaboration showing MPON and MPOO interaction -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON (Metering Point Operator New)" processRef="Process_MPON" />
    <bpmn:participant id="Participant_MPOO" name="MPOO (Metering Point Operator Old)" processRef="Process_MPOO" />
    
    <!-- Message Flows between MPON and MPOO -->
    <bpmn:messageFlow id="MsgFlow_RequestBid" name="Device Takeover Request" sourceRef="Task_MPON_RequestBid" targetRef="Start_MPOO_RequestReceived" />
    <bpmn:messageFlow id="MsgFlow_SendTender" name="Equipment Takeover Tender" sourceRef="Task_MPOO_SendTender" targetRef="Catch_MPON_ReceiveTender" />
    <bpmn:messageFlow id="MsgFlow_PlaceOrder" name="Equipment Order" sourceRef="Task_MPON_PlaceOrder" targetRef="Catch_MPOO_ReceiveOrder" />
    <bpmn:messageFlow id="MsgFlow_ConfirmAndMasterData" name="Order Confirmation &amp; Master Data" sourceRef="Task_MPOO_ConfirmAndSendMasterData" targetRef="Catch_MPON_ReceiveConfirmation" />
  </bpmn:collaboration>

  <!-- Process for MPON -->
  <bpmn:process id="Process_MPON" isExecutable="true">
    <bpmn:startEvent id="Start_MPON" name="Device Takeover Needed">
      <bpmn:outgoing>Flow_MPON_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_MPON_RequestBid" name="Request Device Takeover Bid">
      <bpmn:incoming>Flow_MPON_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Catch_MPON_ReceiveTender" name="Receive Equipment Takeover Tender">
      <bpmn:incoming>Flow_MPON_2</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_3</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:sendTask id="Task_MPON_PlaceOrder" name="Place Order">
      <bpmn:incoming>Flow_MPON_3</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_4</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Catch_MPON_ReceiveConfirmation" name="Receive Order Confirmation and Master Data">
      <bpmn:incoming>Flow_MPON_4</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_5</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:endEvent id="End_MPON" name="Device Takeover Completed">
      <bpmn:incoming>Flow_MPON_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="Start_MPON" targetRef="Task_MPON_RequestBid" />
    <bpmn:sequenceFlow id="Flow_MPON_2" sourceRef="Task_MPON_RequestBid" targetRef="Catch_MPON_ReceiveTender" />
    <bpmn:sequenceFlow id="Flow_MPON_3" sourceRef="Catch_MPON_ReceiveTender" targetRef="Task_MPON_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_MPON_4" sourceRef="Task_MPON_PlaceOrder" targetRef="Catch_MPON_ReceiveConfirmation" />
    <bpmn:sequenceFlow id="Flow_MPON_5" sourceRef="Catch_MPON_ReceiveConfirmation" targetRef="End_MPON" />
  </bpmn:process>

  <!-- Process for MPOO -->
  <bpmn:process id="Process_MPOO" isExecutable="true">
    <bpmn:startEvent id="Start_MPOO_RequestReceived" name="Takeover Request Received">
      <bpmn:outgoing>Flow_MPOO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_1" />
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_MPOO_SendTender" name="Send Tender for Equipment Takeover">
      <bpmn:incoming>Flow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Catch_MPOO_ReceiveOrder" name="Receive Order">
      <bpmn:incoming>Flow_MPOO_2</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_3</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:sendTask id="Task_MPOO_ConfirmAndSendMasterData" name="Confirm Order and Send Master Data">
      <bpmn:incoming>Flow_MPOO_3</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_4</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_MPOO" name="Takeover Process Finished">
      <bpmn:incoming>Flow_MPOO_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_MPOO_1" sourceRef="Start_MPOO_RequestReceived" targetRef="Task_MPOO_SendTender" />
    <bpmn:sequenceFlow id="Flow_MPOO_2" sourceRef="Task_MPOO_SendTender" targetRef="Catch_MPOO_ReceiveOrder" />
    <bpmn:sequenceFlow id="Flow_MPOO_3" sourceRef="Catch_MPOO_ReceiveOrder" targetRef="Task_MPOO_ConfirmAndSendMasterData" />
    <bpmn:sequenceFlow id="Flow_MPOO_4" sourceRef="Task_MPOO_ConfirmAndSendMasterData" targetRef="End_MPOO" />
  </bpmn:process>

  <!-- BPMN Diagram Layout -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      
      <!-- MPON Pool -->
      <bpmndi:BPMNShape id="Participant_MPON_di" bpmnElement="Participant_MPON" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="880" height="160" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Start_MPON_di" bpmnElement="Start_MPON">
        <dc:Bounds x="212" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="185" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_RequestBid_di" bpmnElement="Task_MPON_RequestBid">
        <dc:Bounds x="290" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Catch_MPON_ReceiveTender_di" bpmnElement="Catch_MPON_ReceiveTender">
        <dc:Bounds x="440" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPON_PlaceOrder_di" bpmnElement="Task_MPON_PlaceOrder">
        <dc:Bounds x="590" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Catch_MPON_ReceiveConfirmation_di" bpmnElement="Catch_MPON_ReceiveConfirmation">
        <dc:Bounds x="740" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_MPON_di" bpmnElement="End_MPON">
        <dc:Bounds x="892" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="870" y="185" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_MPON_1_di" bpmnElement="Flow_MPON_1">
        <di:waypoint x="248" y="160" />
        <di:waypoint x="290" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPON_2_di" bpmnElement="Flow_MPON_2">
        <di:waypoint x="390" y="160" />
        <di:waypoint x="440" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPON_3_di" bpmnElement="Flow_MPON_3">
        <di:waypoint x="540" y="160" />
        <di:waypoint x="590" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPON_4_di" bpmnElement="Flow_MPON_4">
        <di:waypoint x="690" y="160" />
        <di:waypoint x="740" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPON_5_di" bpmnElement="Flow_MPON_5">
        <di:waypoint x="840" y="160" />
        <di:waypoint x="892" y="160" />
      </bpmndi:BPMNEdge>

      <!-- MPOO Pool -->
      <bpmndi:BPMNShape id="Participant_MPOO_di" bpmnElement="Participant_MPOO" isHorizontal="true">
        <dc:Bounds x="160" y="300" width="880" height="160" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_MPOO_RequestReceived_di" bpmnElement="Start_MPOO_RequestReceived">
        <dc:Bounds x="322" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="296" y="405" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPOO_SendTender_di" bpmnElement="Task_MPOO_SendTender">
        <dc:Bounds x="440" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Catch_MPOO_ReceiveOrder_di" bpmnElement="Catch_MPOO_ReceiveOrder">
        <dc:Bounds x="590" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MPOO_ConfirmAndSendMasterData_di" bpmnElement="Task_MPOO_ConfirmAndSendMasterData">
        <dc:Bounds x="740" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_MPOO_di" bpmnElement="End_MPOO">
        <dc:Bounds x="892" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="867" y="405" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_MPOO_1_di" bpmnElement="Flow_MPOO_1">
        <di:waypoint x="358" y="380" />
        <di:waypoint x="440" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPOO_2_di" bpmnElement="Flow_MPOO_2">
        <di:waypoint x="540" y="380" />
        <di:waypoint x="590" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPOO_3_di" bpmnElement="Flow_MPOO_3">
        <di:waypoint x="690" y="380" />
        <di:waypoint x="740" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_MPOO_4_di" bpmnElement="Flow_MPOO_4">
        <di:waypoint x="840" y="380" />
        <di:waypoint x="892" y="380" />
      </bpmndi:BPMNEdge>

      <!-- Message Flow Edges -->
      <bpmndi:BPMNEdge id="MsgFlow_RequestBid_di" bpmnElement="MsgFlow_RequestBid">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="340" y="362" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="252" y="278" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MsgFlow_SendTender_di" bpmnElement="MsgFlow_SendTender">
        <di:waypoint x="490" y="340" />
        <di:waypoint x="490" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="500" y="278" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MsgFlow_PlaceOrder_di" bpmnElement="MsgFlow_PlaceOrder">
        <di:waypoint x="640" y="200" />
        <di:waypoint x="640" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="552" y="278" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MsgFlow_ConfirmAndMasterData_di" bpmnElement="MsgFlow_ConfirmAndMasterData">
        <di:waypoint x="790" y="340" />
        <di:waypoint x="790" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="271" width="81" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
