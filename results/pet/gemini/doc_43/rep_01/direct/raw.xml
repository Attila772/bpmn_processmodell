<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ExpenseReimbursement"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_ExpenseProcess">
    <bpmn:participant id="Participant_ExpenseReimbursement" name="Expense Reimbursement Process" processRef="Process_ExpenseReimbursement" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ExpenseReimbursement" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_ExpenseIncurred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitExpenseReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditExpenseReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Task_AutomatedExpenseCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AutoCheckResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupervisorReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupervisorApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupervisorMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Treasurer" name="Treasurer">
        <bpmn:flowNodeRef>Task_TreasurerReceiptCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TreasurerApproval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Payment System">
        <bpmn:flowNodeRef>Task_LinkPaymentSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_PaymentConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Node Definitions -->
    <bpmn:startEvent id="StartEvent_ExpenseIncurred" name="Expense Incurred">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SubmitExpenseReport" name="Submit Expense Report and Receipts">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SupervisorMerge" name="Merge to Supervisor Check">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:businessRuleTask id="Task_AutomatedExpenseCheck" name="Automated Expense Rules Check">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_AutoCheckResult" name="Auto Check Result?">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AutoApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AutoRejected</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ManualReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_SupervisorReview" name="Review Expense Report">
      <bpmn:incoming>SequenceFlow_ManualReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SupervisorApproval" name="Supervisor Approved?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManualApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ManualRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_EditExpenseReport" name="Edit Expense Report">
      <bpmn:incoming>SequenceFlow_AutoRejected</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ManualRejected</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReceiptsMissing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TreasurerReceiptCheck" name="Check Receipts and Items">
      <bpmn:incoming>SequenceFlow_AutoApproved</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ManualApproved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_TreasurerApproval" name="Receipts In Order?">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TreasurerAccepted</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReceiptsMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_LinkPaymentSystem" name="Process Expense in Payment System">
      <bpmn:incoming>SequenceFlow_TreasurerAccepted</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="CatchEvent_PaymentConfirmation" name="Payment Confirmation Received">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_01" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Expense Process Completed">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_ExpenseIncurred" targetRef="Task_SubmitExpenseReport" />
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_SubmitExpenseReport" targetRef="Gateway_SupervisorMerge" />
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Gateway_SupervisorMerge" targetRef="Task_AutomatedExpenseCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_AutomatedExpenseCheck" targetRef="Gateway_AutoCheckResult" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AutoApproved" name="Auto-Approved" sourceRef="Gateway_AutoCheckResult" targetRef="Task_TreasurerReceiptCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${autoCheckResult == 'APPROVED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_AutoRejected" name="Auto-Rejected" sourceRef="Gateway_AutoCheckResult" targetRef="Task_EditExpenseReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${autoCheckResult == 'REJECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ManualReview" name="Manual Review Needed" sourceRef="Gateway_AutoCheckResult" targetRef="Task_SupervisorReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${autoCheckResult == 'MANUAL_REVIEW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_SupervisorReview" targetRef="Gateway_SupervisorApproval" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ManualApproved" name="Approved" sourceRef="Gateway_SupervisorApproval" targetRef="Task_TreasurerReceiptCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${supervisorApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ManualRejected" name="Rejected" sourceRef="Gateway_SupervisorApproval" targetRef="Task_EditExpenseReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${supervisorApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_EditExpenseReport" targetRef="Gateway_SupervisorMerge" />

    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_TreasurerReceiptCheck" targetRef="Gateway_TreasurerApproval" />

    <bpmn:sequenceFlow id="SequenceFlow_TreasurerAccepted" name="Yes" sourceRef="Gateway_TreasurerApproval" targetRef="Task_LinkPaymentSystem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${receiptsValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReceiptsMissing" name="No (Missing/Mismatch)" sourceRef="Gateway_TreasurerApproval" targetRef="Task_EditExpenseReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${receiptsValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_LinkPaymentSystem" targetRef="CatchEvent_PaymentConfirmation" />
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="CatchEvent_PaymentConfirmation" targetRef="EndEvent_ProcessCompleted" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_ExpenseProcess">
      <bpmndi:BPMNShape id="Participant_ExpenseReimbursement_di" bpmnElement="Participant_ExpenseReimbursement" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1240" height="710" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1210" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="1210" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Treasurer_di" bpmnElement="Lane_Treasurer" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="1210" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="640" width="1210" height="150" />
      </bpmndi:BPMNShape>

      <!-- Employee Nodes -->
      <bpmndi:BPMNShape id="StartEvent_ExpenseIncurred_di" bpmnElement="StartEvent_ExpenseIncurred">
        <dc:Bounds x="242" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="218" y="185" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SubmitExpenseReport_di" bpmnElement="Task_SubmitExpenseReport">
        <dc:Bounds x="330" y="120" width="100" height="80" />
