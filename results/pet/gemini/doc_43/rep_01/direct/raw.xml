      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_AutoCheckResult_di" bpmnElement="Gateway_AutoCheckResult" isMarkerVisible="true">
        <dc:Bounds x="575" y="340" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="569" y="303" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SupervisorReview_di" bpmnElement="Task_SupervisorReview">
        <dc:Bounds x="680" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_SupervisorApproval_di" bpmnElement="Gateway_SupervisorApproval" isMarkerVisible="true">
        <dc:Bounds x="825" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="822" y="452" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Treasurer Nodes -->
      <bpmndi:BPMNShape id="Task_TreasurerReceiptCheck_di" bpmnElement="Task_TreasurerReceiptCheck">
        <dc:Bounds x="800" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_TreasurerApproval_di" bpmnElement="Gateway_TreasurerApproval" isMarkerVisible="true">
        <dc:Bounds x="955" y="535" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="955" y="498" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- System Nodes -->
      <bpmndi:BPMNShape id="Task_LinkPaymentSystem_di" bpmnElement="Task_LinkPaymentSystem">
        <dc:Bounds x="930" y="675" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="CatchEvent_PaymentConfirmation_di" bpmnElement="CatchEvent_PaymentConfirmation">
        <dc:Bounds x="1082" y="697" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1068" y="740" width="65" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ProcessCompleted_di" bpmnElement="EndEvent_ProcessCompleted">
        <dc:Bounds x="1182" y="697" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1157" y="740" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="SequenceFlow_01_di" bpmnElement="SequenceFlow_01">
        <di:waypoint x="278" y="160" />
        <di:waypoint x="330" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_02_di" bpmnElement="SequenceFlow_02">
        <di:waypoint x="380" y="200" />
        <di:waypoint x="380" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_03_di" bpmnElement="SequenceFlow_03">
        <di:waypoint x="405" y="365" />
        <di:waypoint x="440" y="365" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_04_di" bpmnElement="SequenceFlow_04">
        <di:waypoint x="540" y="365" />
        <di:waypoint x="575" y="365" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AutoApproved_di" bpmnElement="SequenceFlow_AutoApproved">
        <di:waypoint x="600" y="390" />
        <di:waypoint x="600" y="560" />
        <di:waypoint x="800" y="560" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="613" y="473" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_AutoRejected_di" bpmnElement="SequenceFlow_AutoRejected">
        <di:waypoint x="600" y="340" />
        <di:waypoint x="600" y="160" />
        <di:waypoint x="650" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="233" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ManualReview_di" bpmnElement="SequenceFlow_ManualReview">
        <di:waypoint x="600" y="390" />
        <di:waypoint x="600" y="420" />
        <di:waypoint x="680" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="593" y="423" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_05_di" bpmnElement="SequenceFlow_05">
        <di:waypoint x="780" y="420" />
        <di:waypoint x="825" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ManualApproved_di" bpmnElement="SequenceFlow_ManualApproved">
        <di:waypoint x="850" y="445" />
        <di:waypoint x="850" y="520" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="857" y="480" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ManualRejected_di" bpmnElement="SequenceFlow_ManualRejected">
        <di:waypoint x="850" y="395" />
        <di:waypoint x="850" y="160" />
        <di:waypoint x="750" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="858" y="275" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_12_di" bpmnElement="SequenceFlow_12">
        <di:waypoint x="700" y="120" />
        <di:waypoint x="700" y="100" />
        <di:waypoint x="300" y="100" />
        <di:waypoint x="300" y="365" />
        <di:waypoint x="355" y="365" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_08_di" bpmnElement="SequenceFlow_08">
        <di:waypoint x="900" y="560" />
        <di:waypoint x="955" y="560" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_TreasurerAccepted_di" bpmnElement="SequenceFlow_TreasurerAccepted">
        <di:waypoint x="980" y="585" />
        <di:waypoint x="980" y="675" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="986" y="627" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_ReceiptsMissing_di" bpmnElement="SequenceFlow_ReceiptsMissing">
        <di:waypoint x="1005" y="560" />
        <di:waypoint x="1050" y="560" />
        <di:waypoint x="1050" y="160" />
        <di:waypoint x="750" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1056" y="348" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_10_di" bpmnElement="SequenceFlow_10">
        <di:waypoint x="1030" y="715" />
        <di:waypoint x="1082" y="715" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_11_di" bpmnElement="SequenceFlow_11">
        <di:waypoint x="1118" y="715" />
        <di:waypoint x="1182" y="715" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
