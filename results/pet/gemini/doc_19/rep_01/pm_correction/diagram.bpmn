<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_functional_department_part" name="Functional Department (Head)" processRef="pool_functional_department_proc" />
    <bpmn:participant id="pool_hr_department_part" name="Personnel / HR Department" processRef="pool_hr_department_proc" />
    <bpmn:messageFlow id="mf_vacancy_report" sourceRef="end_msg_vacancy" targetRef="start_msg_vacancy" name="Report vacancy" />
    <bpmn:messageFlow id="mf_hr_questions" sourceRef="end_msg_question" targetRef="start_msg_question" name="Clarification questions" />
    <bpmn:messageFlow id="mf_clarification_response" sourceRef="end_msg_clarification" targetRef="start_msg_clarification" name="Provide clarifications" />
    <bpmn:messageFlow id="mf_jd_review" sourceRef="end_msg_jd_review" targetRef="start_msg_jd_review" name="Job description for review" />
    <bpmn:messageFlow id="mf_corrections" sourceRef="end_msg_corrections" targetRef="start_msg_corrections" name="Correction request" />
  </bpmn:collaboration>
  <bpmn:process id="pool_functional_department_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_vacancy_report" name="Vacancy Report" dataObjectRef="doc_vacancy_report_do" />
    <bpmn:dataObject id="doc_vacancy_report_do" />
    <bpmn:dataObjectReference id="doc_job_description" name="Job Description" dataObjectRef="doc_job_description_do" />
    <bpmn:dataObject id="doc_job_description_do" />
    <bpmn:dataObjectReference id="doc_correction_request" name="Correction Request" dataObjectRef="doc_correction_request_do" />
    <bpmn:dataObject id="doc_correction_request_do" />
    <bpmn:startEvent id="start_fd" name="Personnel requirements detected">
      <bpmn:outgoing>sf_fd_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msg_vacancy" name="Vacancy reported">
      <bpmn:incoming>sf_fd_3</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_vacancy_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_msg_question" name="HR Question received">
      <bpmn:outgoing>sf_fd_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_question_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msg_clarification" name="Clarification sent">
      <bpmn:incoming>sf_fd_5</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_clarification_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_msg_jd_review" name="Job description received for review">
      <bpmn:outgoing>sf_fd_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_jd_review_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msg_corrections" name="Correction request sent">
      <bpmn:incoming>sf_fd_8</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_corrections_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_fd_approved" name="Job description approved">
      <bpmn:incoming>sf_fd_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_detect_req" name="Detect personnel requirements">
      <bpmn:incoming>sf_fd_1</bpmn:incoming>
      <bpmn:outgoing>sf_fd_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_report_vacancy" name="Report vacancy to Personnel Department">
      <bpmn:incoming>sf_fd_2</bpmn:incoming>
      <bpmn:outgoing>sf_fd_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_report_vacancy_doa0">
        <bpmn:targetRef>doc_vacancy_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_provide_clarification" name="Provide clarifications on tasks and requirements">
      <bpmn:incoming>sf_fd_4</bpmn:incoming>
      <bpmn:outgoing>sf_fd_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_review_jd" name="Review job description">
      <bpmn:incoming>sf_fd_6</bpmn:incoming>
      <bpmn:outgoing>sf_fd_7</bpmn:outgoing>
      <bpmn:property id="task_review_jd_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_jd_dia0">
        <bpmn:sourceRef>doc_job_description</bpmn:sourceRef>
        <bpmn:targetRef>task_review_jd_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_request_corrections" name="Ask for corrections">
      <bpmn:incoming>sf_corrections_needed</bpmn:incoming>
      <bpmn:outgoing>sf_fd_8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_request_corrections_doa0">
        <bpmn:targetRef>doc_correction_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_approve_jd" name="Approve job description">
      <bpmn:incoming>sf_approved</bpmn:incoming>
      <bpmn:outgoing>sf_fd_9</bpmn:outgoing>
      <bpmn:property id="task_approve_jd_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_approve_jd_dia0">
        <bpmn:sourceRef>doc_job_description</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_jd_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gtw_review_result" name="Job description acceptable?" isMarkerVisible="true">
      <bpmn:incoming>sf_fd_7</bpmn:incoming>
      <bpmn:outgoing>sf_corrections_needed</bpmn:outgoing>
      <bpmn:outgoing>sf_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_fd_1" sourceRef="start_fd" targetRef="task_detect_req" />
    <bpmn:sequenceFlow id="sf_fd_2" sourceRef="task_detect_req" targetRef="task_report_vacancy" />
    <bpmn:sequenceFlow id="sf_fd_3" sourceRef="task_report_vacancy" targetRef="end_msg_vacancy" />
    <bpmn:sequenceFlow id="sf_fd_4" sourceRef="start_msg_question" targetRef="task_provide_clarification" />
    <bpmn:sequenceFlow id="sf_fd_5" sourceRef="task_provide_clarification" targetRef="end_msg_clarification" />
    <bpmn:sequenceFlow id="sf_fd_6" sourceRef="start_msg_jd_review" targetRef="task_review_jd" />
    <bpmn:sequenceFlow id="sf_fd_7" sourceRef="task_review_jd" targetRef="gtw_review_result" />
    <bpmn:sequenceFlow id="sf_corrections_needed" sourceRef="gtw_review_result" targetRef="task_request_corrections" name="Corrections needed" />
    <bpmn:sequenceFlow id="sf_approved" sourceRef="gtw_review_result" targetRef="task_approve_jd" name="Approved" />
    <bpmn:sequenceFlow id="sf_fd_8" sourceRef="task_request_corrections" targetRef="end_msg_corrections" />
    <bpmn:sequenceFlow id="sf_fd_9" sourceRef="task_approve_jd" targetRef="end_fd_approved" />
  </bpmn:process>
  <bpmn:process id="pool_hr_department_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_vacancy_report_p1" name="Vacancy Report" dataObjectRef="doc_vacancy_report_p1_do" />
    <bpmn:dataObject id="doc_vacancy_report_p1_do" />
    <bpmn:dataObjectReference id="doc_job_description_p1" name="Job Description" dataObjectRef="doc_job_description_p1_do" />
    <bpmn:dataObject id="doc_job_description_p1_do" />
    <bpmn:dataObjectReference id="doc_correction_request_p1" name="Correction Request" dataObjectRef="doc_correction_request_p1_do" />
    <bpmn:dataObject id="doc_correction_request_p1_do" />
    <bpmn:startEvent id="start_msg_vacancy" name="Vacancy report received">
      <bpmn:outgoing>sf_hr_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_vacancy_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msg_question" name="HR Question sent">
      <bpmn:incoming>sf_hr_3</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_question_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_msg_clarification" name="Clarification received">
      <bpmn:outgoing>sf_hr_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_clarification_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_msg_jd_review" name="Job description sent for review">
      <bpmn:incoming>sf_hr_5</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_msg_jd_review_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_msg_corrections" name="Correction request received">
      <bpmn:outgoing>sf_hr_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_msg_corrections_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_hr_advertised" name="Ready for advertising">
      <bpmn:incoming>sf_hr_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_eval_vacancy" name="Evaluate vacancy report">
      <bpmn:incoming>sf_hr_1</bpmn:incoming>
      <bpmn:outgoing>sf_hr_2</bpmn:outgoing>
      <bpmn:property id="task_eval_vacancy_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_eval_vacancy_dia0">
        <bpmn:sourceRef>doc_vacancy_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_eval_vacancy_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_ask_questions" name="Ask questions about tasks and requirements">
      <bpmn:incoming>sf_hr_q_yes</bpmn:incoming>
      <bpmn:outgoing>sf_hr_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_describe_job" name="Describe job / draft job description">
      <bpmn:incoming>sf_hr_q_no</bpmn:incoming>
      <bpmn:incoming>sf_hr_4</bpmn:incoming>
      <bpmn:outgoing>sf_hr_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_describe_job_doa0">
        <bpmn:targetRef>doc_job_description_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_update_jd" name="Update job description">
      <bpmn:incoming>sf_hr_6</bpmn:incoming>
      <bpmn:outgoing>sf_hr_7</bpmn:outgoing>
      <bpmn:property id="task_update_jd_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_update_jd_dia0">
        <bpmn:sourceRef>doc_correction_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_update_jd_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_update_jd_doa0">
        <bpmn:targetRef>doc_job_description_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gtw_hr_questions" name="Questions exist?" isMarkerVisible="true">
      <bpmn:incoming>sf_hr_2</bpmn:incoming>
      <bpmn:outgoing>sf_hr_q_yes</bpmn:outgoing>
      <bpmn:outgoing>sf_hr_q_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_hr_1" sourceRef="start_msg_vacancy" targetRef="task_eval_vacancy" />
    <bpmn:sequenceFlow id="sf_hr_2" sourceRef="task_eval_vacancy" targetRef="gtw_hr_questions" />
    <bpmn:sequenceFlow id="sf_hr_q_yes" sourceRef="gtw_hr_questions" targetRef="task_ask_questions" name="Questions exist" />
    <bpmn:sequenceFlow id="sf_hr_q_no" sourceRef="gtw_hr_questions" targetRef="task_describe_job" name="No questions" />
    <bpmn:sequenceFlow id="sf_hr_3" sourceRef="task_ask_questions" targetRef="end_msg_question" />
    <bpmn:sequenceFlow id="sf_hr_4" sourceRef="start_msg_clarification" targetRef="task_describe_job" />
    <bpmn:sequenceFlow id="sf_hr_5" sourceRef="task_describe_job" targetRef="end_msg_jd_review" />
    <bpmn:sequenceFlow id="sf_hr_6" sourceRef="start_msg_corrections" targetRef="task_update_jd" />
    <bpmn:sequenceFlow id="sf_hr_7" sourceRef="task_update_jd" targetRef="end_hr_advertised" />
  </bpmn:process>
