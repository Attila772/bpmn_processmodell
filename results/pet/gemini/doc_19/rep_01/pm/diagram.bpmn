      <bpmndi:BPMNShape id="evt_send_jd_hr_di" bpmnElement="evt_send_jd_hr">
        <dc:Bounds x="1300" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_questions_hr_di" bpmnElement="evt_send_questions_hr">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_send_vacancy_di" bpmnElement="evt_send_vacancy">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_fd_di" bpmnElement="evt_start_fd">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_hr_di" bpmnElement="evt_start_hr">
        <dc:Bounds x="160" y="560" width="36" height="36" />
