        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gtw_fd_wait_merge_di" bpmnElement="gtw_fd_wait_merge">
        <dc:Bounds x="1870" y="100" width="50" height="50" />
