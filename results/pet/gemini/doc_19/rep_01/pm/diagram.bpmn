        <di:waypoint x="1128" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fd_7_di" bpmnElement="flow_fd_7">
        <di:waypoint x="1128" y="118" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fd_8_di" bpmnElement="flow_fd_8">
