<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_VacancyProcess"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:collaboration id="Collaboration_01">
    <bpmn:participant id="Participant_FunctionalDepartment" name="Head of Functional Department" processRef="Process_FunctionalDepartment" />
    <bpmn:participant id="Participant_HRDepartment" name="Personnel Department (HR)" />
    <bpmn:messageFlow id="MessageFlow_ReportVacancy" name="Vacancy Report" sourceRef="Task_ReportVacancy" targetRef="Participant_HRDepartment" />
    <bpmn:messageFlow id="MessageFlow_HRQuestion" name="Clarification Question" sourceRef="Participant_HRDepartment" targetRef="Event_HRQuestionReceived" />
    <bpmn:messageFlow id="MessageFlow_ClarificationAnswer" name="Clarification Answer" sourceRef="Task_AnswerHRQuestions" targetRef="Participant_HRDepartment" />
    <bpmn:messageFlow id="MessageFlow_JobDescription" name="Job Description" sourceRef="Participant_HRDepartment" targetRef="Event_JobDescriptionReceived" />
    <bpmn:messageFlow id="MessageFlow_CorrectionRequest" name="Correction Request" sourceRef="Task_RequestCorrections" targetRef="Participant_HRDepartment" />
    <bpmn:messageFlow id="MessageFlow_Approval" name="Approval" sourceRef="Task_ApproveJobDescription" targetRef="Participant_HRDepartment" />
  </bpmn:collaboration>

  <bpmn:process id="Process_FunctionalDepartment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_PersonnelRequirementDetected" name="Personnel Requirements Detected">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_ReportVacancy" name="Report Vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:eventBasedGateway id="EventBasedGateway_WaitFeedback" name="Wait for HR Feedback">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LoopClarification</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LoopCorrection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHRQuestion</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToJobDescription</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_HRQuestionReceived" name="HR Question Received">
      <bpmn:incoming>SequenceFlow_ToHRQuestion</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_HRQuestion" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_AnswerHRQuestions" name="Answer HR Questions / Clarify Tasks &amp; Requirements">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoopClarification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_JobDescriptionReceived" name="Job Description Received for Review">
      <bpmn:incoming>SequenceFlow_ToJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_JobDescription" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_ReviewJobDescription" name="Review Job Description">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalDecision" name="Job Description Acceptable?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Approved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedsCorrection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_RequestCorrections" name="Request Corrections">
      <bpmn:incoming>SequenceFlow_NeedsCorrection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoopCorrection</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_ApproveJobDescription" name="Approve Job Description">
      <bpmn:incoming>SequenceFlow_Approved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_JobDescriptionApproved" name="Job Description Approved">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_PersonnelRequirementDetected" targetRef="Task_ReportVacancy" />
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_ReportVacancy" targetRef="EventBasedGateway_WaitFeedback" />
    <bpmn:sequenceFlow id="SequenceFlow_ToHRQuestion" sourceRef="EventBasedGateway_WaitFeedback" targetRef="Event_HRQuestionReceived" />
    <bpmn:sequenceFlow id="SequenceFlow_ToJobDescription" sourceRef="EventBasedGateway_WaitFeedback" targetRef="Event_JobDescriptionReceived" />
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Event_HRQuestionReceived" targetRef="Task_AnswerHRQuestions" />
    <bpmn:sequenceFlow id="SequenceFlow_LoopClarification" sourceRef="Task_AnswerHRQuestions" targetRef="EventBasedGateway_WaitFeedback" />
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Event_JobDescriptionReceived" targetRef="Task_ReviewJobDescription" />
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_ReviewJobDescription" targetRef="ExclusiveGateway_ApprovalDecision" />
    <bpmn:sequenceFlow id="SequenceFlow_Approved" name="Yes (Approved)" sourceRef="ExclusiveGateway_ApprovalDecision" targetRef="Task_ApproveJobDescription" />
    <bpmn:sequenceFlow id="SequenceFlow_NeedsCorrection" name="No (Corrections needed)" sourceRef="ExclusiveGateway_ApprovalDecision" targetRef="Task_RequestCorrections" />
    <bpmn:sequenceFlow id="SequenceFlow_LoopCorrection" sourceRef="Task_RequestCorrections" targetRef="EventBasedGateway_WaitFeedback" />
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_ApproveJobDescription" targetRef="EndEvent_JobDescriptionApproved" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_01">
