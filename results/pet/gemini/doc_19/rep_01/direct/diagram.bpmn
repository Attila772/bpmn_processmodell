<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_DepartmentHead" name="Head of Functional Department" processRef="Process_DepartmentHead" />
    <bpmn:participant id="Participant_HRDepartment" name="Personnel Department (HR)" />
    <bpmn:messageFlow id="MessageFlow_ReportVacancy" name="Vacancy Report" sourceRef="Task_ReportVacancy" targetRef="Participant_HRDepartment" />
    <bpmn:messageFlow id="MessageFlow_HRQuestion" name="Clarification Question" sourceRef="Participant_HRDepartment" targetRef="Event_HRQuestionReceived" />
    <bpmn:messageFlow id="MessageFlow_Clarification" name="Clarification Answer" sourceRef="Task_ProvideClarification" targetRef="Participant_HRDepartment" />
    <bpmn:messageFlow id="MessageFlow_JobDescription" name="Job Description for Review" sourceRef="Participant_HRDepartment" targetRef="Event_JobDescriptionReceived" />
    <bpmn:messageFlow id="MessageFlow_CorrectionRequest" name="Correction Request" sourceRef="Task_RequestCorrections" targetRef="Participant_HRDepartment" />
    <bpmn:messageFlow id="MessageFlow_Approval" name="Job Description Approval" sourceRef="Task_ApproveJobDescription" targetRef="Participant_HRDepartment" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DepartmentHead" isExecutable="true">
    <bpmn:startEvent id="StartEvent_PersonnelRequirementsDetected" name="Personnel requirements detected">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_ReportVacancy" name="Report vacancy to Personnel Department">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:eventBasedGateway id="Gateway_WaitLoop">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_AfterClarification</bpmn:incoming>
      <bpmn:incoming>Flow_AfterCorrection</bpmn:incoming>
      <bpmn:outgoing>Flow_ToJobDescriptionEvent</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToHRQuestionEvent</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_HRQuestionReceived" name="HR question received">
      <bpmn:incoming>Flow_ToHRQuestionEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProvideClarification</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_HRQuestion" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_ProvideClarification" name="Provide clarification on tasks and requirements">
      <bpmn:incoming>Flow_ToProvideClarification</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterClarification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_JobDescriptionReceived" name="Job description received">
      <bpmn:incoming>Flow_ToJobDescriptionEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_JobDescription" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_ReviewJobDescription" name="Review job description">
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Job description acceptable?">
      <bpmn:incoming>Flow_ToGatewayDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_RequiresCorrection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_RequestCorrections" name="Request corrections">
      <bpmn:incoming>Flow_RequiresCorrection</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterCorrection</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_ApproveJobDescription" name="Approve job description">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFinished</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_VacancyReadyForAdvertising" name="Job description approved for advertising">
      <bpmn:incoming>Flow_ToFinished</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_PersonnelRequirementsDetected" targetRef="Task_ReportVacancy" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReportVacancy" targetRef="Gateway_WaitLoop" />
    <bpmn:sequenceFlow id="Flow_ToJobDescriptionEvent" sourceRef="Gateway_WaitLoop" targetRef="Event_JobDescriptionReceived" />
    <bpmn:sequenceFlow id="Flow_ToHRQuestionEvent" sourceRef="Gateway_WaitLoop" targetRef="Event_HRQuestionReceived" />
    <bpmn:sequenceFlow id="Flow_ToProvideClarification" sourceRef="Event_HRQuestionReceived" targetRef="Task_ProvideClarification" />
    <bpmn:sequenceFlow id="Flow_AfterClarification" sourceRef="Task_ProvideClarification" targetRef="Gateway_WaitLoop" />
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="Event_JobDescriptionReceived" targetRef="Task_ReviewJobDescription" />
    <bpmn:sequenceFlow id="Flow_ToGatewayDecision" sourceRef="Task_ReviewJobDescription" targetRef="Gateway_ReviewDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes (Approved)" sourceRef="Gateway_ReviewDecision" targetRef="Task_ApproveJobDescription" />
    <bpmn:sequenceFlow id="Flow_RequiresCorrection" name="No (Corrections needed)" sourceRef="Gateway_ReviewDecision" targetRef="Task_RequestCorrections" />
    <bpmn:sequenceFlow id="Flow_AfterCorrection" sourceRef="Task_RequestCorrections" targetRef="Gateway_WaitLoop" />
    <bpmn:sequenceFlow id="Flow_ToFinished" sourceRef="Task_ApproveJobDescription" targetRef="EndEvent_VacancyReadyForAdvertising" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_DepartmentHead_di" bpmnElement="Participant_DepartmentHead" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="1180" height="340" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="StartEvent_PersonnelRequirementsDetected_di" bpmnElement="StartEvent_PersonnelRequirementsDetected">
        <dc:Bounds x="212" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="187" y="305" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReportVacancy_di" bpmnElement="Task_ReportVacancy">
        <dc:Bounds x="290" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_WaitLoop_di" bpmnElement="Gateway_WaitLoop" isMarkerVisible="true">
        <dc:Bounds x="435" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_HRQuestionReceived_di" bpmnElement="Event_HRQuestionReceived">
        <dc:Bounds x="522" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="509" y="415" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProvideClarification_di" bpmnElement="Task_ProvideClarification">
        <dc:Bounds x="610" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_JobDescriptionReceived_di" bpmnElement="Event_JobDescriptionReceived">
        <dc:Bounds x="522" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="503" y="305" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewJobDescription_di" bpmnElement="Task_ReviewJobDescription">
        <dc:Bounds x="610" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ReviewDecision_di" bpmnElement="Gateway_ReviewDecision" isMarkerVisible="true">
        <dc:Bounds x="755" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="743" y="218" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RequestCorrections_di" bpmnElement="Task_RequestCorrections">
        <dc:Bounds x="860" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ApproveJobDescription_di" bpmnElement="Task_ApproveJobDescription">
        <dc:Bounds x="860" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_VacancyReadyForAdvertising_di" bpmnElement="EndEvent_VacancyReadyForAdvertising">
        <dc:Bounds x="1012" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="993" y="305" width="75" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="248" y="280" />
        <di:waypoint x="290" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="390" y="280" />
        <di:waypoint x="435" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToJobDescriptionEvent_di" bpmnElement="Flow_ToJobDescriptionEvent">
        <di:waypoint x="485" y="280" />
        <di:waypoint x="522" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToHRQuestionEvent_di" bpmnElement="Flow_ToHRQuestionEvent">
        <di:waypoint x="460" y="305" />
        <di:waypoint x="460" y="390" />
        <di:waypoint x="522" y="390" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToProvideClarification_di" bpmnElement="Flow_ToProvideClarification">
        <di:waypoint x="558" y="390" />
        <di:waypoint x="610" y="390" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AfterClarification_di" bpmnElement="Flow_AfterClarification">
        <di:waypoint x="660" y="430" />
        <di:waypoint x="660" y="470" />
        <di:waypoint x="410" y="470" />
        <di:waypoint x="410" y="290" />
        <di:waypoint x="436" y="281" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToReview_di" bpmnElement="Flow_ToReview">
        <di:waypoint x="558" y="280" />
        <di:waypoint x="610" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToGatewayDecision_di" bpmnElement="Flow_ToGatewayDecision">
        <di:waypoint x="710" y="280" />
        <di:waypoint x="755" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="805" y="280" />
        <di:waypoint x="860" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="789" y="262" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_RequiresCorrection_di" bpmnElement="Flow_RequiresCorrection">
        <di:waypoint x="780" y="305" />
        <di:waypoint x="780" y="390" />
        <di:waypoint x="860" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="342" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AfterCorrection_di" bpmnElement="Flow_AfterCorrection">
        <di:waypoint x="910" y="430" />
        <di:waypoint x="910" y="500" />
        <di:waypoint x="430" y="500" />
        <di:waypoint x="430" y="290" />
        <di:waypoint x="445" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToFinished_di" bpmnElement="Flow_ToFinished">
        <di:waypoint x="960" y="280" />
        <di:waypoint x="1012" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_HRDepartment_di" bpmnElement="Participant_HRDepartment" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1180" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="MessageFlow_ReportVacancy_di" bpmnElement="MessageFlow_ReportVacancy">
        <di:waypoint x="340" y="240" />
        <di:waypoint x="340" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="346" y="173" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_HRQuestion_di" bpmnElement="MessageFlow_HRQuestion">
        <di:waypoint x="540" y="140" />
        <di:waypoint x="540" y="372" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="470" y="173" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Clarification_di" bpmnElement="MessageFlow_Clarification">
        <di:waypoint x="660" y="350" />
        <di:waypoint x="660" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="668" y="173" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_JobDescription_di" bpmnElement="MessageFlow_JobDescription">
        <di:waypoint x="540" y="140" />
        <di:waypoint x="540" y="262" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="545" y="173" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_CorrectionRequest_di" bpmnElement="MessageFlow_CorrectionRequest">
        <di:waypoint x="910" y="350" />
        <di:waypoint x="910" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="916" y="173" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Approval_di" bpmnElement="MessageFlow_Approval">
        <di:waypoint x="880" y="240" />
        <di:waypoint x="880" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="803" y="173" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
