<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON" />
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO" />
    <bpmn:messageFlow id="MessageFlow_Dismissal" name="Dismissal" sourceRef="Task_SendDismissal" targetRef="StartEvent_MPOO" />
  </bpmn:collaboration>

  <bpmn:process id="Process_MPON" isExecutable="true">
    <bpmn:startEvent id="StartEvent_MPON" name="Dismissal required">
      <bpmn:outgoing>SequenceFlow_MPON_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SendDismissal" name="Send dismissal to MPOO">
      <bpmn:incoming>SequenceFlow_MPON_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_MPON" name="Dismissal sent">
      <bpmn:incoming>SequenceFlow_MPON_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_SendDismissal" />
    <bpmn:sequenceFlow id="SequenceFlow_MPON_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPON" />
  </bpmn:process>

  <bpmn:process id="Process_MPOO" isExecutable="true">
    <bpmn:startEvent id="StartEvent_MPOO" name="Dismissal received">
      <bpmn:outgoing>SequenceFlow_MPOO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewDismissal" name="Review dismissal">
      <bpmn:incoming>SequenceFlow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision on dismissal?">
      <bpmn:incoming>SequenceFlow_MPOO_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Confirm</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Oppose</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConfirmDismissal" name="Confirm dismissal">
      <bpmn:incoming>SequenceFlow_Confirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OpposeDismissal" name="Oppose dismissal">
      <bpmn:incoming>SequenceFlow_Oppose</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Confirmed" name="Dismissal confirmed">
      <bpmn:incoming>SequenceFlow_MPOO_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Opposed" name="Dismissal opposed">
      <bpmn:incoming>SequenceFlow_MPOO_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_1" sourceRef="StartEvent_MPOO" targetRef="Task_ReviewDismissal" />
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_2" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="SequenceFlow_Confirm" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_ConfirmDismissal" />
    <bpmn:sequenceFlow id="SequenceFlow_Oppose" name="Oppose" sourceRef="Gateway_Decision" targetRef="Task_OpposeDismissal" />
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_3" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_Confirmed" />
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_4" sourceRef="Task_OpposeDismissal" targetRef="EndEvent_Opposed" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_MPON_di" bpmnElement="Participant_MPON" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="600" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_MPON_di" bpmnElement="StartEvent_MPON">
        <dc:Bounds x="222" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="215" y="185" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendDismissal_di" bpmnElement="Task_SendDismissal">
        <dc:Bounds x="310" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_MPON_di" bpmnElement="EndEvent_MPON">
        <dc:Bounds x="462" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="445" y="185" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow_MPON_1_di" bpmnElement="SequenceFlow_MPON_1">
        <di:waypoint x="258" y="160" />
        <di:waypoint x="310" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_MPON_2_di" bpmnElement="SequenceFlow_MPON_2">
        <di:waypoint x="410" y="160" />
        <di:waypoint x="462" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_MPOO_di" bpmnElement="Participant_MPOO" isHorizontal="true">
        <dc:Bounds x="160" y="290" width="700" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_MPOO_di" bpmnElement="StartEvent_MPOO">
        <dc:Bounds x="342" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="338" y="445" width="45" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewDismissal_di" bpmnElement="Task_ReviewDismissal">
        <dc:Bounds x="430" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="575" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="571" y="452" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmDismissal_di" bpmnElement="Task_ConfirmDismissal">
        <dc:Bounds x="670" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpposeDismissal_di" bpmnElement="Task_OpposeDismissal">
        <dc:Bounds x="670" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Confirmed_di" bpmnElement="EndEvent_Confirmed">
        <dc:Bounds x="802" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="796" y="385" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Opposed_di" bpmnElement="EndEvent_Opposed">
        <dc:Bounds x="802" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="796" y="505" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow_MPOO_1_di" bpmnElement="SequenceFlow_MPOO_1">
        <di:waypoint x="378" y="420" />
        <di:waypoint x="430" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_MPOO_2_di" bpmnElement="SequenceFlow_MPOO_2">
        <di:waypoint x="530" y="420" />
        <di:waypoint x="575" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_Confirm_di" bpmnElement="SequenceFlow_Confirm">
        <di:waypoint x="600" y="395" />
        <di:waypoint x="600" y="360" />
        <di:waypoint x="670" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="609" y="343" width="41" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_Oppose_di" bpmnElement="SequenceFlow_Oppose">
        <di:waypoint x="600" y="445" />
        <di:waypoint x="600" y="480" />
        <di:waypoint x="670" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="610" y="488" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_MPOO_3_di" bpmnElement="SequenceFlow_MPOO_3">
        <di:waypoint x="770" y="360" />
        <di:waypoint x="802" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_MPOO_4_di" bpmnElement="SequenceFlow_MPOO_4">
        <di:waypoint x="770" y="480" />
        <di:waypoint x="802" y="480" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Dismissal_di" bpmnElement="MessageFlow_Dismissal">
        <di:waypoint x="360" y="200" />
        <di:waypoint x="360" y="402" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="366" y="298" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
