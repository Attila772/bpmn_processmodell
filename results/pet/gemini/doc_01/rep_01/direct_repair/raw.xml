        <di:waypoint x="880" y="590" />
        <di:waypoint x="940" y="590" />
        <di:waypoint x="940" y="635" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IP_4_di" bpmnElement="Flow_IP_4">
