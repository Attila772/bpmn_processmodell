      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_INQ_2_di" bpmnElement="Flow_INQ_2">
        <di:waypoint x="540" y="380" />
        <di:waypoint x="870" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_INQ_3_di" bpmnElement="Flow_INQ_3">
        <di:waypoint x="970" y="380" />
        <di:waypoint x="1022" y="380" />
      </bpmndi:BPMNEdge>

      <!-- PARTICIPANT IP -->
      <bpmndi:BPMNShape id="Participant_IP_di" bpmnElement="Participant_IP" isHorizontal="true">
        <dc:Bounds x="160" y="520" width="1000" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_IP_Received_di" bpmnElement="Start_IP_Received">
        <dc:Bounds x="472" y="642" width="36" height="36" />
