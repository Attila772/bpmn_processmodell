      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_INQ_di" bpmnElement="End_INQ">
        <dc:Bounds x="1022" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1014" y="405" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_INQ_1_di" bpmnElement="Flow_INQ_1">
        <di:waypoint x="388" y="380" />
