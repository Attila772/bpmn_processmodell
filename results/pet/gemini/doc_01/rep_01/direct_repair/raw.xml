          <dc:Bounds x="668" y="692" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IP_Confirm_di" bpmnElement="Task_IP_Confirm">
        <dc:Bounds x="780" y="550" width="100" height="80" />
