        <dc:Bounds x="160" y="80" width="1000" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_EC_di" bpmnElement="Start_EC">
        <dc:Bounds x="232" y="142" width="36" height="36" />
