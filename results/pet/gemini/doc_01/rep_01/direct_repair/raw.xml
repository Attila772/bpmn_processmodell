      <bpmndi:BPMNShape id="Task_IP_Reject_di" bpmnElement="Task_IP_Reject">
        <dc:Bounds x="780" y="680" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join" isMarkerVisible="true">
