<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="do_job_ad" name="Job Advertisement" dataObjectRef="do_job_ad_do" />
    <bpmn:dataObject id="do_job_ad_do" />
    <bpmn:dataObjectReference id="do_application" name="Application" dataObjectRef="do_application_do" />
    <bpmn:dataObject id="do_application_do" />
    <bpmn:dataObjectReference id="do_employment_contract" name="Contract of Employment" dataObjectRef="do_employment_contract_do" />
    <bpmn:dataObject id="do_employment_contract_do" />
    <bpmn:startEvent id="evt_start_demand" name="Demand for post filling raised">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_filled" name="Post filled">
      <bpmn:incoming>flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_advertise" name="Advertise post">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_advertise_doa0">
        <bpmn:targetRef>do_job_ad</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task_apply" name="Apply for post">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_apply_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_apply_dia0">
        <bpmn:sourceRef>do_job_ad</bpmn:sourceRef>
        <bpmn:targetRef>task_apply_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_apply_doa0">
        <bpmn:targetRef>do_application</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_check_applications" name="Check applications">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_check_applications_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_applications_dia0">
        <bpmn:sourceRef>do_application</bpmn:sourceRef>
        <bpmn:targetRef>task_check_applications_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task_conclude_contract" name="Conclude contract of employment">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_conclude_contract_doa0">
        <bpmn:targetRef>do_employment_contract</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_demand" targetRef="task_advertise" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_advertise" targetRef="task_apply" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_apply" targetRef="task_check_applications" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_check_applications" targetRef="task_conclude_contract" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_conclude_contract" targetRef="evt_end_filled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_filled_di" bpmnElement="evt_end_filled">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_demand_di" bpmnElement="evt_start_demand">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_advertise_di" bpmnElement="task_advertise">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_apply_di" bpmnElement="task_apply">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_applications_di" bpmnElement="task_check_applications">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_conclude_contract_di" bpmnElement="task_conclude_contract">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_job_ad_di" bpmnElement="do_job_ad">
        <dc:Bounds x="465" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_application_di" bpmnElement="do_application">
        <dc:Bounds x="655" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_employment_contract_di" bpmnElement="do_employment_contract">
        <dc:Bounds x="940" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_advertise_doa0_di" bpmnElement="task_advertise_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_apply_dia0_di" bpmnElement="task_apply_dia0">
        <di:waypoint x="483" y="265" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_apply_doa0_di" bpmnElement="task_apply_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="673" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_applications_dia0_di" bpmnElement="task_check_applications_dia0">
        <di:waypoint x="673" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_conclude_contract_doa0_di" bpmnElement="task_conclude_contract_doa0">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="958" y="265" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>