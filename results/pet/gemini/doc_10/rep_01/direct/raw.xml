<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Recruitment" name="Recruitment Process" processRef="Process_Recruitment" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Recruitment" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_HR" name="HR Department">
        <bpmn:flowNodeRef>StartEvent_DemandReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdvertisePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationsApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeEmploymentContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PostFilled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_DemandReceived" name="Demand to fill post received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>

    <bpmn:task id="Task_AdvertisePost" name="Advertise Post">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReceiveApplications" name="Receive Applications">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckApplications" name="Check Applications">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ApplicationsApproved" name="Suitable candidate found?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ConcludeEmploymentContract" name="Conclude Employment Contract">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_PostFilled" name="Post Filled">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_DemandReceived" targetRef="Task_AdvertisePost" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_AdvertisePost" targetRef="Task_ReceiveApplications" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ReceiveApplications" targetRef="Task_CheckApplications" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckApplications" targetRef="Gateway_ApplicationsApproved" />
    <bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="Gateway_ApplicationsApproved" targetRef="Task_AdvertisePost" />
    <bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="Gateway_ApplicationsApproved" targetRef="Task_ConcludeEmploymentContract" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ConcludeEmploymentContract" targetRef="EndEvent_PostFilled" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Recruitment_di" bpmnElement="Participant_Recruitment" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1020" height="250" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Lane_HR_di" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="990" height="250" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_DemandReceived_di" bpmnElement="StartEvent_DemandReceived">
        <dc:Bounds x="242" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="221" y="215" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AdvertisePost_di" bpmnElement="Task_AdvertisePost">
        <dc:Bounds x="330" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveApplications_di" bpmnElement="Task_ReceiveApplications">
        <dc:Bounds x="480" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckApplications_di" bpmnElement="Task_CheckApplications">
        <dc:Bounds x="630" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ApplicationsApproved_di" bpmnElement="Gateway_ApplicationsApproved" isMarkerVisible="true">
        <dc:Bounds x="785" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="768" y="128" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConcludeEmploymentContract_di" bpmnElement="Task_ConcludeEmploymentContract">
        <dc:Bounds x="890" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_PostFilled_di" bpmnElement="EndEvent_PostFilled">
        <dc:Bounds x="1042" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="215" width="51" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="190" />
        <di:waypoint x="330" y="190" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="430" y="190" />
        <di:waypoint x="480" y="190" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="580" y="190" />
        <di:waypoint x="630" y="190" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="730" y="190" />
        <di:waypoint x="785" y="190" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="810" y="215" />
        <di:waypoint x="810" y="270" />
        <di:waypoint x="380" y="270" />
        <di:waypoint x="380" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="782" y="235" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="835" y="190" />
        <di:waypoint x="890" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="854" y="172" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="990" y="190" />
        <di:waypoint x="1042" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
