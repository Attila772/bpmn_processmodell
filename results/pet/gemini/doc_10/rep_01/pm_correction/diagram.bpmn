<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="doc_job_advertisement" name="Job Advertisement" dataObjectRef="doc_job_advertisement_do" />
    <bpmn:dataObject id="doc_job_advertisement_do" />
    <bpmn:dataObjectReference id="doc_application" name="Application" dataObjectRef="doc_application_do" />
    <bpmn:dataObject id="doc_application_do" />
    <bpmn:dataObjectReference id="doc_employment_contract" name="Contract of Employment" dataObjectRef="doc_employment_contract_do" />
    <bpmn:dataObject id="doc_employment_contract_do" />
    <bpmn:startEvent id="evt_start" name="Demand to fill a post received">
      <bpmn:outgoing>seq_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end" name="Post filled">
      <bpmn:incoming>seq_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_advertise" name="Advertise post">
      <bpmn:incoming>seq_1</bpmn:incoming>
      <bpmn:outgoing>seq_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_advertise_doa0">
        <bpmn:targetRef>doc_job_advertisement</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_apply" name="Receive applications">
      <bpmn:incoming>seq_2</bpmn:incoming>
      <bpmn:outgoing>seq_3</bpmn:outgoing>
      <bpmn:property id="task_apply_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_apply_dia0">
        <bpmn:sourceRef>doc_job_advertisement</bpmn:sourceRef>
        <bpmn:targetRef>task_apply_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_apply_doa0">
        <bpmn:targetRef>doc_application</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="task_check" name="Check applications">
      <bpmn:incoming>seq_3</bpmn:incoming>
      <bpmn:outgoing>seq_4</bpmn:outgoing>
      <bpmn:property id="task_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_dia0">
        <bpmn:sourceRef>doc_application</bpmn:sourceRef>
        <bpmn:targetRef>task_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_conclude_contract" name="Conclude contract of employment">
      <bpmn:incoming>seq_4</bpmn:incoming>
      <bpmn:outgoing>seq_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_conclude_contract_doa0">
        <bpmn:targetRef>doc_employment_contract</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="seq_1" sourceRef="evt_start" targetRef="task_advertise" />
    <bpmn:sequenceFlow id="seq_2" sourceRef="task_advertise" targetRef="task_apply" />
    <bpmn:sequenceFlow id="seq_3" sourceRef="task_apply" targetRef="task_check" />
    <bpmn:sequenceFlow id="seq_4" sourceRef="task_check" targetRef="task_conclude_contract" />
    <bpmn:sequenceFlow id="seq_5" sourceRef="task_conclude_contract" targetRef="evt_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_di" bpmnElement="evt_end">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_di" bpmnElement="evt_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_advertise_di" bpmnElement="task_advertise">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_apply_di" bpmnElement="task_apply">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_di" bpmnElement="task_check">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_conclude_contract_di" bpmnElement="task_conclude_contract">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_job_advertisement_di" bpmnElement="doc_job_advertisement">
        <dc:Bounds x="465" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_application_di" bpmnElement="doc_application">
        <dc:Bounds x="655" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc_employment_contract_di" bpmnElement="doc_employment_contract">
        <dc:Bounds x="940" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="seq_1_di" bpmnElement="seq_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_2_di" bpmnElement="seq_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_3_di" bpmnElement="seq_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_4_di" bpmnElement="seq_4">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_5_di" bpmnElement="seq_5">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_advertise_doa0_di" bpmnElement="task_advertise_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_apply_dia0_di" bpmnElement="task_apply_dia0">
        <di:waypoint x="483" y="265" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_apply_doa0_di" bpmnElement="task_apply_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="673" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_dia0_di" bpmnElement="task_check_dia0">
        <di:waypoint x="673" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_conclude_contract_doa0_di" bpmnElement="task_conclude_contract_doa0">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="958" y="265" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>