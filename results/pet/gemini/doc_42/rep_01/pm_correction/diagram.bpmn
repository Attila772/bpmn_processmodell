  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="p1_part" name="Grid Operator (GO)" processRef="p1_proc" />
    <bpmn:participant id="p2_part" name="Meter Service Provider (MSP)" processRef="p2_proc" />
    <bpmn:participant id="p3_part" name="Service Provider (SP)" processRef="p3_proc" />
    <bpmn:messageFlow id="mf1" sourceRef="e2" targetRef="e3" name="Measurement Request" />
    <bpmn:messageFlow id="mf2" sourceRef="e4" targetRef="e5" name="Failure Notification" />
    <bpmn:messageFlow id="mf3" sourceRef="e7" targetRef="e8" name="Measured Values" />
    <bpmn:messageFlow id="mf4" sourceRef="e9" targetRef="e10" name="Changed Values" />
    <bpmn:messageFlow id="mf5" sourceRef="e12" targetRef="e13" name="Readings" />
  </bpmn:collaboration>
  <bpmn:process id="p1_proc" isExecutable="false">
    <bpmn:dataObjectReference id="d1" name="Measurement Request" dataObjectRef="d1_do" />
    <bpmn:dataObject id="d1_do" />
    <bpmn:dataObjectReference id="d3_p1" name="Measured Values" dataObjectRef="d3_p1_do" />
    <bpmn:dataObject id="d3_p1_do" />
    <bpmn:dataObjectReference id="d4" name="Changed Values / Readings" dataObjectRef="d4_do" />
    <bpmn:dataObject id="d4_do" />
    <bpmn:startEvent id="e1" name="Start Process">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2" name="Send Measurement Request">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:messageEventDefinition id="e2_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="e5" name="Receive Failure Notification">
      <bpmn:outgoing>sf10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e5_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="e6" name="Process Terminated on Failure">
      <bpmn:incoming>sf10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="e8" name="Receive Measured Values">
      <bpmn:outgoing>sf11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e8_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="e9" name="Send Changed Values">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e9_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="e12" name="Send Readings to SP">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:messageEventDefinition id="e12_msgdef" />
    </bpmn:endEvent>
    <bpmn:task id="t1" name="Request measurements">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_doa0">
        <bpmn:targetRef>d1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t6" name="Process measured values">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:property id="t6_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t6_dia0">
        <bpmn:sourceRef>d3_p1</bpmn:sourceRef>
        <bpmn:targetRef>t6_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t6_doa0">
        <bpmn:targetRef>d4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t7" name="Send changed values to MSP">
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf13</bpmn:outgoing>
      <bpmn:property id="t7_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t7_dia0">
        <bpmn:sourceRef>d4</bpmn:sourceRef>
        <bpmn:targetRef>t7_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t7_doa0">
        <bpmn:targetRef>d4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t8" name="Transmit readings to SP">
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
      <bpmn:property id="t8_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t8_dia0">
        <bpmn:sourceRef>d4</bpmn:sourceRef>
        <bpmn:targetRef>t8_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t8_doa0">
        <bpmn:targetRef>d4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="sf1" sourceRef="e1" targetRef="t1" />
    <bpmn:sequenceFlow id="sf2" sourceRef="t1" targetRef="e2" />
    <bpmn:sequenceFlow id="sf10" sourceRef="e5" targetRef="e6" />
    <bpmn:sequenceFlow id="sf11" sourceRef="e8" targetRef="t6" />
    <bpmn:sequenceFlow id="sf12" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="sf13" sourceRef="t7" targetRef="e9" />
    <bpmn:sequenceFlow id="sf14" sourceRef="e9" targetRef="t8" />
    <bpmn:sequenceFlow id="sf15" sourceRef="t8" targetRef="e12" />
  </bpmn:process>
  <bpmn:process id="p2_proc" isExecutable="false">
    <bpmn:dataObjectReference id="d1_p1" name="Measurement Request" dataObjectRef="d1_p1_do" />
    <bpmn:dataObject id="d1_p1_do" />
    <bpmn:dataObjectReference id="d2" name="Failure Notification" dataObjectRef="d2_do" />
    <bpmn:dataObject id="d2_do" />
    <bpmn:dataObjectReference id="d3" name="Measured Values" dataObjectRef="d3_do" />
    <bpmn:dataObject id="d3_do" />
    <bpmn:startEvent id="e3" name="Receive Measurement Request">
      <bpmn:outgoing>sf3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e3_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="e4" name="Send Failure Notification">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:messageEventDefinition id="e4_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="e7" name="Send Measured Values">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:messageEventDefinition id="e7_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="e10" name="Receive Changed Values">
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="e10_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="e11" name="MSP Process Finished">
      <bpmn:incoming>sf16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t2" name="Check received request">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
      <bpmn:property id="t2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t2_dia0">
        <bpmn:sourceRef>d1_p1</bpmn:sourceRef>
        <bpmn:targetRef>t2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t3" name="Deny request and inform about failure">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t3_doa0">
        <bpmn:targetRef>d2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="t4" name="Perform measurement">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t4_doa0">
        <bpmn:targetRef>d3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="t5" name="Transmit measured values">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
      <bpmn:property id="t5_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t5_dia0">
        <bpmn:sourceRef>d3</bpmn:sourceRef>
        <bpmn:targetRef>t5_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t5_doa0">
        <bpmn:targetRef>d3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Request approved?" isMarkerVisible="true">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
      <bpmn:outgoing>sf7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf3" sourceRef="e3" targetRef="t2" />
    <bpmn:sequenceFlow id="sf4" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="sf5" sourceRef="g1" targetRef="t3" name="Denied" />
    <bpmn:sequenceFlow id="sf6" sourceRef="t3" targetRef="e4" />
    <bpmn:sequenceFlow id="sf7" sourceRef="g1" targetRef="t4" name="Approved" />
    <bpmn:sequenceFlow id="sf8" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="sf9" sourceRef="t5" targetRef="e7" />
    <bpmn:sequenceFlow id="sf16" sourceRef="e10" targetRef="e11" />
  </bpmn:process>
  <bpmn:process id="p3_proc" isExecutable="false">
