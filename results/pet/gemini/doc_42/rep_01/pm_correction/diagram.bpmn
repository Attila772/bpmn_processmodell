    <bpmn:endEvent id="e14" name="SP Process Finished">
      <bpmn:incoming>sf17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf17" sourceRef="e13" targetRef="e14" />
  </bpmn:process>
