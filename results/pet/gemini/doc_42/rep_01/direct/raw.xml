<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn">

  <!-- COLLABORATION -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_GO" name="Grid Operator (GO)" processRef="Process_GO" />
    <bpmn:participant id="Participant_MSP" name="Meter Service Provider (MSP)" processRef="Process_MSP" />
    <bpmn:participant id="Participant_SP" name="Service Provider (SP)" processRef="Process_SP" />
    
    <!-- Message Flows -->
    <bpmn:messageFlow id="MF_Request_Measurements" name="Measurement Request" sourceRef="Task_Request_Measurements" targetRef="Start_MSP" />
    <bpmn:messageFlow id="MF_Denial" name="Request Denial" sourceRef="Task_Deny_Request" targetRef="Event_Receive_Denial" />
    <bpmn:messageFlow id="MF_Failure_Info" name="Failure Info" sourceRef="Task_Inform_Failure" targetRef="Event_Receive_Failure" />
    <bpmn:messageFlow id="MF_Measured_Values" name="Measured Values" sourceRef="Task_Transmit_Values" targetRef="Event_Receive_Values" />
    <bpmn:messageFlow id="MF_Changed_Values" name="Changed Values" sourceRef="Task_Send_Changed_Values" targetRef="Event_Receive_Changed_Values" />
    <bpmn:messageFlow id="MF_Readings_SP" name="Readings" sourceRef="Task_Transmit_Readings_SP" targetRef="Start_SP" />
  </bpmn:collaboration>

  <!-- PROCESS: GO -->
  <bpmn:process id="Process_GO" isExecutable="true">
    <bpmn:startEvent id="Start_GO" name="Process Started">
      <bpmn:outgoing">Flow_GO_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_Request_Measurements" name="Request Measurements from MSP">
      <bpmn:incoming">Flow_GO_1</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:eventBasedGateway id="EventGateway_GO" name="Await Response">
      <bpmn:incoming">Flow_GO_2</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_To_Denial</bpmn:outgoing>
      <bpmn:outgoing">Flow_GO_To_Failure</bpmn:outgoing>
      <bpmn:outgoing">Flow_GO_To_Values</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Branch 1: Denial -->
    <bpmn:intermediateCatchEvent id="Event_Receive_Denial" name="Request Denied">
      <bpmn:incoming">Flow_GO_To_Denial</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_Denial" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_GO_Denied" name="Process Terminated (Request Denied)">
      <bpmn:incoming">Flow_GO_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Branch 2: Failure -->
    <bpmn:intermediateCatchEvent id="Event_Receive_Failure" name="Reading Failed">
      <bpmn:incoming">Flow_GO_To_Failure</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_Failure" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_GO_Failed" name="Process Terminated (Reading Failed)">
      <bpmn:incoming">Flow_GO_4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Branch 3: Success -->
    <bpmn:intermediateCatchEvent id="Event_Receive_Values" name="Measured Values Received">
      <bpmn:incoming">Flow_GO_To_Values</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_Values" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Process_Values" name="Process Measured Values">
      <bpmn:incoming">Flow_GO_5</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sendTask id="Task_Send_Changed_Values" name="Send Changed Values to MSP">
      <bpmn:incoming">Flow_GO_6</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_7</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_Transmit_Readings_SP" name="Transmit Readings to SP">
      <bpmn:incoming">Flow_GO_7</bpmn:incoming>
      <bpmn:outgoing">Flow_GO_8</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_GO_Success" name="Process Completed Successfully">
      <bpmn:incoming">Flow_GO_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows GO -->
    <bpmn:sequenceFlow id="Flow_GO_1" sourceRef="Start_GO" targetRef="Task_Request_Measurements" />
    <bpmn:sequenceFlow id="Flow_GO_2" sourceRef="Task_Request_Measurements" targetRef="EventGateway_GO" />
    <bpmn:sequenceFlow id="Flow_GO_To_Denial" sourceRef="EventGateway_GO" targetRef="Event_Receive_Denial" />
    <bpmn:sequenceFlow id="Flow_GO_To_Failure" sourceRef="EventGateway_GO" targetRef="Event_Receive_Failure" />
    <bpmn:sequenceFlow id="Flow_GO_To_Values" sourceRef="EventGateway_GO" targetRef="Event_Receive_Values" />
    <bpmn:sequenceFlow id="Flow_GO_3" sourceRef="Event_Receive_Denial" targetRef="End_GO_Denied" />
    <bpmn:sequenceFlow id="Flow_GO_4" sourceRef="Event_Receive_Failure" targetRef="End_GO_Failed" />
    <bpmn:sequenceFlow id="Flow_GO_5" sourceRef="Event_Receive_Values" targetRef="Task_Process_Values" />
    <bpmn:sequenceFlow id="Flow_GO_6" sourceRef="Task_Process_Values" targetRef="Task_Send_Changed_Values" />
    <bpmn:sequenceFlow id="Flow_GO_7" sourceRef="Task_Send_Changed_Values" targetRef="Task_Transmit_Readings_SP" />
    <bpmn:sequenceFlow id="Flow_GO_8" sourceRef="Task_Transmit_Readings_SP" targetRef="End_GO_Success" />
  </bpmn:process>

  <!-- PROCESS: MSP -->
  <bpmn:process id="Process_MSP" isExecutable="true">
    <bpmn:startEvent id="Start_MSP" name="Measurement Request Received">
      <bpmn:outgoing">Flow_MSP_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_StartMSP" />
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Check_Request" name="Check Received Request">
      <bpmn:incoming">Flow_MSP_1</bpmn:incoming>
      <bpmn:outgoing">Flow_MSP_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Request_Approved" name="Is Request Approved?">
      <bpmn:incoming">Flow_MSP_2</bpmn:incoming>
      <bpmn:outgoing">Flow_MSP_Denied</bpmn:outgoing>
      <bpmn:outgoing">Flow_MSP_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_Deny_Request" name="Deny Request of GO">
      <bpmn:incoming">Flow_MSP_Denied</bpmn:incoming>
      <bpmn:outgoing">Flow_MSP_3</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_MSP_Denied" name="Request Denied">
      <bpmn:incoming">Flow_MSP_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Perform_Measurement" name="Perform Measurement">
      <bpmn:incoming">Flow_MSP_Approved</bpmn:incoming>
      <bpmn:outgoing">Flow_MSP_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Measurement_Successful" name="Is Measurement Successful?">
      <bpmn:incoming">Flow_MSP_4</bpmn:incoming>
      <bpmn:outgoing">Flow_MSP_Failed</bpmn:outgoing>
      <bpmn:outgoing">Flow_MSP_Success</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_Inform_Failure" name="Inform GO About Failure">
      <bpmn:incoming">Flow_MSP_Failed</bpmn:incoming>
      <bpmn:outgoing">Flow_MSP_5</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_MSP_Failed" name="Measurement Failed">
      <bpmn:incoming">Flow_MSP_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_Transmit_Values" name="Transmit Measured Values to GO">
      <bpmn:incoming">Flow_MSP_Success</bpmn:incoming>
      <bpmn:outgoing">Flow_MSP_6</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_Receive_Changed_Values" name="Changed Values Received">
      <bpmn:incoming">Flow_MSP_6</bpmn:incoming>
      <bpmn:outgoing">Flow_MSP_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_Changed_Values" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_MSP_Success" name="Measurement Process Finished">
      <bpmn:incoming">Flow_MSP_7</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows MSP -->
    <bpmn:sequenceFlow id="Flow_MSP_1" sourceRef="Start_MSP" targetRef="Task_Check_Request" />
    <bpmn:sequenceFlow id="Flow_MSP_2" sourceRef="Task_Check_Request" targetRef="Gateway_Request_Approved" />
    <bpmn:sequenceFlow id="Flow_MSP_Denied" name="No" sourceRef="Gateway_Request_Approved" targetRef="Task_Deny_Request" />
    <bpmn:sequenceFlow id="Flow_MSP_Approved" name="Yes" sourceRef="Gateway_Request_Approved" targetRef="Task_Perform_Measurement" />
    <bpmn:sequenceFlow id="Flow_MSP_3" sourceRef="Task_Deny_Request" targetRef="End_MSP_Denied" />
    <bpmn:sequenceFlow id="Flow_MSP_4" sourceRef="Task_Perform_Measurement" targetRef="Gateway_Measurement_Successful" />
    <bpmn:sequenceFlow id="Flow_MSP_Failed" name="No" sourceRef="Gateway_Measurement_Successful" targetRef="Task_Inform_Failure" />
    <bpmn:sequenceFlow id="Flow_MSP_Success" name="Yes" sourceRef="Gateway_Measurement_Successful" targetRef="Task_Transmit_Values" />
    <bpmn:sequenceFlow id="Flow_MSP_5" sourceRef="Task_Inform_Failure" targetRef="End_MSP_Failed" />
    <bpmn:sequenceFlow id="Flow_MSP_6" sourceRef="Task_Transmit_Values" targetRef="Event_Receive_Changed_Values" />
    <bpmn:sequenceFlow id="Flow_MSP_7" sourceRef="Event_Receive_Changed_Values" targetRef="End_MSP_Success" />
  </bpmn:process>

  <!-- PROCESS: SP -->
  <bpmn:process id="Process_SP" isExecutable="true">
    <bpmn:startEvent id="Start_SP" name="Readings Received">
      <bpmn:outgoing">Flow_SP_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_StartSP" />
    </bpmn:startEvent>

    <bpmn:endEvent id="End_SP" name="Readings Processed">
      <bpmn:incoming">Flow_SP_1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_SP_1" sourceRef="Start_SP" targetRef="End_SP" />
  </bpmn:process>

