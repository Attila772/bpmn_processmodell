<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf_mpon_to_go_report" sourceRef="msg_send_report" targetRef="start_go" name="Meter Operation Report / Application" />
    <bpmn:messageFlow id="mf_go_to_mpon_rej" sourceRef="msg_send_app_rej" targetRef="msg_rec_reg_conf" name="Application Rejection" />
    <bpmn:messageFlow id="mf_go_to_mpon_conf" sourceRef="msg_send_mpon_conf" targetRef="msg_rec_reg_conf" name="Registration Confirmation" />
    <bpmn:messageFlow id="mf_go_to_mpoo_conf" sourceRef="msg_send_mpoo_conf" targetRef="start_mpoo" name="Registration Confirmation" />
    <bpmn:messageFlow id="mf_go_to_mspo_conf" sourceRef="msg_send_mspo_conf" targetRef="start_mspo" name="Registration Confirmation" />
    <bpmn:messageFlow id="mf_mpon_to_go_result" sourceRef="msg_send_proc_result" targetRef="msg_rec_mpon_result" name="Process Success/Failure Notification" />
    <bpmn:messageFlow id="mf_go_to_mpon_fail" sourceRef="msg_send_failure_conf_mpon" targetRef="msg_rec_final_conf" name="Failure Confirmation / Deadline Timeout Notice" />
    <bpmn:messageFlow id="mf_go_to_mpoo_fail" sourceRef="msg_send_mpoo_fail" targetRef="msg_rec_mpoo_outcome" name="Failure Notice" />
    <bpmn:messageFlow id="mf_go_to_mspo_fail" sourceRef="msg_send_mspo_fail" targetRef="msg_rec_mspo_outcome" name="Failure Notice" />
    <bpmn:messageFlow id="mf_go_to_mpon_assign" sourceRef="msg_send_assign_conf_mpon" targetRef="msg_rec_final_conf" name="Assignment Confirmation" />
    <bpmn:messageFlow id="mf_go_to_mpoo_assign" sourceRef="msg_send_mpoo_assign" targetRef="msg_rec_mpoo_outcome" name="Assignment Notice" />
    <bpmn:messageFlow id="mf_go_to_mspo_assign" sourceRef="msg_send_mspo_assign" targetRef="msg_rec_mspo_outcome" name="Assignment Notice" />
    <bpmn:messageFlow id="mf_go_to_sp_assign" sourceRef="msg_send_sp_assign" targetRef="start_sp" name="Assignment Notice" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_app" name="Application Application / Meter Operation Report" dataObjectRef="doc_app_do" />
    <bpmn:dataObject id="doc_app_do" />
    <bpmn:startEvent id="start_mpon" name="Meter Operation Need Identified">
      <bpmn:outgoing>sf_mpon_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_app_rejected_mpon" name="Application Rejected">
      <bpmn:incoming>sf_mpon_reg_rej</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_process_failed_mpon" name="Process Failed">
      <bpmn:incoming>sf_mpon_final_fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_process_success_mpon" name="Process Completed Successfully">
      <bpmn:incoming>sf_mpon_final_success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="msg_send_report" name="Send Meter Operation Report">
      <bpmn:incoming>sf_mpon_2</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_report_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_rec_reg_conf" name="Receive Registration Decision">
      <bpmn:incoming>sf_mpon_3</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_rec_reg_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_proc_result" name="Send Process Execution Result">
      <bpmn:incoming>sf_mpon_fail</bpmn:incoming>
      <bpmn:incoming>sf_mpon_success</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_proc_result_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_rec_final_conf" name="Receive Final Assignment Confirmation">
      <bpmn:incoming>sf_mpon_6</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_rec_final_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="task_mpon_report" name="Report meter operation to GO">
      <bpmn:incoming>sf_mpon_1</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mpon_report_doa0">
        <bpmn:targetRef>doc_app</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_mpon_acq" name="Perform equipment acquisition and/or equipment changes (MPON)">
      <bpmn:incoming>sf_mpon_reg_conf</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gtw_mpon_eval_reg" name="Registration Status?" isMarkerVisible="true">
      <bpmn:incoming>sf_mpon_4</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_reg_rej</bpmn:outgoing>
      <bpmn:outgoing>sf_mpon_reg_conf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_mpon_acq_outcome" name="Acquisition Outcome?" isMarkerVisible="true">
      <bpmn:incoming>sf_mpon_5</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_fail</bpmn:outgoing>
      <bpmn:outgoing>sf_mpon_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gtw_mpon_final_outcome" name="Final Outcome Decision?" isMarkerVisible="true">
      <bpmn:incoming>sf_mpon_7</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_final_fail</bpmn:outgoing>
      <bpmn:outgoing>sf_mpon_final_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_mpon_1" sourceRef="start_mpon" targetRef="task_mpon_report" />
    <bpmn:sequenceFlow id="sf_mpon_2" sourceRef="task_mpon_report" targetRef="msg_send_report" />
    <bpmn:sequenceFlow id="sf_mpon_3" sourceRef="msg_send_report" targetRef="msg_rec_reg_conf" />
    <bpmn:sequenceFlow id="sf_mpon_4" sourceRef="msg_rec_reg_conf" targetRef="gtw_mpon_eval_reg" />
    <bpmn:sequenceFlow id="sf_mpon_reg_rej" sourceRef="gtw_mpon_eval_reg" targetRef="end_app_rejected_mpon" name="Application Rejected" />
    <bpmn:sequenceFlow id="sf_mpon_reg_conf" sourceRef="gtw_mpon_eval_reg" targetRef="task_mpon_acq" name="Application Confirmed" />
    <bpmn:sequenceFlow id="sf_mpon_5" sourceRef="task_mpon_acq" targetRef="gtw_mpon_acq_outcome" />
    <bpmn:sequenceFlow id="sf_mpon_fail" sourceRef="gtw_mpon_acq_outcome" targetRef="msg_send_proc_result" name="Failure" />
    <bpmn:sequenceFlow id="sf_mpon_success" sourceRef="gtw_mpon_acq_outcome" targetRef="msg_send_proc_result" name="Success" />
    <bpmn:sequenceFlow id="sf_mpon_6" sourceRef="msg_send_proc_result" targetRef="msg_rec_final_conf" />
    <bpmn:sequenceFlow id="sf_mpon_7" sourceRef="msg_rec_final_conf" targetRef="gtw_mpon_final_outcome" />
    <bpmn:sequenceFlow id="sf_mpon_final_fail" sourceRef="gtw_mpon_final_outcome" targetRef="end_process_failed_mpon" name="Failed" />
    <bpmn:sequenceFlow id="sf_mpon_final_success" sourceRef="gtw_mpon_final_outcome" targetRef="end_process_success_mpon" name="Successful" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="doc_app_p1" name="Application Application / Meter Operation Report" dataObjectRef="doc_app_p1_do" />
    <bpmn:dataObject id="doc_app_p1_do" />
    <bpmn:startEvent id="start_go" name="Receive Application Report">
      <bpmn:outgoing>sf_go_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_go_rej" name="Application Rejected End">
      <bpmn:incoming>sf_go_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go_failed" name="Process Failed End">
      <bpmn:incoming>sf_go_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go_assigned" name="Assignment Completed End">
      <bpmn:incoming>sf_go_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="msg_send_app_rej" name="Send Application Rejection">
      <bpmn:incoming>sf_app_rej</bpmn:incoming>
      <bpmn:outgoing>sf_go_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_app_rej_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_mpon_conf" name="Send Confirmation to MPON">
      <bpmn:incoming>sf_go_par_1</bpmn:incoming>
      <bpmn:outgoing>sf_go_join_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_mpon_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_mpoo_conf" name="Inform MPOO of Registration">
      <bpmn:incoming>sf_go_par_2</bpmn:incoming>
      <bpmn:outgoing>sf_go_join_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_mpoo_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_mspo_conf" name="Inform MSPO of Registration">
      <bpmn:incoming>sf_go_par_3</bpmn:incoming>
      <bpmn:outgoing>sf_go_join_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_mspo_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_rec_mpon_result" name="Receive Execution Result / Timeout">
      <bpmn:incoming>sf_go_4</bpmn:incoming>
      <bpmn:outgoing>sf_go_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_rec_mpon_result_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_failure_conf_mpon" name="Confirm Failure to MPON">
      <bpmn:incoming>sf_go_fail_1</bpmn:incoming>
      <bpmn:outgoing>sf_go_fail_j1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_failure_conf_mpon_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_mpoo_fail" name="Inform MPOO of Failure">
      <bpmn:incoming>sf_go_fail_2</bpmn:incoming>
      <bpmn:outgoing>sf_go_fail_j2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_mpoo_fail_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_mspo_fail" name="Inform MSPO of Failure">
      <bpmn:incoming>sf_go_fail_3</bpmn:incoming>
      <bpmn:outgoing>sf_go_fail_j3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_mspo_fail_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_assign_conf_mpon" name="Confirm Assignment to MPON">
      <bpmn:incoming>sf_go_ass_1</bpmn:incoming>
      <bpmn:outgoing>sf_go_ass_j1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_assign_conf_mpon_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_mpoo_assign" name="Inform MPOO of Assignment">
      <bpmn:incoming>sf_go_ass_2</bpmn:incoming>
      <bpmn:outgoing>sf_go_ass_j2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_mpoo_assign_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_mspo_assign" name="Inform MSPO of Assignment">
      <bpmn:incoming>sf_go_ass_3</bpmn:incoming>
      <bpmn:outgoing>sf_go_ass_j3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_mspo_assign_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_send_sp_assign" name="Inform SP of Assignment">
      <bpmn:incoming>sf_go_ass_4</bpmn:incoming>
      <bpmn:outgoing>sf_go_ass_j4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_send_sp_assign_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="task_go_examine" name="Examine application of MPON">
      <bpmn:incoming>sf_go_1</bpmn:incoming>
      <bpmn:outgoing>sf_go_2</bpmn:outgoing>
      <bpmn:property id="task_go_examine_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_go_examine_dia0">
        <bpmn:sourceRef>doc_app_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_go_examine_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="task_go_assign" name="Assign MPON">
      <bpmn:incoming>sf_go_outcome_success</bpmn:incoming>
      <bpmn:outgoing>sf_go_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gtw_app_decision" name="Application Decision?" isMarkerVisible="true">
      <bpmn:incoming>sf_go_2</bpmn:incoming>
      <bpmn:outgoing>sf_app_rej</bpmn:outgoing>
      <bpmn:outgoing>sf_app_conf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gtw_go_par_inform" name="Parallel Registration Notification">
      <bpmn:incoming>sf_app_conf</bpmn:incoming>
      <bpmn:outgoing>sf_go_par_1</bpmn:outgoing>
      <bpmn:outgoing>sf_go_par_2</bpmn:outgoing>
      <bpmn:outgoing>sf_go_par_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gtw_go_par_inform_join" name="Join Registration Notification">
      <bpmn:incoming>sf_go_join_1</bpmn:incoming>
      <bpmn:incoming>sf_go_join_2</bpmn:incoming>
      <bpmn:incoming>sf_go_join_3</bpmn:incoming>
      <bpmn:outgoing>sf_go_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gtw_go_proc_outcome" name="Process Outcome?" isMarkerVisible="true">
      <bpmn:incoming>sf_go_5</bpmn:incoming>
      <bpmn:outgoing>sf_go_outcome_fail</bpmn:outgoing>
      <bpmn:outgoing>sf_go_outcome_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gtw_go_par_fail" name="Parallel Failure Notification">
      <bpmn:incoming>sf_go_outcome_fail</bpmn:incoming>
      <bpmn:outgoing>sf_go_fail_1</bpmn:outgoing>
      <bpmn:outgoing>sf_go_fail_2</bpmn:outgoing>
      <bpmn:outgoing>sf_go_fail_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gtw_go_par_fail_join" name="Join Failure Notification">
      <bpmn:incoming>sf_go_fail_j1</bpmn:incoming>
      <bpmn:incoming>sf_go_fail_j2</bpmn:incoming>
      <bpmn:incoming>sf_go_fail_j3</bpmn:incoming>
      <bpmn:outgoing>sf_go_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gtw_go_par_assign" name="Parallel Assignment Notification">
      <bpmn:incoming>sf_go_7</bpmn:incoming>
      <bpmn:outgoing>sf_go_ass_1</bpmn:outgoing>
      <bpmn:outgoing>sf_go_ass_2</bpmn:outgoing>
      <bpmn:outgoing>sf_go_ass_3</bpmn:outgoing>
      <bpmn:outgoing>sf_go_ass_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gtw_go_par_assign_join" name="Join Assignment Notification">
      <bpmn:incoming>sf_go_ass_j1</bpmn:incoming>
      <bpmn:incoming>sf_go_ass_j2</bpmn:incoming>
      <bpmn:incoming>sf_go_ass_j3</bpmn:incoming>
      <bpmn:incoming>sf_go_ass_j4</bpmn:incoming>
      <bpmn:outgoing>sf_go_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="sf_go_1" sourceRef="start_go" targetRef="task_go_examine" />
    <bpmn:sequenceFlow id="sf_go_2" sourceRef="task_go_examine" targetRef="gtw_app_decision" />
    <bpmn:sequenceFlow id="sf_app_rej" sourceRef="gtw_app_decision" targetRef="msg_send_app_rej" name="Rejected" />
    <bpmn:sequenceFlow id="sf_go_3" sourceRef="msg_send_app_rej" targetRef="end_go_rej" />
    <bpmn:sequenceFlow id="sf_app_conf" sourceRef="gtw_app_decision" targetRef="gtw_go_par_inform" name="Confirmed" />
    <bpmn:sequenceFlow id="sf_go_par_1" sourceRef="gtw_go_par_inform" targetRef="msg_send_mpon_conf" />
    <bpmn:sequenceFlow id="sf_go_par_2" sourceRef="gtw_go_par_inform" targetRef="msg_send_mpoo_conf" />
    <bpmn:sequenceFlow id="sf_go_par_3" sourceRef="gtw_go_par_inform" targetRef="msg_send_mspo_conf" />
    <bpmn:sequenceFlow id="sf_go_join_1" sourceRef="msg_send_mpon_conf" targetRef="gtw_go_par_inform_join" />
    <bpmn:sequenceFlow id="sf_go_join_2" sourceRef="msg_send_mpoo_conf" targetRef="gtw_go_par_inform_join" />
    <bpmn:sequenceFlow id="sf_go_join_3" sourceRef="msg_send_mspo_conf" targetRef="gtw_go_par_inform_join" />
    <bpmn:sequenceFlow id="sf_go_4" sourceRef="gtw_go_par_inform_join" targetRef="msg_rec_mpon_result" />
    <bpmn:sequenceFlow id="sf_go_5" sourceRef="msg_rec_mpon_result" targetRef="gtw_go_proc_outcome" />
    <bpmn:sequenceFlow id="sf_go_outcome_fail" sourceRef="gtw_go_proc_outcome" targetRef="gtw_go_par_fail" name="Failure or Deadline Timeout" />
    <bpmn:sequenceFlow id="sf_go_fail_1" sourceRef="gtw_go_par_fail" targetRef="msg_send_failure_conf_mpon" />
    <bpmn:sequenceFlow id="sf_go_fail_2" sourceRef="gtw_go_par_fail" targetRef="msg_send_mpoo_fail" />
    <bpmn:sequenceFlow id="sf_go_fail_3" sourceRef="gtw_go_par_fail" targetRef="msg_send_mspo_fail" />
    <bpmn:sequenceFlow id="sf_go_fail_j1" sourceRef="msg_send_failure_conf_mpon" targetRef="gtw_go_par_fail_join" />
    <bpmn:sequenceFlow id="sf_go_fail_j2" sourceRef="msg_send_mpoo_fail" targetRef="gtw_go_par_fail_join" />
    <bpmn:sequenceFlow id="sf_go_fail_j3" sourceRef="msg_send_mspo_fail" targetRef="gtw_go_par_fail_join" />
    <bpmn:sequenceFlow id="sf_go_6" sourceRef="gtw_go_par_fail_join" targetRef="end_go_failed" />
    <bpmn:sequenceFlow id="sf_go_outcome_success" sourceRef="gtw_go_proc_outcome" targetRef="task_go_assign" name="Successful Completion" />
    <bpmn:sequenceFlow id="sf_go_7" sourceRef="task_go_assign" targetRef="gtw_go_par_assign" />
    <bpmn:sequenceFlow id="sf_go_ass_1" sourceRef="gtw_go_par_assign" targetRef="msg_send_assign_conf_mpon" />
    <bpmn:sequenceFlow id="sf_go_ass_2" sourceRef="gtw_go_par_assign" targetRef="msg_send_mpoo_assign" />
    <bpmn:sequenceFlow id="sf_go_ass_3" sourceRef="gtw_go_par_assign" targetRef="msg_send_mspo_assign" />
    <bpmn:sequenceFlow id="sf_go_ass_4" sourceRef="gtw_go_par_assign" targetRef="msg_send_sp_assign" />
    <bpmn:sequenceFlow id="sf_go_ass_j1" sourceRef="msg_send_assign_conf_mpon" targetRef="gtw_go_par_assign_join" />
    <bpmn:sequenceFlow id="sf_go_ass_j2" sourceRef="msg_send_mpoo_assign" targetRef="gtw_go_par_assign_join" />
    <bpmn:sequenceFlow id="sf_go_ass_j3" sourceRef="msg_send_mspo_assign" targetRef="gtw_go_par_assign_join" />
    <bpmn:sequenceFlow id="sf_go_ass_j4" sourceRef="msg_send_sp_assign" targetRef="gtw_go_par_assign_join" />
    <bpmn:sequenceFlow id="sf_go_8" sourceRef="gtw_go_par_assign_join" targetRef="end_go_assigned" />
  </bpmn:process>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:startEvent id="start_mpoo" name="Registration Notice Received">
      <bpmn:outgoing>sf_mpoo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpoo_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="msg_rec_mpoo_outcome" name="Receive Final Assignment Outcome">
      <bpmn:incoming>sf_mpoo_2</bpmn:incoming>
      <bpmn:outgoing>sf_mpoo_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_rec_mpoo_outcome_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_mpoo" name="MPOO Process Ended">
      <bpmn:incoming>sf_mpoo_3</bpmn:incoming>
