<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_mspo_part" name="MSPO" processRef="pool_mspo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="mf_1" sourceRef="msg_mpon_send_report" targetRef="start_go" name="Application of MPON" />
    <bpmn:messageFlow id="mf_2" sourceRef="msg_go_send_mpon_reject" targetRef="msg_mpon_recv_conf" name="Rejection of Application" />
    <bpmn:messageFlow id="mf_3" sourceRef="msg_go_send_mpon_conf" targetRef="msg_mpon_recv_conf" name="Confirmation of Application" />
    <bpmn:messageFlow id="mf_4" sourceRef="msg_go_send_mpoo_conf" targetRef="start_mpoo_conf" name="Registration Confirmation" />
    <bpmn:messageFlow id="mf_5" sourceRef="msg_go_send_mspo_conf" targetRef="start_mspo_conf" name="Registration Confirmation" />
    <bpmn:messageFlow id="mf_6" sourceRef="msg_mpon_send_status" targetRef="msg_go_recv_status" name="Process Outcome Message" />
    <bpmn:messageFlow id="mf_7" sourceRef="msg_go_send_mpon_timeout" targetRef="end_mpon_failed" name="Failure by Deadline Notification" />
    <bpmn:messageFlow id="mf_8" sourceRef="msg_go_send_mpon_fail_ack" targetRef="msg_mpon_recv_final_ack" name="Confirmation of Failure of Assignment" />
    <bpmn:messageFlow id="mf_9" sourceRef="msg_go_send_mpon_assign_ack" targetRef="msg_mpon_recv_final_ack" name="Confirmation of Assignment" />
    <bpmn:messageFlow id="mf_10" sourceRef="msg_go_send_sp_assign" targetRef="start_sp" name="Assignment Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_application" name="Meter Operation Application" dataObjectRef="data_application_do" />
    <bpmn:dataObject id="data_application_do" />
    <bpmn:startEvent id="start_mpon" name="Start Meter Operation Process">
      <bpmn:outgoing>sf_mpon_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpon_rejected" name="Application Rejected">
      <bpmn:incoming>sf_mpon_app_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_mpon_failed" name="Process Failed">
    </bpmn:endEvent>
    <bpmn:endEvent id="end_mpon_assigned" name="Assignment Completed">
      <bpmn:incoming>sf_mpon_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="msg_mpon_send_report" name="Send Application to GO">
      <bpmn:incoming>sf_mpon_2</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_mpon_send_report_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_mpon_recv_conf" name="Receive Confirmation/Rejection">
      <bpmn:incoming>sf_mpon_3</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_mpon_recv_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_mpon_send_status" name="Send Process Status to GO">
      <bpmn:incoming>sf_mpon_exec_failed</bpmn:incoming>
      <bpmn:incoming>sf_mpon_exec_success</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_mpon_send_status_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_mpon_recv_final_ack" name="Receive Final Confirmation">
      <bpmn:incoming>sf_mpon_6</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_mpon_recv_final_ack_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="task_mpon_report" name="Report meter operation to GO">
      <bpmn:incoming>sf_mpon_1</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mpon_report_doa0">
        <bpmn:targetRef>data_application</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="task_mpon_equip" name="Perform equipment acquisition and / or equipment changes">
      <bpmn:incoming>sf_mpon_app_confirmed</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_mpon_check_app" name="Application Confirmed?" isMarkerVisible="true">
      <bpmn:incoming>sf_mpon_4</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_app_rejected</bpmn:outgoing>
      <bpmn:outgoing>sf_mpon_app_confirmed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_mpon_exec_status" name="Process Execution Result" isMarkerVisible="true">
      <bpmn:incoming>sf_mpon_5</bpmn:incoming>
      <bpmn:outgoing>sf_mpon_exec_failed</bpmn:outgoing>
      <bpmn:outgoing>sf_mpon_exec_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_mpon_1" sourceRef="start_mpon" targetRef="task_mpon_report" />
    <bpmn:sequenceFlow id="sf_mpon_2" sourceRef="task_mpon_report" targetRef="msg_mpon_send_report" />
    <bpmn:sequenceFlow id="sf_mpon_3" sourceRef="msg_mpon_send_report" targetRef="msg_mpon_recv_conf" />
    <bpmn:sequenceFlow id="sf_mpon_4" sourceRef="msg_mpon_recv_conf" targetRef="gw_mpon_check_app" />
    <bpmn:sequenceFlow id="sf_mpon_app_rejected" sourceRef="gw_mpon_check_app" targetRef="end_mpon_rejected" name="Rejected" />
    <bpmn:sequenceFlow id="sf_mpon_app_confirmed" sourceRef="gw_mpon_check_app" targetRef="task_mpon_equip" name="Confirmed" />
    <bpmn:sequenceFlow id="sf_mpon_5" sourceRef="task_mpon_equip" targetRef="gw_mpon_exec_status" />
    <bpmn:sequenceFlow id="sf_mpon_exec_failed" sourceRef="gw_mpon_exec_status" targetRef="msg_mpon_send_status" name="Failure of entire process" />
    <bpmn:sequenceFlow id="sf_mpon_exec_success" sourceRef="gw_mpon_exec_status" targetRef="msg_mpon_send_status" name="Successful completion" />
    <bpmn:sequenceFlow id="sf_mpon_6" sourceRef="msg_mpon_send_status" targetRef="msg_mpon_recv_final_ack" />
    <bpmn:sequenceFlow id="sf_mpon_7" sourceRef="msg_mpon_recv_final_ack" targetRef="end_mpon_assigned" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_application_p1" name="Meter Operation Application" dataObjectRef="data_application_p1_do" />
    <bpmn:dataObject id="data_application_p1_do" />
    <bpmn:startEvent id="start_go" name="Meter Operation Reported">
      <bpmn:outgoing>sf_go_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_go_rejected" name="Application Rejected Process End">
      <bpmn:incoming>sf_go_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go_failed" name="Overall Process Failed">
      <bpmn:incoming>sf_go_5</bpmn:incoming>
      <bpmn:incoming>sf_go_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_go_assigned" name="MPON Assigned Process End">
      <bpmn:incoming>sf_go_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mpoo_conf" name="Inform MPOO about Registration Confirmation">
      <bpmn:incoming>sf_go_p2</bpmn:incoming>
      <bpmn:outgoing>sf_go_p5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mpoo_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mspo_conf" name="Inform MSPO about Registration Confirmation">
      <bpmn:incoming>sf_go_p3</bpmn:incoming>
      <bpmn:outgoing>sf_go_p6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mspo_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mpon_conf" name="Inform MPON about Confirmation">
      <bpmn:incoming>sf_go_p1</bpmn:incoming>
      <bpmn:outgoing>sf_go_p4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mpon_conf_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mpon_reject" name="Inform MPON about Rejection">
      <bpmn:incoming>sf_go_reject</bpmn:incoming>
      <bpmn:outgoing>sf_go_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mpon_reject_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_recv_status" name="Receive Completion Status from MPON">
      <bpmn:incoming>sf_go_msg_received</bpmn:incoming>
      <bpmn:outgoing>sf_go_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_recv_status_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mpon_timeout" name="Inform MPON about Failure by Deadline">
      <bpmn:incoming>sf_go_timeout</bpmn:incoming>
      <bpmn:outgoing>sf_go_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mpon_timeout_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mpon_fail_ack" name="Confirm Failure of Assignment to MPON">
      <bpmn:incoming>sf_go_ff1</bpmn:incoming>
      <bpmn:outgoing>sf_go_ff4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mpon_fail_ack_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mpon_assign_ack" name="Confirm Assignment to MPON">
      <bpmn:incoming>sf_go_fs1</bpmn:incoming>
      <bpmn:outgoing>sf_go_fs5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mpon_assign_ack_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mpoo_fail" name="Inform MPOO about Failure of Assignment">
      <bpmn:incoming>sf_go_ff2</bpmn:incoming>
      <bpmn:outgoing>sf_go_ff5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mpoo_fail_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mpoo_assign" name="Inform MPOO about Assignment of MPON">
      <bpmn:incoming>sf_go_fs2</bpmn:incoming>
      <bpmn:outgoing>sf_go_fs6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mpoo_assign_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mspo_fail" name="Inform MSPO about Failure of Assignment">
      <bpmn:incoming>sf_go_ff3</bpmn:incoming>
      <bpmn:outgoing>sf_go_ff6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mspo_fail_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_mspo_assign" name="Inform MSPO about Assignment of MPON">
      <bpmn:incoming>sf_go_fs3</bpmn:incoming>
      <bpmn:outgoing>sf_go_fs7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_mspo_assign_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="msg_go_send_sp_assign" name="Inform SP about Assignment of MPON">
      <bpmn:incoming>sf_go_fs4</bpmn:incoming>
      <bpmn:outgoing>sf_go_fs8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msg_go_send_sp_assign_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_go_examine" name="Examine application of MPON">
      <bpmn:incoming>sf_go_1</bpmn:incoming>
      <bpmn:outgoing>sf_go_2</bpmn:outgoing>
      <bpmn:property id="task_go_examine_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_go_examine_dia0">
        <bpmn:sourceRef>data_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_go_examine_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_go_assign" name="Assign MPON">
      <bpmn:incoming>sf_go_status_success</bpmn:incoming>
      <bpmn:outgoing>sf_go_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_go_app_decision" name="Application Decision" isMarkerVisible="true">
      <bpmn:incoming>sf_go_2</bpmn:incoming>
      <bpmn:outgoing>sf_go_reject</bpmn:outgoing>
      <bpmn:outgoing>sf_go_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_go_parallel_inform_start" name="Inform Parties Split">
      <bpmn:incoming>sf_go_confirm</bpmn:incoming>
      <bpmn:outgoing>sf_go_p1</bpmn:outgoing>
      <bpmn:outgoing>sf_go_p2</bpmn:outgoing>
      <bpmn:outgoing>sf_go_p3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_go_parallel_inform_join" name="Inform Parties Join">
      <bpmn:incoming>sf_go_p4</bpmn:incoming>
      <bpmn:incoming>sf_go_p5</bpmn:incoming>
      <bpmn:incoming>sf_go_p6</bpmn:incoming>
      <bpmn:outgoing>sf_go_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gw_go_receive_outcome" name="Message Received in Time?" isMarkerVisible="true">
      <bpmn:incoming>sf_go_4</bpmn:incoming>
      <bpmn:outgoing>sf_go_timeout</bpmn:outgoing>
      <bpmn:outgoing>sf_go_msg_received</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_go_status_check" name="Execution Outcome from MPON" isMarkerVisible="true">
      <bpmn:incoming>sf_go_6</bpmn:incoming>
      <bpmn:outgoing>sf_go_status_failure</bpmn:outgoing>
      <bpmn:outgoing>sf_go_status_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_go_parallel_final_fail_start" name="Parallel Fail Inform Split">
      <bpmn:incoming>sf_go_status_failure</bpmn:incoming>
      <bpmn:outgoing>sf_go_ff1</bpmn:outgoing>
      <bpmn:outgoing>sf_go_ff2</bpmn:outgoing>
      <bpmn:outgoing>sf_go_ff3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_go_parallel_final_fail_join" name="Parallel Fail Inform Join">
      <bpmn:incoming>sf_go_ff4</bpmn:incoming>
      <bpmn:incoming>sf_go_ff5</bpmn:incoming>
      <bpmn:incoming>sf_go_ff6</bpmn:incoming>
      <bpmn:outgoing>sf_go_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_go_parallel_final_succ_start" name="Parallel Success Inform Split">
      <bpmn:incoming>sf_go_8</bpmn:incoming>
      <bpmn:outgoing>sf_go_fs1</bpmn:outgoing>
      <bpmn:outgoing>sf_go_fs2</bpmn:outgoing>
      <bpmn:outgoing>sf_go_fs3</bpmn:outgoing>
      <bpmn:outgoing>sf_go_fs4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_go_parallel_final_succ_join" name="Parallel Success Inform Join">
      <bpmn:incoming>sf_go_fs5</bpmn:incoming>
      <bpmn:incoming>sf_go_fs6</bpmn:incoming>
      <bpmn:incoming>sf_go_fs7</bpmn:incoming>
      <bpmn:incoming>sf_go_fs8</bpmn:incoming>
      <bpmn:outgoing>sf_go_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="sf_go_1" sourceRef="start_go" targetRef="task_go_examine" />
    <bpmn:sequenceFlow id="sf_go_2" sourceRef="task_go_examine" targetRef="gw_go_app_decision" />
    <bpmn:sequenceFlow id="sf_go_reject" sourceRef="gw_go_app_decision" targetRef="msg_go_send_mpon_reject" name="Reject application" />
    <bpmn:sequenceFlow id="sf_go_3" sourceRef="msg_go_send_mpon_reject" targetRef="end_go_rejected" />
    <bpmn:sequenceFlow id="sf_go_confirm" sourceRef="gw_go_app_decision" targetRef="gw_go_parallel_inform_start" name="Confirm application" />
    <bpmn:sequenceFlow id="sf_go_p1" sourceRef="gw_go_parallel_inform_start" targetRef="msg_go_send_mpon_conf" />
    <bpmn:sequenceFlow id="sf_go_p2" sourceRef="gw_go_parallel_inform_start" targetRef="msg_go_send_mpoo_conf" />
    <bpmn:sequenceFlow id="sf_go_p3" sourceRef="gw_go_parallel_inform_start" targetRef="msg_go_send_mspo_conf" />
    <bpmn:sequenceFlow id="sf_go_p4" sourceRef="msg_go_send_mpon_conf" targetRef="gw_go_parallel_inform_join" />
    <bpmn:sequenceFlow id="sf_go_p5" sourceRef="msg_go_send_mpoo_conf" targetRef="gw_go_parallel_inform_join" />
    <bpmn:sequenceFlow id="sf_go_p6" sourceRef="msg_go_send_mspo_conf" targetRef="gw_go_parallel_inform_join" />
    <bpmn:sequenceFlow id="sf_go_4" sourceRef="gw_go_parallel_inform_join" targetRef="gw_go_receive_outcome" />
    <bpmn:sequenceFlow id="sf_go_timeout" sourceRef="gw_go_receive_outcome" targetRef="msg_go_send_mpon_timeout" name="No message after maximum time limit" />
    <bpmn:sequenceFlow id="sf_go_5" sourceRef="msg_go_send_mpon_timeout" targetRef="end_go_failed" />
    <bpmn:sequenceFlow id="sf_go_msg_received" sourceRef="gw_go_receive_outcome" targetRef="msg_go_recv_status" name="Message received" />
    <bpmn:sequenceFlow id="sf_go_6" sourceRef="msg_go_recv_status" targetRef="gw_go_status_check" />
    <bpmn:sequenceFlow id="sf_go_status_failure" sourceRef="gw_go_status_check" targetRef="gw_go_parallel_final_fail_start" name="Failure of entire process" />
    <bpmn:sequenceFlow id="sf_go_ff1" sourceRef="gw_go_parallel_final_fail_start" targetRef="msg_go_send_mpon_fail_ack" />
    <bpmn:sequenceFlow id="sf_go_ff2" sourceRef="gw_go_parallel_final_fail_start" targetRef="msg_go_send_mpoo_fail" />
    <bpmn:sequenceFlow id="sf_go_ff3" sourceRef="gw_go_parallel_final_fail_start" targetRef="msg_go_send_mspo_fail" />
    <bpmn:sequenceFlow id="sf_go_ff4" sourceRef="msg_go_send_mpon_fail_ack" targetRef="gw_go_parallel_final_fail_join" />
    <bpmn:sequenceFlow id="sf_go_ff5" sourceRef="msg_go_send_mpoo_fail" targetRef="gw_go_parallel_final_fail_join" />
    <bpmn:sequenceFlow id="sf_go_ff6" sourceRef="msg_go_send_mspo_fail" targetRef="gw_go_parallel_final_fail_join" />
    <bpmn:sequenceFlow id="sf_go_7" sourceRef="gw_go_parallel_final_fail_join" targetRef="end_go_failed" />
    <bpmn:sequenceFlow id="sf_go_status_success" sourceRef="gw_go_status_check" targetRef="task_go_assign" name="Successful completion" />
    <bpmn:sequenceFlow id="sf_go_8" sourceRef="task_go_assign" targetRef="gw_go_parallel_final_succ_start" />
    <bpmn:sequenceFlow id="sf_go_fs1" sourceRef="gw_go_parallel_final_succ_start" targetRef="msg_go_send_mpon_assign_ack" />
    <bpmn:sequenceFlow id="sf_go_fs2" sourceRef="gw_go_parallel_final_succ_start" targetRef="msg_go_send_mpoo_assign" />
    <bpmn:sequenceFlow id="sf_go_fs3" sourceRef="gw_go_parallel_final_succ_start" targetRef="msg_go_send_mspo_assign" />
    <bpmn:sequenceFlow id="sf_go_fs4" sourceRef="gw_go_parallel_final_succ_start" targetRef="msg_go_send_sp_assign" />
    <bpmn:sequenceFlow id="sf_go_fs5" sourceRef="msg_go_send_mpon_assign_ack" targetRef="gw_go_parallel_final_succ_join" />
    <bpmn:sequenceFlow id="sf_go_fs6" sourceRef="msg_go_send_mpoo_assign" targetRef="gw_go_parallel_final_succ_join" />
    <bpmn:sequenceFlow id="sf_go_fs7" sourceRef="msg_go_send_mspo_assign" targetRef="gw_go_parallel_final_succ_join" />
    <bpmn:sequenceFlow id="sf_go_fs8" sourceRef="msg_go_send_sp_assign" targetRef="gw_go_parallel_final_succ_join" />
    <bpmn:sequenceFlow id="sf_go_9" sourceRef="gw_go_parallel_final_succ_join" targetRef="end_go_assigned" />
  </bpmn:process>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:startEvent id="start_mpoo_conf" name="Registration Confirmation Received">
      <bpmn:outgoing>sf_mpoo_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpoo_conf_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpoo" name="MPOO Process End">
      <bpmn:incoming>sf_mpoo_2</bpmn:incoming>
    </bpmn:endEvent>
