    },
    {
      "id": "SequenceFlow_NextManager",
      "source_id": "Gateway_MoreManagers",
      "target_id": "Task_ReviewInvoiceContent",
      "condition_name": "Yes (Pass to next manager)"
    },
    {
      "id": "SequenceFlow_AllManagersCompleted",
      "source_id": "Gateway_MoreManagers",
      "target_id": "Task_ForwardToCommercialManager",
      "condition_name": "No (All positions AP)"
    },
    {
      "id": "SequenceFlow_AccurateNo",
      "source_id": "Gateway_ContentAccurate",
      "target_id": "Task_RejectAPAndDirectReturn",
      "condition_name": "No (Inconsistencies)"
    },
    {
      "id": "SequenceFlow_ToClarification",
      "source_id": "Task_RejectAPAndDirectReturn",
      "target_id": "Task_ClarifyWithVendor",
      "condition_name": null
    },
    {
      "id": "SequenceFlow_ResolvedToCC",
      "source_id": "Task_ClarifyWithVendor",
      "target_id": "Task_SendToFirstCCManager",
      "condition_name": null
    },
    {
      "id": "SequenceFlow_ToCommAudit",
      "source_id": "Task_ForwardToCommercialManager",
      "target_id": "Task_CommercialAudit",
      "condition_name": null
    },
    {
      "id": "SequenceFlow_CommAuditDone",
      "source_id": "Task_CommercialAudit",
      "target_id": "Gateway_CommercialAuditOutcome",
      "condition_name": null
    },
    {
      "id": "SequenceFlow_AuditPassed",
      "source_id": "Gateway_CommercialAuditOutcome",
      "target_id": "Gateway_AmountThreshold",
      "condition_name": "No complaint"
    },
    {
      "id": "SequenceFlow_AuditFailed",
      "source_id": "Gateway_CommercialAuditOutcome",
      "target_id": "Task_ResolveCommercialComplaint",
      "condition_name": "Complaint exists"
    },
    {
      "id": "SequenceFlow_ComplaintResolved",
      "source_id": "Task_ResolveCommercialComplaint",
      "target_id": "Gateway_AmountThreshold",
      "condition_name": null
    },
    {
      "id": "SequenceFlow_Exceeds20",
      "source_id": "Gateway_AmountThreshold",
      "target_id": "Task_BoardReview",
      "condition_name": "Yes (> EUR 20)"
    },
    {
      "id": "SequenceFlow_NotExceeds20",
      "source_id": "Gateway_AmountThreshold",
      "target_id": "Gateway_BoardApprovalJoin",
      "condition_name": "No (<= EUR 20)"
    },
    {
      "id": "SequenceFlow_BoardApproved",
      "source_id": "Task_BoardReview",
      "target_id": "Gateway_BoardApprovalJoin",
      "condition_name": null
    },
    {
      "id": "SequenceFlow_ToPaymentInstruction",
      "source_id": "Gateway_BoardApprovalJoin",
      "target_id": "Task_GivePaymentInstructionAndClose",
      "condition_name": null
    },
    {
      "id": "SequenceFlow_End",
      "source_id": "Task_GivePaymentInstructionAndClose",
      "target_id": "EndEvent_InvoiceProcessed",
      "condition_name": null
    }
