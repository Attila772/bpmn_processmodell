<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_InvoiceProcess"
                  targetNamespace="http://bpmn.org/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- Collaboration defining the pools and lanes -->
  <bpmn:collaboration id="Collaboration_01">
    <bpmn:participant id="Participant_ACME" name="ACME AG - Invoice Processing" processRef="Process_InvoiceProcessing" />
  </bpmn:collaboration>

  <!-- Main Process Definition -->
  <bpmn:process id="Process_InvoiceProcessing" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Secretariat" name="Secretariat">
        <bpmn:flowNodeRef>Start_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VisualInspection</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Accounting" name="Accounting Employee">
        <bpmn:flowNodeRef>Task_IdentifySupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPositionsCreateDocket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreManagers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyInconsistencies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CommercialAuditResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveCommercialComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BoardCheckNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GivePaymentInstructions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvoiceProcessed</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_CostCenterManager" name="Cost Center Manager">
        <bpmn:flowNodeRef>Task_ReviewPosition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContentAccurate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApprovePosition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectPosition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAfterApproval</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_CommercialManager" name="Commercial Manager">
        <bpmn:flowNodeRef>Task_CommercialAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CommercialAuditOK</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Board" name="Board">
        <bpmn:flowNodeRef>Task_BoardApproval</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Data Objects -->
    <bpmn:dataObject id="DataObject_Invoice" name="Invoice Copy" />
    <bpmn:dataObject id="DataObject_Docket" name="Docket" />

    <!-- Process Flow Nodes -->
    
    <!-- Secretariat -->
    <bpmn:startEvent id="Start_InvoiceReceived" name="Invoice received (paper/fax)">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_VisualInspection" name="Perform visual inspection and forward">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Accounting -->
    <bpmn:userTask id="Task_IdentifySupplier" name="Identify supplier and create invoice instance in ACME Financial Accounting">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CheckPositionsCreateDocket" name="Check invoice items and create docket with cost centers/managers">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_MoreManagers" name="More cost center managers to review?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_LoopNextManager</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNextManager</bpmn:outgoing>
      <bpmn:outgoing>Flow_AllManagersApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Cost Center Manager -->
    <bpmn:userTask id="Task_ReviewPosition" name="Review invoice position content for accuracy">
      <bpmn:incoming>Flow_ToNextManager</bpmn:incoming>
      <bpmn:incoming>Flow_ResendToCCM</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ContentAccurate" name="Content accurate?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_ContentOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContentInaccurate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ApprovePosition" name="Note code (AP) on docket">
      <bpmn:incoming>Flow_ContentOK</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RejectPosition" name="Reject AP with note &amp; statement on docket, send directly to accounting">
      <bpmn:incoming>Flow_ContentInaccurate</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_MergeAfterApproval">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopNextManager</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Inconsistency Loop back at Accounting -->
    <bpmn:userTask id="Task_ClarifyInconsistencies" name="Clarify inconsistencies with vendor and/or CCM">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_ResendToCCM</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Commercial Manager -->
    <bpmn:userTask id="Task_CommercialAudit" name="Perform commercial audit and issue payment approval">
      <bpmn:incoming>Flow_AllManagersApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CommercialAuditOK" name="Commercial audit successful?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_AuditFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ResolveCommercialComplaint" name="Resolve complaint with supplier">
      <bpmn:incoming>Flow_AuditFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CommercialAuditResolution">
      <bpmn:incoming>Flow_AuditPassed</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Board Review -->
    <bpmn:exclusiveGateway id="Gateway_BoardCheckNeeded" name="Bill amount &gt; 20 EUR?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_BoardCheckYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_BoardCheckNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_BoardApproval" name="Check invoice (4-eyes-principle)">
      <bpmn:incoming>Flow_BoardCheckYes</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Execution -->
    <bpmn:userTask id="Task_GivePaymentInstructions" name="Give payment instructions and close instance in ACME Financial Accounting">
      <bpmn:incoming>Flow_BoardCheckNo</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_InvoiceProcessed" name="Invoice processing completed">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_InvoiceReceived" targetRef="Task_VisualInspection" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_VisualInspection" targetRef="Task_IdentifySupplier" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_IdentifySupplier" targetRef="Task_CheckPositionsCreateDocket" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CheckPositionsCreateDocket" targetRef="Gateway_MoreManagers" />
    <bpmn:sequenceFlow id="Flow_ToNextManager" name="Yes" sourceRef="Gateway_MoreManagers" targetRef="Task_ReviewPosition" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ReviewPosition" targetRef="Gateway_ContentAccurate" />
    <bpmn:sequenceFlow id="Flow_ContentOK" name="Yes" sourceRef="Gateway_ContentAccurate" targetRef="Task_ApprovePosition" />
    <bpmn:sequenceFlow id="Flow_ContentInaccurate" name="No" sourceRef="Gateway_ContentAccurate" targetRef="Task_RejectPosition" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ApprovePosition" targetRef="Gateway_MergeAfterApproval" />
    <bpmn:sequenceFlow id="Flow_LoopNextManager" sourceRef="Gateway_MergeAfterApproval" targetRef="Gateway_MoreManagers" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_RejectPosition" targetRef="Task_ClarifyInconsistencies" />
    <bpmn:sequenceFlow id="Flow_ResendToCCM" name="Resolved" sourceRef="Task_ClarifyInconsistencies" targetRef="Task_ReviewPosition" />
    <bpmn:sequenceFlow id="Flow_AllManagersApproved" name="No (All positions AP)" sourceRef="Gateway_MoreManagers" targetRef="Task_CommercialAudit" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_CommercialAudit" targetRef="Gateway_CommercialAuditOK" />
    <bpmn:sequenceFlow id="Flow_AuditPassed" name="Yes" sourceRef="Gateway_CommercialAuditOK" targetRef="Gateway_CommercialAuditResolution" />
    <bpmn:sequenceFlow id="Flow_AuditFailed" name="No (Complaint)" sourceRef="Gateway_CommercialAuditOK" targetRef="Task_ResolveCommercialComplaint" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ResolveCommercialComplaint" targetRef="Gateway_CommercialAuditResolution" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_CommercialAuditResolution" targetRef="Gateway_BoardCheckNeeded" />
    <bpmn:sequenceFlow id="Flow_BoardCheckYes" name="Yes" sourceRef="Gateway_BoardCheckNeeded" targetRef="Task_BoardApproval" />
    <bpmn:sequenceFlow id="Flow_BoardCheckNo" name="No" sourceRef="Gateway_BoardCheckNeeded" targetRef="Task_GivePaymentInstructions" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_BoardApproval" targetRef="Task_GivePaymentInstructions" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_GivePaymentInstructions" targetRef="End_InvoiceProcessed" />

  </bpmn:process>

  <!-- BPMN Diagram Layout Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_01">
      <bpmndi:BPMNShape id="Participant_ACME_di" bpmnElement="Participant_ACME" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1680" height="1050" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Secretariat_di" bpmnElement="Lane_Secretariat" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1650" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Accounting_di" bpmnElement="Lane_Accounting" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="1650" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CostCenterManager_di" bpmnElement="Lane_CostCenterManager" isHorizontal="true">
        <dc:Bounds x="190" y="530" width="1650" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CommercialManager_di" bpmnElement="Lane_CommercialManager" isHorizontal="true">
        <dc:Bounds x="190" y="810" width="1650" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Board_di" bpmnElement="Lane_Board" isHorizontal="true">
        <dc:Bounds x="190" y="980" width="1650" height="150" />
      </bpmndi:BPMNShape>

      <!-- Nodes -->
      <bpmndi:BPMNShape id="Start_InvoiceReceived_di" bpmnElement="Start_InvoiceReceived">
        <dc:Bounds x="242" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="221" y="175" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_VisualInspection_di" bpmnElement="Task_VisualInspection">
        <dc:Bounds x="330" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_IdentifySupplier_di" bpmnElement="Task_IdentifySupplier">
        <dc:Bounds x="330" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckPositionsCreateDocket_di" bpmnElement="Task_CheckPositionsCreateDocket">
        <dc:Bounds x="480" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MoreManagers_di" bpmnElement="Gateway_MoreManagers" isMarkerVisible="true">
        <dc:Bounds x="635" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="618" y="250" width="84" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewPosition_di" bpmnElement="Task_ReviewPosition">
        <dc:Bounds x="610" y="630" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ContentAccurate_di" bpmnElement="Gateway_ContentAccurate" isMarkerVisible="true">
        <dc:Bounds x="765" y="645" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="746" y="702" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ApprovePosition_di" bpmnElement="Task_ApprovePosition">
        <dc:Bounds x="870" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RejectPosition_di" bpmnElement="Task_RejectPosition">
        <dc:Bounds x="870" y="690" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergeAfterApproval_di" bpmnElement="Gateway_MergeAfterApproval" isMarkerVisible="true">
        <dc:Bounds x="1015" y="575" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ClarifyInconsistencies_di" bpmnElement="Task_ClarifyInconsistencies">
        <dc:Bounds x="870" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CommercialAudit_di" bpmnElement="Task_CommercialAudit">
        <dc:Bounds x="1090" y="850" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_CommercialAuditOK_di" bpmnElement="Gateway_CommercialAuditOK" isMarkerVisible="true">
        <dc:Bounds x="1245" y="865" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1227" y="922" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ResolveCommercialComplaint_di" bpmnElement="Task_ResolveCommercialComplaint">
        <dc:Bounds x="1220" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_CommercialAuditResolution_di" bpmnElement="Gateway_CommercialAuditResolution" isMarkerVisible="true">
        <dc:Bounds x="1375" y="425" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_BoardCheckNeeded_di" bpmnElement="Gateway_BoardCheckNeeded" isMarkerVisible="true">
        <dc:Bounds x="1475" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1465" y="388" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_BoardApproval_di" bpmnElement="Task_BoardApproval">
        <dc:Bounds x="1450" y="1010" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_GivePaymentInstructions_di" bpmnElement="Task_GivePaymentInstructions">
        <dc:Bounds x="1590" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_InvoiceProcessed_di" bpmnElement="End_InvoiceProcessed">
        <dc:Bounds x="1742" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1716" y="475" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="278" y="150" />
        <di:waypoint x="330" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="380" y="190" />
        <di:waypoint x="380" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="430" y="320" />
        <di:waypoint x="480" y="320" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="580" y="320" />
        <di:waypoint x="635" y="320" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToNextManager_di" bpmnElement="Flow_ToNextManager">
        <di:waypoint x="660" y="345" />
        <di:waypoint x="660" y="630" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="666" y="380" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="710" y="670" />
        <di:waypoint x="765" y="670" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ContentOK_di" bpmnElement="Flow_ContentOK">
        <di:waypoint x="790" y="645" />
        <di:waypoint x="790" y="600" />
        <di:waypoint x="870" y="600" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="796" y="620" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ContentInaccurate_di" bpmnElement="Flow_ContentInaccurate">
        <di:waypoint x="790" y="695" />
        <di:waypoint x="790" y="730" />
        <di:waypoint x="870" y="730" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="798" y="708" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="970" y="600" />
        <di:waypoint x="1015" y="600" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_LoopNextManager_di" bpmnElement="Flow_LoopNextManager">
        <di:waypoint x="1040" y="575" />
        <di:waypoint x="1040" y="250" />
        <di:waypoint x="660" y="250" />
        <di:waypoint x="660" y="295" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="920" y="690" />
        <di:waypoint x="920" y="490" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ResendToCCM_di" bpmnElement="Flow_ResendToCCM">
        <di:waypoint x="870" y="450" />
        <di:waypoint x="550" y="450" />
        <di:waypoint x="550" y="670" />
        <di:waypoint x="610" y="670" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="567" y="432" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AllManagersApproved_di" bpmnElement="Flow_AllManagersApproved">
        <di:waypoint x="685" y="320" />
        <di:waypoint x="1140" y="320" />
        <di:waypoint x="1140" y="850" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="702" y="286" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="1190" y="890" />
        <di:waypoint x="1245" y="890" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AuditPassed_di" bpmnElement="Flow_AuditPassed">
        <di:waypoint x="1295" y="890" />
        <di:waypoint x="1400" y="890" />
        <di:waypoint x="1400" y="475" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1339" y="872" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AuditFailed_di" bpmnElement="Flow_AuditFailed">
        <di:waypoint x="1270" y="865" />
        <di:waypoint x="1270" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1278" y="780" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="1320" y="450" />
        <di:waypoint x="1375" y="450" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1425" y="450" />
        <di:waypoint x="1475" y="450" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_BoardCheckYes_di" bpmnElement="Flow_BoardCheckYes">
        <di:waypoint x="1500" y="475" />
        <di:waypoint x="1500" y="1010" />
        <bpmndi:BPMNLabel>
