  "gateways": [
    {
      "id": "gw_ccm_review",
      "name": "Content in order?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_ccm_in_order",
          "condition": "Everything in order"
        },
        {
          "flow_id": "flow_ccm_inconsistencies",
          "condition": "Inconsistencies exist"
        }
      ]
    },
    {
      "id": "gw_ccm_next_or_done",
      "name": "More cost center managers?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_more_ccm",
          "condition": "More cost center managers in list"
        },
        {
          "flow_id": "flow_all_ccm_done",
          "condition": "All items marked correct"
        }
      ]
    },
    {
      "id": "gw_acct_check_ccm_result",
      "name": "Are there inconsistencies?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_acct_has_inconsistencies",
          "condition": "Inconsistencies reported"
        },
        {
          "flow_id": "flow_acct_all_approved",
          "condition": "All items approved (AP)"
        }
      ]
    },
    {
      "id": "gw_cm_amount_check",
      "name": "Exceeds EUR 20?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_cm_exceeds_20",
          "condition": "Bill amount > 20 EUR"
        },
        {
          "flow_id": "flow_cm_under_20",
          "condition": "Bill amount <= 20 EUR"
        }
      ]
    },
    {
      "id": "gw_cm_complaint_check",
      "name": "Complaint during commercial audit?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_complaint_exists",
          "condition": "Complaint exists"
        },
        {
          "flow_id": "flow_no_complaint",
          "condition": "Audit successfully completed"
        }
      ]
    }
  ],
