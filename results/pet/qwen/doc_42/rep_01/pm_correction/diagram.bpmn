  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_msp_part" name="MSP" processRef="pool_msp_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="msg_req" sourceRef="evt_end_request_go" targetRef="evt_req_received_msp" name="Measurement Request" />
    <bpmn:messageFlow id="msg_fail" sourceRef="evt_end_failure_msp" targetRef="evt_failure_notif_go" name="Failure Notification" />
    <bpmn:messageFlow id="msg_vals" sourceRef="evt_end_values_msp" targetRef="evt_values_received_go" name="Measured Values" />
    <bpmn:messageFlow id="msg_changed" sourceRef="evt_end_changed_go" targetRef="evt_changed_sent_msp" name="Changed Values" />
    <bpmn:messageFlow id="msg_readings" sourceRef="evt_end_readings_go" targetRef="evt_readings_sent_sp" name="Readings" />
  </bpmn:collaboration>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_measured_values_p1" name="Measured Values" dataObjectRef="data_measured_values_p1_do" />
    <bpmn:dataObject id="data_measured_values_p1_do" />
    <bpmn:dataObjectReference id="data_changed_values" name="Changed Values" dataObjectRef="data_changed_values_do" />
    <bpmn:dataObject id="data_changed_values_do" />
    <bpmn:dataObjectReference id="data_readings" name="Readings" dataObjectRef="data_readings_do" />
    <bpmn:dataObject id="data_readings_do" />
    <bpmn:startEvent id="evt_start_go" name="Start Measurement Request">
      <bpmn:outgoing>flow_start_to_end_req</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_request_go" name="Request Sent">
      <bpmn:incoming>flow_start_to_end_req</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_request_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_failure_notif_go" name="Failure Notification Received">
      <bpmn:outgoing>flow_fail_to_handle</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_failure_notif_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_values_received_go" name="Measured Values Received">
      <bpmn:outgoing>flow_vals_to_process</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_values_received_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_changed_go" name="Changed Values Sent">
      <bpmn:incoming>flow_process_to_send_changed</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_changed_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_readings_go" name="Readings Sent">
      <bpmn:incoming>flow_transmit_to_end_readings</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_readings_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_process_go" name="Process End">
      <bpmn:incoming>flow_handle_fail_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_process_values" name="Process the measured values">
      <bpmn:incoming>flow_vals_to_process</bpmn:incoming>
      <bpmn:outgoing>flow_process_to_send_changed</bpmn:outgoing>
      <bpmn:outgoing>flow_process_to_transmit</bpmn:outgoing>
      <bpmn:property id="task_process_values_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_process_values_dia0">
        <bpmn:sourceRef>data_measured_values_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_process_values_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_process_values_doa0">
        <bpmn:targetRef>data_changed_values</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_handle_failure" name="Handle failure notification">
      <bpmn:incoming>flow_fail_to_handle</bpmn:incoming>
      <bpmn:outgoing>flow_handle_fail_to_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_transmit_readings" name="Transmit readings to SP">
      <bpmn:incoming>flow_process_to_transmit</bpmn:incoming>
      <bpmn:outgoing>flow_transmit_to_end_readings</bpmn:outgoing>
      <bpmn:property id="task_transmit_readings_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_transmit_readings_dia0">
        <bpmn:sourceRef>data_changed_values</bpmn:sourceRef>
        <bpmn:targetRef>task_transmit_readings_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_transmit_readings_doa0">
        <bpmn:targetRef>data_readings</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_start_to_end_req" sourceRef="evt_start_go" targetRef="evt_end_request_go" />
    <bpmn:sequenceFlow id="flow_fail_to_handle" sourceRef="evt_failure_notif_go" targetRef="task_handle_failure" />
    <bpmn:sequenceFlow id="flow_handle_fail_to_end" sourceRef="task_handle_failure" targetRef="evt_end_process_go" />
    <bpmn:sequenceFlow id="flow_vals_to_process" sourceRef="evt_values_received_go" targetRef="task_process_values" />
    <bpmn:sequenceFlow id="flow_process_to_send_changed" sourceRef="task_process_values" targetRef="evt_end_changed_go" />
    <bpmn:sequenceFlow id="flow_process_to_transmit" sourceRef="task_process_values" targetRef="task_transmit_readings" />
    <bpmn:sequenceFlow id="flow_transmit_to_end_readings" sourceRef="task_transmit_readings" targetRef="evt_end_readings_go" />
  </bpmn:process>
  <bpmn:process id="pool_msp_proc" isExecutable="false">
