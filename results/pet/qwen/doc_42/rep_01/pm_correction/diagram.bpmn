        <bpmn:targetRef>task_handle_changed_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_check_result" name="Request Check Result" isMarkerVisible="true">
      <bpmn:incoming>flow_check_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_deny</bpmn:outgoing>
      <bpmn:outgoing>flow_measure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_recv_to_check" sourceRef="evt_req_received_msp" targetRef="task_check_request" />
    <bpmn:sequenceFlow id="flow_check_to_gw" sourceRef="task_check_request" targetRef="gw_check_result" />
    <bpmn:sequenceFlow id="flow_deny" sourceRef="gw_check_result" targetRef="evt_end_failure_msp" name="Deny request" />
    <bpmn:sequenceFlow id="flow_measure" sourceRef="gw_check_result" targetRef="task_perform_measurement" name="Perform measurement" />
    <bpmn:sequenceFlow id="flow_measure_to_end_vals" sourceRef="task_perform_measurement" targetRef="evt_end_values_msp" />
    <bpmn:sequenceFlow id="flow_changed_to_handle" sourceRef="evt_changed_sent_msp" targetRef="task_handle_changed" />
    <bpmn:sequenceFlow id="flow_handle_changed_to_end" sourceRef="task_handle_changed" targetRef="evt_end_process_msp" />
