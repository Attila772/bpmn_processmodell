  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_mpo0_part" name="MPOO" processRef="pool_mpo0_proc" />
    <bpmn:messageFlow id="msg_1" sourceRef="evt_end_request_mpon" targetRef="evt_start_tender_mpo0" name="Device Takeover Bid Request" />
    <bpmn:messageFlow id="msg_2" sourceRef="evt_end_tender_mpo0" targetRef="evt_start_order_mpon" name="Equipment Takeover Tender" />
    <bpmn:messageFlow id="msg_3" sourceRef="evt_end_order_mpon" targetRef="evt_start_confirm_mpo0" name="Takeover Order" />
    <bpmn:messageFlow id="msg_4" sourceRef="evt_end_confirm_mpo0" targetRef="evt_end_process_mpon" name="Order Confirmation and Master Data" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_bid_request" name="Device Takeover Bid Request" dataObjectRef="data_bid_request_do" />
    <bpmn:dataObject id="data_bid_request_do" />
    <bpmn:dataObjectReference id="data_tender_p1" name="Equipment Takeover Tender" dataObjectRef="data_tender_p1_do" />
    <bpmn:dataObject id="data_tender_p1_do" />
    <bpmn:dataObjectReference id="data_order" name="Takeover Order" dataObjectRef="data_order_do" />
    <bpmn:dataObject id="data_order_do" />
    <bpmn:startEvent id="evt_start_mpon" name="Start Device Takeover Request">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_request_mpon" name="Request Sent">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_request_mpon_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_order_mpon" name="Receive Tender">
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_order_mpon_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_order_mpon" name="Order Placed">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_order_mpon_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_process_mpon" name="Process Complete">
      <bpmn:messageEventDefinition id="evt_end_process_mpon_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_prepare_bid_request" name="Prepare Device Takeover Bid Request">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_prepare_bid_request_doa0">
        <bpmn:targetRef>data_bid_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_place_order" name="Place Order for Equipment Takeover">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_place_order_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_place_order_dia0">
        <bpmn:sourceRef>data_tender_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_place_order_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_place_order_doa0">
        <bpmn:targetRef>data_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_mpon" targetRef="task_prepare_bid_request" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_prepare_bid_request" targetRef="evt_end_request_mpon" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="evt_start_order_mpon" targetRef="task_place_order" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_place_order" targetRef="evt_end_order_mpon" />
  </bpmn:process>
  <bpmn:process id="pool_mpo0_proc" isExecutable="false">
