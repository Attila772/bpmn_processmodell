      <bpmn:dataOutputAssociation id="task_confirm_and_send_data_doa1">
        <bpmn:targetRef>data_master_data</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_3" sourceRef="evt_start_tender_mpo0" targetRef="task_create_tender" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_create_tender" targetRef="evt_end_tender_mpo0" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="evt_start_confirm_mpo0" targetRef="task_confirm_and_send_data" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_confirm_and_send_data" targetRef="evt_end_confirm_mpo0" />
  </bpmn:process>
