      <bpmn:dataOutputAssociation id="task_create_tender_doa0">
        <bpmn:targetRef>data_tender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_confirm_and_send_data" name="Confirm Order and Send Master Data">
