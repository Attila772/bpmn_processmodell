  <bpmn:process id="CommitteeMeetingProcess" name="Committee Meeting Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_DatesFinalized" name="Dates Finalized">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
