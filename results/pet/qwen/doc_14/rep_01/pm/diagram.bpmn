      <bpmn:messageEventDefinition id="evt_recv_meeting_prep_done_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:manualTask id="task_read_documents" name="Read Related Documents">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
