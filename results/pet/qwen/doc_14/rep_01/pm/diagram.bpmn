      <bpmn:dataOutputAssociation id="task_qa_check_minutes_doa0">
        <bpmn:targetRef>data_minutes_approved</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_send_minutes_to_members" name="Send Minutes to Committee Members">
