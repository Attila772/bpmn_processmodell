<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_support_officer_part" name="Support Officer" processRef="pool_support_officer_proc" />
    <bpmn:participant id="pool_committee_members_part" name="Committee Members" processRef="pool_committee_members_proc" />
    <bpmn:participant id="pool_coordination_unit_part" name="Coordination Unit" processRef="pool_coordination_unit_proc" />
    <bpmn:messageFlow id="msg_flow_1" sourceRef="evt_msg_meeting_prep_done" targetRef="evt_recv_meeting_prep_done" name="Meeting Prep Notification" />
    <bpmn:messageFlow id="msg_flow_2" sourceRef="evt_msg_minutes_ready" targetRef="evt_recv_minutes_ready" name="Draft Minutes" />
    <bpmn:messageFlow id="msg_flow_3" sourceRef="evt_msg_qa_approved" targetRef="evt_recv_qa_approved" name="Approved Minutes" />
  </bpmn:collaboration>
  <bpmn:process id="pool_support_officer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_documents" name="Meeting Documents" dataObjectRef="data_documents_do" />
    <bpmn:dataObject id="data_documents_do" />
    <bpmn:dataObjectReference id="data_minutes_draft_p1" name="Draft Minutes with Action Points" dataObjectRef="data_minutes_draft_p1_do" />
    <bpmn:dataObject id="data_minutes_draft_p1_do" />
    <bpmn:dataObjectReference id="data_minutes_approved_p1" name="Approved Minutes" dataObjectRef="data_minutes_approved_p1_do" />
    <bpmn:dataObject id="data_minutes_approved_p1_do" />
    <bpmn:startEvent id="evt_start_dates_finalized" name="Dates Finalized">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_records_updated" name="Records Updated">
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_meeting_prep_done" name="Meeting Preparation Complete">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_meeting_prep_done_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_minutes_ready" name="Minutes Ready for QA">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_minutes_ready_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_recv_qa_approved" name="Receive Approved Minutes">
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_recv_qa_approved_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_update_calendars_folders" name="Update Calendars and Create Folders">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_update_calendars_folders_doa0">
        <bpmn:targetRef>data_documents</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_upload_documents" name="Upload Documents to System">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_upload_documents_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_upload_documents_dia0">
        <bpmn:sourceRef>data_documents</bpmn:sourceRef>
        <bpmn:targetRef>task_upload_documents_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_produce_minutes" name="Produce Minutes and Action Points">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_produce_minutes_doa0">
        <bpmn:targetRef>data_minutes_draft_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_update_departmental_records" name="Update Departmental Records">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:property id="task_update_departmental_records_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_update_departmental_records_dia0">
        <bpmn:sourceRef>data_minutes_approved_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_update_departmental_records_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_dates_finalized" targetRef="task_update_calendars_folders" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_update_calendars_folders" targetRef="task_upload_documents" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_upload_documents" targetRef="evt_msg_meeting_prep_done" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_produce_minutes" targetRef="evt_msg_minutes_ready" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="evt_recv_qa_approved" targetRef="task_update_departmental_records" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="task_update_departmental_records" targetRef="evt_end_records_updated" />
  </bpmn:process>
  <bpmn:process id="pool_committee_members_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_documents_p1" name="Meeting Documents" dataObjectRef="data_documents_p1_do" />
