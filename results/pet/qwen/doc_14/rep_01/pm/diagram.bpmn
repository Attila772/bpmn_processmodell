    <bpmn:sequenceFlow id="flow_4" sourceRef="evt_recv_meeting_prep_done" targetRef="task_read_documents" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_read_documents" targetRef="task_hold_meeting" />
  </bpmn:process>
  <bpmn:process id="pool_coordination_unit_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_minutes_draft_p2" name="Draft Minutes with Action Points" dataObjectRef="data_minutes_draft_p2_do" />
