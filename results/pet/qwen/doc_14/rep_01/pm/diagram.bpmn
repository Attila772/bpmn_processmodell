    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_8" sourceRef="evt_recv_minutes_ready" targetRef="task_qa_check_minutes" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_qa_check_minutes" targetRef="task_send_minutes_to_members" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_send_minutes_to_members" targetRef="evt_msg_qa_approved" />
  </bpmn:process>
