<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_sp_pu_go_part" name="SP / PU / GO" processRef="pool_sp_pu_go_proc" />
    <bpmn:messageFlow id="msg_flow_request" sourceRef="pool_sp_pu_go" targetRef="evt_start_mpo" name="Change Request" />
    <bpmn:messageFlow id="msg_flow_reject" sourceRef="evt_end_reject" targetRef="pool_sp_pu_go" name="Rejection Notification" />
    <bpmn:messageFlow id="msg_flow_success" sourceRef="evt_end_success" targetRef="pool_sp_pu_go" name="Implementation Report" />
    <bpmn:messageFlow id="msg_flow_failure" sourceRef="evt_end_failure" targetRef="pool_sp_pu_go" name="Failure Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_mpo" name="Change Request Received (from SP/PU/GO or MPO)">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mpo_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_reject" name="Notify Rejection">
      <bpmn:incoming>flow_to_reject</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_reject_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_success" name="Report Implementation">
      <bpmn:incoming>flow_to_success</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_success_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_failure" name="Notify Failure">
      <bpmn:incoming>flow_to_failure</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_failure_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_review" name="Review change request">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_perform_change" name="Perform measuring point change">
      <bpmn:incoming>flow_to_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_decision" name="Decision on Change Request" isMarkerVisible="true">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_to_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_to_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_outcome" name="Outcome of Change Execution" isMarkerVisible="true">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_to_success</bpmn:outgoing>
      <bpmn:outgoing>flow_to_failure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_mpo" targetRef="task_review" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_review" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_to_reject" sourceRef="gw_decision" targetRef="evt_end_reject" name="Reject" />
    <bpmn:sequenceFlow id="flow_to_confirm" sourceRef="gw_decision" targetRef="task_perform_change" name="Confirm" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_perform_change" targetRef="gw_outcome" />
    <bpmn:sequenceFlow id="flow_to_success" sourceRef="gw_outcome" targetRef="evt_end_success" name="Success" />
    <bpmn:sequenceFlow id="flow_to_failure" sourceRef="gw_outcome" targetRef="evt_end_failure" name="Failure" />
  </bpmn:process>
  <bpmn:process id="pool_sp_pu_go_proc" isExecutable="false">
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpo_part_di" bpmnElement="pool_mpo_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1330" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_sp_pu_go_part_di" bpmnElement="pool_sp_pu_go_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="700" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_failure_di" bpmnElement="evt_end_failure">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_reject_di" bpmnElement="evt_end_reject">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_success_di" bpmnElement="evt_end_success">
        <dc:Bounds x="1110" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_mpo_di" bpmnElement="evt_start_mpo">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_di" bpmnElement="gw_decision">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_outcome_di" bpmnElement="gw_outcome">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_perform_change_di" bpmnElement="task_perform_change">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_di" bpmnElement="task_review">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_reject_di" bpmnElement="flow_to_reject">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_confirm_di" bpmnElement="flow_to_confirm">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_success_di" bpmnElement="flow_to_success">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1128" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_failure_di" bpmnElement="flow_to_failure">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_request_di" bpmnElement="msg_flow_request">
        <di:waypoint x="150" y="140" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_reject_di" bpmnElement="msg_flow_reject">
        <di:waypoint x="748" y="118" />
        <di:waypoint x="150" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_success_di" bpmnElement="msg_flow_success">
        <di:waypoint x="1128" y="243" />
        <di:waypoint x="150" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_failure_di" bpmnElement="msg_flow_failure">
        <di:waypoint x="1128" y="118" />
        <di:waypoint x="150" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>