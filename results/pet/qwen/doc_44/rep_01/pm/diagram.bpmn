      <bpmndi:BPMNShape id="pool_engineering_part_di" bpmnElement="pool_engineering_part" isHorizontal="true">
        <dc:Bounds x="120" y="960" width="1330" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_all_parts_ready_di" bpmnElement="evt_all_parts_ready">
        <dc:Bounds x="540" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_assembly_complete_di" bpmnElement="evt_assembly_complete">
        <dc:Bounds x="1110" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_rejected_di" bpmnElement="evt_end_rejected">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_to_engineering_di" bpmnElement="evt_msg_to_engineering">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_to_storehouse_di" bpmnElement="evt_msg_to_storehouse">
        <dc:Bounds x="730" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_prep_finished_di" bpmnElement="evt_prep_finished">
        <dc:Bounds x="540" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_shipped_di" bpmnElement="evt_shipped">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_engineering_prep_di" bpmnElement="evt_start_engineering_prep">
        <dc:Bounds x="160" y="1020" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_sales_di" bpmnElement="evt_start_sales">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_storehouse_di" bpmnElement="evt_start_storehouse">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_order_decision_di" bpmnElement="gw_order_decision">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parts_loop_di" bpmnElement="gw_parts_loop">
        <dc:Bounds x="730" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sync_assembly_di" bpmnElement="gw_sync_assembly">
        <dc:Bounds x="730" y="1020" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assemble_bike_di" bpmnElement="task_assemble_bike">
        <dc:Bounds x="920" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_order_di" bpmnElement="task_check_order">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prepare_assembly_di" bpmnElement="task_prepare_assembly">
        <dc:Bounds x="350" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_part_item_di" bpmnElement="task_process_part_item">
        <dc:Bounds x="540" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ship_bike_di" bpmnElement="task_ship_bike">
        <dc:Bounds x="160" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_order_di" bpmnElement="data_order">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_assembled_bike_p1_di" bpmnElement="data_assembled_bike_p1">
        <dc:Bounds x="180" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_part_list_di" bpmnElement="data_part_list">
        <dc:Bounds x="560" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_inventory_status_di" bpmnElement="data_inventory_status">
        <dc:Bounds x="560" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_part_list_p1_di" bpmnElement="data_part_list_p1">
        <dc:Bounds x="370" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_inventory_status_p1_di" bpmnElement="data_inventory_status_p1">
        <dc:Bounds x="940" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_assembled_bike_di" bpmnElement="data_assembled_bike">
        <dc:Bounds x="940" y="1160" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_check_di" bpmnElement="flow_start_to_check">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_gw_di" bpmnElement="flow_check_to_gw">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reject_di" bpmnElement="flow_reject">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_accept_di" bpmnElement="flow_accept">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="748" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_msg_to_eng_di" bpmnElement="flow_msg_to_eng">
        <di:waypoint x="748" y="243" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_storehouse_start_di" bpmnElement="flow_storehouse_start">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="755" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_next_item_di" bpmnElement="flow_next_item">
        <di:waypoint x="755" y="585" />
        <di:waypoint x="590" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_item_to_gw_di" bpmnElement="flow_item_to_gw">
        <di:waypoint x="590" y="725" />
        <di:waypoint x="755" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_all_done_di" bpmnElement="flow_all_done">
        <di:waypoint x="755" y="585" />
        <di:waypoint x="558" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_eng_prep_start_di" bpmnElement="flow_eng_prep_start">
        <di:waypoint x="178" y="1038" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_prep_to_evt_di" bpmnElement="flow_prep_to_evt">
        <di:waypoint x="400" y="1060" />
        <di:waypoint x="558" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sync_in_1_di" bpmnElement="flow_sync_in_1">
        <di:waypoint x="558" y="578" />
        <di:waypoint x="755" y="1045" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sync_in_2_di" bpmnElement="flow_sync_in_2">
        <di:waypoint x="558" y="1038" />
        <di:waypoint x="755" y="1045" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sync_out_di" bpmnElement="flow_sync_out">
        <di:waypoint x="755" y="1045" />
        <di:waypoint x="970" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assemble_to_evt_di" bpmnElement="flow_assemble_to_evt">
        <di:waypoint x="970" y="1060" />
        <di:waypoint x="1128" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assemble_to_ship_di" bpmnElement="flow_assemble_to_ship">
        <di:waypoint x="1128" y="1038" />
        <di:waypoint x="210" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ship_to_end_di" bpmnElement="flow_ship_to_end">
        <di:waypoint x="210" y="265" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_to_storehouse_di" bpmnElement="msg_flow_to_storehouse">
        <di:waypoint x="748" y="243" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_to_engineering_di" bpmnElement="msg_flow_to_engineering">
        <di:waypoint x="938" y="118" />
        <di:waypoint x="178" y="1038" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_order_dia0_di" bpmnElement="task_check_order_dia0">
        <di:waypoint x="388" y="390" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_process_part_item_dia0_di" bpmnElement="task_process_part_item_dia0">
        <di:waypoint x="578" y="850" />
        <di:waypoint x="590" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_process_part_item_doa0_di" bpmnElement="task_process_part_item_doa0">
        <di:waypoint x="590" y="725" />
        <di:waypoint x="578" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_prepare_assembly_dia0_di" bpmnElement="task_prepare_assembly_dia0">
        <di:waypoint x="388" y="1185" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_assemble_bike_dia0_di" bpmnElement="task_assemble_bike_dia0">
        <di:waypoint x="958" y="1185" />
