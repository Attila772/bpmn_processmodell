<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_sales_part" name="Sales Department" processRef="pool_sales_proc" />
    <bpmn:participant id="pool_storehouse_part" name="Storehouse" processRef="pool_storehouse_proc" />
    <bpmn:participant id="pool_engineering_part" name="Engineering Department" processRef="pool_engineering_proc" />
    <bpmn:messageFlow id="msg_flow_to_storehouse" sourceRef="evt_msg_to_storehouse" targetRef="evt_start_storehouse" name="Order and Part List Notification" />
    <bpmn:messageFlow id="msg_flow_to_engineering" sourceRef="evt_msg_to_engineering" targetRef="evt_start_engineering_prep" name="Order and Part List Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_sales_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_order" name="Order" dataObjectRef="data_order_do" />
    <bpmn:dataObject id="data_order_do" />
    <bpmn:dataObjectReference id="data_assembled_bike_p1" name="Assembled Bicycle" dataObjectRef="data_assembled_bike_p1_do" />
    <bpmn:dataObject id="data_assembled_bike_p1_do" />
    <bpmn:startEvent id="evt_start_sales" name="Order Received">
      <bpmn:outgoing>flow_start_to_check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_rejected" name="Order Rejected">
      <bpmn:incoming>flow_reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_storehouse" name="Inform Storehouse">
      <bpmn:incoming>flow_accept</bpmn:incoming>
      <bpmn:outgoing>flow_msg_to_eng</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_to_storehouse_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_engineering" name="Inform Engineering">
      <bpmn:incoming>flow_msg_to_eng</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_engineering_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="evt_shipped" name="Process Finished">
      <bpmn:incoming>flow_ship_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_order" name="Check Order">
      <bpmn:incoming>flow_start_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gw</bpmn:outgoing>
      <bpmn:property id="task_check_order_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_order_dia0">
        <bpmn:sourceRef>data_order</bpmn:sourceRef>
        <bpmn:targetRef>task_check_order_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_ship_bike" name="Ship Bicycle to Customer">
      <bpmn:incoming>flow_assemble_to_ship</bpmn:incoming>
      <bpmn:outgoing>flow_ship_to_end</bpmn:outgoing>
      <bpmn:property id="task_ship_bike_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_ship_bike_dia0">
        <bpmn:sourceRef>data_assembled_bike_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_ship_bike_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_order_decision" name="Accept or Reject Order?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_accept</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_check" sourceRef="evt_start_sales" targetRef="task_check_order" />
    <bpmn:sequenceFlow id="flow_check_to_gw" sourceRef="task_check_order" targetRef="gw_order_decision" />
    <bpmn:sequenceFlow id="flow_reject" sourceRef="gw_order_decision" targetRef="evt_end_rejected" name="Rejected" />
    <bpmn:sequenceFlow id="flow_accept" sourceRef="gw_order_decision" targetRef="evt_msg_to_storehouse" name="Accepted" />
    <bpmn:sequenceFlow id="flow_msg_to_eng" sourceRef="evt_msg_to_storehouse" targetRef="evt_msg_to_engineering" />
    <bpmn:sequenceFlow id="flow_ship_to_end" sourceRef="task_ship_bike" targetRef="evt_shipped" />
  </bpmn:process>
  <bpmn:process id="pool_storehouse_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_part_list" name="Part List" dataObjectRef="data_part_list_do" />
    <bpmn:dataObject id="data_part_list_do" />
    <bpmn:dataObjectReference id="data_inventory_status" name="Inventory Status (Reserved/Back-ordered)" dataObjectRef="data_inventory_status_do" />
    <bpmn:dataObject id="data_inventory_status_do" />
    <bpmn:startEvent id="evt_start_storehouse" name="Receive Order Info">
      <bpmn:outgoing>flow_storehouse_start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_storehouse_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_all_parts_ready" name="All Parts Reserved/Back-ordered">
      <bpmn:incoming>flow_all_done</bpmn:incoming>
      <bpmn:outgoing>flow_sync_in_1</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:manualTask id="task_process_part_item" name="Process Part Item (Check Quantity &amp; Reserve/Back-order)">
      <bpmn:incoming>flow_next_item</bpmn:incoming>
      <bpmn:outgoing>flow_item_to_gw</bpmn:outgoing>
      <bpmn:property id="task_process_part_item_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_process_part_item_dia0">
        <bpmn:sourceRef>data_part_list</bpmn:sourceRef>
        <bpmn:targetRef>task_process_part_item_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_process_part_item_doa0">
        <bpmn:targetRef>data_inventory_status</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:standardLoopCharacteristics />
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_parts_loop" name="More Items on Part List?" isMarkerVisible="true">
      <bpmn:incoming>flow_storehouse_start</bpmn:incoming>
      <bpmn:incoming>flow_item_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_next_item</bpmn:outgoing>
      <bpmn:outgoing>flow_all_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_storehouse_start" sourceRef="evt_start_storehouse" targetRef="gw_parts_loop" />
    <bpmn:sequenceFlow id="flow_next_item" sourceRef="gw_parts_loop" targetRef="task_process_part_item" name="Yes" />
    <bpmn:sequenceFlow id="flow_item_to_gw" sourceRef="task_process_part_item" targetRef="gw_parts_loop" />
    <bpmn:sequenceFlow id="flow_all_done" sourceRef="gw_parts_loop" targetRef="evt_all_parts_ready" name="No" />
  </bpmn:process>
  <bpmn:process id="pool_engineering_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_part_list_p1" name="Part List" dataObjectRef="data_part_list_p1_do" />
    <bpmn:dataObject id="data_part_list_p1_do" />
    <bpmn:dataObjectReference id="data_inventory_status_p1" name="Inventory Status (Reserved/Back-ordered)" dataObjectRef="data_inventory_status_p1_do" />
    <bpmn:dataObject id="data_inventory_status_p1_do" />
    <bpmn:dataObjectReference id="data_assembled_bike" name="Assembled Bicycle" dataObjectRef="data_assembled_bike_do" />
    <bpmn:dataObject id="data_assembled_bike_do" />
    <bpmn:startEvent id="evt_start_engineering_prep" name="Receive Order Info">
      <bpmn:outgoing>flow_eng_prep_start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_engineering_prep_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_prep_finished" name="Preparation Finished">
      <bpmn:incoming>flow_prep_to_evt</bpmn:incoming>
      <bpmn:outgoing>flow_sync_in_2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_assembly_complete" name="Bicycle Assembled">
      <bpmn:incoming>flow_assemble_to_evt</bpmn:incoming>
      <bpmn:outgoing>flow_assemble_to_ship</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:manualTask id="task_prepare_assembly" name="Prepare for Assembly">
      <bpmn:incoming>flow_eng_prep_start</bpmn:incoming>
      <bpmn:outgoing>flow_prep_to_evt</bpmn:outgoing>
      <bpmn:property id="task_prepare_assembly_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prepare_assembly_dia0">
        <bpmn:sourceRef>data_part_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_prepare_assembly_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_assemble_bike" name="Assemble Bicycle">
      <bpmn:incoming>flow_sync_out</bpmn:incoming>
      <bpmn:outgoing>flow_assemble_to_evt</bpmn:outgoing>
      <bpmn:property id="task_assemble_bike_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_assemble_bike_dia0">
        <bpmn:sourceRef>data_inventory_status_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_assemble_bike_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_assemble_bike_doa0">
        <bpmn:targetRef>data_assembled_bike</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="gw_sync_assembly" name="Wait for Parts and Prep">
      <bpmn:incoming>flow_sync_in_1</bpmn:incoming>
      <bpmn:incoming>flow_sync_in_2</bpmn:incoming>
      <bpmn:outgoing>flow_sync_out</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_eng_prep_start" sourceRef="evt_start_engineering_prep" targetRef="task_prepare_assembly" />
    <bpmn:sequenceFlow id="flow_prep_to_evt" sourceRef="task_prepare_assembly" targetRef="evt_prep_finished" />
    <bpmn:sequenceFlow id="flow_sync_in_2" sourceRef="evt_prep_finished" targetRef="gw_sync_assembly" />
    <bpmn:sequenceFlow id="flow_sync_out" sourceRef="gw_sync_assembly" targetRef="task_assemble_bike" />
    <bpmn:sequenceFlow id="flow_assemble_to_evt" sourceRef="task_assemble_bike" targetRef="evt_assembly_complete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_sales_part_di" bpmnElement="pool_sales_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1140" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_storehouse_part_di" bpmnElement="pool_storehouse_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="950" height="400" />
