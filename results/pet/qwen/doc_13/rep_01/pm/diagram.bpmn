<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_forms" name="Relevant Forms" dataObjectRef="data_forms_do" />
    <bpmn:dataObject id="data_forms_do" />
    <bpmn:startEvent id="evt_start_claim_received" name="Claim Received">
      <bpmn:outgoing>flow_start_to_check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_rejected" name="Claim Rejected">
      <bpmn:incoming>flow_inform_reject_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_intermediate_forms_returned" name="Forms Returned">
      <bpmn:incoming>flow_send_to_forms_returned</bpmn:incoming>
      <bpmn:outgoing>flow_forms_returned_to_check</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_intermediate_forms_returned_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="evt_end_registered" name="Claim Registered">
      <bpmn:incoming>flow_register_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_intermediate_updated_forms_returned" name="Updated Forms Returned">
      <bpmn:incoming>flow_inform_update_to_updated_returned</bpmn:incoming>
      <bpmn:outgoing>flow_updated_returned_to_check</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_intermediate_updated_forms_returned_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_check_insured" name="Check if claimant is insured">
      <bpmn:incoming>flow_start_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gw_insured</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_inform_rejection" name="Inform claimant of rejection">
      <bpmn:incoming>flow_not_insured</bpmn:incoming>
      <bpmn:outgoing>flow_inform_reject_to_end</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_evaluate_severity" name="Evaluate severity of claim">
      <bpmn:incoming>flow_is_insured</bpmn:incoming>
      <bpmn:outgoing>flow_eval_to_gw_sev</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_send_forms" name="Send relevant forms to claimant">
      <bpmn:incoming>flow_simple</bpmn:incoming>
      <bpmn:incoming>flow_complex</bpmn:incoming>
      <bpmn:outgoing>flow_send_to_forms_returned</bpmn:outgoing>
      <bpmn:property id="task_send_forms_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_forms_dia0">
        <bpmn:sourceRef>data_forms</bpmn:sourceRef>
        <bpmn:targetRef>task_send_forms_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_check_completeness" name="Check forms for completeness">
      <bpmn:incoming>flow_forms_returned_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gw_comp</bpmn:outgoing>
      <bpmn:property id="task_check_completeness_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_completeness_dia0">
        <bpmn:sourceRef>data_forms</bpmn:sourceRef>
        <bpmn:targetRef>task_check_completeness_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_register_claim" name="Register claim in Claims Management system">
      <bpmn:incoming>flow_complete_yes</bpmn:incoming>
      <bpmn:incoming>flow_updated_complete_yes</bpmn:incoming>
      <bpmn:outgoing>flow_register_to_end</bpmn:outgoing>
      <bpmn:property id="task_register_claim_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_register_claim_dia0">
        <bpmn:sourceRef>data_forms</bpmn:sourceRef>
        <bpmn:targetRef>task_register_claim_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_inform_update" name="Inform claimant to update forms">
      <bpmn:incoming>flow_complete_no</bpmn:incoming>
      <bpmn:incoming>flow_updated_complete_no</bpmn:incoming>
      <bpmn:outgoing>flow_inform_update_to_updated_returned</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_check_updated_completeness" name="Check updated forms for completeness">
      <bpmn:incoming>flow_updated_returned_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_updated_to_gw_upd</bpmn:outgoing>
      <bpmn:property id="task_check_updated_completeness_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_updated_completeness_dia0">
        <bpmn:sourceRef>data_forms</bpmn:sourceRef>
        <bpmn:targetRef>task_check_updated_completeness_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_is_insured" name="Is Claimant Insured?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_to_gw_insured</bpmn:incoming>
      <bpmn:outgoing>flow_not_insured</bpmn:outgoing>
      <bpmn:outgoing>flow_is_insured</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_severity" name="Claim Severity" isMarkerVisible="true">
      <bpmn:incoming>flow_eval_to_gw_sev</bpmn:incoming>
      <bpmn:outgoing>flow_simple</bpmn:outgoing>
      <bpmn:outgoing>flow_complex</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_complete_initial" name="Are Forms Complete?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_to_gw_comp</bpmn:incoming>
      <bpmn:outgoing>flow_complete_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_complete_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_complete_updated" name="Are Updated Forms Complete?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_updated_to_gw_upd</bpmn:incoming>
      <bpmn:outgoing>flow_updated_complete_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_updated_complete_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_check" sourceRef="evt_start_claim_received" targetRef="task_check_insured" />
    <bpmn:sequenceFlow id="flow_check_to_gw_insured" sourceRef="task_check_insured" targetRef="gw_is_insured" />
    <bpmn:sequenceFlow id="flow_not_insured" sourceRef="gw_is_insured" targetRef="task_inform_rejection" name="Not Insured" />
    <bpmn:sequenceFlow id="flow_inform_reject_to_end" sourceRef="task_inform_rejection" targetRef="evt_end_rejected" />
    <bpmn:sequenceFlow id="flow_is_insured" sourceRef="gw_is_insured" targetRef="task_evaluate_severity" name="Insured" />
    <bpmn:sequenceFlow id="flow_eval_to_gw_sev" sourceRef="task_evaluate_severity" targetRef="gw_severity" />
    <bpmn:sequenceFlow id="flow_simple" sourceRef="gw_severity" targetRef="task_send_forms" name="Simple" />
    <bpmn:sequenceFlow id="flow_complex" sourceRef="gw_severity" targetRef="task_send_forms" name="Complex" />
    <bpmn:sequenceFlow id="flow_send_to_forms_returned" sourceRef="task_send_forms" targetRef="evt_intermediate_forms_returned" />
    <bpmn:sequenceFlow id="flow_forms_returned_to_check" sourceRef="evt_intermediate_forms_returned" targetRef="task_check_completeness" />
    <bpmn:sequenceFlow id="flow_check_to_gw_comp" sourceRef="task_check_completeness" targetRef="gw_complete_initial" />
    <bpmn:sequenceFlow id="flow_complete_yes" sourceRef="gw_complete_initial" targetRef="task_register_claim" name="Complete" />
    <bpmn:sequenceFlow id="flow_register_to_end" sourceRef="task_register_claim" targetRef="evt_end_registered" />
    <bpmn:sequenceFlow id="flow_complete_no" sourceRef="gw_complete_initial" targetRef="task_inform_update" name="Incomplete" />
    <bpmn:sequenceFlow id="flow_inform_update_to_updated_returned" sourceRef="task_inform_update" targetRef="evt_intermediate_updated_forms_returned" />
    <bpmn:sequenceFlow id="flow_updated_returned_to_check" sourceRef="evt_intermediate_updated_forms_returned" targetRef="task_check_updated_completeness" />
    <bpmn:sequenceFlow id="flow_check_updated_to_gw_upd" sourceRef="task_check_updated_completeness" targetRef="gw_complete_updated" />
    <bpmn:sequenceFlow id="flow_updated_complete_yes" sourceRef="gw_complete_updated" targetRef="task_register_claim" name="Complete" />
    <bpmn:sequenceFlow id="flow_updated_complete_no" sourceRef="gw_complete_updated" targetRef="task_inform_update" name="Incomplete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_registered_di" bpmnElement="evt_end_registered">
        <dc:Bounds x="2060" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_rejected_di" bpmnElement="evt_end_rejected">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_intermediate_forms_returned_di" bpmnElement="evt_intermediate_forms_returned">
        <dc:Bounds x="1300" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_intermediate_updated_forms_returned_di" bpmnElement="evt_intermediate_updated_forms_returned">
        <dc:Bounds x="2060" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_claim_received_di" bpmnElement="evt_start_claim_received">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_complete_initial_di" bpmnElement="gw_complete_initial">
        <dc:Bounds x="1680" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_complete_updated_di" bpmnElement="gw_complete_updated">
        <dc:Bounds x="2440" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_is_insured_di" bpmnElement="gw_is_insured">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_severity_di" bpmnElement="gw_severity">
        <dc:Bounds x="920" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_completeness_di" bpmnElement="task_check_completeness">
        <dc:Bounds x="1490" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_insured_di" bpmnElement="task_check_insured">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_updated_completeness_di" bpmnElement="task_check_updated_completeness">
        <dc:Bounds x="2250" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_evaluate_severity_di" bpmnElement="task_evaluate_severity">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_rejection_di" bpmnElement="task_inform_rejection">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_update_di" bpmnElement="task_inform_update">
        <dc:Bounds x="2630" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_claim_di" bpmnElement="task_register_claim">
        <dc:Bounds x="2630" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_forms_di" bpmnElement="task_send_forms">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_forms_di" bpmnElement="data_forms">
        <dc:Bounds x="1890" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_check_di" bpmnElement="flow_start_to_check">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_gw_insured_di" bpmnElement="flow_check_to_gw_insured">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_not_insured_di" bpmnElement="flow_not_insured">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_reject_to_end_di" bpmnElement="flow_inform_reject_to_end">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_is_insured_di" bpmnElement="flow_is_insured">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_eval_to_gw_sev_di" bpmnElement="flow_eval_to_gw_sev">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_simple_di" bpmnElement="flow_simple">
        <di:waypoint x="945" y="250" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_complex_di" bpmnElement="flow_complex">
        <di:waypoint x="945" y="250" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_send_to_forms_returned_di" bpmnElement="flow_send_to_forms_returned">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1318" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_forms_returned_to_check_di" bpmnElement="flow_forms_returned_to_check">
        <di:waypoint x="1318" y="118" />
        <di:waypoint x="1540" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_gw_comp_di" bpmnElement="flow_check_to_gw_comp">
        <di:waypoint x="1540" y="140" />
        <di:waypoint x="1705" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_complete_yes_di" bpmnElement="flow_complete_yes">
        <di:waypoint x="1705" y="125" />
        <di:waypoint x="2680" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_register_to_end_di" bpmnElement="flow_register_to_end">
        <di:waypoint x="2680" y="265" />
        <di:waypoint x="2078" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_complete_no_di" bpmnElement="flow_complete_no">
        <di:waypoint x="1705" y="125" />
        <di:waypoint x="2680" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_update_to_updated_returned_di" bpmnElement="flow_inform_update_to_updated_returned">
        <di:waypoint x="2680" y="140" />
        <di:waypoint x="2078" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_updated_returned_to_check_di" bpmnElement="flow_updated_returned_to_check">
        <di:waypoint x="2078" y="243" />
        <di:waypoint x="2300" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_updated_to_gw_upd_di" bpmnElement="flow_check_updated_to_gw_upd">
        <di:waypoint x="2300" y="140" />
        <di:waypoint x="2465" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_updated_complete_yes_di" bpmnElement="flow_updated_complete_yes">
        <di:waypoint x="2465" y="125" />
        <di:waypoint x="2680" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_updated_complete_no_di" bpmnElement="flow_updated_complete_no">
        <di:waypoint x="2465" y="125" />
        <di:waypoint x="2680" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_send_forms_dia0_di" bpmnElement="task_send_forms_dia0">
        <di:waypoint x="1908" y="390" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_completeness_dia0_di" bpmnElement="task_check_completeness_dia0">
        <di:waypoint x="1908" y="390" />
        <di:waypoint x="1540" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_register_claim_dia0_di" bpmnElement="task_register_claim_dia0">
        <di:waypoint x="1908" y="390" />
        <di:waypoint x="2680" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_updated_completeness_dia0_di" bpmnElement="task_check_updated_completeness_dia0">
        <di:waypoint x="1908" y="390" />
        <di:waypoint x="2300" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>