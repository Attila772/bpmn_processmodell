      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_mpon_or_mpoa_final_reading_di" bpmnElement="task_mpon_or_mpoa_final_reading">
        <dc:Bounds x="350" y="350" width="100" height="80" />
