      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_go_receive_readings_di" bpmnElement="evt_start_go_receive_readings">
        <dc:Bounds x="160" y="1270" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_mpoa_receive_di" bpmnElement="evt_start_mpoa_receive">
