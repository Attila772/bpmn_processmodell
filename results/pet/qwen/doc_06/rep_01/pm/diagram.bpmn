<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_mpoa_part" name="MPOO" processRef="pool_mpoa_proc" />
    <bpmn:participant id="pool_shared_ops_part" name="Shared Operations (MPON/MPOO)" processRef="pool_shared_ops_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_msp_part" name="MSP" processRef="pool_msp_proc" />
    <bpmn:messageFlow id="msg_1" sourceRef="evt_end_notify_mpoa" targetRef="evt_start_mpoa_decision" name="Equipment Change Intention Notification" />
    <bpmn:messageFlow id="msg_2" sourceRef="evt_end_self_dismount" targetRef="evt_start_read_dismount" name="Self-Dismounting Announcement" />
    <bpmn:messageFlow id="msg_3" sourceRef="evt_end_no_self_dismount" targetRef="evt_start_read_dismount" name="No Self-Dismounting Notification" />
    <bpmn:messageFlow id="msg_4" sourceRef="evt_end_final_reading" targetRef="evt_start_mount_new" name="Final Reading Data" />
    <bpmn:messageFlow id="msg_5" sourceRef="evt_end_dismount_old" targetRef="evt_start_mount_new" name="Old Equipment Dismounted" />
    <bpmn:messageFlow id="msg_6" sourceRef="evt_end_mount_new" targetRef="evt_start_read_installed" name="New Device Mounted" />
    <bpmn:messageFlow id="msg_7" sourceRef="evt_end_read_installed" targetRef="evt_start_device_change_info" name="Installed Meter Count" />
    <bpmn:messageFlow id="msg_8" sourceRef="evt_end_send_to_go" targetRef="evt_start_go_processing" name="Final Reading Values" />
    <bpmn:messageFlow id="msg_9" sourceRef="evt_end_device_change_info" targetRef="evt_start_device_change_info" name="Device Change Information" />
    <bpmn:messageFlow id="msg_10" sourceRef="evt_end_msp_notification" targetRef="evt_start_msp_notification" name="Complete Change Data" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_equipment_change_intention" name="Equipment Change Intention" dataObjectRef="data_equipment_change_intention_do" />
    <bpmn:dataObject id="data_equipment_change_intention_do" />
    <bpmn:dataObjectReference id="data_old_equipment_removed_p1" name="Old Equipment Removed Record" dataObjectRef="data_old_equipment_removed_p1_do" />
    <bpmn:dataObject id="data_old_equipment_removed_p1_do" />
    <bpmn:dataObjectReference id="data_new_device_installed" name="New Device Installed Record" dataObjectRef="data_new_device_installed_do" />
    <bpmn:dataObject id="data_new_device_installed_do" />
    <bpmn:dataObjectReference id="data_installed_meter_count" name="Installed Meter Count" dataObjectRef="data_installed_meter_count_do" />
    <bpmn:dataObject id="data_installed_meter_count_do" />
    <bpmn:dataObjectReference id="data_final_reading_p1" name="Final Reading" dataObjectRef="data_final_reading_p1_do" />
    <bpmn:dataObject id="data_final_reading_p1_do" />
    <bpmn:dataObjectReference id="data_final_reading_values" name="Final Reading Values" dataObjectRef="data_final_reading_values_do" />
    <bpmn:dataObject id="data_final_reading_values_do" />
    <bpmn:dataObjectReference id="data_master_data" name="Master Data" dataObjectRef="data_master_data_do" />
    <bpmn:dataObject id="data_master_data_do" />
    <bpmn:dataObjectReference id="data_device_change_info" name="Device Change Information" dataObjectRef="data_device_change_info_do" />
    <bpmn:dataObject id="data_device_change_info_do" />
    <bpmn:startEvent id="evt_start_mpon" name="Start: Equipment Change Intention">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_notify_mpoa" name="End: Notify MPOO of Intention">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_notify_mpoa_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_mount_new" name="Start: Mount New Device">
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mount_new_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mount_new" name="End: New Device Mounted">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mount_new_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_read_installed" name="Start: Read Installed Meter">
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_read_installed_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_read_installed" name="End: Installed Meter Read">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_read_installed_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_send_to_go" name="End: Send Values to GO">
      <bpmn:messageEventDefinition id="evt_end_send_to_go_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_device_change_info" name="End: Send Device Change Info">
      <bpmn:messageEventDefinition id="evt_end_device_change_info_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_notify_intention" name="Notify MPOO about equipment change intentions">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_notify_intention_doa0">
        <bpmn:targetRef>data_equipment_change_intention</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_mount_new_device" name="Mount the new device">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:property id="task_mount_new_device_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_mount_new_device_dia0">
        <bpmn:sourceRef>data_old_equipment_removed_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_mount_new_device_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_mount_new_device_doa0">
        <bpmn:targetRef>data_new_device_installed</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_read_installed_meter" name="Read the meter count from the installed meter">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:property id="task_read_installed_meter_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_read_installed_meter_dia0">
        <bpmn:sourceRef>data_new_device_installed</bpmn:sourceRef>
        <bpmn:targetRef>task_read_installed_meter_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_read_installed_meter_doa0">
        <bpmn:targetRef>data_installed_meter_count</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_send_final_reading_to_go" name="Send values of the final reading to the GO">
      <bpmn:property id="task_send_final_reading_to_go_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_final_reading_to_go_dia0">
        <bpmn:sourceRef>data_final_reading_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_send_final_reading_to_go_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_send_final_reading_to_go_doa0">
        <bpmn:targetRef>data_final_reading_values</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_tell_go_device_changes" name="Tell GO about device changes, master data and meter count at installation">
      <bpmn:property id="task_tell_go_device_changes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_tell_go_device_changes_dia0">
        <bpmn:sourceRef>data_installed_meter_count</bpmn:sourceRef>
        <bpmn:targetRef>task_tell_go_device_changes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_tell_go_device_changes_dia1">
        <bpmn:sourceRef>data_master_data</bpmn:sourceRef>
        <bpmn:targetRef>task_tell_go_device_changes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_tell_go_device_changes_doa0">
        <bpmn:targetRef>data_device_change_info</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_mpon" targetRef="task_notify_intention" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_notify_intention" targetRef="evt_end_notify_mpoa" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="evt_start_mount_new" targetRef="task_mount_new_device" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="task_mount_new_device" targetRef="evt_end_mount_new" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="evt_start_read_installed" targetRef="task_read_installed_meter" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="task_read_installed_meter" targetRef="evt_end_read_installed" />
  </bpmn:process>
  <bpmn:process id="pool_mpoa_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_equipment_change_intention_p1" name="Equipment Change Intention" dataObjectRef="data_equipment_change_intention_p1_do" />
    <bpmn:dataObject id="data_equipment_change_intention_p1_do" />
    <bpmn:dataObjectReference id="data_self_dismount_status" name="Self-Dismounting Status" dataObjectRef="data_self_dismount_status_do" />
    <bpmn:dataObject id="data_self_dismount_status_do" />
    <bpmn:dataObjectReference id="data_no_self_dismount_status" name="No Self-Dismounting Status" dataObjectRef="data_no_self_dismount_status_do" />
    <bpmn:dataObject id="data_no_self_dismount_status_do" />
    <bpmn:startEvent id="evt_start_mpoa_decision" name="Start: Receive Intention">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mpoa_decision_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_self_dismount" name="End: Announce Self Dismounting">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_self_dismount_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_no_self_dismount" name="End: Notify No Self-Dismounting">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_no_self_dismount_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_decide_dismount" name="Decide on self-dismounting">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_decide_dismount_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_decide_dismount_dia0">
        <bpmn:sourceRef>data_equipment_change_intention_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_decide_dismount_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_announce_self_dismount" name="Announce self dismounting">
      <bpmn:incoming>flow_self_dismount</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_announce_self_dismount_doa0">
        <bpmn:targetRef>data_self_dismount_status</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_notify_no_self_dismount" name="Notify MPON about no self-dismounting">
      <bpmn:incoming>flow_no_self_dismount</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_notify_no_self_dismount_doa0">
        <bpmn:targetRef>data_no_self_dismount_status</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_dismount_decision" name="Self-Dismounting Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_self_dismount</bpmn:outgoing>
      <bpmn:outgoing>flow_no_self_dismount</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_3" sourceRef="evt_start_mpoa_decision" targetRef="task_decide_dismount" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_decide_dismount" targetRef="gw_dismount_decision" />
    <bpmn:sequenceFlow id="flow_self_dismount" sourceRef="gw_dismount_decision" targetRef="task_announce_self_dismount" name="Self-dismounting" />
    <bpmn:sequenceFlow id="flow_no_self_dismount" sourceRef="gw_dismount_decision" targetRef="task_notify_no_self_dismount" name="No self-dismounting" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_announce_self_dismount" targetRef="evt_end_self_dismount" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_notify_no_self_dismount" targetRef="evt_end_no_self_dismount" />
  </bpmn:process>
  <bpmn:process id="pool_shared_ops_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_self_dismount_status_p1" name="Self-Dismounting Status" dataObjectRef="data_self_dismount_status_p1_do" />
    <bpmn:dataObject id="data_self_dismount_status_p1_do" />
    <bpmn:dataObjectReference id="data_no_self_dismount_status_p1" name="No Self-Dismounting Status" dataObjectRef="data_no_self_dismount_status_p1_do" />
    <bpmn:dataObject id="data_no_self_dismount_status_p1_do" />
    <bpmn:dataObjectReference id="data_final_reading" name="Final Reading" dataObjectRef="data_final_reading_do" />
    <bpmn:dataObject id="data_final_reading_do" />
    <bpmn:dataObjectReference id="data_old_equipment_removed" name="Old Equipment Removed Record" dataObjectRef="data_old_equipment_removed_do" />
    <bpmn:dataObject id="data_old_equipment_removed_do" />
    <bpmn:startEvent id="evt_start_read_dismount" name="Start: Perform Final Reading/Dismount">
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_read_dismount_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_final_reading" name="End: Final Reading Complete">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_final_reading_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_dismount_old" name="End: Old Equipment Dismounted">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_dismount_old_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_perform_final_reading" name="Perform final reading">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:property id="task_perform_final_reading_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_perform_final_reading_dia0">
        <bpmn:sourceRef>data_self_dismount_status_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_perform_final_reading_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_perform_final_reading_dia1">
        <bpmn:sourceRef>data_no_self_dismount_status_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_perform_final_reading_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_perform_final_reading_doa0">
        <bpmn:targetRef>data_final_reading</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_dismount_old_equipment" name="Dismount the old equipment">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:property id="task_dismount_old_equipment_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_dismount_old_equipment_dia0">
        <bpmn:sourceRef>data_final_reading</bpmn:sourceRef>
        <bpmn:targetRef>task_dismount_old_equipment_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_dismount_old_equipment_doa0">
        <bpmn:targetRef>data_old_equipment_removed</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:inclusiveGateway id="gw_merge_dismount_status" name="Merge Dismount Status">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="flow_7" sourceRef="evt_start_read_dismount" targetRef="gw_merge_dismount_status" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="gw_merge_dismount_status" targetRef="task_perform_final_reading" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_perform_final_reading" targetRef="evt_end_final_reading" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="evt_start_read_dismount" targetRef="task_dismount_old_equipment" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_dismount_old_equipment" targetRef="evt_end_dismount_old" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_device_change_info_p1" name="Device Change Information" dataObjectRef="data_device_change_info_p1_do" />
    <bpmn:dataObject id="data_device_change_info_p1_do" />
    <bpmn:dataObjectReference id="data_final_reading_values_p1" name="Final Reading Values" dataObjectRef="data_final_reading_values_p1_do" />
    <bpmn:dataObject id="data_final_reading_values_p1_do" />
    <bpmn:dataObjectReference id="data_complete_change_data" name="Complete Change Data" dataObjectRef="data_complete_change_data_do" />
    <bpmn:dataObject id="data_complete_change_data_do" />
    <bpmn:startEvent id="evt_start_go_processing" name="Start: GO Processing">
      <bpmn:outgoing>flow_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_go_processing_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_device_change_info" name="Start: Device Change Info">
      <bpmn:outgoing>flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_device_change_info_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_msp_notification" name="End: Notify MSP">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_msp_notification_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_notify_msp" name="Notify MSP about device changes, master data, meter counts">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
      <bpmn:property id="task_notify_msp_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_notify_msp_dia0">
        <bpmn:sourceRef>data_device_change_info_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_notify_msp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_notify_msp_dia1">
        <bpmn:sourceRef>data_final_reading_values_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_notify_msp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_notify_msp_doa0">
        <bpmn:targetRef>data_complete_change_data</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gw_merge_mp_inputs" name="Merge MP Inputs for GO">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_16" sourceRef="evt_start_go_processing" targetRef="gw_merge_mp_inputs" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="evt_start_device_change_info" targetRef="gw_merge_mp_inputs" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="gw_merge_mp_inputs" targetRef="task_notify_msp" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="task_notify_msp" targetRef="evt_end_msp_notification" />
  </bpmn:process>
  <bpmn:process id="pool_msp_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_msp_notification" name="Start: MSP Notification">
      <bpmn:outgoing>flow_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_msp_notification_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_process_complete" name="Process Complete">
      <bpmn:incoming>flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_20" sourceRef="evt_start_msp_notification" targetRef="evt_process_complete" />
  </bpmn:process>
