<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="AccountDefaulterProcess" name="Account Defaulter Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Weekday Morning">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_BackupDB" name="Backup Database">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckNewRecords" name="Check Account Defaulter Table for New Records">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_NoNewRecords</bpmn:outgoing>
      <bpmn:outgoing>Flow_NewRecordsExist</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckCRMReturns" name="Check CRM System for New Returns">
      <bpmn:incoming>Flow_NoNewRecords</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckCRMReturnsResult" name="New Returns Filed?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_NewReturnsYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_NewReturnsNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RegisterDefaulters" name="Register All Defaulting Accounts and Customers">
      <bpmn:incoming>Flow_NewReturnsYes</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AdvisedCheck" name="Client Codes Previously Advised?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_NotAdvised</bpmn:outgoing>
      <bpmn:outgoing>Flow_Advised</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ProduceTableAndSend" name="Produce Table of Defaulting Accounts and Send to Account Management">
      <bpmn:incoming>Flow_NotAdvised</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Timer_230PM" name="Deadline 2:30 PM">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_TimeOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_TimeExceeded</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_SendAlertSupervisor" name="Send Alert to Supervisor">
      <bpmn:incoming>Flow_TimeExceeded</bpmn:incoming>
      <bpmn:outgoing>Flow_EndAlert</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_AlertSent" name="Alert Sent">
      <bpmn:incoming>Flow_EndAlert</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CheckCRMReturnsAgain" name="Check CRM System for New Returns (Post-Report)">
      <bpmn:incoming>Flow_TimeOK</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckCRMReturnsResult2" name="New Returns Filed?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_ReconcileYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReconcileNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReconcileAccounts" name="Reconcile with Existing Account Defaulters Table">
      <bpmn:incoming>Flow_ReconcileYes</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Timer_400PM" name="Deadline 4:00 PM">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_TimeOK2</bpmn:outgoing>
      <bpmn:outgoing>Flow_TimeExceeded2</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_SendMessageSupervisor" name="Send Message to Supervisor">
      <bpmn:incoming>Flow_TimeExceeded2</bpmn:incoming>
      <bpmn:outgoing>Flow_EndMessage</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_MessageSent" name="Message Sent">
      <bpmn:incoming>Flow_EndMessage</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>Flow_TimeOK2</bpmn:incoming>
      <bpmn:incoming>Flow_ReconcileNo</bpmn:incoming>
      <bpmn:incoming>Flow_Advised</bpmn:incoming>
      <bpmn:incoming>Flow_NewReturnsNo</bpmn:incoming>
      <bpmn:incoming>Flow_NewRecordsExist</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_BackupDB"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_BackupDB" targetRef="Gateway_CheckNewRecords"/>
    <bpmn:sequenceFlow id="Flow_NoNewRecords" name="No New Records" sourceRef="Gateway_CheckNewRecords" targetRef="Task_CheckCRMReturns"/>
    <bpmn:sequenceFlow id="Flow_NewRecordsExist" name="New Records Found" sourceRef="Gateway_CheckNewRecords" targetRef="EndEvent_Completed"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckCRMReturns" targetRef="Gateway_CheckCRMReturnsResult"/>
    <bpmn:sequenceFlow id="Flow_NewReturnsYes" name="Yes" sourceRef="Gateway_CheckCRMReturnsResult" targetRef="Task_RegisterDefaulters"/>
    <bpmn:sequenceFlow id="Flow_NewReturnsNo" name="No" sourceRef="Gateway_CheckCRMReturnsResult" targetRef="EndEvent_Completed"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_RegisterDefaulters" targetRef="Gateway_AdvisedCheck"/>
    <bpmn:sequenceFlow id="Flow_NotAdvised" name="Not Advised" sourceRef="Gateway_AdvisedCheck" targetRef="Task_ProduceTableAndSend"/>
    <bpmn:sequenceFlow id="Flow_Advised" name="Previously Advised" sourceRef="Gateway_AdvisedCheck" targetRef="EndEvent_Completed"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ProduceTableAndSend" targetRef="Timer_230PM"/>
    <bpmn:sequenceFlow id="Flow_TimeOK" name="Within Time" sourceRef="Timer_230PM" targetRef="Task_CheckCRMReturnsAgain"/>
    <bpmn:sequenceFlow id="Flow_TimeExceeded" name="Time Exceeded" sourceRef="Timer_230PM" targetRef="Task_SendAlertSupervisor"/>
    <bpmn:sequenceFlow id="Flow_EndAlert" sourceRef="Task_SendAlertSupervisor" targetRef="EndEvent_AlertSent"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CheckCRMReturnsAgain" targetRef="Gateway_CheckCRMReturnsResult2"/>
    <bpmn:sequenceFlow id="Flow_ReconcileYes" name="Yes" sourceRef="Gateway_CheckCRMReturnsResult2" targetRef="Task_ReconcileAccounts"/>
    <bpmn:sequenceFlow id="Flow_ReconcileNo" name="No" sourceRef="Gateway_CheckCRMReturnsResult2" targetRef="EndEvent_Completed"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ReconcileAccounts" targetRef="Timer_400PM"/>
    <bpmn:sequenceFlow id="Flow_TimeOK2" name="Within Time" sourceRef="Timer_400PM" targetRef="EndEvent_Completed"/>
    <bpmn:sequenceFlow id="Flow_TimeExceeded2" name="Time Exceeded" sourceRef="Timer_400PM" targetRef="Task_SendMessageSupervisor"/>
    <bpmn:sequenceFlow id="Flow_EndMessage" sourceRef="Task_SendMessageSupervisor" targetRef="EndEvent_MessageSent"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="AccountDefaulterProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BackupDB_di" bpmnElement="Task_BackupDB">
        <dc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckNewRecords_di" bpmnElement="Gateway_CheckNewRecords" isMarkerVisible="true">
        <dc:Bounds x="390" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckCRMReturns_di" bpmnElement="Task_CheckCRMReturns">
        <dc:Bounds x="490" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckCRMReturnsResult_di" bpmnElement="Gateway_CheckCRMReturnsResult" isMarkerVisible="true">
        <dc:Bounds x="640" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterDefaulters_di" bpmnElement="Task_RegisterDefaulters">
        <dc:Bounds x="740" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AdvisedCheck_di" bpmnElement="Gateway_AdvisedCheck" isMarkerVisible="true">
        <dc:Bounds x="890" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProduceTableAndSend_di" bpmnElement="Task_ProduceTableAndSend">
        <dc:Bounds x="990" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_230PM_di" bpmnElement="Timer_230PM">
        <dc:Bounds x="1142" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendAlertSupervisor_di" bpmnElement="Task_SendAlertSupervisor">
        <dc:Bounds x="1240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_AlertSent_di" bpmnElement="EndEvent_AlertSent">
        <dc:Bounds x="1392" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckCRMReturnsAgain_di" bpmnElement="Task_CheckCRMReturnsAgain">
        <dc:Bounds x="1240" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckCRMReturnsResult2_di" bpmnElement="Gateway_CheckCRMReturnsResult2" isMarkerVisible="true">
        <dc:Bounds x="1390" y="215" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReconcileAccounts_di" bpmnElement="Task_ReconcileAccounts">
        <dc:Bounds x="1490" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_400PM_di" bpmnElement="Timer_400PM">
        <dc:Bounds x="1642" y="222" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendMessageSupervisor_di" bpmnElement="Task_SendMessageSupervisor">
        <dc:Bounds x="1740" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_MessageSent_di" bpmnElement="EndEvent_MessageSent">
        <dc:Bounds x="1892" y="222" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="1742" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120"/>
        <di:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120"/>
        <di:waypoint x="390" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoNewRecords_di" bpmnElement="Flow_NoNewRecords">
        <di:waypoint x="440" y="120"/>
        <di:waypoint x="490" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NewRecordsExist_di" bpmnElement="Flow_NewRecordsExist">
        <di:waypoint x="415" y="95"/>
        <di:waypoint x="415" y="50"/>
        <di:waypoint x="1760" y="50"/>
        <di:waypoint x="1760" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="590" y="120"/>
        <di:waypoint x="640" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NewReturnsYes_di" bpmnElement="Flow_NewReturnsYes">
        <di:waypoint x="690" y="120"/>
        <di:waypoint x="740" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NewReturnsNo_di" bpmnElement="Flow_NewReturnsNo">
        <di:waypoint x="665" y="95"/>
        <di:waypoint x="665" y="50"/>
        <di:waypoint x="1760" y="50"/>
        <di:waypoint x="1760" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="840" y="120"/>
        <di:waypoint x="890" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotAdvised_di" bpmnElement="Flow_NotAdvised">
        <di:waypoint x="940" y="120"/>
        <di:waypoint x="990" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Advised_di" bpmnElement="Flow_Advised">
        <di:waypoint x="915" y="95"/>
        <di:waypoint x="915" y="50"/>
        <di:waypoint x="1760" y="50"/>
        <di:waypoint x="1760" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1090" y="120"/>
        <di:waypoint x="1142" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TimeOK_di" bpmnElement="Flow_TimeOK">
        <di:waypoint x="1160" y="138"/>
        <di:waypoint x="1160" y="240"/>
        <di:waypoint x="1240" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TimeExceeded_di" bpmnElement="Flow_TimeExceeded">
        <di:waypoint x="1178" y="120"/>
        <di:waypoint x="1240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EndAlert_di" bpmnElement="Flow_EndAlert">
        <di:waypoint x="1340" y="120"/>
        <di:waypoint x="1392" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1340" y="240"/>
        <di:waypoint x="1390" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReconcileYes_di" bpmnElement="Flow_ReconcileYes">
        <di:waypoint x="1440" y="240"/>
        <di:waypoint x="1490" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReconcileNo_di" bpmnElement="Flow_ReconcileNo">
        <di:waypoint x="1415" y="215"/>
        <di:waypoint x="1415" y="150"/>
        <di:waypoint x="1760" y="150"/>
        <di:waypoint x="1760" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1590" y="240"/>
        <di:waypoint x="1642" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TimeOK2_di" bpmnElement="Flow_TimeOK2">
        <di:waypoint x="1660" y="258"/>
        <di:waypoint x="1660" y="150"/>
        <di:waypoint x="1760" y="150"/>
        <di:waypoint x="1760" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TimeExceeded2_di" bpmnElement="Flow_TimeExceeded2">
        <di:waypoint x="1678" y="240"/>
        <di:waypoint x="1740" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EndMessage_di" bpmnElement="Flow_EndMessage">
        <di:waypoint x="1840" y="240"/>
        <di:waypoint x="1892" y="240"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>