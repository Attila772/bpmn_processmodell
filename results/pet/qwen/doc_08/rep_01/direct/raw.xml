    <bpmn:sequenceFlow id="Flow_TimeOK" name="Within Time" sourceRef="Timer_230pm" targetRef="Task_CheckCRMAgain" />
    <bpmn:sequenceFlow id="Flow_TimeExceeded" name="Time Exceeded" sourceRef="Timer_230pm" targetRef="Task_SendAlertSupervisor" />
    <bpmn:sequenceFlow id="Flow_EndAlert" sourceRef="Task_SendAlertSupervisor" targetRef="EndEvent_Alert" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CheckCRMAgain" targetRef="Gateway_CheckCRMReturnsResult2" />
