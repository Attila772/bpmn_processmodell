    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_SendMessageSupervisor" name="Send Message to Supervisor">
      <bpmn:incoming>Flow_TimeExceeded2</bpmn:incoming>
      <bpmn:outgoing>Flow_EndMessage</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Message" name="Message Sent">
      <bpmn:incoming>Flow_EndMessage</bpmn:incoming>
    </bpmn:endEvent>
