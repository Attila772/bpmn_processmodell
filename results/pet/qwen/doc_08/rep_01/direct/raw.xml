  <bpmn:process id="AccountDefaulterProcess" name="Account Defaulter Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Weekday Morning">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_BackupDB" name="Backup Database">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckNewRecords" name="Check Account Defaulter Table for New Records">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_NoNewRecords</bpmn:outgoing>
      <bpmn:outgoing>Flow_NewRecordsExist</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckCRMReturns" name="Check CRM for New Returns">
      <bpmn:incoming>Flow_NoNewRecords</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckCRMReturnsResult" name="New Returns Filed?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnsExist</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoReturns</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RegisterDefaulters" name="Register Defaulting Accounts and Customers">
      <bpmn:incoming>Flow_ReturnsExist</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AdvisedCheck" name="Client Codes Previously Advised?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_NotAdvised</bpmn:outgoing>
      <bpmn:outgoing>Flow_Advised</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ProduceTableAndSend" name="Produce Table of Defaulting Accounts and Send to Account Management">
      <bpmn:incoming>Flow_NotAdvised</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Timer_230pm" name="Deadline 2:30 PM">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_TimeOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_TimeExceeded</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_SendAlertSupervisor" name="Send Alert to Supervisor">
      <bpmn:incoming>Flow_TimeExceeded</bpmn:incoming>
      <bpmn:outgoing>Flow_EndAlert</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Alert" name="Alert Sent">
      <bpmn:incoming>Flow_EndAlert</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CheckCRMAgain" name="Check CRM for New Returns (Post-Report)">
      <bpmn:incoming>Flow_TimeOK</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckCRMReturnsResult2" name="New Returns Filed?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
