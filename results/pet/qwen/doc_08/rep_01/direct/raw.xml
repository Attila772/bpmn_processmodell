      <bpmn:incoming>Flow_ReturnsExist2</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Timer_400pm" name="Deadline 4:00 PM">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_TimeOK2</bpmn:outgoing>
      <bpmn:outgoing>Flow_TimeExceeded2</bpmn:outgoing>
