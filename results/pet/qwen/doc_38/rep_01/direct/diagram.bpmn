<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="LoanApprovalProcess" name="Loan Approval Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ReceiveRequest" name="Receive Customer Request">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ReceiveRequest" targetRef="Task_RiskAssessment" />
    <bpmn:task id="Task_RiskAssessment" name="Invoke Risk Assessment Web Service">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision Gateway">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Deny</bpmn:outgoing>
      <bpmn:outgoing>Flow_FurtherReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RiskAssessment" targetRef="Gateway_Decision" />
    
    <!-- Path 1: Approved -->
    <bpmn:sequenceFlow id="Flow_Approve" name="Small Loan &amp; Low Risk" sourceRef="Gateway_Decision" targetRef="Task_ApproveLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">loanAmount &lt; 10000 AND riskLevel == 'LOW'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Task_ApproveLoan" name="Approve Loan">
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFeedback</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Denied -->
    <bpmn:sequenceFlow id="Flow_Deny" name="High Risk" sourceRef="Gateway_Decision" targetRef="Task_DenyLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">riskLevel == 'HIGH'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Task_DenyLoan" name="Deny Loan">
      <bpmn:incoming>Flow_Deny</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFeedback</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 3: Further Review -->
    <bpmn:sequenceFlow id="Flow_FurtherReview" name="Further Review or Large Amount" sourceRef="Gateway_Decision" targetRef="Task_ApproverService">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">loanAmount &gt;= 10000 OR needsReview == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Task_ApproverService" name="Invoke Approver Web Service">
      <bpmn:incoming>Flow_FurtherReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFeedback</bpmn:outgoing>
    </bpmn:task>

    <!-- Feedback End Event -->
    <bpmn:sequenceFlow id="Flow_ToFeedback" sourceRef="Task_ApproveLoan" targetRef="EndEvent_Feedback" />
    <bpmn:sequenceFlow id="Flow_ToFeedback_2" sourceRef="Task_DenyLoan" targetRef="EndEvent_Feedback" />
    <bpmn:sequenceFlow id="Flow_ToFeedback_3" sourceRef="Task_ApproverService" targetRef="EndEvent_Feedback" />
    
    <bpmn:endEvent id="EndEvent_Feedback" name="Send Feedback to Customer">
      <bpmn:incoming>Flow_ToFeedback</bpmn:incoming>
      <bpmn:incoming>Flow_ToFeedback_2</bpmn:incoming>
      <bpmn:incoming>Flow_ToFeedback_3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>