<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="GoPublicProcess" name="Company Going Public Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Decision to Go Public">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProvideAdvice" name="Provide Procedural and Financial Advice">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrepareRegistration" name="Prepare Registration Statement for SEC">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckBlueSkyLaws" name="Check Compliance with Blue-Sky Laws">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_1" name="Start Parallel Activities">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_AwaitSECApproval" name="Await SEC Approval">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FirmUpPrice" name="Firm Up Issue Price">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RoadShow" name="Arrange Road Show to Talk to Potential Investors">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_2" name="Synchronize Activities">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_FixIssuePrice" name="Fix Issue Price">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Reason Not To Proceed?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Cancelled" name="Process Cancelled">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_BuyStock" name="Enter Firm Commitment to Buy Stock">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OfferToPublic" name="Offer Stock to the Public">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Completed" name="IPO Completed">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SelectUnderwriters" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SelectUnderwriters" targetRef="Task_ProvideAdvice" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ProvideAdvice" targetRef="Task_PrepareRegistration" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PrepareRegistration" targetRef="Task_CheckBlueSkyLaws" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CheckBlueSkyLaws" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_1" targetRef="Task_AwaitSECApproval" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_1" targetRef="Task_FirmUpPrice" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_AwaitSECApproval" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_FirmUpPrice" targetRef="Task_RoadShow" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RoadShow" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_2" targetRef="Task_FixIssuePrice" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_FixIssuePrice" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Yes" sourceRef="Gateway_Decision" targetRef="EndEvent_Cancelled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reasonFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_No" sourceRef="Gateway_Decision" targetRef="Task_BuyStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reasonFound = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_BuyStock" targetRef="Task_OfferToPublic" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_OfferToPublic" targetRef="EndEvent_Completed" />
  </bpmn:process>
</bpmn:definitions>