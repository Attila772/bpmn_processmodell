<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_company_part" name="Company" processRef="pool_company_proc" />
    <bpmn:participant id="pool_underwriters_part" name="Underwriters" processRef="pool_underwriters_proc" />
    <bpmn:participant id="pool_sec_part" name="Securities and Exchange Commission (SEC)" processRef="pool_sec_proc" />
    <bpmn:messageFlow id="msg_1" sourceRef="evt_end_select_underwriters" targetRef="evt_start_underwriters" name="Selection of underwriters" />
    <bpmn:messageFlow id="msg_2" sourceRef="evt_end_registration_submitted" targetRef="evt_start_sec_review" name="Registration statement submission" />
    <bpmn:messageFlow id="msg_3" sourceRef="evt_end_sec_approval" targetRef="evt_start_price_fixing" name="SEC Clearance" />
  </bpmn:collaboration>
  <bpmn:process id="pool_company_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_company" name="Decision to go public">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_select_underwriters" name="Underwriters selected">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_select_underwriters_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_select_underwriters" name="Select the underwriters">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_company" targetRef="task_select_underwriters" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_select_underwriters" targetRef="evt_end_select_underwriters" />
  </bpmn:process>
  <bpmn:process id="pool_underwriters_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_reg_statement" name="Registration statement" dataObjectRef="data_reg_statement_do" />
    <bpmn:dataObject id="data_reg_statement_do" />
    <bpmn:startEvent id="evt_start_underwriters" name="Receive selection">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_underwriters_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_registration_submitted" name="Registration statement submitted">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_registration_submitted_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_price_fixing" name="Receive SEC Clearance">
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_price_fixing_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_ipo_complete" name="Stock offered to public">
      <bpmn:incoming>flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_provide_advice" name="Provide procedural and financial advice">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_prepare_registration" name="Prepare registration statement">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_prepare_registration_doa0">
        <bpmn:targetRef>data_reg_statement</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_blue_sky_laws" name="Check compliance with blue-sky laws">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_check_blue_sky_laws_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_blue_sky_laws_dia0">
        <bpmn:sourceRef>data_reg_statement</bpmn:sourceRef>
        <bpmn:targetRef>task_check_blue_sky_laws_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_firm_up_price" name="Firm up issue price">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_arrange_road_show" name="Arrange road show">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_fix_issue_price" name="Fix the issue price">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_commit_buy_stock" name="Enter into firm commitment to buy stock">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_offer_to_public" name="Offer stock to the public">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_3" sourceRef="evt_start_underwriters" targetRef="task_provide_advice" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_provide_advice" targetRef="task_prepare_registration" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_prepare_registration" targetRef="task_check_blue_sky_laws" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_check_blue_sky_laws" targetRef="task_firm_up_price" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_firm_up_price" targetRef="task_arrange_road_show" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_arrange_road_show" targetRef="evt_end_registration_submitted" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="evt_start_price_fixing" targetRef="task_fix_issue_price" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="task_fix_issue_price" targetRef="task_commit_buy_stock" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="task_commit_buy_stock" targetRef="task_offer_to_public" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="task_offer_to_public" targetRef="evt_end_ipo_complete" />
  </bpmn:process>
  <bpmn:process id="pool_sec_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_reg_statement_p1" name="Registration statement" dataObjectRef="data_reg_statement_p1_do" />
    <bpmn:dataObject id="data_reg_statement_p1_do" />
    <bpmn:startEvent id="evt_start_sec_review" name="Receive registration statement">
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_sec_review_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_sec_approval" name="SEC Approval granted">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_sec_approval_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_review_registration" name="Review registration statement">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:property id="task_review_registration_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_registration_dia0">
        <bpmn:sourceRef>data_reg_statement_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_registration_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_9" sourceRef="evt_start_sec_review" targetRef="task_review_registration" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_review_registration" targetRef="evt_end_sec_approval" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_company_part_di" bpmnElement="pool_company_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_underwriters_part_di" bpmnElement="pool_underwriters_part" isHorizontal="true">
        <dc:Bounds x="120" y="375" width="1520" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_sec_part_di" bpmnElement="pool_sec_part" isHorizontal="true">
        <dc:Bounds x="120" y="835" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_ipo_complete_di" bpmnElement="evt_end_ipo_complete">
        <dc:Bounds x="920" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_registration_submitted_di" bpmnElement="evt_end_registration_submitted">
