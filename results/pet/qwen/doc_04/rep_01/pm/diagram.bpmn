      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_select_underwriters_di" bpmnElement="evt_end_select_underwriters">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_company_di" bpmnElement="evt_start_company">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_price_fixing_di" bpmnElement="evt_start_price_fixing">
        <dc:Bounds x="160" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_sec_review_di" bpmnElement="evt_start_sec_review">
        <dc:Bounds x="160" y="895" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_underwriters_di" bpmnElement="evt_start_underwriters">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_arrange_road_show_di" bpmnElement="task_arrange_road_show">
        <dc:Bounds x="1110" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_blue_sky_laws_di" bpmnElement="task_check_blue_sky_laws">
        <dc:Bounds x="730" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_commit_buy_stock_di" bpmnElement="task_commit_buy_stock">
        <dc:Bounds x="540" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_firm_up_price_di" bpmnElement="task_firm_up_price">
        <dc:Bounds x="920" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_fix_issue_price_di" bpmnElement="task_fix_issue_price">
        <dc:Bounds x="350" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_offer_to_public_di" bpmnElement="task_offer_to_public">
        <dc:Bounds x="730" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prepare_registration_di" bpmnElement="task_prepare_registration">
        <dc:Bounds x="540" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_provide_advice_di" bpmnElement="task_provide_advice">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_registration_di" bpmnElement="task_review_registration">
        <dc:Bounds x="350" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_select_underwriters_di" bpmnElement="task_select_underwriters">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_reg_statement_di" bpmnElement="data_reg_statement">
        <dc:Bounds x="655" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_reg_statement_p1_di" bpmnElement="data_reg_statement_p1">
        <dc:Bounds x="370" y="1035" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
