<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:messageFlow id="msg_dereg_request" sourceRef="end_mpoo_process" targetRef="start_go_verify" name="Deregistration Request" />
    <bpmn:messageFlow id="msg_rejection" sourceRef="intermediate_rejection" targetRef="end_go_rejection" name="Rejection Notice" />
    <bpmn:messageFlow id="msg_continuation_obligation" sourceRef="intermediate_continuation_request" targetRef="start_mpoo_confirm" name="Continuation Obligation" />
    <bpmn:messageFlow id="msg_continuation_confirmation" sourceRef="end_mpoo_confirm" targetRef="start_go_post_confirm" name="Continuation Confirmation" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_dereg_request" name="Deregistration Request Document" dataObjectRef="data_dereg_request_do" />
    <bpmn:dataObject id="data_dereg_request_do" />
    <bpmn:dataObjectReference id="data_continuation_obligation_p1" name="Continuation Obligation Notice" dataObjectRef="data_continuation_obligation_p1_do" />
    <bpmn:dataObject id="data_continuation_obligation_p1_do" />
    <bpmn:dataObjectReference id="data_continuation_confirmation" name="Continuation Confirmation" dataObjectRef="data_continuation_confirmation_do" />
    <bpmn:dataObject id="data_continuation_confirmation_do" />
    <bpmn:startEvent id="start_mpoo_dereg" name="MPOO initiates deregistration">
      <bpmn:outgoing>flow_start_to_dereg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpoo_process" name="MPOO process part completed">
      <bpmn:incoming>flow_dereg_to_end_mpoo</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_mpoo_process_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_mpoo_confirm" name="Receive Continuation Obligation">
      <bpmn:outgoing>flow_start_mpoo_conf_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpoo_confirm_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpoo_confirm" name="Confirmation Sent">
      <bpmn:incoming>flow_mpoo_conf_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_mpoo_confirm_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_mpoo_deregister" name="Deregister at GO">
      <bpmn:incoming>flow_start_to_dereg</bpmn:incoming>
      <bpmn:outgoing>flow_dereg_to_end_mpoo</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mpoo_deregister_doa0">
        <bpmn:targetRef>data_dereg_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_mpoo_confirm_continuation" name="Confirm continuation">
      <bpmn:incoming>flow_start_mpoo_conf_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_mpoo_conf_to_end</bpmn:outgoing>
      <bpmn:property id="task_mpoo_confirm_continuation_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_mpoo_confirm_continuation_dia0">
        <bpmn:sourceRef>data_continuation_obligation_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_mpoo_confirm_continuation_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_mpoo_confirm_continuation_doa0">
        <bpmn:targetRef>data_continuation_confirmation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_start_to_dereg" sourceRef="start_mpoo_dereg" targetRef="task_mpoo_deregister" />
    <bpmn:sequenceFlow id="flow_dereg_to_end_mpoo" sourceRef="task_mpoo_deregister" targetRef="end_mpoo_process" />
    <bpmn:sequenceFlow id="flow_start_mpoo_conf_to_task" sourceRef="start_mpoo_confirm" targetRef="task_mpoo_confirm_continuation" />
    <bpmn:sequenceFlow id="flow_mpoo_conf_to_end" sourceRef="task_mpoo_confirm_continuation" targetRef="end_mpoo_confirm" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_dereg_request_p1" name="Deregistration Request Document" dataObjectRef="data_dereg_request_p1_do" />
    <bpmn:dataObject id="data_dereg_request_p1_do" />
    <bpmn:dataObjectReference id="data_continuation_obligation" name="Continuation Obligation Notice" dataObjectRef="data_continuation_obligation_do" />
    <bpmn:dataObject id="data_continuation_obligation_do" />
    <bpmn:dataObjectReference id="data_assignment_record" name="Assignment Record" dataObjectRef="data_assignment_record_do" />
    <bpmn:dataObject id="data_assignment_record_do" />
    <bpmn:startEvent id="start_go_verify" name="Receive Deregistration Request">
      <bpmn:outgoing>flow_start_go_to_verify</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_go_verify_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="intermediate_rejection" name="Deregistration Rejected">
      <bpmn:incoming>flow_verify_to_reject</bpmn:incoming>
      <bpmn:outgoing>flow_reject_to_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="intermediate_rejection_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_go_rejection" name="Process End (Rejected)">
      <bpmn:incoming>flow_reject_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="intermediate_continuation_request" name="Continuation Obligation Sent">
      <bpmn:incoming>flow_oblige_to_msg</bpmn:incoming>
      <bpmn:messageEventDefinition id="intermediate_continuation_request_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="start_go_post_confirm" name="Receive Continuation Confirmation">
      <bpmn:outgoing>flow_start_go_post_to_equip</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_go_post_confirm_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_go_process" name="Assignment Complete">
      <bpmn:incoming>flow_inform_others_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_go_verify" name="Verify deregistration">
      <bpmn:incoming>flow_start_go_to_verify</bpmn:incoming>
      <bpmn:outgoing>flow_verify_to_gw</bpmn:outgoing>
      <bpmn:property id="task_go_verify_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_go_verify_dia0">
        <bpmn:sourceRef>data_dereg_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_go_verify_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_go_prepare_readmission" name="Prepare readmission of measuring point">
      <bpmn:incoming>flow_verify_to_prepare</bpmn:incoming>
      <bpmn:outgoing>flow_prepare_to_gw_cont</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_go_oblige_continuation" name="Oblige MPOO to continue operations">
      <bpmn:incoming>flow_oblige_yes</bpmn:incoming>
      <bpmn:outgoing>flow_oblige_to_msg</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_go_oblige_continuation_doa0">
        <bpmn:targetRef>data_continuation_obligation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_go_equipment_acquisition" name="Perform equipment acquisition / changes">
      <bpmn:incoming>flow_start_go_post_to_equip</bpmn:incoming>
      <bpmn:incoming>flow_oblige_no</bpmn:incoming>
      <bpmn:outgoing>flow_equip_to_assign</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_go_assign_self" name="Assign GO as MPO">
      <bpmn:incoming>flow_equip_to_assign</bpmn:incoming>
      <bpmn:outgoing>flow_assign_to_inform_mpoo</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_go_assign_self_doa0">
        <bpmn:targetRef>data_assignment_record</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_go_inform_mpoo" name="Inform MPOO about end of assignment">
      <bpmn:incoming>flow_assign_to_inform_mpoo</bpmn:incoming>
      <bpmn:outgoing>flow_inform_mpoo_to_inform_others</bpmn:outgoing>
      <bpmn:property id="task_go_inform_mpoo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_go_inform_mpoo_dia0">
        <bpmn:sourceRef>data_assignment_record</bpmn:sourceRef>
        <bpmn:targetRef>task_go_inform_mpoo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_go_inform_mspon_sp" name="Inform MSPO and SP about assignment">
      <bpmn:incoming>flow_inform_mpoo_to_inform_others</bpmn:incoming>
      <bpmn:outgoing>flow_inform_others_to_end</bpmn:outgoing>
      <bpmn:property id="task_go_inform_mspon_sp_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_go_inform_mspon_sp_dia0">
        <bpmn:sourceRef>data_assignment_record</bpmn:sourceRef>
        <bpmn:targetRef>task_go_inform_mspon_sp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_verification_result" name="Verification Result" isMarkerVisible="true">
      <bpmn:incoming>flow_verify_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_verify_to_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_verify_to_prepare</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_continuation_decision" name="Continuation Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_prepare_to_gw_cont</bpmn:incoming>
      <bpmn:outgoing>flow_oblige_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_oblige_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_go_to_verify" sourceRef="start_go_verify" targetRef="task_go_verify" />
    <bpmn:sequenceFlow id="flow_verify_to_gw" sourceRef="task_go_verify" targetRef="gw_verification_result" />
    <bpmn:sequenceFlow id="flow_verify_to_reject" sourceRef="gw_verification_result" targetRef="intermediate_rejection" name="Reject" />
    <bpmn:sequenceFlow id="flow_reject_to_end" sourceRef="intermediate_rejection" targetRef="end_go_rejection" />
    <bpmn:sequenceFlow id="flow_verify_to_prepare" sourceRef="gw_verification_result" targetRef="task_go_prepare_readmission" name="Preliminarily Confirm" />
    <bpmn:sequenceFlow id="flow_prepare_to_gw_cont" sourceRef="task_go_prepare_readmission" targetRef="gw_continuation_decision" />
    <bpmn:sequenceFlow id="flow_oblige_yes" sourceRef="gw_continuation_decision" targetRef="task_go_oblige_continuation" name="Oblige to continue" />
    <bpmn:sequenceFlow id="flow_oblige_to_msg" sourceRef="task_go_oblige_continuation" targetRef="intermediate_continuation_request" />
    <bpmn:sequenceFlow id="flow_start_go_post_to_equip" sourceRef="start_go_post_confirm" targetRef="task_go_equipment_acquisition" />
    <bpmn:sequenceFlow id="flow_equip_to_assign" sourceRef="task_go_equipment_acquisition" targetRef="task_go_assign_self" />
    <bpmn:sequenceFlow id="flow_assign_to_inform_mpoo" sourceRef="task_go_assign_self" targetRef="task_go_inform_mpoo" />
    <bpmn:sequenceFlow id="flow_inform_mpoo_to_inform_others" sourceRef="task_go_inform_mpoo" targetRef="task_go_inform_mspon_sp" />
    <bpmn:sequenceFlow id="flow_inform_others_to_end" sourceRef="task_go_inform_mspon_sp" targetRef="end_go_process" />
    <bpmn:sequenceFlow id="flow_oblige_no" sourceRef="gw_continuation_decision" targetRef="task_go_equipment_acquisition" name="Do not oblige" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpoo_part_di" bpmnElement="pool_mpoo_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_go_part_di" bpmnElement="pool_go_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="1520" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_go_process_di" bpmnElement="end_go_process">
        <dc:Bounds x="1110" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_go_rejection_di" bpmnElement="end_go_rejection">
        <dc:Bounds x="920" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mpoo_confirm_di" bpmnElement="end_mpoo_confirm">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mpoo_process_di" bpmnElement="end_mpoo_process">
        <dc:Bounds x="540" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_continuation_decision_di" bpmnElement="gw_continuation_decision">
        <dc:Bounds x="920" y="685" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_verification_result_di" bpmnElement="gw_verification_result">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_continuation_request_di" bpmnElement="intermediate_continuation_request">
        <dc:Bounds x="1300" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_rejection_di" bpmnElement="intermediate_rejection">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_go_post_confirm_di" bpmnElement="start_go_post_confirm">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_go_verify_di" bpmnElement="start_go_verify">
        <dc:Bounds x="160" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_confirm_di" bpmnElement="start_mpoo_confirm">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_dereg_di" bpmnElement="start_mpoo_dereg">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_assign_self_di" bpmnElement="task_go_assign_self">
        <dc:Bounds x="540" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_equipment_acquisition_di" bpmnElement="task_go_equipment_acquisition">
        <dc:Bounds x="1110" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_inform_mpoo_di" bpmnElement="task_go_inform_mpoo">
        <dc:Bounds x="730" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_inform_mspon_sp_di" bpmnElement="task_go_inform_mspon_sp">
        <dc:Bounds x="920" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_oblige_continuation_di" bpmnElement="task_go_oblige_continuation">
        <dc:Bounds x="1110" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_prepare_readmission_di" bpmnElement="task_go_prepare_readmission">
        <dc:Bounds x="730" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_go_verify_di" bpmnElement="task_go_verify">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_mpoo_confirm_continuation_di" bpmnElement="task_mpoo_confirm_continuation">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_mpoo_deregister_di" bpmnElement="task_mpoo_deregister">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_dereg_request_di" bpmnElement="data_dereg_request">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_continuation_obligation_p1_di" bpmnElement="data_continuation_obligation_p1">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_continuation_confirmation_di" bpmnElement="data_continuation_confirmation">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_dereg_request_p1_di" bpmnElement="data_dereg_request_p1">
        <dc:Bounds x="370" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_continuation_obligation_di" bpmnElement="data_continuation_obligation">
        <dc:Bounds x="1130" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_assignment_record_di" bpmnElement="data_assignment_record">
        <dc:Bounds x="750" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_dereg_di" bpmnElement="flow_start_to_dereg">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_dereg_to_end_mpoo_di" bpmnElement="flow_dereg_to_end_mpoo">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_go_to_verify_di" bpmnElement="flow_start_go_to_verify">
        <di:waypoint x="178" y="703" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_verify_to_gw_di" bpmnElement="flow_verify_to_gw">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_verify_to_reject_di" bpmnElement="flow_verify_to_reject">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reject_to_end_di" bpmnElement="flow_reject_to_end">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="938" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_verify_to_prepare_di" bpmnElement="flow_verify_to_prepare">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="780" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_prepare_to_gw_cont_di" bpmnElement="flow_prepare_to_gw_cont">
        <di:waypoint x="780" y="850" />
        <di:waypoint x="945" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_oblige_yes_di" bpmnElement="flow_oblige_yes">
        <di:waypoint x="945" y="710" />
        <di:waypoint x="1160" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_oblige_to_msg_di" bpmnElement="flow_oblige_to_msg">
        <di:waypoint x="1160" y="850" />
        <di:waypoint x="1318" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_mpoo_conf_to_task_di" bpmnElement="flow_start_mpoo_conf_to_task">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mpoo_conf_to_end_di" bpmnElement="flow_mpoo_conf_to_end">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_go_post_to_equip_di" bpmnElement="flow_start_go_post_to_equip">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="1160" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_equip_to_assign_di" bpmnElement="flow_equip_to_assign">
        <di:waypoint x="1160" y="725" />
        <di:waypoint x="590" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assign_to_inform_mpoo_di" bpmnElement="flow_assign_to_inform_mpoo">
        <di:waypoint x="590" y="725" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
