<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:messageFlow id="msg_dereg_request" sourceRef="end_mpoo_pool_1" targetRef="start_go_verify" name="Deregistration Request" />
    <bpmn:messageFlow id="msg_obligation" sourceRef="end_go_obligation" targetRef="start_mpoo_confirm" name="Obligation to Continue Operations" />
    <bpmn:messageFlow id="msg_confirmation" sourceRef="end_mpoo_pool_2" targetRef="start_go_receive_confirm" name="Confirmation of Continuation" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_dereg_request" name="Deregistration Request Document" dataObjectRef="data_dereg_request_do" />
    <bpmn:dataObject id="data_dereg_request_do" />
    <bpmn:dataObjectReference id="data_obligation_p1" name="Obligation Notice" dataObjectRef="data_obligation_p1_do" />
    <bpmn:dataObject id="data_obligation_p1_do" />
    <bpmn:dataObjectReference id="data_confirmation" name="Continuation Confirmation" dataObjectRef="data_confirmation_do" />
    <bpmn:dataObject id="data_confirmation_do" />
    <bpmn:startEvent id="start_mpoo_dereg" name="MPOO initiates deregistration">
      <bpmn:outgoing>flow_start_to_dereg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpoo_pool_1" name="Deregistration request sent">
      <bpmn:incoming>flow_dereg_to_end_msg</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_mpoo_pool_1_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_mpoo_confirm" name="Receive Obligation">
      <bpmn:outgoing>flow_start_confirm_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_mpoo_confirm_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_mpoo_pool_2" name="Confirmation of continuation sent">
      <bpmn:incoming>flow_confirm_to_end_msg</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_mpoo_pool_2_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_deregister" name="Deregister at the GO">
      <bpmn:incoming>flow_start_to_dereg</bpmn:incoming>
      <bpmn:outgoing>flow_dereg_to_end_msg</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_deregister_doa0">
        <bpmn:targetRef>data_dereg_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_confirm_continuation" name="Confirm the continuation">
      <bpmn:incoming>flow_start_confirm_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_to_end_msg</bpmn:outgoing>
      <bpmn:property id="task_confirm_continuation_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_confirm_continuation_dia0">
        <bpmn:sourceRef>data_obligation_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_confirm_continuation_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_confirm_continuation_doa0">
        <bpmn:targetRef>data_confirmation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_start_to_dereg" sourceRef="start_mpoo_dereg" targetRef="task_deregister" />
    <bpmn:sequenceFlow id="flow_dereg_to_end_msg" sourceRef="task_deregister" targetRef="end_mpoo_pool_1" />
    <bpmn:sequenceFlow id="flow_start_confirm_to_task" sourceRef="start_mpoo_confirm" targetRef="task_confirm_continuation" />
    <bpmn:sequenceFlow id="flow_confirm_to_end_msg" sourceRef="task_confirm_continuation" targetRef="end_mpoo_pool_2" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_dereg_request_p1" name="Deregistration Request Document" dataObjectRef="data_dereg_request_p1_do" />
    <bpmn:dataObject id="data_dereg_request_p1_do" />
    <bpmn:dataObjectReference id="data_obligation" name="Obligation Notice" dataObjectRef="data_obligation_do" />
    <bpmn:dataObject id="data_obligation_do" />
    <bpmn:dataObjectReference id="data_assignment_record" name="Assignment Record" dataObjectRef="data_assignment_record_do" />
    <bpmn:dataObject id="data_assignment_record_do" />
    <bpmn:startEvent id="start_go_verify" name="Receive Deregistration Request">
      <bpmn:outgoing>flow_start_verify_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_go_verify_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="intermediate_rejection" name="Deregistration Rejected">
      <bpmn:incoming>flow_reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="intermediate_confirmed" name="Deregistration Preliminarily Confirmed">
      <bpmn:incoming>flow_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_confirmed_to_prepare</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_go_obligation" name="Obligation to continue operations sent">
      <bpmn:incoming>flow_oblige_to_end_msg</bpmn:incoming>
      <bpmn:messageEventDefinition id="end_go_obligation_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="start_go_receive_confirm" name="Receive Confirmation">
      <bpmn:outgoing>flow_start_recv_confirm_to_gw_merge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_go_receive_confirm_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="end_process" name="Process Completed">
      <bpmn:incoming>flow_inform_sp_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_verify" name="Verify the deregistration">
      <bpmn:incoming>flow_start_verify_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_verify_to_gw</bpmn:outgoing>
      <bpmn:property id="task_verify_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_verify_dia0">
        <bpmn:sourceRef>data_dereg_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_verify_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_prepare_readmission" name="Prepare the readmission of the measuring point">
      <bpmn:incoming>flow_confirmed_to_prepare</bpmn:incoming>
      <bpmn:outgoing>flow_prepare_to_gw_obl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_oblige_continue" name="Oblige MPOO to continue operations">
      <bpmn:incoming>flow_oblige_yes</bpmn:incoming>
      <bpmn:outgoing>flow_oblige_to_end_msg</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_oblige_continue_doa0">
        <bpmn:targetRef>data_obligation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_equipment_acquisition" name="Perform equipment acquisition and/or equipment changes">
      <bpmn:incoming>flow_merge_to_equip</bpmn:incoming>
      <bpmn:outgoing>flow_equip_to_assign</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_assign_go_as_mpo" name="Assign the GO as MPO">
      <bpmn:incoming>flow_equip_to_assign</bpmn:incoming>
      <bpmn:outgoing>flow_assign_to_inform_mpoo</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_assign_go_as_mpo_doa0">
        <bpmn:targetRef>data_assignment_record</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_mpoo_end" name="Inform MPOO about end of assignment and beginning of GO assignment">
      <bpmn:incoming>flow_assign_to_inform_mpoo</bpmn:incoming>
      <bpmn:outgoing>flow_inform_mpoo_to_inform_mspo</bpmn:outgoing>
      <bpmn:property id="task_inform_mpoo_end_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mpoo_end_dia0">
        <bpmn:sourceRef>data_assignment_record</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mpoo_end_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_mspo" name="Inform MSPO about assignment of GO">
      <bpmn:incoming>flow_inform_mpoo_to_inform_mspo</bpmn:incoming>
      <bpmn:outgoing>flow_inform_mspto_inform_sp</bpmn:outgoing>
      <bpmn:property id="task_inform_mspo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mspo_dia0">
        <bpmn:sourceRef>data_assignment_record</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mspo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_sp" name="Inform SP about assignment of GO">
      <bpmn:incoming>flow_inform_mspto_inform_sp</bpmn:incoming>
      <bpmn:outgoing>flow_inform_sp_to_end</bpmn:outgoing>
      <bpmn:property id="task_inform_sp_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_sp_dia0">
        <bpmn:sourceRef>data_assignment_record</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_sp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decision_verify" name="Verification Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_verify_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_decision_obligation" name="Obligation Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_prepare_to_gw_obl</bpmn:incoming>
      <bpmn:outgoing>flow_oblige_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_oblige_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_merge_obligation" name="Merge Obligation Path">
      <bpmn:incoming>flow_oblige_no</bpmn:incoming>
      <bpmn:incoming>flow_start_recv_confirm_to_gw_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_equip</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_start_verify_to_task" sourceRef="start_go_verify" targetRef="task_verify" />
    <bpmn:sequenceFlow id="flow_verify_to_gw" sourceRef="task_verify" targetRef="gw_decision_verify" />
    <bpmn:sequenceFlow id="flow_reject" sourceRef="gw_decision_verify" targetRef="intermediate_rejection" name="Reject" />
    <bpmn:sequenceFlow id="flow_confirm" sourceRef="gw_decision_verify" targetRef="intermediate_confirmed" name="Confirm" />
    <bpmn:sequenceFlow id="flow_confirmed_to_prepare" sourceRef="intermediate_confirmed" targetRef="task_prepare_readmission" />
    <bpmn:sequenceFlow id="flow_prepare_to_gw_obl" sourceRef="task_prepare_readmission" targetRef="gw_decision_obligation" />
    <bpmn:sequenceFlow id="flow_oblige_yes" sourceRef="gw_decision_obligation" targetRef="task_oblige_continue" name="Yes" />
    <bpmn:sequenceFlow id="flow_oblige_no" sourceRef="gw_decision_obligation" targetRef="gw_merge_obligation" name="No" />
    <bpmn:sequenceFlow id="flow_oblige_to_end_msg" sourceRef="task_oblige_continue" targetRef="end_go_obligation" />
    <bpmn:sequenceFlow id="flow_start_recv_confirm_to_gw_merge" sourceRef="start_go_receive_confirm" targetRef="gw_merge_obligation" />
    <bpmn:sequenceFlow id="flow_merge_to_equip" sourceRef="gw_merge_obligation" targetRef="task_equipment_acquisition" />
    <bpmn:sequenceFlow id="flow_equip_to_assign" sourceRef="task_equipment_acquisition" targetRef="task_assign_go_as_mpo" />
    <bpmn:sequenceFlow id="flow_assign_to_inform_mpoo" sourceRef="task_assign_go_as_mpo" targetRef="task_inform_mpoo_end" />
    <bpmn:sequenceFlow id="flow_inform_mpoo_to_inform_mspo" sourceRef="task_inform_mpoo_end" targetRef="task_inform_mspo" />
    <bpmn:sequenceFlow id="flow_inform_mspto_inform_sp" sourceRef="task_inform_mspo" targetRef="task_inform_sp" />
    <bpmn:sequenceFlow id="flow_inform_sp_to_end" sourceRef="task_inform_sp" targetRef="end_process" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpoo_part_di" bpmnElement="pool_mpoo_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_go_part_di" bpmnElement="pool_go_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="1710" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_go_obligation_di" bpmnElement="end_go_obligation">
        <dc:Bounds x="1490" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mpoo_pool_1_di" bpmnElement="end_mpoo_pool_1">
        <dc:Bounds x="540" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mpoo_pool_2_di" bpmnElement="end_mpoo_pool_2">
        <dc:Bounds x="540" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_process_di" bpmnElement="end_process">
        <dc:Bounds x="1490" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_obligation_di" bpmnElement="gw_decision_obligation">
        <dc:Bounds x="1110" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_verify_di" bpmnElement="gw_decision_verify">
        <dc:Bounds x="540" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_obligation_di" bpmnElement="gw_merge_obligation">
        <dc:Bounds x="1300" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_confirmed_di" bpmnElement="intermediate_confirmed">
        <dc:Bounds x="730" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_rejection_di" bpmnElement="intermediate_rejection">
        <dc:Bounds x="730" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_go_receive_confirm_di" bpmnElement="start_go_receive_confirm">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_go_verify_di" bpmnElement="start_go_verify">
        <dc:Bounds x="160" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_confirm_di" bpmnElement="start_mpoo_confirm">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_mpoo_dereg_di" bpmnElement="start_mpoo_dereg">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assign_go_as_mpo_di" bpmnElement="task_assign_go_as_mpo">
        <dc:Bounds x="730" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_confirm_continuation_di" bpmnElement="task_confirm_continuation">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_deregister_di" bpmnElement="task_deregister">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_equipment_acquisition_di" bpmnElement="task_equipment_acquisition">
        <dc:Bounds x="540" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_mpoo_end_di" bpmnElement="task_inform_mpoo_end">
        <dc:Bounds x="920" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_mspo_di" bpmnElement="task_inform_mspo">
        <dc:Bounds x="1110" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_sp_di" bpmnElement="task_inform_sp">
        <dc:Bounds x="1300" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_oblige_continue_di" bpmnElement="task_oblige_continue">
        <dc:Bounds x="1300" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prepare_readmission_di" bpmnElement="task_prepare_readmission">
        <dc:Bounds x="920" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_verify_di" bpmnElement="task_verify">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_dereg_request_di" bpmnElement="data_dereg_request">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_obligation_p1_di" bpmnElement="data_obligation_p1">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_confirmation_di" bpmnElement="data_confirmation">
        <dc:Bounds x="370" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_dereg_request_p1_di" bpmnElement="data_dereg_request_p1">
        <dc:Bounds x="370" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_obligation_di" bpmnElement="data_obligation">
        <dc:Bounds x="1320" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_assignment_record_di" bpmnElement="data_assignment_record">
        <dc:Bounds x="1035" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_dereg_di" bpmnElement="flow_start_to_dereg">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_dereg_to_end_msg_di" bpmnElement="flow_dereg_to_end_msg">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="558" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_verify_to_task_di" bpmnElement="flow_start_verify_to_task">
        <di:waypoint x="178" y="703" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_verify_to_gw_di" bpmnElement="flow_verify_to_gw">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="565" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reject_di" bpmnElement="flow_reject">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirm_di" bpmnElement="flow_confirm">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="748" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirmed_to_prepare_di" bpmnElement="flow_confirmed_to_prepare">
        <di:waypoint x="748" y="578" />
        <di:waypoint x="970" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_prepare_to_gw_obl_di" bpmnElement="flow_prepare_to_gw_obl">
        <di:waypoint x="970" y="725" />
        <di:waypoint x="1135" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_oblige_yes_di" bpmnElement="flow_oblige_yes">
        <di:waypoint x="1135" y="585" />
        <di:waypoint x="1350" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_oblige_no_di" bpmnElement="flow_oblige_no">
        <di:waypoint x="1135" y="585" />
        <di:waypoint x="1325" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_oblige_to_end_msg_di" bpmnElement="flow_oblige_to_end_msg">
        <di:waypoint x="1350" y="850" />
        <di:waypoint x="1508" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_confirm_to_task_di" bpmnElement="flow_start_confirm_to_task">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirm_to_end_msg_di" bpmnElement="flow_confirm_to_end_msg">
        <di:waypoint x="400" y="140" />
