<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_manager_part" name="Manager" processRef="pool_manager_proc" />
    <bpmn:participant id="pool_sales_assistant_part" name="Sales Assistant" processRef="pool_sales_assistant_proc" />
    <bpmn:messageFlow id="msg_flow_1" sourceRef="evt_msg_send_note" targetRef="evt_msg_receive_note" name="Interest Note" />
  </bpmn:collaboration>
  <bpmn:process id="pool_manager_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_manager" name="Process Start">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_manager" name="Process End">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_msg_receive_note" name="Receive Interest Note">
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_receive_note_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_check_leads" name="Check open leads">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_select_top_five" name="Select top five leads">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_process_lead" name="Process the lead">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_manager" targetRef="task_check_leads" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_check_leads" targetRef="task_select_top_five" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_select_top_five" targetRef="evt_end_manager" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="evt_msg_receive_note" targetRef="task_process_lead" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_process_lead" targetRef="evt_end_manager" />
  </bpmn:process>
  <bpmn:process id="pool_sales_assistant_proc" isExecutable="false">
    <bpmn:endEvent id="evt_msg_send_note" name="Send Note to Manager">
      <bpmn:incoming>flow_interested_yes</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_send_note_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_call_customer" name="Call customer">
      <bpmn:incoming>flow_interested_no</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_interest_decision" name="Is customer interested?" isMarkerVisible="true">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_interested_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_interested_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_call_customer" targetRef="gw_interest_decision" />
    <bpmn:sequenceFlow id="flow_interested_yes" sourceRef="gw_interest_decision" targetRef="evt_msg_send_note" name="Interested" />
    <bpmn:sequenceFlow id="flow_interested_no" sourceRef="gw_interest_decision" targetRef="task_call_customer" name="Not Interested" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_manager_part_di" bpmnElement="pool_manager_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="950" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_sales_assistant_part_di" bpmnElement="pool_sales_assistant_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="700" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_manager_di" bpmnElement="evt_end_manager">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_receive_note_di" bpmnElement="evt_msg_receive_note">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_send_note_di" bpmnElement="evt_msg_send_note">
        <dc:Bounds x="160" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_manager_di" bpmnElement="evt_start_manager">
        <dc:Bounds x="160" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_interest_decision_di" bpmnElement="gw_interest_decision">
        <dc:Bounds x="160" y="685" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_call_customer_di" bpmnElement="task_call_customer">
        <dc:Bounds x="160" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_leads_di" bpmnElement="task_check_leads">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_lead_di" bpmnElement="task_process_lead">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_select_top_five_di" bpmnElement="task_select_top_five">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="243" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="210" y="850" />
        <di:waypoint x="185" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_yes_di" bpmnElement="flow_interested_yes">
        <di:waypoint x="185" y="710" />
        <di:waypoint x="178" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_no_di" bpmnElement="flow_interested_no">
        <di:waypoint x="185" y="710" />
        <di:waypoint x="210" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_1_di" bpmnElement="msg_flow_1">
        <di:waypoint x="178" y="578" />
        <di:waypoint x="178" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>