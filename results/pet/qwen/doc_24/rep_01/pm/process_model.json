{
  "name": "Power Supplier Switch-Over Process",
  "resources": [
    {
      "name": "Customer Service Agent",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "CIS System",
      "capacity": 1,
      "resource_type": "system"
    },
    {
      "name": "Grid Operator",
      "capacity": 1,
      "resource_type": "external_party"
    },
    {
      "name": "Old Supplier",
      "capacity": 1,
      "resource_type": "external_party"
    },
    {
      "name": "Customer",
      "capacity": 1,
      "resource_type": "external_party"
    }
  ],
  "events": [
    {
      "id": "evt_start_cs",
      "name": "Switch-over Request Received",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Switch-over Request Data"
    },
    {
      "id": "evt_end_cs_withdrawal",
      "name": "Process Ends (Withdrawal)",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_msg_to_grid",
      "name": "Request Sent to Grid Operator",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Supplier Concurrence Check Request"
    },
    {
      "id": "evt_start_grid",
      "name": "Receive Request from Customer Service",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Supplier Concurrence Check Request"
    },
    {
      "id": "evt_msg_to_cs_response",
      "name": "Response Sent to Customer Service",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Concurrence Check Response"
    },
    {
      "id": "evt_start_cs_response",
      "name": "Receive Response from Grid Operator",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Concurrence Check Response"
    },
    {
      "id": "evt_msg_to_customer_contract",
      "name": "Contract Sent to Customer",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "CIS Contract Document"
    },
    {
      "id": "evt_start_customer_check",
      "name": "Receive Contract for Review",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "CIS Contract Document"
    },
    {
      "id": "evt_msg_to_cs_decision",
      "name": "Decision Sent to Customer Service",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Contract Acceptance/Withdrawal"
    },
    {
      "id": "evt_start_cs_decision",
      "name": "Receive Customer Decision",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Contract Acceptance/Withdrawal"
    },
    {
      "id": "evt_timer_acceptance",
      "name": "7 Days Elapsed (Implicit Acceptance)",
      "event_position": "intermediate",
      "trigger_type": "timer",
      "message_name": null
    },
    {
      "id": "evt_msg_meter_data_cs",
      "name": "Meter Data Sent to CS",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Services Consumption Report"
    },
    {
      "id": "evt_start_cs_meter",
      "name": "Receive Meter Data",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Services Consumption Report"
    },
    {
      "id": "evt_msg_meter_data_old",
      "name": "Meter Data Sent to Old Supplier",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Services Consumption Report"
    },
    {
      "id": "evt_start_old_meter",
      "name": "Receive Meter Data",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Services Consumption Report"
    },
    {
      "id": "evt_msg_billing_old",
      "name": "Final Billing Sent to Old Supplier",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Final Billing Calculation"
    },
    {
      "id": "evt_start_old_billing",
      "name": "Receive Final Billing",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Final Billing Calculation"
    },
    {
      "id": "evt_msg_billing_customer",
      "name": "Final Billing Sent to Customer",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Final Invoice"
    },
    {
      "id": "evt_start_customer_billing",
      "name": "Receive Final Invoice",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Final Invoice"
    },
    {
      "id": "evt_end_grid",
      "name": "Grid Operator Process End",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_end_old_supplier",
      "name": "Old Supplier Process End",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_end_customer",
      "name": "Customer Process End",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_end_cs_success",
      "name": "New Customer Winning Process End",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    }
  ],
