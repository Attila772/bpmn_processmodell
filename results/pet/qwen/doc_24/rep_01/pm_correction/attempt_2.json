      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Sales Agreement Termination"
    },
    {
      "id": "evt_start_old_supplier_term",
      "name": "Receive Termination Notice",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Sales Agreement Termination"
    },
    {
      "id": "evt_msg_to_customer_contract",
      "name": "Contract Documents Sent",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Contract Documents for Review"
    },
    {
      "id": "evt_start_customer_review",
      "name": "Receive Contract Documents",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Contract Documents for Review"
    },
    {
      "id": "evt_msg_to_cs_decision",
