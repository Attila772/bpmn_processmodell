    {
      "name": "Customer Service Agent",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "CIS System",
      "capacity": 1,
      "resource_type": "system"
    },
    {
      "name": "Grid Operator",
      "capacity": 1,
      "resource_type": "external_party"
    },
    {
      "name": "Old Supplier",
      "capacity": 1,
      "resource_type": "external_party"
    },
    {
      "name": "Customer",
      "capacity": 1,
      "resource_type": "external_party"
    }
