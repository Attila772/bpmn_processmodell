      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_msg_to_grid",
      "name": "Request Sent to Grid Operator",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Supplier Concurrence Check Request"
    },
    {
      "id": "evt_start_grid",
      "name": "Receive Request from CIS",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Supplier Concurrence Check Request"
    },
    {
      "id": "evt_msg_to_cs_response",
