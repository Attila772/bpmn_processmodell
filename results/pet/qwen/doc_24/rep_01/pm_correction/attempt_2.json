  "gateways": [
    {
      "id": "gw_data_errors",
      "name": "Data Errors?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_errors_yes",
          "condition": "Errors found"
        },
        {
          "flow_id": "flow_errors_no",
          "condition": "No errors"
        }
      ]
    },
    {
      "id": "gw_customer_exists",
      "name": "Customer Exists in DB?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_exists_yes",
          "condition": "Exists"
        },
        {
          "flow_id": "flow_exists_no",
          "condition": "Does not exist"
        }
      ]
    },
    {
      "id": "gw_contract_gen_success",
      "name": "Contract Generation Successful?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_gen_fail",
          "condition": "Negative response / Incorrectly generated"
        },
        {
          "flow_id": "flow_gen_success",
          "condition": "Positive response"
        }
      ]
    },
    {
      "id": "gw_concurrence",
      "name": "Supplier Concurrence?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_concurrence_yes",
          "condition": "Concurrence exists"
        },
        {
          "flow_id": "flow_concurrence_no",
          "condition": "No objections"
        }
      ]
    },
    {
      "id": "gw_customer_decision",
      "name": "Customer Decision",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_withdraw",
          "condition": "Withdraw"
        },
        {
          "flow_id": "flow_confirm",
          "condition": "Confirm"
        }
      ]
    },
    {
      "id": "gw_timer_merge",
      "name": "Acceptance Merge",
      "gateway_type": "inclusive",
      "branch_probabilities": null,
      "branch_conditions": null
    }
  ],
