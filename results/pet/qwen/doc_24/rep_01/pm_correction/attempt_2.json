      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Contract Acceptance/Rejection"
    },
    {
      "id": "evt_start_cs_decision",
      "name": "Receive Customer Decision",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Contract Acceptance/Rejection"
    },
    {
      "id": "evt_timer_acceptance",
      "name": "7 Days Elapsed (Implicit Acceptance)",
      "event_position": "intermediate",
      "trigger_type": "timer",
      "message_name": null
    },
    {
      "id": "evt_msg_meter_data_cs",
      "name": "Meter Data Sent to CS",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Services Consumption Report"
    },
    {
      "id": "evt_start_cs_meter",
      "name": "Receive Meter Data",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Services Consumption Report"
    },
    {
      "id": "evt_msg_meter_data_old",
      "name": "Meter Data Sent to Old Supplier",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Services Consumption Report"
    },
    {
      "id": "evt_start_old_supplier_meter",
      "name": "Receive Meter Data",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Services Consumption Report"
    },
    {
      "id": "evt_msg_billing_old",
      "name": "Final Billing Sent to Old Supplier",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Final Billing Calculation"
    },
    {
      "id": "evt_start_old_supplier_billing",
      "name": "Receive Final Billing",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Final Billing Calculation"
    },
    {
      "id": "evt_msg_final_bill_customer",
      "name": "Final Bill Sent to Customer",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Final Invoice"
    },
    {
      "id": "evt_start_customer_bill",
      "name": "Receive Final Bill",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Final Invoice"
    },
    {
      "id": "evt_end_grid",
      "name": "Grid Operator Process End",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_end_old_supplier",
      "name": "Old Supplier Process End",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_end_customer",
      "name": "Customer Process End",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_end_cs_main",
      "name": "New Customer Winning Process End",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    }
