<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_cs_part" name="Customer Service" processRef="pool_cs_proc" />
    <bpmn:participant id="pool_grid_part" name="Grid Operator" processRef="pool_grid_proc" />
    <bpmn:participant id="pool_old_supplier_part" name="Old Supplier" processRef="pool_old_supplier_proc" />
    <bpmn:participant id="pool_customer_part" name="Customer" processRef="pool_customer_proc" />
    <bpmn:messageFlow id="msg_flow_request_grid" sourceRef="evt_msg_to_grid" targetRef="evt_start_grid" name="Supplier Concurrence Check Request" />
    <bpmn:messageFlow id="msg_flow_response_cs" sourceRef="evt_msg_to_cs_response" targetRef="evt_start_cs_response" name="Concurrence Check Result" />
    <bpmn:messageFlow id="msg_flow_termination" sourceRef="evt_msg_to_old_supplier_termination" targetRef="evt_start_old_supplier_term" name="Sales Agreement Termination" />
    <bpmn:messageFlow id="msg_flow_contract_customer" sourceRef="evt_msg_to_customer_contract" targetRef="evt_start_customer_review" name="Contract Documents for Review" />
    <bpmn:messageFlow id="msg_flow_decision_cs" sourceRef="evt_msg_to_cs_decision" targetRef="evt_start_cs_decision" name="Contract Acceptance/Rejection" />
    <bpmn:messageFlow id="msg_flow_meter_cs" sourceRef="evt_msg_meter_data_cs" targetRef="evt_start_cs_meter" name="Services Consumption Report" />
    <bpmn:messageFlow id="msg_flow_meter_old" sourceRef="evt_msg_meter_data_old" targetRef="evt_start_old_supplier_meter" name="Services Consumption Report" />
    <bpmn:messageFlow id="msg_flow_billing_old" sourceRef="evt_msg_billing_old" targetRef="evt_start_old_supplier_billing" name="Final Billing Calculation" />
    <bpmn:messageFlow id="msg_flow_final_bill_customer" sourceRef="evt_msg_final_bill_customer" targetRef="evt_start_customer_bill" name="Final Invoice" />
    <bpmn:messageFlow id="msg_flow_send_contract" sourceRef="task_send_contract_customer" targetRef="evt_msg_to_customer_contract" name="Contract Documents" />
    <bpmn:messageFlow id="msg_flow_review_decision" sourceRef="task_customer_review" targetRef="evt_msg_to_cs_decision" name="Decision" />
    <bpmn:messageFlow id="msg_flow_old_bill" sourceRef="task_old_supplier_create_bill" targetRef="evt_msg_final_bill_customer" name="Final Bill" />
  </bpmn:collaboration>
  <bpmn:process id="pool_cs_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_customer_raw" name="Customer Raw Data" dataObjectRef="data_customer_raw_do" />
    <bpmn:dataObject id="data_customer_raw_do" />
    <bpmn:dataObjectReference id="data_customer_object" name="Customer Object" dataObjectRef="data_customer_object_do" />
    <bpmn:dataObject id="data_customer_object_do" />
    <bpmn:dataObjectReference id="data_error_list" name="Error List" dataObjectRef="data_error_list_do" />
    <bpmn:dataObject id="data_error_list_do" />
    <bpmn:dataObjectReference id="doc_contract_draft" name="Contract Draft" dataObjectRef="doc_contract_draft_do" />
    <bpmn:dataObject id="doc_contract_draft_do" />
    <bpmn:dataObjectReference id="doc_final_contract" name="Final Contract Documents" dataObjectRef="doc_final_contract_do" />
    <bpmn:dataObject id="doc_final_contract_do" />
    <bpmn:dataObjectReference id="data_meter_report" name="Services Consumption Report" dataObjectRef="data_meter_report_do" />
    <bpmn:dataObject id="data_meter_report_do" />
    <bpmn:startEvent id="evt_start_cs" name="Switch-over Request Received">
      <bpmn:outgoing>flow_start_to_enter</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_cs_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_cs_contract_rejected" name="Process Ends (Withdrawal)">
      <bpmn:incoming>flow_withdraw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_grid" name="Request Sent to Grid Operator">
      <bpmn:incoming>flow_request_grid_to_evt_msg</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_grid_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_start_cs_response" name="Receive Response from Grid Operator">
      <bpmn:outgoing>flow_resp_start_to_create_cis</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_cs_response_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_cs_decision" name="Decision Sent to Customer Service">
      <bpmn:messageEventDefinition id="evt_msg_to_cs_decision_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_start_cs_decision" name="Receive Customer Decision">
      <bpmn:outgoing>flow_dec_start_to_gw_dec</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_cs_decision_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_timer_acceptance" name="7 Days Elapsed (Implicit Acceptance)">
      <bpmn:outgoing>flow_timer_to_merge</bpmn:outgoing>
      <bpmn:timerEventDefinition id="evt_timer_acceptance_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_start_cs_meter" name="Receive Meter Data">
      <bpmn:messageEventDefinition id="evt_start_cs_meter_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_cs_main" name="New Customer Winning Process End">
      <bpmn:incoming>flow_import_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_enter_crm" name="Enter Customer Data into CRM">
      <bpmn:incoming>flow_start_to_enter</bpmn:incoming>
      <bpmn:outgoing>flow_enter_to_check</bpmn:outgoing>
      <bpmn:property id="task_enter_crm_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_enter_crm_dia0">
        <bpmn:sourceRef>data_customer_raw</bpmn:sourceRef>
        <bpmn:targetRef>task_enter_crm_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_enter_crm_doa0">
        <bpmn:targetRef>data_customer_object</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_data" name="Check Completeness and Plausibility">
      <bpmn:incoming>flow_enter_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gw_errors</bpmn:outgoing>
      <bpmn:property id="task_check_data_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_data_dia0">
        <bpmn:sourceRef>data_customer_object</bpmn:sourceRef>
        <bpmn:targetRef>task_check_data_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_correct_errors" name="Correct Errors based on Error List">
      <bpmn:incoming>flow_errors_yes</bpmn:incoming>
      <bpmn:outgoing>flow_correct_to_exists</bpmn:outgoing>
      <bpmn:property id="task_correct_errors_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_correct_errors_dia0">
        <bpmn:sourceRef>data_error_list</bpmn:sourceRef>
        <bpmn:targetRef>task_correct_errors_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_correct_errors_doa0">
        <bpmn:targetRef>data_customer_object</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_create_new_customer" name="Create New Customer Object">
      <bpmn:incoming>flow_exists_no</bpmn:incoming>
      <bpmn:outgoing>flow_create_to_prepare</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_new_customer_doa0">
        <bpmn:targetRef>data_customer_object</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_prepare_contract" name="Prepare Contract Documents">
      <bpmn:incoming>flow_exists_yes</bpmn:incoming>
      <bpmn:incoming>flow_create_to_prepare</bpmn:incoming>
      <bpmn:incoming>flow_analyze_to_prepare</bpmn:incoming>
      <bpmn:outgoing>flow_prepare_to_auto_check</bpmn:outgoing>
      <bpmn:property id="task_prepare_contract_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prepare_contract_dia0">
        <bpmn:sourceRef>data_customer_object</bpmn:sourceRef>
        <bpmn:targetRef>task_prepare_contract_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_prepare_contract_doa0">
        <bpmn:targetRef>doc_contract_draft</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_auto_check_cis" name="Automated Check of Contract Documents in CIS">
      <bpmn:incoming>flow_prepare_to_auto_check</bpmn:incoming>
      <bpmn:outgoing>flow_auto_check_to_gw_gen</bpmn:outgoing>
      <bpmn:property id="task_auto_check_cis_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_auto_check_cis_dia0">
        <bpmn:sourceRef>doc_contract_draft</bpmn:sourceRef>
        <bpmn:targetRef>task_auto_check_cis_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_analyze_issues" name="Analyze and Resolve Issues">
      <bpmn:incoming>flow_gen_fail</bpmn:incoming>
      <bpmn:outgoing>flow_analyze_to_prepare</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_send_confirmation" name="Send Confirmation Document to Customer">
      <bpmn:incoming>flow_gen_success</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_to_request_grid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_request_grid" name="Send Request to Grid Operator via CIS">
      <bpmn:incoming>flow_confirm_to_request_grid</bpmn:incoming>
      <bpmn:outgoing>flow_request_grid_to_evt_msg</bpmn:outgoing>
      <bpmn:property id="task_request_grid_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_request_grid_dia0">
        <bpmn:sourceRef>data_customer_object</bpmn:sourceRef>
        <bpmn:targetRef>task_request_grid_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_create_cis_contract" name="Create CIS Contract">
      <bpmn:incoming>flow_resp_start_to_create_cis</bpmn:incoming>
      <bpmn:outgoing>flow_create_cis_to_send_contract</bpmn:outgoing>
      <bpmn:property id="task_create_cis_contract_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_cis_contract_dia0">
        <bpmn:sourceRef>data_customer_object</bpmn:sourceRef>
        <bpmn:targetRef>task_create_cis_contract_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_cis_contract_doa0">
        <bpmn:targetRef>doc_final_contract</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_send_contract_customer" name="Send Contract Documents to Customer">
      <bpmn:incoming>flow_create_cis_to_send_contract</bpmn:incoming>
      <bpmn:property id="task_send_contract_customer_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_contract_customer_dia0">
        <bpmn:sourceRef>doc_final_contract</bpmn:sourceRef>
        <bpmn:targetRef>task_send_contract_customer_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_import_meter_data" name="Import Meter Data to Systems">
      <bpmn:incoming>flow_merge_to_import</bpmn:incoming>
      <bpmn:outgoing>flow_import_to_end</bpmn:outgoing>
      <bpmn:property id="task_import_meter_data_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_import_meter_data_dia0">
        <bpmn:sourceRef>data_meter_report</bpmn:sourceRef>
        <bpmn:targetRef>task_import_meter_data_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_data_errors" name="Data Errors?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_to_gw_errors</bpmn:incoming>
      <bpmn:outgoing>flow_errors_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_errors_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_customer_exists" name="Customer Exists in DB?" isMarkerVisible="true">
      <bpmn:incoming>flow_errors_no</bpmn:incoming>
      <bpmn:incoming>flow_correct_to_exists</bpmn:incoming>
      <bpmn:outgoing>flow_exists_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_exists_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_contract_gen_success" name="Contract Generation Successful?" isMarkerVisible="true">
      <bpmn:incoming>flow_auto_check_to_gw_gen</bpmn:incoming>
      <bpmn:outgoing>flow_gen_fail</bpmn:outgoing>
      <bpmn:outgoing>flow_gen_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_customer_decision" name="Customer Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_dec_start_to_gw_dec</bpmn:incoming>
      <bpmn:outgoing>flow_withdraw</bpmn:outgoing>
      <bpmn:outgoing>flow_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="gw_timer_merge" name="Acceptance Merge">
      <bpmn:incoming>flow_confirm</bpmn:incoming>
      <bpmn:incoming>flow_timer_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_import</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_enter" sourceRef="evt_start_cs" targetRef="task_enter_crm" />
    <bpmn:sequenceFlow id="flow_enter_to_check" sourceRef="task_enter_crm" targetRef="task_check_data" />
    <bpmn:sequenceFlow id="flow_check_to_gw_errors" sourceRef="task_check_data" targetRef="gw_data_errors" />
    <bpmn:sequenceFlow id="flow_errors_yes" sourceRef="gw_data_errors" targetRef="task_correct_errors" name="Errors found" />
    <bpmn:sequenceFlow id="flow_errors_no" sourceRef="gw_data_errors" targetRef="gw_customer_exists" name="No errors" />
    <bpmn:sequenceFlow id="flow_correct_to_exists" sourceRef="task_correct_errors" targetRef="gw_customer_exists" />
    <bpmn:sequenceFlow id="flow_exists_yes" sourceRef="gw_customer_exists" targetRef="task_prepare_contract" name="Exists" />
    <bpmn:sequenceFlow id="flow_exists_no" sourceRef="gw_customer_exists" targetRef="task_create_new_customer" name="Does not exist" />
    <bpmn:sequenceFlow id="flow_create_to_prepare" sourceRef="task_create_new_customer" targetRef="task_prepare_contract" />
    <bpmn:sequenceFlow id="flow_prepare_to_auto_check" sourceRef="task_prepare_contract" targetRef="task_auto_check_cis" />
    <bpmn:sequenceFlow id="flow_auto_check_to_gw_gen" sourceRef="task_auto_check_cis" targetRef="gw_contract_gen_success" />
    <bpmn:sequenceFlow id="flow_gen_fail" sourceRef="gw_contract_gen_success" targetRef="task_analyze_issues" name="Negative response" />
    <bpmn:sequenceFlow id="flow_gen_success" sourceRef="gw_contract_gen_success" targetRef="task_send_confirmation" name="Positive response" />
    <bpmn:sequenceFlow id="flow_analyze_to_prepare" sourceRef="task_analyze_issues" targetRef="task_prepare_contract" />
    <bpmn:sequenceFlow id="flow_confirm_to_request_grid" sourceRef="task_send_confirmation" targetRef="task_request_grid" />
    <bpmn:sequenceFlow id="flow_request_grid_to_evt_msg" sourceRef="task_request_grid" targetRef="evt_msg_to_grid" />
    <bpmn:sequenceFlow id="flow_resp_start_to_create_cis" sourceRef="evt_start_cs_response" targetRef="task_create_cis_contract" />
    <bpmn:sequenceFlow id="flow_create_cis_to_send_contract" sourceRef="task_create_cis_contract" targetRef="task_send_contract_customer" />
    <bpmn:sequenceFlow id="flow_dec_start_to_gw_dec" sourceRef="evt_start_cs_decision" targetRef="gw_customer_decision" />
    <bpmn:sequenceFlow id="flow_withdraw" sourceRef="gw_customer_decision" targetRef="evt_end_cs_contract_rejected" name="Withdraw" />
    <bpmn:sequenceFlow id="flow_confirm" sourceRef="gw_customer_decision" targetRef="gw_timer_merge" name="Confirm" />
    <bpmn:sequenceFlow id="flow_timer_to_merge" sourceRef="evt_timer_acceptance" targetRef="gw_timer_merge" />
    <bpmn:sequenceFlow id="flow_merge_to_import" sourceRef="gw_timer_merge" targetRef="task_import_meter_data" />
    <bpmn:sequenceFlow id="flow_import_to_end" sourceRef="task_import_meter_data" targetRef="evt_end_cs_main" />
  </bpmn:process>
  <bpmn:process id="pool_grid_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_meter_report_p1" name="Services Consumption Report" dataObjectRef="data_meter_report_p1_do" />
    <bpmn:dataObject id="data_meter_report_p1_do" />
    <bpmn:dataObjectReference id="doc_final_billing_grid" name="Final Billing Calculation" dataObjectRef="doc_final_billing_grid_do" />
    <bpmn:dataObject id="doc_final_billing_grid_do" />
    <bpmn:startEvent id="evt_start_grid" name="Receive Request from CIS">
      <bpmn:outgoing>flow_grid_start_to_check</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_grid_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_cs_response" name="Response Sent to Customer Service">
      <bpmn:incoming>flow_terminate_to_evt_msg_resp</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_cs_response_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_meter_data_cs" name="Meter Data Sent to CS">
      <bpmn:incoming>flow_grid_meter_to_evt_msg_cs</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_meter_data_cs_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_meter_data_old" name="Meter Data Sent to Old Supplier">
      <bpmn:incoming>flow_grid_meter_to_evt_msg_old</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_meter_data_old_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_billing_old" name="Final Billing Sent to Old Supplier">
      <bpmn:incoming>flow_grid_billing_to_evt_msg_old</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_billing_old_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="evt_end_grid" name="Grid Operator Process End">
      <bpmn:incoming>flow_grid_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_grid_check_concurrence" name="Check for Supplier Concurrence">
      <bpmn:incoming>flow_grid_start_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gw_concurrence</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_grid_resolve_conflict" name="Inform Suppliers and Demand Resolution">
      <bpmn:incoming>flow_concurrence_yes</bpmn:incoming>
      <bpmn:outgoing>flow_resolve_to_terminate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_grid_terminate_old" name="Terminate Sales Agreement with Old Supplier">
      <bpmn:incoming>flow_concurrence_no</bpmn:incoming>
      <bpmn:incoming>flow_resolve_to_terminate</bpmn:incoming>
      <bpmn:outgoing>flow_terminate_to_evt_msg_resp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_grid_compute_billing" name="Compute Final Billing">
      <bpmn:outgoing>flow_grid_meter_to_evt_msg_cs</bpmn:outgoing>
      <bpmn:outgoing>flow_grid_meter_to_evt_msg_old</bpmn:outgoing>
      <bpmn:outgoing>flow_grid_billing_to_evt_msg_old</bpmn:outgoing>
      <bpmn:outgoing>flow_grid_end</bpmn:outgoing>
      <bpmn:property id="task_grid_compute_billing_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_grid_compute_billing_dia0">
        <bpmn:sourceRef>data_meter_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_grid_compute_billing_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_grid_compute_billing_doa0">
        <bpmn:targetRef>doc_final_billing_grid</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_concurrence" name="Supplier Concurrence?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_to_gw_concurrence</bpmn:incoming>
      <bpmn:outgoing>flow_concurrence_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_concurrence_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_grid_start_to_check" sourceRef="evt_start_grid" targetRef="task_grid_check_concurrence" />
    <bpmn:sequenceFlow id="flow_check_to_gw_concurrence" sourceRef="task_grid_check_concurrence" targetRef="gw_concurrence" />
    <bpmn:sequenceFlow id="flow_concurrence_yes" sourceRef="gw_concurrence" targetRef="task_grid_resolve_conflict" name="Concurrence exists" />
    <bpmn:sequenceFlow id="flow_concurrence_no" sourceRef="gw_concurrence" targetRef="task_grid_terminate_old" name="No objections" />
    <bpmn:sequenceFlow id="flow_resolve_to_terminate" sourceRef="task_grid_resolve_conflict" targetRef="task_grid_terminate_old" />
    <bpmn:sequenceFlow id="flow_terminate_to_evt_msg_resp" sourceRef="task_grid_terminate_old" targetRef="evt_msg_to_cs_response" />
