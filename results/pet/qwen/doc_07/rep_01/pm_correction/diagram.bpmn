    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mpo_info" name="End: MPO Informed">
      <bpmn:incoming>flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_8" sourceRef="evt_start_mpo_info" targetRef="evt_end_mpo_info" />
  </bpmn:process>
  <bpmn:process id="pool_sp_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_sp_info" name="Start: Receive Assignment Info">
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_sp_info_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_sp_info" name="End: SP Informed">
      <bpmn:incoming>flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_9" sourceRef="evt_start_sp_info" targetRef="evt_end_sp_info" />
  </bpmn:process>
