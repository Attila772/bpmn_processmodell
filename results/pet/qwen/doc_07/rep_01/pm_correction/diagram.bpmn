<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mspn_part" name="MSPN" processRef="pool_mspn_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mspon_part" name="MSPO" processRef="pool_mspon_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="msg_1" sourceRef="evt_end_mspn_registration" targetRef="evt_start_go_exam" name="Registration Data" />
    <bpmn:messageFlow id="msg_2" sourceRef="evt_end_go_reject" targetRef="evt_start_mspn" name="Rejection Notice" />
    <bpmn:messageFlow id="msg_3" sourceRef="evt_end_go_confirm_assign" targetRef="evt_start_mspo_info" name="Assignment Notification" />
    <bpmn:messageFlow id="msg_4" sourceRef="evt_end_go_confirm_assign" targetRef="evt_start_mpo_info" name="Assignment Notification" />
    <bpmn:messageFlow id="msg_5" sourceRef="evt_end_go_confirm_assign" targetRef="evt_start_sp_info" name="Assignment Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mspn_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_application" name="Application of the MSPN" dataObjectRef="data_application_do" />
    <bpmn:dataObject id="data_application_do" />
    <bpmn:startEvent id="evt_start_mspn" name="Start: MSPN Registers Measurement">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mspn_registration" name="End: Registration Complete">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mspn_registration_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_register_measurement" name="Register measurement at the GO">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_measurement_doa0">
        <bpmn:targetRef>data_application</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_mspn" targetRef="task_register_measurement" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_register_measurement" targetRef="evt_end_mspn_registration" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_application_p1" name="Application of the MSPN" dataObjectRef="data_application_p1_do" />
    <bpmn:dataObject id="data_application_p1_do" />
    <bpmn:dataObjectReference id="data_assignment" name="Assignment of MSPN" dataObjectRef="data_assignment_do" />
    <bpmn:dataObject id="data_assignment_do" />
    <bpmn:startEvent id="evt_start_go_exam" name="Start: Receive Registration">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_go_exam_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_go_reject" name="End: Application Rejected">
      <bpmn:incoming>flow_to_reject</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_reject_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_go_confirm_assign" name="End: Assignment Confirmed">
      <bpmn:incoming>flow_8_new</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_confirm_assign_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_examine_application" name="Examine the application of the MSPN">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_examine_application_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_application_dia0">
        <bpmn:sourceRef>data_application_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_application_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_assign_mspn" name="Assign the MSPN">
      <bpmn:incoming>flow_to_assign</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_assign_mspn_doa0">
        <bpmn:targetRef>data_assignment</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_mspon" name="Inform the MSPO about the assignment">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_inform_mspon_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mspon_dia0">
        <bpmn:sourceRef>data_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mspon_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_mpo" name="Inform the MPO about the assignment">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7_new</bpmn:outgoing>
      <bpmn:property id="task_inform_mpo_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_mpo_dia0">
        <bpmn:sourceRef>data_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_mpo_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_sp" name="Inform the SP about the assignment">
      <bpmn:incoming>flow_7_new</bpmn:incoming>
      <bpmn:outgoing>flow_8_new</bpmn:outgoing>
      <bpmn:property id="task_inform_sp_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_sp_dia0">
        <bpmn:sourceRef>data_assignment</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_sp_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decision" name="Decision: Reject or Confirm?" isMarkerVisible="true">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_to_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_to_assign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_3" sourceRef="evt_start_go_exam" targetRef="task_examine_application" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_examine_application" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_to_reject" sourceRef="gw_decision" targetRef="evt_end_go_reject" name="Reject" />
    <bpmn:sequenceFlow id="flow_to_assign" sourceRef="gw_decision" targetRef="task_assign_mspn" name="Confirm" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_assign_mspn" targetRef="task_inform_mspon" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_inform_mspon" targetRef="task_inform_mpo" />
    <bpmn:sequenceFlow id="flow_7_new" sourceRef="task_inform_mpo" targetRef="task_inform_sp" />
    <bpmn:sequenceFlow id="flow_8_new" sourceRef="task_inform_sp" targetRef="evt_end_go_confirm_assign" />
  </bpmn:process>
  <bpmn:process id="pool_mspon_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_mspo_info" name="Start: Receive Assignment Info">
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mspo_info_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mspo_info" name="End: MSPO Informed">
      <bpmn:incoming>flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_7" sourceRef="evt_start_mspo_info" targetRef="evt_end_mspo_info" />
  </bpmn:process>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_mpo_info" name="Start: Receive Assignment Info">
      <bpmn:outgoing>flow_8</bpmn:outgoing>
