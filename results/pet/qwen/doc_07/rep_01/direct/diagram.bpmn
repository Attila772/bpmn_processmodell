<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_MSPN_Assignment" name="MSPN Assignment Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Register Measurement">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ExamineApplication" name="Examine Application of MSPN">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision on Application">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Rejected" name="Application Rejected">
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_AssignMSPN" name="Assign MSPN">
      <bpmn:incoming>Flow_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Parallel_Start" name="Start Notifications">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Info_MSPO</bpmn:outgoing>
      <bpmn:outgoing>Flow_Info_MPO</bpmn:outgoing>
      <bpmn:outgoing>Flow_Info_SP</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_InformMSPO" name="Inform MSPO about assignment">
      <bpmn:incoming>Flow_Info_MSPO</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_MSPO</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InformMPO" name="Inform MPO about assignment">
      <bpmn:incoming>Flow_Info_MPO</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_MPO</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InformSP" name="Inform SP about assignment">
      <bpmn:incoming>Flow_Info_SP</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_SP</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Parallel_End" name="End Notifications">
      <bpmn:incoming>Flow_Join_MSPO</bpmn:incoming>
      <bpmn:incoming>Flow_Join_MPO</bpmn:incoming>
      <bpmn:incoming>Flow_Join_SP</bpmn:incoming>
      <bpmn:outgoing>Flow_Final</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_Completed" name="Assignment Completed">
      <bpmn:incoming>Flow_Final</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ExamineApplication" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ExamineApplication" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Reject" name="Reject" sourceRef="Gateway_Decision" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_Confirm" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_AssignMSPN" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AssignMSPN" targetRef="Gateway_Parallel_Start" />
    <bpmn:sequenceFlow id="Flow_Info_MSPO" sourceRef="Gateway_Parallel_Start" targetRef="Task_InformMSPO" />
    <bpmn:sequenceFlow id="Flow_Info_MPO" sourceRef="Gateway_Parallel_Start" targetRef="Task_InformMPO" />
    <bpmn:sequenceFlow id="Flow_Info_SP" sourceRef="Gateway_Parallel_Start" targetRef="Task_InformSP" />
    <bpmn:sequenceFlow id="Flow_Join_MSPO" sourceRef="Task_InformMSPO" targetRef="Gateway_Parallel_End" />
    <bpmn:sequenceFlow id="Flow_Join_MPO" sourceRef="Task_InformMPO" targetRef="Gateway_Parallel_End" />
    <bpmn:sequenceFlow id="Flow_Join_SP" sourceRef="Task_InformSP" targetRef="Gateway_Parallel_End" />
    <bpmn:sequenceFlow id="Flow_Final" sourceRef="Gateway_Parallel_End" targetRef="EndEvent_Completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_MSPN_Assignment">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="137" y="145" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExamineApplication_di" bpmnElement="Task_ExamineApplication">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="385" y="155" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="502" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="487" y="145" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignMSPN_di" bpmnElement="Task_AssignMSPN">
        <dc:Bounds x="390" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Parallel_Start_di" bpmnElement="Gateway_Parallel_Start" isMarkerVisible="true">
        <dc:Bounds x="545" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformMSPO_di" bpmnElement="Task_InformMSPO">
        <dc:Bounds x="650" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformMPO_di" bpmnElement="Task_InformMPO">
        <dc:Bounds x="650" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformSP_di" bpmnElement="Task_InformSP">
        <dc:Bounds x="650" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Parallel_End_di" bpmnElement="Gateway_Parallel_End" isMarkerVisible="true">
        <dc:Bounds x="825" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="932" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="917" y="265" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_di" bpmnElement="Flow_Reject">
        <di:waypoint x="445" y="120" />
        <di:waypoint x="502" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="463" y="106" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Confirm_di" bpmnElement="Flow_Confirm">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="165" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="490" y="240" />
        <di:waypoint x="545" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Info_MSPO_di" bpmnElement="Flow_Info_MSPO">
        <di:waypoint x="570" y="215" />
        <di:waypoint x="700" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Info_MPO_di" bpmnElement="Flow_Info_MPO">
        <di:waypoint x="595" y="240" />
        <di:waypoint x="650" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Info_SP_di" bpmnElement="Flow_Info_SP">
        <di:waypoint x="570" y="265" />
        <di:waypoint x="700" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_MSPO_di" bpmnElement="Flow_Join_MSPO">
        <di:waypoint x="750" y="140" />
        <di:waypoint x="850" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_MPO_di" bpmnElement="Flow_Join_MPO">
        <di:waypoint x="750" y="255" />
        <di:waypoint x="875" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_SP_di" bpmnElement="Flow_Join_SP">
        <di:waypoint x="750" y="370" />
        <di:waypoint x="850" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Final_di" bpmnElement="Flow_Final">
        <di:waypoint x="875" y="240" />
        <di:waypoint x="932" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>