<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_contact_details" name="Contact Details" dataObjectRef="data_contact_details_do" />
    <bpmn:dataObject id="data_contact_details_do" />
    <bpmn:dataObjectReference id="data_interest_status" name="Interest Status" dataObjectRef="data_interest_status_do" />
    <bpmn:dataObject id="data_interest_status_do" />
    <bpmn:dataObjectReference id="data_budget_info" name="Budget Information" dataObjectRef="data_budget_info_do" />
    <bpmn:dataObject id="data_budget_info_do" />
    <bpmn:dataObjectReference id="data_final_interest" name="Final Interest Confirmation" dataObjectRef="data_final_interest_do" />
    <bpmn:dataObject id="data_final_interest_do" />
    <bpmn:dataObjectReference id="data_quotation" name="Quotation" dataObjectRef="data_quotation_do" />
    <bpmn:dataObject id="data_quotation_do" />
    <bpmn:startEvent id="evt_start" name="Process Start">
      <bpmn:outgoing>flow_start_to_contacts</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_rejected" name="Customer Rejected">
      <bpmn:incoming>flow_budget_normal</bpmn:incoming>
      <bpmn:incoming>flow_not_interested_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_quotation_created" name="Quotation Created">
      <bpmn:incoming>flow_quote_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_determine_contacts" name="Determine contact details of potential customers">
      <bpmn:incoming>flow_start_to_contacts</bpmn:incoming>
      <bpmn:outgoing>flow_contacts_to_call</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_determine_contacts_doa0">
        <bpmn:targetRef>data_contact_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="task_call_customer" name="Call the customer">
      <bpmn:incoming>flow_contacts_to_call</bpmn:incoming>
      <bpmn:outgoing>flow_call_to_gw_interest</bpmn:outgoing>
      <bpmn:property id="task_call_customer_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_call_customer_dia0">
        <bpmn:sourceRef>data_contact_details</bpmn:sourceRef>
        <bpmn:targetRef>task_call_customer_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_call_customer_doa0">
        <bpmn:targetRef>data_interest_status</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_call_customer_doa1">
        <bpmn:targetRef>data_budget_info</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_head_acquisition" name="Head of development personally tries to acquire the customer">
      <bpmn:incoming>flow_budget_huge</bpmn:incoming>
      <bpmn:outgoing>flow_head_to_gw_final</bpmn:outgoing>
      <bpmn:property id="task_head_acquisition_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_head_acquisition_dia0">
        <bpmn:sourceRef>data_budget_info</bpmn:sourceRef>
        <bpmn:targetRef>task_head_acquisition_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_head_acquisition_doa0">
        <bpmn:targetRef>data_final_interest</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_online_presentation" name="Detailed online presentation">
      <bpmn:incoming>flow_sales_rep_pres</bpmn:incoming>
      <bpmn:incoming>flow_presales_pres</bpmn:incoming>
      <bpmn:outgoing>flow_pres_to_wait</bpmn:outgoing>
      <bpmn:property id="task_online_presentation_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_online_presentation_dia0">
        <bpmn:sourceRef>data_final_interest</bpmn:sourceRef>
        <bpmn:targetRef>task_online_presentation_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_wait_for_feedback" name="Wait for customer feedback">
      <bpmn:incoming>flow_pres_to_wait</bpmn:incoming>
      <bpmn:outgoing>flow_wait_to_gw_feedback</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_follow_up_call" name="Sales representative calls the customer">
      <bpmn:incoming>flow_no_feedback</bpmn:incoming>
      <bpmn:outgoing>flow_followup_to_quote</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_quotation" name="Creation of a quotation">
      <bpmn:incoming>flow_feedback_received</bpmn:incoming>
      <bpmn:incoming>flow_followup_to_quote</bpmn:incoming>
      <bpmn:outgoing>flow_quote_to_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_create_quotation_doa0">
        <bpmn:targetRef>data_quotation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_initial_interest" name="Is customer generally interested?" isMarkerVisible="true">
      <bpmn:incoming>flow_call_to_gw_interest</bpmn:incoming>
      <bpmn:outgoing>flow_not_interested</bpmn:outgoing>
      <bpmn:outgoing>flow_interested</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_huge_budget" name="Is potential project budget huge?" isMarkerVisible="true">
      <bpmn:incoming>flow_not_interested</bpmn:incoming>
      <bpmn:outgoing>flow_budget_normal</bpmn:outgoing>
      <bpmn:outgoing>flow_budget_huge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_final_interest" name="Is customer interested in the end?" isMarkerVisible="true">
      <bpmn:incoming>flow_interested</bpmn:incoming>
      <bpmn:incoming>flow_head_to_gw_final</bpmn:incoming>
      <bpmn:outgoing>flow_not_interested_end</bpmn:outgoing>
      <bpmn:outgoing>flow_interested_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_presentation_type" name="Presentation Type Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_interested_end</bpmn:incoming>
      <bpmn:outgoing>flow_sales_rep_pres</bpmn:outgoing>
      <bpmn:outgoing>flow_presales_pres</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_feedback_received" name="Feedback Received within 2 weeks?" isMarkerVisible="true">
      <bpmn:incoming>flow_wait_to_gw_feedback</bpmn:incoming>
      <bpmn:outgoing>flow_no_feedback</bpmn:outgoing>
      <bpmn:outgoing>flow_feedback_received</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_contacts" sourceRef="evt_start" targetRef="task_determine_contacts" />
    <bpmn:sequenceFlow id="flow_contacts_to_call" sourceRef="task_determine_contacts" targetRef="task_call_customer" />
    <bpmn:sequenceFlow id="flow_call_to_gw_interest" sourceRef="task_call_customer" targetRef="gw_initial_interest" />
    <bpmn:sequenceFlow id="flow_not_interested" sourceRef="gw_initial_interest" targetRef="gw_huge_budget" name="Not interested" />
    <bpmn:sequenceFlow id="flow_interested" sourceRef="gw_initial_interest" targetRef="gw_final_interest" name="Interested" />
    <bpmn:sequenceFlow id="flow_budget_normal" sourceRef="gw_huge_budget" targetRef="evt_end_rejected" name="Normal Budget" />
    <bpmn:sequenceFlow id="flow_budget_huge" sourceRef="gw_huge_budget" targetRef="task_head_acquisition" name="Huge Budget" />
    <bpmn:sequenceFlow id="flow_head_to_gw_final" sourceRef="task_head_acquisition" targetRef="gw_final_interest" />
    <bpmn:sequenceFlow id="flow_not_interested_end" sourceRef="gw_final_interest" targetRef="evt_end_rejected" name="Not interested" />
    <bpmn:sequenceFlow id="flow_interested_end" sourceRef="gw_final_interest" targetRef="gw_presentation_type" name="Interested" />
    <bpmn:sequenceFlow id="flow_sales_rep_pres" sourceRef="gw_presentation_type" targetRef="task_online_presentation" name="Standard Presentation" />
    <bpmn:sequenceFlow id="flow_presales_pres" sourceRef="gw_presentation_type" targetRef="task_online_presentation" name="Technical Presentation" />
    <bpmn:sequenceFlow id="flow_pres_to_wait" sourceRef="task_online_presentation" targetRef="task_wait_for_feedback" />
    <bpmn:sequenceFlow id="flow_wait_to_gw_feedback" sourceRef="task_wait_for_feedback" targetRef="gw_feedback_received" />
    <bpmn:sequenceFlow id="flow_no_feedback" sourceRef="gw_feedback_received" targetRef="task_follow_up_call" name="No feedback within 2 weeks" />
    <bpmn:sequenceFlow id="flow_feedback_received" sourceRef="gw_feedback_received" targetRef="task_create_quotation" name="Feedback received" />
    <bpmn:sequenceFlow id="flow_followup_to_quote" sourceRef="task_follow_up_call" targetRef="task_create_quotation" />
    <bpmn:sequenceFlow id="flow_quote_to_end" sourceRef="task_create_quotation" targetRef="evt_end_quotation_created" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_quotation_created_di" bpmnElement="evt_end_quotation_created">
        <dc:Bounds x="2250" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_rejected_di" bpmnElement="evt_end_rejected">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_di" bpmnElement="evt_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_feedback_received_di" bpmnElement="gw_feedback_received">
        <dc:Bounds x="1680" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_final_interest_di" bpmnElement="gw_final_interest">
        <dc:Bounds x="1300" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_huge_budget_di" bpmnElement="gw_huge_budget">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_initial_interest_di" bpmnElement="gw_initial_interest">
        <dc:Bounds x="730" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_presentation_type_di" bpmnElement="gw_presentation_type">
        <dc:Bounds x="1110" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_call_customer_di" bpmnElement="task_call_customer">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_create_quotation_di" bpmnElement="task_create_quotation">
        <dc:Bounds x="2060" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_determine_contacts_di" bpmnElement="task_determine_contacts">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_follow_up_call_di" bpmnElement="task_follow_up_call">
        <dc:Bounds x="1870" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_head_acquisition_di" bpmnElement="task_head_acquisition">
        <dc:Bounds x="1110" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_online_presentation_di" bpmnElement="task_online_presentation">
        <dc:Bounds x="1300" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_wait_for_feedback_di" bpmnElement="task_wait_for_feedback">
        <dc:Bounds x="1490" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_contact_details_di" bpmnElement="data_contact_details">
        <dc:Bounds x="465" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_interest_status_di" bpmnElement="data_interest_status">
        <dc:Bounds x="560" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_budget_info_di" bpmnElement="data_budget_info">
        <dc:Bounds x="845" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_final_interest_di" bpmnElement="data_final_interest">
        <dc:Bounds x="1225" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_quotation_di" bpmnElement="data_quotation">
        <dc:Bounds x="2080" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_contacts_di" bpmnElement="flow_start_to_contacts">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_contacts_to_call_di" bpmnElement="flow_contacts_to_call">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_call_to_gw_interest_di" bpmnElement="flow_call_to_gw_interest">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_not_interested_di" bpmnElement="flow_not_interested">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_di" bpmnElement="flow_interested">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_budget_normal_di" bpmnElement="flow_budget_normal">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_budget_huge_di" bpmnElement="flow_budget_huge">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_head_to_gw_final_di" bpmnElement="flow_head_to_gw_final">
        <di:waypoint x="1160" y="390" />
        <di:waypoint x="1325" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_not_interested_end_di" bpmnElement="flow_not_interested_end">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_interested_end_di" bpmnElement="flow_interested_end">
        <di:waypoint x="1325" y="125" />
        <di:waypoint x="1135" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sales_rep_pres_di" bpmnElement="flow_sales_rep_pres">
        <di:waypoint x="1135" y="250" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_presales_pres_di" bpmnElement="flow_presales_pres">
        <di:waypoint x="1135" y="250" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_pres_to_wait_di" bpmnElement="flow_pres_to_wait">
        <di:waypoint x="1350" y="265" />
        <di:waypoint x="1540" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_wait_to_gw_feedback_di" bpmnElement="flow_wait_to_gw_feedback">
        <di:waypoint x="1540" y="140" />
        <di:waypoint x="1705" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_no_feedback_di" bpmnElement="flow_no_feedback">
        <di:waypoint x="1705" y="125" />
        <di:waypoint x="1920" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_feedback_received_di" bpmnElement="flow_feedback_received">
        <di:waypoint x="1705" y="125" />
        <di:waypoint x="2110" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_followup_to_quote_di" bpmnElement="flow_followup_to_quote">
        <di:waypoint x="1920" y="140" />
        <di:waypoint x="2110" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_quote_to_end_di" bpmnElement="flow_quote_to_end">
        <di:waypoint x="2110" y="140" />
        <di:waypoint x="2268" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_determine_contacts_doa0_di" bpmnElement="task_determine_contacts_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_call_customer_dia0_di" bpmnElement="task_call_customer_dia0">
        <di:waypoint x="483" y="515" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_call_customer_doa0_di" bpmnElement="task_call_customer_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="578" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_call_customer_doa1_di" bpmnElement="task_call_customer_doa1">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="863" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_head_acquisition_dia0_di" bpmnElement="task_head_acquisition_dia0">
        <di:waypoint x="863" y="515" />
        <di:waypoint x="1160" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_head_acquisition_doa0_di" bpmnElement="task_head_acquisition_doa0">
        <di:waypoint x="1160" y="390" />
        <di:waypoint x="1243" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_online_presentation_dia0_di" bpmnElement="task_online_presentation_dia0">
        <di:waypoint x="1243" y="515" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_create_quotation_doa0_di" bpmnElement="task_create_quotation_doa0">
        <di:waypoint x="2110" y="140" />
        <di:waypoint x="2098" y="515" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>