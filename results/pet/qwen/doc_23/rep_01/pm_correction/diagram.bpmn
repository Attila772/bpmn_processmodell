<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_order_ticket" name="Order ticket" dataObjectRef="data_order_ticket_do" />
    <bpmn:dataObject id="data_order_ticket_do" />
    <bpmn:dataObjectReference id="data_prepared_food" name="Prepared food" dataObjectRef="data_prepared_food_do" />
    <bpmn:dataObject id="data_prepared_food_do" />
    <bpmn:dataObjectReference id="data_ready_cart" name="Ready cart" dataObjectRef="data_ready_cart_do" />
    <bpmn:dataObject id="data_ready_cart_do" />
    <bpmn:dataObjectReference id="data_nonalc_drinks" name="Nonalcoholic drinks" dataObjectRef="data_nonalc_drinks_do" />
    <bpmn:dataObject id="data_nonalc_drinks_do" />
    <bpmn:dataObjectReference id="data_alc_beverages" name="Alcoholic beverages" dataObjectRef="data_alc_beverages_do" />
    <bpmn:dataObject id="data_alc_beverages_do" />
    <bpmn:startEvent id="evt_start" name="Guest calls room service">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end" name="Order completed and billed">
      <bpmn:incoming>flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_take_order" name="Take down the order">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_take_order_doa0">
        <bpmn:targetRef>data_order_ticket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_submit_kitchen" name="Submit order ticket to kitchen">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_submit_kitchen_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_submit_kitchen_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_submit_kitchen_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_prepare_food" name="Prepare food">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_prepare_food_doa0">
        <bpmn:targetRef>data_prepared_food</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_assign_waiter" name="Assign order to waiter">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:property id="task_assign_waiter_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_assign_waiter_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_assign_waiter_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_ready_cart" name="Ready cart (tablecloth, silverware)">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_ready_cart_doa0">
        <bpmn:targetRef>data_ready_cart</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_prepare_nonalc" name="Prepare nonalcoholic drinks">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_prepare_nonalc_doa0">
        <bpmn:targetRef>data_nonalc_drinks</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_fetch_wine" name="Fetch wine from cellar">
      <bpmn:incoming>flow_yes_alcohol</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_fetch_wine_doa0">
        <bpmn:targetRef>data_alc_beverages</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_prepare_alc" name="Prepare other alcoholic beverages">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_prepare_alc_doa0">
        <bpmn:targetRef>data_alc_beverages</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_deliver" name="Deliver to guest's room">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:property id="task_deliver_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_deliver_dia0">
        <bpmn:sourceRef>data_prepared_food</bpmn:sourceRef>
        <bpmn:targetRef>task_deliver_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_deliver_dia1">
        <bpmn:sourceRef>data_alc_beverages</bpmn:sourceRef>
        <bpmn:targetRef>task_deliver_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_deliver_dia2">
        <bpmn:sourceRef>data_nonalc_drinks</bpmn:sourceRef>
        <bpmn:targetRef>task_deliver_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_deliver_dia3">
        <bpmn:sourceRef>data_ready_cart</bpmn:sourceRef>
        <bpmn:targetRef>task_deliver_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_debit_account" name="Debit guest's account">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:property id="task_debit_account_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_debit_account_dia0">
        <bpmn:sourceRef>data_order_ticket</bpmn:sourceRef>
        <bpmn:targetRef>task_debit_account_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_alcohol_check" name="Does order include alcohol?" isMarkerVisible="true">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_yes_alcohol</bpmn:outgoing>
      <bpmn:outgoing>flow_no_alcohol</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_sync_delivery" name="Sync for delivery">
      <bpmn:incoming>flow_no_alcohol</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start" targetRef="task_take_order" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_take_order" targetRef="task_submit_kitchen" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_submit_kitchen" targetRef="task_prepare_food" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_take_order" targetRef="task_assign_waiter" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_assign_waiter" targetRef="task_ready_cart" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_ready_cart" targetRef="task_prepare_nonalc" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_assign_waiter" targetRef="gw_alcohol_check" />
    <bpmn:sequenceFlow id="flow_yes_alcohol" sourceRef="gw_alcohol_check" targetRef="task_fetch_wine" name="Yes" />
    <bpmn:sequenceFlow id="flow_no_alcohol" sourceRef="gw_alcohol_check" targetRef="gw_sync_delivery" name="No" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_fetch_wine" targetRef="task_prepare_alc" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_prepare_alc" targetRef="gw_sync_delivery" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_prepare_food" targetRef="gw_sync_delivery" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_prepare_nonalc" targetRef="gw_sync_delivery" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="gw_sync_delivery" targetRef="task_deliver" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="task_deliver" targetRef="task_debit_account" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="task_debit_account" targetRef="evt_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
