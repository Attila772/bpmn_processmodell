  <bpmn:process id="ClaimHandlingProcess" name="Claim Handling Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CheckRecommendation" name="Check Recommendation">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_ProcessProceeds" name="Process Proceeds">
      <bpmn:incoming>Flow_OK</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_WriteRecommendation" targetRef="Gateway_CheckRecommendation" />
    <bpmn:sequenceFlow id="Flow_OK" name="OK" sourceRef="Gateway_CheckRecommendation" targetRef="EndEvent_ProcessProceeds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">status == &quot;OK&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotOK" name="Not OK" sourceRef="Gateway_CheckRecommendation" targetRef="Task_WriteRecommendation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">status == &quot;Not OK&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
