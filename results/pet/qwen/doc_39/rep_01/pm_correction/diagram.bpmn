<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_settlement_recommendation" name="Settlement Recommendation" dataObjectRef="data_settlement_recommendation_do" />
    <bpmn:dataObject id="data_settlement_recommendation_do" />
    <bpmn:startEvent id="evt_start_claim_registered" name="Claim Registered">
      <bpmn:outgoing>flow_start_to_examine</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_process_complete" name="Claim Handling Complete">
      <bpmn:incoming>flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_examine_claim" name="Examine Claim">
      <bpmn:incoming>flow_start_to_examine</bpmn:incoming>
      <bpmn:outgoing>flow_examine_to_write</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_write_recommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>flow_examine_to_write</bpmn:incoming>
      <bpmn:incoming>flow_back_to_officer</bpmn:incoming>
      <bpmn:outgoing>flow_write_to_check</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_write_recommendation_doa0">
        <bpmn:targetRef>data_settlement_recommendation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_recommendation" name="Check Recommendation">
      <bpmn:incoming>flow_write_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gateway</bpmn:outgoing>
      <bpmn:property id="task_check_recommendation_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_recommendation_dia0">
        <bpmn:sourceRef>data_settlement_recommendation</bpmn:sourceRef>
        <bpmn:targetRef>task_check_recommendation_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decision_ok_not_ok" name="Is Recommendation OK?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_to_end</bpmn:outgoing>
      <bpmn:outgoing>flow_back_to_officer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_examine" sourceRef="evt_start_claim_registered" targetRef="task_examine_claim" />
    <bpmn:sequenceFlow id="flow_examine_to_write" sourceRef="task_examine_claim" targetRef="task_write_recommendation" />
    <bpmn:sequenceFlow id="flow_write_to_check" sourceRef="task_write_recommendation" targetRef="task_check_recommendation" />
    <bpmn:sequenceFlow id="flow_check_to_gateway" sourceRef="task_check_recommendation" targetRef="gw_decision_ok_not_ok" />
    <bpmn:sequenceFlow id="flow_to_end" sourceRef="gw_decision_ok_not_ok" targetRef="evt_end_process_complete" name="OK" />
    <bpmn:sequenceFlow id="flow_back_to_officer" sourceRef="gw_decision_ok_not_ok" targetRef="task_write_recommendation" name="Not OK" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_process_complete_di" bpmnElement="evt_end_process_complete">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_claim_registered_di" bpmnElement="evt_start_claim_registered">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_ok_not_ok_di" bpmnElement="gw_decision_ok_not_ok">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_recommendation_di" bpmnElement="task_check_recommendation">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_examine_claim_di" bpmnElement="task_examine_claim">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_write_recommendation_di" bpmnElement="task_write_recommendation">
        <dc:Bounds x="1110" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_settlement_recommendation_di" bpmnElement="data_settlement_recommendation">
        <dc:Bounds x="940" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_examine_di" bpmnElement="flow_start_to_examine">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_examine_to_write_di" bpmnElement="flow_examine_to_write">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_write_to_check_di" bpmnElement="flow_write_to_check">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_gateway_di" bpmnElement="flow_check_to_gateway">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_end_di" bpmnElement="flow_to_end">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_back_to_officer_di" bpmnElement="flow_back_to_officer">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_write_recommendation_doa0_di" bpmnElement="task_write_recommendation_doa0">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="958" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_recommendation_dia0_di" bpmnElement="task_check_recommendation_dia0">
        <di:waypoint x="958" y="390" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>