    {
      "id": "pool_accounting",
      "name": "Accounting",
      "element_ids": [
        "evt_msg_from_secretariat",
        "task_create_instance",
        "task_check_items_and_cost_centers",
        "evt_msg_to_ccm_1",
        "evt_msg_back_to_accounting_ccm",
        "evt_msg_from_accounting_ccm_return",
        "evt_msg_reject_to_accounting",
        "evt_msg_from_accounting_reject",
        "task_clarify_with_vendor",
        "evt_msg_resend_to_ccm",
        "evt_msg_from_accounting_resend",
        "evt_msg_to_commercial_mgr",
        "evt_msg_complaint_to_accounting",
        "evt_msg_from_accounting_complaint",
        "task_resolve_complaint",
        "evt_msg_board_approved_to_accounting",
        "evt_msg_from_accounting_board_return",
        "task_give_payment_instructions",
        "task_close_instance",
        "evt_end_process_closed"
      ]
    },
