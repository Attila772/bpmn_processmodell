{
  "name": "ACME AG Invoice Processing Process",
  "resources": [
    {
      "name": "Secretariat",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "Accounting Employee",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "Cost Center Manager",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "Commercial Manager",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "Board",
      "capacity": 1,
      "resource_type": "human"
    }
  ],
  "events": [
    {
      "id": "evt_start_invoice_received",
      "name": "Invoice Received (Paper/Fax)",
      "event_position": "start",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_end_process_closed",
      "name": "Instance Closed",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_msg_to_accounting",
      "name": "Forward to Accounting",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Invoice & Docket to Accounting"
    },
    {
      "id": "evt_msg_from_secretariat",
      "name": "Receive from Secretariat",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Invoice & Docket to Accounting"
    },
    {
      "id": "evt_msg_to_ccm_1",
      "name": "Send to First CCM",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Invoice Copy & Docket to CCM"
    },
    {
      "id": "evt_msg_from_ccm_1",
      "name": "Receive from First CCM",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Invoice Copy & Docket from CCM"
    },
    {
      "id": "evt_msg_to_next_ccm",
      "name": "Send to Next CCM",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Invoice Copy & Docket to Next CCM"
    },
    {
      "id": "evt_msg_from_next_ccm",
      "name": "Receive from Next CCM",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Invoice Copy & Docket from Next CCM"
    },
    {
      "id": "evt_msg_back_to_accounting_ccm",
      "name": "Return to Accounting (CCM Loop End)",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Approved Invoice & Docket to Accounting"
    },
    {
      "id": "evt_msg_from_accounting_ccm_return",
      "name": "Receive Return from Accounting (CCM Loop)",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Approved Invoice & Docket to Accounting"
    },
    {
      "id": "evt_msg_reject_to_accounting",
      "name": "Reject to Accounting",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Rejected Invoice & Docket to Accounting"
    },
    {
      "id": "evt_msg_from_accounting_reject",
      "name": "Receive Rejection from CCM",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Rejected Invoice & Docket to Accounting"
    },
    {
      "id": "evt_msg_resend_to_ccm",
      "name": "Resend to CCMs after Clarification",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Clarified Invoice & Docket to CCMs"
    },
    {
      "id": "evt_msg_from_accounting_resend",
      "name": "Receive Resend Trigger",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Clarified Invoice & Docket to CCMs"
    },
    {
      "id": "evt_msg_to_commercial_mgr",
      "name": "Send to Commercial Manager",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Approved Invoice & Docket to Comm. Mgr."
    },
    {
      "id": "evt_msg_from_commercial_mgr",
      "name": "Receive from Commercial Manager",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Approved Invoice & Docket to Comm. Mgr."
    },
    {
      "id": "evt_msg_complaint_to_accounting",
      "name": "Complaint to Accounting",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Complaint Details to Accounting"
    },
    {
      "id": "evt_msg_from_accounting_complaint",
      "name": "Receive Complaint",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Complaint Details to Accounting"
    },
    {
      "id": "evt_msg_commercial_approved_to_board",
      "name": "Send to Board (if >20 EUR)",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Invoice for Board Approval"
    },
    {
      "id": "evt_msg_from_board",
      "name": "Receive Board Approval/Rejection",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Invoice for Board Approval"
    },
    {
      "id": "evt_msg_board_approved_to_accounting",
      "name": "Return to Accounting (Board Approved)",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Board Approved Invoice to Accounting"
    },
    {
      "id": "evt_msg_from_accounting_board_return",
      "name": "Receive Board Approved Invoice",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Board Approved Invoice to Accounting"
    }
  ],
