  "gateways": [
    {
      "id": "gw_all_items_marked_correct",
      "name": "All Items Marked Correct?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_to_next_ccm_or_accounting",
          "condition": "No"
        },
        {
          "flow_id": "flow_to_commercial_mgr",
          "condition": "Yes"
        }
      ]
    },
    {
      "id": "gw_ccm_decision",
      "name": "Accuracy Check Result",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_to_note_ap",
          "condition": "In Order"
        },
        {
          "flow_id": "flow_to_reject",
          "condition": "Inconsistencies Exist"
        }
      ]
    },
    {
      "id": "gw_commercial_audit_result",
      "name": "Commercial Audit Result",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_to_issue_approval",
          "condition": "Successful"
        },
        {
          "flow_id": "flow_to_complaint",
          "condition": "Complaint"
        }
      ]
    },
    {
      "id": "gw_amount_exceeds_20",
      "name": "Amount > EUR 20?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_to_board",
          "condition": "Yes"
        },
        {
          "flow_id": "flow_to_payment_instructions",
          "condition": "No"
        }
      ]
    }
  ],
  "sequence_flows": [
    {
      "id": "flow_start_to_inspection",
      "source_id": "evt_start_invoice_received",
      "target_id": "task_visual_inspection",
      "condition_name": null
    },
    {
      "id": "flow_inspection_to_msg_accounting",
      "source_id": "task_visual_inspection",
      "target_id": "evt_msg_to_accounting",
      "condition_name": null
    },
    {
      "id": "flow_msg_accounting_to_create_instance",
      "source_id": "evt_msg_from_secretariat",
      "target_id": "task_create_instance",
      "condition_name": null
    },
    {
      "id": "flow_create_instance_to_check_items",
      "source_id": "task_create_instance",
      "target_id": "task_check_items_and_cost_centers",
      "condition_name": null
    },
    {
      "id": "flow_check_items_to_msg_ccm_1",
      "source_id": "task_check_items_and_cost_centers",
      "target_id": "evt_msg_to_ccm_1",
      "condition_name": null
    },
    {
      "id": "flow_msg_ccm_1_to_review",
      "source_id": "evt_msg_from_ccm_1",
      "target_id": "task_review_accuracy_ccm",
      "condition_name": null
    },
    {
      "id": "flow_review_to_gateway_ccm",
      "source_id": "task_review_accuracy_ccm",
      "target_id": "gw_ccm_decision",
      "condition_name": null
    },
    {
      "id": "flow_to_note_ap",
      "source_id": "gw_ccm_decision",
      "target_id": "task_note_ap_code",
      "condition_name": "In Order"
    },
    {
      "id": "flow_to_reject",
      "source_id": "gw_ccm_decision",
      "target_id": "task_reject_ap_with_note",
      "condition_name": "Inconsistencies Exist"
    },
    {
      "id": "flow_note_ap_to_gateway_all_correct",
      "source_id": "task_note_ap_code",
      "target_id": "gw_all_items_marked_correct",
      "condition_name": null
    },
    {
      "id": "flow_to_next_ccm_or_accounting",
      "source_id": "gw_all_items_marked_correct",
      "target_id": "evt_msg_to_next_ccm",
      "condition_name": "No"
    },
    {
      "id": "flow_to_commercial_mgr",
      "source_id": "gw_all_items_marked_correct",
      "target_id": "evt_msg_back_to_accounting_ccm",
      "condition_name": "Yes"
    },
    {
      "id": "flow_msg_next_ccm_to_review_loop",
      "source_id": "evt_msg_from_next_ccm",
      "target_id": "task_review_accuracy_ccm",
      "condition_name": null
    },
    {
      "id": "flow_reject_to_msg_accounting",
      "source_id": "task_reject_ap_with_note",
      "target_id": "evt_msg_reject_to_accounting",
      "condition_name": null
    },
    {
      "id": "flow_msg_reject_to_clarify",
      "source_id": "evt_msg_from_accounting_reject",
      "target_id": "task_clarify_with_vendor",
      "condition_name": null
    },
    {
      "id": "flow_clarify_to_msg_resend",
      "source_id": "task_clarify_with_vendor",
      "target_id": "evt_msg_resend_to_ccm",
      "condition_name": null
    },
    {
      "id": "flow_msg_resend_to_review_loop",
      "source_id": "evt_msg_from_accounting_resend",
      "target_id": "task_review_accuracy_ccm",
      "condition_name": null
    },
    {
      "id": "flow_msg_back_to_accounting_to_commercial",
      "source_id": "evt_msg_from_accounting_ccm_return",
      "target_id": "evt_msg_to_commercial_mgr",
      "condition_name": null
    },
    {
      "id": "flow_msg_commercial_to_audit",
      "source_id": "evt_msg_from_commercial_mgr",
      "target_id": "task_commercial_audit",
      "condition_name": null
    },
    {
      "id": "flow_audit_to_gateway_commercial",
      "source_id": "task_commercial_audit",
      "target_id": "gw_commercial_audit_result",
      "condition_name": null
    },
    {
      "id": "flow_to_issue_approval",
      "source_id": "gw_commercial_audit_result",
      "target_id": "task_issue_approval_payment",
      "condition_name": "Successful"
    },
    {
      "id": "flow_to_complaint",
      "source_id": "gw_commercial_audit_result",
      "target_id": "evt_msg_complaint_to_accounting",
      "condition_name": "Complaint"
    },
    {
      "id": "flow_msg_complaint_to_resolve",
      "source_id": "evt_msg_from_accounting_complaint",
      "target_id": "task_resolve_complaint",
      "condition_name": null
    },
    {
      "id": "flow_resolve_to_msg_commercial_retry",
      "source_id": "task_resolve_complaint",
      "target_id": "evt_msg_to_commercial_mgr",
      "condition_name": null
    },
    {
      "id": "flow_issue_approval_to_gateway_amount",
      "source_id": "task_issue_approval_payment",
      "target_id": "gw_amount_exceeds_20",
      "condition_name": null
    },
    {
      "id": "flow_to_board",
      "source_id": "gw_amount_exceeds_20",
      "target_id": "evt_msg_commercial_approved_to_board",
      "condition_name": "Yes"
    },
    {
      "id": "flow_to_payment_instructions",
      "source_id": "gw_amount_exceeds_20",
      "target_id": "task_give_payment_instructions",
      "condition_name": "No"
    },
    {
      "id": "flow_msg_board_to_check",
      "source_id": "evt_msg_from_board",
      "target_id": "task_board_check",
      "condition_name": null
    },
    {
      "id": "flow_board_check_to_msg_accounting",
      "source_id": "task_board_check",
      "target_id": "evt_msg_board_approved_to_accounting",
      "condition_name": null
    },
    {
      "id": "flow_msg_board_approved_to_payment",
      "source_id": "evt_msg_from_accounting_board_return",
      "target_id": "task_give_payment_instructions",
      "condition_name": null
    },
    {
      "id": "flow_payment_to_close",
      "source_id": "task_give_payment_instructions",
      "target_id": "task_close_instance",
      "condition_name": null
    },
    {
      "id": "flow_close_to_end",
      "source_id": "task_close_instance",
      "target_id": "evt_end_process_closed",
      "condition_name": null
    }
  ],
