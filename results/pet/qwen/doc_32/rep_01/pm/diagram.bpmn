<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_secretariat_part" name="Secretariat" processRef="pool_secretariat_proc" />
    <bpmn:participant id="pool_accounting_part" name="Accounting" processRef="pool_accounting_proc" />
    <bpmn:participant id="pool_cost_center_managers_part" name="Cost Center Managers" processRef="pool_cost_center_managers_proc" />
    <bpmn:participant id="pool_commercial_manager_part" name="Commercial Manager" processRef="pool_commercial_manager_proc" />
    <bpmn:participant id="pool_board_part" name="Board" processRef="pool_board_proc" />
    <bpmn:messageFlow id="msg_flow_secretariat_to_accounting" sourceRef="evt_msg_to_accounting" targetRef="evt_msg_from_secretariat" name="Invoice &amp; Docket to Accounting" />
    <bpmn:messageFlow id="msg_flow_accounting_to_ccm_1" sourceRef="evt_msg_to_ccm_1" targetRef="evt_msg_from_ccm_1" name="Invoice Copy &amp; Docket to CCM" />
    <bpmn:messageFlow id="msg_flow_ccm_loop_internal" sourceRef="evt_msg_to_next_ccm" targetRef="evt_msg_from_next_ccm" name="Invoice Copy &amp; Docket to Next CCM" />
    <bpmn:messageFlow id="msg_flow_ccm_to_accounting_approved" sourceRef="evt_msg_back_to_accounting_ccm" targetRef="evt_msg_from_accounting_ccm_return" name="Approved Invoice &amp; Docket to Accounting" />
    <bpmn:messageFlow id="msg_flow_ccm_to_accounting_rejected" sourceRef="evt_msg_reject_to_accounting" targetRef="evt_msg_from_accounting_reject" name="Rejected Invoice &amp; Docket to Accounting" />
    <bpmn:messageFlow id="msg_flow_accounting_to_ccm_resend" sourceRef="evt_msg_resend_to_ccm" targetRef="evt_msg_from_accounting_resend" name="Clarified Invoice &amp; Docket to CCMs" />
    <bpmn:messageFlow id="msg_flow_accounting_to_commercial" sourceRef="evt_msg_to_commercial_mgr" targetRef="evt_msg_from_commercial_mgr" name="Approved Invoice &amp; Docket to Comm. Mgr." />
    <bpmn:messageFlow id="msg_flow_commercial_to_accounting_complaint" sourceRef="evt_msg_complaint_to_accounting" targetRef="evt_msg_from_accounting_complaint" name="Complaint Details to Accounting" />
    <bpmn:messageFlow id="msg_flow_accounting_to_commercial_retry" sourceRef="evt_msg_to_commercial_mgr" targetRef="evt_msg_from_commercial_mgr" name="Retry Commercial Audit" />
    <bpmn:messageFlow id="msg_flow_commercial_to_board" sourceRef="evt_msg_commercial_approved_to_board" targetRef="evt_msg_from_board" name="Invoice for Board Approval" />
    <bpmn:messageFlow id="msg_flow_board_to_accounting" sourceRef="evt_msg_board_approved_to_accounting" targetRef="evt_msg_from_accounting_board_return" name="Board Approved Invoice to Accounting" />
  </bpmn:collaboration>
  <bpmn:process id="pool_secretariat_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_invoice_paper" name="Invoice (Paper/Fax)" dataObjectRef="data_invoice_paper_do" />
    <bpmn:dataObject id="data_invoice_paper_do" />
    <bpmn:startEvent id="evt_start_invoice_received" name="Invoice Received (Paper/Fax)">
      <bpmn:outgoing>flow_start_to_inspection</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_accounting" name="Forward to Accounting">
      <bpmn:incoming>flow_inspection_to_msg_accounting</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_accounting_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_commercial_approved_to_board" name="Send to Board (if &gt;20 EUR)">
      <bpmn:incoming>flow_to_board</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_commercial_approved_to_board_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:manualTask id="task_visual_inspection" name="Visual Inspection">
      <bpmn:incoming>flow_start_to_inspection</bpmn:incoming>
      <bpmn:outgoing>flow_inspection_to_msg_accounting</bpmn:outgoing>
      <bpmn:property id="task_visual_inspection_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_visual_inspection_dia0">
        <bpmn:sourceRef>data_invoice_paper</bpmn:sourceRef>
        <bpmn:targetRef>task_visual_inspection_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow_start_to_inspection" sourceRef="evt_start_invoice_received" targetRef="task_visual_inspection" />
    <bpmn:sequenceFlow id="flow_inspection_to_msg_accounting" sourceRef="task_visual_inspection" targetRef="evt_msg_to_accounting" />
  </bpmn:process>
  <bpmn:process id="pool_accounting_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_invoice_copy" name="Copy of Invoice" dataObjectRef="data_invoice_copy_do" />
    <bpmn:dataObject id="data_invoice_copy_do" />
    <bpmn:dataObjectReference id="data_docket" name="Docket" dataObjectRef="data_docket_do" />
    <bpmn:dataObject id="data_docket_do" />
    <bpmn:endEvent id="evt_end_process_closed" name="Instance Closed">
      <bpmn:incoming>flow_close_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_msg_from_secretariat" name="Receive from Secretariat">
      <bpmn:outgoing>flow_msg_accounting_to_create_instance</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_secretariat_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_ccm_1" name="Send to First CCM">
      <bpmn:incoming>flow_check_items_to_msg_ccm_1</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_ccm_1_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_back_to_accounting_ccm" name="Return to Accounting (CCM Loop End)">
      <bpmn:incoming>flow_to_commercial_mgr</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_back_to_accounting_ccm_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_msg_from_accounting_ccm_return" name="Receive Return from Accounting (CCM Loop)">
      <bpmn:outgoing>flow_msg_back_to_accounting_to_commercial</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_accounting_ccm_return_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_reject_to_accounting" name="Reject to Accounting">
      <bpmn:incoming>flow_reject_to_msg_accounting</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_reject_to_accounting_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_msg_from_accounting_reject" name="Receive Rejection from CCM">
      <bpmn:outgoing>flow_msg_reject_to_clarify</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_accounting_reject_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_resend_to_ccm" name="Resend to CCMs after Clarification">
      <bpmn:incoming>flow_clarify_to_msg_resend</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_resend_to_ccm_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_msg_from_accounting_resend" name="Receive Resend Trigger">
      <bpmn:outgoing>flow_msg_resend_to_review_loop</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_accounting_resend_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_commercial_mgr" name="Send to Commercial Manager">
      <bpmn:incoming>flow_msg_back_to_accounting_to_commercial</bpmn:incoming>
      <bpmn:incoming>flow_resolve_to_msg_commercial_retry</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_commercial_mgr_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_complaint_to_accounting" name="Complaint to Accounting">
      <bpmn:incoming>flow_to_complaint</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_complaint_to_accounting_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_msg_from_accounting_complaint" name="Receive Complaint">
      <bpmn:outgoing>flow_msg_complaint_to_resolve</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_accounting_complaint_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_board_approved_to_accounting" name="Return to Accounting (Board Approved)">
      <bpmn:incoming>flow_board_check_to_msg_accounting</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_board_approved_to_accounting_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_msg_from_accounting_board_return" name="Receive Board Approved Invoice">
      <bpmn:outgoing>flow_msg_board_approved_to_payment</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_accounting_board_return_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_create_instance" name="Identify Supplier &amp; Create Instance">
      <bpmn:incoming>flow_msg_accounting_to_create_instance</bpmn:incoming>
      <bpmn:outgoing>flow_create_instance_to_check_items</bpmn:outgoing>
      <bpmn:property id="task_create_instance_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_instance_dia0">
        <bpmn:sourceRef>data_invoice_copy</bpmn:sourceRef>
        <bpmn:targetRef>task_create_instance_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_instance_doa0">
        <bpmn:targetRef>data_docket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_items_and_cost_centers" name="Check Items &amp; Note Cost Centers">
      <bpmn:incoming>flow_create_instance_to_check_items</bpmn:incoming>
      <bpmn:outgoing>flow_check_items_to_msg_ccm_1</bpmn:outgoing>
      <bpmn:property id="task_check_items_and_cost_centers_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_items_and_cost_centers_dia0">
        <bpmn:sourceRef>data_invoice_copy</bpmn:sourceRef>
        <bpmn:targetRef>task_check_items_and_cost_centers_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_check_items_and_cost_centers_doa0">
        <bpmn:targetRef>data_docket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_clarify_with_vendor" name="Clarify with Vendor / Consult CCMs">
      <bpmn:incoming>flow_msg_reject_to_clarify</bpmn:incoming>
      <bpmn:outgoing>flow_clarify_to_msg_resend</bpmn:outgoing>
      <bpmn:property id="task_clarify_with_vendor_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_clarify_with_vendor_dia0">
        <bpmn:sourceRef>data_docket</bpmn:sourceRef>
        <bpmn:targetRef>task_clarify_with_vendor_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_resolve_complaint" name="Resolve Complaint with Supplier">
      <bpmn:incoming>flow_msg_complaint_to_resolve</bpmn:incoming>
      <bpmn:outgoing>flow_resolve_to_msg_commercial_retry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_give_payment_instructions" name="Give Payment Instructions">
      <bpmn:incoming>flow_to_payment_instructions</bpmn:incoming>
      <bpmn:incoming>flow_msg_board_approved_to_payment</bpmn:incoming>
      <bpmn:outgoing>flow_payment_to_close</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_close_instance" name="Close Instance in ACME Financial Accounting">
      <bpmn:incoming>flow_payment_to_close</bpmn:incoming>
      <bpmn:outgoing>flow_close_to_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_msg_accounting_to_create_instance" sourceRef="evt_msg_from_secretariat" targetRef="task_create_instance" />
    <bpmn:sequenceFlow id="flow_create_instance_to_check_items" sourceRef="task_create_instance" targetRef="task_check_items_and_cost_centers" />
    <bpmn:sequenceFlow id="flow_check_items_to_msg_ccm_1" sourceRef="task_check_items_and_cost_centers" targetRef="evt_msg_to_ccm_1" />
    <bpmn:sequenceFlow id="flow_msg_reject_to_clarify" sourceRef="evt_msg_from_accounting_reject" targetRef="task_clarify_with_vendor" />
    <bpmn:sequenceFlow id="flow_clarify_to_msg_resend" sourceRef="task_clarify_with_vendor" targetRef="evt_msg_resend_to_ccm" />
    <bpmn:sequenceFlow id="flow_msg_back_to_accounting_to_commercial" sourceRef="evt_msg_from_accounting_ccm_return" targetRef="evt_msg_to_commercial_mgr" />
    <bpmn:sequenceFlow id="flow_msg_complaint_to_resolve" sourceRef="evt_msg_from_accounting_complaint" targetRef="task_resolve_complaint" />
    <bpmn:sequenceFlow id="flow_resolve_to_msg_commercial_retry" sourceRef="task_resolve_complaint" targetRef="evt_msg_to_commercial_mgr" />
    <bpmn:sequenceFlow id="flow_msg_board_approved_to_payment" sourceRef="evt_msg_from_accounting_board_return" targetRef="task_give_payment_instructions" />
    <bpmn:sequenceFlow id="flow_payment_to_close" sourceRef="task_give_payment_instructions" targetRef="task_close_instance" />
    <bpmn:sequenceFlow id="flow_close_to_end" sourceRef="task_close_instance" targetRef="evt_end_process_closed" />
  </bpmn:process>
  <bpmn:process id="pool_cost_center_managers_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_invoice_copy_p1" name="Copy of Invoice" dataObjectRef="data_invoice_copy_p1_do" />
    <bpmn:dataObject id="data_invoice_copy_p1_do" />
    <bpmn:dataObjectReference id="data_docket_p1" name="Docket" dataObjectRef="data_docket_p1_do" />
    <bpmn:dataObject id="data_docket_p1_do" />
    <bpmn:startEvent id="evt_msg_from_ccm_1" name="Receive from First CCM">
      <bpmn:outgoing>flow_msg_ccm_1_to_review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_ccm_1_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_next_ccm" name="Send to Next CCM">
      <bpmn:incoming>flow_to_next_ccm_or_accounting</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_next_ccm_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="evt_msg_from_next_ccm" name="Receive from Next CCM">
      <bpmn:outgoing>flow_msg_next_ccm_to_review_loop</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_next_ccm_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_review_accuracy_ccm" name="Review Content for Accuracy">
      <bpmn:incoming>flow_msg_ccm_1_to_review</bpmn:incoming>
      <bpmn:incoming>flow_msg_next_ccm_to_review_loop</bpmn:incoming>
      <bpmn:incoming>flow_msg_resend_to_review_loop</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_gateway_ccm</bpmn:outgoing>
      <bpmn:property id="task_review_accuracy_ccm_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_accuracy_ccm_dia0">
        <bpmn:sourceRef>data_invoice_copy_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_accuracy_ccm_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_review_accuracy_ccm_dia1">
        <bpmn:sourceRef>data_docket_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_accuracy_ccm_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_review_accuracy_ccm_doa0">
        <bpmn:targetRef>data_docket_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_note_ap_code" name="Note AP Code (Accurate Position)">
      <bpmn:incoming>flow_to_note_ap</bpmn:incoming>
      <bpmn:outgoing>flow_note_ap_to_gateway_all_correct</bpmn:outgoing>
      <bpmn:property id="task_note_ap_code_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_note_ap_code_dia0">
        <bpmn:sourceRef>data_docket_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_note_ap_code_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_note_ap_code_doa0">
        <bpmn:targetRef>data_docket_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_reject_ap_with_note" name="Reject AP with Note &amp; Statement">
      <bpmn:incoming>flow_to_reject</bpmn:incoming>
      <bpmn:outgoing>flow_reject_to_msg_accounting</bpmn:outgoing>
      <bpmn:property id="task_reject_ap_with_note_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_reject_ap_with_note_dia0">
        <bpmn:sourceRef>data_docket_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_reject_ap_with_note_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_reject_ap_with_note_doa0">
        <bpmn:targetRef>data_docket_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_all_items_marked_correct" name="All Items Marked Correct?" isMarkerVisible="true">
      <bpmn:incoming>flow_note_ap_to_gateway_all_correct</bpmn:incoming>
      <bpmn:outgoing>flow_to_next_ccm_or_accounting</bpmn:outgoing>
      <bpmn:outgoing>flow_to_commercial_mgr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_ccm_decision" name="Accuracy Check Result" isMarkerVisible="true">
      <bpmn:incoming>flow_review_to_gateway_ccm</bpmn:incoming>
      <bpmn:outgoing>flow_to_note_ap</bpmn:outgoing>
      <bpmn:outgoing>flow_to_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_msg_ccm_1_to_review" sourceRef="evt_msg_from_ccm_1" targetRef="task_review_accuracy_ccm" />
    <bpmn:sequenceFlow id="flow_review_to_gateway_ccm" sourceRef="task_review_accuracy_ccm" targetRef="gw_ccm_decision" />
    <bpmn:sequenceFlow id="flow_to_note_ap" sourceRef="gw_ccm_decision" targetRef="task_note_ap_code" name="In Order" />
    <bpmn:sequenceFlow id="flow_to_reject" sourceRef="gw_ccm_decision" targetRef="task_reject_ap_with_note" name="Inconsistencies Exist" />
    <bpmn:sequenceFlow id="flow_note_ap_to_gateway_all_correct" sourceRef="task_note_ap_code" targetRef="gw_all_items_marked_correct" />
    <bpmn:sequenceFlow id="flow_to_next_ccm_or_accounting" sourceRef="gw_all_items_marked_correct" targetRef="evt_msg_to_next_ccm" name="No" />
    <bpmn:sequenceFlow id="flow_msg_next_ccm_to_review_loop" sourceRef="evt_msg_from_next_ccm" targetRef="task_review_accuracy_ccm" />
  </bpmn:process>
  <bpmn:process id="pool_commercial_manager_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_invoice_copy_p2" name="Copy of Invoice" dataObjectRef="data_invoice_copy_p2_do" />
    <bpmn:dataObject id="data_invoice_copy_p2_do" />
    <bpmn:dataObjectReference id="data_docket_p2" name="Docket" dataObjectRef="data_docket_p2_do" />
    <bpmn:dataObject id="data_docket_p2_do" />
    <bpmn:startEvent id="evt_msg_from_commercial_mgr" name="Receive from Commercial Manager">
      <bpmn:outgoing>flow_msg_commercial_to_audit</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_commercial_mgr_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_commercial_audit" name="Commercial Audit">
      <bpmn:incoming>flow_msg_commercial_to_audit</bpmn:incoming>
      <bpmn:outgoing>flow_audit_to_gateway_commercial</bpmn:outgoing>
      <bpmn:property id="task_commercial_audit_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_commercial_audit_dia0">
        <bpmn:sourceRef>data_invoice_copy_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_commercial_audit_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_commercial_audit_dia1">
        <bpmn:sourceRef>data_docket_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_commercial_audit_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_issue_approval_payment" name="Issue Approval for Payment">
      <bpmn:incoming>flow_to_issue_approval</bpmn:incoming>
      <bpmn:outgoing>flow_issue_approval_to_gateway_amount</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_commercial_audit_result" name="Commercial Audit Result" isMarkerVisible="true">
      <bpmn:incoming>flow_audit_to_gateway_commercial</bpmn:incoming>
      <bpmn:outgoing>flow_to_issue_approval</bpmn:outgoing>
      <bpmn:outgoing>flow_to_complaint</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_amount_exceeds_20" name="Amount &gt; EUR 20?" isMarkerVisible="true">
      <bpmn:incoming>flow_issue_approval_to_gateway_amount</bpmn:incoming>
      <bpmn:outgoing>flow_to_board</bpmn:outgoing>
