<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_customer_part" name="Customer" processRef="pool_customer_proc" />
    <bpmn:participant id="pool_customer_service_part" name="Customer Service" processRef="pool_customer_service_proc" />
    <bpmn:participant id="pool_service_management_part" name="Service Management" processRef="pool_service_management_proc" />
    <bpmn:participant id="pool_resource_provisioning_part" name="Resource Provisioning" processRef="pool_resource_provisioning_proc" />
    <bpmn:participant id="pool_billing_part" name="Billing &amp; Collections" processRef="pool_billing_proc" />
    <bpmn:messageFlow id="msg_flow_1" sourceRef="evt_end_cs_send_list" targetRef="evt_start_cs_receive_list" name="Problem Parameter List" />
    <bpmn:messageFlow id="msg_flow_2" sourceRef="evt_end_sm_send_detailed_report" targetRef="evt_start_sm_receive_detailed_report" name="Detailed Problem Report" />
    <bpmn:messageFlow id="msg_flow_3" sourceRef="evt_end_rp_send_status_report" targetRef="evt_start_sm_receive_status_report" name="Status Report" />
    <bpmn:messageFlow id="msg_flow_4" sourceRef="evt_end_sm_send_restoration_request" targetRef="evt_start_rp_receive_restoration_request" name="Automatic Resource Restoration Request" />
    <bpmn:messageFlow id="msg_flow_5" sourceRef="evt_end_rp_send_troubleshooting_report" targetRef="evt_start_sm_receive_troubleshooting_report" name="Trouble-shooting Report" />
    <bpmn:messageFlow id="msg_flow_6" sourceRef="evt_end_sm_send_resolution_report" targetRef="evt_start_cs_receive_resolution_report" name="Problem Resolution Report" />
    <bpmn:messageFlow id="msg_flow_7" sourceRef="evt_end_cs_send_customer_report" targetRef="evt_start_customer_receive_report" name="Service Performance and Resolution Report" />
    <bpmn:messageFlow id="msg_flow_8" sourceRef="evt_end_billing_rebate" targetRef="evt_start_billing_receive_rebate" name="SLA Violation Rebate Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_customer_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_customer" name="Customer perceives service degradation">
      <bpmn:outgoing>flow_cust_to_cs</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_customer_receive_report" name="Receive Customer Report">
      <bpmn:outgoing>flow_cust_start_recv_to_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_customer_receive_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_process_customer" name="Process ends (Customer)">
      <bpmn:incoming>flow_cust_start_recv_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_cust_start_recv_to_end" sourceRef="evt_start_customer_receive_report" targetRef="evt_end_process_customer" />
  </bpmn:process>
  <bpmn:process id="pool_customer_service_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_problem_params" name="List with all the problem parameters" dataObjectRef="data_problem_params_do" />
    <bpmn:dataObject id="data_problem_params_do" />
    <bpmn:dataObjectReference id="data_problem_report" name="Problem report" dataObjectRef="data_problem_report_do" />
    <bpmn:dataObject id="data_problem_report_do" />
    <bpmn:dataObjectReference id="data_sla_contract" name="Customer SLA / Contract commitment data" dataObjectRef="data_sla_contract_do" />
    <bpmn:dataObject id="data_sla_contract_do" />
    <bpmn:dataObjectReference id="data_degradation_details" name="Extent and details of service degradation" dataObjectRef="data_degradation_details_do" />
    <bpmn:dataObject id="data_degradation_details_do" />
    <bpmn:dataObjectReference id="data_prioritized_measures" name="Necessary counter measures including priorities" dataObjectRef="data_prioritized_measures_do" />
    <bpmn:dataObject id="data_prioritized_measures_do" />
    <bpmn:dataObjectReference id="data_contract_history" name="History of contractual relationship" dataObjectRef="data_contract_history_do" />
    <bpmn:dataObject id="data_contract_history_do" />
    <bpmn:dataObjectReference id="data_customer_significance" name="Customer significance" dataObjectRef="data_customer_significance_do" />
    <bpmn:dataObject id="data_customer_significance_do" />
    <bpmn:dataObjectReference id="data_final_prioritized_measures" name="Re-prioritized counter measures" dataObjectRef="data_final_prioritized_measures_do" />
    <bpmn:dataObject id="data_final_prioritized_measures_do" />
    <bpmn:dataObjectReference id="data_detailed_problem_report" name="Detailed problem report" dataObjectRef="data_detailed_problem_report_do" />
    <bpmn:dataObject id="data_detailed_problem_report_do" />
    <bpmn:dataObjectReference id="data_problem_resolution_report_p1" name="Problem resolution report" dataObjectRef="data_problem_resolution_report_p1_do" />
    <bpmn:dataObject id="data_problem_resolution_report_p1_do" />
    <bpmn:dataObjectReference id="data_actual_service_performance" name="Actual service performance" dataObjectRef="data_actual_service_performance_do" />
    <bpmn:dataObject id="data_actual_service_performance_do" />
    <bpmn:dataObjectReference id="data_customer_report" name="Report for customer" dataObjectRef="data_customer_report_do" />
    <bpmn:dataObject id="data_customer_report_do" />
    <bpmn:dataObjectReference id="data_rebate_notification" name="SLA violation rebate notification" dataObjectRef="data_rebate_notification_do" />
    <bpmn:dataObject id="data_rebate_notification_do" />
    <bpmn:endEvent id="evt_end_cs_send_list" name="Problem parameter list sent">
      <bpmn:incoming>flow_cust_to_cs</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_cs_send_list_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_cs_receive_list" name="Receive Problem Parameter List">
      <bpmn:outgoing>flow_cs_start_to_enter</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_cs_receive_list_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_sm_send_detailed_report" name="Detailed problem report sent">
      <bpmn:incoming>flow_cs_create_to_end</bpmn:incoming>
      <bpmn:incoming>flow_sm_analyzable_no</bpmn:incoming>
      <bpmn:incoming>flow_sm_no_problem</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_sm_send_detailed_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_cs_receive_resolution_report" name="Receive Problem Resolution Report">
      <bpmn:outgoing>flow_cs_start_res_to_gw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_cs_receive_resolution_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_cs_send_customer_report" name="Customer report sent">
      <bpmn:incoming>flow_cs_create_cust_to_end</bpmn:incoming>
      <bpmn:outgoing>flow_cs_cust_report_to_merge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_end_cs_send_customer_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_billing_rebate" name="SLA violation rebate reported">
      <bpmn:incoming>flow_cs_report_rebate_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_billing_rebate_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_process_cs" name="Process ends (Customer Service)">
      <bpmn:incoming>flow_cs_premium_yes</bpmn:incoming>
      <bpmn:incoming>flow_cs_merge_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_cs_enter_report" name="Enter problem report into system T">
      <bpmn:incoming>flow_cs_start_to_enter</bpmn:incoming>
      <bpmn:outgoing>flow_cs_enter_to_compare</bpmn:outgoing>
      <bpmn:property id="task_cs_enter_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_cs_enter_report_dia0">
        <bpmn:sourceRef>data_problem_params</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_enter_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_cs_enter_report_doa0">
        <bpmn:targetRef>data_problem_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_cs_compare_sla" name="Compare problem report to customer SLA">
      <bpmn:incoming>flow_cs_enter_to_compare</bpmn:incoming>
      <bpmn:outgoing>flow_cs_compare_to_determine</bpmn:outgoing>
      <bpmn:property id="task_cs_compare_sla_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_cs_compare_sla_dia0">
        <bpmn:sourceRef>data_problem_report</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_compare_sla_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_cs_compare_sla_dia1">
        <bpmn:sourceRef>data_sla_contract</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_compare_sla_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_cs_compare_sla_doa0">
        <bpmn:targetRef>data_degradation_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_cs_determine_measures" name="Determine necessary counter measures and priorities">
      <bpmn:incoming>flow_cs_compare_to_determine</bpmn:incoming>
      <bpmn:outgoing>flow_cs_determine_to_es</bpmn:outgoing>
      <bpmn:property id="task_cs_determine_measures_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_cs_determine_measures_dia0">
        <bpmn:sourceRef>data_degradation_details</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_determine_measures_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_cs_determine_measures_doa0">
        <bpmn:targetRef>data_prioritized_measures</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_es_determine_significance" name="Determine customer significance">
      <bpmn:incoming>flow_cs_determine_to_es</bpmn:incoming>
      <bpmn:outgoing>flow_es_to_gw_premium</bpmn:outgoing>
      <bpmn:property id="task_es_determine_significance_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_es_determine_significance_dia0">
        <bpmn:sourceRef>data_contract_history</bpmn:sourceRef>
        <bpmn:targetRef>task_es_determine_significance_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_es_determine_significance_doa0">
        <bpmn:targetRef>data_customer_significance</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_cs_reprioritize" name="Re-prioritize counter measures">
      <bpmn:incoming>flow_cs_sig_yes</bpmn:incoming>
      <bpmn:outgoing>flow_cs_reprioritize_to_create</bpmn:outgoing>
      <bpmn:property id="task_cs_reprioritize_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_cs_reprioritize_dia0">
        <bpmn:sourceRef>data_prioritized_measures</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_reprioritize_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_cs_reprioritize_dia1">
        <bpmn:sourceRef>data_customer_significance</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_reprioritize_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_cs_reprioritize_doa0">
        <bpmn:targetRef>data_final_prioritized_measures</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_cs_create_detailed_report" name="Create detailed problem report">
      <bpmn:incoming>flow_cs_sig_no</bpmn:incoming>
      <bpmn:incoming>flow_cs_reprioritize_to_create</bpmn:incoming>
      <bpmn:outgoing>flow_cs_create_to_end</bpmn:outgoing>
      <bpmn:property id="task_cs_create_detailed_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_cs_create_detailed_report_dia0">
        <bpmn:sourceRef>data_sla_contract</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_create_detailed_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_cs_create_detailed_report_dia1">
        <bpmn:sourceRef>data_final_prioritized_measures</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_create_detailed_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_cs_create_detailed_report_doa0">
        <bpmn:targetRef>data_detailed_problem_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_cs_create_customer_report" name="Create report for customer detailing performance and resolution">
      <bpmn:incoming>flow_cs_gw_to_create_cust</bpmn:incoming>
      <bpmn:outgoing>flow_cs_create_cust_to_end</bpmn:outgoing>
      <bpmn:property id="task_cs_create_customer_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_cs_create_customer_report_dia0">
        <bpmn:sourceRef>data_problem_resolution_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_create_customer_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_cs_create_customer_report_dia1">
        <bpmn:sourceRef>data_actual_service_performance</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_create_customer_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_cs_create_customer_report_doa0">
        <bpmn:targetRef>data_customer_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_cs_report_rebate" name="Report SLA violation rebate to Billing &amp; Collections">
      <bpmn:incoming>flow_cs_gw_to_report_rebate</bpmn:incoming>
      <bpmn:outgoing>flow_cs_report_rebate_to_end</bpmn:outgoing>
      <bpmn:property id="task_cs_report_rebate_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_cs_report_rebate_dia0">
        <bpmn:sourceRef>data_problem_resolution_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_cs_report_rebate_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_cs_report_rebate_doa0">
        <bpmn:targetRef>data_rebate_notification</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_cs_premium" name="Is customer premium?" isMarkerVisible="true">
      <bpmn:incoming>flow_es_to_gw_premium</bpmn:incoming>
      <bpmn:outgoing>flow_cs_premium_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_cs_premium_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_cs_significance" name="Does significance affect counter measures?" isMarkerVisible="true">
      <bpmn:incoming>flow_cs_premium_no</bpmn:incoming>
      <bpmn:outgoing>flow_cs_sig_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_cs_sig_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_cs_parallel_activities" name="Trigger concurrent activities">
      <bpmn:incoming>flow_cs_start_res_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_cs_gw_to_create_cust</bpmn:outgoing>
      <bpmn:outgoing>flow_cs_gw_to_report_rebate</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_cs_merge_activities" name="Merge concurrent activities">
      <bpmn:incoming>flow_bill_adjust_to_merge</bpmn:incoming>
      <bpmn:incoming>flow_cs_cust_report_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_cs_merge_to_end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_cs_start_to_enter" sourceRef="evt_start_cs_receive_list" targetRef="task_cs_enter_report" />
    <bpmn:sequenceFlow id="flow_cs_enter_to_compare" sourceRef="task_cs_enter_report" targetRef="task_cs_compare_sla" />
    <bpmn:sequenceFlow id="flow_cs_compare_to_determine" sourceRef="task_cs_compare_sla" targetRef="task_cs_determine_measures" />
    <bpmn:sequenceFlow id="flow_cs_determine_to_es" sourceRef="task_cs_determine_measures" targetRef="task_es_determine_significance" />
    <bpmn:sequenceFlow id="flow_es_to_gw_premium" sourceRef="task_es_determine_significance" targetRef="gw_cs_premium" />
    <bpmn:sequenceFlow id="flow_cs_premium_yes" sourceRef="gw_cs_premium" targetRef="evt_end_process_cs" name="Link to extra process (End)" />
    <bpmn:sequenceFlow id="flow_cs_premium_no" sourceRef="gw_cs_premium" targetRef="gw_cs_significance" />
    <bpmn:sequenceFlow id="flow_cs_sig_yes" sourceRef="gw_cs_significance" targetRef="task_cs_reprioritize" />
    <bpmn:sequenceFlow id="flow_cs_sig_no" sourceRef="gw_cs_significance" targetRef="task_cs_create_detailed_report" />
    <bpmn:sequenceFlow id="flow_cs_reprioritize_to_create" sourceRef="task_cs_reprioritize" targetRef="task_cs_create_detailed_report" />
    <bpmn:sequenceFlow id="flow_cs_create_to_end" sourceRef="task_cs_create_detailed_report" targetRef="evt_end_sm_send_detailed_report" />
    <bpmn:sequenceFlow id="flow_cs_start_res_to_gw" sourceRef="evt_start_cs_receive_resolution_report" targetRef="gw_cs_parallel_activities" />
    <bpmn:sequenceFlow id="flow_cs_gw_to_create_cust" sourceRef="gw_cs_parallel_activities" targetRef="task_cs_create_customer_report" />
    <bpmn:sequenceFlow id="flow_cs_gw_to_report_rebate" sourceRef="gw_cs_parallel_activities" targetRef="task_cs_report_rebate" />
    <bpmn:sequenceFlow id="flow_cs_create_cust_to_end" sourceRef="task_cs_create_customer_report" targetRef="evt_end_cs_send_customer_report" />
    <bpmn:sequenceFlow id="flow_cs_report_rebate_to_end" sourceRef="task_cs_report_rebate" targetRef="evt_end_billing_rebate" />
    <bpmn:sequenceFlow id="flow_cs_cust_report_to_merge" sourceRef="evt_end_cs_send_customer_report" targetRef="gw_cs_merge_activities" />
    <bpmn:sequenceFlow id="flow_cs_merge_to_end" sourceRef="gw_cs_merge_activities" targetRef="evt_end_process_cs" />
  </bpmn:process>
  <bpmn:process id="pool_service_management_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_detailed_problem_report_p1" name="Detailed problem report" dataObjectRef="data_detailed_problem_report_p1_do" />
    <bpmn:dataObject id="data_detailed_problem_report_p1_do" />
    <bpmn:dataObjectReference id="data_trouble_report_sm" name="Trouble report (SM)" dataObjectRef="data_trouble_report_sm_do" />
    <bpmn:dataObject id="data_trouble_report_sm_do" />
    <bpmn:dataObjectReference id="data_status_report_p1" name="Status report" dataObjectRef="data_status_report_p1_do" />
    <bpmn:dataObject id="data_status_report_p1_do" />
    <bpmn:dataObjectReference id="data_final_status_report" name="Final status report" dataObjectRef="data_final_status_report_do" />
    <bpmn:dataObject id="data_final_status_report_do" />
    <bpmn:dataObjectReference id="data_decision_countermeasures" name="Decision on counter measures" dataObjectRef="data_decision_countermeasures_do" />
    <bpmn:dataObject id="data_decision_countermeasures_do" />
    <bpmn:dataObjectReference id="data_troubleshooting_report_rp" name="Trouble-shooting report" dataObjectRef="data_troubleshooting_report_rp_do" />
    <bpmn:dataObject id="data_troubleshooting_report_rp_do" />
    <bpmn:dataObjectReference id="data_problem_resolution_report" name="Problem resolution report" dataObjectRef="data_problem_resolution_report_do" />
    <bpmn:dataObject id="data_problem_resolution_report_do" />
    <bpmn:dataObjectReference id="data_restoration_request" name="Request for automatic resource restoration" dataObjectRef="data_restoration_request_do" />
    <bpmn:dataObject id="data_restoration_request_do" />
    <bpmn:startEvent id="evt_start_sm_receive_status_report" name="Receive Status Report">
      <bpmn:outgoing>flow_sm_start_status_to_prepare</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_sm_receive_status_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_sm_send_restoration_request" name="Restoration request sent">
      <bpmn:incoming>flow_sm_create_req_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_sm_send_restoration_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_sm_receive_troubleshooting_report" name="Receive Trouble-shooting Report">
      <bpmn:outgoing>flow_sm_start_ts_to_create_res</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_sm_receive_troubleshooting_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_sm_send_resolution_report" name="Problem resolution report sent">
      <bpmn:incoming>flow_sm_create_res_to_end</bpmn:incoming>
      <bpmn:incoming>flow_sm_create_res_auto_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_sm_send_resolution_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_process_sm_minor" name="Process ends (Service Management - Minor)">
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_process_sm_auto" name="Process ends (Service Management - Auto)">
    </bpmn:endEvent>
    <bpmn:userTask id="task_sm_investigate_level" name="Investigate if problem is analyzable at SM level">
      <bpmn:incoming>flow_sm_start_to_investigate</bpmn:incoming>
