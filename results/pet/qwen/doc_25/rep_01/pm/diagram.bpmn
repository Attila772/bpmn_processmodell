<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_employee_part" name="Employee" processRef="pool_employee_proc" />
    <bpmn:participant id="pool_supervisor_part" name="Supervisor" processRef="pool_supervisor_proc" />
    <bpmn:participant id="pool_purchase_part" name="Purchase Department" processRef="pool_purchase_proc" />
    <bpmn:messageFlow id="msg_flow_change_req" sourceRef="evt_msg_to_employee_change" targetRef="evt_msg_from_employee_change" name="Change Request Notification" />
    <bpmn:messageFlow id="msg_flow_approved_req" sourceRef="evt_msg_to_purchase" targetRef="evt_msg_from_purchase" name="Approved Office Supply Request" />
  </bpmn:collaboration>
  <bpmn:process id="pool_employee_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_request" name="Office Supply Request" dataObjectRef="data_request_do" />
    <bpmn:dataObject id="data_request_do" />
    <bpmn:startEvent id="evt_start_request" name="Request Submitted">
      <bpmn:outgoing>flow_start_to_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_employee_change" name="Send Change Request to Employee">
      <bpmn:incoming>flow_supervisor_change</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_employee_change_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_from_employee_change" name="Receive Revised Request from Employee">
      <bpmn:outgoing>flow_change_to_employee_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_employee_change_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_purchase" name="Send Approved Request to Purchase">
      <bpmn:incoming>flow_supervisor_approve</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_to_purchase_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_submit_request" name="Submit Office Supply Request">
      <bpmn:incoming>flow_start_to_submit</bpmn:incoming>
      <bpmn:incoming>flow_review_to_submit_again</bpmn:incoming>
      <bpmn:outgoing>flow_submit_to_register</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_submit_request_doa0">
        <bpmn:targetRef>data_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_review_comments" name="Review Comments for Change">
      <bpmn:incoming>flow_change_to_employee_task</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_submit_again</bpmn:outgoing>
      <bpmn:property id="task_review_comments_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_comments_dia0">
        <bpmn:sourceRef>data_request</bpmn:sourceRef>
        <bpmn:targetRef>task_review_comments_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_review_comments_doa0">
        <bpmn:targetRef>data_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_start_to_submit" sourceRef="evt_start_request" targetRef="task_submit_request" />
    <bpmn:sequenceFlow id="flow_change_to_employee_task" sourceRef="evt_msg_from_employee_change" targetRef="task_review_comments" />
    <bpmn:sequenceFlow id="flow_review_to_submit_again" sourceRef="task_review_comments" targetRef="task_submit_request" />
  </bpmn:process>
  <bpmn:process id="pool_supervisor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_request_p1" name="Office Supply Request" dataObjectRef="data_request_p1_do" />
    <bpmn:dataObject id="data_request_p1_do" />
    <bpmn:endEvent id="evt_end_rejected" name="Process Ended (Rejected)">
      <bpmn:incoming>flow_notify_reject_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_register_request" name="Register Requirement">
      <bpmn:incoming>flow_submit_to_register</bpmn:incoming>
      <bpmn:outgoing>flow_register_to_supervisor</bpmn:outgoing>
      <bpmn:property id="task_register_request_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_register_request_dia0">
        <bpmn:sourceRef>data_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_register_request_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_supervisor_review" name="Review and Decide on Request">
      <bpmn:incoming>flow_register_to_supervisor</bpmn:incoming>
      <bpmn:outgoing>flow_supervisor_to_gw</bpmn:outgoing>
      <bpmn:property id="task_supervisor_review_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_supervisor_review_dia0">
        <bpmn:sourceRef>data_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_supervisor_review_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_notify_decision" name="Send Decision Notification">
      <bpmn:incoming>flow_supervisor_reject</bpmn:incoming>
      <bpmn:outgoing>flow_notify_reject_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_supervisor_decision" name="Supervisor Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_supervisor_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_supervisor_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_supervisor_change</bpmn:outgoing>
      <bpmn:outgoing>flow_supervisor_approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_register_to_supervisor" sourceRef="task_register_request" targetRef="task_supervisor_review" />
    <bpmn:sequenceFlow id="flow_supervisor_to_gw" sourceRef="task_supervisor_review" targetRef="gw_supervisor_decision" />
    <bpmn:sequenceFlow id="flow_supervisor_reject" sourceRef="gw_supervisor_decision" targetRef="task_notify_decision" name="Reject" />
    <bpmn:sequenceFlow id="flow_notify_reject_to_end" sourceRef="task_notify_decision" targetRef="evt_end_rejected" />
  </bpmn:process>
  <bpmn:process id="pool_purchase_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_request_p2" name="Office Supply Request" dataObjectRef="data_request_p2_do" />
    <bpmn:dataObject id="data_request_p2_do" />
    <bpmn:dataObjectReference id="data_vendor_list" name="Quotation List" dataObjectRef="data_vendor_list_do" />
    <bpmn:dataObject id="data_vendor_list_do" />
    <bpmn:dataObjectReference id="data_selected_vendor" name="Selected Vendor" dataObjectRef="data_selected_vendor_do" />
    <bpmn:dataObject id="data_selected_vendor_do" />
    <bpmn:dataObjectReference id="data_purchase_order" name="Purchase Order" dataObjectRef="data_purchase_order_do" />
    <bpmn:dataObject id="data_purchase_order_do" />
    <bpmn:dataObjectReference id="data_invoice" name="Invoice" dataObjectRef="data_invoice_do" />
    <bpmn:dataObject id="data_invoice_do" />
    <bpmn:endEvent id="evt_end_completed" name="Process Completed">
      <bpmn:incoming>flow_notify_complete_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_from_purchase" name="Receive Vendor Selection from Purchase">
      <bpmn:outgoing>flow_purchase_start_to_quote</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_purchase_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_make_quotations" name="Make Quotations">
      <bpmn:incoming>flow_purchase_start_to_quote</bpmn:incoming>
      <bpmn:outgoing>flow_quote_to_select</bpmn:outgoing>
      <bpmn:property id="task_make_quotations_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_make_quotations_dia0">
        <bpmn:sourceRef>data_request_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_make_quotations_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_make_quotations_doa0">
        <bpmn:targetRef>data_vendor_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_select_vendor" name="Select Vendor">
      <bpmn:incoming>flow_quote_to_select</bpmn:incoming>
      <bpmn:incoming>flow_vendor_invalid</bpmn:incoming>
      <bpmn:outgoing>flow_select_to_validate</bpmn:outgoing>
      <bpmn:property id="task_select_vendor_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_select_vendor_dia0">
        <bpmn:sourceRef>data_vendor_list</bpmn:sourceRef>
        <bpmn:targetRef>task_select_vendor_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_select_vendor_doa0">
        <bpmn:targetRef>data_selected_vendor</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_validate_vendor" name="Validate Vendor in System">
      <bpmn:incoming>flow_select_to_validate</bpmn:incoming>
      <bpmn:outgoing>flow_validate_to_gw</bpmn:outgoing>
      <bpmn:property id="task_validate_vendor_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_validate_vendor_dia0">
        <bpmn:sourceRef>data_selected_vendor</bpmn:sourceRef>
        <bpmn:targetRef>task_validate_vendor_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_generate_po" name="Generate and Send Purchase Order">
      <bpmn:incoming>flow_vendor_valid</bpmn:incoming>
      <bpmn:outgoing>flow_po_to_wait</bpmn:outgoing>
      <bpmn:property id="task_generate_po_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_generate_po_dia0">
        <bpmn:sourceRef>data_selected_vendor</bpmn:sourceRef>
        <bpmn:targetRef>task_generate_po_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_generate_po_doa0">
        <bpmn:targetRef>data_purchase_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:manualTask id="task_wait_delivery_invoice" name="Wait for Delivery and Invoice">
      <bpmn:incoming>flow_po_to_wait</bpmn:incoming>
      <bpmn:outgoing>flow_wait_to_notify_complete</bpmn:outgoing>
      <bpmn:property id="task_wait_delivery_invoice_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_wait_delivery_invoice_dia0">
        <bpmn:sourceRef>data_purchase_order</bpmn:sourceRef>
        <bpmn:targetRef>task_wait_delivery_invoice_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_wait_delivery_invoice_doa0">
        <bpmn:targetRef>data_invoice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:serviceTask id="task_notify_completion" name="Send Completion Notification">
      <bpmn:incoming>flow_wait_to_notify_complete</bpmn:incoming>
      <bpmn:outgoing>flow_notify_complete_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_vendor_validity" name="Vendor Valid?" isMarkerVisible="true">
      <bpmn:incoming>flow_validate_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_vendor_invalid</bpmn:outgoing>
      <bpmn:outgoing>flow_vendor_valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_purchase_start_to_quote" sourceRef="evt_msg_from_purchase" targetRef="task_make_quotations" />
    <bpmn:sequenceFlow id="flow_quote_to_select" sourceRef="task_make_quotations" targetRef="task_select_vendor" />
    <bpmn:sequenceFlow id="flow_select_to_validate" sourceRef="task_select_vendor" targetRef="task_validate_vendor" />
    <bpmn:sequenceFlow id="flow_validate_to_gw" sourceRef="task_validate_vendor" targetRef="gw_vendor_validity" />
    <bpmn:sequenceFlow id="flow_vendor_invalid" sourceRef="gw_vendor_validity" targetRef="task_select_vendor" name="Invalid" />
    <bpmn:sequenceFlow id="flow_vendor_valid" sourceRef="gw_vendor_validity" targetRef="task_generate_po" name="Valid" />
    <bpmn:sequenceFlow id="flow_po_to_wait" sourceRef="task_generate_po" targetRef="task_wait_delivery_invoice" />
    <bpmn:sequenceFlow id="flow_wait_to_notify_complete" sourceRef="task_wait_delivery_invoice" targetRef="task_notify_completion" />
    <bpmn:sequenceFlow id="flow_notify_complete_to_end" sourceRef="task_notify_completion" targetRef="evt_end_completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
