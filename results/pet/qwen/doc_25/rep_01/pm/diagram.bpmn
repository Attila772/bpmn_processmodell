        <di:waypoint x="590" y="140" />
        <di:waypoint x="210" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_register_to_supervisor_di" bpmnElement="flow_register_to_supervisor">
        <di:waypoint x="210" y="600" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_supervisor_to_gw_di" bpmnElement="flow_supervisor_to_gw">
        <di:waypoint x="400" y="600" />
