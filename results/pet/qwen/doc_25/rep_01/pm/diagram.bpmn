      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_supervisor_reject_di" bpmnElement="flow_supervisor_reject">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="780" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_supervisor_change_di" bpmnElement="flow_supervisor_change">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="118" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_supervisor_approve_di" bpmnElement="flow_supervisor_approve">
        <di:waypoint x="565" y="585" />
        <di:waypoint x="118" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_reject_to_end_di" bpmnElement="flow_notify_reject_to_end">
        <di:waypoint x="780" y="600" />
        <di:waypoint x="938" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_change_to_employee_task_di" bpmnElement="flow_change_to_employee_task">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_to_submit_again_di" bpmnElement="flow_review_to_submit_again">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_purchase_start_to_quote_di" bpmnElement="flow_purchase_start_to_quote">
        <di:waypoint x="178" y="913" />
        <di:waypoint x="400" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_quote_to_select_di" bpmnElement="flow_quote_to_select">
        <di:waypoint x="400" y="935" />
        <di:waypoint x="1160" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_select_to_validate_di" bpmnElement="flow_select_to_validate">
        <di:waypoint x="1160" y="1060" />
