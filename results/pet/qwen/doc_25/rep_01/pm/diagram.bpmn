      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_make_quotations_di" bpmnElement="task_make_quotations">
        <dc:Bounds x="350" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
