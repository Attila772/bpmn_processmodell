        <dc:Bounds x="1490" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_notification_decision_di" bpmnElement="task_send_notification_decision">
        <dc:Bounds x="730" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_request_di" bpmnElement="task_submit_request">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_supervisor_review_di" bpmnElement="task_supervisor_review">
