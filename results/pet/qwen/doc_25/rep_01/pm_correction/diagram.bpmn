      <bpmndi:BPMNShape id="gw_vendor_validity_di" bpmnElement="gw_vendor_validity">
        <dc:Bounds x="920" y="1020" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_generate_po_di" bpmnElement="task_generate_po">
        <dc:Bounds x="1110" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_make_quotations_di" bpmnElement="task_make_quotations">
        <dc:Bounds x="350" y="1020" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_request_di" bpmnElement="task_register_request">
        <dc:Bounds x="160" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_comments_di" bpmnElement="task_review_comments">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_select_vendor_di" bpmnElement="task_select_vendor">
