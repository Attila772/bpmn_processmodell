      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_supervisor_reject_di" bpmnElement="flow_supervisor_reject">
        <di:waypoint x="565" y="710" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_to_end_rejected_di" bpmnElement="flow_notify_to_end_rejected">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="938" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_receive_change_to_review_di" bpmnElement="flow_receive_change_to_review">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_to_submit_again_di" bpmnElement="flow_review_to_submit_again">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_receive_purchase_to_quote_di" bpmnElement="flow_receive_purchase_to_quote">
        <di:waypoint x="178" y="1038" />
        <di:waypoint x="400" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_quote_to_select_di" bpmnElement="flow_quote_to_select">
        <di:waypoint x="400" y="1060" />
        <di:waypoint x="1160" y="1185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_select_to_validate_di" bpmnElement="flow_select_to_validate">
        <di:waypoint x="1160" y="1185" />
        <di:waypoint x="780" y="1060" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_validate_to_gw_di" bpmnElement="flow_validate_to_gw">
        <di:waypoint x="780" y="1060" />
        <di:waypoint x="945" y="1045" />
