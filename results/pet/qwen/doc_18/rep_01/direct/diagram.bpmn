<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="InvoiceExaminationProcess" name="Invoice Examination Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_BillTempContinuationMetering" name="MPOO sends bill for temporary continuation of metering point operations">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GOExaminesBillTempContinuationMetering" name="GO examines the bill">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_TempContinuationMetering" name="Process End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_BillTempContinuationMetering" targetRef="Task_GOExaminesBillTempContinuationMetering" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_GOExaminesBillTempContinuationMetering" targetRef="EndEvent_TempContinuationMetering" />

    <bpmn:startEvent id="StartEvent_BillTempContinuationMeasurement" name="MSPO sends bill for temporary continuation of measurement">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GOExaminesBillTempContinuationMeasurement" name="GO examines the bill">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_TempContinuationMeasurement" name="Process End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="StartEvent_BillTempContinuationMeasurement" targetRef="Task_GOExaminesBillTempContinuationMeasurement" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GOExaminesBillTempContinuationMeasurement" targetRef="EndEvent_TempContinuationMeasurement" />

    <bpmn:startEvent id="StartEvent_BillAdditionalReadings" name="MSPO sends bill for additional readings">
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GOExaminesBillAdditionalReadings" name="GO examines the bill">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_AdditionalReadings" name="Process End">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="StartEvent_BillAdditionalReadings" targetRef="Task_GOExaminesBillAdditionalReadings" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_GOExaminesBillAdditionalReadings" targetRef="EndEvent_AdditionalReadings" />

    <bpmn:startEvent id="StartEvent_BillEquipmentAcquisition" name="MPOO sends bill for equipment acquisition to MPON or GO">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_MPONGOExaminesBillEquipment" name="MPON or GO examines the bill">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_EquipmentDecision" name="Decision on Equipment Bill">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Equipment</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject_Equipment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConfirmEquipment" name="Confirm invoice with payment advice to MPOO">
      <bpmn:incoming>Flow_Confirm_Equipment</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Confirm_Equipment</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RejectEquipment" name="Reject invoice of MPOO">
      <bpmn:incoming>Flow_Reject_Equipment</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Reject_Equipment</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ConfirmEquipment" name="Confirmation Sent">
      <bpmn:incoming>Flow_End_Confirm_Equipment</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_RejectEquipment" name="Rejection Sent">
      <bpmn:incoming>Flow_End_Reject_Equipment</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="StartEvent_BillEquipmentAcquisition" targetRef="Task_MPONGOExaminesBillEquipment" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_MPONGOExaminesBillEquipment" targetRef="Gateway_EquipmentDecision" />
    <bpmn:sequenceFlow id="Flow_Confirm_Equipment" name="Confirm" sourceRef="Gateway_EquipmentDecision" targetRef="Task_ConfirmEquipment" />
    <bpmn:sequenceFlow id="Flow_Reject_Equipment" name="Reject" sourceRef="Gateway_EquipmentDecision" targetRef="Task_RejectEquipment" />
    <bpmn:sequenceFlow id="Flow_End_Confirm_Equipment" sourceRef="Task_ConfirmEquipment" targetRef="EndEvent_ConfirmEquipment" />
    <bpmn:sequenceFlow id="Flow_End_Reject_Equipment" sourceRef="Task_RejectEquipment" targetRef="EndEvent_RejectEquipment" />
  </bpmn:process>
</bpmn:definitions>