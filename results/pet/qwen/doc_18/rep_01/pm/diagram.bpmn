<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpoo_part" name="MPOO" processRef="pool_mpoo_proc" />
    <bpmn:participant id="pool_mspon_part" name="MSPO" processRef="pool_mspon_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:messageFlow id="msg_flow_mpoo_metering" sourceRef="evt_start_mpoo_metering" targetRef="evt_msg_mpoo_metering_to_go" name="Metering Bill" />
    <bpmn:messageFlow id="msg_flow_mspon_measurement" sourceRef="evt_start_mspon_measurement" targetRef="evt_msg_mspon_measurement_to_go" name="Measurement Bill" />
    <bpmn:messageFlow id="msg_flow_mspon_readings" sourceRef="evt_start_mspon_readings" targetRef="evt_msg_mspon_readings_to_go" name="Additional Readings Bill" />
    <bpmn:messageFlow id="msg_flow_mpoo_equip_go" sourceRef="evt_start_mpoo_equipment_go" targetRef="evt_msg_mpoo_equipment_to_go" name="Equipment Bill" />
    <bpmn:messageFlow id="msg_flow_mpoo_equip_mpon" sourceRef="evt_start_mpoo_equipment_mpon" targetRef="evt_msg_mpoo_equipment_to_mpon" name="Equipment Bill" />
    <bpmn:messageFlow id="msg_flow_go_confirm_mpoo" sourceRef="evt_msg_confirm_to_mpoo" targetRef="evt_start_mpoo_confirmed" name="Confirmation/Rejection" />
    <bpmn:messageFlow id="msg_flow_mpon_confirm_mpoo" sourceRef="evt_msg_confirm_to_mpoo" targetRef="evt_start_mpoo_confirmed" name="Confirmation/Rejection" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpoo_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_mpoo_metering" name="Start: MPOO sends metering bill">
      <bpmn:outgoing>flow_mpoo_start_to_msg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_mspo_measurement" name="Start: MSPO sends measurement bill">
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_mspo_readings" name="Start: MSPO sends additional readings bill">
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_mpoo_equipment_go" name="Start: MPOO sends equipment bill to GO">
      <bpmn:outgoing>flow_mpoo_start_equip_go_to_msg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_mpoo_equipment_mpon" name="Start: MPOO sends equipment bill to MPON">
      <bpmn:outgoing>flow_mpoo_start_equip_mpon_to_msg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_msg_mspo_measurement_to_go" name="Receive Measurement Bill">
      <bpmn:messageEventDefinition id="evt_msg_mspo_measurement_to_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_msg_mspo_readings_to_go" name="Receive Additional Readings Bill">
      <bpmn:messageEventDefinition id="evt_msg_mspo_readings_to_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_msg_confirm_to_mspon" name="Send Confirmation to MSPO">
      <bpmn:messageEventDefinition id="evt_msg_confirm_to_mspon_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_msg_reject_to_mspon" name="Send Rejection to MSPO">
      <bpmn:messageEventDefinition id="evt_msg_reject_to_mspon_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_mpoo_confirmed" name="Start: MPOO Receives Decision">
      <bpmn:outgoing>flow_mpoo_recv_confirm</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mpoo_confirmed_msgdef" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="pool_mspon_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_mspon_confirmed" name="Start: MSPO Receives Decision">
      <bpmn:outgoing>flow_mspon_recv_confirm</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mspon_confirmed_msgdef" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_bill_metering" name="Bill for temporary continuation of metering point operations" dataObjectRef="data_bill_metering_do" />
    <bpmn:dataObject id="data_bill_metering_do" />
    <bpmn:dataObjectReference id="data_bill_measurement" name="Bill for temporary continuation of measurement" dataObjectRef="data_bill_measurement_do" />
    <bpmn:dataObject id="data_bill_measurement_do" />
    <bpmn:dataObjectReference id="data_bill_readings" name="Bill for additional readings" dataObjectRef="data_bill_readings_do" />
    <bpmn:dataObject id="data_bill_readings_do" />
    <bpmn:dataObjectReference id="data_bill_equipment" name="Bill for equipment acquisition" dataObjectRef="data_bill_equipment_do" />
    <bpmn:dataObject id="data_bill_equipment_do" />
    <bpmn:dataObjectReference id="data_decision" name="Payment advice or Rejection notice" dataObjectRef="data_decision_do" />
    <bpmn:dataObject id="data_decision_do" />
    <bpmn:startEvent id="evt_msg_mpoo_metering_to_go" name="Receive Metering Bill">
      <bpmn:incoming>flow_mpoo_start_to_msg</bpmn:incoming>
      <bpmn:outgoing>flow_go_msg_to_task_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_mpoo_metering_to_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_msg_mpoo_equipment_to_go" name="Receive Equipment Bill (GO)">
      <bpmn:incoming>flow_mpoo_start_equip_go_to_msg</bpmn:incoming>
      <bpmn:outgoing>flow_go_msg_to_task_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_mpoo_equipment_to_go_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_go_examined" name="End: GO Examined Bill">
      <bpmn:incoming>flow_go_task_1_to_end</bpmn:incoming>
      <bpmn:incoming>flow_go_task_2_to_end</bpmn:incoming>
      <bpmn:incoming>flow_go_task_3_to_end</bpmn:incoming>
      <bpmn:incoming>flow_mpoo_recv_confirm</bpmn:incoming>
      <bpmn:incoming>flow_mspon_recv_confirm</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_examine_go_1" name="Examine the bill (Metering)">
      <bpmn:incoming>flow_go_msg_to_task_1</bpmn:incoming>
      <bpmn:outgoing>flow_go_task_1_to_end</bpmn:outgoing>
      <bpmn:property id="task_examine_go_1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_go_1_dia0">
        <bpmn:sourceRef>data_bill_metering</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_go_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_examine_go_2" name="Examine the bill (Measurement)">
      <bpmn:incoming>flow_go_msg_to_task_2</bpmn:incoming>
      <bpmn:outgoing>flow_go_task_2_to_end</bpmn:outgoing>
      <bpmn:property id="task_examine_go_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_go_2_dia0">
        <bpmn:sourceRef>data_bill_measurement</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_go_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_examine_go_3" name="Examine the bill (Additional Readings)">
      <bpmn:incoming>flow_go_msg_to_task_3</bpmn:incoming>
      <bpmn:outgoing>flow_go_task_3_to_end</bpmn:outgoing>
      <bpmn:property id="task_examine_go_3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_go_3_dia0">
        <bpmn:sourceRef>data_bill_readings</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_go_3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_examine_go_4" name="Examine the bill (Equipment)">
      <bpmn:incoming>flow_go_msg_to_task_4</bpmn:incoming>
      <bpmn:outgoing>flow_go_task_4_to_decide</bpmn:outgoing>
      <bpmn:property id="task_examine_go_4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_go_4_dia0">
        <bpmn:sourceRef>data_bill_equipment</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_go_4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_decide_go" name="Confirm or Reject Invoice (GO)">
      <bpmn:incoming>flow_go_task_4_to_decide</bpmn:incoming>
      <bpmn:outgoing>flow_go_decide_to_gw</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_decide_go_doa0">
        <bpmn:targetRef>data_decision</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decide_go" name="Decision Gateway (GO)" isMarkerVisible="true">
      <bpmn:incoming>flow_go_decide_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_go_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_go_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_go_msg_to_task_1" sourceRef="evt_msg_mpoo_metering_to_go" targetRef="task_examine_go_1" />
    <bpmn:sequenceFlow id="flow_go_msg_to_task_4" sourceRef="evt_msg_mpoo_equipment_to_go" targetRef="task_examine_go_4" />
    <bpmn:sequenceFlow id="flow_go_task_1_to_end" sourceRef="task_examine_go_1" targetRef="evt_end_go_examined" />
    <bpmn:sequenceFlow id="flow_go_task_2_to_end" sourceRef="task_examine_go_2" targetRef="evt_end_go_examined" />
    <bpmn:sequenceFlow id="flow_go_task_3_to_end" sourceRef="task_examine_go_3" targetRef="evt_end_go_examined" />
    <bpmn:sequenceFlow id="flow_go_task_4_to_decide" sourceRef="task_examine_go_4" targetRef="task_decide_go" />
    <bpmn:sequenceFlow id="flow_go_decide_to_gw" sourceRef="task_decide_go" targetRef="gw_decide_go" />
  </bpmn:process>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_bill_equipment_p1" name="Bill for equipment acquisition" dataObjectRef="data_bill_equipment_p1_do" />
    <bpmn:dataObject id="data_bill_equipment_p1_do" />
    <bpmn:dataObjectReference id="data_decision_p1" name="Payment advice or Rejection notice" dataObjectRef="data_decision_p1_do" />
    <bpmn:dataObject id="data_decision_p1_do" />
    <bpmn:startEvent id="evt_msg_mpoo_equipment_to_mpon" name="Receive Equipment Bill (MPON)">
      <bpmn:incoming>flow_mpoo_start_equip_mpon_to_msg</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_msg_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_mpoo_equipment_to_mpon_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mpon_examined" name="End: MPON Examined Bill">
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_msg_confirm_to_mpoo" name="Send Confirmation to MPOO">
      <bpmn:incoming>flow_go_confirm</bpmn:incoming>
      <bpmn:incoming>flow_mpon_confirm</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_confirm_to_mpoo_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_msg_reject_to_mpoo" name="Send Rejection to MPOO">
      <bpmn:incoming>flow_go_reject</bpmn:incoming>
      <bpmn:incoming>flow_mpon_reject</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_reject_to_mpoo_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_examine_mpon" name="Examine the bill (Equipment)">
      <bpmn:incoming>flow_mpon_msg_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_task_to_decide</bpmn:outgoing>
      <bpmn:property id="task_examine_mpon_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_examine_mpon_dia0">
        <bpmn:sourceRef>data_bill_equipment_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_examine_mpon_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_decide_mpon" name="Confirm or Reject Invoice (MPON)">
      <bpmn:incoming>flow_mpon_task_to_decide</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_decide_to_gw</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_decide_mpon_doa0">
        <bpmn:targetRef>data_decision_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decide_mpon" name="Decision Gateway (MPON)" isMarkerVisible="true">
      <bpmn:incoming>flow_mpon_decide_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_mpon_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_mpon_msg_to_task" sourceRef="evt_msg_mpoo_equipment_to_mpon" targetRef="task_examine_mpon" />
    <bpmn:sequenceFlow id="flow_mpon_task_to_decide" sourceRef="task_examine_mpon" targetRef="task_decide_mpon" />
    <bpmn:sequenceFlow id="flow_mpon_decide_to_gw" sourceRef="task_decide_mpon" targetRef="gw_decide_mpon" />
    <bpmn:sequenceFlow id="flow_mpon_confirm" sourceRef="gw_decide_mpon" targetRef="evt_msg_confirm_to_mpoo" name="Confirm" />
    <bpmn:sequenceFlow id="flow_mpon_reject" sourceRef="gw_decide_mpon" targetRef="evt_msg_reject_to_mpoo" name="Reject" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpoo_part_di" bpmnElement="pool_mpoo_part" isHorizontal="true">
