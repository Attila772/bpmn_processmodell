{
  "name": "Job Vacancy Processing Process",
  "resources": [
    {
      "name": "HR Clerk",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "Department",
      "capacity": 1,
      "resource_type": "department"
    }
  ],
  "events": [
    {
      "id": "evt_start_vacancy_reported",
      "name": "Vacancy Reported",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Vacancy Report"
    },
    {
      "id": "evt_end_job_posted",
      "name": "Job Posted",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_msg_send_desc_for_approval",
      "name": "Send Job Description for Approval",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Job Description for Approval"
    },
    {
      "id": "evt_msg_receive_approval_decision",
      "name": "Receive Approval Decision",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Approval Decision"
    },
    {
      "id": "evt_msg_request_clarification",
