<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_police_report" name="Police Report" dataObjectRef="data_police_report_do" />
    <bpmn:dataObject id="data_police_report_do" />
    <bpmn:dataObjectReference id="data_claim_documentation" name="Claim Documentation" dataObjectRef="data_claim_documentation_do" />
    <bpmn:dataObject id="data_claim_documentation_do" />
    <bpmn:dataObjectReference id="data_claim_file" name="File (Police Report + Claim Documentation)" dataObjectRef="data_claim_file_do" />
    <bpmn:dataObject id="data_claim_file_do" />
    <bpmn:dataObjectReference id="data_claim_estimate" name="Initial Claim Estimate" dataObjectRef="data_claim_estimate_do" />
    <bpmn:dataObject id="data_claim_estimate_do" />
    <bpmn:dataObjectReference id="data_action_plan_checklist" name="Action Plan Checklist" dataObjectRef="data_action_plan_checklist_do" />
    <bpmn:dataObject id="data_action_plan_checklist_do" />
    <bpmn:dataObjectReference id="data_action_plan" name="Action Plan" dataObjectRef="data_action_plan_do" />
    <bpmn:dataObject id="data_action_plan_do" />
    <bpmn:dataObjectReference id="data_settlement_outcome" name="Settlement Outcome" dataObjectRef="data_settlement_outcome_do" />
    <bpmn:dataObject id="data_settlement_outcome_do" />
    <bpmn:startEvent id="evt_start" name="Start Process">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end" name="Process Ended">
      <bpmn:incoming>flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_search_report" name="Search Police Report in Database">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_search_report_doa0">
        <bpmn:targetRef>data_police_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_create_file" name="Create File with Claim Documentation">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_create_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_file_dia0">
        <bpmn:sourceRef>data_police_report</bpmn:sourceRef>
        <bpmn:targetRef>task_create_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_create_file_dia1">
        <bpmn:sourceRef>data_claim_documentation</bpmn:sourceRef>
        <bpmn:targetRef>task_create_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_file_doa0">
        <bpmn:targetRef>data_claim_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_calculate_estimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_calculate_estimate_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_calculate_estimate_dia0">
        <bpmn:sourceRef>data_claim_file</bpmn:sourceRef>
        <bpmn:targetRef>task_calculate_estimate_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_calculate_estimate_doa0">
        <bpmn:targetRef>data_claim_estimate</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_retrieve_checklist" name="Retrieve Action Plan Checklist">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_retrieve_checklist_doa0">
        <bpmn:targetRef>data_action_plan_checklist</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_create_action_plan" name="Create Action Plan">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_create_action_plan_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_action_plan_dia0">
        <bpmn:sourceRef>data_action_plan_checklist</bpmn:sourceRef>
        <bpmn:targetRef>task_create_action_plan_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_action_plan_doa0">
        <bpmn:targetRef>data_action_plan</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_negotiate_settlement" name="Negotiate Settlement on Claim Estimate">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:property id="task_negotiate_settlement_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_negotiate_settlement_dia0">
        <bpmn:sourceRef>data_action_plan</bpmn:sourceRef>
        <bpmn:targetRef>task_negotiate_settlement_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_negotiate_settlement_dia1">
        <bpmn:sourceRef>data_claim_estimate</bpmn:sourceRef>
        <bpmn:targetRef>task_negotiate_settlement_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_negotiate_settlement_doa0">
        <bpmn:targetRef>data_settlement_outcome</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_inform_claimant" name="Inform Claimant of Outcome">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:property id="task_inform_claimant_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_inform_claimant_dia0">
        <bpmn:sourceRef>data_settlement_outcome</bpmn:sourceRef>
        <bpmn:targetRef>task_inform_claimant_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start" targetRef="task_search_report" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_search_report" targetRef="task_create_file" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_create_file" targetRef="task_calculate_estimate" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_calculate_estimate" targetRef="task_retrieve_checklist" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_retrieve_checklist" targetRef="task_create_action_plan" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_create_action_plan" targetRef="task_negotiate_settlement" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_negotiate_settlement" targetRef="task_inform_claimant" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_inform_claimant" targetRef="evt_end" />
  </bpmn:process>
