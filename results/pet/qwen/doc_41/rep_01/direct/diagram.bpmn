<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="CarAccidentClaimProcess" name="Car Accident Claim Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Car Accident Reported">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SearchPoliceReport" name="Search Police Report in Database">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataObjectReference id="DataRef_PoliceReport" dataObjectRef="DataObject_PoliceReport"/>
    </bpmn:task>
    <bpmn:task id="Task_CreateFile" name="Create File with Claim Documentation">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataInputAssociation id="Assoc_Input_ClaimDoc">
        <bpmn:sourceRef>DataObject_ClaimDocumentation</bpmn:sourceRef>
        <bpmn:targetRef>DataObject_CombinedFile</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Assoc_Input_PoliceReport">
        <bpmn:sourceRef>DataObject_PoliceReport</bpmn:sourceRef>
        <bpmn:targetRef>DataObject_CombinedFile</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_CalculateEstimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:dataInputAssociation id="Assoc_Input_File">
        <bpmn:sourceRef>DataObject_CombinedFile</bpmn:sourceRef>
        <bpmn:targetRef>DataObject_ClaimEstimate</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_RetrieveChecklist" name="Retrieve Action Plan Checklist">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_Output_Checklist">
        <bpmn:sourceRef>DataObject_ActionPlanChecklist</bpmn:sourceRef>
        <bpmn:targetRef>DataObject_ActionPlan</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:dataInputAssociation id="Assoc_Input_ChecklistToPlan">
        <bpmn:sourceRef>DataObject_ActionPlanChecklist</bpmn:sourceRef>
        <bpmn:targetRef>DataObject_ActionPlan</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Settlement">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:dataInputAssociation id="Assoc_Input_Estimate">
        <bpmn:sourceRef>DataObject_ClaimEstimate</bpmn:sourceRef>
        <bpmn:targetRef>DataObject_SettlementOutcome</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Assoc_Input_ActionPlan">
        <bpmn:sourceRef>DataObject_ActionPlan</bpmn:sourceRef>
        <bpmn:targetRef>DataObject_SettlementOutcome</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_InformClaimant" name="Inform Claimant of Outcome">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:dataInputAssociation id="Assoc_Input_Outcome">
        <bpmn:sourceRef>DataObject_SettlementOutcome</bpmn:sourceRef>
        <bpmn:targetRef>DataObject_Notification</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Process Ended">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SearchPoliceReport"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SearchPoliceReport" targetRef="Task_CreateFile"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CreateFile" targetRef="Task_CalculateEstimate"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CalculateEstimate" targetRef="Task_RetrieveChecklist"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RetrieveChecklist" targetRef="Task_CreateActionPlan"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_NegotiateSettlement" targetRef="Task_InformClaimant"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_InformClaimant" targetRef="EndEvent_1"/>
    
    <!-- Data Objects -->
    <bpmn:dataObject id="DataObject_PoliceReport" name="Police Report"/>
    <bpmn:dataObject id="DataObject_ClaimDocumentation" name="Claim Documentation"/>
    <bpmn:dataObject id="DataObject_CombinedFile" name="Combined File (Police Report + Claim Doc)"/>
    <bpmn:dataObject id="DataObject_ClaimEstimate" name="Initial Claim Estimate"/>
    <bpmn:dataObject id="DataObject_ActionPlanChecklist" name="Action Plan Checklist"/>
    <bpmn:dataObject id="DataObject_ActionPlan" name="Action Plan"/>
    <bpmn:dataObject id="DataObject_SettlementOutcome" name="Settlement Outcome"/>
    <bpmn:dataObject id="DataObject_Notification" name="Notification to Claimant"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="CarAccidentClaimProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="139" y="145" width="62" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SearchPoliceReport_di" bpmnElement="Task_SearchPoliceReport">
        <dc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateFile_di" bpmnElement="Task_CreateFile">
        <dc:Bounds x="380" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalculateEstimate_di" bpmnElement="Task_CalculateEstimate">
        <dc:Bounds x="520" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetrieveChecklist_di" bpmnElement="Task_RetrieveChecklist">
        <dc:Bounds x="660" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateActionPlan_di" bpmnElement="Task_CreateActionPlan">
        <dc:Bounds x="800" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NegotiateSettlement_di" bpmnElement="Task_NegotiateSettlement">
        <dc:Bounds x="940" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformClaimant_di" bpmnElement="Task_InformClaimant">
        <dc:Bounds x="1080" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1222" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1213" y="145" width="54" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120"/>
        <di:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120"/>
        <di:waypoint x="380" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="480" y="120"/>
        <di:waypoint x="520" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="620" y="120"/>
        <di:waypoint x="660" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="760" y="120"/>
        <di:waypoint x="800" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="900" y="120"/>
        <di:waypoint x="940" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1040" y="120"/>
        <di:waypoint x="1080" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1180" y="120"/>
        <di:waypoint x="1222" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>