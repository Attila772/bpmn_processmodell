<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_secretariat_part" name="Secretarial Office" processRef="pool_secretariat_proc" />
    <bpmn:participant id="pool_nursing_part" name="Nursing Officer" processRef="pool_nursing_proc" />
    <bpmn:participant id="pool_medical_team_part" name="Medical Team" processRef="pool_medical_team_proc" />
    <bpmn:participant id="pool_first_intaker_part" name="First Intaker (Social-Medical Worker)" processRef="pool_first_intaker_proc" />
    <bpmn:participant id="pool_second_intaker_part" name="Second Intaker (Physician)" processRef="pool_second_intaker_proc" />
    <bpmn:participant id="pool_family_doctor_part" name="Family Doctor" processRef="pool_family_doctor_proc" />
    <bpmn:participant id="pool_end_event_part" name="Process End" processRef="pool_end_event_proc" />
    <bpmn:messageFlow id="msg_1" sourceRef="evt_end_secretary_handover" targetRef="evt_start_nursing_inquiry" name="Patient Details for Inquiry" />
    <bpmn:messageFlow id="msg_2" sourceRef="evt_end_form_return" targetRef="evt_start_form_processing" name="Completed Registration Form" />
    <bpmn:messageFlow id="msg_3" sourceRef="evt_end_assignment_handover" targetRef="evt_start_assignment_processing" name="Assignment List" />
    <bpmn:messageFlow id="msg_4" sourceRef="evt_end_card_distribution" targetRef="evt_start_first_intaker" name="Registration Cards" />
    <bpmn:messageFlow id="msg_5" sourceRef="evt_end_card_distribution" targetRef="evt_start_second_intaker" name="Registration Cards" />
    <bpmn:messageFlow id="msg_6" sourceRef="evt_end_medical_file_request" targetRef="evt_start_family_doctor_response" name="Medical File Request Letter" />
    <bpmn:messageFlow id="msg_7" sourceRef="evt_end_medical_file_receipt" targetRef="evt_start_secretary_file_update" name="Medical File Copy" />
    <bpmn:messageFlow id="msg_8" sourceRef="evt_end_notes_submission" targetRef="evt_start_secretary_notes_filing" name="First Intaker Notes &amp; Checklist" />
    <bpmn:messageFlow id="msg_9" sourceRef="evt_end_physician_tape_submission" targetRef="evt_start_secretary_typing" name="Dictaphone Tape" />
    <bpmn:messageFlow id="msg_yes_medical_file" sourceRef="gw_medical_file_needed" targetRef="task_prepare_medical_file_letter" name="Yes" />
    <bpmn:messageFlow id="msg_no_medical_file" sourceRef="gw_medical_file_needed" targetRef="task_store_assignment_in_system" name="No" />
    <bpmn:messageFlow id="msg_status_list" sourceRef="evt_end_status_list_submission" targetRef="evt_start_treatment_planning" name="List of Patients Reaching Status" />
  </bpmn:collaboration>
  <bpmn:process id="pool_secretariat_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_registration_form_p1" name="Registration Form" dataObjectRef="data_registration_form_p1_do" />
    <bpmn:dataObject id="data_registration_form_p1_do" />
    <bpmn:dataObjectReference id="data_system_printout" name="Print from Information System" dataObjectRef="data_system_printout_do" />
    <bpmn:dataObject id="data_system_printout_do" />
    <bpmn:dataObjectReference id="data_patient_file" name="Patient File" dataObjectRef="data_patient_file_do" />
    <bpmn:dataObject id="data_patient_file_do" />
    <bpmn:dataObjectReference id="data_registration_card" name="Registration Card" dataObjectRef="data_registration_card_do" />
    <bpmn:dataObject id="data_registration_card_do" />
    <bpmn:dataObjectReference id="data_new_notices_list" name="List of New Notices" dataObjectRef="data_new_notices_list_do" />
    <bpmn:dataObject id="data_new_notices_list_do" />
    <bpmn:dataObjectReference id="data_assignment_list_p1" name="Assignment List" dataObjectRef="data_assignment_list_p1_do" />
    <bpmn:dataObject id="data_assignment_list_p1_do" />
    <bpmn:dataObjectReference id="data_medical_file_request_letter" name="Medical File Request Letter" dataObjectRef="data_medical_file_request_letter_do" />
    <bpmn:dataObject id="data_medical_file_request_letter_do" />
    <bpmn:dataObjectReference id="data_medical_file_copy_p1" name="Medical File Copy" dataObjectRef="data_medical_file_copy_p1_do" />
    <bpmn:dataObject id="data_medical_file_copy_p1_do" />
    <bpmn:dataObjectReference id="data_dictaphone_tape_p1" name="Dictaphone Tape" dataObjectRef="data_dictaphone_tape_p1_do" />
    <bpmn:dataObject id="data_dictaphone_tape_p1_do" />
    <bpmn:dataObjectReference id="data_typed_observations" name="Typed Observations" dataObjectRef="data_typed_observations_do" />
    <bpmn:dataObject id="data_typed_observations_do" />
    <bpmn:dataObjectReference id="data_completed_intake_list" name="List of Patients Reaching Status" dataObjectRef="data_completed_intake_list_do" />
    <bpmn:dataObject id="data_completed_intake_list_do" />
    <bpmn:startEvent id="evt_start_notice" name="Notice by Telephone">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_notice_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_secretary_handover" name="Handover to Nursing Officer">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_secretary_handover_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_form_processing" name="Receive Registration Form">
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_form_processing_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_assignment_handover" name="Handover Assignment List">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_assignment_handover_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_assignment_processing" name="Receive Assignment List">
      <bpmn:outgoing>flow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_assignment_processing_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_card_distribution" name="Distribute Registration Cards">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_card_distribution_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_medical_file_request" name="Send Medical File Request">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_medical_file_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_secretary_file_update" name="Receive Medical File Copy">
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_file_update_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_secretary_notes_filing" name="Receive First Intaker Notes">
      <bpmn:outgoing>flow_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_notes_filing_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_secretary_typing" name="Receive Dictaphone Tape">
      <bpmn:outgoing>flow_28</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_typing_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_status_list_submission" name="Submit Status List to Team Leader">
      <bpmn:incoming>flow_31</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_status_list_submission_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_inquire_patient_details" name="Inquire Name and Residence">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_store_and_print_info" name="Store Info in System and Print">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_store_and_print_info_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_and_print_info_dia0">
        <bpmn:sourceRef>data_registration_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_and_print_info_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_and_print_info_doa0">
        <bpmn:targetRef>data_system_printout</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_create_patient_file" name="Create Patient File and Store Documents">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:property id="task_create_patient_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_patient_file_dia0">
        <bpmn:sourceRef>data_registration_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_create_patient_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_create_patient_file_dia1">
        <bpmn:sourceRef>data_system_printout</bpmn:sourceRef>
        <bpmn:targetRef>task_create_patient_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_patient_file_doa0">
        <bpmn:targetRef>data_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_produce_registration_cards" name="Produce Registration Cards">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:property id="task_produce_registration_cards_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_produce_registration_cards_dia0">
        <bpmn:sourceRef>data_patient_file</bpmn:sourceRef>
        <bpmn:targetRef>task_produce_registration_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_produce_registration_cards_doa0">
        <bpmn:targetRef>data_registration_card</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_add_to_new_notices_list" name="Add to List of New Notices">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_add_to_new_notices_list_doa0">
        <bpmn:targetRef>data_new_notices_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_store_assignment_in_system" name="Store Assignment in Information System">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
      <bpmn:property id="task_store_assignment_in_system_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_assignment_in_system_dia0">
        <bpmn:sourceRef>data_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_assignment_in_system_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_prepare_medical_file_letter" name="Prepare and Send Medical File Request Letter">
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:property id="task_prepare_medical_file_letter_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prepare_medical_file_letter_dia0">
        <bpmn:sourceRef>data_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_prepare_medical_file_letter_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_prepare_medical_file_letter_doa0">
        <bpmn:targetRef>data_medical_file_request_letter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_update_patient_file_with_medical_copy" name="Inform Second Intaker and Add Copy to File">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
      <bpmn:property id="task_update_patient_file_with_medical_copy_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_update_patient_file_with_medical_copy_dia0">
        <bpmn:sourceRef>data_medical_file_copy_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_update_patient_file_with_medical_copy_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_update_patient_file_with_medical_copy_doa0">
        <bpmn:targetRef>data_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_type_out_tapes" name="Type Out Dictaphone Tapes">
      <bpmn:incoming>flow_28</bpmn:incoming>
      <bpmn:outgoing>flow_29</bpmn:outgoing>
      <bpmn:property id="task_type_out_tapes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_type_out_tapes_dia0">
        <bpmn:sourceRef>data_dictaphone_tape_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_type_out_tapes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_type_out_tapes_doa0">
        <bpmn:targetRef>data_typed_observations</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_add_typed_obs_to_file" name="Add Typed Observations to Patient File">
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:incoming>flow_29</bpmn:incoming>
      <bpmn:outgoing>flow_24</bpmn:outgoing>
      <bpmn:property id="task_add_typed_obs_to_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_add_typed_obs_to_file_dia0">
        <bpmn:sourceRef>data_typed_observations</bpmn:sourceRef>
        <bpmn:targetRef>task_add_typed_obs_to_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_add_typed_obs_to_file_doa0">
        <bpmn:targetRef>data_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_update_status_list" name="Update List of Patients Reaching Status">
      <bpmn:incoming>flow_30</bpmn:incoming>
      <bpmn:outgoing>flow_31</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_update_status_list_doa0">
        <bpmn:targetRef>data_completed_intake_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gw_both_meetings_done" name="Are Both Meetings Done?">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:incoming>flow_24</bpmn:incoming>
      <bpmn:outgoing>flow_30</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_notice" targetRef="task_inquire_patient_details" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_inquire_patient_details" targetRef="evt_end_secretary_handover" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="evt_start_form_processing" targetRef="task_store_and_print_info" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_store_and_print_info" targetRef="task_create_patient_file" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_create_patient_file" targetRef="task_produce_registration_cards" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_produce_registration_cards" targetRef="task_add_to_new_notices_list" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_add_to_new_notices_list" targetRef="evt_end_assignment_handover" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="task_prepare_medical_file_letter" targetRef="evt_end_medical_file_request" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="evt_start_secretary_file_update" targetRef="task_update_patient_file_with_medical_copy" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="task_update_patient_file_with_medical_copy" targetRef="gw_both_meetings_done" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="task_store_assignment_in_system" targetRef="evt_end_card_distribution" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="evt_start_assignment_processing" targetRef="task_store_assignment_in_system" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="evt_start_secretary_notes_filing" targetRef="task_add_typed_obs_to_file" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="task_add_typed_obs_to_file" targetRef="gw_both_meetings_done" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="evt_start_secretary_typing" targetRef="task_type_out_tapes" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="task_type_out_tapes" targetRef="task_add_typed_obs_to_file" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="gw_both_meetings_done" targetRef="task_update_status_list" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="task_update_status_list" targetRef="evt_end_status_list_submission" />
  </bpmn:process>
  <bpmn:process id="pool_nursing_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_registration_form" name="Registration Form" dataObjectRef="data_registration_form_do" />
    <bpmn:dataObject id="data_registration_form_do" />
    <bpmn:startEvent id="evt_start_nursing_inquiry" name="Receive Patient Details">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_nursing_inquiry_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_form_return" name="Return Registration Form">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_form_return_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_conduct_full_inquiry" name="Conduct Full Mental/Health/Social Inquiry">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_conduct_full_inquiry_doa0">
        <bpmn:targetRef>data_registration_form</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_3" sourceRef="evt_start_nursing_inquiry" targetRef="task_conduct_full_inquiry" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_conduct_full_inquiry" targetRef="evt_end_form_return" />
  </bpmn:process>
  <bpmn:process id="pool_medical_team_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_new_notices_list_p1" name="List of New Notices" dataObjectRef="data_new_notices_list_p1_do" />
    <bpmn:dataObject id="data_new_notices_list_p1_do" />
    <bpmn:dataObjectReference id="data_assignment_list" name="Assignment List" dataObjectRef="data_assignment_list_do" />
    <bpmn:dataObject id="data_assignment_list_do" />
    <bpmn:dataObjectReference id="data_completed_intake_list_p1" name="List of Patients Reaching Status" dataObjectRef="data_completed_intake_list_p1_do" />
    <bpmn:dataObject id="data_completed_intake_list_p1_do" />
    <bpmn:dataObjectReference id="data_patient_file_p1" name="Patient File" dataObjectRef="data_patient_file_p1_do" />
    <bpmn:dataObject id="data_patient_file_p1_do" />
    <bpmn:dataObjectReference id="data_treatment_plan" name="Treatment Plan" dataObjectRef="data_treatment_plan_do" />
    <bpmn:dataObject id="data_treatment_plan_do" />
    <bpmn:startEvent id="evt_start_treatment_planning" name="Receive Status List">
      <bpmn:outgoing>flow_32</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_treatment_planning_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_assign_intakers" name="Assign Intakers at Staff Meeting">
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:property id="task_assign_intakers_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_assign_intakers_dia0">
        <bpmn:sourceRef>data_new_notices_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_assign_intakers_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_assign_intakers_doa0">
        <bpmn:targetRef>data_assignment_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_determine_medical_file_need" name="Determine if Medical File Required">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:property id="task_determine_medical_file_need_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_determine_medical_file_need_dia0">
        <bpmn:sourceRef>data_assignment_list</bpmn:sourceRef>
        <bpmn:targetRef>task_determine_medical_file_need_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_determine_medical_file_need_doa0">
        <bpmn:targetRef>data_assignment_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_formulate_treatment_plan" name="Formulate Treatment Plan">
      <bpmn:incoming>flow_32</bpmn:incoming>
      <bpmn:outgoing>flow_33</bpmn:outgoing>
      <bpmn:property id="task_formulate_treatment_plan_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_formulate_treatment_plan_dia0">
        <bpmn:sourceRef>data_completed_intake_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_formulate_treatment_plan_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
