<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_secretariat_part" name="Secretarial Office" processRef="pool_secretariat_proc" />
    <bpmn:participant id="pool_nursing_part" name="Nursing Officer" processRef="pool_nursing_proc" />
    <bpmn:participant id="pool_team_leader_part" name="Team Leader / Staff Meeting" processRef="pool_team_leader_proc" />
    <bpmn:participant id="pool_first_intaker_part" name="First Intaker (Social-Medical Worker)" processRef="pool_first_intaker_proc" />
    <bpmn:participant id="pool_second_intaker_part" name="Second Intaker (Physician)" processRef="pool_second_intaker_proc" />
    <bpmn:participant id="pool_family_doctor_part" name="Family Doctor" processRef="pool_family_doctor_proc" />
    <bpmn:messageFlow id="msg_1" sourceRef="evt_end_secretary_inquiry" targetRef="evt_start_nursing_inquiry" name="Patient Details for Routing" />
    <bpmn:messageFlow id="msg_2" sourceRef="evt_end_nursing_form" targetRef="evt_start_secretary_processing" name="Completed Registration Form" />
    <bpmn:messageFlow id="msg_3" sourceRef="evt_end_assignment_list" targetRef="evt_start_secretary_assignment" name="Assignment List" />
    <bpmn:messageFlow id="msg_4" sourceRef="evt_end_cards_to_intakers" targetRef="evt_start_first_intaker" name="Registration Cards" />
    <bpmn:messageFlow id="msg_5" sourceRef="evt_end_cards_to_intakers" targetRef="evt_start_second_intaker" name="Registration Cards" />
    <bpmn:messageFlow id="msg_6" sourceRef="evt_end_medical_file_request" targetRef="evt_start_family_doctor_response" name="Request for Medical File" />
    <bpmn:messageFlow id="msg_7" sourceRef="evt_end_medical_file_copy" targetRef="evt_start_secretary_file_update" name="Medical File Copy" />
    <bpmn:messageFlow id="msg_8" sourceRef="evt_end_notify_second_intaker" targetRef="evt_start_second_intaker_ready" name="File Available Notification" />
    <bpmn:messageFlow id="msg_9" sourceRef="evt_end_first_visit_notes" targetRef="evt_start_secretary_file_add_1" name="First Visit Documentation" />
    <bpmn:messageFlow id="msg_10" sourceRef="evt_end_second_visit_notes" targetRef="evt_start_secretary_typing" name="Second Visit Dictaphone Tape" />
    <bpmn:messageFlow id="msg_11" sourceRef="evt_end_typed_notes" targetRef="evt_start_secretary_file_add_2" name="Typed Physician Notes" />
  </bpmn:collaboration>
  <bpmn:process id="pool_secretariat_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_reg_form_p1" name="Registration Form" dataObjectRef="data_reg_form_p1_do" />
    <bpmn:dataObject id="data_reg_form_p1_do" />
    <bpmn:dataObjectReference id="data_printout" name="Print from Information System" dataObjectRef="data_printout_do" />
    <bpmn:dataObject id="data_printout_do" />
    <bpmn:dataObjectReference id="data_patient_file" name="Patient File" dataObjectRef="data_patient_file_do" />
    <bpmn:dataObject id="data_patient_file_do" />
    <bpmn:dataObjectReference id="data_reg_card" name="Registration Card" dataObjectRef="data_reg_card_do" />
    <bpmn:dataObject id="data_reg_card_do" />
    <bpmn:dataObjectReference id="data_new_notices_list" name="List of New Notices" dataObjectRef="data_new_notices_list_do" />
    <bpmn:dataObject id="data_new_notices_list_do" />
    <bpmn:dataObjectReference id="data_assignment_list_p1" name="Assignment List" dataObjectRef="data_assignment_list_p1_do" />
    <bpmn:dataObject id="data_assignment_list_p1_do" />
    <bpmn:dataObjectReference id="data_medical_file_copy_p1" name="Medical File Copy" dataObjectRef="data_medical_file_copy_p1_do" />
    <bpmn:dataObject id="data_medical_file_copy_p1_do" />
    <bpmn:dataObjectReference id="data_dictaphone_tape_p1" name="Dictaphone Tape" dataObjectRef="data_dictaphone_tape_p1_do" />
    <bpmn:dataObject id="data_dictaphone_tape_p1_do" />
    <bpmn:dataObjectReference id="data_typed_notes" name="Typed Physician Notes" dataObjectRef="data_typed_notes_do" />
    <bpmn:dataObject id="data_typed_notes_do" />
    <bpmn:dataObjectReference id="data_status_list" name="List of Patients Reaching Status" dataObjectRef="data_status_list_do" />
    <bpmn:dataObject id="data_status_list_do" />
    <bpmn:startEvent id="evt_start_notice" name="Notice by Telephone">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_notice_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_secretary_inquiry" name="Inquiry Completed">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_secretary_inquiry_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_secretary_processing" name="Receive Registration Form">
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_processing_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_assignment_list" name="Assignment List Ready">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_assignment_list_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_secretary_assignment" name="Receive Assignment List">
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_assignment_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_cards_to_intakers" name="Cards Sent to Intakers">
      <bpmn:incoming>flow_22</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_cards_to_intakers_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_medical_file_request" name="Medical File Request Sent">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_medical_file_request_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_secretary_file_update" name="Receive Medical File Copy">
      <bpmn:outgoing>flow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_file_update_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_notify_second_intaker" name="Notify Second Intaker">
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_notify_second_intaker_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_secretary_file_add_1" name="Receive First Visit Docs">
      <bpmn:outgoing>flow_35</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_file_add_1_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_secretary_typing" name="Receive Dictaphone Tape">
      <bpmn:outgoing>flow_31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_typing_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_typed_notes" name="Typed Notes Ready">
      <bpmn:incoming>flow_32</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_typed_notes_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_secretary_file_add_2" name="Receive Typed Notes">
      <bpmn:outgoing>flow_33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_secretary_file_add_2_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_status_update" name="Status Updated in System">
      <bpmn:incoming>flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_inquire_details" name="Inquire Name and Residence">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_route_call" name="Put Through to Nursing Officer">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_store_info_system" name="Store Information in Information System">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:property id="task_store_info_system_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_info_system_dia0">
        <bpmn:sourceRef>data_reg_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_info_system_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_store_info_system_doa0">
        <bpmn:targetRef>data_printout</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_create_patient_file" name="Create Patient File">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:property id="task_create_patient_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_patient_file_dia0">
        <bpmn:sourceRef>data_reg_form_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_create_patient_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_create_patient_file_dia1">
        <bpmn:sourceRef>data_printout</bpmn:sourceRef>
        <bpmn:targetRef>task_create_patient_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_patient_file_doa0">
        <bpmn:targetRef>data_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_produce_registration_cards" name="Produce Two Registration Cards">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_produce_registration_cards_doa0">
        <bpmn:targetRef>data_reg_card</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_add_to_new_notices_list" name="Add to List of New Notices">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_add_to_new_notices_list_doa0">
        <bpmn:targetRef>data_new_notices_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_store_assignment" name="Store Assignment in Information System">
      <bpmn:incoming>flow_req_no</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
      <bpmn:property id="task_store_assignment_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_store_assignment_dia0">
        <bpmn:sourceRef>data_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_store_assignment_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_pass_registration_cards" name="Pass Registration Cards to Intakers">
      <bpmn:incoming>flow_21</bpmn:incoming>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
      <bpmn:property id="task_pass_registration_cards_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_pass_registration_cards_dia0">
        <bpmn:sourceRef>data_reg_card</bpmn:sourceRef>
        <bpmn:targetRef>task_pass_registration_cards_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_send_medical_file_request" name="Prepare and Send Letter to Family Doctor">
      <bpmn:incoming>flow_req_yes</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:property id="task_send_medical_file_request_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_medical_file_request_dia0">
        <bpmn:sourceRef>data_assignment_list_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_send_medical_file_request_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_add_copy_to_file" name="Add Copy to Patient File">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
      <bpmn:property id="task_add_copy_to_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_add_copy_to_file_dia0">
        <bpmn:sourceRef>data_medical_file_copy_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_add_copy_to_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_add_copy_to_file_doa0">
        <bpmn:targetRef>data_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_notify_second_intaker" name="Inform Second Intaker">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_type_tapes" name="Type Out Dictaphone Tapes">
      <bpmn:incoming>flow_31</bpmn:incoming>
      <bpmn:outgoing>flow_32</bpmn:outgoing>
      <bpmn:property id="task_type_tapes_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_type_tapes_dia0">
        <bpmn:sourceRef>data_dictaphone_tape_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_type_tapes_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_type_tapes_doa0">
        <bpmn:targetRef>data_typed_notes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_add_typed_notes_to_file" name="Add Typed Information to Patient File">
      <bpmn:incoming>flow_33</bpmn:incoming>
      <bpmn:outgoing>flow_34</bpmn:outgoing>
      <bpmn:property id="task_add_typed_notes_to_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_add_typed_notes_to_file_dia0">
        <bpmn:sourceRef>data_typed_notes</bpmn:sourceRef>
        <bpmn:targetRef>task_add_typed_notes_to_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_add_typed_notes_to_file_doa0">
        <bpmn:targetRef>data_patient_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_update_status_list" name="Put Patient on Status List">
      <bpmn:incoming>flow_36</bpmn:incoming>
      <bpmn:outgoing>flow_37</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_update_status_list_doa0">
        <bpmn:targetRef>data_status_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_provide_list_to_leader" name="Provide List to Team Leader">
      <bpmn:incoming>flow_38</bpmn:incoming>
      <bpmn:outgoing>flow_39</bpmn:outgoing>
      <bpmn:property id="task_provide_list_to_leader_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_provide_list_to_leader_dia0">
        <bpmn:sourceRef>data_status_list</bpmn:sourceRef>
        <bpmn:targetRef>task_provide_list_to_leader_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="gw_both_visits_done" name="Are Both Visits Completed?">
      <bpmn:incoming>flow_34</bpmn:incoming>
      <bpmn:incoming>flow_35</bpmn:incoming>
      <bpmn:outgoing>flow_36</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_notice" targetRef="task_inquire_details" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_inquire_details" targetRef="task_route_call" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_route_call" targetRef="evt_end_secretary_inquiry" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="evt_start_secretary_processing" targetRef="task_store_info_system" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_store_info_system" targetRef="task_create_patient_file" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_create_patient_file" targetRef="task_produce_registration_cards" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_produce_registration_cards" targetRef="task_add_to_new_notices_list" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_add_to_new_notices_list" targetRef="evt_end_assignment_list" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="task_send_medical_file_request" targetRef="evt_end_medical_file_request" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="evt_start_secretary_file_update" targetRef="task_add_copy_to_file" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="task_add_copy_to_file" targetRef="task_notify_second_intaker" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="task_notify_second_intaker" targetRef="evt_end_notify_second_intaker" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="task_store_assignment" targetRef="task_pass_registration_cards" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="task_pass_registration_cards" targetRef="evt_end_cards_to_intakers" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="evt_start_secretary_typing" targetRef="task_type_tapes" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="task_type_tapes" targetRef="evt_end_typed_notes" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="evt_start_secretary_file_add_2" targetRef="task_add_typed_notes_to_file" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="task_add_typed_notes_to_file" targetRef="gw_both_visits_done" />
    <bpmn:sequenceFlow id="flow_35" sourceRef="evt_start_secretary_file_add_1" targetRef="gw_both_visits_done" />
    <bpmn:sequenceFlow id="flow_36" sourceRef="gw_both_visits_done" targetRef="task_update_status_list" />
    <bpmn:sequenceFlow id="flow_37" sourceRef="task_update_status_list" targetRef="evt_end_status_update" />
  </bpmn:process>
  <bpmn:process id="pool_nursing_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_reg_form" name="Registration Form" dataObjectRef="data_reg_form_do" />
    <bpmn:dataObject id="data_reg_form_do" />
    <bpmn:startEvent id="evt_start_nursing_inquiry" name="Start Nursing Inquiry">
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_nursing_inquiry_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_nursing_form" name="Registration Form Ready">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_nursing_form_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_nursing_inquiry" name="Full Inquiry into Mental/Health/Social State">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_nursing_inquiry_doa0">
        <bpmn:targetRef>data_reg_form</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_record_form" name="Record Information on Registration Form">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_record_form_doa0">
        <bpmn:targetRef>data_reg_form</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow_4" sourceRef="evt_start_nursing_inquiry" targetRef="task_nursing_inquiry" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_nursing_inquiry" targetRef="task_record_form" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_record_form" targetRef="evt_end_nursing_form" />
  </bpmn:process>
  <bpmn:process id="pool_team_leader_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_new_notices_list_p1" name="List of New Notices" dataObjectRef="data_new_notices_list_p1_do" />
    <bpmn:dataObject id="data_new_notices_list_p1_do" />
    <bpmn:dataObjectReference id="data_assignment_list" name="Assignment List" dataObjectRef="data_assignment_list_do" />
    <bpmn:dataObject id="data_assignment_list_do" />
    <bpmn:dataObjectReference id="data_status_list_p1" name="List of Patients Reaching Status" dataObjectRef="data_status_list_p1_do" />
    <bpmn:dataObject id="data_status_list_p1_do" />
    <bpmn:dataObjectReference id="data_treatment_plan" name="Treatment Plan" dataObjectRef="data_treatment_plan_do" />
    <bpmn:dataObject id="data_treatment_plan_do" />
    <bpmn:startEvent id="evt_start_staff_meeting" name="Staff Meeting Start">
      <bpmn:outgoing>flow_38</bpmn:outgoing>
      <bpmn:timerEventDefinition id="evt_start_staff_meeting_timerdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_treatment_plan" name="Treatment Plan Formulated">
      <bpmn:incoming>flow_40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_assign_patients" name="Assign Patients to Team Members">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
