<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="IntakeWorkflow" name="Mental Health Care Intake Workflow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Notice by Telephone">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_InquirePatientInfo" />
    <bpmn:userTask id="Task_InquirePatientInfo" name="Inquire Name and Residence">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_InquirePatientInfo" targetRef="Task_ConnectToNursingOfficer" />
    <bpmn:userTask id="Task_ConnectToNursingOfficer" name="Connect to Nursing Officer">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ConnectToNursingOfficer" targetRef="Task_FullInquiry" />
    <bpmn:userTask id="Task_FullInquiry" name="Full Inquiry into Mental, Health, Social State">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_FullInquiry" targetRef="Task_RecordOnForm" />
    <bpmn:userTask id="Task_RecordOnForm" name="Record Information on Registration Form">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RecordOnForm" targetRef="Task_HandInForm" />
    <bpmn:userTask id="Task_HandInForm" name="Hand In Form at Secretarial Office">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_HandInForm" targetRef="Task_StoreInIS" />
    <bpmn:userTask id="Task_StoreInIS" name="Store Info in Information System">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_StoreInIS" targetRef="Task_PrintInfo" />
    <bpmn:userTask id="Task_PrintInfo" name="Print Information from IS">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_PrintInfo" targetRef="Task_CreatePatientFile" />
    <bpmn:userTask id="Task_CreatePatientFile" name="Create Patient File (New Patients)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_CreatePatientFile" targetRef="Task_StoreDocsInFile" />
    <bpmn:userTask id="Task_StoreDocsInFile" name="Store Form and Print in Patient File">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_StoreDocsInFile" targetRef="Task_ProduceRegistrationCards" />
    <bpmn:userTask id="Task_ProduceRegistrationCards" name="Produce Two Registration Cards">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ProduceRegistrationCards" targetRef="Task_AddToListOfNotices" />
    <bpmn:userTask id="Task_AddToListOfNotices" name="Add Patient to List of New Notices">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_AddToListOfNotices" targetRef="IntermediateCatchEvent_Wednesday" />
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Wednesday" name="Wednesday Staff Meeting">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="xsd:string">2023-01-01T09:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="IntermediateCatchEvent_Wednesday" targetRef="Task_AssignPatients" />
    <bpmn:userTask id="Task_AssignPatients" name="Assign Patients to Team Members">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AssignPatients" targetRef="Task_RecordAssignments" />
    <bpmn:userTask id="Task_RecordAssignments" name="Record Assignments on Assignment List">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RecordAssignments" targetRef="Task_DetermineMedicalFileReq" />
    <bpmn:userTask id="Task_DetermineMedicalFileReq" name="Determine if Medical File Required">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_DetermineMedicalFileReq" targetRef="Task_HandListToSecretariat" />
    <bpmn:userTask id="Task_HandListToSecretariat" name="Hand Assignment List to Secretarial Office">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_HandListToSecretariat" targetRef="Task_StoreAssignmentInIS" />
    <bpmn:userTask id="Task_StoreAssignmentInIS" name="Store Assignment in Information System">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_StoreAssignmentInIS" targetRef="Task_PassCardsToIntakers" />
    <bpmn:userTask id="Task_PassCardsToIntakers" name="Pass Registration Cards to Intakers">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_PassCardsToIntakers" targetRef="ExclusiveGateway_MedicalFileNeeded" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_MedicalFileNeeded" name="Medical File Needed?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="ExclusiveGateway_MedicalFileNeeded" targetRef="Task_RequestMedicalFile" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="ExclusiveGateway_MedicalFileNeeded" targetRef="Task_FirstIntakerPlansMeeting" />
    <bpmn:userTask id="Task_RequestMedicalFile" name="Send Letter to Family Doctor for Medical File">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_RequestMedicalFile" targetRef="IntermediateCatchEvent_FileReceived" />
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_FileReceived" name="Medical File Copy Received">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="IntermediateCatchEvent_FileReceived" targetRef="Task_InformSecondIntaker" />
    <bpmn:userTask id="Task_InformSecondIntaker" name="Inform Second Intaker">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_InformSecondIntaker" targetRef="Task_AddCopyToFile" />
    <bpmn:userTask id="Task_AddCopyToFile" name="Add Copy to Patient File">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_AddCopyToFile" targetRef="Task_FirstIntakerPlansMeeting" />
    <bpmn:userTask id="Task_FirstIntakerPlansMeeting" name="First Intaker Plans Meeting">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_FirstIntakerPlansMeeting" targetRef="Task_FirstMeetingExam" />
    <bpmn:userTask id="Task_FirstMeetingExam" name="First Meeting: Examine Patient with Checklist">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_FirstMeetingExam" targetRef="Task_RegisterObservations" />
    <bpmn:userTask id="Task_RegisterObservations" name="Register Additional Observations in Notebook">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_RegisterObservations" targetRef="Task_PutNotesInFile" />
    <bpmn:userTask id="Task_PutNotesInFile" name="Put Notes and Checklist in Patient File">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_PutNotesInFile" targetRef="Task_SecondIntakerPlansMeeting" />
    <bpmn:userTask id="Task_SecondIntakerPlansMeeting" name="Second Intaker Plans Meeting">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_SecondIntakerPlansMeeting" targetRef="Task_SecondMeetingDictaphone" />
    <bpmn:userTask id="Task_SecondMeetingDictaphone" name="Second Meeting: Record Observations on Dictaphone">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_SecondMeetingDictaphone" targetRef="Task_TypeOutTapes" />
    <bpmn:userTask id="Task_TypeOutTapes" name="Type Out Tapes at Secretarial Office">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_TypeOutTapes" targetRef="Task_AddTypedInfoToFile" />
    <bpmn:userTask id="Task_AddTypedInfoToFile" name="Add Typed Info to Patient File">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_AddTypedInfoToFile" targetRef="Task_UpdateStatusList" />
    <bpmn:userTask id="Task_UpdateStatusList" name="Update List of Patients with Completed Meetings">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_UpdateStatusList" targetRef="IntermediateCatchEvent_NextWednesday" />
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_NextWednesday" name="Next Wednesday Staff Meeting">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="xsd:string">2023-01-08T09:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="IntermediateCatchEvent_NextWednesday" targetRef="Task_ProvideListToTeamLeader" />
    <bpmn:userTask id="Task_ProvideListToTeamLeader" name="Provide List to Team Leader">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_ProvideListToTeamLeader" targetRef="Task_FormulateTreatmentPlan" />
    <bpmn:userTask id="Task_FormulateTreatmentPlan" name="Formulate Treatment Plan">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_FormulateTreatmentPlan" targetRef="EndEvent_IntakeComplete" />
    <bpmn:endEvent id="EndEvent_IntakeComplete" name="Intake Procedure Ends">
      <bpmn:incoming>Flow_35</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Secretarial Office" processRef="IntakeWorkflow" />
  </bpmn:collaboration>
</bpmn:definitions>