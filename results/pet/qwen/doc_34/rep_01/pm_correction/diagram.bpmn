      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_timer_30_days_di" bpmnElement="evt_timer_30_days">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_timer_7_days_di" bpmnElement="evt_timer_7_days">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_account_exists_di" bpmnElement="gw_account_exists">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_amount_check_di" bpmnElement="gw_amount_check">
        <dc:Bounds x="1110" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_approval_paths_di" bpmnElement="gw_merge_approval_paths">
        <dc:Bounds x="1680" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_supervisor_decision_di" bpmnElement="gw_supervisor_decision">
        <dc:Bounds x="1490" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_timer_30_days_check_di" bpmnElement="gw_timer_30_days_check">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_timer_7_days_check_di" bpmnElement="gw_timer_7_days_check">
        <dc:Bounds x="540" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_auto_approve_di" bpmnElement="task_auto_approve">
        <dc:Bounds x="1300" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_account_di" bpmnElement="task_check_account">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_create_account_di" bpmnElement="task_create_account">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_reimbursement_di" bpmnElement="task_process_reimbursement">
        <dc:Bounds x="1680" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_report_di" bpmnElement="task_review_report">
        <dc:Bounds x="920" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_cancellation_email_di" bpmnElement="task_send_cancellation_email">
        <dc:Bounds x="1110" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_progress_email_di" bpmnElement="task_send_progress_email">
        <dc:Bounds x="730" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_rejection_email_di" bpmnElement="task_send_rejection_email">
        <dc:Bounds x="1680" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_supervisor_approval_di" bpmnElement="task_supervisor_approval">
        <dc:Bounds x="1300" y="475" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_expense_report_di" bpmnElement="data_expense_report">
        <dc:Bounds x="876" y="615" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_check_di" bpmnElement="flow_start_to_check">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_gw_account_di" bpmnElement="flow_check_to_gw_account">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_create_account_di" bpmnElement="flow_to_create_account">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_create_to_review_di" bpmnElement="flow_create_to_review">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_review_di" bpmnElement="flow_to_review">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_to_gw_amount_di" bpmnElement="flow_review_to_gw_amount">
        <di:waypoint x="970" y="265" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_auto_approve_di" bpmnElement="flow_to_auto_approve">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1350" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_supervisor_di" bpmnElement="flow_to_supervisor">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1350" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_auto_to_merge_di" bpmnElement="flow_auto_to_merge">
        <di:waypoint x="1350" y="390" />
        <di:waypoint x="1705" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_supervisor_to_gw_decision_di" bpmnElement="flow_supervisor_to_gw_decision">
        <di:waypoint x="1350" y="515" />
        <di:waypoint x="1515" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_reimbursement_di" bpmnElement="flow_to_reimbursement">
        <di:waypoint x="1515" y="125" />
        <di:waypoint x="1705" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_rejection_di" bpmnElement="flow_to_rejection">
        <di:waypoint x="1515" y="125" />
        <di:waypoint x="1730" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejection_to_end_di" bpmnElement="flow_rejection_to_end">
        <di:waypoint x="1730" y="390" />
        <di:waypoint x="1888" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_to_reimbursement_task_di" bpmnElement="flow_merge_to_reimbursement_task">
        <di:waypoint x="1705" y="125" />
        <di:waypoint x="1730" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reimbursement_to_end_di" bpmnElement="flow_reimbursement_to_end">
        <di:waypoint x="1730" y="265" />
        <di:waypoint x="1318" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_to_timer_7_di" bpmnElement="flow_start_to_timer_7">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_timer_7_to_gw_di" bpmnElement="flow_timer_7_to_gw">
        <di:waypoint x="368" y="118" />
        <di:waypoint x="565" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_progress_email_di" bpmnElement="flow_to_progress_email">
        <di:waypoint x="565" y="250" />
        <di:waypoint x="780" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_progress_to_end_di" bpmnElement="flow_progress_to_end">
        <di:waypoint x="780" y="390" />
        <di:waypoint x="1318" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_continue_processing_di" bpmnElement="flow_continue_processing">
        <di:waypoint x="565" y="250" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_timer_30_to_gw_di" bpmnElement="flow_timer_30_to_gw">
        <di:waypoint x="748" y="118" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_cancellation_di" bpmnElement="flow_to_cancellation">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cancellation_to_end_di" bpmnElement="flow_cancellation_to_end">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="1318" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_continue_processing_2_di" bpmnElement="flow_continue_processing_2">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1730" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_account_dia0_di" bpmnElement="task_check_account_dia0">
        <di:waypoint x="894" y="640" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_review_report_dia0_di" bpmnElement="task_review_report_dia0">
        <di:waypoint x="894" y="640" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_supervisor_approval_dia0_di" bpmnElement="task_supervisor_approval_dia0">
        <di:waypoint x="894" y="640" />
        <di:waypoint x="1350" y="515" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>