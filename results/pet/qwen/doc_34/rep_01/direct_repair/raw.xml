<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ExpenseProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ExpenseReportProcess" name="Expense Report Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Received" name="Expense Report Received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_AccountCheck" name="Account Exists?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_NoAccount</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CreateAccount" name="Create New Account">
      <bpmn:incoming>Flow_NoAccount</bpmn:incoming>
      <bpmn:outgoing>Flow_AccountCreated</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Received" targetRef="Gateway_AccountCheck" />
    <bpmn:sequenceFlow id="Flow_NoAccount" name="No" sourceRef="Gateway_AccountCheck" targetRef="Task_CreateAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">accountExists == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AccountCreated" sourceRef="Task_CreateAccount" targetRef="Gateway_AmountCheck" />
    <bpmn:sequenceFlow id="Flow_HasAccount" name="Yes" sourceRef="Gateway_AccountCheck" targetRef="Gateway_AmountCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">accountExists == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_AmountCheck" name="Amount Check">
      <bpmn:incoming>Flow_AccountCreated</bpmn:incoming>
      <bpmn:incoming>Flow_HasAccount</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_SupervisorApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_AutoApprove" name="&lt; $200" sourceRef="Gateway_AmountCheck" targetRef="Task_ProcessReimbursement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">amount &lt; 200</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SupervisorApproval" name="&gt;= $200" sourceRef="Gateway_AmountCheck" targetRef="Task_SupervisorReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">amount &gt;= 200</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_SupervisorReview" name="Supervisor Approval">
      <bpmn:incoming>Flow_SupervisorApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Task_SupervisorReview" targetRef="Task_ProcessReimbursement" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Task_SupervisorReview" targetRef="Task_SendRejectionEmail" />
    <bpmn:serviceTask id="Task_SendRejectionEmail" name="Send Rejection Notice Email">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_EndRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Rejected" name="Process Ended (Rejected)">
      <bpmn:incoming>Flow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EndRejected" sourceRef="Task_SendRejectionEmail" targetRef="EndEvent_Rejected" />
    <bpmn:serviceTask id="Task_ProcessReimbursement" name="Process Direct Deposit">
      <bpmn:incoming>Flow_AutoApprove</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Success" name="Process Completed">
      <bpmn:incoming>Flow_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEndSuccess" sourceRef="Task_ProcessReimbursement" targetRef="EndEvent_Success" />
    
    <!-- Intermediate Catch Events for Timeouts -->
    <bpmn:intermediateCatchEvent id="Timer_7Days" name="7 Days Passed">
      <bpmn:incoming>Flow_TimerStart</bpmn:incoming>
      <bpmn:outgoing>Flow_SendProgressEmail</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_SendProgressEmail" name="Send 'Approval in Progress' Email">
      <bpmn:incoming>Flow_SendProgressEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_To30DayTimer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SendProgressEmail" sourceRef="Timer_7Days" targetRef="Task_SendProgressEmail" />
    
    <bpmn:intermediateCatchEvent id="Timer_30Days" name="30 Days Passed">
      <bpmn:incoming>Flow_To30DayTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_SendCancellationEmail</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_To30DayTimer" sourceRef="Task_SendProgressEmail" targetRef="Timer_30Days" />
    
    <bpmn:serviceTask id="Task_SendCancellationEmail" name="Send Cancellation Notice Email">
      <bpmn:incoming>Flow_SendCancellationEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_EndCancelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SendCancellationEmail" sourceRef="Timer_30Days" targetRef="Task_SendCancellationEmail" />
    
    <bpmn:endEvent id="EndEvent_Cancelled" name="Process Cancelled">
      <bpmn:incoming>Flow_EndCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EndCancelled" sourceRef="Task_SendCancellationEmail" targetRef="EndEvent_Cancelled" />

    <!-- Timer Start Flow - Conceptually attached to the main flow or a parallel subprocess. 
         For simplicity in this flat model, we assume a parallel path starts at the beginning 
         or these timers are boundary events on the main tasks. 
         However, standard BPMN usually handles timeouts via Boundary Events on Tasks or Subprocesses.
         To strictly follow "If request not completed...", we should attach these as non-interrupting boundary events 
         to the main process flow or use a parallel subprocess. 
         
         Let's refactor to use Boundary Events on the main approval/reimbursement block for better semantic accuracy,
         but since we have multiple tasks, a parallel subprocess is cleaner. 
         Given the constraint of a single process definition without complex sub-processes, 
         I will model the timers as a parallel path starting from the initial gateway or start event.
         
         Correction: The prompt implies global timeouts. A parallel path from the start is the most robust way 
         to model "global" timeouts in a flat BPMN diagram without using Call Activities or Subprocesses extensively.
    -->
    <bpmn:parallelGateway id="Gateway_ParallelStart" name="Split Main and Timer Paths">
      <bpmn:incoming>Flow_StartSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_MainPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_TimerPath</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_StartSplit" sourceRef="StartEvent_Received" targetRef="Gateway_ParallelStart" />
    <bpmn:sequenceFlow id="Flow_MainPath" sourceRef="Gateway_ParallelStart" targetRef="Gateway_AccountCheck" />
    <bpmn:sequenceFlow id="Flow_TimerPath" sourceRef="Gateway_ParallelStart" targetRef="Timer_7Days" />
    
    <!-- Join back for cancellation end? No, cancellation ends the whole process. 
         In BPMN, if one path ends, it doesn't automatically kill others unless using Terminate End Event.
         The prompt says "process is stopped". This implies a Terminate End Event.
    -->
    <bpmn:endEvent id="EndEvent_Terminate" name="Process Terminated">
      <bpmn:incoming>Flow_EndCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:terminateEventDefinition/>
    
    <!-- Update previous EndEvent_Cancelled to be a Terminate End Event -->
    <bpmn:endEvent id="EndEvent_Cancelled_Term" name="Process Cancelled &amp; Stopped">
      <bpmn:incoming>Flow_EndCancelled</bpmn:incoming>
      <bpmn:terminateEventDefinition/>
    </bpmn:endEvent>
    
    <!-- Remove old EndEvent_Cancelled reference and update flow -->
    <bpmn:sequenceFlow id="Flow_EndCancelled_Update" sourceRef="Task_SendCancellationEmail" targetRef="EndEvent_Cancelled_Term" />
    <bpmn:sequenceFlow id="Flow_EndCancelled_Old" sourceRef="Task_SendCancellationEmail" targetRef="EndEvent_Cancelled" />
    
    <!-- Clean up: Remove unused elements and fix flows -->
  </bpmn:process>
  
  <!-- Redefining the process cleanly to avoid XML errors from the thought process above -->
  <bpmn:process id="ExpenseReportProcessClean" name="Expense Report Process" isExecutable="true">
    <bpmn:startEvent id="Start_Expense" name="Expense Report Received">
      <bpmn:outgoing>Flow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:parallelGateway id="Par_Gateway_Start" name="Start Parallel Paths">
      <bpmn:incoming>Flow_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMainLogic</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToTimerLogic</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- Main Logic Path -->
    <bpmn:sequenceFlow id="Flow_StartToParallel" sourceRef="Start_Expense" targetRef="Par_Gateway_Start" />
    <bpmn:sequenceFlow id="Flow_ToMainLogic" sourceRef="Par_Gateway_Start" targetRef="Gw_CheckAccount" />
    
    <bpmn:exclusiveGateway id="Gw_CheckAccount" name="Account Exists?">
      <bpmn:incoming>Flow_ToMainLogic</bpmn:incoming>
      <bpmn:outgoing>Flow_NoAccount</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_CreateAcc" name="Create New Account">
      <bpmn:incoming>Flow_NoAccount</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedToAmount</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Flow_NoAccount" name="No" sourceRef="Gw_CheckAccount" targetRef="Task_CreateAcc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!hasAccount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_HasAccount" name="Yes" sourceRef="Gw_CheckAccount" targetRef="Gw_CheckAmount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">hasAccount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_CreatedToAmount" sourceRef="Task_CreateAcc" targetRef="Gw_CheckAmount" />
    
    <bpmn:exclusiveGateway id="Gw_CheckAmount" name="Amount Check">
      <bpmn:incoming>Flow_HasAccount</bpmn:incoming>
      <bpmn:incoming>Flow_CreatedToAmount</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_SupervisorReq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_AutoApprove" name="&lt; $200" sourceRef="Gw_CheckAmount" targetRef="Task_Deposit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">amount &lt; 200</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_SupervisorReq" name="&gt;= $200" sourceRef="Gw_CheckAmount" targetRef="Task_SupervisorReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">amount &gt;= 200</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:userTask id="Task_SupervisorReview" name="Supervisor Approval">
      <bpmn:incoming>Flow_SupervisorReq</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Task_SupervisorReview" targetRef="Task_Deposit" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Task_SupervisorReview" targetRef="Task_EmailReject" />
    
    <bpmn:serviceTask id="Task_EmailReject" name="Send Rejection Notice">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_EndReject</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="End_Reject" name="Rejected">
      <bpmn:incoming>Flow_EndReject</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_EndReject" sourceRef="Task_EmailReject" targetRef="End_Reject" />
    
    <bpmn:serviceTask id="Task_Deposit" name="Direct Deposit Reimbursement">
      <bpmn:incoming>Flow_AutoApprove</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_EndSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="End_Success" name="Completed">
      <bpmn:incoming>Flow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_EndSuccess" sourceRef="Task_Deposit" targetRef="End_Success" />
    
    <!-- Timer Logic Path -->
    <bpmn:sequenceFlow id="Flow_ToTimerLogic" sourceRef="Par_Gateway_Start" targetRef="Timer_7D" />
    
    <bpmn:intermediateCatchEvent id="Timer_7D" name="7 Days Elapsed">
      <bpmn:incoming>Flow_ToTimerLogic</bpmn:incoming>
      <bpmn:outgoing>Flow_SendProgress</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:serviceTask id="Task_EmailProgress" name="Send 'In Progress' Email">
      <bpmn:incoming>Flow_SendProgress</bpmn:incoming>
      <bpmn:outgoing>Flow_To30D</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="Flow_SendProgress" sourceRef="Timer_7D" targetRef="Task_EmailProgress" />
    <bpmn:sequenceFlow id="Flow_To30D" sourceRef="Task_EmailProgress" targetRef="Timer_30D" />
    
    <bpmn:intermediateCatchEvent id="Timer_30D" name="30 Days Elapsed">
      <bpmn:incoming>Flow_To30D</bpmn:incoming>
      <bpmn:outgoing>Flow_SendCancel</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:serviceTask id="Task_EmailCancel" name="Send Cancellation Notice">
      <bpmn:incoming>Flow_SendCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_EndCancel</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="Flow_SendCancel" sourceRef="Timer_30D" targetRef="Task_EmailCancel" />
    
    <bpmn:endEvent id="End_Cancel" name="Process Cancelled">
      <bpmn:incoming>Flow_EndCancel</bpmn:incoming>
      <bpmn:terminateEventDefinition/>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_EndCancel" sourceRef="Task_EmailCancel" targetRef="End_Cancel" />
    
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ExpenseReportProcessClean">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start_Expense">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ParStart" bpmnElement="Par_Gateway_Start" isMarkerVisible="true">
        <dc:Bounds x="220" y="90" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="220" y="140" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwAccount" bpmnElement="Gw_CheckAccount" isMarkerVisible="true">
        <dc:Bounds x="310" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TaskCreate" bpmnElement="Task_CreateAcc">
        <dc:Bounds x="410" y="10" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwAmount" bpmnElement="Gw_CheckAmount" isMarkerVisible="true">
        <dc:Bounds x="410" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TaskSupervisor" bpmnElement="Task_SupervisorReview">
        <dc:Bounds x="510" y="10" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TaskDeposit" bpmnElement="Task_Deposit">
        <dc:Bounds x="510" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TaskEmailReject" bpmnElement="Task_EmailReject">
        <dc:Bounds x="660" y="10" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndReject" bpmnElement="End_Reject">
        <dc:Bounds x="810" y="32" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndSuccess" bpmnElement="End_Success">
        <dc:Bounds x="660" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <!-- Timer Shapes -->
      <bpmndi:BPMNShape id="Shape_Timer7" bpmnElement="Timer_7D">
        <dc:Bounds x="220" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TaskProgress" bpmnElement="Task_EmailProgress">
        <dc:Bounds x="310" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Timer30" bpmnElement="Timer_30D">
        <dc:Bounds x="460" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TaskCancel" bpmnElement="Task_EmailCancel">
        <dc:Bounds x="550" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndCancel" bpmnElement="End_Cancel">
        <dc:Bounds x="700" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Flows -->
      <bpmndi:BPMNEdge id="Edge_Start_Par" bpmnElement="Flow_StartToParallel">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="220" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Par_Main" bpmnElement="Flow_ToMainLogic">
        <di:waypoint x="270" y="115" />
        <di:waypoint x="310" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Par_Timer" bpmnElement="Flow_ToTimerLogic">
        <di:waypoint x="245" y="140" />
        <di:waypoint x="245" y="200" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_GwAcc_No" bpmnElement="Flow_NoAccount">
        <di:waypoint x="335" y="90" />
        <di:waypoint x="460" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GwAcc_Yes" bpmnElement="Flow_HasAccount">
        <di:waypoint x="360" y="115" />
        <di:waypoint x="410" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Create_Amt" bpmnElement="Flow_CreatedToAmount">
        <di:waypoint x="510" y="50" />
        <di:waypoint x="435" y="90" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Amt_Auto" bpmnElement="Flow_AutoApprove">
        <di:waypoint x="460" y="115" />
        <di:waypoint x="510" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Amt_Sup" bpmnElement="Flow_SupervisorReq">
        <di:waypoint x="435" y="90" />
        <di:waypoint x="560" y="90" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Sup_Approve" bpmnElement="Flow_Approved">
        <di:waypoint x="610" y="50" />
        <di:waypoint x="560" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Sup_Reject" bpmnElement="Flow_Rejected">
        <di:waypoint x="610" y="50" />
        <di:waypoint x="660" y="50" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Reject_Email" bpmnElement="Flow_EndReject">
        <di:waypoint x="760" y="50" />
        <di:waypoint x="810" y="50" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Edge_Deposit_End" bpmnElement="Flow_EndSuccess">
        <di:waypoint x="610" y="130" />
        <di:waypoint x="660" y="120" />
      </bpmndi:BPMNEdge>
      
      <!-- Timer Flows -->
      <bpmndi:BPMNEdge id="Edge_T7_Progress" bpmnElement="Flow_SendProgress">
        <di:waypoint x="256" y="218" />
        <di:waypoint x="310" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Progress_T30" bpmnElement="Flow_To30D">
        <di:waypoint x="410" y="230" />
        <di:waypoint x="460" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T30_Cancel" bpmnElement="Flow_SendCancel">
        <di:waypoint x="496" y="218" />
        <di:waypoint x="550" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Cancel_End" bpmnElement="Flow_EndCancel">
        <di:waypoint x="650" y="230" />
        <di:waypoint x="700" y="220" />
