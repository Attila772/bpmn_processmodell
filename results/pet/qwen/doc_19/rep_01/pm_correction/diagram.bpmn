      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_job_desc_draft_di" bpmnElement="data_job_desc_draft">
        <dc:Bounds x="560" y="1200" width="36" height="50" />
      </bpmndi:BPMNShape>
