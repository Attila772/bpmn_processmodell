        <dc:Bounds x="540" y="1060" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_detect_req_di" bpmnElement="task_detect_req">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_provide_clarifications_di" bpmnElement="task_provide_clarifications">
        <dc:Bounds x="160" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_report_vacancy_di" bpmnElement="task_report_vacancy">
        <dc:Bounds x="540" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_request_corrections_di" bpmnElement="task_request_corrections">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_jd_di" bpmnElement="task_review_jd">
        <dc:Bounds x="350" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacancy_req_di" bpmnElement="data_vacancy_req">
        <dc:Bounds x="465" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_questions_p1_di" bpmnElement="data_questions_p1">
        <dc:Bounds x="180" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_clarifications_di" bpmnElement="data_clarifications">
        <dc:Bounds x="180" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
