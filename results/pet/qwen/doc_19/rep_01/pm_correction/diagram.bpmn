      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_detect_di" bpmnElement="flow_start_to_detect">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_detect_to_report_di" bpmnElement="flow_detect_to_report">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_report_to_end_func_di" bpmnElement="flow_report_to_end_func">
        <di:waypoint x="590" y="265" />
