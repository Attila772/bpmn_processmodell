<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_func_dept_part" name="Functional Department" processRef="pool_func_dept_proc" />
    <bpmn:participant id="pool_hr_dept_part" name="Personnel Department (HR)" processRef="pool_hr_dept_proc" />
    <bpmn:messageFlow id="msg_vacancy_report" sourceRef="evt_end_func_report" targetRef="evt_start_hr_receive" name="Vacancy Report" />
    <bpmn:messageFlow id="msg_jd_draft" sourceRef="evt_end_hr_desc" targetRef="evt_start_func_review" name="Job Description Draft" />
    <bpmn:messageFlow id="msg_clarification_req" sourceRef="task_ask_questions" targetRef="evt_start_hr_clarify" name="Clarification Request" />
    <bpmn:messageFlow id="msg_clarification_resp" sourceRef="evt_end_func_clarify" targetRef="evt_start_hr_clarify" name="Clarification Response" />
    <bpmn:messageFlow id="msg_approved_jd" sourceRef="evt_end_func_approve" targetRef="evt_start_hr_final" name="Approved Job Description" />
    <bpmn:messageFlow id="flow_start_hr_clarify_to_task" sourceRef="evt_start_hr_clarify" targetRef="task_provide_clarifications" />
  </bpmn:collaboration>
  <bpmn:process id="pool_func_dept_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacancy_req" name="Personnel Requirements List" dataObjectRef="data_vacancy_req_do" />
    <bpmn:dataObject id="data_vacancy_req_do" />
    <bpmn:dataObjectReference id="data_questions_p1" name="HR Questions" dataObjectRef="data_questions_p1_do" />
    <bpmn:dataObject id="data_questions_p1_do" />
    <bpmn:dataObjectReference id="data_clarifications" name="Clarifications from Head of Dept" dataObjectRef="data_clarifications_do" />
    <bpmn:dataObject id="data_clarifications_do" />
    <bpmn:dataObjectReference id="data_job_desc_draft_p1" name="Job Description Draft" dataObjectRef="data_job_desc_draft_p1_do" />
    <bpmn:dataObject id="data_job_desc_draft_p1_do" />
    <bpmn:dataObjectReference id="data_correction_requests" name="Correction Requests" dataObjectRef="data_correction_requests_do" />
    <bpmn:dataObject id="data_correction_requests_do" />
    <bpmn:dataObjectReference id="data_approved_jd" name="Approved Job Description" dataObjectRef="data_approved_jd_do" />
    <bpmn:dataObject id="data_approved_jd_do" />
    <bpmn:startEvent id="evt_start_func" name="Start: Personnel Requirements Detected">
      <bpmn:outgoing>flow_start_to_detect</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_func_report" name="End: Vacancy Reported">
      <bpmn:incoming>flow_report_to_end_func</bpmn:incoming>
      <bpmn:incoming>flow_correct_to_end_func_corr</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_func_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_func_review" name="Start: Receive Job Description for Review">
      <bpmn:outgoing>flow_start_func_review_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_func_review_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_func_clarify" name="End: Clarifications Provided">
      <bpmn:incoming>flow_task_clarify_to_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_func_clarify_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_func_approve" name="End: Job Description Approved">
      <bpmn:incoming>flow_approve_to_end_func_app</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_func_approve_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_detect_req" name="Detect Personnel Requirements">
      <bpmn:incoming>flow_start_to_detect</bpmn:incoming>
      <bpmn:outgoing>flow_detect_to_report</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_detect_req_doa0">
        <bpmn:targetRef>data_vacancy_req</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_report_vacancy" name="Report Vacancy to Personnel Dept">
      <bpmn:incoming>flow_detect_to_report</bpmn:incoming>
      <bpmn:outgoing>flow_report_to_end_func</bpmn:outgoing>
      <bpmn:property id="task_report_vacancy_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_report_vacancy_dia0">
        <bpmn:sourceRef>data_vacancy_req</bpmn:sourceRef>
        <bpmn:targetRef>task_report_vacancy_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_provide_clarifications" name="Provide Clarifications">
      <bpmn:outgoing>flow_task_clarify_to_end</bpmn:outgoing>
      <bpmn:property id="task_provide_clarifications_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_provide_clarifications_dia0">
        <bpmn:sourceRef>data_questions_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_provide_clarifications_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_provide_clarifications_doa0">
        <bpmn:targetRef>data_clarifications</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_review_jd" name="Review Job Description">
      <bpmn:incoming>flow_start_func_review_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_gw</bpmn:outgoing>
      <bpmn:property id="task_review_jd_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_jd_dia0">
        <bpmn:sourceRef>data_job_desc_draft_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_jd_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_request_corrections" name="Request Corrections">
      <bpmn:incoming>flow_func_to_correct</bpmn:incoming>
      <bpmn:outgoing>flow_correct_to_end_func_corr</bpmn:outgoing>
      <bpmn:property id="task_request_corrections_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_request_corrections_dia0">
        <bpmn:sourceRef>data_job_desc_draft_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_request_corrections_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_request_corrections_doa0">
        <bpmn:targetRef>data_correction_requests</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_approve_jd" name="Approve Job Description">
      <bpmn:incoming>flow_func_to_approve</bpmn:incoming>
      <bpmn:outgoing>flow_approve_to_end_func_app</bpmn:outgoing>
      <bpmn:property id="task_approve_jd_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_approve_jd_dia0">
        <bpmn:sourceRef>data_job_desc_draft_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_jd_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_approve_jd_doa0">
        <bpmn:targetRef>data_approved_jd</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_func_review" name="Is Job Description Correct?" isMarkerVisible="true">
      <bpmn:incoming>flow_review_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_func_to_correct</bpmn:outgoing>
      <bpmn:outgoing>flow_func_to_approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_detect" sourceRef="evt_start_func" targetRef="task_detect_req" />
    <bpmn:sequenceFlow id="flow_detect_to_report" sourceRef="task_detect_req" targetRef="task_report_vacancy" />
    <bpmn:sequenceFlow id="flow_report_to_end_func" sourceRef="task_report_vacancy" targetRef="evt_end_func_report" />
    <bpmn:sequenceFlow id="flow_task_clarify_to_end" sourceRef="task_provide_clarifications" targetRef="evt_end_func_clarify" />
    <bpmn:sequenceFlow id="flow_start_func_review_to_task" sourceRef="evt_start_func_review" targetRef="task_review_jd" />
    <bpmn:sequenceFlow id="flow_review_to_gw" sourceRef="task_review_jd" targetRef="gw_func_review" />
    <bpmn:sequenceFlow id="flow_func_to_correct" sourceRef="gw_func_review" targetRef="task_request_corrections" name="Corrections needed" />
    <bpmn:sequenceFlow id="flow_func_to_approve" sourceRef="gw_func_review" targetRef="task_approve_jd" name="Correct" />
    <bpmn:sequenceFlow id="flow_correct_to_end_func_corr" sourceRef="task_request_corrections" targetRef="evt_end_func_report" />
    <bpmn:sequenceFlow id="flow_approve_to_end_func_app" sourceRef="task_approve_jd" targetRef="evt_end_func_approve" />
  </bpmn:process>
  <bpmn:process id="pool_hr_dept_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacancy_req_p1" name="Personnel Requirements List" dataObjectRef="data_vacancy_req_p1_do" />
    <bpmn:dataObject id="data_vacancy_req_p1_do" />
    <bpmn:dataObjectReference id="data_job_desc_draft" name="Job Description Draft" dataObjectRef="data_job_desc_draft_do" />
    <bpmn:dataObject id="data_job_desc_draft_do" />
    <bpmn:dataObjectReference id="data_questions" name="HR Questions" dataObjectRef="data_questions_do" />
    <bpmn:dataObject id="data_questions_do" />
    <bpmn:dataObjectReference id="data_approved_jd_p1" name="Approved Job Description" dataObjectRef="data_approved_jd_p1_do" />
    <bpmn:dataObject id="data_approved_jd_p1_do" />
    <bpmn:startEvent id="evt_start_hr_receive" name="Start: Receive Vacancy Report">
      <bpmn:outgoing>flow_start_hr_to_gw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_hr_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_hr_desc" name="End: Job Description Ready for Review">
      <bpmn:incoming>flow_create_to_end_hr</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_hr_desc_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_hr_clarify" name="Start: Receive Clarifications">
      <bpmn:outgoing>flow_start_hr_clarify_to_create</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_hr_clarify_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_hr_final" name="Start: Receive Approved JD">
      <bpmn:outgoing>flow_start_hr_final_to_adv</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_hr_final_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_process" name="Process Complete">
      <bpmn:incoming>flow_adv_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_create_jd" name="Create Job Description">
      <bpmn:incoming>flow_hr_to_create</bpmn:incoming>
      <bpmn:incoming>flow_start_hr_clarify_to_create</bpmn:incoming>
      <bpmn:outgoing>flow_create_to_end_hr</bpmn:outgoing>
      <bpmn:property id="task_create_jd_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_jd_dia0">
        <bpmn:sourceRef>data_vacancy_req_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_create_jd_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_jd_doa0">
        <bpmn:targetRef>data_job_desc_draft</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_ask_questions" name="Ask Questions about Tasks/Requirements">
      <bpmn:incoming>flow_hr_to_ask</bpmn:incoming>
      <bpmn:property id="task_ask_questions_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_ask_questions_dia0">
        <bpmn:sourceRef>data_vacancy_req_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_ask_questions_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_ask_questions_doa0">
        <bpmn:targetRef>data_questions</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_advertise_jd" name="Advertise Job Description">
      <bpmn:incoming>flow_start_hr_final_to_adv</bpmn:incoming>
      <bpmn:outgoing>flow_adv_to_end</bpmn:outgoing>
      <bpmn:property id="task_advertise_jd_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_advertise_jd_dia0">
        <bpmn:sourceRef>data_approved_jd_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_advertise_jd_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_hr_questions" name="Does HR have questions?" isMarkerVisible="true">
      <bpmn:incoming>flow_start_hr_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_hr_to_ask</bpmn:outgoing>
      <bpmn:outgoing>flow_hr_to_create</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_hr_to_gw" sourceRef="evt_start_hr_receive" targetRef="gw_hr_questions" />
    <bpmn:sequenceFlow id="flow_hr_to_ask" sourceRef="gw_hr_questions" targetRef="task_ask_questions" name="Yes, has questions" />
    <bpmn:sequenceFlow id="flow_hr_to_create" sourceRef="gw_hr_questions" targetRef="task_create_jd" name="No questions" />
    <bpmn:sequenceFlow id="flow_start_hr_clarify_to_create" sourceRef="evt_start_hr_clarify" targetRef="task_create_jd" />
    <bpmn:sequenceFlow id="flow_create_to_end_hr" sourceRef="task_create_jd" targetRef="evt_end_hr_desc" />
    <bpmn:sequenceFlow id="flow_start_hr_final_to_adv" sourceRef="evt_start_hr_final" targetRef="task_advertise_jd" />
    <bpmn:sequenceFlow id="flow_adv_to_end" sourceRef="task_advertise_jd" targetRef="evt_end_process" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_func_dept_part_di" bpmnElement="pool_func_dept_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1140" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_hr_dept_part_di" bpmnElement="pool_hr_dept_part" isHorizontal="true">
        <dc:Bounds x="120" y="625" width="760" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_func_approve_di" bpmnElement="evt_end_func_approve">
