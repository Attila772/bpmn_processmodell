      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_hr_receive_di" bpmnElement="evt_start_hr_receive">
        <dc:Bounds x="160" y="935" width="36" height="36" />
      </bpmndi:BPMNShape>
