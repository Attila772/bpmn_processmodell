<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_func_dept_part" name="Functional Department" processRef="pool_func_dept_proc" />
    <bpmn:participant id="pool_hr_dept_part" name="Personnel Department" processRef="pool_hr_dept_proc" />
    <bpmn:messageFlow id="msg_report_vacancy" sourceRef="evt_end_func_report" targetRef="evt_start_hr_receive" name="Report Vacancy" />
    <bpmn:messageFlow id="msg_send_desc" sourceRef="evt_end_hr_desc" targetRef="evt_start_func_review" name="Send Job Description for Review" />
    <bpmn:messageFlow id="msg_request_corrections" sourceRef="evt_end_func_correct" targetRef="evt_start_hr_correct" name="Request Corrections" />
    <bpmn:messageFlow id="msg_approve_desc" sourceRef="evt_end_func_approve" targetRef="evt_start_hr_final" name="Approve Job Description" />
    <bpmn:messageFlow id="msg_provide_clarifications" sourceRef="evt_end_func_clarify" targetRef="evt_start_hr_clarify" name="Provide Clarifications" />
  </bpmn:collaboration>
  <bpmn:process id="pool_func_dept_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacancy_info" name="Vacancy Information" dataObjectRef="data_vacancy_info_do" />
    <bpmn:dataObject id="data_vacancy_info_do" />
    <bpmn:dataObjectReference id="data_job_description_p1" name="Job Description" dataObjectRef="data_job_description_p1_do" />
    <bpmn:dataObject id="data_job_description_p1_do" />
    <bpmn:startEvent id="evt_start_func" name="Personnel requirements detected">
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_func_report" name="Vacancy reported to HR">
      <bpmn:incoming>flow_report_to_end_func</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_func_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_func_review" name="Receive Job Description">
      <bpmn:outgoing>flow_start_func_review_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_func_review_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_func_clarify" name="Clarifications Provided">
      <bpmn:incoming>flow_ask_to_end_func_clarify</bpmn:incoming>
      <bpmn:incoming>flow_clarify_to_end_hr</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_func_clarify_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_hr_clarify" name="Receive Clarifications">
      <bpmn:outgoing>flow_start_func_clarify_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_hr_clarify_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_func_correct" name="Correction Request Sent">
      <bpmn:incoming>flow_request_to_end_func</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_func_correct_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_func_approve" name="Approval Sent">
      <bpmn:incoming>flow_approve_to_end_func</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_func_approve_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_detect_req" name="Detect personnel requirements">
      <bpmn:outgoing>flow_detect_to_report</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_detect_req_doa0">
        <bpmn:targetRef>data_vacancy_info</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_report_vacancy" name="Report vacancy to Personnel Department">
      <bpmn:incoming>flow_detect_to_report</bpmn:incoming>
      <bpmn:outgoing>flow_report_to_end_func</bpmn:outgoing>
      <bpmn:property id="task_report_vacancy_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_report_vacancy_dia0">
        <bpmn:sourceRef>data_vacancy_info</bpmn:sourceRef>
        <bpmn:targetRef>task_report_vacancy_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_provide_clarifications" name="Provide clarifications">
      <bpmn:incoming>flow_start_func_clarify_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_clarify_to_end_hr</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_review_desc" name="Review job description">
      <bpmn:incoming>flow_start_func_review_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_gw</bpmn:outgoing>
      <bpmn:property id="task_review_desc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_desc_dia0">
        <bpmn:sourceRef>data_job_description_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_desc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_request_corrections" name="Request corrections">
      <bpmn:incoming>flow_func_correct</bpmn:incoming>
      <bpmn:outgoing>flow_request_to_end_func</bpmn:outgoing>
      <bpmn:property id="task_request_corrections_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_request_corrections_dia0">
        <bpmn:sourceRef>data_job_description_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_request_corrections_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_approve_desc" name="Approve job description">
      <bpmn:incoming>flow_func_approve</bpmn:incoming>
      <bpmn:outgoing>flow_approve_to_end_func</bpmn:outgoing>
      <bpmn:property id="task_approve_desc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_approve_desc_dia0">
        <bpmn:sourceRef>data_job_description_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_approve_desc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_func_decision" name="Decision on Job Description" isMarkerVisible="true">
      <bpmn:incoming>flow_review_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_func_correct</bpmn:outgoing>
      <bpmn:outgoing>flow_func_approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_detect_to_report" sourceRef="task_detect_req" targetRef="task_report_vacancy" />
    <bpmn:sequenceFlow id="flow_report_to_end_func" sourceRef="task_report_vacancy" targetRef="evt_end_func_report" />
    <bpmn:sequenceFlow id="flow_start_func_clarify_to_task" sourceRef="evt_start_hr_clarify" targetRef="task_provide_clarifications" />
    <bpmn:sequenceFlow id="flow_clarify_to_end_hr" sourceRef="task_provide_clarifications" targetRef="evt_end_func_clarify" />
    <bpmn:sequenceFlow id="flow_start_func_review_to_task" sourceRef="evt_start_func_review" targetRef="task_review_desc" />
    <bpmn:sequenceFlow id="flow_review_to_gw" sourceRef="task_review_desc" targetRef="gw_func_decision" />
    <bpmn:sequenceFlow id="flow_func_correct" sourceRef="gw_func_decision" targetRef="task_request_corrections" name="Corrections needed" />
    <bpmn:sequenceFlow id="flow_func_approve" sourceRef="gw_func_decision" targetRef="task_approve_desc" name="Approved" />
    <bpmn:sequenceFlow id="flow_request_to_end_func" sourceRef="task_request_corrections" targetRef="evt_end_func_correct" />
    <bpmn:sequenceFlow id="flow_approve_to_end_func" sourceRef="task_approve_desc" targetRef="evt_end_func_approve" />
  </bpmn:process>
  <bpmn:process id="pool_hr_dept_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacancy_info_p1" name="Vacancy Information" dataObjectRef="data_vacancy_info_p1_do" />
    <bpmn:dataObject id="data_vacancy_info_p1_do" />
    <bpmn:dataObjectReference id="data_job_description" name="Job Description" dataObjectRef="data_job_description_do" />
    <bpmn:dataObject id="data_job_description_do" />
    <bpmn:startEvent id="evt_start_hr_receive" name="Receive Vacancy Report">
      <bpmn:outgoing>flow_start_hr_to_gw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_hr_receive_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_hr_desc" name="Job Description Ready for Review">
      <bpmn:incoming>flow_create_to_end_hr</bpmn:incoming>
      <bpmn:incoming>flow_correct_to_end_hr</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_hr_desc_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_hr_correct" name="Receive Correction Request">
      <bpmn:outgoing>flow_start_hr_correct_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_hr_correct_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_hr_final" name="Receive Approval">
      <bpmn:outgoing>flow_start_hr_final_to_task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_hr_final_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_process" name="Process Completed (Advertized)">
      <bpmn:incoming>flow_advertise_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_create_desc" name="Create job description">
      <bpmn:incoming>flow_hr_create</bpmn:incoming>
      <bpmn:outgoing>flow_create_to_end_hr</bpmn:outgoing>
      <bpmn:property id="task_create_desc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_create_desc_dia0">
        <bpmn:sourceRef>data_vacancy_info_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_create_desc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_create_desc_doa0">
        <bpmn:targetRef>data_job_description</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_ask_questions" name="Ask questions about tasks/requirements">
      <bpmn:incoming>flow_hr_ask</bpmn:incoming>
      <bpmn:outgoing>flow_ask_to_end_func_clarify</bpmn:outgoing>
      <bpmn:property id="task_ask_questions_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_ask_questions_dia0">
        <bpmn:sourceRef>data_vacancy_info_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_ask_questions_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_correct_desc" name="Correct job description">
      <bpmn:incoming>flow_start_hr_correct_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_correct_to_end_hr</bpmn:outgoing>
      <bpmn:property id="task_correct_desc_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_correct_desc_dia0">
        <bpmn:sourceRef>data_job_description</bpmn:sourceRef>
        <bpmn:targetRef>task_correct_desc_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_correct_desc_doa0">
        <bpmn:targetRef>data_job_description</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_advertise" name="Advertise job">
      <bpmn:incoming>flow_start_hr_final_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_advertise_to_end</bpmn:outgoing>
      <bpmn:property id="task_advertise_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_advertise_dia0">
        <bpmn:sourceRef>data_job_description</bpmn:sourceRef>
        <bpmn:targetRef>task_advertise_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_hr_questions" name="Does HR have questions?" isMarkerVisible="true">
      <bpmn:incoming>flow_start_hr_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_hr_ask</bpmn:outgoing>
      <bpmn:outgoing>flow_hr_create</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_hr_to_gw" sourceRef="evt_start_hr_receive" targetRef="gw_hr_questions" />
    <bpmn:sequenceFlow id="flow_hr_ask" sourceRef="gw_hr_questions" targetRef="task_ask_questions" name="Yes, has questions" />
    <bpmn:sequenceFlow id="flow_hr_create" sourceRef="gw_hr_questions" targetRef="task_create_desc" name="No questions" />
    <bpmn:sequenceFlow id="flow_create_to_end_hr" sourceRef="task_create_desc" targetRef="evt_end_hr_desc" />
    <bpmn:sequenceFlow id="flow_start_hr_correct_to_task" sourceRef="evt_start_hr_correct" targetRef="task_correct_desc" />
    <bpmn:sequenceFlow id="flow_correct_to_end_hr" sourceRef="task_correct_desc" targetRef="evt_end_hr_desc" />
    <bpmn:sequenceFlow id="flow_start_hr_final_to_task" sourceRef="evt_start_hr_final" targetRef="task_advertise" />
    <bpmn:sequenceFlow id="flow_advertise_to_end" sourceRef="task_advertise" targetRef="evt_end_process" />
  </bpmn:process>
