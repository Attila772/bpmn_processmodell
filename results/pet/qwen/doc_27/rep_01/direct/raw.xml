  <bpmn:process id="Process_FaultHandling" name="Fault Handling Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_FailureReported" name="Failure Reported or Suspected">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ExamineFailure" name="Examine the failure">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision on Failure">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Rejected" name="Failure Rejected">
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_InformGO_MSP" name="Inform GO and MSP about confirmed failure">
      <bpmn:incoming>Flow_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FixFault" name="Fix the fault at the measuring device">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShareResults" name="Share repair results with Fault Detector">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Parallel_Start" name="Parallel Start">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_InformGO_Resolution" name="Inform GO about resolution of interference">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InformMSP_Resolution" name="Inform MSP about resolution of interference">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Parallel_End" name="Parallel End">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_FailureReported" targetRef="Task_ExamineFailure" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ExamineFailure" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Reject" name="Rejects failure" sourceRef="Gateway_Decision" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_Confirm" name="Confirms failure" sourceRef="Gateway_Decision" targetRef="Task_InformGO_MSP" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_InformGO_MSP" targetRef="Task_FixFault" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_FixFault" targetRef="Task_ShareResults" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ShareResults" targetRef="Gateway_Parallel_Start" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Parallel_Start" targetRef="Task_InformGO_Resolution" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Parallel_Start" targetRef="Task_InformMSP_Resolution" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_InformGO_Resolution" targetRef="Gateway_Parallel_End" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_InformMSP_Resolution" targetRef="Gateway_Parallel_End" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Parallel_End" targetRef="EndEvent_Completed" />
  </bpmn:process>
