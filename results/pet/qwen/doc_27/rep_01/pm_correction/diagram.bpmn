<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpo_part" name="MPO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_fault_detector_part" name="Fault Detector" processRef="pool_fault_detector_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_msp_part" name="MSP" processRef="pool_msp_proc" />
    <bpmn:messageFlow id="msg_flow_failure_report" sourceRef="evt_start_fd_report" targetRef="gw_merge_trigger" name="Failure Report" />
    <bpmn:messageFlow id="flow_start_fd_to_merge" sourceRef="evt_start_fd_report" targetRef="gw_merge_trigger" />
    <bpmn:messageFlow id="flow_notify_go_confirmed" sourceRef="gw_parallel_notify_confirmed" targetRef="evt_msg_notify_go_confirmed" />
    <bpmn:messageFlow id="flow_notify_msp_confirmed" sourceRef="gw_parallel_notify_confirmed" targetRef="evt_msg_notify_msp_confirmed" />
    <bpmn:messageFlow id="flow_fix_to_share_results" sourceRef="task_fix_fault" targetRef="evt_msg_share_results_fd" />
    <bpmn:messageFlow id="flow_share_results_to_parallel_resolved" sourceRef="evt_msg_share_results_fd" targetRef="gw_parallel_notify_resolved" />
    <bpmn:messageFlow id="flow_notify_go_resolved" sourceRef="gw_parallel_notify_resolved" targetRef="evt_msg_notify_go_resolved" />
    <bpmn:messageFlow id="flow_notify_msp_resolved" sourceRef="gw_parallel_notify_resolved" targetRef="evt_msg_notify_msp_resolved" />
    <bpmn:messageFlow id="flow_from_notify_go_confirmed_to_join" sourceRef="evt_msg_notify_go_confirmed" targetRef="gw_join_notify_confirmed" />
    <bpmn:messageFlow id="flow_from_notify_msp_confirmed_to_join" sourceRef="evt_msg_notify_msp_confirmed" targetRef="gw_join_notify_confirmed" />
    <bpmn:messageFlow id="flow_from_notify_go_resolved_to_join" sourceRef="evt_msg_notify_go_resolved" targetRef="gw_join_notify_resolved" />
    <bpmn:messageFlow id="flow_from_notify_msp_resolved_to_join" sourceRef="evt_msg_notify_msp_resolved" targetRef="gw_join_notify_resolved" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_mpo_suspicion" name="MPO Has Suspicion of Fault">
      <bpmn:outgoing>flow_start_mpo_to_merge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_reject" name="Failure Rejected">
      <bpmn:incoming>flow_to_reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_process" name="Process Completed">
      <bpmn:incoming>flow_join_resolved_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_examine_failure" name="Examine the failure">
      <bpmn:incoming>flow_merge_to_examine</bpmn:incoming>
      <bpmn:outgoing>flow_examine_to_decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_fix_fault" name="Fix the fault at the measuring device">
      <bpmn:incoming>flow_join_confirmed_to_fix</bpmn:incoming>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="gw_merge_trigger" name="Merge Triggers">
      <bpmn:incoming>flow_start_mpo_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_examine</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gw_decision_confirm" name="Confirm or Reject Failure?" isMarkerVisible="true">
      <bpmn:incoming>flow_examine_to_decision</bpmn:incoming>
      <bpmn:outgoing>flow_to_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_to_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_parallel_notify_confirmed" name="Parallel Notify Confirmed">
      <bpmn:incoming>flow_to_confirm</bpmn:incoming>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_join_notify_confirmed" name="Join Notify Confirmed">
      <bpmn:outgoing>flow_join_confirmed_to_fix</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_parallel_notify_resolved" name="Parallel Notify Resolved">
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_join_notify_resolved" name="Join Notify Resolved">
      <bpmn:outgoing>flow_join_resolved_to_end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_start_mpo_to_merge" sourceRef="evt_start_mpo_suspicion" targetRef="gw_merge_trigger" />
    <bpmn:sequenceFlow id="flow_merge_to_examine" sourceRef="gw_merge_trigger" targetRef="task_examine_failure" />
    <bpmn:sequenceFlow id="flow_examine_to_decision" sourceRef="task_examine_failure" targetRef="gw_decision_confirm" />
    <bpmn:sequenceFlow id="flow_to_reject" sourceRef="gw_decision_confirm" targetRef="evt_end_reject" name="Rejects the failure" />
    <bpmn:sequenceFlow id="flow_to_confirm" sourceRef="gw_decision_confirm" targetRef="gw_parallel_notify_confirmed" name="Confirms the failure" />
    <bpmn:sequenceFlow id="flow_join_confirmed_to_fix" sourceRef="gw_join_notify_confirmed" targetRef="task_fix_fault" />
    <bpmn:sequenceFlow id="flow_join_resolved_to_end" sourceRef="gw_join_notify_resolved" targetRef="evt_end_process" />
  </bpmn:process>
  <bpmn:process id="pool_fault_detector_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_fd_report" name="Fault Detector Reports Failure">
      <bpmn:messageEventDefinition id="evt_start_fd_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_share_results_fd" name="Share Repair Results with Fault Detector">
      <bpmn:messageEventDefinition id="evt_msg_share_results_fd_msgdef" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:intermediateThrowEvent id="evt_msg_notify_go_confirmed" name="Notify GO of Confirmed Failure">
      <bpmn:messageEventDefinition id="evt_msg_notify_go_confirmed_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_notify_go_resolved" name="Notify GO of Resolution">
      <bpmn:messageEventDefinition id="evt_msg_notify_go_resolved_msgdef" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="pool_msp_proc" isExecutable="false">
    <bpmn:intermediateThrowEvent id="evt_msg_notify_msp_confirmed" name="Notify MSP of Confirmed Failure">
      <bpmn:messageEventDefinition id="evt_msg_notify_msp_confirmed_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_notify_msp_resolved" name="Notify MSP of Resolution">
      <bpmn:messageEventDefinition id="evt_msg_notify_msp_resolved_msgdef" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpo_part_di" bpmnElement="pool_mpo_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1140" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_fault_detector_part_di" bpmnElement="pool_fault_detector_part" isHorizontal="true">
        <dc:Bounds x="120" y="750" width="700" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_go_part_di" bpmnElement="pool_go_part" isHorizontal="true">
        <dc:Bounds x="120" y="1210" width="700" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_msp_part_di" bpmnElement="pool_msp_part" isHorizontal="true">
        <dc:Bounds x="120" y="1670" width="700" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_process_di" bpmnElement="evt_end_process">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_reject_di" bpmnElement="evt_end_reject">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_notify_go_confirmed_di" bpmnElement="evt_msg_notify_go_confirmed">
        <dc:Bounds x="160" y="1270" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_notify_go_resolved_di" bpmnElement="evt_msg_notify_go_resolved">
        <dc:Bounds x="160" y="1395" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_notify_msp_confirmed_di" bpmnElement="evt_msg_notify_msp_confirmed">
        <dc:Bounds x="160" y="1730" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_notify_msp_resolved_di" bpmnElement="evt_msg_notify_msp_resolved">
        <dc:Bounds x="160" y="1855" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_share_results_fd_di" bpmnElement="evt_msg_share_results_fd">
        <dc:Bounds x="160" y="810" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_fd_report_di" bpmnElement="evt_start_fd_report">
        <dc:Bounds x="160" y="935" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_mpo_suspicion_di" bpmnElement="evt_start_mpo_suspicion">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_confirm_di" bpmnElement="gw_decision_confirm">
        <dc:Bounds x="730" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_join_notify_confirmed_di" bpmnElement="gw_join_notify_confirmed">
        <dc:Bounds x="160" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_join_notify_resolved_di" bpmnElement="gw_join_notify_resolved">
        <dc:Bounds x="160" y="350" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_trigger_di" bpmnElement="gw_merge_trigger">
        <dc:Bounds x="350" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_notify_confirmed_di" bpmnElement="gw_parallel_notify_confirmed">
        <dc:Bounds x="920" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_notify_resolved_di" bpmnElement="gw_parallel_notify_resolved">
        <dc:Bounds x="160" y="475" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_examine_failure_di" bpmnElement="task_examine_failure">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_fix_fault_di" bpmnElement="task_fix_fault">
        <dc:Bounds x="350" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_mpo_to_merge_di" bpmnElement="flow_start_mpo_to_merge">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="375" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_to_examine_di" bpmnElement="flow_merge_to_examine">
        <di:waypoint x="375" y="250" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_examine_to_decision_di" bpmnElement="flow_examine_to_decision">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_reject_di" bpmnElement="flow_to_reject">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_confirm_di" bpmnElement="flow_to_confirm">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="945" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_confirmed_to_fix_di" bpmnElement="flow_join_confirmed_to_fix">
        <di:waypoint x="185" y="250" />
        <di:waypoint x="400" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_resolved_to_end_di" bpmnElement="flow_join_resolved_to_end">
        <di:waypoint x="185" y="375" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_failure_report_di" bpmnElement="msg_flow_failure_report">
        <di:waypoint x="178" y="953" />
        <di:waypoint x="375" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_fd_to_merge_di" bpmnElement="flow_start_fd_to_merge">
        <di:waypoint x="178" y="953" />
        <di:waypoint x="375" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_go_confirmed_di" bpmnElement="flow_notify_go_confirmed">
        <di:waypoint x="945" y="250" />
        <di:waypoint x="178" y="1288" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_msp_confirmed_di" bpmnElement="flow_notify_msp_confirmed">
        <di:waypoint x="945" y="250" />
        <di:waypoint x="178" y="1748" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fix_to_share_results_di" bpmnElement="flow_fix_to_share_results">
        <di:waypoint x="400" y="390" />
        <di:waypoint x="178" y="828" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_share_results_to_parallel_resolved_di" bpmnElement="flow_share_results_to_parallel_resolved">
        <di:waypoint x="178" y="828" />
        <di:waypoint x="185" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_go_resolved_di" bpmnElement="flow_notify_go_resolved">
        <di:waypoint x="185" y="500" />
        <di:waypoint x="178" y="1413" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_msp_resolved_di" bpmnElement="flow_notify_msp_resolved">
        <di:waypoint x="185" y="500" />
        <di:waypoint x="178" y="1873" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_from_notify_go_confirmed_to_join_di" bpmnElement="flow_from_notify_go_confirmed_to_join">
        <di:waypoint x="178" y="1288" />
        <di:waypoint x="185" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_from_notify_msp_confirmed_to_join_di" bpmnElement="flow_from_notify_msp_confirmed_to_join">
        <di:waypoint x="178" y="1748" />
        <di:waypoint x="185" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_from_notify_go_resolved_to_join_di" bpmnElement="flow_from_notify_go_resolved_to_join">
        <di:waypoint x="178" y="1413" />
        <di:waypoint x="185" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_from_notify_msp_resolved_to_join_di" bpmnElement="flow_from_notify_msp_resolved_to_join">
        <di:waypoint x="178" y="1873" />
        <di:waypoint x="185" y="375" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>