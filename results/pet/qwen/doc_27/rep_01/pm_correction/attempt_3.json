      "target_id": "task_examine_failure",
      "condition_name": null
    },
    {
      "id": "flow_examine_to_decision",
      "source_id": "task_examine_failure",
      "target_id": "gw_decision_confirm",
      "condition_name": null
    },
    {
      "id": "flow_to_reject",
      "source_id": "gw_decision_confirm",
      "target_id": "evt_end_reject",
      "condition_name": "Rejects the failure"
    },
    {
      "id": "flow_to_confirm",
      "source_id": "gw_decision_confirm",
      "target_id": "gw_parallel_notify_confirmed",
      "condition_name": "Confirms the failure"
    },
    {
      "id": "flow_join_confirmed_to_fix",
      "source_id": "gw_join_notify_confirmed",
      "target_id": "task_fix_fault",
      "condition_name": null
    },
    {
      "id": "flow_join_resolved_to_end",
      "source_id": "gw_join_notify_resolved",
      "target_id": "evt_end_process",
      "condition_name": null
    }
  ],
  "pools": [
    {
      "id": "pool_mpo",
      "name": "MPO",
      "element_ids": [
        "evt_start_mpo_suspicion",
        "gw_merge_trigger",
        "task_examine_failure",
        "gw_decision_confirm",
        "evt_end_reject",
        "gw_parallel_notify_confirmed",
        "gw_join_notify_confirmed",
