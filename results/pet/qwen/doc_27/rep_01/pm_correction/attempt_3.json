{
  "name": "Fault Handling Process",
  "resources": [
    {
      "name": "MPO",
      "capacity": 1,
      "resource_type": "human"
    },
    {
      "name": "Fault Detector",
      "capacity": 1,
      "resource_type": "system"
    },
    {
      "name": "GO",
      "capacity": 1,
      "resource_type": "external_party"
    },
    {
      "name": "MSP",
      "capacity": 1,
      "resource_type": "external_party"
    }
  ],
  "events": [
    {
      "id": "evt_start_fd_report",
      "name": "Fault Detector Reports Failure",
      "event_position": "start",
      "trigger_type": "message",
      "message_name": "Failure Report"
    },
    {
      "id": "evt_start_mpo_suspicion",
      "name": "MPO Has Suspicion of Fault",
      "event_position": "start",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_end_reject",
      "name": "Failure Rejected",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    },
    {
      "id": "evt_msg_notify_go_confirmed",
      "name": "Notify GO of Confirmed Failure",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Confirmation Notification"
    },
    {
      "id": "evt_msg_notify_msp_confirmed",
      "name": "Notify MSP of Confirmed Failure",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Confirmation Notification"
    },
    {
      "id": "evt_msg_share_results_fd",
      "name": "Share Repair Results with Fault Detector",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Repair Results"
    },
    {
      "id": "evt_msg_notify_go_resolved",
      "name": "Notify GO of Resolution",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Resolution Notification"
    },
    {
      "id": "evt_msg_notify_msp_resolved",
      "name": "Notify MSP of Resolution",
      "event_position": "intermediate",
      "trigger_type": "message",
      "message_name": "Resolution Notification"
    },
    {
      "id": "evt_end_process",
      "name": "Process Completed",
      "event_position": "end",
      "trigger_type": "none",
      "message_name": null
    }
  ],
  "tasks": [
    {
      "id": "task_examine_failure",
      "name": "Examine the failure",
      "bpmn_type": "bpmn:UserTask",
      "resource_name": "MPO",
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [],
      "output_data_ids": []
    },
    {
      "id": "task_fix_fault",
      "name": "Fix the fault at the measuring device",
      "bpmn_type": "bpmn:ManualTask",
      "resource_name": "MPO",
      "duration": {
        "distribution": "fixed",
        "value": 1.0,
        "mean": null,
        "std": null,
        "min": null,
        "max": null,
        "unit": "minutes",
        "is_placeholder": true,
        "source": "default_missing_duration"
      },
      "is_loop": false,
      "input_data_ids": [],
      "output_data_ids": []
    }
  ],
  "gateways": [
    {
      "id": "gw_merge_trigger",
      "name": "Merge Triggers",
      "gateway_type": "parallel",
      "branch_probabilities": null,
      "branch_conditions": null
    },
    {
      "id": "gw_decision_confirm",
      "name": "Confirm or Reject Failure?",
      "gateway_type": "exclusive",
      "branch_probabilities": null,
      "branch_conditions": [
        {
          "flow_id": "flow_to_reject",
          "condition": "Rejects the failure"
        },
        {
          "flow_id": "flow_to_confirm",
          "condition": "Confirms the failure"
        }
      ]
    },
    {
      "id": "gw_parallel_notify_confirmed",
      "name": "Parallel Notify Confirmed",
      "gateway_type": "parallel",
      "branch_probabilities": null,
      "branch_conditions": null
    },
    {
      "id": "gw_join_notify_confirmed",
      "name": "Join Notify Confirmed",
      "gateway_type": "parallel",
      "branch_probabilities": null,
      "branch_conditions": null
    },
    {
      "id": "gw_parallel_notify_resolved",
      "name": "Parallel Notify Resolved",
      "gateway_type": "parallel",
      "branch_probabilities": null,
      "branch_conditions": null
    },
    {
      "id": "gw_join_notify_resolved",
      "name": "Join Notify Resolved",
      "gateway_type": "parallel",
      "branch_probabilities": null,
      "branch_conditions": null
    }
  ],
  "sequence_flows": [
    {
      "id": "flow_start_mpo_to_merge",
      "source_id": "evt_start_mpo_suspicion",
      "target_id": "gw_merge_trigger",
      "condition_name": null
    },
    {
      "id": "flow_merge_to_examine",
