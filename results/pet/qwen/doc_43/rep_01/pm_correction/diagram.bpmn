<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_employee_part" name="Employee" processRef="pool_employee_proc" />
    <bpmn:participant id="pool_supervisor_part" name="Supervisor" processRef="pool_supervisor_proc" />
    <bpmn:participant id="pool_treasurer_part" name="Treasurer" processRef="pool_treasurer_proc" />
    <bpmn:participant id="pool_payment_system_part" name="Payment System" processRef="pool_payment_system_proc" />
    <bpmn:messageFlow id="msg_flow_emp_to_sup" sourceRef="task_submit_report" targetRef="evt_msg_to_supervisor" name="Expense Report Submission" />
    <bpmn:messageFlow id="msg_flow_sup_reject" sourceRef="gw_supervisor_decision" targetRef="evt_msg_from_supervisor_reject" name="Rejection Notification" />
    <bpmn:messageFlow id="msg_flow_sup_approve" sourceRef="gw_supervisor_decision" targetRef="evt_msg_to_treasurer" name="Approved Expense Report" />
    <bpmn:messageFlow id="msg_flow_tre_reject" sourceRef="gw_treasurer_decision" targetRef="evt_msg_from_treasurer_reject" name="Correction Request" />
    <bpmn:messageFlow id="msg_flow_tre_to_pay" sourceRef="task_accept_processing" targetRef="evt_msg_to_payment" name="Payment Instruction" />
    <bpmn:messageFlow id="msg_flow_pay_to_tre" sourceRef="evt_msg_payment_confirmed" targetRef="evt_msg_payment_confirmed" name="Payment Confirmation" />
  </bpmn:collaboration>
  <bpmn:process id="pool_employee_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_expense_report" name="Expense Report" dataObjectRef="data_expense_report_do" />
    <bpmn:dataObject id="data_expense_report_do" />
    <bpmn:dataObjectReference id="data_receipts" name="Receipts" dataObjectRef="data_receipts_do" />
    <bpmn:dataObject id="data_receipts_do" />
    <bpmn:startEvent id="evt_start_employee" name="Purchase Made">
      <bpmn:outgoing>flow_start_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_from_supervisor_reject" name="Report Rejected">
      <bpmn:outgoing>flow_msg_reject_to_edit</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_supervisor_reject_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_from_treasurer_reject" name="Returned by Treasurer">
      <bpmn:outgoing>flow_msg_treasurer_reject_to_edit</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_from_treasurer_reject_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_submit_report" name="Submit expense report with receipts">
      <bpmn:incoming>flow_start_submit</bpmn:incoming>
      <bpmn:incoming>flow_edit_to_resubmit</bpmn:incoming>
      <bpmn:dataOutputAssociation id="task_submit_report_doa0">
        <bpmn:targetRef>data_expense_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="task_submit_report_doa1">
        <bpmn:targetRef>data_receipts</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_edit_report" name="Edit expense report">
      <bpmn:incoming>flow_msg_reject_to_edit</bpmn:incoming>
      <bpmn:incoming>flow_msg_treasurer_reject_to_edit</bpmn:incoming>
      <bpmn:outgoing>flow_edit_to_resubmit</bpmn:outgoing>
      <bpmn:property id="task_edit_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_edit_report_dia0">
        <bpmn:sourceRef>data_expense_report</bpmn:sourceRef>
        <bpmn:targetRef>task_edit_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_edit_report_doa0">
        <bpmn:targetRef>data_expense_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_start_submit" sourceRef="evt_start_employee" targetRef="task_submit_report" />
    <bpmn:sequenceFlow id="flow_msg_reject_to_edit" sourceRef="evt_msg_from_supervisor_reject" targetRef="task_edit_report" />
    <bpmn:sequenceFlow id="flow_edit_to_resubmit" sourceRef="task_edit_report" targetRef="task_submit_report" />
    <bpmn:sequenceFlow id="flow_msg_treasurer_reject_to_edit" sourceRef="evt_msg_from_treasurer_reject" targetRef="task_edit_report" />
  </bpmn:process>
  <bpmn:process id="pool_supervisor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_expense_report_p1" name="Expense Report" dataObjectRef="data_expense_report_p1_do" />
    <bpmn:dataObject id="data_expense_report_p1_do" />
    <bpmn:dataObjectReference id="data_receipts_p1" name="Receipts" dataObjectRef="data_receipts_p1_do" />
    <bpmn:dataObject id="data_receipts_p1_do" />
    <bpmn:intermediateThrowEvent id="evt_msg_to_supervisor" name="Submit to Supervisor">
      <bpmn:outgoing>flow_msg_supervisor_to_review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_to_supervisor_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_review_report" name="Review expense report">
      <bpmn:incoming>flow_msg_supervisor_to_review</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_gw_supervisor</bpmn:outgoing>
      <bpmn:property id="task_review_report_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_report_dia0">
        <bpmn:sourceRef>data_expense_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_review_report_dia1">
        <bpmn:sourceRef>data_receipts_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_review_report_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_supervisor_decision" name="Supervisor Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_review_to_gw_supervisor</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_msg_supervisor_to_review" sourceRef="evt_msg_to_supervisor" targetRef="task_review_report" />
    <bpmn:sequenceFlow id="flow_review_to_gw_supervisor" sourceRef="task_review_report" targetRef="gw_supervisor_decision" />
  </bpmn:process>
  <bpmn:process id="pool_treasurer_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_expense_report_p2" name="Expense Report" dataObjectRef="data_expense_report_p2_do" />
    <bpmn:dataObject id="data_expense_report_p2_do" />
    <bpmn:dataObjectReference id="data_receipts_p2" name="Receipts" dataObjectRef="data_receipts_p2_do" />
    <bpmn:dataObject id="data_receipts_p2_do" />
    <bpmn:intermediateThrowEvent id="evt_msg_to_treasurer" name="Approved for Treasurer">
      <bpmn:outgoing>flow_msg_treasurer_to_check</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_to_treasurer_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_check_receipts" name="Check receipts match items">
      <bpmn:incoming>flow_msg_treasurer_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gw_treasurer</bpmn:outgoing>
      <bpmn:property id="task_check_receipts_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_receipts_dia0">
        <bpmn:sourceRef>data_expense_report_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_check_receipts_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_check_receipts_dia1">
        <bpmn:sourceRef>data_receipts_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_check_receipts_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_accept_processing" name="Accept expenses for processing">
      <bpmn:incoming>flow_treasurer_accept</bpmn:incoming>
      <bpmn:property id="task_accept_processing_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_accept_processing_dia0">
        <bpmn:sourceRef>data_expense_report_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_accept_processing_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_treasurer_decision" name="Treasurer Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_check_to_gw_treasurer</bpmn:incoming>
      <bpmn:outgoing>flow_treasurer_accept</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_msg_treasurer_to_check" sourceRef="evt_msg_to_treasurer" targetRef="task_check_receipts" />
    <bpmn:sequenceFlow id="flow_check_to_gw_treasurer" sourceRef="task_check_receipts" targetRef="gw_treasurer_decision" />
    <bpmn:sequenceFlow id="flow_treasurer_accept" sourceRef="gw_treasurer_decision" targetRef="task_accept_processing" name="All in order" />
  </bpmn:process>
  <bpmn:process id="pool_payment_system_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_expense_report_p3" name="Expense Report" dataObjectRef="data_expense_report_p3_do" />
    <bpmn:dataObject id="data_expense_report_p3_do" />
    <bpmn:endEvent id="evt_end_process" name="Process Ends">
      <bpmn:incoming>flow_confirm_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_to_payment" name="Send for Payment">
      <bpmn:outgoing>flow_msg_payment_to_link</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_to_payment_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_payment_confirmed" name="Payment Confirmed">
      <bpmn:incoming>flow_link_to_msg_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_to_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_payment_confirmed_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="task_link_payment" name="Link to payment system">
      <bpmn:incoming>flow_msg_payment_to_link</bpmn:incoming>
      <bpmn:outgoing>flow_link_to_msg_confirm</bpmn:outgoing>
      <bpmn:property id="task_link_payment_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_link_payment_dia0">
        <bpmn:sourceRef>data_expense_report_p3</bpmn:sourceRef>
        <bpmn:targetRef>task_link_payment_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_msg_payment_to_link" sourceRef="evt_msg_to_payment" targetRef="task_link_payment" />
    <bpmn:sequenceFlow id="flow_link_to_msg_confirm" sourceRef="task_link_payment" targetRef="evt_msg_payment_confirmed" />
    <bpmn:sequenceFlow id="flow_confirm_to_end" sourceRef="evt_msg_payment_confirmed" targetRef="evt_end_process" />
  </bpmn:process>
