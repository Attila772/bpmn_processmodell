        <di:waypoint x="558" y="1623" />
        <di:waypoint x="748" y="1623" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_emp_to_sup_di" bpmnElement="msg_flow_emp_to_sup">
        <di:waypoint x="178" y="703" />
        <di:waypoint x="178" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_sup_to_emp_reject_di" bpmnElement="msg_flow_sup_to_emp_reject">
        <di:waypoint x="748" y="703" />
        <di:waypoint x="748" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_sup_to_tre_di" bpmnElement="msg_flow_sup_to_tre">
        <di:waypoint x="178" y="1163" />
        <di:waypoint x="178" y="1163" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_tre_to_emp_reject_di" bpmnElement="msg_flow_tre_to_emp_reject">
        <di:waypoint x="748" y="1163" />
        <di:waypoint x="748" y="1163" />
      </bpmndi:BPMNEdge>
