      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_msg_treasurer_to_check_di" bpmnElement="flow_msg_treasurer_to_check">
        <di:waypoint x="178" y="1163" />
        <di:waypoint x="400" y="1185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_gw_treasurer_di" bpmnElement="flow_check_to_gw_treasurer">
        <di:waypoint x="400" y="1185" />
        <di:waypoint x="565" y="1170" />
      </bpmndi:BPMNEdge>
