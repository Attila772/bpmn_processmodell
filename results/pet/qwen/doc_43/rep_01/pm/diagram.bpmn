        <di:waypoint x="565" y="710" />
        <di:waypoint x="748" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_msg_reject_to_edit_di" bpmnElement="flow_msg_reject_to_edit">
        <di:waypoint x="748" y="703" />
