        <dc:Bounds x="370" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_receipts_p1_di" bpmnElement="data_receipts_p1">
        <dc:Bounds x="370" y="950" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_expense_report_p2_di" bpmnElement="data_expense_report_p2">
        <dc:Bounds x="370" y="1410" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_receipts_p2_di" bpmnElement="data_receipts_p2">
        <dc:Bounds x="370" y="1410" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_expense_report_p3_di" bpmnElement="data_expense_report_p3">
        <dc:Bounds x="370" y="1745" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_submit_di" bpmnElement="flow_start_to_submit">
        <di:waypoint x="178" y="368" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_submit_to_msg_supervisor_di" bpmnElement="flow_submit_to_msg_supervisor">
        <di:waypoint x="590" y="140" />
