      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_employee_di" bpmnElement="evt_start_employee">
        <dc:Bounds x="160" y="350" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_supervisor_decision_di" bpmnElement="gw_supervisor_decision">
        <dc:Bounds x="540" y="685" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_treasurer_decision_di" bpmnElement="gw_treasurer_decision">
        <dc:Bounds x="540" y="1145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_receipts_di" bpmnElement="task_check_receipts">
        <dc:Bounds x="350" y="1145" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_edit_report_di" bpmnElement="task_edit_report">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
