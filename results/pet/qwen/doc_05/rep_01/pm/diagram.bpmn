<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_notification_part" name="Notification Department" processRef="pool_notification_proc" />
    <bpmn:participant id="pool_handling_part" name="Handling Department" processRef="pool_handling_proc" />
    <bpmn:participant id="pool_garage_part" name="Garage" processRef="pool_garage_proc" />
    <bpmn:messageFlow id="msg_flow_handover" sourceRef="evt_msg_handover_handling" targetRef="evt_msg_handover_handling_recv" name="Handover Registered Claim" />
    <bpmn:messageFlow id="msg_flow_auth_req" sourceRef="evt_msg_garage_authorize" targetRef="evt_msg_garage_authorize_recv" name="Request Repair Authorization" />
    <bpmn:messageFlow id="msg_flow_auth_conf" sourceRef="evt_msg_garage_confirm_send" targetRef="evt_msg_garage_confirm" name="Confirm Authorization" />
  </bpmn:collaboration>
  <bpmn:process id="pool_notification_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_claim_docs" name="Relevant Documentation" dataObjectRef="data_claim_docs_do" />
    <bpmn:dataObject id="data_claim_docs_do" />
    <bpmn:dataObjectReference id="data_registered_claim" name="Registered Claim Record" dataObjectRef="data_registered_claim_do" />
    <bpmn:dataObject id="data_registered_claim_do" />
    <bpmn:startEvent id="evt_start_claim" name="Customer submits claim with documentation">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_claim_msgdef" />
    </bpmn:startEvent>
    <bpmn:userTask id="task_check_docs" name="Check documents upon completeness">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:property id="task_check_docs_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_docs_dia0">
        <bpmn:sourceRef>data_claim_docs</bpmn:sourceRef>
        <bpmn:targetRef>task_check_docs_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_register_claim" name="Register the claim">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_register_claim_doa0">
        <bpmn:targetRef>data_registered_claim</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_claim" targetRef="task_check_docs" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_check_docs" targetRef="task_register_claim" />
  </bpmn:process>
  <bpmn:process id="pool_handling_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_registered_claim_p1" name="Registered Claim Record" dataObjectRef="data_registered_claim_p1_do" />
    <bpmn:dataObject id="data_registered_claim_p1_do" />
    <bpmn:dataObjectReference id="data_assessment_result" name="Assessment Result" dataObjectRef="data_assessment_result_do" />
    <bpmn:dataObject id="data_assessment_result_do" />
    <bpmn:dataObjectReference id="data_customer_letter" name="Customer Notification Letter" dataObjectRef="data_customer_letter_do" />
    <bpmn:dataObject id="data_customer_letter_do" />
    <bpmn:endEvent id="evt_end_process" name="Process Complete">
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_garage_authorize" name="Authorize Repairs Request">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_garage_authorize_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_garage_confirm" name="Repair Authorization Received">
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_garage_confirm_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_check_insurance" name="Check the insurance">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:property id="task_check_insurance_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_insurance_dia0">
        <bpmn:sourceRef>data_registered_claim_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_check_insurance_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_assess_claim" name="Perform assessment">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_assess_claim_doa0">
        <bpmn:targetRef>data_assessment_result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_phone_garage" name="Phone garage to authorise repairs">
      <bpmn:incoming>flow_positive</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="task_schedule_payment" name="Schedule payment">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="task_send_letter" name="Send letter to customer">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:property id="task_send_letter_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_send_letter_dia0">
        <bpmn:sourceRef>data_assessment_result</bpmn:sourceRef>
        <bpmn:targetRef>task_send_letter_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_send_letter_doa0">
        <bpmn:targetRef>data_customer_letter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_assessment_decision" name="Assessment Outcome" isMarkerVisible="true">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_positive</bpmn:outgoing>
      <bpmn:outgoing>flow_negative</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_merge_outcome" name="Merge Outcomes">
      <bpmn:incoming>flow_negative</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_check_insurance" targetRef="task_assess_claim" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_assess_claim" targetRef="gw_assessment_decision" />
    <bpmn:sequenceFlow id="flow_positive" sourceRef="gw_assessment_decision" targetRef="task_phone_garage" name="Positive" />
    <bpmn:sequenceFlow id="flow_negative" sourceRef="gw_assessment_decision" targetRef="gw_merge_outcome" name="Negative" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_phone_garage" targetRef="evt_msg_garage_authorize" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="evt_msg_garage_confirm" targetRef="task_schedule_payment" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_schedule_payment" targetRef="gw_merge_outcome" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="gw_merge_outcome" targetRef="task_send_letter" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_send_letter" targetRef="evt_end_process" />
  </bpmn:process>
  <bpmn:process id="pool_garage_proc" isExecutable="false">
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_notification_part_di" bpmnElement="pool_notification_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_handling_part_di" bpmnElement="pool_handling_part" isHorizontal="true">
        <dc:Bounds x="120" y="375" width="1140" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_garage_part_di" bpmnElement="pool_garage_part" isHorizontal="true">
        <dc:Bounds x="120" y="960" width="700" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_process_di" bpmnElement="evt_end_process">
        <dc:Bounds x="920" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_garage_authorize_di" bpmnElement="evt_msg_garage_authorize">
        <dc:Bounds x="920" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_garage_confirm_di" bpmnElement="evt_msg_garage_confirm">
        <dc:Bounds x="160" y="435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_claim_di" bpmnElement="evt_start_claim">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_assessment_decision_di" bpmnElement="gw_assessment_decision">
        <dc:Bounds x="540" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_outcome_di" bpmnElement="gw_merge_outcome">
        <dc:Bounds x="730" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assess_claim_di" bpmnElement="task_assess_claim">
        <dc:Bounds x="350" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_docs_di" bpmnElement="task_check_docs">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_insurance_di" bpmnElement="task_check_insurance">
        <dc:Bounds x="160" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_phone_garage_di" bpmnElement="task_phone_garage">
        <dc:Bounds x="730" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_claim_di" bpmnElement="task_register_claim">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_schedule_payment_di" bpmnElement="task_schedule_payment">
        <dc:Bounds x="350" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_letter_di" bpmnElement="task_send_letter">
        <dc:Bounds x="730" y="685" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_claim_docs_di" bpmnElement="data_claim_docs">
        <dc:Bounds x="370" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_registered_claim_di" bpmnElement="data_registered_claim">
        <dc:Bounds x="560" y="240" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_registered_claim_p1_di" bpmnElement="data_registered_claim_p1">
        <dc:Bounds x="180" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_assessment_result_di" bpmnElement="data_assessment_result">
        <dc:Bounds x="560" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_customer_letter_di" bpmnElement="data_customer_letter">
        <dc:Bounds x="750" y="825" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="150" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="150" y="140" />
        <di:waypoint x="210" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="210" y="600" />
        <di:waypoint x="400" y="475" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="400" y="475" />
        <di:waypoint x="565" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_positive_di" bpmnElement="flow_positive">
        <di:waypoint x="565" y="460" />
        <di:waypoint x="780" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_negative_di" bpmnElement="flow_negative">
        <di:waypoint x="565" y="460" />
        <di:waypoint x="755" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7">
        <di:waypoint x="780" y="600" />
        <di:waypoint x="938" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_8_di" bpmnElement="flow_8">
        <di:waypoint x="178" y="453" />
        <di:waypoint x="400" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_9_di" bpmnElement="flow_9">
        <di:waypoint x="400" y="600" />
        <di:waypoint x="755" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_10_di" bpmnElement="flow_10">
        <di:waypoint x="755" y="460" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_11_di" bpmnElement="flow_11">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="938" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_handover_di" bpmnElement="msg_flow_handover">
        <di:waypoint x="150" y="140" />
        <di:waypoint x="150" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_auth_req_di" bpmnElement="msg_flow_auth_req">
        <di:waypoint x="938" y="578" />
        <di:waypoint x="150" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_auth_conf_di" bpmnElement="msg_flow_auth_conf">
        <di:waypoint x="150" y="140" />
        <di:waypoint x="178" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_docs_dia0_di" bpmnElement="task_check_docs_dia0">
        <di:waypoint x="388" y="265" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_register_claim_doa0_di" bpmnElement="task_register_claim_doa0">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="578" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_insurance_dia0_di" bpmnElement="task_check_insurance_dia0">
        <di:waypoint x="198" y="850" />
        <di:waypoint x="210" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_assess_claim_doa0_di" bpmnElement="task_assess_claim_doa0">
        <di:waypoint x="400" y="475" />
        <di:waypoint x="578" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_send_letter_dia0_di" bpmnElement="task_send_letter_dia0">
        <di:waypoint x="578" y="850" />
        <di:waypoint x="780" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_send_letter_doa0_di" bpmnElement="task_send_letter_doa0">
        <di:waypoint x="780" y="725" />
        <di:waypoint x="768" y="850" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>