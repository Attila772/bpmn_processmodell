<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="CarInsuranceClaimProcess" name="Car Insurance Claim Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_SubmitClaim" name="Customer submits claim with documentation">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckDocuments" name="Check documents for completeness" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_SubmitClaim" targetRef="Task_CheckDocuments" />
    <bpmn:task id="Task_RegisterClaim" name="Register the claim" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckDocuments" targetRef="Task_RegisterClaim" />
    <bpmn:task id="Task_PickUpClaim" name="Pick up the claim" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_RegisterClaim" targetRef="Task_PickUpClaim" />
    <bpmn:task id="Task_CheckInsurance" name="Check the insurance" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PickUpClaim" targetRef="Task_CheckInsurance" />
    <bpmn:task id="Task_PerformAssessment" name="Perform assessment" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CheckInsurance" targetRef="Task_PerformAssessment" />
    <bpmn:exclusiveGateway id="Gateway_AssessmentResult" name="Assessment Result">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Positive</bpmn:outgoing>
      <bpmn:outgoing>Flow_Negative</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_PerformAssessment" targetRef="Gateway_AssessmentResult" />
    <bpmn:task id="Task_AuthoriseRepairs" name="Phone garage to authorise repairs" />
    <bpmn:sequenceFlow id="Flow_Positive" name="Positive" sourceRef="Gateway_AssessmentResult" targetRef="Task_AuthoriseRepairs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">assessment == 'positive'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Task_SchedulePayment" name="Schedule payment" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AuthoriseRepairs" targetRef="Task_SchedulePayment" />
    <bpmn:task id="Task_RejectClaim" name="Reject the claim" />
    <bpmn:sequenceFlow id="Flow_Negative" name="Negative" sourceRef="Gateway_AssessmentResult" targetRef="Task_RejectClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">assessment != 'positive'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:parallelGateway id="Gateway_MergeOutcomes" name="Merge Outcomes">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_RejectClaim" targetRef="Gateway_MergeOutcomes" />
    <bpmn:task id="Task_SendLetter" name="Send letter to customer" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_MergeOutcomes" targetRef="Task_SendLetter" />
    <bpmn:endEvent id="EndEvent_Complete" name="Process Complete">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SendLetter" targetRef="EndEvent_Complete" />
  </bpmn:process>
