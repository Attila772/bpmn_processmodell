<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mail_processing_unit_part" name="Mail Processing Unit" processRef="pool_mail_processing_unit_proc" />
    <bpmn:participant id="pool_registry_part" name="Registry" processRef="pool_registry_proc" />
    <bpmn:participant id="pool_cashier_part" name="Cashier" processRef="pool_cashier_proc" />
    <bpmn:messageFlow id="msg_1" sourceRef="evt_end_mail_distributed" targetRef="evt_start_registry_receipt" name="Distribute Mail" />
    <bpmn:messageFlow id="msg_2" sourceRef="evt_end_rejection_sent" targetRef="evt_start_mail_collection" name="Send Rejection List" />
    <bpmn:messageFlow id="msg_3" sourceRef="task_capture_matter_details" targetRef="evt_start_cashier_receipt" name="Provide Matter Details" />
    <bpmn:messageFlow id="msg_4" sourceRef="evt_end_receipt_posted" targetRef="evt_start_mail_collection" name="Post Receipt" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mail_processing_unit_proc" isExecutable="false">
    <bpmn:startEvent id="evt_start_mail_collection" name="Mail Collected from Party">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mail_distributed" name="Mail Distributed to Registry">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mail_distributed_msgdef" />
    </bpmn:endEvent>
    <bpmn:manualTask id="task_sort_mail" name="Sort unopened mail into business areas">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_mail_collection" targetRef="task_sort_mail" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_sort_mail" targetRef="evt_end_mail_distributed" />
  </bpmn:process>
  <bpmn:process id="pool_registry_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_manual_register" name="Manual Incoming Mail Register" dataObjectRef="data_manual_register_do" />
    <bpmn:dataObject id="data_manual_register_do" />
    <bpmn:dataObjectReference id="data_rejection_list" name="List of Requisition (Rejection)" dataObjectRef="data_rejection_list_do" />
    <bpmn:dataObject id="data_rejection_list_do" />
    <bpmn:dataObjectReference id="data_matter_details" name="Matter Details (Types of Action)" dataObjectRef="data_matter_details_do" />
    <bpmn:dataObject id="data_matter_details_do" />
    <bpmn:dataObjectReference id="data_receipt_p1" name="Receipt" dataObjectRef="data_receipt_p1_do" />
    <bpmn:dataObject id="data_receipt_p1_do" />
    <bpmn:startEvent id="evt_start_registry_receipt" name="Receive Mail at Registry">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_registry_receipt_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_rejection_sent" name="Rejection List Sent to Party">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_rejection_sent_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_receipt_posted" name="Receipt Posted to Party">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_receipt_posted_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_open_and_register" name="Open, sort, and register mail in Manual Incoming Mail Register">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_open_and_register_doa0">
        <bpmn:targetRef>data_manual_register</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_quality_check" name="Perform quality check on mail">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:property id="task_quality_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_quality_check_dia0">
        <bpmn:sourceRef>data_manual_register</bpmn:sourceRef>
        <bpmn:targetRef>task_quality_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_compile_rejection" name="Compile list of requisition explaining rejection">
      <bpmn:incoming>flow_to_rejection</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_compile_rejection_doa0">
        <bpmn:targetRef>data_rejection_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_capture_matter_details" name="Capture matter details (types of action)">
      <bpmn:incoming>flow_to_capture</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_capture_matter_details_doa0">
        <bpmn:targetRef>data_matter_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_prepare_envelope" name="Put receipt and copied documents into envelope">
      <bpmn:incoming>flow_10_pre_envelope</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:property id="task_prepare_envelope_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_prepare_envelope_dia0">
        <bpmn:sourceRef>data_receipt_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_prepare_envelope_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_compliance_check" name="Is mail compliant?" isMarkerVisible="true">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_to_rejection</bpmn:outgoing>
      <bpmn:outgoing>flow_to_capture</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_3" sourceRef="evt_start_registry_receipt" targetRef="task_open_and_register" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_open_and_register" targetRef="task_quality_check" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_quality_check" targetRef="gw_compliance_check" />
    <bpmn:sequenceFlow id="flow_to_rejection" sourceRef="gw_compliance_check" targetRef="task_compile_rejection" name="Not Compliant" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_compile_rejection" targetRef="evt_end_rejection_sent" />
    <bpmn:sequenceFlow id="flow_to_capture" sourceRef="gw_compliance_check" targetRef="task_capture_matter_details" name="Compliant" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_prepare_envelope" targetRef="evt_end_receipt_posted" />
  </bpmn:process>
  <bpmn:process id="pool_cashier_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_matter_details_p1" name="Matter Details (Types of Action)" dataObjectRef="data_matter_details_p1_do" />
    <bpmn:dataObject id="data_matter_details_p1_do" />
    <bpmn:dataObjectReference id="data_receipt" name="Receipt" dataObjectRef="data_receipt_do" />
    <bpmn:dataObject id="data_receipt_do" />
    <bpmn:dataObjectReference id="data_party_details" name="Party Details" dataObjectRef="data_party_details_do" />
    <bpmn:dataObject id="data_party_details_do" />
    <bpmn:dataObjectReference id="data_physical_court_file" name="Physical Court File" dataObjectRef="data_physical_court_file_do" />
    <bpmn:dataObject id="data_physical_court_file_do" />
    <bpmn:startEvent id="evt_start_cashier_receipt" name="Receive Matter Details for Fees">
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_cashier_receipt_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_court_file_printed" name="Physical Court File Printed">
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_take_fees" name="Take applicable fees attached to the mail">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9_internal</bpmn:outgoing>
      <bpmn:outgoing>flow_10_pre_envelope</bpmn:outgoing>
      <bpmn:property id="task_take_fees_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_take_fees_dia0">
        <bpmn:sourceRef>data_matter_details_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_take_fees_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_take_fees_doa0">
        <bpmn:targetRef>data_receipt</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_print_court_file" name="Print Physical Court File">
      <bpmn:incoming>flow_9_internal</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:property id="task_print_court_file_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_print_court_file_dia0">
        <bpmn:sourceRef>data_party_details</bpmn:sourceRef>
        <bpmn:targetRef>task_print_court_file_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_print_court_file_doa0">
        <bpmn:targetRef>data_physical_court_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_8" sourceRef="evt_start_cashier_receipt" targetRef="task_take_fees" />
    <bpmn:sequenceFlow id="flow_9_internal" sourceRef="task_take_fees" targetRef="task_print_court_file" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="task_print_court_file" targetRef="evt_end_court_file_printed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
