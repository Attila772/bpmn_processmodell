<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_csr_part" name="Customer Service Representative" processRef="pool_csr_proc" />
    <bpmn:participant id="pool_admin_part" name="Administration" processRef="pool_admin_proc" />
    <bpmn:messageFlow id="msg_flow_to_admin" sourceRef="evt_send_to_admin" targetRef="evt_received_by_admin" name="Case for Completion" />
  </bpmn:collaboration>
  <bpmn:process id="pool_csr_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_mortgage_offer" name="Mortgage Offer" dataObjectRef="data_mortgage_offer_do" />
    <bpmn:dataObject id="data_mortgage_offer_do" />
    <bpmn:dataObjectReference id="data_case_details" name="Case Details" dataObjectRef="data_case_details_do" />
    <bpmn:dataObject id="data_case_details_do" />
    <bpmn:dataObjectReference id="data_completed_offer" name="Completed Offer Documents" dataObjectRef="data_completed_offer_do" />
    <bpmn:dataObject id="data_completed_offer_do" />
    <bpmn:dataObjectReference id="data_prerequisite_docs" name="Prerequisite Documents" dataObjectRef="data_prerequisite_docs_do" />
    <bpmn:dataObject id="data_prerequisite_docs_do" />
    <bpmn:dataObjectReference id="data_request_message" name="Request for Outstanding Documents" dataObjectRef="data_request_message_do" />
    <bpmn:dataObject id="data_request_message_do" />
    <bpmn:startEvent id="evt_start" name="Process Start">
      <bpmn:outgoing>flow_start_send</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="evt_wait_reply" name="Wait for Customer Reply">
      <bpmn:incoming>flow_send_wait</bpmn:incoming>
      <bpmn:incoming>flow_request_wait</bpmn:incoming>
      <bpmn:outgoing>flow_wait_gateway</bpmn:outgoing>
      <bpmn:timerEventDefinition id="evt_wait_reply_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_receive_decline" name="Receive Decline">
      <bpmn:incoming>flow_decline</bpmn:incoming>
      <bpmn:outgoing>flow_decline_update</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_decline_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_receive_documents" name="Receive Completed Documents">
      <bpmn:incoming>flow_documents</bpmn:incoming>
      <bpmn:outgoing>flow_docs_check</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_receive_documents_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="evt_timeout" name="2 Weeks Timeout">
      <bpmn:incoming>flow_timeout</bpmn:incoming>
      <bpmn:outgoing>flow_timeout_update</bpmn:outgoing>
      <bpmn:timerEventDefinition id="evt_timeout_timerdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="evt_archive_cancel" name="Case Archived and Cancelled">
      <bpmn:incoming>flow_archive_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_send_to_admin" name="Send to Administration">
      <bpmn:incoming>flow_all_provided</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_send_to_admin_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_send_offer" name="Send Mortgage Offer">
      <bpmn:incoming>flow_start_send</bpmn:incoming>
      <bpmn:outgoing>flow_send_wait</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_send_offer_doa0">
        <bpmn:targetRef>data_mortgage_offer</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_update_details_decline" name="Update Case Details (Decline)">
      <bpmn:incoming>flow_decline_update</bpmn:incoming>
      <bpmn:outgoing>flow_update_archive</bpmn:outgoing>
      <bpmn:property id="task_update_details_decline_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_update_details_decline_dia0">
        <bpmn:sourceRef>data_case_details</bpmn:sourceRef>
        <bpmn:targetRef>task_update_details_decline_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_update_details_decline_doa0">
        <bpmn:targetRef>data_case_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_archive_cancel" name="Archive and Cancel">
      <bpmn:incoming>flow_update_archive</bpmn:incoming>
      <bpmn:incoming>flow_timeout_archive</bpmn:incoming>
      <bpmn:outgoing>flow_archive_end</bpmn:outgoing>
      <bpmn:property id="task_archive_cancel_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_archive_cancel_dia0">
        <bpmn:sourceRef>data_case_details</bpmn:sourceRef>
        <bpmn:targetRef>task_archive_cancel_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_prerequisites" name="Check Prerequisite Documents">
      <bpmn:incoming>flow_docs_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_gateway</bpmn:outgoing>
      <bpmn:property id="task_check_prerequisites_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_prerequisites_dia0">
        <bpmn:sourceRef>data_completed_offer</bpmn:sourceRef>
        <bpmn:targetRef>task_check_prerequisites_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_check_prerequisites_dia1">
        <bpmn:sourceRef>data_prerequisite_docs</bpmn:sourceRef>
        <bpmn:targetRef>task_check_prerequisites_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_request_outstanding" name="Request Outstanding Documents">
      <bpmn:incoming>flow_missing</bpmn:incoming>
      <bpmn:outgoing>flow_request_wait</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_request_outstanding_doa0">
        <bpmn:targetRef>data_request_message</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_update_details_timeout" name="Update Case Details (Timeout)">
      <bpmn:incoming>flow_timeout_update</bpmn:incoming>
      <bpmn:outgoing>flow_timeout_archive</bpmn:outgoing>
      <bpmn:property id="task_update_details_timeout_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_update_details_timeout_dia0">
        <bpmn:sourceRef>data_case_details</bpmn:sourceRef>
        <bpmn:targetRef>task_update_details_timeout_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_update_details_timeout_doa0">
        <bpmn:targetRef>data_case_details</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_reply_type" name="Reply Type?" isMarkerVisible="true">
      <bpmn:incoming>flow_wait_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_decline</bpmn:outgoing>
      <bpmn:outgoing>flow_documents</bpmn:outgoing>
      <bpmn:outgoing>flow_timeout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_prereq_check" name="All Prerequisites Provided?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_all_provided</bpmn:outgoing>
      <bpmn:outgoing>flow_missing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_send" sourceRef="evt_start" targetRef="task_send_offer" />
    <bpmn:sequenceFlow id="flow_send_wait" sourceRef="task_send_offer" targetRef="evt_wait_reply" />
    <bpmn:sequenceFlow id="flow_wait_gateway" sourceRef="evt_wait_reply" targetRef="gw_reply_type" />
    <bpmn:sequenceFlow id="flow_decline" sourceRef="gw_reply_type" targetRef="evt_receive_decline" name="Declined" />
    <bpmn:sequenceFlow id="flow_documents" sourceRef="gw_reply_type" targetRef="evt_receive_documents" name="Documents Received" />
    <bpmn:sequenceFlow id="flow_timeout" sourceRef="gw_reply_type" targetRef="evt_timeout" name="No Answer (2 weeks)" />
    <bpmn:sequenceFlow id="flow_decline_update" sourceRef="evt_receive_decline" targetRef="task_update_details_decline" />
    <bpmn:sequenceFlow id="flow_update_archive" sourceRef="task_update_details_decline" targetRef="task_archive_cancel" />
    <bpmn:sequenceFlow id="flow_archive_end" sourceRef="task_archive_cancel" targetRef="evt_archive_cancel" />
    <bpmn:sequenceFlow id="flow_docs_check" sourceRef="evt_receive_documents" targetRef="task_check_prerequisites" />
    <bpmn:sequenceFlow id="flow_check_gateway" sourceRef="task_check_prerequisites" targetRef="gw_prereq_check" />
    <bpmn:sequenceFlow id="flow_all_provided" sourceRef="gw_prereq_check" targetRef="evt_send_to_admin" name="Yes" />
    <bpmn:sequenceFlow id="flow_missing" sourceRef="gw_prereq_check" targetRef="task_request_outstanding" name="No" />
    <bpmn:sequenceFlow id="flow_request_wait" sourceRef="task_request_outstanding" targetRef="evt_wait_reply" />
    <bpmn:sequenceFlow id="flow_timeout_update" sourceRef="evt_timeout" targetRef="task_update_details_timeout" />
    <bpmn:sequenceFlow id="flow_timeout_archive" sourceRef="task_update_details_timeout" targetRef="task_archive_cancel" />
  </bpmn:process>
  <bpmn:process id="pool_admin_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_completed_offer_p1" name="Completed Offer Documents" dataObjectRef="data_completed_offer_p1_do" />
    <bpmn:dataObject id="data_completed_offer_p1_do" />
    <bpmn:dataObjectReference id="data_prerequisite_docs_p1" name="Prerequisite Documents" dataObjectRef="data_prerequisite_docs_p1_do" />
    <bpmn:dataObject id="data_prerequisite_docs_p1_do" />
    <bpmn:startEvent id="evt_received_by_admin" name="Received by Administration">
      <bpmn:outgoing>flow_admin_complete</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_received_by_admin_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_completion_done" name="Completion Done">
      <bpmn:incoming>flow_complete_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_complete_mortgage" name="Complete Mortgage">
      <bpmn:incoming>flow_admin_complete</bpmn:incoming>
      <bpmn:outgoing>flow_complete_end</bpmn:outgoing>
      <bpmn:property id="task_complete_mortgage_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_complete_mortgage_dia0">
        <bpmn:sourceRef>data_completed_offer_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_complete_mortgage_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_complete_mortgage_dia1">
        <bpmn:sourceRef>data_prerequisite_docs_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_complete_mortgage_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_admin_complete" sourceRef="evt_received_by_admin" targetRef="task_complete_mortgage" />
    <bpmn:sequenceFlow id="flow_complete_end" sourceRef="task_complete_mortgage" targetRef="evt_completion_done" />
  </bpmn:process>
