<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_crs_part" name="CRS (Repair Service)" processRef="pool_crs_proc" />
    <bpmn:participant id="pool_customer_part" name="Customer" processRef="pool_customer_proc" />
    <bpmn:messageFlow id="msg_flow_calculation" sourceRef="evt_msg_send_calculation" targetRef="evt_msg_receive_calculation" name="Repair Cost Calculation" />
    <bpmn:messageFlow id="msg_flow_accept_costs" sourceRef="gw_customer_decision" targetRef="gw_parallel_split" name="Costs acceptable" />
  </bpmn:collaboration>
  <bpmn:process id="pool_crs_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_defect_report" name="Defect Report" dataObjectRef="data_defect_report_do" />
    <bpmn:dataObject id="data_defect_report_do" />
    <bpmn:dataObjectReference id="data_cost_calculation" name="Repair Cost Calculation" dataObjectRef="data_cost_calculation_do" />
    <bpmn:dataObject id="data_cost_calculation_do" />
    <bpmn:dataObjectReference id="data_test_result" name="Test Result" dataObjectRef="data_test_result_do" />
    <bpmn:dataObject id="data_test_result_do" />
    <bpmn:startEvent id="evt_start" name="Customer brings in defective computer">
      <bpmn:outgoing>flow_start_to_check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_repair_finished" name="Repair finished">
      <bpmn:incoming>flow_no_error</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_send_calculation" name="Hand out repair cost calculation">
      <bpmn:incoming>flow_calc_to_msg_send</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_send_calculation_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:manualTask id="task_check_defect" name="Check the defect">
      <bpmn:incoming>flow_start_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_calc</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_check_defect_doa0">
        <bpmn:targetRef>data_defect_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_calculate_cost" name="Calculate repair cost">
      <bpmn:incoming>flow_check_to_calc</bpmn:incoming>
      <bpmn:outgoing>flow_calc_to_msg_send</bpmn:outgoing>
      <bpmn:property id="task_calculate_cost_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_calculate_cost_dia0">
        <bpmn:sourceRef>data_defect_report</bpmn:sourceRef>
        <bpmn:targetRef>task_calculate_cost_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_calculate_cost_doa0">
        <bpmn:targetRef>data_cost_calculation</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_hardware_repair" name="Check and repair hardware">
      <bpmn:incoming>flow_split_to_hw</bpmn:incoming>
      <bpmn:outgoing>flow_hw_to_join</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_software_config" name="Check and configure software">
      <bpmn:incoming>flow_split_to_sw</bpmn:incoming>
      <bpmn:outgoing>flow_sw_to_join</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_test_functionality" name="Test system functionality">
      <bpmn:incoming>flow_join_to_test</bpmn:incoming>
      <bpmn:incoming>flow_arbitrary_to_test</bpmn:incoming>
      <bpmn:outgoing>flow_test_to_gw</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_test_functionality_doa0">
        <bpmn:targetRef>data_test_result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_arbitrary_repair" name="Execute arbitrary repair activity">
      <bpmn:incoming>flow_error_detected</bpmn:incoming>
      <bpmn:outgoing>flow_arbitrary_to_test</bpmn:outgoing>
      <bpmn:property id="task_arbitrary_repair_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_arbitrary_repair_dia0">
        <bpmn:sourceRef>data_test_result</bpmn:sourceRef>
        <bpmn:targetRef>task_arbitrary_repair_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="gw_parallel_split" name="Start parallel repairs">
      <bpmn:outgoing>flow_split_to_hw</bpmn:outgoing>
      <bpmn:outgoing>flow_split_to_sw</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_parallel_join" name="Join parallel repairs">
      <bpmn:incoming>flow_hw_to_join</bpmn:incoming>
      <bpmn:incoming>flow_sw_to_join</bpmn:incoming>
      <bpmn:outgoing>flow_join_to_test</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gw_test_result" name="Error detected?" isMarkerVisible="true">
      <bpmn:incoming>flow_test_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_error_detected</bpmn:outgoing>
      <bpmn:outgoing>flow_no_error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_check" sourceRef="evt_start" targetRef="task_check_defect" />
    <bpmn:sequenceFlow id="flow_check_to_calc" sourceRef="task_check_defect" targetRef="task_calculate_cost" />
    <bpmn:sequenceFlow id="flow_calc_to_msg_send" sourceRef="task_calculate_cost" targetRef="evt_msg_send_calculation" />
    <bpmn:sequenceFlow id="flow_split_to_hw" sourceRef="gw_parallel_split" targetRef="task_hardware_repair" />
    <bpmn:sequenceFlow id="flow_split_to_sw" sourceRef="gw_parallel_split" targetRef="task_software_config" />
    <bpmn:sequenceFlow id="flow_hw_to_join" sourceRef="task_hardware_repair" targetRef="gw_parallel_join" />
    <bpmn:sequenceFlow id="flow_sw_to_join" sourceRef="task_software_config" targetRef="gw_parallel_join" />
    <bpmn:sequenceFlow id="flow_join_to_test" sourceRef="gw_parallel_join" targetRef="task_test_functionality" />
    <bpmn:sequenceFlow id="flow_test_to_gw" sourceRef="task_test_functionality" targetRef="gw_test_result" />
    <bpmn:sequenceFlow id="flow_error_detected" sourceRef="gw_test_result" targetRef="task_arbitrary_repair" name="Error detected" />
    <bpmn:sequenceFlow id="flow_no_error" sourceRef="gw_test_result" targetRef="evt_end_repair_finished" name="No error" />
    <bpmn:sequenceFlow id="flow_arbitrary_to_test" sourceRef="task_arbitrary_repair" targetRef="task_test_functionality" />
  </bpmn:process>
  <bpmn:process id="pool_customer_proc" isExecutable="false">
    <bpmn:endEvent id="evt_end_unrepaired" name="Customer takes computer home unrepaired">
      <bpmn:incoming>flow_reject_costs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="evt_msg_receive_calculation" name="Receive repair cost calculation">
      <bpmn:outgoing>flow_msg_recv_to_decision</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_receive_calculation_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="gw_customer_decision" name="Are costs acceptable?" isMarkerVisible="true">
      <bpmn:incoming>flow_msg_recv_to_decision</bpmn:incoming>
      <bpmn:outgoing>flow_reject_costs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_msg_recv_to_decision" sourceRef="evt_msg_receive_calculation" targetRef="gw_customer_decision" />
    <bpmn:sequenceFlow id="flow_reject_costs" sourceRef="gw_customer_decision" targetRef="evt_end_unrepaired" name="Costs not acceptable" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_crs_part_di" bpmnElement="pool_crs_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1520" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_customer_part_di" bpmnElement="pool_customer_part" isHorizontal="true">
        <dc:Bounds x="120" y="625" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_repair_finished_di" bpmnElement="evt_end_repair_finished">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_unrepaired_di" bpmnElement="evt_end_unrepaired">
        <dc:Bounds x="540" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_receive_calculation_di" bpmnElement="evt_msg_receive_calculation">
        <dc:Bounds x="160" y="685" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_send_calculation_di" bpmnElement="evt_msg_send_calculation">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_di" bpmnElement="evt_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_customer_decision_di" bpmnElement="gw_customer_decision">
        <dc:Bounds x="350" y="685" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_join_di" bpmnElement="gw_parallel_join">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_split_di" bpmnElement="gw_parallel_split">
        <dc:Bounds x="160" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_test_result_di" bpmnElement="gw_test_result">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_arbitrary_repair_di" bpmnElement="task_arbitrary_repair">
        <dc:Bounds x="1110" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_calculate_cost_di" bpmnElement="task_calculate_cost">
        <dc:Bounds x="540" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_defect_di" bpmnElement="task_check_defect">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_hardware_repair_di" bpmnElement="task_hardware_repair">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_software_config_di" bpmnElement="task_software_config">
        <dc:Bounds x="350" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_test_functionality_di" bpmnElement="task_test_functionality">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_defect_report_di" bpmnElement="data_defect_report">
        <dc:Bounds x="465" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_cost_calculation_di" bpmnElement="data_cost_calculation">
        <dc:Bounds x="560" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_test_result_di" bpmnElement="data_test_result">
        <dc:Bounds x="1225" y="490" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_check_di" bpmnElement="flow_start_to_check">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_calc_di" bpmnElement="flow_check_to_calc">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_calc_to_msg_send_di" bpmnElement="flow_calc_to_msg_send">
        <di:waypoint x="590" y="265" />
        <di:waypoint x="748" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_msg_recv_to_decision_di" bpmnElement="flow_msg_recv_to_decision">
        <di:waypoint x="178" y="703" />
        <di:waypoint x="375" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reject_costs_di" bpmnElement="flow_reject_costs">
        <di:waypoint x="375" y="710" />
        <di:waypoint x="558" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_split_to_hw_di" bpmnElement="flow_split_to_hw">
        <di:waypoint x="185" y="250" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_split_to_sw_di" bpmnElement="flow_split_to_sw">
        <di:waypoint x="185" y="250" />
        <di:waypoint x="400" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hw_to_join_di" bpmnElement="flow_hw_to_join">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sw_to_join_di" bpmnElement="flow_sw_to_join">
        <di:waypoint x="400" y="390" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_to_test_di" bpmnElement="flow_join_to_test">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_test_to_gw_di" bpmnElement="flow_test_to_gw">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_error_detected_di" bpmnElement="flow_error_detected">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_no_error_di" bpmnElement="flow_no_error">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_arbitrary_to_test_di" bpmnElement="flow_arbitrary_to_test">
        <di:waypoint x="1160" y="265" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_calculation_di" bpmnElement="msg_flow_calculation">
        <di:waypoint x="748" y="118" />
        <di:waypoint x="178" y="703" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_accept_costs_di" bpmnElement="msg_flow_accept_costs">
        <di:waypoint x="375" y="710" />
        <di:waypoint x="185" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_defect_doa0_di" bpmnElement="task_check_defect_doa0">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="483" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_calculate_cost_dia0_di" bpmnElement="task_calculate_cost_dia0">
        <di:waypoint x="483" y="515" />
        <di:waypoint x="590" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_calculate_cost_doa0_di" bpmnElement="task_calculate_cost_doa0">
        <di:waypoint x="590" y="265" />
        <di:waypoint x="578" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_test_functionality_doa0_di" bpmnElement="task_test_functionality_doa0">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1243" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_arbitrary_repair_dia0_di" bpmnElement="task_arbitrary_repair_dia0">
        <di:waypoint x="1243" y="515" />
        <di:waypoint x="1160" y="265" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>