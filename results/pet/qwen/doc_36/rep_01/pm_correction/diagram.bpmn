<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_files" name="Case Files" dataObjectRef="data_files_do" />
    <bpmn:dataObject id="data_files_do" />
    <bpmn:dataObjectReference id="data_files_ready" name="Ready Case Files" dataObjectRef="data_files_ready_do" />
    <bpmn:dataObject id="data_files_ready_do" />
    <bpmn:dataObjectReference id="data_lawlist" name="Judge's Lawlist" dataObjectRef="data_lawlist_do" />
    <bpmn:dataObject id="data_lawlist_do" />
    <bpmn:startEvent id="evt_start" name="Morning Start">
      <bpmn:outgoing>flow_start_check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end" name="Process Complete">
      <bpmn:incoming>flow_hearing_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_files" name="Check files for order">
      <bpmn:incoming>flow_start_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_gateway</bpmn:outgoing>
      <bpmn:property id="task_check_files_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_check_files_dia0">
        <bpmn:sourceRef>data_files</bpmn:sourceRef>
        <bpmn:targetRef>task_check_files_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_search_missing" name="Initiate search for missing files">
      <bpmn:incoming>flow_missing_yes</bpmn:incoming>
      <bpmn:outgoing>flow_search_merge</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_search_missing_doa0">
        <bpmn:targetRef>data_files</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_track_files" name="Physically track files to intended location">
      <bpmn:incoming>flow_missing_no</bpmn:incoming>
      <bpmn:outgoing>flow_track_merge</bpmn:outgoing>
      <bpmn:property id="task_track_files_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_track_files_dia0">
        <bpmn:sourceRef>data_files</bpmn:sourceRef>
        <bpmn:targetRef>task_track_files_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_track_files_doa0">
        <bpmn:targetRef>data_files_ready</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="task_hand_to_associate" name="Hand ready files to Associate">
      <bpmn:incoming>flow_parallel_handover</bpmn:incoming>
      <bpmn:outgoing>flow_handover_sync</bpmn:outgoing>
      <bpmn:property id="task_hand_to_associate_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_hand_to_associate_dia0">
        <bpmn:sourceRef>data_files_ready</bpmn:sourceRef>
        <bpmn:targetRef>task_hand_to_associate_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="task_distribute_lawlist" name="Distribute Judge's Lawlist">
      <bpmn:incoming>flow_parallel_lawlist</bpmn:incoming>
      <bpmn:outgoing>flow_lawlist_sync</bpmn:outgoing>
      <bpmn:property id="task_distribute_lawlist_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_distribute_lawlist_dia0">
        <bpmn:sourceRef>data_lawlist</bpmn:sourceRef>
        <bpmn:targetRef>task_distribute_lawlist_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:task id="task_conduct_hearings" name="Conduct directions hearings">
      <bpmn:incoming>flow_sync_hearing</bpmn:incoming>
      <bpmn:outgoing>flow_hearing_end</bpmn:outgoing>
      <bpmn:property id="task_conduct_hearings_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_conduct_hearings_dia0">
        <bpmn:sourceRef>data_files_ready</bpmn:sourceRef>
        <bpmn:targetRef>task_conduct_hearings_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="task_conduct_hearings_dia1">
        <bpmn:sourceRef>data_lawlist</bpmn:sourceRef>
        <bpmn:targetRef>task_conduct_hearings_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_missing_check" name="Are files missing?" isMarkerVisible="true">
      <bpmn:incoming>flow_check_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_missing_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_missing_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_merge_tracking" name="Merge Tracking/Search">
      <bpmn:incoming>flow_search_merge</bpmn:incoming>
      <bpmn:incoming>flow_track_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_parallel</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_parallel_prep" name="Start Parallel Preparations">
      <bpmn:incoming>flow_merge_parallel</bpmn:incoming>
      <bpmn:outgoing>flow_parallel_handover</bpmn:outgoing>
      <bpmn:outgoing>flow_parallel_lawlist</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gw_sync_hearing" name="Sync for Hearings">
      <bpmn:incoming>flow_handover_sync</bpmn:incoming>
      <bpmn:incoming>flow_lawlist_sync</bpmn:incoming>
      <bpmn:outgoing>flow_sync_hearing</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_start_check" sourceRef="evt_start" targetRef="task_check_files" />
    <bpmn:sequenceFlow id="flow_check_gateway" sourceRef="task_check_files" targetRef="gw_missing_check" />
    <bpmn:sequenceFlow id="flow_missing_yes" sourceRef="gw_missing_check" targetRef="task_search_missing" name="igen" />
    <bpmn:sequenceFlow id="flow_missing_no" sourceRef="gw_missing_check" targetRef="task_track_files" name="nem" />
    <bpmn:sequenceFlow id="flow_search_merge" sourceRef="task_search_missing" targetRef="gw_merge_tracking" />
    <bpmn:sequenceFlow id="flow_track_merge" sourceRef="task_track_files" targetRef="gw_merge_tracking" />
    <bpmn:sequenceFlow id="flow_merge_parallel" sourceRef="gw_merge_tracking" targetRef="gw_parallel_prep" />
    <bpmn:sequenceFlow id="flow_parallel_handover" sourceRef="gw_parallel_prep" targetRef="task_hand_to_associate" />
    <bpmn:sequenceFlow id="flow_parallel_lawlist" sourceRef="gw_parallel_prep" targetRef="task_distribute_lawlist" />
    <bpmn:sequenceFlow id="flow_handover_sync" sourceRef="task_hand_to_associate" targetRef="gw_sync_hearing" />
    <bpmn:sequenceFlow id="flow_lawlist_sync" sourceRef="task_distribute_lawlist" targetRef="gw_sync_hearing" />
    <bpmn:sequenceFlow id="flow_sync_hearing" sourceRef="gw_sync_hearing" targetRef="task_conduct_hearings" />
    <bpmn:sequenceFlow id="flow_hearing_end" sourceRef="task_conduct_hearings" targetRef="evt_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_di" bpmnElement="evt_end">
        <dc:Bounds x="1870" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_di" bpmnElement="evt_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_tracking_di" bpmnElement="gw_merge_tracking">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_missing_check_di" bpmnElement="gw_missing_check">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_prep_di" bpmnElement="gw_parallel_prep">
        <dc:Bounds x="1110" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sync_hearing_di" bpmnElement="gw_sync_hearing">
        <dc:Bounds x="1490" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_files_di" bpmnElement="task_check_files">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_conduct_hearings_di" bpmnElement="task_conduct_hearings">
        <dc:Bounds x="1680" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_distribute_lawlist_di" bpmnElement="task_distribute_lawlist">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_hand_to_associate_di" bpmnElement="task_hand_to_associate">
        <dc:Bounds x="1300" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_search_missing_di" bpmnElement="task_search_missing">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_track_files_di" bpmnElement="task_track_files">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_files_di" bpmnElement="data_files">
        <dc:Bounds x="623" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_files_ready_di" bpmnElement="data_files_ready">
        <dc:Bounds x="1256" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_lawlist_di" bpmnElement="data_lawlist">
        <dc:Bounds x="1510" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_check_di" bpmnElement="flow_start_check">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_gateway_di" bpmnElement="flow_check_gateway">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_missing_yes_di" bpmnElement="flow_missing_yes">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_missing_no_di" bpmnElement="flow_missing_no">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_merge_di" bpmnElement="flow_search_merge">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_track_merge_di" bpmnElement="flow_track_merge">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_parallel_di" bpmnElement="flow_merge_parallel">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1135" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_parallel_handover_di" bpmnElement="flow_parallel_handover">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_parallel_lawlist_di" bpmnElement="flow_parallel_lawlist">
        <di:waypoint x="1135" y="125" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_handover_sync_di" bpmnElement="flow_handover_sync">
        <di:waypoint x="1350" y="265" />
        <di:waypoint x="1515" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_lawlist_sync_di" bpmnElement="flow_lawlist_sync">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1515" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sync_hearing_di" bpmnElement="flow_sync_hearing">
        <di:waypoint x="1515" y="125" />
        <di:waypoint x="1730" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hearing_end_di" bpmnElement="flow_hearing_end">
        <di:waypoint x="1730" y="140" />
        <di:waypoint x="1888" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_check_files_dia0_di" bpmnElement="task_check_files_dia0">
        <di:waypoint x="641" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_search_missing_doa0_di" bpmnElement="task_search_missing_doa0">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="641" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_track_files_dia0_di" bpmnElement="task_track_files_dia0">
        <di:waypoint x="641" y="390" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_track_files_doa0_di" bpmnElement="task_track_files_doa0">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="1274" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_hand_to_associate_dia0_di" bpmnElement="task_hand_to_associate_dia0">
        <di:waypoint x="1274" y="390" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_distribute_lawlist_dia0_di" bpmnElement="task_distribute_lawlist_dia0">
        <di:waypoint x="1528" y="390" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_conduct_hearings_dia0_di" bpmnElement="task_conduct_hearings_dia0">
        <di:waypoint x="1274" y="390" />
        <di:waypoint x="1730" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_conduct_hearings_dia1_di" bpmnElement="task_conduct_hearings_dia1">
        <di:waypoint x="1528" y="390" />
        <di:waypoint x="1730" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>