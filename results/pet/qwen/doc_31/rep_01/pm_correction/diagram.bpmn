<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_employee_part" name="Employee" processRef="pool_employee_proc" />
    <bpmn:participant id="pool_supervisor_part" name="Immediate Supervisor" processRef="pool_supervisor_proc" />
    <bpmn:participant id="pool_hr_part" name="Human Resources" processRef="pool_hr_proc" />
    <bpmn:messageFlow id="msg_flow_1" sourceRef="evt_msg_send_approval" targetRef="evt_msg_recv_approval" name="Approval Notification" />
    <bpmn:messageFlow id="msg_flow_rejected" sourceRef="gw_decision" targetRef="task_review_rejection" name="Rejection Notification" />
    <bpmn:messageFlow id="msg_flow_request" sourceRef="task_submit_request" targetRef="task_supervisor_decision" name="Vacation Request Submission" />
  </bpmn:collaboration>
  <bpmn:process id="pool_employee_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request" name="Vacation Request" dataObjectRef="data_vacation_request_do" />
    <bpmn:dataObject id="data_vacation_request_do" />
    <bpmn:startEvent id="evt_start_request" name="Submit Vacation Request">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_rejected" name="Request Rejected">
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_submit_request" name="Register Vacation Request">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:dataOutputAssociation id="task_submit_request_doa0">
        <bpmn:targetRef>data_vacation_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="task_review_rejection" name="Review Rejection Reasons">
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:property id="task_review_rejection_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_review_rejection_dia0">
        <bpmn:sourceRef>data_vacation_request</bpmn:sourceRef>
        <bpmn:targetRef>task_review_rejection_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start_request" targetRef="task_submit_request" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_review_rejection" targetRef="evt_end_rejected" />
  </bpmn:process>
  <bpmn:process id="pool_supervisor_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request_p1" name="Vacation Request" dataObjectRef="data_vacation_request_p1_do" />
    <bpmn:dataObject id="data_vacation_request_p1_do" />
    <bpmn:intermediateThrowEvent id="evt_msg_send_approval" name="Send Approval Notification">
      <bpmn:incoming>flow_approved</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_msg_send_approval_msgdef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="task_supervisor_decision" name="Approve or Reject Request">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:property id="task_supervisor_decision_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_supervisor_decision_dia0">
        <bpmn:sourceRef>data_vacation_request_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_supervisor_decision_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task_supervisor_decision_doa0">
        <bpmn:targetRef>data_vacation_request_p1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_decision" name="Decision Gateway" isMarkerVisible="true">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_supervisor_decision" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="flow_approved" sourceRef="gw_decision" targetRef="evt_msg_send_approval" name="Approved" />
  </bpmn:process>
  <bpmn:process id="pool_hr_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_vacation_request_p2" name="Vacation Request" dataObjectRef="data_vacation_request_p2_do" />
    <bpmn:dataObject id="data_vacation_request_p2_do" />
    <bpmn:startEvent id="evt_msg_recv_approval" name="Receive Approval Notification">
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_msg_recv_approval_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_hr_complete" name="Management Procedures Completed">
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_hr_management" name="Complete Management Procedures">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:property id="task_hr_management_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_hr_management_dia0">
        <bpmn:sourceRef>data_vacation_request_p2</bpmn:sourceRef>
        <bpmn:targetRef>task_hr_management_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_5" sourceRef="evt_msg_recv_approval" targetRef="task_hr_management" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_hr_management" targetRef="evt_end_hr_complete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_employee_part_di" bpmnElement="pool_employee_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="700" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_supervisor_part_di" bpmnElement="pool_supervisor_part" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_hr_part_di" bpmnElement="pool_hr_part" isHorizontal="true">
        <dc:Bounds x="120" y="835" width="760" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_hr_complete_di" bpmnElement="evt_end_hr_complete">
        <dc:Bounds x="540" y="895" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_rejected_di" bpmnElement="evt_end_rejected">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_recv_approval_di" bpmnElement="evt_msg_recv_approval">
        <dc:Bounds x="160" y="895" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_msg_send_approval_di" bpmnElement="evt_msg_send_approval">
        <dc:Bounds x="540" y="560" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_request_di" bpmnElement="evt_start_request">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_di" bpmnElement="gw_decision">
        <dc:Bounds x="350" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_hr_management_di" bpmnElement="task_hr_management">
        <dc:Bounds x="350" y="895" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_rejection_di" bpmnElement="task_review_rejection">
        <dc:Bounds x="160" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_request_di" bpmnElement="task_submit_request">
        <dc:Bounds x="350" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_supervisor_decision_di" bpmnElement="task_supervisor_decision">
        <dc:Bounds x="160" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_di" bpmnElement="data_vacation_request">
        <dc:Bounds x="275" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_p1_di" bpmnElement="data_vacation_request_p1">
        <dc:Bounds x="180" y="700" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_vacation_request_p2_di" bpmnElement="data_vacation_request_p2">
        <dc:Bounds x="370" y="1035" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="210" y="600" />
        <di:waypoint x="375" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approved_di" bpmnElement="flow_approved">
        <di:waypoint x="375" y="585" />
        <di:waypoint x="558" y="578" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="210" y="265" />
        <di:waypoint x="368" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="178" y="913" />
        <di:waypoint x="400" y="935" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="400" y="935" />
        <di:waypoint x="558" y="913" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_1_di" bpmnElement="msg_flow_1">
        <di:waypoint x="558" y="578" />
        <di:waypoint x="178" y="913" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_rejected_di" bpmnElement="msg_flow_rejected">
        <di:waypoint x="375" y="585" />
        <di:waypoint x="210" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_flow_request_di" bpmnElement="msg_flow_request">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="210" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_submit_request_doa0_di" bpmnElement="task_submit_request_doa0">
        <di:waypoint x="400" y="265" />
        <di:waypoint x="293" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_review_rejection_dia0_di" bpmnElement="task_review_rejection_dia0">
        <di:waypoint x="293" y="390" />
        <di:waypoint x="210" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_supervisor_decision_dia0_di" bpmnElement="task_supervisor_decision_dia0">
        <di:waypoint x="198" y="725" />
        <di:waypoint x="210" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_supervisor_decision_doa0_di" bpmnElement="task_supervisor_decision_doa0">
        <di:waypoint x="210" y="600" />
        <di:waypoint x="198" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_hr_management_dia0_di" bpmnElement="task_hr_management_dia0">
        <di:waypoint x="388" y="1060" />
        <di:waypoint x="400" y="935" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>