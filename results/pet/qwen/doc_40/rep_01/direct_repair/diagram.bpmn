<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="WarrantPossessionProcess" name="Warrant Possession Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Warrant Possession Request Received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve SCT File">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ForwardToPolice" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StorePhysicalFile" name="Store SCT Physical File">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_WaitForReport" name="Wait for Police Report">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PoliceReport" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_RetrieveFileAgain" name="Retrieve Respective SCT File">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AttachAndStore" name="Attach New SCT Document and Store Expanded File">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="File Handed Over to Internal Staff">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_RetrieveSCTFile" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RetrieveSCTFile" targetRef="Task_ForwardToPolice" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ForwardToPolice" targetRef="Task_StorePhysicalFile" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_StorePhysicalFile" targetRef="Event_WaitForReport" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_WaitForReport" targetRef="Task_RetrieveFileAgain" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RetrieveFileAgain" targetRef="Task_AttachAndStore" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AttachAndStore" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmn:message id="Message_PoliceReport" name="Police Report" />
  <bpmn:collaboration id="Collaboration_1" name="Collaboration">
    <bpmn:participant id="Participant_ClientServiceBackOffice" name="Client Service Back Office (Small Claims Registry Operations)" processRef="WarrantPossessionProcess" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_ClientServiceBackOffice_di" bpmnElement="Participant_ClientServiceBackOffice" isHorizontal="true">
        <dc:Bounds x="100" y="100" width="900" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="150" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="215" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetrieveSCTFile_di" bpmnElement="Task_RetrieveSCTFile">
        <dc:Bounds x="240" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ForwardToPolice_di" bpmnElement="Task_ForwardToPolice">
        <dc:Bounds x="390" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StorePhysicalFile_di" bpmnElement="Task_StorePhysicalFile">
        <dc:Bounds x="540" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_WaitForReport_di" bpmnElement="Event_WaitForReport" isMarkerVisible="true">
        <dc:Bounds x="692" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="670" y="215" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetrieveFileAgain_di" bpmnElement="Task_RetrieveFileAgain">
        <dc:Bounds x="780" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AttachAndStore_di" bpmnElement="Task_AttachAndStore">
        <dc:Bounds x="930" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1082" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1060" y="215" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="186" y="190" />
        <di:waypoint x="240" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="190" />
        <di:waypoint x="390" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="490" y="190" />
        <di:waypoint x="540" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="640" y="190" />
        <di:waypoint x="692" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="728" y="190" />
        <di:waypoint x="780" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="880" y="190" />
        <di:waypoint x="930" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1030" y="190" />
        <di:waypoint x="1082" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>