<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool_mpon_part" name="MPON" processRef="pool_mpon_proc" />
    <bpmn:participant id="pool_go_part" name="GO" processRef="pool_go_proc" />
    <bpmn:participant id="pool_mpo_part" name="MPOO" processRef="pool_mpo_proc" />
    <bpmn:participant id="pool_mspon_part" name="MSPO" processRef="pool_mspon_proc" />
    <bpmn:participant id="pool_sp_part" name="SP" processRef="pool_sp_proc" />
    <bpmn:messageFlow id="msg_mpon_to_go_report" sourceRef="evt_end_mpon_report" targetRef="evt_start_go_receive_report" name="Meter Operation Report" />
    <bpmn:messageFlow id="msg_go_to_mpon_reject" sourceRef="evt_end_go_reject" targetRef="evt_start_mpon_receive_reject" name="Rejection Notice" />
    <bpmn:messageFlow id="msg_go_to_mpon_conf" sourceRef="evt_end_go_confirm_reg" targetRef="evt_start_mpon_receive_conf" name="Registration Confirmation" />
    <bpmn:messageFlow id="msg_go_to_mpo_conf" sourceRef="evt_end_go_confirm_reg" targetRef="evt_start_mpo_receive_conf" name="Registration Confirmation" />
    <bpmn:messageFlow id="msg_go_to_mspon_conf" sourceRef="evt_end_go_confirm_reg" targetRef="evt_start_mspon_receive_conf" name="Registration Confirmation" />
    <bpmn:messageFlow id="msg_mpon_to_go_fail" sourceRef="evt_end_mpon_fail_proc" targetRef="evt_start_go_receive_fail" name="Process Failure Report" />
    <bpmn:messageFlow id="msg_mpon_to_go_success" sourceRef="evt_end_mpon_success_proc" targetRef="evt_start_go_receive_success" name="Process Success Report" />
    <bpmn:messageFlow id="msg_go_to_mpon_fail_assign" sourceRef="evt_end_go_fail_assign" targetRef="evt_start_mpon_receive_fail_assign" name="Assignment Failure Notice" />
    <bpmn:messageFlow id="msg_go_to_mpon_assign" sourceRef="evt_end_go_assign_mpon" targetRef="evt_start_mpon_receive_assign" name="Assignment Confirmation" />
    <bpmn:messageFlow id="msg_go_to_mpo_fail" sourceRef="evt_end_go_notify_mpo_fail" targetRef="evt_start_mpo_receive_fail" name="Assignment Failure Notification" />
    <bpmn:messageFlow id="msg_go_to_mpo_assign" sourceRef="evt_end_go_notify_mpo_assign" targetRef="evt_start_mpo_receive_assign" name="Assignment Notification" />
    <bpmn:messageFlow id="msg_go_to_mspon_fail" sourceRef="evt_end_go_notify_mspon_fail" targetRef="evt_start_mspon_receive_fail" name="Assignment Failure Notification" />
    <bpmn:messageFlow id="msg_go_to_mspon_assign" sourceRef="evt_end_go_notify_mspon_assign" targetRef="evt_start_mspon_receive_assign" name="Assignment Notification" />
    <bpmn:messageFlow id="msg_go_to_sp" sourceRef="evt_end_go_notify_sp" targetRef="evt_start_sp_receive" name="SP Assignment Notification" />
  </bpmn:collaboration>
  <bpmn:process id="pool_mpon_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_meter_report" name="Meter Operation Report" dataObjectRef="data_meter_report_do" />
    <bpmn:dataObject id="data_meter_report_do" />
    <bpmn:startEvent id="evt_start_mpon" name="Process Start (MPON)">
      <bpmn:outgoing>flow_mpon_start_report</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mpon_report" name="Report Meter Operation Sent">
      <bpmn:incoming>flow_mpon_report_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mpon_report_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_mpon_receive_reject" name="Receive Rejection">
      <bpmn:outgoing>flow_mpon_reject_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mpon_receive_reject_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_mpon_receive_conf" name="Receive Registration Confirmation">
      <bpmn:outgoing>flow_mpon_conf_start_equip</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mpon_receive_conf_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mpon_fail_proc" name="Process Failure Reported">
      <bpmn:incoming>flow_mpon_fail</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mpon_fail_proc_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_mpon_success_proc" name="Process Success Reported">
      <bpmn:incoming>flow_mpon_success</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_mpon_success_proc_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_mpon_receive_fail_assign" name="Receive Assignment Failure">
      <bpmn:outgoing>flow_mpon_recv_fail_assign_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mpon_receive_fail_assign_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_mpon_receive_assign" name="Receive Assignment Confirmation">
      <bpmn:outgoing>flow_mpon_recv_assign_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_mpon_receive_assign_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_mpon_process_fail" name="Process End (Failure)">
      <bpmn:incoming>flow_mpon_reject_end</bpmn:incoming>
      <bpmn:incoming>flow_mpon_recv_fail_assign_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_mpon_process_success" name="Process End (Success)">
      <bpmn:incoming>flow_mpon_recv_assign_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_mpon_report" name="Report meter operation to GO">
      <bpmn:incoming>flow_mpon_start_report</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_report_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_mpon_report_doa0">
        <bpmn:targetRef>data_meter_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="task_mpon_equipment" name="Perform equipment acquisition / changes">
      <bpmn:incoming>flow_mpon_conf_start_equip</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_equip_gw</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_mpon_result" name="Decision: Process Result" isMarkerVisible="true">
      <bpmn:incoming>flow_mpon_equip_gw</bpmn:incoming>
      <bpmn:outgoing>flow_mpon_fail</bpmn:outgoing>
      <bpmn:outgoing>flow_mpon_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_mpon_start_report" sourceRef="evt_start_mpon" targetRef="task_mpon_report" />
    <bpmn:sequenceFlow id="flow_mpon_report_end" sourceRef="task_mpon_report" targetRef="evt_end_mpon_report" />
    <bpmn:sequenceFlow id="flow_mpon_reject_end" sourceRef="evt_start_mpon_receive_reject" targetRef="evt_end_mpon_process_fail" />
    <bpmn:sequenceFlow id="flow_mpon_conf_start_equip" sourceRef="evt_start_mpon_receive_conf" targetRef="task_mpon_equipment" />
    <bpmn:sequenceFlow id="flow_mpon_equip_gw" sourceRef="task_mpon_equipment" targetRef="gw_mpon_result" />
    <bpmn:sequenceFlow id="flow_mpon_fail" sourceRef="gw_mpon_result" targetRef="evt_end_mpon_fail_proc" name="Failure" />
    <bpmn:sequenceFlow id="flow_mpon_success" sourceRef="gw_mpon_result" targetRef="evt_end_mpon_success_proc" name="Success" />
    <bpmn:sequenceFlow id="flow_mpon_recv_fail_assign_end" sourceRef="evt_start_mpon_receive_fail_assign" targetRef="evt_end_mpon_process_fail" />
    <bpmn:sequenceFlow id="flow_mpon_recv_assign_end" sourceRef="evt_start_mpon_receive_assign" targetRef="evt_end_mpon_process_success" />
  </bpmn:process>
  <bpmn:process id="pool_go_proc" isExecutable="false">
    <bpmn:dataObjectReference id="data_meter_report_p1" name="Meter Operation Report" dataObjectRef="data_meter_report_p1_do" />
    <bpmn:dataObject id="data_meter_report_p1_do" />
    <bpmn:startEvent id="evt_start_go_receive_report" name="Receive Meter Operation Report">
      <bpmn:outgoing>flow_go_start_examine</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_go_receive_report_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_go_reject" name="Application Rejected">
      <bpmn:incoming>flow_go_reject</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_reject_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_go_confirm_reg" name="Registration Confirmed">
      <bpmn:incoming>flow_go_confirm</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_confirm_reg_msgdef" />
    </bpmn:endEvent>
    <bpmn:startEvent id="evt_start_go_timeout" name="Timeout Reached">
      <bpmn:outgoing>flow_go_timeout_start</bpmn:outgoing>
      <bpmn:timerEventDefinition id="evt_start_go_timeout_timerdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_go_receive_fail" name="Receive Process Failure">
      <bpmn:outgoing>flow_go_recv_fail_start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_go_receive_fail_msgdef" />
    </bpmn:startEvent>
    <bpmn:startEvent id="evt_start_go_receive_success" name="Receive Process Success">
      <bpmn:outgoing>flow_go_recv_success_start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_start_go_receive_success_msgdef" />
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_go_fail_assign" name="Assignment Failure Confirmed">
      <bpmn:incoming>flow_go_handle_fail_end</bpmn:incoming>
      <bpmn:outgoing>flow_go_notify_mpo_fail</bpmn:outgoing>
      <bpmn:outgoing>flow_go_notify_mspon_fail</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_end_go_fail_assign_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_go_assign_mpon" name="MPON Assigned">
      <bpmn:incoming>flow_go_assign_end</bpmn:incoming>
      <bpmn:outgoing>flow_go_notify_mpo_assign</bpmn:outgoing>
      <bpmn:outgoing>flow_go_notify_mspon_assign</bpmn:outgoing>
      <bpmn:outgoing>flow_go_notify_sp</bpmn:outgoing>
      <bpmn:messageEventDefinition id="evt_end_go_assign_mpon_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_go_notify_mpo_fail" name="Notify MPOO of Failure">
      <bpmn:incoming>flow_go_notify_mpo_fail</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_notify_mpo_fail_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_go_notify_mpo_assign" name="Notify MPOO of Assignment">
      <bpmn:incoming>flow_go_notify_mpo_assign</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_notify_mpo_assign_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_go_notify_mspon_fail" name="Notify MSPO of Failure">
      <bpmn:incoming>flow_go_notify_mspon_fail</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_notify_mspon_fail_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_go_notify_mspon_assign" name="Notify MSPO of Assignment">
      <bpmn:incoming>flow_go_notify_mspon_assign</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_notify_mspon_assign_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_go_notify_sp" name="Notify SP of Assignment">
      <bpmn:incoming>flow_go_notify_sp</bpmn:incoming>
      <bpmn:messageEventDefinition id="evt_end_go_notify_sp_msgdef" />
    </bpmn:endEvent>
    <bpmn:userTask id="task_go_examine" name="Examine application of MPON">
      <bpmn:incoming>flow_go_start_examine</bpmn:incoming>
      <bpmn:outgoing>flow_go_examine_gw</bpmn:outgoing>
      <bpmn:property id="task_go_examine_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_go_examine_dia0">
        <bpmn:sourceRef>data_meter_report_p1</bpmn:sourceRef>
        <bpmn:targetRef>task_go_examine_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_go_handle_failure" name="Confirm failure of assignment">
      <bpmn:incoming>flow_go_fail_assign</bpmn:incoming>
      <bpmn:outgoing>flow_go_handle_fail_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_go_assign" name="Assign the MPON">
      <bpmn:incoming>flow_go_success_assign</bpmn:incoming>
      <bpmn:outgoing>flow_go_assign_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_go_decision" name="Decision: Reject or Confirm Application" isMarkerVisible="true">
      <bpmn:incoming>flow_go_examine_gw</bpmn:incoming>
      <bpmn:outgoing>flow_go_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_go_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_go_outcome" name="Decision: Assignment Outcome" isMarkerVisible="true">
      <bpmn:incoming>flow_go_timeout_start</bpmn:incoming>
      <bpmn:incoming>flow_go_recv_fail_start</bpmn:incoming>
      <bpmn:incoming>flow_go_recv_success_start</bpmn:incoming>
      <bpmn:outgoing>flow_go_fail_assign</bpmn:outgoing>
      <bpmn:outgoing>flow_go_success_assign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_go_start_examine" sourceRef="evt_start_go_receive_report" targetRef="task_go_examine" />
    <bpmn:sequenceFlow id="flow_go_examine_gw" sourceRef="task_go_examine" targetRef="gw_go_decision" />
    <bpmn:sequenceFlow id="flow_go_reject" sourceRef="gw_go_decision" targetRef="evt_end_go_reject" name="Reject" />
    <bpmn:sequenceFlow id="flow_go_confirm" sourceRef="gw_go_decision" targetRef="evt_end_go_confirm_reg" name="Confirm" />
    <bpmn:sequenceFlow id="flow_go_timeout_start" sourceRef="evt_start_go_timeout" targetRef="gw_go_outcome" />
    <bpmn:sequenceFlow id="flow_go_recv_fail_start" sourceRef="evt_start_go_receive_fail" targetRef="gw_go_outcome" />
    <bpmn:sequenceFlow id="flow_go_recv_success_start" sourceRef="evt_start_go_receive_success" targetRef="gw_go_outcome" />
    <bpmn:sequenceFlow id="flow_go_fail_assign" sourceRef="gw_go_outcome" targetRef="task_go_handle_failure" name="Failure/Timeout" />
    <bpmn:sequenceFlow id="flow_go_success_assign" sourceRef="gw_go_outcome" targetRef="task_go_assign" name="Success" />
    <bpmn:sequenceFlow id="flow_go_handle_fail_end" sourceRef="task_go_handle_failure" targetRef="evt_end_go_fail_assign" />
    <bpmn:sequenceFlow id="flow_go_assign_end" sourceRef="task_go_assign" targetRef="evt_end_go_assign_mpon" />
    <bpmn:sequenceFlow id="flow_go_notify_mpo_fail" sourceRef="evt_end_go_fail_assign" targetRef="evt_end_go_notify_mpo_fail" />
    <bpmn:sequenceFlow id="flow_go_notify_mpo_assign" sourceRef="evt_end_go_assign_mpon" targetRef="evt_end_go_notify_mpo_assign" />
    <bpmn:sequenceFlow id="flow_go_notify_mspon_fail" sourceRef="evt_end_go_fail_assign" targetRef="evt_end_go_notify_mspon_fail" />
    <bpmn:sequenceFlow id="flow_go_notify_mspon_assign" sourceRef="evt_end_go_assign_mpon" targetRef="evt_end_go_notify_mspon_assign" />
    <bpmn:sequenceFlow id="flow_go_notify_sp" sourceRef="evt_end_go_assign_mpon" targetRef="evt_end_go_notify_sp" />
  </bpmn:process>
  <bpmn:process id="pool_mpo_proc" isExecutable="false">
    <bpmn:endEvent id="evt_start_mpo_receive_conf" name="Receive Registration Confirmation">
      <bpmn:messageEventDefinition id="evt_start_mpo_receive_conf_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_start_mpo_receive_fail" name="Receive Assignment Failure">
      <bpmn:messageEventDefinition id="evt_start_mpo_receive_fail_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_start_mpo_receive_assign" name="Receive Assignment">
      <bpmn:messageEventDefinition id="evt_start_mpo_receive_assign_msgdef" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="pool_mspon_proc" isExecutable="false">
    <bpmn:endEvent id="evt_start_mspon_receive_conf" name="Receive Registration Confirmation">
      <bpmn:messageEventDefinition id="evt_start_mspon_receive_conf_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_start_mspon_receive_fail" name="Receive Assignment Failure">
      <bpmn:messageEventDefinition id="evt_start_mspon_receive_fail_msgdef" />
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_start_mspon_receive_assign" name="Receive Assignment">
      <bpmn:messageEventDefinition id="evt_start_mspon_receive_assign_msgdef" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="pool_sp_proc" isExecutable="false">
    <bpmn:endEvent id="evt_start_sp_receive" name="Receive SP Notification">
      <bpmn:messageEventDefinition id="evt_start_sp_receive_msgdef" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="pool_mpon_part_di" bpmnElement="pool_mpon_part" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="950" height="775" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_go_part_di" bpmnElement="pool_go_part" isHorizontal="true">
        <dc:Bounds x="120" y="875" width="1140" height="775" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_mpo_part_di" bpmnElement="pool_mpo_part" isHorizontal="true">
        <dc:Bounds x="120" y="1710" width="700" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_mspon_part_di" bpmnElement="pool_mspon_part" isHorizontal="true">
        <dc:Bounds x="120" y="2295" width="700" height="525" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_sp_part_di" bpmnElement="pool_sp_part" isHorizontal="true">
        <dc:Bounds x="120" y="2880" width="700" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_assign_mpon_di" bpmnElement="evt_end_go_assign_mpon">
        <dc:Bounds x="730" y="935" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_confirm_reg_di" bpmnElement="evt_end_go_confirm_reg">
        <dc:Bounds x="730" y="1060" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_fail_assign_di" bpmnElement="evt_end_go_fail_assign">
        <dc:Bounds x="730" y="1185" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_notify_mpo_assign_di" bpmnElement="evt_end_go_notify_mpo_assign">
        <dc:Bounds x="920" y="935" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_notify_mpo_fail_di" bpmnElement="evt_end_go_notify_mpo_fail">
        <dc:Bounds x="920" y="1060" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_notify_mspon_assign_di" bpmnElement="evt_end_go_notify_mspon_assign">
        <dc:Bounds x="920" y="1185" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_notify_mspon_fail_di" bpmnElement="evt_end_go_notify_mspon_fail">
        <dc:Bounds x="920" y="1310" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_notify_sp_di" bpmnElement="evt_end_go_notify_sp">
        <dc:Bounds x="920" y="1435" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_go_reject_di" bpmnElement="evt_end_go_reject">
        <dc:Bounds x="730" y="1310" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_mpon_fail_proc_di" bpmnElement="evt_end_mpon_fail_proc">
        <dc:Bounds x="730" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_mpon_process_fail_di" bpmnElement="evt_end_mpon_process_fail">
        <dc:Bounds x="350" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_mpon_process_success_di" bpmnElement="evt_end_mpon_process_success">
        <dc:Bounds x="350" y="225" width="36" height="36" />
