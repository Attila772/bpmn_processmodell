<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bpsim="http://www.bpsim.org/schemas/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  
  <!-- Process Definition -->
  <bpmn:process id="Synthetic_Process_1" name="Synthetic Process 1" isExecutable="true">
    
    <bpmn:startEvent id="StartEvent_1" name="Case Arrived">
      <bpmn:outgoing">SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_RecordForm0" />

    <bpmn:serviceTask id="Task_RecordForm0" name="Record form 0">
      <bpmn:incoming">SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_RecordForm0" targetRef="Task_AssessDocument1" />

    <bpmn:serviceTask id="Task_AssessDocument1" name="Assess document 1">
      <bpmn:incoming">SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_AssessDocument1" targetRef="Task_ReviewFile2" />

    <bpmn:serviceTask id="Task_ReviewFile2" name="Review file 2">
      <bpmn:incoming">SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_ReviewFile2" targetRef="Task_NotifyClaim3" />

    <bpmn:serviceTask id="Task_NotifyClaim3" name="Notify claim 3">
      <bpmn:incoming">SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_NotifyClaim3" targetRef="Task_RecordRequest4" />

    <bpmn:serviceTask id="Task_RecordRequest4" name="Record request 4">
      <bpmn:incoming">SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_RecordRequest4" targetRef="Task_ProcessRequest5" />

    <bpmn:serviceTask id="Task_ProcessRequest5" name="Process request 5">
      <bpmn:incoming">SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_ProcessRequest5" targetRef="EndEvent_1" />

    <bpmn:endEvent id="EndEvent_1" name="Process Ended">
      <bpmn:incoming">SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- BPMN Diagram Layout -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Synthetic_Process_1">
      
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="173" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="145" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RecordForm0_di" bpmnElement="Task_RecordForm0">
        <dc:Bounds x="260" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AssessDocument1_di" bpmnElement="Task_AssessDocument1">
        <dc:Bounds x="410" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewFile2_di" bpmnElement="Task_ReviewFile2">
        <dc:Bounds x="560" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyClaim3_di" bpmnElement="Task_NotifyClaim3">
        <dc:Bounds x="710" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RecordRequest4_di" bpmnElement="Task_RecordRequest4">
        <dc:Bounds x="860" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcessRequest5_di" bpmnElement="Task_ProcessRequest5">
        <dc:Bounds x="1010" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1162" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1143" y="145" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="SequenceFlow_1_di" bpmnElement="SequenceFlow_1">
        <di:waypoint x="209" y="120" />
        <di:waypoint x="260" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_2_di" bpmnElement="SequenceFlow_2">
        <di:waypoint x="360" y="120" />
        <di:waypoint x="410" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_3_di" bpmnElement="SequenceFlow_3">
        <di:waypoint x="510" y="120" />
        <di:waypoint x="560" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_4_di" bpmnElement="SequenceFlow_4">
        <di:waypoint x="660" y="120" />
        <di:waypoint x="710" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_5_di" bpmnElement="SequenceFlow_5">
        <di:waypoint x="810" y="120" />
        <di:waypoint x="860" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_6_di" bpmnElement="SequenceFlow_6">
        <di:waypoint x="960" y="120" />
        <di:waypoint x="1010" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="SequenceFlow_7_di" bpmnElement="SequenceFlow_7">
        <di:waypoint x="1110" y="120" />
        <di:waypoint x="1162" y="120" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <!-- BPSim Simulation Configuration -->
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="Scenario_1" name="8 Hour Simulation Scenario">
          <bpsim:ScenarioParameters duration="PT8H" timeUnit="min" />
          
          <!-- Resources Definition -->
          <bpsim:ElementParameters targetRef="Worker_1">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>1</bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <bpsim:ElementParameters targetRef="Worker_2">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>1</bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Start Event Inter-arrival (Exponential mean 17.0 min) -->
          <bpsim:ElementParameters targetRef="StartEvent_1">
            <bpsim:ControlParameters>
              <bpsim:InterArrivalTime>
                <bpsim:ExponentialDistribution mean="17.0" />
              </bpsim:InterArrivalTime>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>

          <!-- Task 1: Record form 0 (Exponential mean 12.0 min, no resource) -->
          <bpsim:ElementParameters targetRef="Task_RecordForm0">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ExponentialDistribution mean="12.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>

          <!-- Task 2: Assess document 1 (Uniform 12.0-19.0 min, Worker 2) -->
          <bpsim:ElementParameters targetRef="Task_AssessDocument1">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:UniformDistribution min="12.0" max="19.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Worker_2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 3: Review file 2 (Uniform 11.0-17.0 min, Worker 1) -->
          <bpsim:ElementParameters targetRef="Task_ReviewFile2">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:UniformDistribution min="11.0" max="17.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Worker_1</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 4: Notify claim 3 (Exponential mean 14.0 min, Worker 2) -->
          <bpsim:ElementParameters targetRef="Task_NotifyClaim3">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ExponentialDistribution mean="14.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Worker_2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 5: Record request 4 (Exponential mean 13.0 min, no resource) -->
          <bpsim:ElementParameters targetRef="Task_RecordRequest4">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ExponentialDistribution mean="13.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>

          <!-- Task 6: Process request 5 (Fixed 3.0 min, Worker 2) -->
          <bpsim:ElementParameters targetRef="Task_ProcessRequest5">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ConstantDistribution value="3.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Worker_2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
  </bpmn:relationship>

</bpmn:definitions>
