<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="data_obj_1" name="Loan Application" dataObjectRef="data_obj_1_do" />
    <bpmn:dataObject id="data_obj_1_do" />
    <bpmn:dataObjectReference id="data_obj_2" name="Loan Offer" dataObjectRef="data_obj_2_do" />
    <bpmn:dataObject id="data_obj_2_do" />
    <bpmn:dataObjectReference id="data_obj_3" name="Rejection Letter" dataObjectRef="data_obj_3_do" />
    <bpmn:dataObject id="data_obj_3_do" />
    <bpmn:startEvent id="start_event_1" name="Application Received">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_1" name="Application Closed">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_1" name="Receive Application">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:property id="task_1_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_1_dia0">
        <bpmn:sourceRef>data_obj_1</bpmn:sourceRef>
        <bpmn:targetRef>task_1_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_2" name="Credit Check">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_gw_in</bpmn:outgoing>
      <bpmn:property id="task_2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task_2_dia0">
        <bpmn:sourceRef>data_obj_1</bpmn:sourceRef>
        <bpmn:targetRef>task_2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_3" name="Prepare Offer">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_3_doa0">
        <bpmn:targetRef>data_obj_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_4" name="Send Rejection">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task_4_doa0">
        <bpmn:targetRef>data_obj_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_1" name="Review Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_gw_in</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_event_1" targetRef="task_1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="flow_gw_in" sourceRef="task_2" targetRef="gateway_1" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="gateway_1" targetRef="task_3" name="Approved" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="gateway_1" targetRef="task_4" name="Rejected" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_3" targetRef="end_event_1" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_4" targetRef="end_event_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_event_1_di" bpmnElement="end_event_1">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_1_di" bpmnElement="gateway_1">
        <dc:Bounds x="730" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_1_di" bpmnElement="start_event_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_di" bpmnElement="task_1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_2_di" bpmnElement="task_2">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_3_di" bpmnElement="task_3">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_4_di" bpmnElement="task_4">
        <dc:Bounds x="920" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_obj_1_di" bpmnElement="data_obj_1">
        <dc:Bounds x="465" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_obj_2_di" bpmnElement="data_obj_2">
        <dc:Bounds x="940" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_obj_3_di" bpmnElement="data_obj_3">
        <dc:Bounds x="940" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_in_di" bpmnElement="flow_gw_in">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="970" y="265" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_1_dia0_di" bpmnElement="task_1_dia0">
        <di:waypoint x="483" y="390" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_2_dia0_di" bpmnElement="task_2_dia0">
        <di:waypoint x="483" y="390" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_3_doa0_di" bpmnElement="task_3_doa0">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="958" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="task_4_doa0_di" bpmnElement="task_4_doa0">
        <di:waypoint x="970" y="265" />
        <di:waypoint x="958" y="390" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>