<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Synthetic_Process_5"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:process id="Process_Synthetic_5" name="Synthetic Process 5" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Case Arrived">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Activity_ApproveTicket0" />
    
    <bpmn:serviceTask id="Activity_ApproveTicket0" name="Approve ticket 0" camunda:type="external" camunda:topic="approve-ticket-0">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Activity_ApproveTicket0" targetRef="Gateway_Exclusive1" />
    
    <bpmn:exclusiveGateway id="Gateway_Exclusive1" name="Routing Gateway">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing">Flow_RegisterOrder1</bpmn:outgoing>
      <bpmn:outgoing">Flow_DispatchForm2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_RegisterOrder1" name="53%" sourceRef="Gateway_Exclusive1" targetRef="Activity_RegisterOrder1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sequence == 'register'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_DispatchForm2" name="47%" sourceRef="Gateway_Exclusive1" targetRef="Activity_DispatchForm2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sequence == 'dispatch'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:serviceTask id="Activity_RegisterOrder1" name="Register order 1" camunda:type="external" camunda:topic="register-order-1">
      <bpmn:incoming>Flow_RegisterOrder1</bpmn:incoming>
      <bpmn:outgoing">Flow_Merge1</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="Activity_DispatchForm2" name="Dispatch form 2" camunda:type="external" camunda:topic="dispatch-form-2">
      <bpmn:incoming>Flow_DispatchForm2</bpmn:incoming>
      <bpmn:outgoing">Flow_Merge2</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:exclusiveGateway id="Gateway_Merge1" name="Merge Gateway">
      <bpmn:incoming>Flow_Merge1</bpmn:incoming>
      <bpmn:incoming>Flow_Merge2</bpmn:incoming>
      <bpmn:outgoing">Flow_ToDispatchTicket3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_Merge1" sourceRef="Activity_RegisterOrder1" targetRef="Gateway_Merge1" />
    <bpmn:sequenceFlow id="Flow_Merge2" sourceRef="Activity_DispatchForm2" targetRef="Gateway_Merge1" />
    <bpmn:sequenceFlow id="Flow_ToDispatchTicket3" sourceRef="Gateway_Merge1" targetRef="Activity_DispatchTicket3" />
    
    <bpmn:serviceTask id="Activity_DispatchTicket3" name="Dispatch ticket 3" camunda:type="external" camunda:topic="dispatch-ticket-3">
      <bpmn:incoming>Flow_ToDispatchTicket3</bpmn:incoming>
      <bpmn:outgoing">Flow_ToInspectDocument4</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="Flow_ToInspectDocument4" sourceRef="Activity_DispatchTicket3" targetRef="Activity_InspectDocument4" />
    
    <bpmn:serviceTask id="Activity_InspectDocument4" name="Inspect document 4" camunda:type="external" camunda:topic="inspect-document-4">
      <bpmn:incoming>Flow_ToInspectDocument4</bpmn:incoming>
      <bpmn:outgoing">Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Activity_InspectDocument4" targetRef="EndEvent_1" />
    
    <bpmn:endEvent id="EndEvent_1" name="Process Completed">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Synthetic_5">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="225" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_ApproveTicket0_di" bpmnElement="Activity_ApproveTicket0">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_Exclusive1_di" bpmnElement="Gateway_Exclusive1" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="378" y="145" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_RegisterOrder1_di" bpmnElement="Activity_RegisterOrder1">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_DispatchForm2_di" bpmnElement="Activity_DispatchForm2">
        <dc:Bounds x="500" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_Merge1_di" bpmnElement="Gateway_Merge1" isMarkerVisible="true">
        <dc:Bounds x="655" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="642" y="145" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_DispatchTicket3_di" bpmnElement="Activity_DispatchTicket3">
        <dc:Bounds x="760" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Activity_InspectDocument4_di" bpmnElement="Activity_InspectDocument4">
        <dc:Bounds x="920" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1082" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1073" y="225" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_RegisterOrder1_di" bpmnElement="Flow_RegisterOrder1">
        <di:waypoint x="420" y="175" />
        <di:waypoint x="420" y="120" />
        <di:waypoint x="500" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="448" y="102" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_DispatchForm2_di" bpmnElement="Flow_DispatchForm2">
        <di:waypoint x="420" y="225" />
        <di:waypoint x="420" y="300" />
        <di:waypoint x="500" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="448" y="282" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Merge1_di" bpmnElement="Flow_Merge1">
        <di:waypoint x="600" y="120" />
        <di:waypoint x="680" y="120" />
        <di:waypoint x="680" y="175" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Merge2_di" bpmnElement="Flow_Merge2">
        <di:waypoint x="600" y="300" />
        <di:waypoint x="680" y="300" />
        <di:waypoint x="680" y="225" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToDispatchTicket3_di" bpmnElement="Flow_ToDispatchTicket3">
        <di:waypoint x="705" y="200" />
        <di:waypoint x="760" y="200" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToInspectDocument4_di" bpmnElement="Flow_ToInspectDocument4">
        <di:waypoint x="860" y="200" />
        <di:waypoint x="920" y="200" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="1020" y="200" />
        <di:waypoint x="1082" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
