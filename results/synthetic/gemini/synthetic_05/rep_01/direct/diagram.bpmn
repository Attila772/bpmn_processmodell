<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:bpsim="http://www.bpsim.org/schemas/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:process id="Process_Synthetic_5" name="Synthetic Process 5" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Case Arrived">
      <bpmn:outgoing">SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_ApproveTicket0" />
    
    <bpmn:serviceTask id="Task_ApproveTicket0" name="Approve ticket 0" camunda:type="external" camunda:topic="Worker1">
      <bpmn:incoming">SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_ApproveTicket0" targetRef="Gateway_Exclusive" />
    
    <bpmn:exclusiveGateway id="Gateway_Exclusive" name="Exclusive Decision">
      <bpmn:incoming">SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_ToRegister</bpmn:outgoing>
      <bpmn:outgoing">SequenceFlow_ToDispatchForm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToRegister" name="53%" sourceRef="Gateway_Exclusive" targetRef="Task_RegisterOrder1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'register'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToDispatchForm" name="47%" sourceRef="Gateway_Exclusive" targetRef="Task_DispatchForm2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'dispatch_form'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:serviceTask id="Task_RegisterOrder1" name="Register order 1" camunda:type="external" camunda:topic="Worker1">
      <bpmn:incoming">SequenceFlow_ToRegister</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_FromRegister</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="Task_DispatchForm2" name="Dispatch form 2" camunda:type="external" camunda:topic="Worker1">
      <bpmn:incoming">SequenceFlow_ToDispatchForm</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_FromDispatchForm</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_FromRegister" sourceRef="Task_RegisterOrder1" targetRef="Task_DispatchTicket3" />
    <bpmn:sequenceFlow id="SequenceFlow_FromDispatchForm" sourceRef="Task_DispatchForm2" targetRef="Task_DispatchTicket3" />
    
    <bpmn:serviceTask id="Task_DispatchTicket3" name="Dispatch ticket 3" camunda:type="external" camunda:topic="Worker1">
      <bpmn:incoming">SequenceFlow_FromRegister</bpmn:incoming>
      <bpmn:incoming">SequenceFlow_FromDispatchForm</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_DispatchTicket3" targetRef="Task_InspectDocument4" />
    
    <bpmn:serviceTask id="Task_InspectDocument4" name="Inspect document 4" camunda:type="external" camunda:topic="Worker1">
      <bpmn:incoming">SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing">SequenceFlow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_InspectDocument4" targetRef="EndEvent_1" />
    
    <bpmn:endEvent id="EndEvent_1" name="Process Ended">
      <bpmn:incoming">SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Synthetic_5">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="145" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_ApproveTicket0_di" bpmnElement="Task_ApproveTicket0">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_Exclusive_di" bpmnElement="Gateway_Exclusive" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="375" y="65" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_RegisterOrder1_di" bpmnElement="Task_RegisterOrder1">
        <dc:Bounds x="500" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_DispatchForm2_di" bpmnElement="Task_DispatchForm2">
        <dc:Bounds x="500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_DispatchTicket3_di" bpmnElement="Task_DispatchTicket3">
        <dc:Bounds x="650" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_InspectDocument4_di" bpmnElement="Task_InspectDocument4">
        <dc:Bounds x="800" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="952" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="933" y="145" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="SequenceFlow_0_di" bpmnElement="SequenceFlow_0">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_1_di" bpmnElement="SequenceFlow_1">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_ToRegister_di" bpmnElement="SequenceFlow_ToRegister">
        <di:waypoint x="420" y="95" />
        <di:waypoint x="420" y="60" />
        <di:waypoint x="500" y="60" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="43" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_ToDispatchForm_di" bpmnElement="SequenceFlow_ToDispatchForm">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="200" />
        <di:waypoint x="500" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="208" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_FromRegister_di" bpmnElement="SequenceFlow_FromRegister">
        <di:waypoint x="600" y="60" />
        <di:waypoint x="625" y="60" />
        <di:waypoint x="625" y="100" />
        <di:waypoint x="650" y="100" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_FromDispatchForm_di" bpmnElement="SequenceFlow_FromDispatchForm">
        <di:waypoint x="600" y="200" />
        <di:waypoint x="625" y="200" />
        <di:waypoint x="625" y="140" />
        <di:waypoint x="650" y="140" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_4_di" bpmnElement="SequenceFlow_4">
        <di:waypoint x="750" y="120" />
        <di:waypoint x="800" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_5_di" bpmnElement="SequenceFlow_5">
        <di:waypoint x="900" y="120" />
        <di:waypoint x="952" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="Scenario_1" name="Simulation Scenario" default="true">
          <bpsim:ScenarioParameters duration="PT8H" timeUnit="min" />
          
          <bpsim:ElementParameters elementRef="StartEvent_1">
            <bpsim:TimeParameters>
              <bpsim:WaitTime>
                <bpsim:ExponentialDistribution mean="8.0" />
              </bpsim:WaitTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          
          <bpsim:ElementParameters elementRef="Task_ApproveTicket0">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ExponentialDistribution mean="6.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Resource id="Worker1_1" name="Worker 1" />
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          
          <bpsim:ElementParameters elementRef="SequenceFlow_ToRegister">
            <bpsim:ControlParameters>
              <bpsim:Probability>0.53</bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          
          <bpsim:ElementParameters elementRef="SequenceFlow_ToDispatchForm">
            <bpsim:ControlParameters>
              <bpsim:Probability>0.47</bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          
          <bpsim:ElementParameters elementRef="Task_RegisterOrder1">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:UniformDistribution min="10.0" max="16.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Resource id="Worker1_2" name="Worker 1" />
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          
          <bpsim:ElementParameters elementRef="Task_DispatchForm2">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="18.0" standardDeviation="3.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Resource id="Worker1_3" name="Worker 1" />
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          
          <bpsim:ElementParameters elementRef="Task_DispatchTicket3">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="8.0" standardDeviation="1.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Resource id="Worker1_4" name="Worker 1" />
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          
          <bpsim:ElementParameters elementRef="Task_InspectDocument4">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:UniformDistribution min="9.0" max="17.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Resource id="Worker1_5" name="Worker 1" />
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
  </bpmn:relationship>
</bpmn:definitions>
