<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bpsim="http://www.bpsim.org/schemas/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn">

  <!-- Resource Definitions -->
  <bpmn:resource id="Resource_Worker1" name="Worker 1"/>
  <bpmn:resource id="Resource_Worker2" name="Worker 2"/>
  <bpmn:resource id="Resource_Worker3" name="Worker 3"/>

  <!-- Process Definition -->
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Case Arrival">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_InspectFile0"/>

    <bpmn:serviceTask id="Task_InspectFile0" name="Inspect file 0">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:potentialOwner id="PO_InspectFile0">
        <bpmn:resourceRef>Resource_Worker2</bpmn:resourceRef>
      </bpmn:potentialOwner>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_InspectFile0" targetRef="Task_DispatchFile1"/>

    <bpmn:serviceTask id="Task_DispatchFile1" name="Dispatch file 1">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:potentialOwner id="PO_DispatchFile1">
        <bpmn:resourceRef>Resource_Worker2</bpmn:resourceRef>
      </bpmn:potentialOwner>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DispatchFile1" targetRef="Task_ValidateClaim2"/>

    <bpmn:serviceTask id="Task_ValidateClaim2" name="Validate claim 2">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:potentialOwner id="PO_ValidateClaim2">
        <bpmn:resourceRef>Resource_Worker2</bpmn:resourceRef>
      </bpmn:potentialOwner>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ValidateClaim2" targetRef="Task_ValidateOrder3"/>

    <bpmn:serviceTask id="Task_ValidateOrder3" name="Validate order 3">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:potentialOwner id="PO_ValidateOrder3">
        <bpmn:resourceRef>Resource_Worker1</bpmn:resourceRef>
      </bpmn:potentialOwner>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ValidateOrder3" targetRef="Task_ReviewDocument4"/>

    <bpmn:serviceTask id="Task_ReviewDocument4" name="Review document 4">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ReviewDocument4" targetRef="Task_DispatchDocument5"/>

    <bpmn:serviceTask id="Task_DispatchDocument5" name="Dispatch document 5">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:potentialOwner id="PO_DispatchDocument5">
        <bpmn:resourceRef>Resource_Worker3</bpmn:resourceRef>
      </bpmn:potentialOwner>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_DispatchDocument5" targetRef="EndEvent_1"/>

    <bpmn:endEvent id="EndEvent_1" name="Process End">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="150" y="100" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="143" width="60" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_InspectFile0" bpmnElement="Task_InspectFile0">
        <dc:Bounds x="240" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_DispatchFile1" bpmnElement="Task_DispatchFile1">
        <dc:Bounds x="390" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ValidateClaim2" bpmnElement="Task_ValidateClaim2">
        <dc:Bounds x="540" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ValidateOrder3" bpmnElement="Task_ValidateOrder3">
        <dc:Bounds x="690" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ReviewDocument4" bpmnElement="Task_ReviewDocument4">
        <dc:Bounds x="840" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_DispatchDocument5" bpmnElement="Task_DispatchDocument5">
        <dc:Bounds x="990" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="1140" y="100" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1127" y="143" width="63" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="186" y="118"/>
        <di:waypoint x="240" y="118"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="340" y="118"/>
        <di:waypoint x="390" y="118"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="490" y="118"/>
        <di:waypoint x="540" y="118"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="640" y="118"/>
        <di:waypoint x="690" y="118"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="790" y="118"/>
        <di:waypoint x="840" y="118"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="940" y="118"/>
        <di:waypoint x="990" y="118"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1090" y="118"/>
        <di:waypoint x="1140" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <!-- BPSim Simulation Parameters -->
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="Scenario_1" name="8-Hour Simulation">
          <bpsim:ScenarioParameters duration="PT8H" timeUnit="min"/>
          
          <!-- Arrival Rate -->
          <bpsim:ElementParameters elementRef="StartEvent_1">
            <bpsim:TimeParameters>
              <bpsim:WaitTime>
                <bpsim:ExponentialDistribution mean="14.0"/>
              </bpsim:WaitTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>

          <!-- Task 0: Inspect file 0 -->
          <bpsim:ElementParameters elementRef="Task_InspectFile0">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="21.0" standardDeviation="4.0"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 1: Dispatch file 1 -->
          <bpsim:ElementParameters elementRef="Task_DispatchFile1">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ConstantDistribution value="7.0"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 2: Validate claim 2 -->
          <bpsim:ElementParameters elementRef="Task_ValidateClaim2">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="15.0" standardDeviation="3.0"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 3: Validate order 3 -->
          <bpsim:ElementParameters elementRef="Task_ValidateOrder3">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:UniformDistribution min="5.0" max="14.0"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker1</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 4: Review document 4 -->
          <bpsim:ElementParameters elementRef="Task_ReviewDocument4">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="9.0" standardDeviation="1.0"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>

          <!-- Task 5: Dispatch document 5 -->
          <bpsim:ElementParameters elementRef="Task_DispatchDocument5">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ConstantDistribution value="3.0"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker3</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
  </bpmn:relationship>

</bpmn:definitions>
