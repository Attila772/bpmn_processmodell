<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bpsim="http://www.bpsim.org/schemas/1.0"
                  id="Definitions_SyntheticProcess3"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  
  <!-- BPMN 2.0 Process Diagram -->
  <bpmn:process id="Process_Synthetic3" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="New Case Arrived">
      <bpmn:outgoing>Flow_Start_To_Task1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Inspect file 0 -->
    <bpmn:serviceTask id="Task_1" name="Inspect file 0">
      <bpmn:incoming>Flow_Start_To_Task1</bpmn:incoming>
      <bpmn:outgoing>Flow_Task1_To_Task2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 2: Dispatch file 1 -->
    <bpmn:serviceTask id="Task_2" name="Dispatch file 1">
      <bpmn:incoming>Flow_Task1_To_Task2</bpmn:incoming>
      <bpmn:outgoing>Flow_Task2_To_Task3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 3: Validate claim 2 -->
    <bpmn:serviceTask id="Task_3" name="Validate claim 2">
      <bpmn:incoming>Flow_Task2_To_Task3</bpmn:incoming>
      <bpmn:outgoing>Flow_Task3_To_Task4</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 4: Validate order 3 -->
    <bpmn:serviceTask id="Task_4" name="Validate order 3">
      <bpmn:incoming>Flow_Task3_To_Task4</bpmn:incoming>
      <bpmn:outgoing>Flow_Task4_To_Task5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 5: Review document 4 -->
    <bpmn:serviceTask id="Task_5" name="Review document 4">
      <bpmn:incoming>Flow_Task4_To_Task5</bpmn:incoming>
      <bpmn:outgoing>Flow_Task5_To_Task6</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 6: Dispatch document 5 -->
    <bpmn:serviceTask id="Task_6" name="Dispatch document 5">
      <bpmn:incoming>Flow_Task5_To_Task6</bpmn:incoming>
      <bpmn:outgoing>Flow_Task6_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process Finished">
      <bpmn:incoming>Flow_Task6_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_To_Task1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_Task1_To_Task2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_Task2_To_Task3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_Task3_To_Task4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_Task4_To_Task5" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_Task5_To_Task6" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_Task6_To_End" sourceRef="Task_6" targetRef="EndEvent_1" />

  </bpmn:process>

  <!-- BPMN Diagram Graphical Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Synthetic3">
      
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="142" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="270" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="430" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="590" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="750" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="910" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_Task_6_di" bpmnElement="Task_6">
        <dc:Bounds x="1070" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Event_EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1232" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1208" y="142" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_To_Task1_di" bpmnElement="Flow_Start_To_Task1">
        <di:waypoint x="215" y="117" />
        <di:waypoint x="270" y="117" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Task1_To_Task2_di" bpmnElement="Flow_Task1_To_Task2">
        <di:waypoint x="370" y="117" />
        <di:waypoint x="430" y="117" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Task2_To_Task3_di" bpmnElement="Flow_Task2_To_Task3">
        <di:waypoint x="530" y="117" />
        <di:waypoint x="590" y="117" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Task3_To_Task4_di" bpmnElement="Flow_Task3_To_Task4">
        <di:waypoint x="690" y="117" />
        <di:waypoint x="750" y="117" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Task4_To_Task5_di" bpmnElement="Flow_Task4_To_Task5">
        <di:waypoint x="850" y="117" />
        <di:waypoint x="910" y="117" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Task5_To_Task6_di" bpmnElement="Flow_Task5_To_Task6">
        <di:waypoint x="1010" y="117" />
        <di:waypoint x="1070" y="117" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Task6_To_End_di" bpmnElement="Flow_Task6_To_End">
        <di:waypoint x="1170" y="117" />
        <di:waypoint x="1232" y="117" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <!-- BPSim Simulation Parameters -->
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="Scenario_1" name="Synthetic Process 3 Simulation">
          <bpsim:ScenarioParameters timeUnit="min">
            <bpsim:Duration>PT8H</bpsim:Duration>
          </bpsim:ScenarioParameters>

          <!-- Resource Definitions -->
          <bpsim:Resource id="Resource_Worker_1" name="Worker 1">
            <bpsim:Quantity>1</bpsim:Quantity>
          </bpsim:Resource>
          <bpsim:Resource id="Resource_Worker_2" name="Worker 2">
            <bpsim:Quantity>1</bpsim:Quantity>
          </bpsim:Resource>
          <bpsim:Resource id="Resource_Worker_3" name="Worker 3">
            <bpsim:Quantity>1</bpsim:Quantity>
          </bpsim:Resource>

          <!-- Start Event Inter-arrival (Exponential mean 14.0 min) -->
          <bpsim:ElementParameters elementRef="StartEvent_1">
            <bpsim:TimeParameters>
              <bpsim:WaitTime>
                <bpsim:ExponentialDistribution mean="14.0" />
              </bpsim:WaitTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>

          <!-- Task 1: Inspect file 0 -->
          <bpsim:ElementParameters elementRef="Task_1">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="21.0" standardDeviation="4.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker_2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 2: Dispatch file 1 -->
          <bpsim:ElementParameters elementRef="Task_2">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ConstantDistribution result="7.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker_2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 3: Validate claim 2 -->
          <bpsim:ElementParameters elementRef="Task_3">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="15.0" standardDeviation="3.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker_2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 4: Validate order 3 -->
          <bpsim:ElementParameters elementRef="Task_4">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:UniformDistribution min="5.0" max="14.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker_1</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Task 5: Review document 4 (No Resource) -->
          <bpsim:ElementParameters elementRef="Task_5">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="9.0" standardDeviation="1.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>

          <!-- Task 6: Dispatch document 5 -->
          <bpsim:ElementParameters elementRef="Task_6">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ConstantDistribution result="3.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker_3</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
  </bpmn:relationship>

</bpmn:definitions>
