<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bpsim="http://www.bpsim.org/schemas/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.org/schema/bpmn">

  <!-- Process Definition -->
  <bpmn:process id="Process_1" isExecutable="true">
    
    <bpmn:startEvent id="StartEvent_1" name="Case Arrived">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_0" />

    <bpmn:serviceTask id="Task_0" name="Notify request 0">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_0" targetRef="Gateway_1" />

    <bpmn:exclusiveGateway id="Gateway_1" name="Route Choice">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Review</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Register</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_To_Review" name="54%" sourceRef="Gateway_1" targetRef="Task_1" />

    <bpmn:serviceTask id="Task_1" name="Review case 1">
      <bpmn:incoming>Flow_To_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_From_Review</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_To_Register" name="46%" sourceRef="Gateway_1" targetRef="Task_2" />

    <bpmn:serviceTask id="Task_2" name="Register order 2">
      <bpmn:incoming>Flow_To_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_From_Register</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_2" name="Merge">
      <bpmn:incoming>Flow_From_Review</bpmn:incoming>
      <bpmn:incoming>Flow_From_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_To_ProcessDoc</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_From_Review" sourceRef="Task_1" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_From_Register" sourceRef="Task_2" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_To_ProcessDoc" sourceRef="Gateway_2" targetRef="Task_3" />

    <bpmn:serviceTask id="Task_3" name="Process document 3">
      <bpmn:incoming>Flow_To_ProcessDoc</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_3" targetRef="EndEvent_1" />

    <bpmn:endEvent id="EndEvent_1" name="Process Ended">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- BPSim Simulation Parameters -->
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="Scenario_1" name="8 Hour Simulation">
          <bpsim:ScenarioParameters duration="PT8H" />
          
          <!-- Element Parameters for Start Event -->
          <bpsim:ElementParameters targetRef="StartEvent_1">
            <bpsim:TimeParameters>
              <bpsim:WaitTime>
                <bpsim:ExponentialDistribution mean="17.0" unit="min" />
              </bpsim:WaitTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>

          <!-- Element Parameters for Task 0 -->
          <bpsim:ElementParameters targetRef="Task_0">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="5.0" standardDeviation="0.0" unit="min" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:Resource id="Worker_1" />
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Branching Probability for Flow_To_Review -->
          <bpsim:ElementParameters targetRef="Flow_To_Review">
            <bpsim:ControlParameters>
              <bpsim:Probability>0.54</bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>

          <!-- Branching Probability for Flow_To_Register -->
          <bpsim:ElementParameters targetRef="Flow_To_Register">
            <bpsim:ControlParameters>
              <bpsim:Probability>0.46</bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>

          <!-- Element Parameters for Task 1 -->
          <bpsim:ElementParameters targetRef="Task_1">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ExponentialDistribution mean="17.0" unit="min" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:Resource id="Worker_1" />
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Element Parameters for Task 2 -->
          <bpsim:ElementParameters targetRef="Task_2">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:UniformDistribution min="11.0" max="17.0" unit="min" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:Resource id="Worker_1" />
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <!-- Element Parameters for Task 3 -->
          <bpsim:ElementParameters targetRef="Task_3">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="16.0" standardDeviation="3.0" unit="min" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:Resource id="Worker_1" />
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
  </bpmn:relationship>

  <!-- BPMN Diagram Layout -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="145" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_0_di" bpmnElement="Task_0">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="387" y="65" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="500" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="500" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_2_di" bpmnElement="Gateway_2" isMarkerVisible="true">
        <dc:Bounds x="655" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="65" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="750" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="902" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="883" y="145" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_Review_di" bpmnElement="Flow_To_Review">
        <di:waypoint x="420" y="95" />
        <di:waypoint x="420" y="70" />
        <di:waypoint x="500" y="70" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="52" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_Register_di" bpmnElement="Flow_To_Register">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="190" />
        <di:waypoint x="500" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="172" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_From_Review_di" bpmnElement="Flow_From_Review">
        <di:waypoint x="600" y="70" />
        <di:waypoint x="680" y="70" />
        <di:waypoint x="680" y="95" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_From_Register_di" bpmnElement="Flow_From_Register">
        <di:waypoint x="600" y="190" />
        <di:waypoint x="680" y="190" />
        <di:waypoint x="680" y="145" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_ProcessDoc_di" bpmnElement="Flow_To_ProcessDoc">
        <di:waypoint x="705" y="120" />
        <di:waypoint x="750" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_End_di" bpmnElement="Flow_End">
        <di:waypoint x="850" y="120" />
        <di:waypoint x="902" y="120" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
