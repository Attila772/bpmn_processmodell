<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bpsim="http://www.bpsim.org/schemas/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:resource id="Resource_Worker1" name="Worker 1" />
  <bpmn:resource id="Resource_Worker2" name="Worker 2" />

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Case Arrived">
      <bpmn:outgoing>Flow_Start_To_Task0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_0" name="Process case 0">
      <bpmn:incoming>Flow_Start_To_Task0</bpmn:incoming>
      <bpmn:outgoing>Flow_Task0_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_1" name="Route Choice">
      <bpmn:incoming>Flow_Task0_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_To_Task1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_To_Task2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_1" name="Assess claim 1">
      <bpmn:incoming>Flow_Gateway_To_Task1</bpmn:incoming>
      <bpmn:outgoing>Flow_Task1_To_Task3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_2" name="Register case 2">
      <bpmn:incoming>Flow_Gateway_To_Task2</bpmn:incoming>
      <bpmn:outgoing>Flow_Task2_To_Task3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_3" name="Assess form 3">
      <bpmn:incoming>Flow_Task1_To_Task3</bpmn:incoming>
      <bpmn:incoming>Flow_Task2_To_Task3</bpmn:incoming>
      <bpmn:outgoing>Flow_Task3_To_Task4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_4" name="Schedule form 4">
      <bpmn:incoming>Flow_Task3_To_Task4</bpmn:incoming>
      <bpmn:outgoing>Flow_Task4_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="Case Processed">
      <bpmn:incoming>Flow_Task4_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_To_Task0" sourceRef="StartEvent_1" targetRef="Task_0" />
    <bpmn:sequenceFlow id="Flow_Task0_To_Gateway" sourceRef="Task_0" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_Gateway_To_Task1" name="76%" sourceRef="Gateway_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_Gateway_To_Task2" name="24%" sourceRef="Gateway_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_Task1_To_Task3" sourceRef="Task_1" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_Task2_To_Task3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_Task3_To_Task4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_Task4_To_End" sourceRef="Task_4" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="BPMNShape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="145" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_0" bpmnElement="Task_0">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_1" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="387" y="65" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_1" bpmnElement="Task_1">
        <dc:Bounds x="500" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_2" bpmnElement="Task_2">
        <dc:Bounds x="500" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_3" bpmnElement="Task_3">
        <dc:Bounds x="650" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_4" bpmnElement="Task_4">
        <dc:Bounds x="800" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="952" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="145" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Start_To_Task0" bpmnElement="Flow_Start_To_Task0">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Task0_To_Gateway" bpmnElement="Flow_Task0_To_Gateway">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gateway_To_Task1" bpmnElement="Flow_Gateway_To_Task1">
        <di:waypoint x="420" y="95" />
        <di:waypoint x="420" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gateway_To_Task2" bpmnElement="Flow_Gateway_To_Task2">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="190" />
        <di:waypoint x="500" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Task1_To_Task3" bpmnElement="Flow_Task1_To_Task3">
        <di:waypoint x="600" y="70" />
        <di:waypoint x="625" y="70" />
        <di:waypoint x="625" y="120" />
        <di:waypoint x="650" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Task2_To_Task3" bpmnElement="Flow_Task2_To_Task3">
        <di:waypoint x="600" y="190" />
        <di:waypoint x="625" y="190" />
        <di:waypoint x="625" y="120" />
        <di:waypoint x="650" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Task3_To_Task4" bpmnElement="Flow_Task3_To_Task4">
        <di:waypoint x="750" y="120" />
        <di:waypoint x="800" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Task4_To_End" bpmnElement="Flow_Task4_To_End">
        <di:waypoint x="900" y="120" />
        <di:waypoint x="952" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpmn:relationship type="BPSimData">
    <bpmn:extension>
      <bpsim:BPSimData>
        <bpsim:Scenario id="Scenario_1" name="Synthetic Process Simulation" duration="PT8H">
          <bpsim:ScenarioParameters timeUnit="min" />

          <bpsim:ElementParameters elementRef="StartEvent_1">
            <bpsim:TimeParameters>
              <bpsim:WaitTime>
                <bpsim:ExponentialDistribution mean="17.0" />
              </bpsim:WaitTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>

          <bpsim:ElementParameters elementRef="Task_0">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:UniformDistribution min="8.0" max="14.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <bpsim:ElementParameters elementRef="Flow_Gateway_To_Task1">
            <bpsim:ControlParameters>
              <bpsim:Probability>0.76</bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>

          <bpsim:ElementParameters elementRef="Flow_Gateway_To_Task2">
            <bpsim:ControlParameters>
              <bpsim:Probability>0.24</bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>

          <bpsim:ElementParameters elementRef="Task_1">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ConstantDistribution value="2.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <bpsim:ElementParameters elementRef="Task_2">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NormalDistribution mean="22.0" standardDeviation="4.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <bpsim:ElementParameters elementRef="Task_3">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ExponentialDistribution mean="18.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker1</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

          <bpsim:ElementParameters elementRef="Task_4">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:ConstantDistribution value="6.0" />
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ResourceRef>Resource_Worker2</bpsim:ResourceRef>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>

        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extension>
  </bpmn:relationship>
</bpmn:definitions>
