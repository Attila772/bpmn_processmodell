<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start_event" name="Case Arrived">
      <bpmn:outgoing>sf_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event" name="Process Ended">
      <bpmn:incoming>sf_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_0" name="Process case 0">
      <bpmn:incoming>sf_0</bpmn:incoming>
      <bpmn:outgoing>sf_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_1" name="Assess claim 1">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_2" name="Register case 2">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_3" name="Assess form 3">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_4" name="Schedule form 4">
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_split" name="Exclusive Split" isMarkerVisible="true">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_join" name="Exclusive Join" isMarkerVisible="true">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf_0" sourceRef="start_event" targetRef="task_0" />
    <bpmn:sequenceFlow id="sf_1" sourceRef="task_0" targetRef="gw_split" />
    <bpmn:sequenceFlow id="sf_2" sourceRef="gw_split" targetRef="task_1" />
    <bpmn:sequenceFlow id="sf_3" sourceRef="gw_split" targetRef="task_2" />
    <bpmn:sequenceFlow id="sf_4" sourceRef="task_1" targetRef="gw_join" />
    <bpmn:sequenceFlow id="sf_5" sourceRef="task_2" targetRef="gw_join" />
    <bpmn:sequenceFlow id="sf_6" sourceRef="gw_join" targetRef="task_3" />
    <bpmn:sequenceFlow id="sf_7" sourceRef="task_3" targetRef="task_4" />
    <bpmn:sequenceFlow id="sf_8" sourceRef="task_4" targetRef="end_event" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
