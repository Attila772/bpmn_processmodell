<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:sim="http://www.simulation.org/bpmn/extensions"
                  id="Definitions_Synthetic_Process_7"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- Process Definition -->
  <bpmn:process id="Process_Synthetic_7" name="Synthetic Process 7" isExecutable="true">
    
    <bpmn:startEvent id="StartEvent_1" name="Case Arrived">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ArchiveClaim0" />

    <bpmn:serviceTask id="Task_ArchiveClaim0" name="Archive claim 0">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ArchiveClaim0" targetRef="Task_ArchiveCase1" />

    <bpmn:serviceTask id="Task_ArchiveCase1" name="Archive case 1">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ArchiveCase1" targetRef="Task_ReviewDocument2" />

    <bpmn:serviceTask id="Task_ReviewDocument2" name="Review document 2">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReviewDocument2" targetRef="EndEvent_1" />

    <bpmn:endEvent id="EndEvent_1" name="Case Ended">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Simulation Parameters Extension -->
  <sim:simulationConfiguration id="SimConfig_1" processRef="Process_Synthetic_7">
    <sim:simulationParameters duration="28800" timeUnit="SECONDS" /> <!-- 8 hours = 28800 seconds -->
    
    <sim:resources>
      <sim:resource id="Worker_1" name="Worker 1" capacity="1" />
    </sim:resources>

    <sim:elementSimulationParameters elementRef="StartEvent_1">
      <sim:arrivalRate>
        <sim:distribution type="EXPONENTIAL" mean="660" /> <!-- 11.0 minutes = 660 seconds -->
      </sim:arrivalRate>
    </sim:elementSimulationParameters>

    <sim:elementSimulationParameters elementRef="Task_ArchiveClaim0">
      <sim:duration>
        <sim:distribution type="EXPONENTIAL" mean="360" /> <!-- 6.0 minutes = 360 seconds -->
      </sim:duration>
    </sim:elementSimulationParameters>

    <sim:elementSimulationParameters elementRef="Task_ArchiveCase1">
      <sim:duration>
        <sim:distribution type="FIXED" value="240" /> <!-- 4.0 minutes = 240 seconds -->
      </sim:duration>
    </sim:elementSimulationParameters>

    <sim:elementSimulationParameters elementRef="Task_ReviewDocument2">
      <sim:duration>
        <sim:distribution type="UNIFORM" min="180" max="600" /> <!-- 3.0-10.0 min = 180-600 seconds -->
      </sim:duration>
      <sim:resourceRequirements>
        <sim:resourceRequirement resourceRef="Worker_1" amount="1" />
      </sim:resourceRequirements>
    </sim:elementSimulationParameters>
  </sim:simulationConfiguration>

  <!-- Diagram Interchange Graphical Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Synthetic_7">
      
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="145" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ArchiveClaim0_di" bpmnElement="Task_ArchiveClaim0">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ArchiveCase1_di" bpmnElement="Task_ArchiveCase1">
        <dc:Bounds x="400" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewDocument2_di" bpmnElement="Task_ReviewDocument2">
        <dc:Bounds x="560" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="722" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="710" y="145" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="400" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="500" y="120" />
        <di:waypoint x="560" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="660" y="120" />
        <di:waypoint x="722" y="120" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
