<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:resource id="Resource_Worker1" name="Worker 1" />

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Case Arrived">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_AssessDocument0" />

    <bpmn:serviceTask id="Task_AssessDocument0" name="Assess document 0">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_AssessDocument0" targetRef="Gateway_Exclusive" />

    <bpmn:exclusiveGateway id="Gateway_Exclusive" name="Route Assessment">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReview1</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToValidate2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ToReview1" name="43%" sourceRef="Gateway_Exclusive" targetRef="Task_ReviewRequest1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${random &lt;= 0.43}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToValidate2" name="57%" sourceRef="Gateway_Exclusive" targetRef="Task_ValidateClaim2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${random &gt; 0.43}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_ReviewRequest1" name="Review request 1">
      <bpmn:incoming>Flow_ToReview1</bpmn:incoming>
      <bpmn:outgoing>Flow_FromReview1</bpmn:outgoing>
      <bpmn:potentialOwner id="PotentialOwner_1">
        <bpmn:resourceRef>Resource_Worker1</bpmn:resourceRef>
      </bpmn:potentialOwner>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ValidateClaim2" name="Validate claim 2">
      <bpmn:incoming>Flow_ToValidate2</bpmn:incoming>
      <bpmn:outgoing>Flow_FromValidate2</bpmn:outgoing>
      <bpmn:potentialOwner id="PotentialOwner_2">
        <bpmn:resourceRef>Resource_Worker1</bpmn:resourceRef>
      </bpmn:potentialOwner>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_FromReview1" sourceRef="Task_ReviewRequest1" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_FromValidate2" sourceRef="Task_ValidateClaim2" targetRef="EndEvent_2" />

    <bpmn:endEvent id="EndEvent_1" name="End Review">
      <bpmn:incoming>Flow_FromReview1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_2" name="End Validate">
      <bpmn:incoming>Flow_FromValidate2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="195" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_AssessDocument0_di" bpmnElement="Task_AssessDocument0">
        <dc:Bounds x="240" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Exclusive_di" bpmnElement="Gateway_Exclusive" isMarkerVisible="true">
        <dc:Bounds x="395" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="388" y="108" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ReviewRequest1_di" bpmnElement="Task_ReviewRequest1">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ValidateClaim2_di" bpmnElement="Task_ValidateClaim2">
        <dc:Bounds x="500" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="652" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="641" y="145" width="59" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <dc:Bounds x="652" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="639" y="265" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="170" />
        <di:waypoint x="240" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="170" />
        <di:waypoint x="395" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReview1_di" bpmnElement="Flow_ToReview1">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="120" />
        <di:waypoint x="500" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="102" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToValidate2_di" bpmnElement="Flow_ToValidate2">
        <di:waypoint x="420" y="195" />
        <di:waypoint x="420" y="240" />
        <di:waypoint x="500" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="222" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromReview1_di" bpmnElement="Flow_FromReview1">
        <di:waypoint x="600" y="120" />
        <di:waypoint x="652" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromValidate2_di" bpmnElement="Flow_FromValidate2">
        <di:waypoint x="600" y="240" />
        <di:waypoint x="652" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
