<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="event_start" name="Start">
      <bpmn:outgoing>seq_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="event_end" name="End">
      <bpmn:incoming>seq_flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_1" name="Approve claim 0">
      <bpmn:incoming>seq_flow_0</bpmn:incoming>
      <bpmn:outgoing>seq_flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_2" name="Notify form 1">
      <bpmn:incoming>seq_flow_1</bpmn:incoming>
      <bpmn:outgoing>seq_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_3" name="Schedule file 2">
      <bpmn:incoming>seq_flow_2</bpmn:incoming>
      <bpmn:outgoing>seq_flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_4" name="Validate case 3">
      <bpmn:incoming>seq_flow_3</bpmn:incoming>
      <bpmn:outgoing>seq_flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_5" name="Assess request 4">
      <bpmn:incoming>seq_flow_4</bpmn:incoming>
      <bpmn:outgoing>seq_flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_6" name="Assess request 5">
      <bpmn:incoming>seq_flow_5</bpmn:incoming>
      <bpmn:outgoing>seq_flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="seq_flow_0" sourceRef="event_start" targetRef="task_1" />
    <bpmn:sequenceFlow id="seq_flow_1" sourceRef="task_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="seq_flow_2" sourceRef="task_2" targetRef="task_3" />
    <bpmn:sequenceFlow id="seq_flow_3" sourceRef="task_3" targetRef="task_4" />
    <bpmn:sequenceFlow id="seq_flow_4" sourceRef="task_4" targetRef="task_5" />
    <bpmn:sequenceFlow id="seq_flow_5" sourceRef="task_5" targetRef="task_6" />
    <bpmn:sequenceFlow id="seq_flow_6" sourceRef="task_6" targetRef="event_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="event_end_di" bpmnElement="event_end">
        <dc:Bounds x="1490" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_start_di" bpmnElement="event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_di" bpmnElement="task_1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_2_di" bpmnElement="task_2">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_3_di" bpmnElement="task_3">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_4_di" bpmnElement="task_4">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_5_di" bpmnElement="task_5">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_6_di" bpmnElement="task_6">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="seq_flow_0_di" bpmnElement="seq_flow_0">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_1_di" bpmnElement="seq_flow_1">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_2_di" bpmnElement="seq_flow_2">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_3_di" bpmnElement="seq_flow_3">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_4_di" bpmnElement="seq_flow_4">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_5_di" bpmnElement="seq_flow_5">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_flow_6_di" bpmnElement="seq_flow_6">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1508" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>