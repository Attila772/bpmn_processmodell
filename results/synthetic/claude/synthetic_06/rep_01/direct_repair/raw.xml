<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="Process_SyntheticProcess6" isExecutable="true">

    <extensionElements>
      <simulation:parameters xmlns:simulation="http://simulation.ext"
                              arrivalRateDistribution="exponential"
                              arrivalRateMean="17.0"
                              simulationDuration="8h"/>
    </extensionElements>

    <startEvent id="StartEvent_1" name="New Case Arrives">
      <outgoing>Flow_Start_To_Task1</outgoing>
    </startEvent>

    <serviceTask id="Task_ProcessCase0" name="Process case 0">
      <extensionElements>
        <simulation:resource xmlns:simulation="http://simulation.ext" name="Worker 2"/>
        <simulation:duration xmlns:simulation="http://simulation.ext"
                              distribution="uniform" min="8.0" max="14.0" unit="minutes"/>
      </extensionElements>
      <incoming>Flow_Start_To_Task1</incoming>
      <outgoing>Flow_Task1_To_Gateway1</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_Split" name="Decision">
      <incoming>Flow_Task1_To_Gateway1</incoming>
      <outgoing>Flow_To_AssessClaim</outgoing>
      <outgoing>Flow_To_RegisterCase</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_AssessClaim1" name="Assess claim 1">
      <extensionElements>
        <simulation:resource xmlns:simulation="http://simulation.ext" name="Worker 2"/>
        <simulation:duration xmlns:simulation="http://simulation.ext"
                              distribution="fixed" value="2.0" unit="minutes"/>
      </extensionElements>
      <incoming>Flow_To_AssessClaim</incoming>
      <outgoing>Flow_AssessClaim_To_Merge</outgoing>
    </serviceTask>

    <serviceTask id="Task_RegisterCase2" name="Register case 2">
      <extensionElements>
        <simulation:resource xmlns:simulation="http://simulation.ext" name="Worker 2"/>
        <simulation:duration xmlns:simulation="http://simulation.ext"
                              distribution="normal" mean="22.0" stdDev="4.0" unit="minutes"/>
      </extensionElements>
      <incoming>Flow_To_RegisterCase</incoming>
      <outgoing>Flow_RegisterCase_To_Merge</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_Merge" name="Merge">
      <incoming>Flow_AssessClaim_To_Merge</incoming>
      <incoming>Flow_RegisterCase_To_Merge</incoming>
      <outgoing>Flow_Merge_To_AssessForm</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_AssessForm3" name="Assess form 3">
      <extensionElements>
        <simulation:resource xmlns:simulation="http://simulation.ext" name="Worker 1"/>
        <simulation:duration xmlns:simulation="http://simulation.ext"
                              distribution="exponential" mean="18.0" unit="minutes"/>
      </extensionElements>
      <incoming>Flow_Merge_To_AssessForm</incoming>
      <outgoing>Flow_AssessForm_To_ScheduleForm</outgoing>
    </serviceTask>

    <serviceTask id="Task_ScheduleForm4" name="Schedule form 4">
      <extensionElements>
        <simulation:resource xmlns:simulation="http://simulation.ext" name="Worker 2"/>
        <simulation:duration xmlns:simulation="http://simulation.ext"
                              distribution="fixed" value="6.0" unit="minutes"/>
      </extensionElements>
      <incoming>Flow_AssessForm_To_ScheduleForm</incoming>
      <outgoing>Flow_ScheduleForm_To_End</outgoing>
    </serviceTask>

    <endEvent id="EndEvent_1" name="Process End">
      <incoming>Flow_ScheduleForm_To_End</incoming>
    </endEvent>

    <sequenceFlow id="Flow_Start_To_Task1" sourceRef="StartEvent_1" targetRef="Task_ProcessCase0"/>
    <sequenceFlow id="Flow_Task1_To_Gateway1" sourceRef="Task_ProcessCase0" targetRef="Gateway_Split"/>

    <sequenceFlow id="Flow_To_AssessClaim" sourceRef="Gateway_Split" targetRef="Task_AssessClaim1">
      <extensionElements>
        <simulation:probability xmlns:simulation="http://simulation.ext" value="0.76"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="Flow_To_RegisterCase" sourceRef="Gateway_Split" targetRef="Task_RegisterCase2">
      <extensionElements>
        <simulation:probability xmlns:simulation="http://simulation.ext" value="0.24"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="Flow_AssessClaim_To_Merge" sourceRef="Task_AssessClaim1" targetRef="Gateway_Merge"/>
    <sequenceFlow id="Flow_RegisterCase_To_Merge" sourceRef="Task_RegisterCase2" targetRef="Gateway_Merge"/>
    <sequenceFlow id="Flow_Merge_To_AssessForm" sourceRef="Gateway_Merge" targetRef="Task_AssessForm3"/>
    <sequenceFlow id="Flow_AssessForm_To_ScheduleForm" sourceRef="Task_AssessForm3" targetRef="Task_ScheduleForm4"/>
    <sequenceFlow id="Flow_ScheduleForm_To_End" sourceRef="Task_ScheduleForm4" targetRef="EndEvent_1"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SyntheticProcess6">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="50" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcessCase0_di" bpmnElement="Task_ProcessCase0">
        <omgdc:Bounds x="140" y="128" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Split_di" bpmnElement="Gateway_Split" isMarkerVisible="true">
        <omgdc:Bounds x="285" y="143" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AssessClaim1_di" bpmnElement="Task_AssessClaim1">
        <omgdc:Bounds x="390" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RegisterCase2_di" bpmnElement="Task_RegisterCase2">
        <omgdc:Bounds x="390" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <omgdc:Bounds x="545" y="143" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AssessForm3_di" bpmnElement="Task_AssessForm3">
        <omgdc:Bounds x="650" y="128" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ScheduleForm4_di" bpmnElement="Task_ScheduleForm4">
        <omgdc:Bounds x="800" y="128" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="950" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_To_Task1_di" bpmnElement="Flow_Start_To_Task1">
        <omgdi:waypoint x="86" y="168"/>
        <omgdi:waypoint x="140" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Task1_To_Gateway1_di" bpmnElement="Flow_Task1_To_Gateway1">
        <omgdi:waypoint x="240" y="168"/>
        <omgdi:waypoint x="285" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_AssessClaim_di" bpmnElement="Flow_To_AssessClaim">
        <omgdi:waypoint x="310" y="143"/>
        <omgdi:waypoint x="310" y="100"/>
        <omgdi:waypoint x="390" y="100"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_RegisterCase_di" bpmnElement="Flow_To_RegisterCase">
        <omgdi:waypoint x="310" y="193"/>
        <omgdi:waypoint x="310" y="240"/>
        <omgdi:waypoint x="390" y="240"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AssessClaim_To_Merge_di" bpmnElement="Flow_AssessClaim_To_Merge">
        <omgdi:waypoint x="490" y="100"/>
        <omgdi:waypoint x="570" y="100"/>
        <omgdi:waypoint x="570" y="143"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_RegisterCase_To_Merge_di" bpmnElement="Flow_RegisterCase_To_Merge">
        <omgdi:waypoint x="490" y="240"/>
        <omgdi:waypoint x="570" y="240"/>
        <omgdi:waypoint x="570" y="193"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Merge_To_AssessForm_di" bpmnElement="Flow_Merge_To_AssessForm">
        <omgdi:waypoint x="595" y="168"/>
        <omgdi:waypoint x="650" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_AssessForm_To_ScheduleForm_di" bpmnElement="Flow_AssessForm_To_ScheduleForm">
        <omgdi:waypoint x="750" y="168"/>
        <omgdi:waypoint x="800" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ScheduleForm_To_End_di" bpmnElement="Flow_ScheduleForm_To_End">
        <omgdi:waypoint x="900" y="168"/>
        <omgdi:waypoint x="950" y="168"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
