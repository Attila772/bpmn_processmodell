<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:sim="http://www.simulation.example.org/bpmnsim"
             targetNamespace="http://www.example.org/bpmn20"
             id="Definitions_1">

  <process id="Process_Synthetic_9" name="Synthetic Process 9" isExecutable="true">

    <extensionElements>
      <sim:simulationConfig>
        <sim:arrivalRate distribution="exponential" mean="17.0" unit="minutes"/>
        <sim:simulationDuration value="8" unit="hours"/>
        <sim:resources>
          <sim:resource id="Worker1" name="Worker 1"/>
        </sim:resources>
      </sim:simulationConfig>
    </extensionElements>

    <startEvent id="StartEvent_1" name="New Case Arrival">
      <outgoing>Flow_Start_To_Notify</outgoing>
    </startEvent>

    <serviceTask id="Task_NotifyRequest0" name="Notify request 0">
      <extensionElements>
        <sim:duration distribution="fixed" value="5.0" unit="minutes"/>
        <sim:resource ref="Worker1"/>
      </extensionElements>
      <incoming>Flow_Start_To_Notify</incoming>
      <outgoing>Flow_Notify_To_Gateway</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_Split_1" name="Route Decision">
      <incoming>Flow_Notify_To_Gateway</incoming>
      <outgoing>Flow_To_ReviewCase1</outgoing>
      <outgoing>Flow_To_RegisterOrder2</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_ReviewCase1" name="Review case 1">
      <extensionElements>
        <sim:duration distribution="exponential" mean="17.0" unit="minutes"/>
        <sim:resource ref="Worker1"/>
      </extensionElements>
      <incoming>Flow_To_ReviewCase1</incoming>
      <outgoing>Flow_ReviewCase1_To_Merge</outgoing>
    </serviceTask>

    <serviceTask id="Task_RegisterOrder2" name="Register order 2">
      <extensionElements>
        <sim:duration distribution="uniform" min="11.0" max="17.0" unit="minutes"/>
        <sim:resource ref="Worker1"/>
      </extensionElements>
      <incoming>Flow_To_RegisterOrder2</incoming>
      <outgoing>Flow_RegisterOrder2_To_Merge</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_Merge_1" name="Merge">
      <incoming>Flow_ReviewCase1_To_Merge</incoming>
      <incoming>Flow_RegisterOrder2_To_Merge</incoming>
      <outgoing>Flow_Merge_To_ProcessDocument3</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_ProcessDocument3" name="Process document 3">
      <extensionElements>
        <sim:duration distribution="normal" mean="16.0" stddev="3.0" unit="minutes"/>
        <sim:resource ref="Worker1"/>
      </extensionElements>
      <incoming>Flow_Merge_To_ProcessDocument3</incoming>
      <outgoing>Flow_ProcessDocument3_To_End</outgoing>
    </serviceTask>

    <endEvent id="EndEvent_1" name="Process End">
      <incoming>Flow_ProcessDocument3_To_End</incoming>
    </endEvent>

    <sequenceFlow id="Flow_Start_To_Notify" sourceRef="StartEvent_1" targetRef="Task_NotifyRequest0"/>
    <sequenceFlow id="Flow_Notify_To_Gateway" sourceRef="Task_NotifyRequest0" targetRef="Gateway_Split_1"/>

    <sequenceFlow id="Flow_To_ReviewCase1" name="54%" sourceRef="Gateway_Split_1" targetRef="Task_ReviewCase1">
      <extensionElements>
        <sim:probability value="0.54"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="Flow_To_RegisterOrder2" name="46%" sourceRef="Gateway_Split_1" targetRef="Task_RegisterOrder2">
      <extensionElements>
        <sim:probability value="0.46"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="Flow_ReviewCase1_To_Merge" sourceRef="Task_ReviewCase1" targetRef="Gateway_Merge_1"/>
    <sequenceFlow id="Flow_RegisterOrder2_To_Merge" sourceRef="Task_RegisterOrder2" targetRef="Gateway_Merge_1"/>
    <sequenceFlow id="Flow_Merge_To_ProcessDocument3" sourceRef="Gateway_Merge_1" targetRef="Task_ProcessDocument3"/>
    <sequenceFlow id="Flow_ProcessDocument3_To_End" sourceRef="Task_ProcessDocument3" targetRef="EndEvent_1"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Synthetic_9">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="50" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyRequest0_di" bpmnElement="Task_NotifyRequest0">
        <omgdc:Bounds x="140" y="128" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Split_1_di" bpmnElement="Gateway_Split_1">
        <omgdc:Bounds x="290" y="143" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReviewCase1_di" bpmnElement="Task_ReviewCase1">
        <omgdc:Bounds x="400" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RegisterOrder2_di" bpmnElement="Task_RegisterOrder2">
        <omgdc:Bounds x="400" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Merge_1_di" bpmnElement="Gateway_Merge_1">
        <omgdc:Bounds x="560" y="143" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcessDocument3_di" bpmnElement="Task_ProcessDocument3">
        <omgdc:Bounds x="660" y="128" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="820" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_To_Notify_di" bpmnElement="Flow_Start_To_Notify">
        <omgdi:waypoint x="86" y="168"/>
        <omgdi:waypoint x="140" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Notify_To_Gateway_di" bpmnElement="Flow_Notify_To_Gateway">
        <omgdi:waypoint x="240" y="168"/>
        <omgdi:waypoint x="290" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_ReviewCase1_di" bpmnElement="Flow_To_ReviewCase1">
        <omgdi:waypoint x="315" y="143"/>
        <omgdi:waypoint x="315" y="100"/>
        <omgdi:waypoint x="400" y="100"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_To_RegisterOrder2_di" bpmnElement="Flow_To_RegisterOrder2">
        <omgdi:waypoint x="315" y="193"/>
        <omgdi:waypoint x="315" y="240"/>
        <omgdi:waypoint x="400" y="240"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ReviewCase1_To_Merge_di" bpmnElement="Flow_ReviewCase1_To_Merge">
        <omgdi:waypoint x="500" y="100"/>
        <omgdi:waypoint x="585" y="100"/>
        <omgdi:waypoint x="585" y="143"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_RegisterOrder2_To_Merge_di" bpmnElement="Flow_RegisterOrder2_To_Merge">
        <omgdi:waypoint x="500" y="240"/>
        <omgdi:waypoint x="585" y="240"/>
        <omgdi:waypoint x="585" y="193"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Merge_To_ProcessDocument3_di" bpmnElement="Flow_Merge_To_ProcessDocument3">
        <omgdi:waypoint x="610" y="168"/>
        <omgdi:waypoint x="660" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ProcessDocument3_To_End_di" bpmnElement="Flow_ProcessDocument3_To_End">
        <omgdi:waypoint x="760" y="168"/>
        <omgdi:waypoint x="820" y="168"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
