<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start1" name="Case Start">
      <bpmn:outgoing>flow_start_task0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="Case End">
      <bpmn:incoming>flow_task3_end1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task0" name="Notify request 0">
      <bpmn:incoming>flow_start_task0</bpmn:incoming>
      <bpmn:outgoing>flow_task0_gw1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task1" name="Review case 1">
      <bpmn:incoming>flow_gw1_review</bpmn:incoming>
      <bpmn:outgoing>flow_task1_task3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task2" name="Register order 2">
      <bpmn:incoming>flow_gw1_register</bpmn:incoming>
      <bpmn:outgoing>flow_task2_task3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task3" name="Process document 3">
      <bpmn:incoming>flow_task1_task3</bpmn:incoming>
      <bpmn:incoming>flow_task2_task3</bpmn:incoming>
      <bpmn:outgoing>flow_task3_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw1" name="Decision after Notify request 0" isMarkerVisible="true">
      <bpmn:incoming>flow_task0_gw1</bpmn:incoming>
      <bpmn:outgoing>flow_gw1_review</bpmn:outgoing>
      <bpmn:outgoing>flow_gw1_register</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_task0" sourceRef="start1" targetRef="task0" />
    <bpmn:sequenceFlow id="flow_task0_gw1" sourceRef="task0" targetRef="gw1" />
    <bpmn:sequenceFlow id="flow_gw1_review" sourceRef="gw1" targetRef="task1" name="54%" />
    <bpmn:sequenceFlow id="flow_gw1_register" sourceRef="gw1" targetRef="task2" name="46%" />
    <bpmn:sequenceFlow id="flow_task1_task3" sourceRef="task1" targetRef="task3" />
    <bpmn:sequenceFlow id="flow_task2_task3" sourceRef="task2" targetRef="task3" />
    <bpmn:sequenceFlow id="flow_task3_end1" sourceRef="task3" targetRef="end1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end1_di" bpmnElement="end1">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw1_di" bpmnElement="gw1">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task0_di" bpmnElement="task0">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task1_di" bpmnElement="task1">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task2_di" bpmnElement="task2">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task3_di" bpmnElement="task3">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_task0_di" bpmnElement="flow_start_task0">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task0_gw1_di" bpmnElement="flow_task0_gw1">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_review_di" bpmnElement="flow_gw1_review">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_register_di" bpmnElement="flow_gw1_register">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task1_task3_di" bpmnElement="flow_task1_task3">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task2_task3_di" bpmnElement="flow_task2_task3">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task3_end1_di" bpmnElement="flow_task3_end1">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>