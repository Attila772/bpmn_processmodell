<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:sim="http://www.example.org/simulation"
             id="Definitions_1"
             targetNamespace="http://www.example.org/bpmn">

  <process id="Process_SyntheticProcess9" name="Synthetic Process 9" isExecutable="true">

    <extensionElements>
      <sim:ArrivalProcess distribution="exponential" mean="17.0" unit="minutes"/>
      <sim:SimulationHorizon value="8" unit="hours"/>
      <sim:Resources>
        <sim:Resource id="Worker1" name="Worker 1"/>
      </sim:Resources>
    </extensionElements>

    <startEvent id="StartEvent_1" name="New Case Arrival">
      <outgoing>Flow_Start_To_Notify</outgoing>
    </startEvent>

    <serviceTask id="Task_NotifyRequest0" name="Notify request 0">
      <extensionElements>
        <sim:Duration distribution="fixed" value="5.0" unit="minutes"/>
        <sim:Performer resourceId="Worker1"/>
      </extensionElements>
      <incoming>Flow_Start_To_Notify</incoming>
      <outgoing>Flow_Notify_To_Gateway</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_Split" name="Decision after Notify request 0">
      <incoming>Flow_Notify_To_Gateway</incoming>
      <outgoing>Flow_Gateway_To_Review</outgoing>
      <outgoing>Flow_Gateway_To_Register</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_ReviewCase1" name="Review case 1">
      <extensionElements>
        <sim:Duration distribution="exponential" mean="17.0" unit="minutes"/>
        <sim:Performer resourceId="Worker1"/>
      </extensionElements>
      <incoming>Flow_Gateway_To_Review</incoming>
      <outgoing>Flow_Review_To_Join</outgoing>
    </serviceTask>

    <serviceTask id="Task_RegisterOrder2" name="Register order 2">
      <extensionElements>
        <sim:Duration distribution="uniform" min="11.0" max="17.0" unit="minutes"/>
        <sim:Performer resourceId="Worker1"/>
      </extensionElements>
      <incoming>Flow_Gateway_To_Register</incoming>
      <outgoing>Flow_Register_To_Join</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_Join" name="Merge before Process document 3">
      <incoming>Flow_Review_To_Join</incoming>
      <incoming>Flow_Register_To_Join</incoming>
      <outgoing>Flow_Join_To_ProcessDocument</outgoing>
    </exclusiveGateway>

    <serviceTask id="Task_ProcessDocument3" name="Process document 3">
      <extensionElements>
        <sim:Duration distribution="normal" mean="16.0" stdDev="3.0" unit="minutes"/>
        <sim:Performer resourceId="Worker1"/>
      </extensionElements>
      <incoming>Flow_Join_To_ProcessDocument</incoming>
      <outgoing>Flow_ProcessDocument_To_End</outgoing>
    </serviceTask>

    <endEvent id="EndEvent_1" name="Process End">
      <incoming>Flow_ProcessDocument_To_End</incoming>
    </endEvent>

    <sequenceFlow id="Flow_Start_To_Notify" sourceRef="StartEvent_1" targetRef="Task_NotifyRequest0"/>
    <sequenceFlow id="Flow_Notify_To_Gateway" sourceRef="Task_NotifyRequest0" targetRef="Gateway_Split"/>

    <sequenceFlow id="Flow_Gateway_To_Review" name="54%" sourceRef="Gateway_Split" targetRef="Task_ReviewCase1">
      <extensionElements>
        <sim:Probability value="0.54"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="Flow_Gateway_To_Register" name="46%" sourceRef="Gateway_Split" targetRef="Task_RegisterOrder2">
      <extensionElements>
        <sim:Probability value="0.46"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="Flow_Review_To_Join" sourceRef="Task_ReviewCase1" targetRef="Gateway_Join"/>
    <sequenceFlow id="Flow_Register_To_Join" sourceRef="Task_RegisterOrder2" targetRef="Gateway_Join"/>
    <sequenceFlow id="Flow_Join_To_ProcessDocument" sourceRef="Gateway_Join" targetRef="Task_ProcessDocument3"/>
    <sequenceFlow id="Flow_ProcessDocument_To_End" sourceRef="Task_ProcessDocument3" targetRef="EndEvent_1"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SyntheticProcess9">

      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="50" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Notify" bpmnElement="Task_NotifyRequest0">
        <omgdc:Bounds x="140" y="128" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GatewaySplit" bpmnElement="Gateway_Split">
        <omgdc:Bounds x="290" y="143" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Task_ReviewCase1">
        <omgdc:Bounds x="400" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Register" bpmnElement="Task_RegisterOrder2">
        <omgdc:Bounds x="400" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GatewayJoin" bpmnElement="Gateway_Join">
        <omgdc:Bounds x="560" y="143" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ProcessDocument" bpmnElement="Task_ProcessDocument3">
        <omgdc:Bounds x="660" y="128" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="810" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Start_Notify" bpmnElement="Flow_Start_To_Notify">
        <omgdi:waypoint x="86" y="168"/>
        <omgdi:waypoint x="140" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Notify_Gateway" bpmnElement="Flow_Notify_To_Gateway">
        <omgdi:waypoint x="240" y="168"/>
        <omgdi:waypoint x="290" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Gateway_Review" bpmnElement="Flow_Gateway_To_Review">
        <omgdi:waypoint x="315" y="143"/>
        <omgdi:waypoint x="315" y="100"/>
        <omgdi:waypoint x="400" y="100"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Gateway_Register" bpmnElement="Flow_Gateway_To_Register">
        <omgdi:waypoint x="315" y="193"/>
        <omgdi:waypoint x="315" y="260"/>
        <omgdi:waypoint x="400" y="260"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Review_Join" bpmnElement="Flow_Review_To_Join">
        <omgdi:waypoint x="500" y="100"/>
        <omgdi:waypoint x="585" y="100"/>
        <omgdi:waypoint x="585" y="143"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Register_Join" bpmnElement="Flow_Register_To_Join">
        <omgdi:waypoint x="500" y="260"/>
        <omgdi:waypoint x="585" y="260"/>
        <omgdi:waypoint x="585" y="193"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Join_ProcessDocument" bpmnElement="Flow_Join_To_ProcessDocument">
        <omgdi:waypoint x="610" y="168"/>
        <omgdi:waypoint x="660" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_ProcessDocument_End" bpmnElement="Flow_ProcessDocument_To_End">
        <omgdi:waypoint x="760" y="168"/>
        <omgdi:waypoint x="810" y="168"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
