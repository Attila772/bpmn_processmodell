<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:qbp="http://www.qbp-simulator.com/Schema201212"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://www.synthetic.org/process2"
             id="definitions_synth2">

  <process id="SyntheticProcess2" name="Synthetic Process 2" isExecutable="true">

    <extensionElements>
      <qbp:processSimulationInfo id="qbpInfo_1"
                                  processInstances="53"
                                  startDateTime="2024-01-01T08:00:00Z"
                                  currency="USD">

        <qbp:arrivalRateDistribution type="EXPONENTIAL" mean="9" timeUnit="minutes"/>

        <qbp:timetables>
          <qbp:timetable id="DEFAULT_TIMETABLE" default="true" name="24/7">
            <qbp:rules>
              <qbp:rule fromTime="00:00:00" toTime="23:59:59" fromWeekDay="MONDAY" toWeekDay="SUNDAY"/>
            </qbp:rules>
          </qbp:timetable>
        </qbp:timetables>

        <qbp:resources>
          <qbp:resource id="QBP_DEFAULT_RESOURCE" name="Default Resource" totalAmount="1" costPerHour="0" timetableId="DEFAULT_TIMETABLE"/>
          <qbp:resource id="Resource_Worker1" name="Worker 1" totalAmount="1" costPerHour="0" timetableId="DEFAULT_TIMETABLE"/>
          <qbp:resource id="Resource_Worker2" name="Worker 2" totalAmount="1" costPerHour="0" timetableId="DEFAULT_TIMETABLE"/>
        </qbp:resources>

        <qbp:elements>
          <qbp:element elementId="Task_ApproveClaim0">
            <qbp:durationDistribution type="UNIFORM" min="4" max="11" timeUnit="minutes"/>
            <qbp:resourceIds>
              <qbp:resourceId>QBP_DEFAULT_RESOURCE</qbp:resourceId>
            </qbp:resourceIds>
          </qbp:element>

          <qbp:element elementId="Task_NotifyForm1">
            <qbp:durationDistribution type="NORMAL" mean="25" arg1="5" timeUnit="minutes"/>
            <qbp:resourceIds>
              <qbp:resourceId>Resource_Worker1</qbp:resourceId>
            </qbp:resourceIds>
          </qbp:element>

          <qbp:element elementId="Task_ScheduleFile2">
            <qbp:durationDistribution type="FIXED" arg1="6" timeUnit="minutes"/>
            <qbp:resourceIds>
              <qbp:resourceId>Resource_Worker1</qbp:resourceId>
            </qbp:resourceIds>
          </qbp:element>

          <qbp:element elementId="Task_ValidateCase3">
            <qbp:durationDistribution type="NORMAL" mean="25" arg1="5" timeUnit="minutes"/>
            <qbp:resourceIds>
              <qbp:resourceId>Resource_Worker2</qbp:resourceId>
            </qbp:resourceIds>
          </qbp:element>

          <qbp:element elementId="Task_AssessRequest4">
            <qbp:durationDistribution type="UNIFORM" min="12" max="19" timeUnit="minutes"/>
            <qbp:resourceIds>
              <qbp:resourceId>Resource_Worker1</qbp:resourceId>
            </qbp:resourceIds>
          </qbp:element>

          <qbp:element elementId="Task_AssessRequest5">
            <qbp:durationDistribution type="UNIFORM" min="10" max="15" timeUnit="minutes"/>
            <qbp:resourceIds>
              <qbp:resourceId>Resource_Worker1</qbp:resourceId>
            </qbp:resourceIds>
          </qbp:element>
        </qbp:elements>

        <qbp:simulationDuration unit="hours" value="8"/>

      </qbp:processSimulationInfo>
    </extensionElements>

    <startEvent id="StartEvent_1" name="New Case Arrives">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <serviceTask id="Task_ApproveClaim0" name="Approve claim 0">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </serviceTask>

    <serviceTask id="Task_NotifyForm1" name="Notify form 1">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <resourceRole id="ResourceRole_1" name="Worker 1">
        <resourceRef>Resource_Worker1</resourceRef>
      </resourceRole>
    </serviceTask>

    <serviceTask id="Task_ScheduleFile2" name="Schedule file 2">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <resourceRole id="ResourceRole_2" name="Worker 1">
        <resourceRef>Resource_Worker1</resourceRef>
      </resourceRole>
    </serviceTask>

    <serviceTask id="Task_ValidateCase3" name="Validate case 3">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <resourceRole id="ResourceRole_3" name="Worker 2">
        <resourceRef>Resource_Worker2</resourceRef>
      </resourceRole>
    </serviceTask>

    <serviceTask id="Task_AssessRequest4" name="Assess request 4">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <resourceRole id="ResourceRole_4" name="Worker 1">
        <resourceRef>Resource_Worker1</resourceRef>
      </resourceRole>
    </serviceTask>

    <serviceTask id="Task_AssessRequest5" name="Assess request 5">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <resourceRole id="ResourceRole_5" name="Worker 1">
        <resourceRef>Resource_Worker1</resourceRef>
      </resourceRole>
    </serviceTask>

    <endEvent id="EndEvent_1" name="Process End">
      <incoming>Flow_7</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ApproveClaim0"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_ApproveClaim0" targetRef="Task_NotifyForm1"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_NotifyForm1" targetRef="Task_ScheduleFile2"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_ScheduleFile2" targetRef="Task_ValidateCase3"/>
    <sequenceFlow id="Flow_5" sourceRef="Task_ValidateCase3" targetRef="Task_AssessRequest4"/>
    <sequenceFlow id="Flow_6" sourceRef="Task_AssessRequest4" targetRef="Task_AssessRequest5"/>
    <sequenceFlow id="Flow_7" sourceRef="Task_AssessRequest5" targetRef="EndEvent_1"/>

  </process>

  <resource id="Resource_Worker1" name="Worker 1"/>
  <resource id="Resource_Worker2" name="Worker 2"/>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="SyntheticProcess2">
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="80" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ApproveClaim0" bpmnElement="Task_ApproveClaim0">
        <omgdc:Bounds x="160" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_NotifyForm1" bpmnElement="Task_NotifyForm1">
        <omgdc:Bounds x="300" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ScheduleFile2" bpmnElement="Task_ScheduleFile2">
        <omgdc:Bounds x="440" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValidateCase3" bpmnElement="Task_ValidateCase3">
        <omgdc:Bounds x="580" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssessRequest4" bpmnElement="Task_AssessRequest4">
        <omgdc:Bounds x="720" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssessRequest5" bpmnElement="Task_AssessRequest5">
        <omgdc:Bounds x="860" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_1" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="1000" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <omgdi:waypoint x="116" y="218"/>
        <omgdi:waypoint x="160" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <omgdi:waypoint x="260" y="218"/>
        <omgdi:waypoint x="300" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <omgdi:waypoint x="400" y="218"/>
        <omgdi:waypoint x="440" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <omgdi:waypoint x="540" y="218"/>
        <omgdi:waypoint x="580" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <omgdi:waypoint x="680" y="218"/>
        <omgdi:waypoint x="720" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <omgdi:waypoint x="820" y="218"/>
        <omgdi:waypoint x="860" y="218"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <omgdi:waypoint x="960" y="218"/>
        <omgdi:waypoint x="1000" y="218"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
