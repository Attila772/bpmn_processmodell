<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:qbp="http://www.qbp-simulator.com/Schema201212"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="LoanApprovalProcess" name="Loan Approval Process" isExecutable="true">

    <startEvent id="StartEvent_1" name="New Loan Application">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <serviceTask id="Task_ReceiveApplication" name="Receive Application">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </serviceTask>

    <serviceTask id="Task_CreditCheck" name="Credit Check">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_ReviewDecision" name="Review Decision">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_Approved</outgoing>
      <outgoing>Flow_Rejected</outgoing>
    </exclusiveGateway>

    <userTask id="Task_PrepareOffer" name="Prepare Offer">
      <incoming>Flow_Approved</incoming>
      <outgoing>Flow_4</outgoing>
    </userTask>

    <serviceTask id="Task_SendRejection" name="Send Rejection">
      <incoming>Flow_Rejected</incoming>
      <outgoing>Flow_5</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_Join">
      <incoming>Flow_4</incoming>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>

    <endEvent id="EndEvent_1" name="Application Closed">
      <incoming>Flow_6</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ReceiveApplication" />
    <sequenceFlow id="Flow_2" sourceRef="Task_ReceiveApplication" targetRef="Task_CreditCheck" />
    <sequenceFlow id="Flow_3" sourceRef="Task_CreditCheck" targetRef="Gateway_ReviewDecision" />
    <sequenceFlow id="Flow_Approved" name="Approved (70%)" sourceRef="Gateway_ReviewDecision" targetRef="Task_PrepareOffer" />
    <sequenceFlow id="Flow_Rejected" name="Rejected (30%)" sourceRef="Gateway_ReviewDecision" targetRef="Task_SendRejection" />
    <sequenceFlow id="Flow_4" sourceRef="Task_PrepareOffer" targetRef="Gateway_Join" />
    <sequenceFlow id="Flow_5" sourceRef="Task_SendRejection" targetRef="Gateway_Join" />
    <sequenceFlow id="Flow_6" sourceRef="Gateway_Join" targetRef="EndEvent_1" />

  </process>

  <!-- Simulation configuration -->
  <qbp:processSimulationInfo id="QBP_SimInfo" processInstances="48" currency="USD"
      startDateTime="2024-01-01T08:00:00.000Z"
      simulationHorizon="PT8H">

    <qbp:arrivalRateDistribution type="EXPONENTIAL" mean="10" timeUnit="minutes"/>

    <qbp:timetables>
      <qbp:timetable id="Timetable_Default" default="true" name="24/7">
        <qbp:rules>
          <qbp:rule fromTime="00:00:00" toTime="23:59:59" fromWeekDay="MONDAY" toWeekDay="SUNDAY"/>
        </qbp:rules>
      </qbp:timetable>
    </qbp:timetables>

    <qbp:resources>
      <qbp:resource id="Resource_CreditAnalyst" name="Credit Analyst" totalAmount="2" costPerHour="0" timetableId="Timetable_Default"/>
      <qbp:resource id="Resource_LoanOfficer" name="Loan Officer" totalAmount="1" costPerHour="0" timetableId="Timetable_Default"/>
      <qbp:resource id="Resource_NoResource" name="No Resource" totalAmount="999" costPerHour="0" timetableId="Timetable_Default"/>
    </qbp:resources>

    <qbp:elements>
      <qbp:element elementId="Task_ReceiveApplication">
        <qbp:durationDistribution type="FIXED" arg1="2" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_NoResource</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>

      <qbp:element elementId="Task_CreditCheck">
        <qbp:durationDistribution type="NORMAL" arg1="15" arg2="3" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_CreditAnalyst</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>

      <qbp:element elementId="Task_PrepareOffer">
        <qbp:durationDistribution type="UNIFORM" arg1="10" arg2="20" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_LoanOfficer</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>

      <qbp:element elementId="Task_SendRejection">
        <qbp:durationDistribution type="FIXED" arg1="5" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_NoResource</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>
    </qbp:elements>

    <qbp:sequenceFlows>
      <qbp:sequenceFlow elementId="Flow_Approved" executionProbability="0.7"/>
      <qbp:sequenceFlow elementId="Flow_Rejected" executionProbability="0.3"/>
    </qbp:sequenceFlows>

  </qbp:processSimulationInfo>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="LoanApprovalProcess">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ReceiveApplication_di" bpmnElement="Task_ReceiveApplication">
        <omgdc:Bounds x="190" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CreditCheck_di" bpmnElement="Task_CreditCheck">
        <omgdc:Bounds x="340" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ReviewDecision_di" bpmnElement="Gateway_ReviewDecision" isMarkerVisible="true">
        <omgdc:Bounds x="495" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PrepareOffer_di" bpmnElement="Task_PrepareOffer">
        <omgdc:Bounds x="600" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendRejection_di" bpmnElement="Task_SendRejection">
        <omgdc:Bounds x="600" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join" isMarkerVisible="true">
        <omgdc:Bounds x="760" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="862" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="136" y="218"/>
        <omgdi:waypoint x="190" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="290" y="218"/>
        <omgdi:waypoint x="340" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="440" y="218"/>
        <omgdi:waypoint x="495" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <omgdi:waypoint x="520" y="193"/>
        <omgdi:waypoint x="520" y="140"/>
        <omgdi:waypoint x="600" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <omgdi:waypoint x="520" y="243"/>
        <omgdi:waypoint x="520" y="300"/>
        <omgdi:waypoint x="600" y="300"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="700" y="140"/>
        <omgdi:waypoint x="785" y="140"/>
        <omgdi:waypoint x="785" y="193"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="700" y="300"/>
        <omgdi:waypoint x="785" y="300"/>
        <omgdi:waypoint x="785" y="243"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="810" y="218"/>
        <omgdi:waypoint x="862" y="218"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
