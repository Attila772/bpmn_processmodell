      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_task3_di" bpmnElement="flow_gw1_task3">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_task4_di" bpmnElement="flow_gw1_task4">
