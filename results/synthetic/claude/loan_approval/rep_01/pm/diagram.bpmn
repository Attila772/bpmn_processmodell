      <bpmndi:BPMNShape id="doc1_di" bpmnElement="doc1">
        <dc:Bounds x="465" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc2_di" bpmnElement="doc2">
        <dc:Bounds x="813" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc3_di" bpmnElement="doc3">
        <dc:Bounds x="940" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doc4_di" bpmnElement="doc4">
        <dc:Bounds x="940" y="365" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="400" y="140" />
