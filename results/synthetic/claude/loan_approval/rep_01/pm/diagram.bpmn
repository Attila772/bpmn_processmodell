<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:dataObjectReference id="doc1" name="Loan Application" dataObjectRef="doc1_do" />
    <bpmn:dataObject id="doc1_do" />
    <bpmn:dataObjectReference id="doc2" name="Credit Check Result" dataObjectRef="doc2_do" />
    <bpmn:dataObject id="doc2_do" />
    <bpmn:dataObjectReference id="doc3" name="Loan Offer" dataObjectRef="doc3_do" />
    <bpmn:dataObject id="doc3_do" />
    <bpmn:dataObjectReference id="doc4" name="Rejection Letter" dataObjectRef="doc4_do" />
    <bpmn:dataObject id="doc4_do" />
    <bpmn:startEvent id="start1" name="Application Received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="Application Closed">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task1" name="Receive Application">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="task1_doa0">
        <bpmn:targetRef>doc1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task2" name="Credit Check">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:property id="task2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task2_dia0">
        <bpmn:sourceRef>doc1</bpmn:sourceRef>
        <bpmn:targetRef>task2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task2_doa0">
        <bpmn:targetRef>doc2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task3" name="Prepare Offer">
      <bpmn:incoming>flow_gw1_task3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="task3_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task3_dia0">
        <bpmn:sourceRef>doc2</bpmn:sourceRef>
        <bpmn:targetRef>task3_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task3_doa0">
        <bpmn:targetRef>doc3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task4" name="Send Rejection">
      <bpmn:incoming>flow_gw1_task4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:property id="task4_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="task4_dia0">
        <bpmn:sourceRef>doc2</bpmn:sourceRef>
        <bpmn:targetRef>task4_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="task4_doa0">
        <bpmn:targetRef>doc4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw1" name="Review Decision" isMarkerVisible="true">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>flow_gw1_task3</bpmn:outgoing>
      <bpmn:outgoing>flow_gw1_task4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="task1" />
    <bpmn:sequenceFlow id="f2" sourceRef="task1" targetRef="task2" />
    <bpmn:sequenceFlow id="f3" sourceRef="task2" targetRef="gw1" />
    <bpmn:sequenceFlow id="flow_gw1_task3" sourceRef="gw1" targetRef="task3" name="Approved" />
    <bpmn:sequenceFlow id="flow_gw1_task4" sourceRef="gw1" targetRef="task4" name="Rejected" />
    <bpmn:sequenceFlow id="f4" sourceRef="task3" targetRef="end1" />
    <bpmn:sequenceFlow id="f5" sourceRef="task4" targetRef="end1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
