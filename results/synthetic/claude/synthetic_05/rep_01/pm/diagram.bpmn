<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start1" name="Case Start">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="Case End">
      <bpmn:incoming>sf6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t0" name="Approve ticket 0">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t1" name="Register order 1">
      <bpmn:incoming>sf_gw1_register</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="Dispatch form 2">
      <bpmn:incoming>sf_gw1_dispatchform</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t3" name="Dispatch ticket 3">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t4" name="Inspect document 4">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw1" name="Route after Approve ticket 0" isMarkerVisible="true">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf_gw1_register</bpmn:outgoing>
      <bpmn:outgoing>sf_gw1_dispatchform</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sf1" sourceRef="start1" targetRef="t0" />
    <bpmn:sequenceFlow id="sf2" sourceRef="t0" targetRef="gw1" />
    <bpmn:sequenceFlow id="sf_gw1_register" sourceRef="gw1" targetRef="t1" name="53%" />
    <bpmn:sequenceFlow id="sf_gw1_dispatchform" sourceRef="gw1" targetRef="t2" name="47%" />
    <bpmn:sequenceFlow id="sf3" sourceRef="t1" targetRef="t3" />
    <bpmn:sequenceFlow id="sf4" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="sf5" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="sf6" sourceRef="t4" targetRef="end1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end1_di" bpmnElement="end1">
        <dc:Bounds x="1300" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw1_di" bpmnElement="gw1">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t0_di" bpmnElement="t0">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_gw1_register_di" bpmnElement="sf_gw1_register">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_gw1_dispatchform_di" bpmnElement="sf_gw1_dispatchform">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf4_di" bpmnElement="sf4">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf5_di" bpmnElement="sf5">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf6_di" bpmnElement="sf6">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1318" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>