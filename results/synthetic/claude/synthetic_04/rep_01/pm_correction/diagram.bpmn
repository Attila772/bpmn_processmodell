<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start_1" name="Case Start">
      <bpmn:outgoing>flow_start_task1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_1" name="Process End">
      <bpmn:incoming>flow_task2_end</bpmn:incoming>
      <bpmn:incoming>flow_task3_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_1" name="Assess document 0">
      <bpmn:incoming>flow_start_task1</bpmn:incoming>
      <bpmn:outgoing>flow_task1_gw1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_2" name="Review request 1">
      <bpmn:incoming>flow_gw1_review</bpmn:incoming>
      <bpmn:outgoing>flow_task2_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_3" name="Validate claim 2">
      <bpmn:incoming>flow_gw1_validate</bpmn:incoming>
      <bpmn:outgoing>flow_task3_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_1" name="Route after assessment" isMarkerVisible="true">
      <bpmn:incoming>flow_task1_gw1</bpmn:incoming>
      <bpmn:outgoing>flow_gw1_review</bpmn:outgoing>
      <bpmn:outgoing>flow_gw1_validate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_task1" sourceRef="start_1" targetRef="task_1" />
    <bpmn:sequenceFlow id="flow_task1_gw1" sourceRef="task_1" targetRef="gw_1" />
    <bpmn:sequenceFlow id="flow_gw1_review" sourceRef="gw_1" targetRef="task_2" name="43%" />
    <bpmn:sequenceFlow id="flow_gw1_validate" sourceRef="gw_1" targetRef="task_3" name="57%" />
    <bpmn:sequenceFlow id="flow_task2_end" sourceRef="task_2" targetRef="end_1" />
    <bpmn:sequenceFlow id="flow_task3_end" sourceRef="task_3" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_1_di" bpmnElement="gw_1">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_di" bpmnElement="task_1">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_2_di" bpmnElement="task_2">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_3_di" bpmnElement="task_3">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_task1_di" bpmnElement="flow_start_task1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task1_gw1_di" bpmnElement="flow_task1_gw1">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_review_di" bpmnElement="flow_gw1_review">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw1_validate_di" bpmnElement="flow_gw1_validate">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task2_end_di" bpmnElement="flow_task2_end">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task3_end_di" bpmnElement="flow_task3_end">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>