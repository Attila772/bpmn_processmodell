      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task3" name="Validate claim 2">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task4" name="Validate order 3">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task5" name="Review document 4">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task6" name="Dispatch document 5">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="task1" />
    <bpmn:sequenceFlow id="f2" sourceRef="task1" targetRef="task2" />
    <bpmn:sequenceFlow id="f3" sourceRef="task2" targetRef="task3" />
    <bpmn:sequenceFlow id="f4" sourceRef="task3" targetRef="task4" />
    <bpmn:sequenceFlow id="f5" sourceRef="task4" targetRef="task5" />
    <bpmn:sequenceFlow id="f6" sourceRef="task5" targetRef="task6" />
    <bpmn:sequenceFlow id="f7" sourceRef="task6" targetRef="end1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
