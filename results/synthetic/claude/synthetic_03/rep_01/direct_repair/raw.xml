             xmlns:qbp="http://www.qbp-simulator.com/Schema201212"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="Process_SyntheticProcess3" name="Synthetic Process 3" isExecutable="true">

    <startEvent id="StartEvent_1" name="Case Arrives">
      <outgoing>Flow_1</outgoing>
    </startEvent>

    <task id="Task_1" name="Inspect file 0">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>

    <task id="Task_2" name="Dispatch file 1">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>

    <task id="Task_3" name="Validate claim 2">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>

    <task id="Task_4" name="Validate order 3">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
    </task>

    <task id="Task_5" name="Review document 4">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </task>

    <task id="Task_6" name="Dispatch document 5">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
    </task>

    <endEvent id="EndEvent_1" name="Process End">
      <incoming>Flow_7</incoming>
    </endEvent>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
    <sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
    <sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4" />
    <sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="Task_5" />
    <sequenceFlow id="Flow_6" sourceRef="Task_5" targetRef="Task_6" />
    <sequenceFlow id="Flow_7" sourceRef="Task_6" targetRef="EndEvent_1" />

  </process>

  <!-- Simulation parameters (QBP-style extension) -->
  <qbp:processSimulationInfo id="QBP_1" processId="Process_SyntheticProcess3"
      currency="EUR" statsOptionSelected="true"
      startDateTime="2024-01-01T08:00:00.000Z">

    <qbp:arrivalRateDistribution type="EXPONENTIAL" mean="14" timeUnit="minutes"/>

    <qbp:timetables>
      <qbp:timetable id="Timetable_default" default="true" name="Default Timetable">
        <qbp:rules>
          <qbp:rule fromTime="00:00:00.000+00:00" toTime="23:59:59.999+00:00" fromWeekDay="MONDAY" toWeekDay="SUNDAY"/>
        </qbp:rules>
      </qbp:timetable>
    </qbp:timetables>

    <qbp:resources>
      <qbp:resource id="Resource_Worker1" name="Worker 1" totalAmount="1" costPerHour="0" timetableId="Timetable_default"/>
      <qbp:resource id="Resource_Worker2" name="Worker 2" totalAmount="1" costPerHour="0" timetableId="Timetable_default"/>
      <qbp:resource id="Resource_Worker3" name="Worker 3" totalAmount="1" costPerHour="0" timetableId="Timetable_default"/>
    </qbp:resources>

    <qbp:elements>
      <qbp:element elementId="Task_1" id="QBP_Task_1">
        <qbp:durationDistribution type="NORMAL" mean="21" arg1="4" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_Worker2</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>

      <qbp:element elementId="Task_2" id="QBP_Task_2">
        <qbp:durationDistribution type="FIXED" mean="7" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_Worker2</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>

      <qbp:element elementId="Task_3" id="QBP_Task_3">
        <qbp:durationDistribution type="NORMAL" mean="15" arg1="3" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_Worker2</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>

      <qbp:element elementId="Task_4" id="QBP_Task_4">
        <qbp:durationDistribution type="UNIFORM" arg1="5" arg2="14" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_Worker1</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>

      <qbp:element elementId="Task_5" id="QBP_Task_5">
        <qbp:durationDistribution type="NORMAL" mean="9" arg1="1" timeUnit="minutes"/>
      </qbp:element>

      <qbp:element elementId="Task_6" id="QBP_Task_6">
        <qbp:durationDistribution type="FIXED" mean="3" timeUnit="minutes"/>
        <qbp:resourceIds>
          <qbp:resourceId>Resource_Worker3</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>
    </qbp:elements>

    <qbp:simulationDuration unit="hours" value="8"/>

  </qbp:processSimulationInfo>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SyntheticProcess3">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="152" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <omgdc:Bounds x="240" y="180" width="100" height="80" />
