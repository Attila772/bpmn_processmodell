<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start_event" name="Start">
      <bpmn:outgoing>flow_start_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event" name="End">
      <bpmn:incoming>flow_5_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_0" name="Inspect file 0">
      <bpmn:incoming>flow_start_0</bpmn:incoming>
      <bpmn:outgoing>flow_0_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_1" name="Dispatch file 1">
      <bpmn:incoming>flow_0_1</bpmn:incoming>
      <bpmn:outgoing>flow_1_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_2" name="Validate claim 2">
      <bpmn:incoming>flow_1_2</bpmn:incoming>
      <bpmn:outgoing>flow_2_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_3" name="Validate order 3">
      <bpmn:incoming>flow_2_3</bpmn:incoming>
      <bpmn:outgoing>flow_3_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_4" name="Review document 4">
      <bpmn:incoming>flow_3_4</bpmn:incoming>
      <bpmn:outgoing>flow_4_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_5" name="Dispatch document 5">
      <bpmn:incoming>flow_4_5</bpmn:incoming>
      <bpmn:outgoing>flow_5_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_start_0" sourceRef="start_event" targetRef="task_0" />
    <bpmn:sequenceFlow id="flow_0_1" sourceRef="task_0" targetRef="task_1" />
    <bpmn:sequenceFlow id="flow_1_2" sourceRef="task_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="flow_2_3" sourceRef="task_2" targetRef="task_3" />
    <bpmn:sequenceFlow id="flow_3_4" sourceRef="task_3" targetRef="task_4" />
    <bpmn:sequenceFlow id="flow_4_5" sourceRef="task_4" targetRef="task_5" />
    <bpmn:sequenceFlow id="flow_5_end" sourceRef="task_5" targetRef="end_event" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
        <dc:Bounds x="1490" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_0_di" bpmnElement="task_0">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_1_di" bpmnElement="task_1">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_2_di" bpmnElement="task_2">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_3_di" bpmnElement="task_3">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_4_di" bpmnElement="task_4">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_5_di" bpmnElement="task_5">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_0_di" bpmnElement="flow_start_0">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_0_1_di" bpmnElement="flow_0_1">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_2_di" bpmnElement="flow_1_2">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_3_di" bpmnElement="flow_2_3">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_4_di" bpmnElement="flow_3_4">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_5_di" bpmnElement="flow_4_5">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_end_di" bpmnElement="flow_5_end">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1508" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>