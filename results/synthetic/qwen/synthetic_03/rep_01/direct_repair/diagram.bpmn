  <bpmn:process id="SyntheticProcess3" name="Synthetic Process 3" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Case Arrival">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_1" name="Process End">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_InspectFile0" />
    <bpmn:serviceTask id="Task_InspectFile0" name="Inspect file 0">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="distribution" value="normal" />
          <simulation:property name="mean" value="21.0" />
          <simulation:property name="stdDev" value="4.0" />
          <simulation:property name="resource" value="Worker 2" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_InspectFile0" targetRef="Task_DispatchFile1" />
    <bpmn:serviceTask id="Task_DispatchFile1" name="Dispatch file 1">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="distribution" value="fixed" />
          <simulation:property name="duration" value="7.0" />
          <simulation:property name="resource" value="Worker 2" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DispatchFile1" targetRef="Task_ValidateClaim2" />
    <bpmn:serviceTask id="Task_ValidateClaim2" name="Validate claim 2">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="distribution" value="normal" />
          <simulation:property name="mean" value="15.0" />
          <simulation:property name="stdDev" value="3.0" />
          <simulation:property name="resource" value="Worker 2" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ValidateClaim2" targetRef="Task_ValidateOrder3" />
    <bpmn:serviceTask id="Task_ValidateOrder3" name="Validate order 3">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="distribution" value="uniform" />
          <simulation:property name="min" value="5.0" />
          <simulation:property name="max" value="14.0" />
          <simulation:property name="resource" value="Worker 1" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ValidateOrder3" targetRef="Task_ReviewDocument4" />
    <bpmn:serviceTask id="Task_ReviewDocument4" name="Review document 4">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="distribution" value="normal" />
          <simulation:property name="mean" value="9.0" />
          <simulation:property name="stdDev" value="1.0" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ReviewDocument4" targetRef="Task_DispatchDocument5" />
    <bpmn:serviceTask id="Task_DispatchDocument5" name="Dispatch document 5">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="distribution" value="fixed" />
          <simulation:property name="duration" value="3.0" />
          <simulation:property name="resource" value="Worker 3" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_DispatchDocument5" targetRef="EndEvent_1" />
  </bpmn:process>
