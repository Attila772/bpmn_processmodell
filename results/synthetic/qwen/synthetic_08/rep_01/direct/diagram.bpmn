<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Synthetic_8" name="Synthetic Process 8" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Case Arrival">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_1" name="Process End">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Review_Document_0" />
    <bpmn:serviceTask id="Task_Review_Document_0" name="Review document 0">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="durationDistribution" value="uniform" />
          <simulation:property name="durationMin" value="5.0" />
          <simulation:property name="durationMax" value="10.0" />
          <simulation:property name="resourcePool" value="Worker 1" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Review_Document_0" targetRef="Task_Validate_Ticket_1" />
    <bpmn:serviceTask id="Task_Validate_Ticket_1" name="Validate ticket 1">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="durationDistribution" value="fixed" />
          <simulation:property name="durationValue" value="6.0" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_2b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2b" sourceRef="Task_Validate_Ticket_1" targetRef="Task_Review_File_2" />
    <bpmn:serviceTask id="Task_Review_File_2" name="Review file 2">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:property name="durationDistribution" value="normal" />
          <simulation:property name="durationMean" value="24.0" />
          <simulation:property name="durationStdDev" value="4.0" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2b</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Review_File_2" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Synthetic_8">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="619" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_Document_0_di" bpmnElement="Task_Review_Document_0">
        <dc:Bounds x="260" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_Ticket_1_di" bpmnElement="Task_Validate_Ticket_1">
        <dc:Bounds x="410" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_File_2_di" bpmnElement="Task_Review_File_2">
        <dc:Bounds x="560" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="215" y="117" />
        <di:waypoint x="260" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="360" y="117" />
        <di:waypoint x="410" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2b_di" bpmnElement="Flow_2b">
        <di:waypoint x="510" y="117" />
        <di:waypoint x="560" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="660" y="117" />
        <di:waypoint x="619" y="117" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>