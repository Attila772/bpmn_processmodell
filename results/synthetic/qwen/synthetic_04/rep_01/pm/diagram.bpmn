<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start_event_0" name="Case Arrival">
      <bpmn:outgoing>flow_start_to_assess</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_1" name="Process End (Review)">
      <bpmn:incoming>flow_review_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_2" name="Process End (Validate)">
      <bpmn:incoming>flow_validate_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_assess_doc_0" name="Assess document 0">
      <bpmn:incoming>flow_start_to_assess</bpmn:incoming>
      <bpmn:outgoing>flow_assess_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_review_req_1" name="Review request 1">
      <bpmn:incoming>flow_to_review</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_validate_claim_2" name="Validate claim 2">
      <bpmn:incoming>flow_to_validate</bpmn:incoming>
      <bpmn:outgoing>flow_validate_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_decision_0" name="Route Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_assess_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_to_review</bpmn:outgoing>
      <bpmn:outgoing>flow_to_validate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_assess" sourceRef="start_event_0" targetRef="task_assess_doc_0" />
    <bpmn:sequenceFlow id="flow_assess_to_gateway" sourceRef="task_assess_doc_0" targetRef="gateway_decision_0" />
    <bpmn:sequenceFlow id="flow_to_review" sourceRef="gateway_decision_0" targetRef="task_review_req_1" name="Route to Review" />
    <bpmn:sequenceFlow id="flow_to_validate" sourceRef="gateway_decision_0" targetRef="task_validate_claim_2" name="Route to Validate" />
    <bpmn:sequenceFlow id="flow_review_to_end" sourceRef="task_review_req_1" targetRef="end_event_1" />
    <bpmn:sequenceFlow id="flow_validate_to_end" sourceRef="task_validate_claim_2" targetRef="end_event_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_event_1_di" bpmnElement="end_event_1">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_2_di" bpmnElement="end_event_2">
        <dc:Bounds x="920" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_decision_0_di" bpmnElement="gateway_decision_0">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_0_di" bpmnElement="start_event_0">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assess_doc_0_di" bpmnElement="task_assess_doc_0">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_req_1_di" bpmnElement="task_review_req_1">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_validate_claim_2_di" bpmnElement="task_validate_claim_2">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_assess_di" bpmnElement="flow_start_to_assess">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assess_to_gateway_di" bpmnElement="flow_assess_to_gateway">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_review_di" bpmnElement="flow_to_review">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_validate_di" bpmnElement="flow_to_validate">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_to_end_di" bpmnElement="flow_review_to_end">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_validate_to_end_di" bpmnElement="flow_validate_to_end">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="938" y="243" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>