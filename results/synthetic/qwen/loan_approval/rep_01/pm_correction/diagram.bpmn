<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="evt_start" name="New Loan Application Arrives">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="evt_end_approved" name="Application Closed (Approved)">
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="evt_end_rejected" name="Application Closed (Rejected)">
      <bpmn:incoming>flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_receive" name="Receive Application">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_credit_check" name="Credit Check">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_prepare_offer" name="Prepare Offer">
      <bpmn:incoming>flow_approved</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_send_rejection" name="Send Rejection">
      <bpmn:incoming>flow_rejected</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_review_decision" name="Review Decision" isMarkerVisible="true">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_approved</bpmn:outgoing>
      <bpmn:outgoing>flow_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_1" sourceRef="evt_start" targetRef="task_receive" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_receive" targetRef="task_credit_check" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_credit_check" targetRef="gw_review_decision" />
    <bpmn:sequenceFlow id="flow_approved" sourceRef="gw_review_decision" targetRef="task_prepare_offer" name="Approved" />
    <bpmn:sequenceFlow id="flow_rejected" sourceRef="gw_review_decision" targetRef="task_send_rejection" name="Rejected" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_prepare_offer" targetRef="evt_end_approved" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_send_rejection" targetRef="evt_end_rejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="evt_end_approved_di" bpmnElement="evt_end_approved">
        <dc:Bounds x="1110" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_end_rejected_di" bpmnElement="evt_end_rejected">
        <dc:Bounds x="1110" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_start_di" bpmnElement="evt_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_review_decision_di" bpmnElement="gw_review_decision">
        <dc:Bounds x="730" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_credit_check_di" bpmnElement="task_credit_check">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prepare_offer_di" bpmnElement="task_prepare_offer">
        <dc:Bounds x="920" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receive_di" bpmnElement="task_receive">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_rejection_di" bpmnElement="task_send_rejection">
        <dc:Bounds x="920" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="755" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approved_di" bpmnElement="flow_approved">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rejected_di" bpmnElement="flow_rejected">
        <di:waypoint x="755" y="125" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1128" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="970" y="265" />
        <di:waypoint x="1128" y="243" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>