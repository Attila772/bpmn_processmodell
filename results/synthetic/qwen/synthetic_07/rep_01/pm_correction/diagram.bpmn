<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start_event" name="Start">
      <bpmn:outgoing>flow_start_to_task1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event" name="End">
      <bpmn:incoming>flow_task3_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_archive_claim_0" name="Archive claim 0">
      <bpmn:incoming>flow_start_to_task1</bpmn:incoming>
      <bpmn:outgoing>flow_task1_to_task2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_archive_case_1" name="Archive case 1">
      <bpmn:incoming>flow_task1_to_task2</bpmn:incoming>
      <bpmn:outgoing>flow_task2_to_task3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_review_document_2" name="Review document 2">
      <bpmn:incoming>flow_task2_to_task3</bpmn:incoming>
      <bpmn:outgoing>flow_task3_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_start_to_task1" sourceRef="start_event" targetRef="task_archive_claim_0" />
    <bpmn:sequenceFlow id="flow_task1_to_task2" sourceRef="task_archive_claim_0" targetRef="task_archive_case_1" />
    <bpmn:sequenceFlow id="flow_task2_to_task3" sourceRef="task_archive_case_1" targetRef="task_review_document_2" />
    <bpmn:sequenceFlow id="flow_task3_to_end" sourceRef="task_review_document_2" targetRef="end_event" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
        <dc:Bounds x="920" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_archive_case_1_di" bpmnElement="task_archive_case_1">
        <dc:Bounds x="540" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_archive_claim_0_di" bpmnElement="task_archive_claim_0">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_document_2_di" bpmnElement="task_review_document_2">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_task1_di" bpmnElement="flow_start_to_task1">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task1_to_task2_di" bpmnElement="flow_task1_to_task2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task2_to_task3_di" bpmnElement="flow_task2_to_task3">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task3_to_end_di" bpmnElement="flow_task3_to_end">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="938" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>