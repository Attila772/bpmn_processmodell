<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start_event_0" name="Start">
      <bpmn:outgoing>flow_start_to_approve</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event_0" name="End">
      <bpmn:incoming>flow_inspect_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_approve_ticket_0" name="Approve ticket 0">
      <bpmn:incoming>flow_start_to_approve</bpmn:incoming>
      <bpmn:outgoing>flow_approve_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_register_order_1" name="Register order 1">
      <bpmn:incoming>flow_to_register_order_1</bpmn:incoming>
      <bpmn:outgoing>flow_register_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_dispatch_form_2" name="Dispatch form 2">
      <bpmn:incoming>flow_to_dispatch_form_2</bpmn:incoming>
      <bpmn:outgoing>flow_dispatch_form_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_dispatch_ticket_3" name="Dispatch ticket 3">
      <bpmn:incoming>flow_merge_to_dispatch_ticket</bpmn:incoming>
      <bpmn:outgoing>flow_dispatch_ticket_to_inspect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_inspect_document_4" name="Inspect document 4">
      <bpmn:incoming>flow_dispatch_ticket_to_inspect</bpmn:incoming>
      <bpmn:outgoing>flow_inspect_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_decision_1" name="Decision after Approve ticket 0" isMarkerVisible="true">
      <bpmn:incoming>flow_approve_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_to_register_order_1</bpmn:outgoing>
      <bpmn:outgoing>flow_to_dispatch_form_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_merge_1" name="Merge paths" isMarkerVisible="true">
      <bpmn:incoming>flow_register_to_merge</bpmn:incoming>
      <bpmn:incoming>flow_dispatch_form_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_dispatch_ticket</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_start_to_approve" sourceRef="start_event_0" targetRef="task_approve_ticket_0" />
    <bpmn:sequenceFlow id="flow_approve_to_gateway" sourceRef="task_approve_ticket_0" targetRef="gateway_decision_1" />
    <bpmn:sequenceFlow id="flow_to_register_order_1" sourceRef="gateway_decision_1" targetRef="task_register_order_1" name="Route to Register order 1" />
    <bpmn:sequenceFlow id="flow_to_dispatch_form_2" sourceRef="gateway_decision_1" targetRef="task_dispatch_form_2" name="Route to Dispatch form 2" />
    <bpmn:sequenceFlow id="flow_register_to_merge" sourceRef="task_register_order_1" targetRef="gateway_merge_1" />
    <bpmn:sequenceFlow id="flow_dispatch_form_to_merge" sourceRef="task_dispatch_form_2" targetRef="gateway_merge_1" />
    <bpmn:sequenceFlow id="flow_merge_to_dispatch_ticket" sourceRef="gateway_merge_1" targetRef="task_dispatch_ticket_3" />
    <bpmn:sequenceFlow id="flow_dispatch_ticket_to_inspect" sourceRef="task_dispatch_ticket_3" targetRef="task_inspect_document_4" />
    <bpmn:sequenceFlow id="flow_inspect_to_end" sourceRef="task_inspect_document_4" targetRef="end_event_0" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_event_0_di" bpmnElement="end_event_0">
        <dc:Bounds x="1490" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_decision_1_di" bpmnElement="gateway_decision_1">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_merge_1_di" bpmnElement="gateway_merge_1">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_0_di" bpmnElement="start_event_0">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_ticket_0_di" bpmnElement="task_approve_ticket_0">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_dispatch_form_2_di" bpmnElement="task_dispatch_form_2">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_dispatch_ticket_3_di" bpmnElement="task_dispatch_ticket_3">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inspect_document_4_di" bpmnElement="task_inspect_document_4">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_order_1_di" bpmnElement="task_register_order_1">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_approve_di" bpmnElement="flow_start_to_approve">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_to_gateway_di" bpmnElement="flow_approve_to_gateway">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_register_order_1_di" bpmnElement="flow_to_register_order_1">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_dispatch_form_2_di" bpmnElement="flow_to_dispatch_form_2">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_register_to_merge_di" bpmnElement="flow_register_to_merge">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_dispatch_form_to_merge_di" bpmnElement="flow_dispatch_form_to_merge">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_to_dispatch_ticket_di" bpmnElement="flow_merge_to_dispatch_ticket">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_dispatch_ticket_to_inspect_di" bpmnElement="flow_dispatch_ticket_to_inspect">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inspect_to_end_di" bpmnElement="flow_inspect_to_end">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1508" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>