<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="SyntheticProcess5" name="Synthetic Process 5" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Case Arrival">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_1" name="Process End">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ApproveTicket0" name="Approve ticket 0">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:durationDistribution type="exponential" mean="6.0" />
          <simulation:resourceAssignment resource="Worker 1" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Route Decision">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3_Register</bpmn:outgoing>
      <bpmn:outgoing>Flow_3_Dispatch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RegisterOrder1" name="Register order 1">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:durationDistribution type="uniform" min="10.0" max="16.0" />
          <simulation:resourceAssignment resource="Worker 1" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DispatchForm2" name="Dispatch form 2">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:durationDistribution type="normal" mean="18.0" stdDev="3.0" />
          <simulation:resourceAssignment resource="Worker 1" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3_Dispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DispatchTicket3" name="Dispatch ticket 3">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:durationDistribution type="normal" mean="8.0" stdDev="1.0" />
          <simulation:resourceAssignment resource="Worker 1" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InspectDocument4" name="Inspect document 4">
      <bpmn:extensionElements>
        <simulation:properties xmlns:simulation="http://camunda.org/schema/1.0/simulation">
          <simulation:durationDistribution type="uniform" min="9.0" max="17.0" />
          <simulation:resourceAssignment resource="Worker 1" />
        </simulation:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ApproveTicket0" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ApproveTicket0" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_3_Register" name="53%" sourceRef="Gateway_Decision" targetRef="Task_RegisterOrder1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${Math.random() &lt; 0.53}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3_Dispatch" name="47%" sourceRef="Gateway_Decision" targetRef="Task_DispatchForm2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${Math.random() &gt;= 0.53}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_RegisterOrder1" targetRef="Task_DispatchTicket3" />
    <bpmn:sequenceFlow id="Flow_4b" sourceRef="Task_DispatchForm2" targetRef="Task_DispatchTicket3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_DispatchTicket3" targetRef="Task_InspectDocument4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_InspectDocument4" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="SyntheticProcess5">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveTicket0_di" bpmnElement="Task_ApproveTicket0">
        <dc:Bounds x="260" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="405" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterOrder1_di" bpmnElement="Task_RegisterOrder1">
        <dc:Bounds x="510" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DispatchForm2_di" bpmnElement="Task_DispatchForm2">
        <dc:Bounds x="510" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DispatchTicket3_di" bpmnElement="Task_DispatchTicket3">
        <dc:Bounds x="680" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InspectDocument4_di" bpmnElement="Task_InspectDocument4">
        <dc:Bounds x="840" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1002" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="215" y="117" />
        <di:waypoint x="260" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="360" y="120" />
        <di:waypoint x="405" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_Register_di" bpmnElement="Flow_3_Register">
        <di:waypoint x="430" y="120" />
        <di:waypoint x="430" y="70" />
        <di:waypoint x="510" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_Dispatch_di" bpmnElement="Flow_3_Dispatch">
        <di:waypoint x="430" y="120" />
        <di:waypoint x="430" y="190" />
        <di:waypoint x="510" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="610" y="70" />
        <di:waypoint x="680" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4b_di" bpmnElement="Flow_4b">
        <di:waypoint x="610" y="190" />
        <di:waypoint x="680" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="780" y="130" />
        <di:waypoint x="840" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="940" y="130" />
        <di:waypoint x="1002" y="117" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>