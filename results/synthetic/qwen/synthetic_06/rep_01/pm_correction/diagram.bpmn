<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start_event" name="Start">
      <bpmn:outgoing>flow_start_to_task0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_event" name="End">
      <bpmn:incoming>flow_schedule_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_process_case_0" name="Process case 0">
      <bpmn:incoming>flow_start_to_task0</bpmn:incoming>
      <bpmn:outgoing>flow_task0_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_assess_claim_1" name="Assess claim 1">
      <bpmn:incoming>flow_to_assess_claim</bpmn:incoming>
      <bpmn:outgoing>flow_assess_claim_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_register_case_2" name="Register case 2">
      <bpmn:incoming>flow_to_register_case</bpmn:incoming>
      <bpmn:outgoing>flow_register_case_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_assess_form_3" name="Assess form 3">
      <bpmn:incoming>flow_merge_to_assess_form</bpmn:incoming>
      <bpmn:outgoing>flow_assess_form_to_schedule</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_schedule_form_4" name="Schedule form 4">
      <bpmn:incoming>flow_assess_form_to_schedule</bpmn:incoming>
      <bpmn:outgoing>flow_schedule_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_decision" name="Decision after Process case 0" isMarkerVisible="true">
      <bpmn:incoming>flow_task0_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_to_assess_claim</bpmn:outgoing>
      <bpmn:outgoing>flow_to_register_case</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gateway_merge" name="Merge paths">
      <bpmn:incoming>flow_assess_claim_to_merge</bpmn:incoming>
      <bpmn:incoming>flow_register_case_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_assess_form</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_start_to_task0" sourceRef="start_event" targetRef="task_process_case_0" />
    <bpmn:sequenceFlow id="flow_task0_to_gateway" sourceRef="task_process_case_0" targetRef="gateway_decision" />
    <bpmn:sequenceFlow id="flow_to_assess_claim" sourceRef="gateway_decision" targetRef="task_assess_claim_1" name="Route to Assess claim 1" />
    <bpmn:sequenceFlow id="flow_to_register_case" sourceRef="gateway_decision" targetRef="task_register_case_2" name="Route to Register case 2" />
    <bpmn:sequenceFlow id="flow_assess_claim_to_merge" sourceRef="task_assess_claim_1" targetRef="gateway_merge" />
    <bpmn:sequenceFlow id="flow_register_case_to_merge" sourceRef="task_register_case_2" targetRef="gateway_merge" />
    <bpmn:sequenceFlow id="flow_merge_to_assess_form" sourceRef="gateway_merge" targetRef="task_assess_form_3" />
    <bpmn:sequenceFlow id="flow_assess_form_to_schedule" sourceRef="task_assess_form_3" targetRef="task_schedule_form_4" />
    <bpmn:sequenceFlow id="flow_schedule_to_end" sourceRef="task_schedule_form_4" targetRef="end_event" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
        <dc:Bounds x="1490" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_decision_di" bpmnElement="gateway_decision">
        <dc:Bounds x="540" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_merge_di" bpmnElement="gateway_merge">
        <dc:Bounds x="920" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assess_claim_1_di" bpmnElement="task_assess_claim_1">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assess_form_3_di" bpmnElement="task_assess_form_3">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_case_0_di" bpmnElement="task_process_case_0">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_case_2_di" bpmnElement="task_register_case_2">
        <dc:Bounds x="730" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_schedule_form_4_di" bpmnElement="task_schedule_form_4">
        <dc:Bounds x="1300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_task0_di" bpmnElement="flow_start_to_task0">
        <di:waypoint x="178" y="118" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_task0_to_gateway_di" bpmnElement="flow_task0_to_gateway">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="565" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_assess_claim_di" bpmnElement="flow_to_assess_claim">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_register_case_di" bpmnElement="flow_to_register_case">
        <di:waypoint x="565" y="125" />
        <di:waypoint x="780" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assess_claim_to_merge_di" bpmnElement="flow_assess_claim_to_merge">
        <di:waypoint x="780" y="140" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_register_case_to_merge_di" bpmnElement="flow_register_case_to_merge">
        <di:waypoint x="780" y="265" />
        <di:waypoint x="945" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_to_assess_form_di" bpmnElement="flow_merge_to_assess_form">
        <di:waypoint x="945" y="125" />
        <di:waypoint x="1160" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assess_form_to_schedule_di" bpmnElement="flow_assess_form_to_schedule">
        <di:waypoint x="1160" y="140" />
        <di:waypoint x="1350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_schedule_to_end_di" bpmnElement="flow_schedule_to_end">
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1508" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>